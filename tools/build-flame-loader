#!/bin/bash
# SPDX-License-Identifier: MIT
# Build the opt-in native storage loader on a Linux build host. No phone access.
# Requires git, make, aarch64-linux-gnu-gcc, dtc, flex, bison, Python 3,
# OpenSSL/UUID development headers and AOSP's mkbootimg.py with its gki helpers.
# Clone https://github.com/wirelessjoe/u-boot and check out the revision below.
set -euo pipefail
revision=e210c6956ce90e48b667eb15a8c6f20bc292b52e
source_dir="" mkbootimg="" out="" jobs=4
die() { echo "error: $*" >&2; exit 1; }
while (($#)); do
  case $1 in
    --uboot) source_dir=${2:?}; shift ;;
    --mkbootimg) mkbootimg=${2:?}; shift ;;
    --out) out=${2:?}; shift ;;
    --jobs) jobs=${2:?}; shift ;;
    -h|--help) echo 'tools/build-flame-loader --uboot DIR --mkbootimg FILE --out FRESH_DIR [--jobs N]'; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
  shift
done
[[ -d $source_dir && -f $mkbootimg && -n $out && $jobs =~ ^[1-9][0-9]*$ ]] || die 'supply source, AOSP mkbootimg and fresh output paths'
source_dir=$(cd -- "$source_dir" && pwd)
mkbootimg=$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$mkbootimg")
[[ $(git -C "$source_dir" rev-parse HEAD) == "$revision" ]] || die 'wrong U-Boot source revision'
git -C "$source_dir" diff --quiet HEAD -- || die 'U-Boot source has tracked local changes'
[[ ! -e $out ]] || die 'choose a fresh output directory'
mkdir -p "$out"
out=$(cd -- "$out" && pwd)
export SOURCE_DATE_EPOCH
SOURCE_DATE_EPOCH=$(git -C "$source_dir" log -1 --format=%ct)
cross=${CROSS_COMPILE:-aarch64-linux-gnu-}
make -C "$source_dir" O="$out/uboot" ARCH=arm CROSS_COMPILE="$cross" qcom_flame_omamobile_defconfig
make -C "$source_dir" O="$out/uboot" ARCH=arm CROSS_COMPILE="$cross" W=1 -j"$jobs"
python3 - "$out" "$revision" <<'PY'
from pathlib import Path
import gzip,hashlib,json,re,sys
out=Path(sys.argv[1]);build=out/'uboot'
config=(build/'.config').read_text().splitlines()
for key in ('EFI_LOADER','FAT_WRITE','FASTBOOT_FLASH','CMD_USB_MASS_STORAGE',
            'USB_FUNCTION_MASS_STORAGE','CMD_SAVEENV','CMD_DFU','DFU_SCSI',
            'DFU_MMC','FASTBOOT_OEM_RUN','FASTBOOT_OEM_BOARD','FASTBOOT_CMD_OEM_CONSOLE'):
 assert 'CONFIG_'+key+'=y' not in config,'Unexpected write facility: '+key
assert 'CONFIG_ENV_IS_NOWHERE=y' in config
header=(build/'include/generated/defaultenv_autogenerated.h').read_text()
data=bytes(int(v,16) for v in re.findall(r'0x([0-9a-fA-F]{2})',header))
env=dict(item.split('=',1) for item in data.decode().split('\0') if '=' in item)
assert env['preboot']=='sleep 2; scsi scan'
assert env['bootcmd']=='run native_boot; run fastboot'
assert 'part number scsi 0 userdata rootpart' in env['native_boot']
assert '/boot/omamobile/boot.img' in env['native_boot']
assert 'usbacm' not in env['stdout'] and 'usbacm' not in env['stderr']
assert not any('ums ' in v or 'bootefi' in v for k,v in env.items() if k.startswith('bootmenu_'))
raw=(build/'u-boot-nodtb.bin').read_bytes()
dtb=(build/'dts/upstream/src/arm64/qcom/sm8150-google-flame.dtb').read_bytes()
(out/'u-boot.gz-dtb').write_bytes(gzip.compress(raw,compresslevel=9,mtime=0)+dtb)
(out/'BUILD.json').write_text(json.dumps({'source_revision':sys.argv[2],
 'config_sha256':hashlib.sha256((build/'.config').read_bytes()).hexdigest(),
 'loader_sha256':hashlib.sha256(raw).hexdigest(),'dtb_sha256':hashlib.sha256(dtb).hexdigest(),
 'compiled_environment_checked':True,'hardware_status':'host build only; new approved RAM boot required'},indent=2)+'\n')
PY
python3 "$mkbootimg" --header_version 0 --base 0 --kernel_offset 0x8000 \
  --ramdisk_offset 0 --second_offset 0 --tags_offset 0x100 --pagesize 4096 \
  --kernel "$out/u-boot.gz-dtb" -o "$out/boot.img"
python3 - "$out/boot.img" <<'PY'
from pathlib import Path
import struct,sys
data=Path(sys.argv[1]).read_bytes()
assert data[:8]==b'ANDROID!' and 4096<len(data)<=4*1024*1024
assert struct.unpack_from('<I',data,40)[0]==0
assert struct.unpack_from('<I',data,16)[0]==0
assert struct.unpack_from('<I',data,36)[0]==4096
assert data[4096:4099]==b'\x1f\x8b\x08'
PY
(cd "$out" && sha256sum boot.img u-boot.gz-dtb BUILD.json > SHA256SUMS)
echo "Built $out/boot.img; no phone accessed. Follow the native RAM-boot gates before flashing."
