[Unit]
Description=Apply the Mi 8's own WLAN and Bluetooth addresses from persist
# persist is read-only to us; the storage guard keeps it that way.
ConditionPathExists=/dev/disk/by-partlabel/persist
Before=NetworkManager.service bluetooth.service
Wants=local-fs.target
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/omamobile-dipper-identity

[Install]
WantedBy=multi-user.target
