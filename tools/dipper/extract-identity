#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Recover this phone's factory WLAN and Bluetooth addresses from its own
# `persist` backup. Offline: the phone is not touched and need not be reachable.
#
# These are device identifiers. They are written outside the repository, mode
# 600, and must never be committed.
set -euo pipefail

REF=${REF:-$HOME/android/reference/dipper-stock}
PERSIST=${PERSIST:-$REF/backup/persist.img}
OUT=${OUT:-$REF/identity.env}
DEBUGFS=${DEBUGFS:-/sbin/debugfs}

[[ -f $PERSIST ]] || { echo "no $PERSIST -- run tools/dipper/backup-stock first" >&2; exit 1; }
[[ -x $DEBUGFS ]] || { echo "need debugfs (e2fsprogs) at $DEBUGFS" >&2; exit 1; }

tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
umask 077

# persist is ext4; read it with debugfs so nothing has to be mounted or elevated.
"$DEBUGFS" -R "dump /wlan_bt/wlan.mac $tmp/wlan.mac" "$PERSIST" 2>/dev/null || true
"$DEBUGFS" -R "dump /wlan_bt/bt.mac $tmp/bt.mac" "$PERSIST" 2>/dev/null || true

fmt() {  # 6 raw bytes -> aa:bb:cc:dd:ee:ff, rejecting anything that is not a MAC
  local f=$1
  [[ -s $f ]] || return 1
  python3 - "$f" <<'PY'
import sys
d = open(sys.argv[1], 'rb').read()
if len(d) != 6 or d == b'\0' * 6 or d == b'\xff' * 6:
    sys.exit(1)
if d[0] & 1:                 # a multicast bit means this is not a station address
    sys.exit(1)
print(":".join(f"{b:02x}" for b in d))
PY
}

wlan=$(fmt "$tmp/wlan.mac") || { echo "no usable WLAN address in persist" >&2; exit 1; }
bt=$(fmt "$tmp/bt.mac") || { echo "no usable Bluetooth address in persist" >&2; exit 1; }

# little-endian byte list for the device tree's local-bd-address
bd_le=$(python3 -c "print(' '.join(reversed('$bt'.split(':'))))")

mkdir -p "$(dirname "$OUT")"
cat > "$OUT" <<EOF
# This phone's factory addresses, recovered from its own persist backup.
# Device identifiers: mode 600, never commit, never publish.
DIPPER_WLAN_MAC=$wlan
DIPPER_BT_MAC=$bt
DIPPER_BT_BD_LE="$bd_le"
EOF
chmod 600 "$OUT"

# A udev .link file fixes wlan0's address at interface creation. systemd-udevd
# applies it whoever manages the interface afterwards, NetworkManager included.
link=$(dirname "$OUT")/10-dipper-wlan.link
cat > "$link" <<EOF
# Install as /etc/systemd/network/10-dipper-wlan.link on the phone.
# The generic WCN3990 board data carries no per-device MAC, so without this the
# interface comes up with whatever ath10k invents, changing across boots.
[Match]
OriginalName=wlan0

[Link]
MACAddress=$wlan
EOF
chmod 600 "$link"

echo "wrote $OUT and $link (both 0600, outside the repo)"
echo "WLAN and Bluetooth addresses recovered; values are not printed here."
