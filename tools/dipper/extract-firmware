#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Pull dipper's own vendor firmware off the phone and merge the split Qualcomm
# .mdt/.bNN sets into the single .mbn files mainline's remoteproc asks for.
#
# Nothing here is redistributable: it is the owner's device firmware, extracted
# from their own phone, and it stays outside the repository.
set -euo pipefail

HOST=${HOST:-mi8}
SU=${SU:-/debug_ramdisk/su}
OUT=${OUT:-$HOME/android/reference/dipper-stock/firmware}

remote() { ssh "$HOST" "$SU -c '$1'"; }

umask 077
raw=$OUT/raw; mkdir -p "$raw" "$OUT/qcom/sdm845/dipper"; chmod -R 700 "$OUT"

# Where each blob lives on this phone, measured: /vendor/firmware for the GPU and
# IPA, /vendor/firmware_mnt/image for the DSPs and the modem.

# One tar stream per source directory: a regex through `su -c` is a quoting
# minefield, and per-file ssh over a relayed link is needlessly slow.
fetch() {           # fetch <remote dir> <pattern...>
  local dir=$1; shift
  ssh "$HOST" "$SU -c \"cd $dir && tar cf - $* 2>/dev/null\"" | tar xf - -C "$raw"
}
fetch_base64() {    # fetch one small binary file through Android's text-only SSH bridge
  ssh "$HOST" "$SU -c \"base64 $1\"" | base64 -d > "$2"
}
echo "== GPU zap shader and IPA from /vendor/firmware"
fetch /vendor/firmware 'a630_zap.mdt a630_zap.b* ipa_fws.mdt ipa_fws.b*'
echo "== DSP and modem images from /vendor/firmware_mnt/image"
fetch /vendor/firmware_mnt/image 'adsp.mdt adsp.b* cdsp.mdt cdsp.b* mba.mbn'
echo "== modem configuration files requested by MPSS"
mkdir -p "$raw/modem_pr/mcfg/configs/mcfg_hw" "$raw/modem_pr/mcfg/configs/mcfg_sw"
fetch_base64 /vendor/firmware_mnt/image/modem_pr/mcfg/configs/mcfg_hw/mbn_hw.dig "$raw/modem_pr/mcfg/configs/mcfg_hw/mbn_hw.dig"
fetch_base64 /vendor/firmware_mnt/image/modem_pr/mcfg/configs/mcfg_sw/mbn_sw.dig "$raw/modem_pr/mcfg/configs/mcfg_sw/mbn_sw.dig"
echo "== ath10k board data and firmware"
mkdir -p "$OUT/wlan"
ssh "$HOST" "$SU -c \"cd /vendor/firmware && tar cf - wlan 2>/dev/null\"" | tar xf - -C "$OUT"
# mba is already a single signed image; the rest get squashed below.
[ -f "$raw/mba.mbn" ] && mv "$raw/mba.mbn" "$OUT/qcom/sdm845/dipper/mba.mbn"
echo "raw files pulled: $(find "$raw" -type f | wc -l)"

python3 "$(dirname "$0")/pil-squash.py" "$raw" "$OUT/qcom/sdm845/dipper"

# MPSS requests these over TFTP; stage them beside modem.mbn for tqftpserv.
install -D -m 600 "$raw/modem_pr/mcfg/configs/mcfg_hw/mbn_hw.dig" "$OUT/qcom/sdm845/dipper/modem_pr/mcfg/configs/mcfg_hw/mbn_hw.dig"
install -D -m 600 "$raw/modem_pr/mcfg/configs/mcfg_sw/mbn_sw.dig" "$OUT/qcom/sdm845/dipper/modem_pr/mcfg/configs/mcfg_sw/mbn_sw.dig"

echo
echo "firmware tree for the phone's /lib/firmware:"
find "$OUT/qcom" "$OUT/wlan" -type f 2>/dev/null | sed "s#$OUT/#  #" | sort
echo
echo "Device firmware from this phone only. Do not commit or redistribute it."
