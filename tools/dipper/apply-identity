#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Write this phone's Bluetooth address into a built DTB, so the identifier lives
# in the flashed image and never in the repository.
#
#   apply-identity <dtb>     (edits the file in place)
#
# Without an identity file it leaves the placeholder alone and says so: the DTB
# stays valid, Bluetooth just keeps the firmware's shared default address.
set -euo pipefail

dtb=${1:?usage: apply-identity <dtb>}
ID=${ID:-$HOME/android/reference/dipper-stock/identity.env}
NODE=${NODE:-}

[[ -f $dtb ]] || { echo "no such DTB: $dtb" >&2; exit 1; }
command -v fdtput >/dev/null || { echo "need fdtput (device-tree-compiler)" >&2; exit 1; }

if [[ ! -r $ID ]]; then
  echo "no identity file at $ID: leaving local-bd-address at the placeholder"
  echo "(run tools/dipper/extract-identity after tools/dipper/backup-stock)"
  exit 0
fi
# shellcheck disable=SC1090
. "$ID"
[[ -n ${DIPPER_BT_BD_LE:-} ]] || { echo "$ID has no DIPPER_BT_BD_LE" >&2; exit 1; }

# Find the bluetooth node rather than hardcoding a path, so a DTS reshuffle
# cannot silently write the address nowhere.
if [[ -z $NODE ]]; then
  NODE=$(fdtget -l / "$dtb" >/dev/null 2>&1 && true; python3 - "$dtb" <<'PY'
import subprocess, sys
dtb = sys.argv[1]
dts = subprocess.check_output(["dtc", "-I", "dtb", "-O", "dts", dtb],
                              stderr=subprocess.DEVNULL).decode()
path, found = [], []
for line in dts.splitlines():
    t = line.strip()
    if t.endswith("{"):
        path.append(t[:-1].strip().split(":")[-1].strip())
    elif t.startswith("}"):
        if path: path.pop()
    elif t.startswith('compatible = "qcom,wcn3990-bt"'):
        found.append("/" + "/".join(p for p in path[1:] if p))
if len(found) != 1:
    print("", end=""); sys.exit(1)
print(found[0], end="")
PY
)
fi
[[ -n $NODE ]] || { echo "could not find exactly one qcom,wcn3990-bt node in $dtb" >&2; exit 1; }

# shellcheck disable=SC2086
fdtput -t bx "$dtb" "$NODE" local-bd-address $DIPPER_BT_BD_LE

got=$(fdtget -t bx "$dtb" "$NODE" local-bd-address | tr -s ' ')
want=$(printf '%s' "$DIPPER_BT_BD_LE" | tr -s ' ')
# fdtget prints 0x-prefixed bytes; normalise both sides before comparing.
norm() { python3 -c "
import sys
print(' '.join(f'{int(x,16):02x}' for x in sys.stdin.read().split()))"; }
[[ $(norm <<<"$got") == $(norm <<<"$want") ]] || {
  echo "the address did not take: wrote '$want', read back '$got'" >&2; exit 1; }

echo "local-bd-address written into $NODE and verified"
