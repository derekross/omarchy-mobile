#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Build a RAM-only Dipper probe: an initramfs (in an aarch64 container), then
# an Android v1 boot image with the DTB appended to the kernel. This tool does
# not flash or push anything to a phone.
#
# Needs: the kernel already built in $KERNEL_SRC (Image.gz, the dipper DTB and
# modules), docker with arm64 emulation registered, zopfli, and SSH_PUBKEY.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
repo=$(cd "$here/../.." && pwd)

KERNEL_DIR=${KERNEL_DIR:-$repo/../linux}
KERNEL_OUT=${KERNEL_OUT:-$KERNEL_DIR}
OUT=${OUT:-$repo/../out/dipper}
: "${SSH_PUBKEY:?set SSH_PUBKEY to your authorized public key}"
ALPINE=${ALPINE:-alpine:3.22}

die() { echo "error: $*" >&2; exit 1; }

[[ -d $KERNEL_DIR && -d $KERNEL_OUT ]] || die "set KERNEL_DIR and KERNEL_OUT to the kernel source and build directories"
image=$KERNEL_OUT/arch/arm64/boot/Image.gz
dtb=$KERNEL_OUT/arch/arm64/boot/dts/qcom/sdm845-xiaomi-dipper.dtb
[[ -f $image ]] || die "no $image -- build the kernel first"
[[ -f $dtb ]] || die "no $dtb -- build qcom/sdm845-xiaomi-dipper.dtb first"
[[ -r $SSH_PUBKEY ]] || die "no SSH public key at $SSH_PUBKEY (set SSH_PUBKEY)"
grep -q '^ssh-' "$SSH_PUBKEY" || die "$SSH_PUBKEY is not an OpenSSH public key"
command -v docker >/dev/null || die "docker is needed for the aarch64 initramfs"

release=$(cat "$KERNEL_OUT/include/config/kernel.release")
echo "kernel release: $release"

umask 077
mkdir -p "$OUT"; chmod 700 "$OUT"
mods=$OUT/modules
echo "installing modules into $mods"
rm -rf "$mods/lib/modules/$release"
make -C "$KERNEL_DIR" ARCH=arm64 LLVM=1 O="$KERNEL_OUT" \
     INSTALL_MOD_PATH="$mods" INSTALL_MOD_STRIP=1 modules_install >/dev/null
mkdir -p "$OUT/include/config"
cp "$KERNEL_OUT/include/config/kernel.release" "$OUT/include/config/kernel.release"
tar -C "$mods/lib/modules" --owner=0 --group=0 --numeric-owner -cf - "$release" \
  | zstd -q -19 -T0 -f -o "$OUT/modules-$release.tar.zst"

echo "building the initramfs in $ALPINE (linux/arm64)"
docker run --rm --platform linux/arm64 \
  -v "$repo:/src:ro" -v "$mods:/modules:ro" -v "$SSH_PUBKEY:/input/key.pub:ro" \
  -v "$OUT:/out" \
  -e "KERNEL_RELEASE=$release" -e "OUT_UID=$(id -u)" -e "OUT_GID=$(id -g)" \
  "$ALPINE" sh /src/tools/dipper/initramfs-inside.sh

# Pack a copy of the DTB so nothing we do can dirty the kernel tree.
packdtb=$OUT/sdm845-xiaomi-dipper.dtb
cp "$dtb" "$packdtb"
kernel_image=$image
if command -v zopfli >/dev/null; then
  echo "compressing the kernel with zopfli for dipper's ABL size limit"
  zopfli -c --i1 "$KERNEL_OUT/arch/arm64/boot/Image" > "$OUT/Image.gz"
  kernel_image=$OUT/Image.gz
fi
# A failed size check must not leave an older boot.img under the current name.
rm -f "$OUT/images/boot.img" "$OUT/images/BOOT-MANIFEST.json"
"$here/build-boot.py" --kernel "$kernel_image" --dtb "$packdtb" \
  --ramdisk "$OUT/initramfs.cpio.gz" --out "$OUT/images"

# Firmware and the Wi-Fi fix-ups are not part of the boot image; they go into the
# root filesystem. Collect them beside it so one directory holds everything.
if [[ -n ${FIRMWARE_DIR:-} ]]; then
  fw=$FIRMWARE_DIR
  [[ -d $fw ]] || die "FIRMWARE_DIR does not exist: $fw"
  mkdir -p "$OUT/firmware"
  # The blobs come off the phone mode 400, so a plain cp cannot overwrite them
  # on a rebuild. Copy without preserving the mode and make them readable.
  for d in qcom ath10k; do
    [[ -d $fw/$d ]] || continue
    rm -rf "$OUT/firmware/$d"
    cp -r --no-preserve=mode "$fw/$d" "$OUT/firmware/"
  done
  chmod -R u+rwX "$OUT/firmware"
  echo "firmware staged in $OUT/firmware"
else
  echo "note: FIRMWARE_DIR is unset; firmware-dependent Wi-Fi will not come up"
fi

echo
echo "artefacts in $OUT/images:"
ls -l "$OUT/images"
cat <<'NOTE'

To try it without writing to the phone (nothing persists):

    fastboot boot boot.img

Do not flash this image. Dipper has no second OS slot and this RAM-only path
has no persistent update or recovery flow.
NOTE
