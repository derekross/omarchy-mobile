#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copy a file to the phone in verified chunks, then optionally write it to a
# partition -- refusing at every step unless the checksum matches.
#
# Why chunks: a single 47 MB stream over the relayed link has silently truncated
# at 32 MiB, and an unverified truncated image written to a partition is exactly
# the mistake this tool exists to make impossible.
set -euo pipefail

HOST=${HOST:-mi8}
SU=${SU:-/debug_ramdisk/su}
REMOTE_DIR=${REMOTE_DIR:-/data/user/0/org.galexander.sshd/files}
CHUNK_MB=${CHUNK_MB:-4}
RETRIES=${RETRIES:-3}

src=${1:?usage: push-verified <file> [--to-partition <name>]}
part=""
if [[ ${2:-} == --to-partition ]]; then part=${3:?partition name}; fi

[[ -f $src ]] || { echo "no such file: $src" >&2; exit 1; }
size=$(stat -c%s "$src")
want=$(sha256sum "$src" | cut -d' ' -f1)
chunk=$((CHUNK_MB * 1024 * 1024))
n=$(( (size + chunk - 1) / chunk ))
base=$(basename "$src")
remote=$REMOTE_DIR/$base

echo "$src: $size bytes, $n chunk(s) of ${CHUNK_MB} MiB, sha256 ${want:0:16}…"
ssh "$HOST" "rm -f '$remote' '$remote'.part" >/dev/null 2>&1 || true

for ((i = 0; i < n; i++)); do
  off=$((i * chunk))
  len=$chunk
  (( off + len > size )) && len=$((size - off))
  csum=$(dd if="$src" bs=1M skip=$((i * CHUNK_MB)) count=$CHUNK_MB 2>/dev/null | sha256sum | cut -d' ' -f1)
  ok=0
  for ((try = 1; try <= RETRIES; try++)); do
    dd if="$src" bs=1M skip=$((i * CHUNK_MB)) count=$CHUNK_MB 2>/dev/null |
      ssh "$HOST" "dd of='$remote'.part bs=1M 2>/dev/null" || true
    got=$(ssh "$HOST" "sha256sum '$remote'.part 2>/dev/null | cut -d' ' -f1" | tr -d '\r\n')
    if [[ $got == "$csum" ]]; then ok=1; break; fi
    echo "  chunk $((i + 1))/$n attempt $try mismatched; retrying" >&2
  done
  (( ok )) || { echo "chunk $((i + 1))/$n failed after $RETRIES attempts" >&2; exit 1; }
  ssh "$HOST" "cat '$remote'.part >> '$remote' && rm -f '$remote'.part"
  printf '\r  %d/%d chunks verified' "$((i + 1))" "$n"
done
echo

got_size=$(ssh "$HOST" "stat -c%s '$remote'" | tr -d '\r\n')
got_sum=$(ssh "$HOST" "sha256sum '$remote' | cut -d' ' -f1" | tr -d '\r\n')
[[ $got_size == "$size" && $got_sum == "$want" ]] || {
  echo "whole-file check failed on the phone: $got_size bytes, ${got_sum:0:16}…" >&2; exit 1; }
echo "uploaded and verified: $remote"

[[ -n $part ]] || exit 0

echo "writing to the $part partition"
blocks=$(( (size + 4095) / 4096 ))
(( size % 4096 == 0 )) || { echo "image is not a multiple of 4096; refusing" >&2; exit 1; }
ssh "$HOST" "$SU -c \"
dev=\\\$(readlink -f /dev/block/by-name/$part)
[ -n \\\"\\\$dev\\\" ] || { echo 'no such partition: $part' >&2; exit 1; }
psize=\\\$(blockdev --getsize64 \\\$dev)
[ \\\"\\\$psize\\\" -ge $size ] || { echo \\\"image $size exceeds \\\$dev (\\\$psize)\\\" >&2; exit 1; }
dd if='$remote' of=\\\$dev bs=1M conv=fsync 2>/dev/null
dd if=\\\$dev bs=4096 count=$blocks 2>/dev/null | sha256sum | cut -d' ' -f1
\"" | tr -d '\r\n' | {
  read -r back
  if [[ $back == "$want" ]]; then
    echo "$part written and read back byte-exact"
  else
    echo "READ-BACK MISMATCH: partition holds ${back:0:16}…, expected ${want:0:16}…" >&2
    exit 1
  fi
}
ssh "$HOST" "rm -f '$remote'"
