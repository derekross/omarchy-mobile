#!/bin/bash
# SPDX-License-Identifier: MIT
# The checks a linux-omarchy-mobile pull request must pass before review
# (CONTRIBUTING.md section 6.2), on the commits between BASE and HEAD of a
# kernel tree:
#
#   - every commit has a human Signed-off-by, one of them the author's (the
#     DCO), and none from an AI agent (an Assisted-by tag credits it);
#   - every subject has a subsystem prefix ("clk: samsung: ...");
#   - scripts/checkpatch.pl --strict on each commit, against that commit's
#     bindings and MAINTAINERS: errors fail, warnings
#     are listed;
#   - tools/pr-check's policy checks: identifiers, blobs;
#   - with --build OUT: each touched C file builds with W=1 (arm64, LLVM,
#     defconfig plus kernel/configs/omamobile.config), every touched
#     device tree builds with W=1 and passes dtbs_check with no warning the
#     base didn't have (on a board the base lacks, none that a board in its
#     directory doesn't have there, but for the board's name; those are
#     listed), each touched overlay (.dtso) builds and applies to
#     its board with no new dt-validate warning, and touched bindings pass
#     dt_binding_check. Needs
#     clang, ld.lld and, for the schema checks, dtschema (`pip install
#     dtschema`); a missing tool skips its check and says so.
#
#   tools/kernel-pr-check [-C KERNEL] [--build OUT] [--merge] BASE [HEAD]
#
# KERNEL defaults to ~/android/mainline/linux, HEAD to HEAD. It reads git and
# builds in OUT (and OUT-base, for the base's device trees); it never
# touches the tree's checkout or anything else.
#
# --merge builds what would land: HEAD merged onto BASE (a test merge,
# written as git objects only), compared with BASE itself. The commit checks
# still read only HEAD's own commits. Without it the builds compare HEAD
# with its merge base, so a fix that reached BASE after the branch was cut
# never shows (L-154). A merge that conflicts fails with "rebase needed".
set -uo pipefail
# sort and comm must agree on the order, whatever the caller's locale.
export LC_ALL=C
self=$(readlink -f "${BASH_SOURCE[0]}")
repo=$(cd -- "$(dirname -- "$self")/.." && pwd)
kernel=$HOME/android/mainline/linux
out=""
merge=0
while (($#)); do
  case $1 in
    -C) kernel=${2:?-C needs a kernel tree}; shift 2 ;;
    --build) out=${2:?--build needs an output directory}; shift 2 ;;
    --merge) merge=1; shift ;;
    -h|--help) sed -n '3,35p' "$self"; exit 0 ;;
    -*) echo "kernel-pr-check: unknown option $1" >&2; exit 2 ;;
    *) break ;;
  esac
done
base=${1:?Usage: kernel-pr-check [-C KERNEL] [--build OUT] [--merge] BASE [HEAD]}
head=${2:-HEAD}
# -C may be relative to the caller's directory. This script changes into
# the tree and then runs pr-check with the same path, so resolve it first.
# Otherwise `kernel-pr-check -C linux` looks for linux/linux.
if [[ ! -d $kernel ]]; then
  echo "kernel-pr-check: no such tree $kernel" >&2
  exit 2
fi
kernel=$(CDPATH='' cd -- "$kernel" && pwd)
# --build too: the builds run after the cd, and they delete and re-extract
# directories under OUT, so OUT must never resolve inside the kernel tree.
if [[ -n $out ]]; then
  out=$(realpath -m -- "$out")
  case $out/ in
    "$kernel"/*) echo "kernel-pr-check: --build $out is inside the kernel tree; use a directory outside it" >&2; exit 2 ;;
  esac
  mkdir -p -- "$out" || { echo "kernel-pr-check: can't create $out" >&2; exit 2; }
fi
cd -- "$kernel" || exit 2
[[ -x scripts/checkpatch.pl ]] || { echo "kernel-pr-check: $kernel is not a kernel tree" >&2; exit 2; }
mb=$(git merge-base "$base" "$head") || { echo "kernel-pr-check: $base and $head share no history" >&2; exit 2; }
range="$mb..$head"
commits=$(git rev-list --reverse --no-merges "$range")
[[ -n $commits ]] || { echo "ok - no commits to check"; exit 0; }

fails=0
fail() { echo "not ok - $*"; fails=$((fails + 1)); }
pass() { echo "ok - $*"; }
skip() { echo "ok - $* # SKIP"; }
ai='claude|anthropic|openai|chatgpt|codex|copilot|gemini|cursor|llm|\[bot\]'

# What the builds compare: HEAD with its merge base, or with --merge the
# test merge of HEAD onto BASE with BASE. A conflict fails and skips the
# builds; the commit checks still run.
build_head=$head build_base=$mb
mdir=""
if ((merge)); then
  # The test merge's objects go to a scratch object directory, with the
  # tree's own as an alternate: the tree is never written (CI and the review
  # container mount it read-only).
  mdir=$(mktemp -d)
  trap 'rm -rf "$mdir"' EXIT
  GIT_ALTERNATE_OBJECT_DIRECTORIES=$(cd -- "$(git rev-parse --git-common-dir)" && pwd)/objects${GIT_ALTERNATE_OBJECT_DIRECTORIES:+:$GIT_ALTERNATE_OBJECT_DIRECTORIES}
  export GIT_OBJECT_DIRECTORY=$mdir GIT_ALTERNATE_OBJECT_DIRECTORIES
  mtree=$(git merge-tree --write-tree --name-only "$base" "$head" 2>&1); st=$?
  if ((st == 1)); then
    fail "rebase needed: $(git rev-parse --short "$head") doesn't merge cleanly onto $(git rev-parse --short "$base"); conflicts in:
$(sed -n '2,/^$/p' <<<"$mtree" | sed '/^$/d; s/^/    /')"
    out=""
  elif ((st)); then
    echo "kernel-pr-check: git merge-tree failed: $mtree" >&2; exit 2
  else
    build_head=$(GIT_AUTHOR_NAME=kernel-pr-check GIT_AUTHOR_EMAIL=kernel-pr-check@invalid \
      GIT_COMMITTER_NAME=kernel-pr-check GIT_COMMITTER_EMAIL=kernel-pr-check@invalid git commit-tree -p "$(git rev-parse "$base")" -p "$(git rev-parse "$head")" \
      -m "kernel-pr-check: test merge" "$(head -1 <<<"$mtree")") || exit 2
    build_base=$base
    pass "merges cleanly onto $(git rev-parse --short "$base") (test merge $(git rev-parse --short "$build_head"))"
  fi
fi

# ---------------------------------------------------------------- commits
sob_bad="" prefix_bad=""
for c in $commits; do
  short=$(git log -1 --format='%h %s' "$c")
  author=$(git log -1 --format='%ae' "$c")
  sobs=$(git log -1 --format=%B "$c" | grep -E '^Signed-off-by: ' || true)
  human=$(grep -viE "$ai" <<<"$sobs" || true)
  if [[ -z $human ]]; then
    sob_bad+="  $short: no human Signed-off-by"$'\n'
  elif ! grep -qiF "<$author>" <<<"$human"; then
    sob_bad+="  $short: no Signed-off-by from the author <$author>"$'\n'
  fi
  grep -qiE "$ai" <<<"$sobs" && sob_bad+="  $short: a Signed-off-by from an AI agent"$'\n'
  subject=$(git log -1 --format=%s "$c")
  [[ $subject =~ ^[A-Za-z0-9_./,+-]+(:[[:space:]][A-Za-z0-9_./,+-]+)*:[[:space:]] ]] || prefix_bad+="  $short"$'\n'
done
n=$(wc -w <<<"$commits")
[[ -z $sob_bad ]] && pass "$n commits signed off by their authors, none by an AI" || fail "sign-offs (Documentation/process/submitting-patches.rst, coding-assistants.rst):
${sob_bad%$'\n'}"
[[ -z $prefix_bad ]] && pass "subjects have subsystem prefixes" || fail "subjects without a subsystem prefix (see git log --oneline <file>):
${prefix_bad%$'\n'}"

# ---------------------------------------------------------------- checkpatch
# checkpatch as the base has it: a pull request can't change its own checker.
cpdir=$(mktemp -d)
trap 'rm -rf "$cpdir" ${mdir:+"$mdir"}' EXIT
mkdir -p "$cpdir/checker" "$cpdir/tree/Documentation"
git archive "$mb" scripts/checkpatch.pl scripts/spelling.txt scripts/const_structs.checkpatch 2>/dev/null | tar -x -C "$cpdir/checker" \
  || git archive "$mb" scripts/checkpatch.pl | tar -x -C "$cpdir/checker"
# Its tree is the kernel's, except for what it checks a patch against: the
# bindings (an undocumented compatible) and MAINTAINERS come from the commit
# itself, so a binding added earlier in the same pull request counts. With
# the checked-out tree, every new compatible read as undocumented (L-30).
for e in "$kernel"/* "$kernel"/.[!.]*; do
  [[ -e $e ]] || continue
  case ${e##*/} in Documentation|MAINTAINERS|.git) continue ;; esac
  ln -s "$e" "$cpdir/tree/${e##*/}"
done
for e in "$kernel"/Documentation/*; do
  [[ ${e##*/} == devicetree ]] || ln -s "$e" "$cpdir/tree/Documentation/${e##*/}"
done
cp_errors="" cp_warnings="" cp_count=0
for c in $commits; do
  rm -rf "$cpdir/tree/Documentation/devicetree" "$cpdir/tree/MAINTAINERS"
  docs=$(git ls-tree --name-only "$c" Documentation/devicetree MAINTAINERS)
  [[ -n $docs ]] && git archive "$c" $docs | tar -x -C "$cpdir/tree"
  report=$(git format-patch -1 --stdout "$c" | perl "$cpdir/checker/scripts/checkpatch.pl" --root="$cpdir/tree" --strict --no-signoff --terse --show-types - 2>/dev/null)
  short=$(git log -1 --format='%h %s' "$c")
  errors=$(grep -E ': ERROR:' <<<"$report" || true)
  [[ -n $errors ]] && cp_errors+="  $short"$'\n'"$(sed 's/^/    /' <<<"$errors")"$'\n'
  warnings=$(grep -E ': (WARNING|CHECK):' <<<"$report" || true)
  if [[ -n $warnings ]]; then
    cp_count=$((cp_count + $(wc -l <<<"$warnings")))
    cp_warnings+="#   $short"$'\n'"$(sed -E -e 's/^-:[0-9]+: /#     /' -e "s,$cpdir/tree/,," <<<"$warnings")"$'\n'
  fi
done
[[ -z $cp_errors ]] && pass "checkpatch --strict: no errors ($cp_count warnings and checks to read)" || fail "checkpatch --strict errors:
${cp_errors%$'\n'}"
# The warnings themselves, so a reviewer reads them without rerunning it.
[[ -n $cp_warnings ]] && printf '%s' "$cp_warnings"

# ---------------------------------------------------------------- policy
policy=$("$repo/tools/pr-check" -C "$kernel" "$base" "$head" 2>&1); status=$?
if ((status == 0)); then
  pass "policy (tools/pr-check): identifiers, blobs"
else
  # pr-check's own "not ok" lines, and anything else it printed. A cd
  # failure does not start with "not ok", and dropping it hides the cause.
  printf '%s\n' "$policy"
  fails=$((fails + 1))
fi

# ---------------------------------------------------------------- builds
if [[ -n $out ]]; then
  changed=$(git diff --name-only --diff-filter=AM "$range")
  cfiles=$(grep -E '\.c$' <<<"$changed" || true)
  dts=$(grep -E '^arch/arm64/boot/dts/.*\.(dts|dtsi|dtso)$' <<<"$changed" || true)
  yamls=$(grep -E '^Documentation/devicetree/bindings/.*\.yaml$' <<<"$changed" || true)
  if ! command -v clang >/dev/null || ! command -v ld.lld >/dev/null; then
    skip "builds: no clang or ld.lld"
  else
    # A clean export of what's built and its base, so the tree's own checkout is never touched.
    src=$out/src srcb=$out/src-base
    rm -rf "$src" "$srcb"; mkdir -p "$src" "$srcb"
    git archive "$build_head" | tar -x -C "$src"
    k=(make -s -C "$src" O="$out/build" ARCH=arm64 LLVM=1 -j"$(nproc)")
    if "${k[@]}" defconfig >/dev/null 2>&1 \
       && (cd "$src" && KCONFIG_CONFIG="$out/build/.config" scripts/kconfig/merge_config.sh -m -O "$out/build" "$out/build/.config" "$repo/kernel/configs/omamobile.config" >/dev/null 2>&1) \
       && "${k[@]}" olddefconfig >/dev/null 2>&1; then
      bad=""
      for f in $cfiles; do
        log=$("${k[@]}" W=1 "${f%.c}.o" 2>&1) || { bad+="  $f"$'\n'"$(tail -5 <<<"$log" | sed 's/^/    /')"$'\n'; continue; }
        w=$(grep -E 'warning:' <<<"$log" || true)
        [[ -n $w ]] && bad+="  $f (W=1 warnings)"$'\n'"$(head -5 <<<"$w" | sed 's/^/    /')"$'\n'
      done
      if [[ -z $cfiles ]]; then skip "C builds: no C files touched"
      elif [[ -z $bad ]]; then pass "W=1 builds of $(wc -w <<<"$cfiles") touched C files"
      else fail "W=1 builds:
${bad%$'\n'}"; fi

      if [[ -n $dts ]]; then
        # The boards whose DTBs the touched files reach: every .dts in the
        # touched directories (a dtsi reaches its whole SoC family).
        dirs=$(xargs -n1 dirname <<<"$dts" | sort -u | sed 's|^arch/arm64/boot/dts/||')
        targets=$(for d in $dirs; do (cd "$src/arch/arm64/boot/dts" && ls "$d"/*.dts 2>/dev/null) | sed 's/\.dts$/.dtb/'; done | sort -u)
        check=""
        command -v dt-validate >/dev/null && check="CHECK_DTBS=y"
        # git archive stamps files with the commit's time: drop earlier
        # outputs so make rebuilds, and prints, every warning. The processed
        # schema goes too, or a reused OUT validates against an earlier
        # tree's bindings (kernel #32's own binding went unseen that way).
        rm -rf "$out/build/arch/arm64/boot/dts" "$out/build-base/arch/arm64/boot/dts" \
          "$out"/build{,-base}/Documentation/devicetree/bindings/processed-schema.json
        log=$("${k[@]}" W=1 $check $targets 2>&1); st=$?
        if ((st)); then
          fail "device trees don't build:
$(tail -8 <<<"$log" | sed 's/^/    /')"
        else
          git archive "$build_base" | tar -x -C "$srcb"
          kb=(make -s -C "$srcb" O="$out/build-base" ARCH=arm64 LLVM=1 -j"$(nproc)")
          cp "$out/build/.config" "$out/build-base/.config" 2>/dev/null || { mkdir -p "$out/build-base"; cp "$out/build/.config" "$out/build-base/.config"; }
          "${kb[@]}" olddefconfig >/dev/null 2>&1
          # Only the boards the base has. A board the pull request adds has
          # no rule there, and asking for it stopped the base build part-way,
          # wherever -j had got to: on CI's four cores zuma-husky was never
          # validated, so its known warnings read as new (kernel #108). -k
          # keeps a base that is broken for another reason (one a pull
          # request may be fixing) validating every board it can, and says
          # so: a board it couldn't build compares with nothing.
          btargets=$(for t in $targets; do [[ -e $srcb/arch/arm64/boot/dts/${t%.dtb}.dts ]] && echo "$t"; done)
          newboards=$(comm -13 <(echo "$btargets") <(echo "$targets"))
          blog="" bst=0
          [[ -n $btargets ]] && { blog=$("${kb[@]}" -k W=1 $check $btargets 2>&1); bst=$?; }
          # Positions go too: a pull request that adds lines above an
          # existing warning moves it without making it new. dt-validate's
          # messages ("x.dtb: /node: ...") say neither warning nor error,
          # and a filter on those words alone dropped every one of them.
          norm() { grep -E 'warning|Warning|error|\.dtbo?: ' | sed -E -e 's,^[^ ]*/arch/arm64/boot/dts/,,' -e 's,/[^ ]*/(src|src-base)/,,g' \
            -e 's/:[0-9]+(\.[0-9]+)?(-[0-9]+(\.[0-9]+)?)?:/:/' | sort -u; }
          # A message about one of the boards named in $1 (its own .dtb or
          # .dts leads the line) with that board's name, wherever it
          # appears, replaced by "<board>": felix's "gs201-felix.dtb: /
          # (google,gs201-felix): soc_id: ..." and panther's read the same.
          generic() {
            awk -v boards="$1" '
              function repl(str, from, to,   o, i) {
                o = ""
                while ((i = index(str, from)) > 0) { o = o substr(str, 1, i - 1) to; str = substr(str, i + length(from)) }
                return o str
              }
              BEGIN { n = split(boards, b, " ")
                for (i = 1; i <= n; i++) { s = b[i]; sub(/.*\//, "", s); sub(/\.dtb$/, "", s); isb[s] = 1 } }
              { if (match($0, /[A-Za-z0-9_+-]+\.dt[bs]:/)) {
                  s = substr($0, RSTART, RLENGTH - 5)
                  if (s in isb) $0 = repl($0, s, "<board>") }
                print }'
          }
          new=$(comm -13 <(norm <<<"$blog") <(norm <<<"$log"))
          # A new board has no base to compare with, so each of its messages
          # read as new, though most are its dtsi's or its siblings' (L-120).
          # One counts as known when a board in the same directory has the
          # same message at the base, word for word but the board's name:
          # same node, same property, same value. They are listed, not
          # hidden. A board the base has stays compared with itself.
          inherited=""
          if [[ -n $new && -n $newboards ]]; then
            bgen=$(norm <<<"$blog" | generic "$btargets" | sort -u)
            keep=""
            while IFS= read -r l; do
              g=$(generic "$newboards" <<<"$l")
              if [[ $g != "$l" ]] && grep -xF -- "$g" <<<"$bgen" >/dev/null; then inherited+="$l"$'\n'
              else keep+="$l"$'\n'; fi
            done <<<"$new"
            new=${keep%$'\n'}
          fi
          what="W=1${check:+ and dtbs_check}"
          [[ -z $check ]] && echo "# no dt-validate (pip install dtschema): dtbs_check skipped"
          if ((bst)); then
            echo "# the base's device trees don't all build ($(git rev-parse --short "$build_base")); compared with those that did:"
            grep -F '***' <<<"$blog" | tail -8 | sed 's/^/#   /'
          fi
          if [[ -z $new ]]; then pass "$(wc -w <<<"$targets") device trees build with $what, no new warnings"
          else fail "new device-tree warnings ($what):
$(head -15 <<<"$new" | sed 's/^/    /')"; fi
          if [[ -n $inherited ]]; then
            echo "# messages on new boards that a sibling has at the base (not counted):"
            sed 's/^/#   /' <<<"${inherited%$'\n'}"
          fi
        fi
      else
        skip "device trees: none touched"
      fi

      # A touched overlay is in no board's DTB, so the build above never
      # compiles it (kernel #32's went unbuilt by every gate, L-70). Each
      # is built and applied to its base: the board in its directory whose
      # name begins its own (gs201-felix-cover-touch.dtso on gs201-felix),
      # built with -@ so the overlay's labels resolve. With dt-validate the
      # result may add no warning its base doesn't have.
      for ov in $(grep -E '\.dtso$' <<<"$dts" || true); do
        d=${ov#arch/arm64/boot/dts/}; dir=$(dirname "$d"); stem=$(basename "$d" .dtso)
        board=""
        for b in "$src/arch/arm64/boot/dts/$dir"/*.dts; do
          b=$(basename "$b" .dts)
          [[ $stem == "$b"-* && ${#b} -gt ${#board} ]] && board=$b
        done
        if [[ -z $board ]]; then
          skip "overlay $d: no board in $dir whose name begins $stem"
          continue
        fi
        log=$("${k[@]}" W=1 "DTC_FLAGS_$board=-@" "$dir/$board.dtb" "$dir/$stem.dtbo" 2>&1) \
          || { fail "overlay $d doesn't build:
$(tail -8 <<<"$log" | sed 's/^/    /')"; continue; }
        dtbs=$out/build/arch/arm64/boot/dts/$dir
        log=$("$out/build/scripts/dtc/fdtoverlay" -i "$dtbs/$board.dtb" -o "$dtbs/$stem-applied.dtb" "$dtbs/$stem.dtbo" 2>&1) \
          || { fail "overlay $d doesn't apply to $board.dtb:
$(sed -e '/^$/d' -e 's/^/    /' <<<"$log")"; continue; }
        schema=$out/build/Documentation/devicetree/bindings/processed-schema.json
        if [[ -n $check && -f $schema ]]; then
          vnorm() { sed -E 's,^[^ ]*/,,; s,^[^:]*: ,,' | sort -u; }
          new=$(comm -13 <(dt-validate -s "$schema" "$dtbs/$board.dtb" 2>&1 | vnorm) \
                         <(dt-validate -s "$schema" "$dtbs/$stem-applied.dtb" 2>&1 | vnorm))
          if [[ -z $new ]]; then pass "overlay $d builds and applies to $board.dtb, no new dt-validate warnings"
          else fail "overlay $d on $board.dtb: new dt-validate warnings:
$(head -15 <<<"$new" | sed 's/^/    /')"; fi
        else
          pass "overlay $d builds and applies to $board.dtb (no dt-validate: not validated)"
        fi
      done

      if [[ -n $yamls ]]; then
        if command -v dt-doc-validate >/dev/null; then
          schemas=$(sed 's|^Documentation/devicetree/bindings/||' <<<"$yamls" | paste -sd:)
          log=$("${k[@]}" dt_binding_check DT_SCHEMA_FILES="$schemas" 2>&1); st=$?
          w=$(grep -E 'warning|error' <<<"$log" || true)
          ((st == 0)) && [[ -z $w ]] && pass "dt_binding_check on $(wc -w <<<"$yamls") bindings" || fail "dt_binding_check:
$(head -10 <<<"${w:-$log}" | sed 's/^/    /')"
        else
          skip "dt_binding_check: no dtschema (pip install dtschema)"
        fi
      fi
    else
      fail "the kernel config doesn't configure (defconfig plus omamobile.config)"
    fi
  fi
fi

if ((fails)); then
  echo "kernel-pr-check: $fails check(s) failed" >&2
  exit 1
fi
