#!/bin/bash
# SPDX-License-Identifier: MIT
# phone-provision: after a fresh install's first boot, put back what the root
# image can't carry: Google's firmware and vendor files (extracted here, on
# the laptop, from the user's own factory image) and this phone's own data
# (from the read-only backup taken before the reinstall, or on a first
# install the modem's board id and NV checksums). Runs as root on the phone
# over tools/phone-ssh. Every step is idempotent and prints what it wrote.
#
#   tools/phone-provision [options] FACTORY.zip
#   tools/phone-provision [options] --skip-extract     (backup only)
#   tools/phone-provision [options] --nv-backup DIR FACTORY.zip   (a first install)
#
# From the factory image (tools/extract-*; nothing Google's leaves the laptop
# except into this phone):
#   firmware     the AoC, Wi-Fi, Bluetooth, haptics, speaker amplifiers -> /usr/lib/firmware/updates
#   sensors      the AoC's sensor registry -> /usr/share/omamobile/sensors/registry
#   chroots      gnss and modem vendor trees -> /usr/lib/omamobile-vendor/<profile>
#                (and waves with --with-waves)
#   fingerprint  the HAL's Android tree -> /usr/lib/omamobile-fp/{root,MANIFEST,SOURCE}
#   camera       sensor and PHY data -> /usr/lib/firmware/omamobile/camera (needs
#                python with unicorn and pyelftools, ~/.cache/omamobile-venv;
#                without it, the backup's copies are used, and a first
#                install has none)
# From the backup (default ~/android/reference/phone-backup-20261013, made
# before the rename: its paths use the old names and are mapped to the new):
#   always       the modem's board id (var/lib/omamobile-vendor/modem/props.conf)
#                and NV checksums (etc/omamobile/modem-nv.sha256)
#   --restore-config  /etc/omamobile speaker, gnss, modem-sit, speaker-tuning settings
#   --restore-wifi    saved NetworkManager connections
#   --import-home     home screens, quick settings and widgets into the user's
#                     ~/.config/omamobile (ids renamed omandroid -> omamobile)
#   --fingerprint     the fingerprint state (Trusty secure storage, factory
#                     calibration, enrolment) -> /var/lib/omamobile-fp, with the
#                     fingerprint service stopped. It never starts the service:
#                     the first storageproxyd start needs the human's go
#                     (FINGERPRINT-PLAN F4)
# A first install (cheetah with no phone-config.tar in the backup directory;
# nothing here makes one, only the backup taken before the rename has it, so
# a later reinstall counts too) has no backup to restore from, so
# --nv-backup DIR is required, as on raven:
# the owner's read-only backup of the modem's partitions, taken and stored
# off the repository by the owner (device/cheetah/REINSTALL-RUNBOOK.md
# section 4a). Its SHA256SUMS must hold one "<sha256>  NAME.img" line for
# each of modem_a, modem_b, efs, efs_backup, modem_userdata and persist;
# those six lines become /etc/omamobile/modem-nv.sha256. The board id is
# androidboot.cdt_hwid in the phone's /proc/bootconfig (Android's init sets
# ro.boot.cdt_hwid from it), read and written on the phone into
# /var/lib/omamobile-vendor/modem/props.conf (root's, mode 600) as
# ro.boot.cdt_hwid and persist.vendor.modem.cdt_hwid (a props.conf already
# there keeps its other lines). The value is never printed and never leaves
# the phone; if it is missing, empty or not 0x and hex digits, the run stops
# before it writes anything. The camera data then comes from the
# factory extraction only. --restore-config, --restore-wifi, --import-home,
# --fingerprint, --force and --backup restore from a phone-config.tar and
# are refused there, and --nv-backup is refused when there is a
# phone-config.tar.
# Options:
#   --backup DIR   the backup directory      --user NAME   the phone's user
#   --work DIR     local staging (default ~/.cache/omamobile-provision; it holds
#                  Google's files and per-phone data, removed afterwards unless --keep)
#   --force        replace fingerprint state that differs from the backup
#   --dry-run      stage locally and print every extraction and push; touch
#                  nothing on the phone
#   -d DEV         cheetah (default) or raven. Raven (device/raven): the
#                  firmware (Wi-Fi, Bluetooth, the AoC, the speaker amplifiers),
#                  the AoC sensor registry and the gnss and modem chroots from
#                  the factory image; the modem's per-phone files, its board id
#                  (props.conf, from --getprop) and NV checksums (from
#                  --nv-backup); then the services cheetah's setup step
#                  enables, but speaker protection. No fingerprint or camera
#                  yet
#   --getprop FILE raven: stock Android's getprop capture (default
#                  ~/android/reference/raven-stock/getprop.txt)
#   --nv-backup DIR  the read-only NV backup with SHA256SUMS. Cheetah: a
#                  first install only (no default). Raven: default the
#                  newest ~/android/reference/raven-backup-*
# Test seams: PHONE_SSH, the command that runs a shell command on the phone
# (default tools/phone-ssh), and PHONE_BOOTCONFIG, the file on the phone
# that a first install reads the board id from (default /proc/bootconfig).
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
ROOT=$PWD

say() { printf '\e[1m==> %s\e[0m\n' "$*"; }
note() { printf '    %s\n' "$*"; }
die() { printf '\e[31merror:\e[0m %s\n' "$*" >&2; exit 1; }

backup=$HOME/android/reference/phone-backup-20261013
work=${XDG_CACHE_HOME:-$HOME/.cache}/omamobile-provision
getprop=$HOME/android/reference/raven-stock/getprop.txt
nv_backup=""
dry=0 skip_extract=0 fingerprint=0 import_home=0 restore_config=0 restore_wifi=0 waves=0 keep=0 force=0 backup_given=0
user="" factory="" device=cheetah
PHONE_SSH=${PHONE_SSH:-$ROOT/tools/phone-ssh}
bootconfig=${PHONE_BOOTCONFIG:-/proc/bootconfig}
while (($#)); do
  case $1 in
    --dry-run) dry=1 ;;
    --skip-extract) skip_extract=1 ;;
    --fingerprint) fingerprint=1 ;;
    --import-home) import_home=1 ;;
    --restore-config) restore_config=1 ;;
    --restore-wifi) restore_wifi=1 ;;
    --with-waves) waves=1 ;;
    --keep) keep=1 ;;
    --force) force=1 ;;
    --backup) backup=${2:?} backup_given=1; shift ;;
    --work) work=${2:?}; shift ;;
    --user) user=${2:?}; shift ;;
    -d) device=${2:?}; shift ;;
    --getprop) getprop=${2:?}; shift ;;
    --nv-backup) nv_backup=${2:?}; shift ;;
    -h|--help) awk 'NR > 2 && !/^#/ { exit } NR > 2 { sub(/^# ?/, ""); print }' "$ROOT/tools/phone-provision"; exit 0 ;;
    -*) die "unknown option $1" ;;
    *) [[ -z $factory ]] || die "one factory image only"; factory=$1 ;;
  esac
  shift
done
((skip_extract)) || [[ -n $factory ]] || die "give the factory image (FACTORY.zip), or --skip-extract"
[[ -z $factory || -f $factory ]] || die "no $factory"
[[ -n $factory ]] && factory=$(readlink -f "$factory")
[[ $device == cheetah || $device == raven ]] || die "unknown device $device (cheetah or raven)"
[[ $device == cheetah ]] || ((skip_extract == 0)) || die "-d $device needs the factory image"
# Raven's run does none of cheetah's backup and fingerprint steps: refuse
# their options rather than ignore them and report "Done"
if [[ $device == raven ]]; then
  unsupported=()
  ((fingerprint)) && unsupported+=(--fingerprint)
  ((import_home)) && unsupported+=(--import-home)
  ((restore_config)) && unsupported+=(--restore-config)
  ((restore_wifi)) && unsupported+=(--restore-wifi)
  ((waves)) && unsupported+=(--with-waves)
  ((force)) && unsupported+=(--force)
  ((backup_given)) && unsupported+=(--backup)
  ((${#unsupported[@]} == 0)) || die "-d raven doesn't support ${unsupported[*]} (cheetah only)"
fi

phone() { "$PHONE_SSH" "$@"; }

# board_id check|write: on the phone, find this phone's board id
# (androidboot.cdt_hwid in bootconfig; Android's init makes it
# ro.boot.cdt_hwid) and, for write, put it into props.conf there: root's,
# mode 600, through a temporary file renamed into place. A props.conf
# already there keeps its other lines (per-phone tweaks, as MODEM-PLAN
# M4.1h's command keeps them); the two keys go last. The value stays on the
# phone, where only shell builtins get it as an argument, so nothing here
# can print or log it. Exit status 3: no androidboot.cdt_hwid, or an empty
# one; 5: a value other than 0x and hex digits.
board_id() {
  phone "BOOTCONFIG='$bootconfig' ACTION=$1 sh -s" <<'SH'
set -eu
v=$(sed -n 's/^androidboot\.cdt_hwid[[:space:]]*=[[:space:]]*"\([^"]*\)"[[:space:]]*$/\1/p' "$BOOTCONFIG" 2>/dev/null | head -n 1) || v=
[ -n "$v" ] || exit 3
case $v in 0x?*) ;; *) exit 5 ;; esac
case ${v#0x} in *[!0-9a-fA-F]*) exit 5 ;; esac
[ "$ACTION" = write ] || exit 0
d=/var/lib/omamobile-vendor/modem
mkdir -p "$d"
t=$(mktemp "$d/.props.conf.XXXXXX")
trap 'rm -f "$t"' EXIT
if [ -e "$d/props.conf" ]; then
  grep -v -e '^ro\.boot\.cdt_hwid=' -e '^persist\.vendor\.modem\.cdt_hwid=' "$d/props.conf" > "$t" || [ $? = 1 ]
fi
printf 'ro.boot.cdt_hwid=%s\npersist.vendor.modem.cdt_hwid=%s\n' "$v" "$v" >> "$t"
chown 0:0 "$t"
chmod 600 "$t"
mv -f "$t" "$d/props.conf"
[ "$(stat -c %a:%u:%g "$d/props.conf")" = 600:0:0 ] || exit 4
[ "$(grep -c -e '^ro\.boot\.cdt_hwid=' -e '^persist\.vendor\.modem\.cdt_hwid=' "$d/props.conf")" = 2 ] || exit 4
[ "$(tail -n 2 "$d/props.conf")" = "$(printf 'ro.boot.cdt_hwid=%s\npersist.vendor.modem.cdt_hwid=%s' "$v" "$v")" ] || exit 4
SH
}

# --- Inputs ------------------------------------------------------------------
# A first install (cheetah, no phone-config.tar): the NV checksums come from
# the owner's read-only backup (--nv-backup, as on raven), the board id from
# the phone itself. The backup is checked here, before the phone is
# contacted; the board id as soon as the phone answers, before any push.
first_install=0
nv_images=(modem_a modem_b efs efs_backup modem_userdata persist)
if [[ $device == cheetah && ! -f $backup/phone-config.tar ]]; then
  [[ -n $nv_backup ]] ||
    die "no $backup/phone-config.tar. Without one (a first install, or a reinstall with no such backup), take the read-only backup of the modem's partitions and give it with --nv-backup DIR (device/cheetah/REINSTALL-RUNBOOK.md section 4a)"
  first_install=1
  unsupported=()
  ((fingerprint)) && unsupported+=(--fingerprint)
  ((import_home)) && unsupported+=(--import-home)
  ((restore_config)) && unsupported+=(--restore-config)
  ((restore_wifi)) && unsupported+=(--restore-wifi)
  ((force)) && unsupported+=(--force)
  ((backup_given)) && unsupported+=(--backup)
  ((${#unsupported[@]} == 0)) ||
    die "a first install (--nv-backup, no phone-config.tar) doesn't support ${unsupported[*]} (a restore from a phone-config.tar)"
  [[ $bootconfig =~ ^/[A-Za-z0-9_./-]+$ ]] || die "PHONE_BOOTCONFIG must be an absolute path of letters, digits and _ . / -"
  say "Checking the NV backup in $nv_backup"
  nv_sums=$nv_backup/SHA256SUMS
  [[ -f $nv_sums ]] || die "no $nv_sums (--nv-backup DIR: the read-only backup of the modem's partitions)"
  # exactly one line per image, in sha256sum's own format (the modem
  # profile compares its copies with these); the sums themselves aren't shown
  bad=()
  for p in "${nv_images[@]}"; do
    [[ $(grep -cE "^[0-9a-f]{64}  $p\\.img\$" "$nv_sums" || true) == 1 ]] || bad+=("$p.img")
  done
  ((${#bad[@]} == 0)) ||
    die "$nv_sums needs one '<sha256>  NAME.img' line for each of the six NV images; none or more than one for ${bad[*]}"
  note "SHA256SUMS: one line for each of ${nv_images[*]}"
fi

if [[ $device == cheetah ]] && ((first_install == 0)); then
[[ -z $nv_backup ]] ||
  die "--nv-backup is for a first install, with no phone-config.tar: $backup/phone-config.tar already holds this phone's board id and NV checksums (leave out --nv-backup)"
say "Checking the backup in $backup"
config_tar=$backup/phone-config.tar fp_tar=$backup/var-lib-omandroid-fp.tar
for f in "$config_tar" $( ((fingerprint)) && echo "$fp_tar"); do
  [[ -f $f ]] || die "no $f"
  if [[ -f $f.sha256 ]]; then
    [[ $(sha256sum < "$f" | cut -d' ' -f1) == "$(cut -d' ' -f1 < "$f.sha256")" ]] || die "$f doesn't match $f.sha256"
    note "$(basename "$f"): checksum matches"
  else
    note "$(basename "$f"): no .sha256 to check against"
  fi
done
fi

if ((dry)); then
  user=${user:-USER}
  note "dry run: the phone isn't contacted; the user is shown as '$user' (or --user)"
else
  say "Checking the phone"
  phone true || die "the phone doesn't answer at 172.16.42.1 (tools/phone-ssh)"
  if [[ -z $user ]]; then
    user=$(phone 'cat /var/lib/omamobile/firstboot/user 2>/dev/null' || true)
    [[ -n $user ]] || user=$(phone "getent passwd | awk -F: '\$3 >= 1000 && \$3 < 60000 {print \$1; exit}'")
  fi
  [[ $user =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "no user on the phone (or --user NAME)"
  phone "getent passwd '$user' >/dev/null" || die "no account '$user' on the phone"
  note "user $user, kernel $(phone 'uname -r')"
  if ((first_install)); then
    rc=0
    board_id check || rc=$?
    ((rc != 3)) || die "no androidboot.cdt_hwid in the phone's $bootconfig, or an empty one: the modem needs this phone's board id (nothing was written)"
    ((rc != 5)) || die "androidboot.cdt_hwid in the phone's $bootconfig isn't 0x and hex digits (not shown): the modem needs this phone's board id (nothing was written)"
    ((rc == 0)) || die "couldn't read the phone's $bootconfig"
    note "board id: androidboot.cdt_hwid is in the phone's $bootconfig (not shown)"
  fi
fi

mkdir -p "$work"
chmod 700 "$work"
W=$(mktemp -d "$work/run.XXXXXX")
cleanup() { ((keep)) || rm -rf "$W"; }
trap cleanup EXIT

# Old names in the backup -> new. The old account's home becomes the user's.
map_path() {
  local p=$1
  p=${p/#home\/omandroid\//home\/$user\/}
  printf '%s' "${p//omandroid/omamobile}"
}

DID=()
# push_tree LOCAL_DIR PHONE_DEST [replace|merge] [owner]: put a staged tree
# on the phone. replace swaps each top-level entry of the tree in place
# (other files in PHONE_DEST stay); merge extracts over what's there.
# Ownership is root's (tar --no-same-owner), or owner's, chown'd after.
push_tree() {
  local src=$1 dest=$2 how=${3:-merge} owner=${4:-} n sums
  n=$(find "$src" -type f | wc -l)
  if ((dry)); then
    note "would push $n files to $dest ($how${owner:+, owned by $owner})"
    DID+=("would push $n files to $dest")
    return
  fi
  sums=$(cd "$src" && find . -type f -printf '%P\0' | sort -z | xargs -0r sha256sum)
  if [[ $how == replace ]]; then
    tar -C "$src" --owner=0 --group=0 --numeric-owner -cf - . | phone "set -e
      mkdir -p '$dest'; t=\$(mktemp -d '$dest/.provision.XXXXXX')
      tar -C \"\$t\" -xf - --no-same-owner
      for x in \$(ls -A \"\$t\"); do rm -rf '$dest'/\"\$x\"; mv \"\$t\"/\"\$x\" '$dest'/\"\$x\"; done
      rmdir \"\$t\""
  else
    tar -C "$src" --owner=0 --group=0 --numeric-owner -cf - . |
      phone "set -e; mkdir -p '$dest'; tar -C '$dest' -xf - --no-same-owner --no-overwrite-dir"
  fi
  if [[ -n $owner ]]; then
    (cd "$src" && find . -mindepth 1 -maxdepth 1 -printf '%P\n') | while read -r top; do
      phone "chown -R '$owner' '$dest/$top'"
    done
  fi
  phone "cd '$dest' && sha256sum -c --quiet" <<<"$sums" || die "the files in $dest don't match after the push"
  note "pushed $n files to $dest, verified"
  DID+=("pushed $n files to $dest")
}

# --- Raven: the firmware, the sensor registry and the services, nothing else --
if [[ $device == raven ]]; then
  say "Extracting from $(basename "$factory") (on this laptop)"
  if ((dry)); then
    note "would run: tools/extract-vendor-firmware -d raven -o $W/fw -w $W $factory"
  else
    tools/extract-vendor-firmware -d raven -o "$W/fw" -w "$W" "$factory" > "$W/extract.log" 2>&1 ||
      { tail -20 "$W/extract.log"; die "extraction failed"; }
    tools/extract-vendor-chroot -d raven -p gnss -o "$W/chroot-gnss" -w "$W" "$factory" > "$W/extract.log" 2>&1 ||
      { tail -20 "$W/extract.log"; die "extraction failed (gnss chroot)"; }
    tools/extract-vendor-chroot -d raven -p modem -o "$W/chroot-modem" -w "$W" "$factory" > "$W/extract.log" 2>&1 ||
      { tail -20 "$W/extract.log"; die "extraction failed (modem chroot)"; }
  fi
  # The modem's per-phone files, staged (never printed: the board id and
  # NV checksums identify this phone).
  [[ -f $getprop ]] || die "no stock getprop capture $getprop (--getprop)"
  if [[ -z $nv_backup ]]; then
    # the newest backup; none is fine until here (cheetah never needs one)
    backups=("$HOME"/android/reference/raven-backup-2*)
    [[ -e ${backups[0]} ]] && nv_backup=$(printf '%s\n' "${backups[@]}" | sort | tail -1)
  fi
  [[ -f $nv_backup/SHA256SUMS ]] || die "no NV backup with SHA256SUMS in '${nv_backup}' (--nv-backup)"
  mkdir -p "$W/modem-stage/var/lib/omamobile-vendor/modem" "$W/modem-stage/etc/omamobile"
  props=$W/modem-stage/var/lib/omamobile-vendor/modem/props.conf
  for k in ro.boot.cdt_hwid ro.hardware ro.boot.hardware.platform; do
    v=$(sed -n "s/^\[$k\]: \[\(.*\)\]\$/\1/p" "$getprop" | head -1)
    [[ -n $v ]] || die "$getprop has no $k"
    printf '%s=%s\n' "$k" "$v" >> "$props"
    [[ $k == ro.boot.cdt_hwid ]] && printf 'persist.vendor.modem.cdt_hwid=%s\n' "$v" >> "$props"
  done
  chmod 600 "$props"
  # All six partitions the modem profile keeps read-only. It reads five
  # of them into RAM today (all but modem_b, the other slot's modem image,
  # which it never boots), but the file then matches the backup and
  # AGENTS.md's check.
  grep -E ' (modem_a|modem_b|efs|efs_backup|modem_userdata|persist)\.img$' "$nv_backup/SHA256SUMS" \
    > "$W/modem-stage/etc/omamobile/modem-nv.sha256"
  [[ $(wc -l < "$W/modem-stage/etc/omamobile/modem-nv.sha256") == 6 ]] || die "$nv_backup/SHA256SUMS lacks one of the six NV images"
  chmod 644 "$W/modem-stage/etc/omamobile/modem-nv.sha256"
  note "modem: board id from $(basename "$getprop"), NV checksums from $(basename "$nv_backup")"
  say "Pushing Google's files"
  if ((dry)); then
    note "would push the firmware tree to /usr/lib/firmware/updates"
    note "would replace the AoC sensor registry in /usr/share/omamobile/sensors/registry"
    note "would replace /usr/lib/omamobile-vendor/gnss/{root,MANIFEST,SOURCE,...}"
    note "would replace /usr/lib/omamobile-vendor/modem/{root,MANIFEST,SOURCE,...}"
    note "would write /var/lib/omamobile-vendor/modem/props.conf and /etc/omamobile/modem-nv.sha256"
  else
    push_tree "$W/fw/usr/lib/firmware/updates" /usr/lib/firmware/updates merge
    push_tree "$W/fw/usr/share/omamobile/sensors/registry" /usr/share/omamobile/sensors/registry replace
    push_tree "$W/chroot-gnss" /usr/lib/omamobile-vendor/gnss replace
    # the staging dir's private modes came along: the shell's location tile
    # (run as the user) checks that the chroot exists
    phone "chmod -R go+rX,go-w /usr/lib/omamobile-vendor/gnss"
    push_tree "$W/chroot-modem" /usr/lib/omamobile-vendor/modem replace
    push_tree "$W/modem-stage" / merge
  fi
  # Not omamobile-speaker-protection: its ceilings and calibration flow are
  # validated on cheetah's amplifiers only.
  say "Enabling the services cheetah's setup step enables, but speaker protection"
  units="omamobile-sensor-proxy.service omamobile-gnss-nmea.socket omamobile-gnss-lto.timer"
  if ((dry)); then
    note "would enable $units"
  else
    phone "for u in $units; do systemctl cat \$u >/dev/null 2>&1 && systemctl enable \$u >/dev/null 2>&1 && echo enabled \$u; done; true" |
      while read -r l; do note "$l"; done
  fi
  say "Done (raven)"
  for d in "${DID[@]}"; do note "$d"; done
  exit 0
fi

# --- From the factory image ----------------------------------------------------
camera_done=0
if ((skip_extract == 0)); then
  say "Extracting from $(basename "$factory") (on this laptop)"
  profiles=(gnss modem)
  ((waves)) && profiles+=(waves)
  py=python3
  [[ -x $HOME/.cache/omamobile-venv/bin/python ]] && py=$HOME/.cache/omamobile-venv/bin/python
  have_unicorn=0
  "$py" -c 'import unicorn, elftools' 2>/dev/null && have_unicorn=1
  extract() {
    if ((dry)); then note "would run: $*"; return; fi
    note "$*"
    "$@" > "$W/extract.log" 2>&1 || { tail -20 "$W/extract.log"; die "extraction failed: $*"; }
  }
  extract tools/extract-vendor-firmware -o "$W/fw" -c "$W/camera.apex" -w "$W" "$factory"
  for p in "${profiles[@]}"; do extract tools/extract-vendor-chroot -p "$p" -o "$W/chroot-$p" -w "$W" "$factory"; done
  extract tools/extract-fingerprint-vendor -o "$W/fp-vendor" -w "$W" "$factory"
  ((have_unicorn)) && extract "$py" tools/extract-camera-data --apex "$W/camera.apex" -d "$W/camera"
  ((have_unicorn || first_install)) || note "no unicorn/pyelftools for $py: camera data comes from the backup instead"
  if ((first_install)); then
    ((have_unicorn)) && note "camera data: from the factory image only (no phone-config.tar to fall back on)"
    ((have_unicorn)) || note "no unicorn/pyelftools for $py: no camera data (no phone-config.tar to fall back on)"
  fi

  say "Pushing Google's files"
  if ((dry)); then
    note "would push the firmware tree to /usr/lib/firmware/updates"
    note "would replace the AoC sensor registry in /usr/share/omamobile/sensors/registry"
    for p in "${profiles[@]}"; do note "would replace /usr/lib/omamobile-vendor/$p/{root,MANIFEST,SOURCE,...}"; done
    note "would replace /usr/lib/omamobile-fp/{root,MANIFEST,SOURCE}"
    ((have_unicorn)) && note "would push the camera data to /usr/lib/firmware/omamobile/camera" && camera_done=1
  else
    push_tree "$W/fw/usr/lib/firmware/updates" /usr/lib/firmware/updates merge
    push_tree "$W/fw/usr/share/omamobile/sensors/registry" /usr/share/omamobile/sensors/registry replace
    for p in "${profiles[@]}"; do push_tree "$W/chroot-$p" "/usr/lib/omamobile-vendor/$p" replace; done
    push_tree "$W/fp-vendor" /usr/lib/omamobile-fp replace
    if ((have_unicorn)); then
      mkdir -p "$W/camera-stage" && cp "$W"/camera/*.bin "$W/camera-stage/"
      push_tree "$W/camera-stage" /usr/lib/firmware/omamobile/camera merge
      camera_done=1
    fi
  fi
fi

# --- A first install: the modem's per-phone files ------------------------------
if ((first_install)); then
  say "Writing this phone's modem files (a first install: no phone-config.tar)"
  ((skip_extract)) && note "camera data: none from this run (--skip-extract, and no phone-config.tar to take it from); camera files already on the phone stay"
  mkdir -p "$W/modem-stage/etc/omamobile"
  nv_re=$(IFS='|'; echo "${nv_images[*]}")
  grep -E "^[0-9a-f]{64}  ($nv_re)\\.img\$" "$nv_sums" > "$W/modem-stage/etc/omamobile/modem-nv.sha256"
  chmod 644 "$W/modem-stage/etc/omamobile/modem-nv.sha256"
  note "/etc/omamobile/modem-nv.sha256: the six NV lines of $nv_sums"
  push_tree "$W/modem-stage" / merge
  props_file=/var/lib/omamobile-vendor/modem/props.conf
  if ((dry)); then
    note "would write $props_file (root's, mode 600) on the phone, from androidboot.cdt_hwid in its $bootconfig"
    DID+=("would write $props_file")
  else
    rc=0
    board_id write || rc=$?
    ((rc != 3)) || die "no androidboot.cdt_hwid in the phone's $bootconfig, or an empty one: $props_file not written"
    ((rc != 5)) || die "androidboot.cdt_hwid in the phone's $bootconfig isn't 0x and hex digits (not shown): $props_file not written"
    ((rc == 0)) || die "writing $props_file on the phone failed"
    note "wrote $props_file on the phone from its $bootconfig (root's, mode 600; the board id isn't shown)"
    DID+=("wrote $props_file (the board id)")
  fi
fi

# --- From the backup -----------------------------------------------------------
if ((first_install == 0)); then
say "Restoring this phone's data from the backup"
mkdir -p "$W/backup" "$W/stage"
tar -C "$W/backup" -xf "$config_tar" --no-same-owner
# What to take, as paths inside the backup
take=(var/lib/omandroid-vendor/modem/props.conf etc/omandroid/modem-nv.sha256)
if ((camera_done == 0)); then
  while read -r f; do take+=("$f"); done < <(cd "$W/backup" && find usr/lib/firmware/omandroid/camera -name '*.bin' 2>/dev/null | sort)
fi
if ((restore_config)); then
  for f in speaker gnss modem-sit speaker-tuning; do
    [[ -f $W/backup/etc/omandroid/$f.conf ]] && take+=("etc/omandroid/$f.conf")
  done
fi
if ((restore_wifi)); then
  while read -r f; do take+=("$f"); done < <(cd "$W/backup" && find etc/NetworkManager/system-connections -name '*.nmconnection' 2>/dev/null | sort)
fi
for f in "${take[@]}"; do
  [[ -f $W/backup/$f ]] || die "the backup has no $f"
  new=$(map_path "$f")
  install -D -m "$(stat -c %a "$W/backup/$f")" "$W/backup/$f" "$W/stage/$new"
  note "$f -> /$new"
done
push_tree "$W/stage" / merge
fi

if ((import_home)); then
  say "Importing home screens, quick settings and widgets for $user"
  src=$W/backup/home/omandroid/.config/omandroid
  [[ -d $src ]] || die "the backup has no home/omandroid/.config/omandroid"
  home_stage=$W/home/.config/omamobile
  mkdir -p "$home_stage"
  for f in home.json quicksettings.json widget-guard.json widgets; do
    [[ -e $src/$f ]] || continue
    cp -a "$src/$f" "$home_stage/"
    note "home/omandroid/.config/omandroid/$f -> /$(map_path "home/omandroid/.config/omandroid/$f")"
  done
  # Plugin and widget ids carried the old name
  while IFS= read -r -d '' f; do
    if grep -q -i omandroid "$f"; then
      sed -i 's/omandroid/omamobile/g; s/Omandroid/Omamobile/g; s/OMANDROID/OMAMOBILE/g' "$f"
      note "renamed ids in ${f#"$W/home/"}"
    fi
  done < <(find "$W/home" -type f \( -name '*.json' -o -name '*.qml' -o -name '*.js' \) -print0)
  if ((dry)); then
    push_tree "$W/home" "/home/$user" merge "$user:$user"
  else
    push_tree "$W/home" "$(phone "getent passwd '$user' | cut -d: -f6")" merge "$user:$user"
  fi
fi

if ((fingerprint)); then
  say "Fingerprint state"
  cat <<'WARN'
    !! The fingerprint state is Trusty's secure storage for this phone. This
    !! tool only copies it to /var/lib/omamobile-fp with the service stopped;
    !! it never starts omamobile-fp. The first storageproxyd start on it writes
    !! the phone's RPMB and is irreversible: it needs the human's explicit go
    !! (device/cheetah/FINGERPRINT-PLAN.md F4).
WARN
  mkdir -p "$W/fp"
  tar -C "$W/fp" -xf "$fp_tar" --no-same-owner
  [[ -d $W/fp/omandroid-fp ]] || die "$fp_tar has no omandroid-fp/"
  # Ownership is Android's (storageproxyd runs as AID_SYSTEM, 1000), so this
  # one tree keeps the backup's numeric owners, renamed paths and all.
  fp_list=$(tar -tf "$fp_tar" | sed 's|^omandroid-fp/||' | grep . || true)
  while read -r f; do note "/var/lib/omandroid-fp/$f -> /var/lib/omamobile-fp/$(map_path "$f")"; done <<<"$fp_list"
  if ((dry)); then
    note "would stop omamobile-fp.service, then restore $(wc -l <<<"$fp_list") entries to /var/lib/omamobile-fp"
    DID+=("would restore the fingerprint state")
  else
    if phone 'test -s /var/lib/omamobile-fp/persist-ss/0'; then
      remote=$(phone 'sha256sum /var/lib/omamobile-fp/persist-ss/0 | cut -d" " -f1')
      local_sum=$(tar -xOf "$fp_tar" omandroid-fp/persist-ss/0 | sha256sum | cut -d' ' -f1)
      if [[ $remote != "$local_sum" ]] && ((force == 0)); then
        die "/var/lib/omamobile-fp already holds different secure storage: not replacing it (--force)"
      fi
    fi
    phone 'systemctl stop omamobile-fp.service 2>/dev/null; systemctl is-active --quiet omamobile-fp.service && exit 1; true' ||
      die "omamobile-fp.service won't stop"
    # Rename the inner directory too, then stream with numeric owners kept
    python3 -I - "$fp_tar" "$W/fp.tar" <<'PY'
import sys, tarfile
src, dst = sys.argv[1], sys.argv[2]
with tarfile.open(src) as i, tarfile.open(dst, "w") as o:
    for m in i.getmembers():
        name = m.name
        if not name.startswith("omandroid-fp"):
            sys.exit(f"unexpected member {name}")
        name = name[len("omandroid-fp"):].lstrip("/") or "."
        m.name = name.replace("omandroid", "omamobile")
        o.addfile(m, i.extractfile(m) if m.isfile() else None)
PY
    phone 'set -e; mkdir -p /var/lib/omamobile-fp; tar -C /var/lib/omamobile-fp -xpf - --numeric-owner --same-owner' < "$W/fp.tar"
    phone 'chmod 0700 /var/lib/omamobile-fp; ls -ln /var/lib/omamobile-fp/persist-ss'
    note "restored; omamobile-fp.service stays stopped"
    DID+=("restored the fingerprint state (service stopped, not started)")
  fi
fi

say "Done"
for d in "${DID[@]}"; do note "$d"; done
((dry)) && note "dry run: nothing was changed on the phone" ||
  note "reboot the phone for the firmware to load (Wi-Fi, Bluetooth, haptics, speakers, camera)"
((keep)) && note "staging kept in $W (Google's files and per-phone data: delete it when done)"
true
