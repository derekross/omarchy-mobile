#!/bin/bash
# SPDX-License-Identifier: MIT
# Publish our kernel branch to github.com/derekross/linux-omarchy-mobile.
#
# Linux's full history is too big for a private repository (and a private repo
# can't be a fork of Linus's tree), so the published branch starts from one
# commit holding the exact upstream tag's tree, with our commits replayed on
# top unchanged. The trees are identical to the local branch, which keeps the
# real upstream history for sending patches.
#   tools/publish-kernel [branch] [upstream-tag]   (defaults: omamobile v7.3-rc6)
set -euo pipefail

# The kernel clone, its worktrees and build outputs live in KERNEL_BASE:
# ~/omamobile-kernel, or ~/android/mainline on setups from before 2026-10-29.
if [[ -z ${KERNEL_BASE:-} ]]; then
  KERNEL_BASE=$HOME/omamobile-kernel
  [[ -d $KERNEL_BASE || ! -d $HOME/android/mainline ]] || KERNEL_BASE=$HOME/android/mainline
fi
linux=${KERNEL_DIR:-$KERNEL_BASE/linux}
branch=${1:-omamobile}
tag=${2:-v7.3-rc6}
remote=git@github.com:derekross/linux-omarchy-mobile.git

cd "$linux"
[[ -z $(git status --porcelain --untracked-files=no) ]] || { echo "$linux has uncommitted changes" >&2; exit 1; }

tree=$(git rev-parse "$tag^{tree}")
base=$(GIT_AUTHOR_NAME="Linus Torvalds" GIT_AUTHOR_EMAIL="torvalds@linux-foundation.org" \
  GIT_AUTHOR_DATE="$(git log -1 --format=%aD "$tag")" GIT_COMMITTER_DATE="$(git log -1 --format=%aD "$tag")" \
  git commit-tree "$tree" -m "Linux ${tag#v}

The tree of Linus Torvalds' $tag tag ($(git rev-parse "$tag^{commit}")),
squashed so this repository stays small. Omarchy Mobile's changes follow as
individual commits; they apply unchanged on top of the upstream tag.")

# Published commit ids must stay put: pull requests are based on them, and a
# full replay gives every commit a new id. So when the published tip has the
# tree of a commit on the local branch, replay only the commits after it, on
# top of the published tip, and push a fast-forward. Only when no such commit
# exists (local history rewritten) is the branch rebuilt and force-pushed.
pub=
git fetch -q "$remote" "refs/heads/$branch" 2>/dev/null && pub=$(git rev-parse FETCH_HEAD)
from=
if [[ -n $pub ]]; then
  ptree=$(git rev-parse "$pub^{tree}")
  for c in $(git rev-list "$tag..$branch"); do
    [[ $(git rev-parse "$c^{tree}") == "$ptree" ]] && { from=$c; break; }
  done
fi

# Replay in a throwaway worktree, so no checkout in use changes.
work=$(mktemp -d)
trap 'git worktree remove --force "$work" >/dev/null 2>&1 || true' EXIT
git worktree add -q --detach "$work" "$branch"
if [[ -n $from ]]; then
  git -C "$work" rebase -q --onto "$pub" "$from"
else
  git -C "$work" rebase -q --onto "$base" "$tag"
fi
published=$(git -C "$work" rev-parse HEAD)

[[ -z $(git diff "$branch" "$published") ]] || { echo "Replayed tree differs from $branch; not publishing" >&2; exit 1; }
git branch -f "publish/$branch" "$published"
if [[ -n $from ]]; then
  git push "$remote" "publish/$branch:refs/heads/$branch"
  echo "Published $branch to $remote: $(git rev-list --count "$pub..$published") new commit(s), fast-forward"
else
  echo "No published commit matches $branch's history: rebuilding, which changes every published commit id" >&2
  git push --force "$remote" "publish/$branch:refs/heads/$branch"
  echo "Published $branch ($(git rev-list --count "$tag..$branch") commits on $tag) to $remote"
fi
