#!/bin/bash
# SPDX-License-Identifier: MIT
# A package's version, worked out from git: nobody writes the last number.
#
#   tools/pkg-version [--main REF] PACKAGE           the version to build HEAD at
#   tools/pkg-version [--main REF] --rev REV PACKAGE the version to build REV at
#   tools/pkg-version --history PACKAGE              "<commit> <version>" for every
#                                                    commit on main's line that
#                                                    touched the package
#   tools/pkg-version --history --count-from C PACKAGE  the same, as if every
#                                                    commit from C counted (tests
#                                                    replay history with it)
#   tools/pkg-version --commit PACKAGE VERSION       the commit that version was built from
#
# PACKAGE is a name (omamobile-shell) or its directory (packages/omamobile-shell).
#
# packages/<name>/version gives the series: its first two numbers (0.2). A
# third number, which PRs used to bump by hand, is read only as a floor: a
# version never goes below it, and a lower or equal one changes nothing. On
# main (the first-parent line of REF, default origin/main) every commit that
# touches packages/<name> is the next number in the series, so two merges can
# never ship one number with different contents, and a merge needs no version
# change at all. Writing a new series (0.3) starts it at 0 (or at its third
# number, if given).
#
# A commit counts only when its PKGBUILD reads .pkgver, the version this tool
# hands a build: the package opts in, not the tool. Before that the version
# file is the version, as it was published, and the first commit that opts in
# is the next number after it, so no published number comes back. Where this
# tool lives doesn't matter (moving it can't restart a count), and a package
# that keeps a written version (the kernel, the keyring, a device package that
# ships boot files) never counts.
#
# Off main, a build is main's version at the merge base, then the branch's
# own commits that touch the package and the commit: 0.2.130.1.g4f2a9c1.
# pacman orders that above 0.2.130 and below main's next 0.2.131, so a phone
# with a test build upgrades to the next published one. A branch that doesn't
# touch the package builds main's version. A package (or a series) that main
# doesn't have yet builds as 0.1.0pre1.g4f2a9c1, below main's first 0.1.0.
#
# Edits not committed yet (without --rev) add the package's tree as it
# stands: 0.2.130.d5e0b7a2, a new version for each edit, above the commit's
# and below the next one, so build-packages builds them and pacman takes
# them over the commit's build. A package not committed at all builds as
# 0.1.0pre0.d5e0b7a2.
#
# It needs the history: in a shallow clone or a copy without .git it refuses
# rather than guess. Tools that build from a copy (build-packages,
# repo-build, phone-install-package) run it here first and put the result in
# the copy as .pkgver, which the PKGBUILDs read before asking git.
#
# OMAMOBILE_MAIN_REF sets REF like --main. On a fork, point it at this
# repository's main (git fetch upstream; OMAMOBILE_MAIN_REF=upstream/main):
# a fork's own main that is behind gives branch builds that sort below the
# published packages.
set -euo pipefail
die() { echo "pkg-version: $*" >&2; exit 1; }

main=${OMAMOBILE_MAIN_REF:-} rev=HEAD explicit_rev='' mode=version want= count_from=
while (($#)); do
  case $1 in
    --main) main=${2:?--main needs a ref}; shift 2 ;;
    --rev) rev=${2:?--rev needs a commit} explicit_rev=1; shift 2 ;;
    --history) mode=history; shift ;;
    --count-from) count_from=${2:?--count-from needs a commit}; shift 2 ;;
    --commit) mode=commit; shift ;;
    -h|--help) source "$(dirname -- "${BASH_SOURCE[0]}")/lib/usage.sh"; usage_from_header "$0"; exit 0 ;;
    -*) die "unknown option $1" ;;
    *) break ;;
  esac
done
(($# >= 1)) || die "usage: tools/pkg-version [--main REF] [--rev REV] PACKAGE"
pkg=${1%/}; pkg=${pkg##*/}
[[ $mode != commit ]] || want=${2:?--commit needs PACKAGE VERSION}
# Only for a listing: a build's version never depends on it
[[ -z $count_from || $mode == history ]] || die "--count-from goes with --history only"
[[ $pkg =~ ^[a-z0-9][a-z0-9.+_-]*$ ]] || die "not a package name: $1"

# The repository: the package directory's, else this tool's.
if [[ -d $1 ]]; then dir=$1; else dir=$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")"); fi
top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) ||
  die "$1 is not in a git checkout: build from a clone, or pass the version as .pkgver"
cd -- "$top"
[[ $(git rev-parse --is-shallow-repository) == false ]] ||
  die "a shallow clone can't count versions: git fetch --unshallow"
path=packages/$pkg

if [[ -z $main ]]; then
  for main in origin/main main ''; do
    [[ -z $main ]] || git rev-parse -q --verify "$main^{commit}" >/dev/null && break
  done
  [[ -n $main ]] || main=$rev
fi
git rev-parse -q --verify "$rev^{commit}" >/dev/null || die "no such commit $rev"
git rev-parse -q --verify "$main^{commit}" >/dev/null || die "no such ref $main"

# "S Z" from a version file's text (Z empty when it gives only a series).
parse() {
  local v
  v=$(tr -d '[:space:]' <<<"$1")
  [[ $v =~ ^([0-9]+\.[0-9]+)(\.([0-9]+))?$ ]] || return 1
  echo "${BASH_REMATCH[1]} ${BASH_REMATCH[3]}"
}
file_at() { git show "$1:$path/version" 2>/dev/null; }

# Does commit F's PKGBUILD read .pkgver (its version counted)? With
# --count-from, every commit in FROM (filled by walk) counts instead.
counts() {
  if [[ -n $count_from ]]; then
    [[ -n ${from[$1]:-} ]]
    return
  fi
  git show "$1:$path/PKGBUILD" 2>/dev/null | grep -c -F '/.pkgver"' >/dev/null
}

# "<commit> <version>" for each commit on C's first-parent line touching the
# package, oldest first. A commit that doesn't count has its version file's
# number, as it was published.
walk() {
  local c=$1 f s z S="" v=-1
  local -A from=()
  if [[ -n $count_from ]]; then
    local k
    k=$(git rev-parse --verify "$count_from^{commit}") || die "no such commit $count_from"
    if git merge-base --is-ancestor "$k" "$c"; then
      while read -r f; do
        from[$f]=1
        [[ $f != "$k" ]] || break
      done < <(git rev-list --first-parent "$c")
    fi
  fi
  while read -r f; do
    read -r s z < <(parse "$(file_at "$f")") || continue
    if [[ $s == "$S" ]] && counts "$f"; then
      v=$((v + 1))
      [[ -z $z ]] || ((z <= v)) || v=$z
    else
      S=$s v=${z:-0}
    fi
    echo "$f $S.$v"
  done < <(git rev-list --first-parent --reverse "$c" -- "$path")
}

case $mode in
  history) walk "$main"; exit 0 ;;
  commit)
    # The whole walk first: leaving its pipe early would SIGPIPE it.
    mapfile -t lines < <(walk "$main")
    for l in "${lines[@]}"; do
      [[ ${l#* } != "$want" ]] || { echo "${l%% *}"; exit 0; }
    done
    die "$pkg $want was never built on $main" ;;
esac

# The package as it stands in the working tree, when that isn't HEAD's: a
# tree id over its tracked and new files (gitignored ones left out, as git
# leaves them), so each edit is its own version and a build of it is never
# taken for the commit's
worktree() {
  local idx t
  idx=$(mktemp -u)
  if ! { GIT_INDEX_FILE=$idx git read-tree HEAD && GIT_INDEX_FILE=$idx git add -A -- "$path" &&
    t=$(GIT_INDEX_FILE=$idx git write-tree); }; then
    rm -f "$idx"
    die "can't read the working tree of $path"
  fi
  rm -f "$idx"
  t=$(git rev-parse -q --verify "$t:$path") || return 0
  [[ $t == "$(git rev-parse -q --verify "HEAD:$path" || true)" ]] || echo "${t:0:7}"
}
local_edits=
[[ -n $explicit_rev ]] || local_edits=$(worktree)

# The version REV builds at, from the history alone
committed() {
  [[ -n $(git ls-tree "$rev" -- "$path/version") ]] || die "$path/version doesn't exist at $rev"
  # The history skips a version file that doesn't parse, so without this its
  # commit would build under the number before it
  parse "$(file_at "$rev")" >/dev/null || die "$path/version doesn't hold a version (0.2 or 0.2.5) at $rev"
  # On main's own line (its first parents), not merely reachable from it: a
  # commit a merge brought in is a branch build of the commit it left main at
  local id later
  id=$(git rev-parse "$rev^{commit}")
  if git rev-list --first-parent "$main" | grep -c -x -F "$id" >/dev/null; then
    v=$(walk "$rev" | tail -1 | cut -d' ' -f2)
    [[ -n $v ]] || die "$path/version doesn't hold a version (0.2 or 0.2.5) at $rev"
    echo "$v"
    return 0
  fi

  base=$(git merge-base "$rev" "$main") || die "$rev shares no history with $main"
  if [[ $base == "$id" ]]; then
    later=$(git rev-list --first-parent "$main" "^$id" | tail -1)
    base=$(git rev-parse "$later^1")
  fi
  n=$(git rev-list --count --first-parent "$base..$rev" -- "$path")
  v=$(walk "$base" | tail -1 | cut -d' ' -f2)
  if ((n == 0)) && [[ -n $v ]]; then echo "$v"; return 0; fi
  read -r s z < <(parse "$(file_at "$rev")") || die "$path/version doesn't hold a version (0.2 or 0.2.5) at $rev"
  sha=$(git rev-parse --short=7 "$rev")
  # A new package, or a branch that starts a new series: main's first build
  # of it will be S.Z, and pacman orders 0.1.0pre1 below 0.1.0.
  if [[ -z $v || ${v%.*} != "$s" ]]; then echo "$s.${z:-0}pre$n.g$sha"; return 0; fi
  echo "$v.$n.g$sha"
}

if [[ -n $local_edits && -z $(git ls-tree HEAD -- "$path/version") ]]; then
  # A package not committed yet: below its first commit's 0.1.0pre1
  read -r s z < <(parse "$(cat "$path/version" 2>/dev/null)") ||
    die "$path/version doesn't hold a version (0.2 or 0.2.5)"
  echo "$s.${z:-0}pre0.d$local_edits"
  exit 0
fi
v=$(committed)
# Edits not committed yet: above the commit's version, below the next commit's
echo "$v${local_edits:+.d$local_edits}"
