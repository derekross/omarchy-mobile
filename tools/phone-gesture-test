def history_limit():
    """The notification service keeps only its newest historyLimit files and
    deletes the rest, so posting more than there is room for would push the
    owner's own notifications out for good."""
    try:
        with open(OMARCHY_SHELL + "/plugins/notifications/Service.qml") as f:
            return int(re.search(r"historyLimit:\s*(\d+)", f.read()).group(1))
    except (OSError, AttributeError):
        return 10


# ------------------------------------------------------------------ plumbing

def session_env():
    env = dict(os.environ)
    run = env.setdefault("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    if not env.get("HYPRLAND_INSTANCE_SIGNATURE"):
        sigs = sorted(glob.glob(run + "/hypr/*/"), key=os.path.getmtime)
        if sigs:
            env["HYPRLAND_INSTANCE_SIGNATURE"] = os.path.basename(sigs[-1].rstrip("/"))
    if not env.get("WAYLAND_DISPLAY"):
        socks = sorted(p for p in glob.glob(run + "/wayland-*") if not p.endswith(".lock"))
        if socks:
            env["WAYLAND_DISPLAY"] = os.path.basename(socks[0])
    return env


# The password for an unattended run, read once and taken out of the
# environment before ENV is copied from it: every child gets ENV, and the
# terminal under the pages keeps its environment for its lifetime.
SUDO_PW = os.environ.pop("GESTURE_TEST_SUDO_PW", None)
ENV = session_env()


def sh(*cmd, check=False, input=None, timeout=30):
    """A command's stdout. A timeout, so a shell that stopped answering can't
    hold up the cleanup, which runs with the signals that end a run ignored."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, input=input, env=ENV, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise RuntimeError("%s gave no answer in %d s" % (" ".join(cmd), timeout))
    if check and r.returncode != 0:
        raise RuntimeError("%s failed: %s" % (" ".join(cmd), r.stderr.strip()))
    return r.stdout


def hypr(what):
    return json.loads(sh("hyprctl", "-j", what))


def dispatch(lua):
    sh("hyprctl", "dispatch", lua)


def shell(*args):
    return sh("omarchy-shell", "shell", *args)


def qs(method, arg=""):
    return shell("call", QS, method, arg)


def state():
    return json.loads(qs("state"))


def notifications(method, arg=None):
    """The Omarchy shell's notification service, through its own IPC target."""
    return sh("qs", "ipc", "-p", OMARCHY_SHELL, "call", "notifications", method, *([arg] if arg else [])).strip()


def shell_build():
    """Which shell ran: the package, and a hash of the quick-settings QML it
    loaded (two builds can carry the same version)."""
    d = os.path.realpath(os.path.expanduser("~/.config/omarchy/plugins/" + QS))
    h = hashlib.sha256()
    for f in ("QuickSettings.qml", "WifiPanel.qml", "BluetoothPanel.qml"):
        try:
            with open(os.path.join(d, f), "rb") as fh:
                h.update(fh.read())
        except OSError:
            h.update(b"-")
    return {"package": sh("pacman", "-Q", "omamobile-shell").strip(), "plugin_dir": d,
            "qml_sha256": h.hexdigest()[:16]}


class Geometry:
    """The focused output: its panel pixels, scale and logical size."""

    def __init__(self):
        m = next((m for m in hypr("monitors") if m.get("focused")), hypr("monitors")[0])
        self.name, self.transform = m["name"], m["transform"]
        self.pw, self.ph, self.scale = m["width"], m["height"], float(m["scale"])
        self.w, self.h = round(self.pw / self.scale), round(self.ph / self.scale)

    def px(self, x, y):
        return (min(self.pw - 1, max(0, round(x * self.scale))),
                min(self.ph - 1, max(0, round(y * self.scale))))

    def info(self):
        return {"output": self.name, "panel": [self.pw, self.ph], "scale": self.scale,
                "logical": [self.w, self.h]}


def layers(geo):
    out = []
    for lvl, ls in hypr("layers").get(geo.name, {}).get("levels", {}).items():
        for l in ls:
            out.append({"level": int(lvl), "ns": l["namespace"], "x": l["x"], "y": l["y"],
                        "w": l["w"], "h": l["h"]})
    return out


def clients_on(ws):
    return [c for c in hypr("clients") if c["workspace"]["name"] == ws]


def focus(ws):
    dispatch('hl.dsp.focus({ workspace = "%s" })' % ws)


def screen_locked():
    return sh("omarchy-shell", "lock", "isLocked").strip() == "true"


CLEANUP_TOOLS = {"hyprctl", "omarchy-shell", "qs"}  # all that --cleanup uses


def needed_tools(tests, record, uinput_writable):
    need = CLEANUP_TOOLS | {"grim", "magick"}
    if any(t["ctx"] == "app" for t in tests):
        need.add("foot")
    if any(t["page"] == "sheet" for t in tests):
        need.add("notify-send")
    if record:
        need.add("wf-recorder")
    if not uinput_writable:
        need.add("sudo")
    return need


def missing_tools(need, path):
    """The commands of `need` that aren't on `path`, as "cmd (package pkg)"."""
    return ["%s (package %s)" % (c, TOOLS.get(c, c)) for c in sorted(need) if not shutil.which(c, path=path)]


# ------------------------------------------------------------------ the finger

def sudo_prefix(pw):
    """How to start the helper as root: with a ticket from sudo -v first, then
    sudo -n, which never reads stdin. (Started with sudo -S, a ticket from a
    moment ago means sudo doesn't read the password, and the password line goes
    on to the helper as its first swipe.) pw comes from GESTURE_TEST_SUDO_PW;
    None asks on the terminal, once."""
    if pw is None:
        subprocess.run(["sudo", "-v"], check=True)
    else:
        r = subprocess.run(["sudo", "-S", "-p", "", "-v"], input=pw + "\n", text=True, capture_output=True)
        if r.returncode != 0:
            raise RuntimeError("sudo did not take GESTURE_TEST_SUDO_PW")
    return ["sudo", "-n"]


class Finger:
    """phone-gesture-touch, started once for the run (root for /dev/uinput)."""

    def __init__(self, geo):
        args = [sys.executable, VT, str(geo.pw), str(geo.ph)]
        if not os.access("/dev/uinput", os.W_OK):
            args = sudo_prefix(SUDO_PW) + args
        self.left_running = False
        self.p = subprocess.Popen(args, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, bufsize=1)
        ready = json.loads(self.p.stdout.readline() or "{}")
        if not ready.get("ready"):
            raise RuntimeError("the virtual touchscreen did not start")

    def swipe(self, geo, x0, y0, x1, y1, ms, label):
        (a, b), (c, d) = geo.px(x0, y0), geo.px(x1, y1)
        self.p.stdin.write(json.dumps({"x0": a, "y0": b, "x1": c, "y1": d, "ms": ms}) + "\n")
        self.p.stdin.flush()
        rec = json.loads(self.p.stdout.readline())
        if "error" in rec:
            raise RuntimeError("touch refused: %s" % rec)
        rec.update(label=label, logical=[x0, y0, x1, y1])
        return rec

    def close(self):
        """End of input: the helper removes its device and exits. Never raises,
        since it runs from the cleanup: the session user can't signal a helper
        under sudo, and an exception here would cost results.json. A helper
        that is still there is noted (left_running); it exits once it reads the
        end of its input."""
        try:
            self.p.stdin.close()
        except OSError:
            pass
        for stop in (None, self.p.terminate):
            try:
                if stop:
                    stop()
                self.p.wait(timeout=5)
                return
            except (subprocess.TimeoutExpired, OSError):
                pass
        self.left_running = True


# ------------------------------------------------------------------ fixtures

def write_state(rec):
    """STATE, replaced in one rename, so a run killed mid-write leaves the old
    record or the new one, never half of one."""
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    tmp = STATE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(rec, f)
    os.replace(tmp, STATE)


def read_state():
    """The record a run left: None when there is none; {} when it can't be
    read, which still counts as a run that didn't clean up."""
    try:
        with open(STATE) as f:
            rec = json.load(f)
    except FileNotFoundError:
        return None
    except (OSError, ValueError):
        return {}
    return rec if isinstance(rec, dict) else {}


def ours(pid, what):
    """pid is still a process of the suite's (its command line names `what`),
    not a later process that got the same number."""
    if not isinstance(pid, int) or pid <= 1:
        return False
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            return what.encode() in f.read()
    except OSError:
        return False


def dismiss_fictional():
    """Take the suite's notifications out of the shade the way a swipe does
    (dismissNotification). How many it dismissed."""
    try:
        rows = json.loads(qs("notificationRows") or "[]")
    except ValueError:
        rows = []
    n = 0
    for r in rows:
        if r.get("app") == NOTES_APP and r.get("key") is not None:
            qs("dismissNotification", str(r["key"]))
            n += 1
    return n


def put_back(rec):
    """Put back what an earlier run recorded in STATE and didn't put back
    itself. Each step checks the screen as it is now, so a step that run never
    got to, or one already undone, changes nothing. Returns what it did, one
    line each."""
    done = []
    if rec.get("dnd_before") == "off" and notifications("dndState") == "on":
        notifications("setDnd", "off")
        done.append("do-not-disturb off again (it was off before that run)")
    if rec.get("tiles_aside") and os.path.exists(CONF_ASIDE):
        if os.path.exists(CONF):
            done.append("left %s alone: %s exists as well" % (CONF_ASIDE, CONF))
        else:
            os.replace(CONF_ASIDE, CONF)
            done.append("the tile layout back in place")
    if ours(rec.get("app_pid"), APP_ID):
        try:
            os.killpg(rec["app_pid"], signal.SIGTERM)
            done.append("its terminal closed")
        except OSError:
            pass
    n = dismiss_fictional()
    if n:
        done.append("%d fictional notification%s dismissed" % (n, "" if n == 1 else "s"))
    # The screen: a page or the sheet that run opened, and one of its
    # workspaces in front (empty now that its terminal is gone).
    try:
        st = state()
    except ValueError:
        st = {}
    if any(st.get(k) for k in OPEN_KEY.values()):
        reset_ui()
        done.append("quick settings closed")
    ws = hypr("activeworkspace")["name"]
    if rec.get("start_ws") and ws != rec["start_ws"] and ws in (rec.get("home_ws"), rec.get("app_ws")) \
            and not clients_on(ws):
        focus(rec["start_ws"])
        done.append("back on workspace %s" % rec["start_ws"])
    # The bar's unread mark: only ever moved back. If it is newer than before
    # that run, the run (opening the shade) or the owner since then moved it;
    # moving it back can show a notification as unread that was read, never
    # hide one that wasn't.
    seen = rec.get("seen_before")
    if isinstance(seen, str):
        try:
            with open(SEEN) as f:
                now = f.read()
        except OSError:
            now = None
        if now is not None and now != seen and now.strip().isdigit() and seen.strip().isdigit() \
                and int(now) > int(seen):
            with open(SEEN, "w") as f:
                f.write(seen)
            done.append("the bar's unread mark back")
    return done


def recover(rec):
    """At the start of a run (or --cleanup): put back what an earlier run that
    couldn't clean up left, and remove its record. Refuses while that run is
    still going."""
    if ours(rec.get("pid"), "phone-gesture-test") and rec.get("pid") != os.getpid():
        sys.exit("phone-gesture-test: another run is going (pid %d)" % rec["pid"])
    lines = put_back(rec)
    os.remove(STATE)
    when = rec.get("started", "an unknown time")
    if lines:
        print("phone-gesture-test: a run from %s ended without its cleanup; put back: %s"
              % (when, "; ".join(lines)), flush=True)
    else:
        print("phone-gesture-test: a run from %s ended without its cleanup; nothing was left changed"
              % when, flush=True)


class Fixtures:
    """Everything the run changes, and puts back in reverse. Each change is
    recorded in STATE before it is made (save), so that a run that never gets
    to restore() can be put back by the next one (recover)."""

    def __init__(self, keep_tiles, quiet):
        self.keep_tiles = keep_tiles
        self.tiles_aside = False
        self.want_quiet = quiet
        self.dnd_before = None
        self.history_before = None
        self.history_kept = None
        self.posted = 0
        self.dnd_during = self.dnd_after = None
        self.app = None
        self.home_ws = self.app_ws = None
        self.restore_errors = []
        self.start_ws = hypr("activeworkspace")["name"]
        # The owner's notification history and the bar's unread mark, checked
        # and put back at the end of every run.
        self.history_before = sorted(os.listdir(HISTORY)) if os.path.isdir(HISTORY) else []
        try:
            with open(SEEN) as f:
                self.seen_before = f.read()
        except OSError:
            self.seen_before = None
        self.rec = {"pid": os.getpid(), "started": time.strftime("%Y-%m-%d %H:%M:%S"),
                    "seen_before": self.seen_before, "start_ws": self.start_ws}
        write_state(self.rec)

    def save(self, **changes):
        self.rec.update(changes)
        write_state(self.rec)

    def tiles(self):
        if self.keep_tiles:
            return
        if os.path.exists(CONF_ASIDE):
            raise RuntimeError("%s is left from an earlier run: put it back as %s first" % (CONF_ASIDE, CONF))
        if os.path.exists(CONF):
            self.save(tiles_aside=True)
            os.replace(CONF, CONF_ASIDE)  # the shell watches the file: the default layout applies now
            self.tiles_aside = True

    def workspaces(self):
        used = {c["workspace"]["name"] for c in hypr("clients")} | {self.start_ws}
        free = [w for w in ("9", "8", "7", "6", "5", "4") if w not in used]
        if len(free) < 2:
            raise RuntimeError("needs two empty workspaces among 4-9")
        self.home_ws, self.app_ws = free[0], free[1]
        self.save(home_ws=self.home_ws, app_ws=self.app_ws)

    def open_app(self):
        focus(self.app_ws); time.sleep(0.5)
        self.app = subprocess.Popen(
            ["foot", "--app-id", APP_ID, "--title", "phone-gesture-test",
             "sh", "-c", "echo 'phone-gesture-test: the app under the page'; exec sleep 3600"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True, env=ENV)
        self.save(app_pid=self.app.pid)
        for _ in range(80):
            if any(c["class"] == APP_ID for c in clients_on(self.app_ws)):
                return
            time.sleep(0.1)
        raise RuntimeError("the test app did not appear on workspace %s" % self.app_ws)

    def quiet(self):
        """Do-not-disturb for the run: no sound or popup for the fictional
        notifications, and no popup over the screen being measured."""
        if not self.want_quiet:
            return
        state = notifications("dndState")
        if state not in ("on", "off"):
            raise RuntimeError("the notification service doesn't answer dndState (%r); use --loud" % state)
        self.dnd_before = state
        if state == "off":
            self.save(dnd_before="off")
            notifications("setDnd", "on")
        self.dnd_during = notifications("dndState")
        if self.dnd_during != "on":
            raise RuntimeError("do-not-disturb didn't turn on (%r); use --loud" % self.dnd_during)

    def post_notifications(self, want):
        """Fictional notifications for the shade's tests, never more than the
        history has room for, less HEADROOM: the service deletes its oldest
        files beyond historyLimit, and those would be the owner's."""
        n = notes_to_post(want, history_limit(), len(self.history_before))
        self.save(posted=n)
        for title, body in NOTE_TEXTS[:n]:
            sh("notify-send", "--app-name=" + NOTES_APP, title, body)
        self.posted = n
        time.sleep(1.0)

    def forget_notifications(self):
        """Take the suite's notifications out of the shade again, then check
        that every history file that was there before the run still is."""
        dismiss_fictional()
        time.sleep(1.0)
        now = set(os.listdir(HISTORY)) if os.path.isdir(HISTORY) else set()
        self.history_kept = set(self.history_before) <= now

    def restore(self):
        """Every step runs even when one before it fails; STATE goes only when
        all of them worked, so the next run tries the rest again."""
        def step(what, fn):
            try:
                fn()
            except Exception as e:
                self.restore_errors.append("%s: %s" % (what, e))

        def seen():
            try:
                with open(SEEN) as f:
                    changed = f.read() != self.seen_before
            except OSError:
                changed = True
            if changed:
                with open(SEEN, "w") as f:
                    f.write(self.seen_before)

        def dnd():
            if self.dnd_before == "off":
                notifications("setDnd", "off")
            if self.dnd_before:
                self.dnd_after = notifications("dndState")
                if self.dnd_before == "off" and self.dnd_after != "off":
                    raise RuntimeError("do-not-disturb reads %r" % self.dnd_after)

        def app():
            try:
                os.killpg(self.app.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            self.app = None

        if self.history_kept is None:
            step("the fictional notifications", self.forget_notifications)
        if self.seen_before is not None:
            step("the unread mark", seen)
        step("do-not-disturb", dnd)
        if self.app:
            step("the terminal", app)
        if self.tiles_aside and os.path.exists(CONF_ASIDE):
            step("the tile layout", lambda: os.replace(CONF_ASIDE, CONF))
            self.tiles_aside = os.path.exists(CONF_ASIDE)
        step("the screen", reset_ui)
        step("the workspace", lambda: focus(self.start_ws))
        if not self.restore_errors:
            try:
                os.remove(STATE)
            except FileNotFoundError:
                pass


def reset_ui():
    shell("summon", QS, "{}")  # opening the sheet closes the Wi-Fi and Bluetooth pages
    time.sleep(0.4)
    for plugin in (QS, "omamobile.switcher", "omamobile.launcher"):
        shell("hide", plugin)
    shell("call", "omamobile.keyboard", "hideKeyboard", "")
    time.sleep(1.0)


# ------------------------------------------------------------------ one test

def last_row_y(png, page, geo):
    """The lowest line of text in the Wi-Fi list, in logical pixels: inside the
    page's window, below its header and switch, above its strip."""
    x0, y0 = geo.px(page["x"] + 60, page["y"] + 166)
    x1, y1 = geo.px(page["x"] + page["w"] - 52, page["y"] + page["h"] - 48)
    out = sh("magick", png, "-crop", "%dx%d+%d+%d" % (x1 - x0, y1 - y0, x0, y0), "+repage",
             "-colorspace", "gray", "-threshold", "45%", "-scale", "1x!", "-threshold", "0.5%", "txt:-")
    last = None
    for line in out.splitlines()[1:]:
        pos, rest = line.split(":", 1)
        if "white" in rest or "FFFFFF" in rest.upper() or "gray(255)" in rest:
            last = int(pos.split(",")[1])
    if last is None:
        raise RuntimeError("no list text found (a light theme, or an empty list?)")
    return (y0 + last) / geo.scale


def gesture_points(t, geo, page, png):
    w, h = geo.w, geo.h
    bottom = page["y"] + page["h"] if page else h
    g = t["gesture"]
    if g == "edge":
        return (w / 2, h - 13, w / 2, h - 288, 300)
    if g == "page-strip":
        return (w / 2, bottom - 16, w / 2, bottom - 279, 300)
    if g == "body":
        return (w / 2, bottom - 73, w / 2, bottom - 336, 300)
    if g == "last-row":
        y = last_row_y(png, page, geo) - 10
        return (w / 2, y, w / 2, max(page["y"] + 60, y - 263), 350)
    if g == "band-top":
        return (w / 2, h - 40, w / 2, h - 315, 300)
    if g == "card":
        return (w * 0.28, h * 0.50, w * 0.28, h * 0.23, 350)
    if g == "list":
        return (w / 2, h - 67, w / 2, h - 367, 350)
    raise ValueError(g)


def precondition(t, st, lay, ws, geo):
    problems = []
    ns = {l["ns"]: l for l in lay}
    strip = ns.get("omamobile-home-strip")
    page = ns.get(PAGE_NS.get(t["page"], ""))
    on_ws = clients_on(ws)
    # Checked before every gesture, not once per run: a run takes minutes,
    # and a swipe must never land on the lock screen or a call.
    if screen_locked():
        problems.append("the screen is locked")
    if any(n in ns for n in CALL_NS):
        problems.append("a call's screen is up")
    if "osk" in ns:
        problems.append("the on-screen keyboard is up")
    if RECENTS_NS in ns:
        problems.append("Recents is open")
    if t["ctx"] == "home":
        if on_ws:
            problems.append("the home workspace has windows")
        if strip:
            problems.append("the shell's bottom strip is shown on the home screen")
        if page and abs(page["y"] + page["h"] - geo.h) > 1:
            problems.append("the page ends at %d, not at the screen's bottom (%d)" % (page["y"] + page["h"], geo.h))
    else:
        if not on_ws:
            problems.append("no app on the app workspace")
        if not strip:
            problems.append("the shell's bottom strip is not shown over the app")
        elif page and abs(page["y"] + page["h"] - strip["y"]) > 1:
            problems.append("the page ends at %d, not above the strip (%d)" % (page["y"] + page["h"], strip["y"]))
    if not st.get(OPEN_KEY[t["page"]]):
        problems.append("%s is not open" % OPEN_KEY[t["page"]])
    if t["page"] == "sheet":
        if st.get("media"):
            problems.append("a media card is shown")
        need = t.get("notes", 1)
        if (st.get("notifications") or 0) < need:
            problems.append("%s notifications in the shade, needs %d" % (st.get("notifications"), need))
    return problems


# Evidence is computed from the pixels, never judged: a region's row profile
# (the mean grey of each panel row) before and after a drag, and the upward
# shift that best lines the two up. A list that scrolled with the finger
# lines up again some way further up (scrolled_with); one that didn't move
# matches itself at a shift of 0. Grey values are 0..65535; STABLE is the
# mean per-row difference below which two frames count as the same picture.
STABLE = 130


def profile(png, geo, rect):
    """Mean grey of each panel row inside rect (logical pixels)."""
    (x0, y0), (x1, y1) = geo.px(rect["x"], rect["y"]), geo.px(rect["x"] + rect["w"], rect["y"] + rect["h"])
    out = sh("magick", png, "-crop", "%dx%d+%d+%d" % (x1 - x0, y1 - y0, x0, y0), "+repage",
             "-colorspace", "gray", "-depth", "16", "-scale", "1x!", "txt:-")
    vals = []
    for line in out.splitlines()[1:]:
        m = re.search(r"\(\s*([\d.]+)", line.split(":", 1)[-1])
        vals.append(float(m.group(1)) if m else 0.0)
    return vals


def diff(a, b, s=0):
    """Mean absolute difference of b[y] and a[y + s] over their overlap."""
    m = min(len(a) - s, len(b))
    if m < max(1, min(len(a), len(b)) // 3):
        return float("inf")
    return sum(abs(b[y] - a[y + s]) for y in range(m)) / m


TIE = 1.25  # shifts whose difference is within this factor of the best line up as well
# (look-alike rows on the 9a and in the VM: 1.05-1.21; any other second-best
# shift seen was more than 1.6 times the best)


def shift_up(a, b, max_shift, near=0):
    """How far the content moved up from profile a to profile b, in panel
    rows: (shift, its difference, the difference unmoved, other shifts that
    line up as well). Rows that look alike (network names of one length, the
    same notification) line up almost as well a whole number of rows apart;
    of those, the shift nearest `near` (the drag) is taken."""
    curve = [diff(a, b, s) for s in range(max(1, max_shift))]
    r0 = curve[0]
    best = min(range(1, len(curve)), key=lambda s: curve[s], default=0)
    if not best or curve[best] >= r0:
        return 0, r0, r0, []
    found = []
    for s in range(1, len(curve)):
        r = curve[s]
        if r > TIE * curve[best] or r > curve[s - 1] or (s + 1 < len(curve) and r > curve[s + 1]):
            continue
        if found and s - found[-1] <= 3:  # the same minimum, a flat bottom
            if r < curve[found[-1]]:
                found[-1] = s
        else:
            found.append(s)
    pick = min(found, key=lambda s: (abs(s - near), s))
    return pick, curve[pick], r0, [s for s in found if s != pick]


def scrolled_with(moved, diff_at_shift, diff_unmoved):
    """A drag that should scroll a list did: the picture changed, and its
    content lines up much better moved up by at least 20 px than unmoved. How
    far a list can go depends on how much of it is left below, so the rule
    doesn't ask for a share of the drag; a touch that never arrived moves
    nothing, and rows a Wi-Fi scan adds push the list down, not up."""
    return moved >= 20 and diff_unmoved > STABLE and diff_at_shift < 0.7 * diff_unmoved


def scroll_evidence(found, scale, drag):
    """shift_up's answer (panel rows) as the log's evidence (logical px), and
    whether it shows the content moving up with the drag. When look-alike
    rows line up at several shifts, every one of them must pass: a list that
    lines up as well after 7 px as after 263 px proves nothing."""
    s, rb, r0, alts = found
    ev = {"dragged": round(drag), "moved": round(s / scale), "diff_at_shift": round(rb),
          "diff_unmoved": round(r0)}
    if alts:
        ev["also_lines_up_at"] = sorted(round(x / scale) for x in alts)
    return scrolled_with(min([s] + alts) / scale, rb, r0), ev


def gesture_result(t, got, lay):
    """PASS when the shell's state is the one the scenario wants and Recents
    stayed shut: no scenario here opens it, so Recents means the touch
    reached the home strip, whatever became of the page."""
    recents = any(l["ns"] == RECENTS_NS for l in lay)
    return ("PASS" if got == t["want"] and not recents else "FAIL"), recents


def notes_to_post(want, limit, existing):
    """How many fictional notifications fit: the history keeps `limit` files,
    and HEADROOM slots stay free for real ones arriving during the run."""
    return min(want, max(0, limit - HEADROOM - existing))


def settle(geo, path, rect, timeout=12.0):
    """Screenshot into path once rect stops changing (a Wi-Fi scan adds rows
    for a few seconds after the page opens). False if it never did."""
    sh("grim", "-o", geo.name, path, check=True)
    prev = profile(path, geo, rect)
    t0 = time.time()
    while time.time() - t0 < timeout:
        time.sleep(1.0)
        sh("grim", "-o", geo.name, path, check=True)
        cur = profile(path, geo, rect)
        if diff(prev, cur) < STABLE:
            return True
        prev = cur
    return False


def evidence_rect(t, geo, page):
    """Where a drag that keeps the page open must show movement: the Wi-Fi
    list between the page's header and its strip, or the lower half of the
    shade where the notification list is."""
    if t["page"] == "sheet":
        return {"x": 0, "y": geo.h * 0.5, "w": geo.w, "h": geo.h * 0.5 - 10}
    return {"x": page["x"] + 60, "y": page["y"] + 166, "w": page["w"] - 112, "h": page["h"] - 166 - 40}


def annotate(png, out, geo, pts):
    (a, b), (c, d) = geo.px(*pts[0:2]), geo.px(*pts[2:4])
    r = max(12, round(8 * geo.scale))
    sh("magick", png, "-fill", "none", "-stroke", "#ff3b30", "-strokewidth", str(max(6, round(3 * geo.scale))),
       "-draw", "line %d,%d %d,%d" % (a, b, c, d), "-fill", "#ff3b30",
       "-draw", "circle %d,%d %d,%d" % (a, b, a + r, b), out)


def hottest():
    """The hottest thermal zone in deg C, batteries left out (None if none)."""
    temps = []
    for z in glob.glob("/sys/class/thermal/thermal_zone*"):
        try:
            with open(z + "/type") as f:
                if "batt" in f.read().lower():
                    continue
            with open(z + "/temp") as f:
                temps.append(int(f.read()) / 1000)
        except (OSError, ValueError):
            pass
    return max(temps) if temps else None


def cool_down(timeout=120.0):
    """Wait until the SoC is below THERMAL_LIMIT: a throttled phone delivers
    touches late or in one burst, and a drag then looks like a jump. Returns
    the temperature it ended at."""
    t0, temp = time.time(), hottest()
    while temp is not None and temp > THERMAL_LIMIT and time.time() - t0 < timeout:
        time.sleep(3.0)
        temp = hottest()
    return temp


def run_test(t, fx, finger, geo, out_dir, record):
    d = os.path.join(out_dir, t["id"] + "-" + t["name"])
    os.makedirs(d, exist_ok=True)
    ws = fx.home_ws if t["ctx"] == "home" else fx.app_ws
    log = {k: t[k] for k in ("id", "name", "title", "expect", "ctx", "page", "gesture", "want")}
    log["workspace"] = ws
    log["temp_start"] = cool_down()
    reset_ui()
    focus(ws); time.sleep(0.8)
    rec = None
    if record:
        rec = subprocess.Popen(["wf-recorder", "-o", geo.name, "-f", os.path.join(d, "raw.mp4"), "-c", "libx264",
                                "-p", "preset=ultrafast", "-p", "crf=20", "-r", "30", "-y"],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=ENV)
        time.sleep(1.0)
    if t["page"] == "wifi":
        if qs("openWifi").strip() == "unavailable":
            raise RuntimeError("no Wi-Fi device")
    elif t["page"] == "bluetooth":
        if qs("openBluetooth").strip() == "unavailable":
            raise RuntimeError("no Bluetooth adapter")
    else:
        shell("summon", QS, json.dumps({"expanded": False}))
    time.sleep(SETTLE[t["page"]])
    # The app under the page is a terminal, and focusing it can bring the
    # on-screen keyboard up; the gesture is about the screen without it.
    shell("call", "omamobile.keyboard", "hideKeyboard", "")
    time.sleep(0.5)
    # Opening the page warms the phone up again: cool down once more before
    # the screen is measured and touched (and before the screenshots, so rows
    # a scan adds while waiting aren't taken for a scroll).
    log["temp_ready"] = cool_down(timeout=60.0)
    st, lay = state(), layers(geo)
    page = next((l for l in lay if l["ns"] == PAGE_NS.get(t["page"])), None)
    keep_open = all(v is True for v in t["want"].values())
    before = os.path.join(d, "before.png")
    rect = None
    if keep_open and (page or t["page"] == "sheet"):
        rect = evidence_rect(t, geo, page)
        log["settled"] = settle(geo, before, rect)
        st, lay = state(), layers(geo)
        page = next((l for l in lay if l["ns"] == PAGE_NS.get(t["page"])), None)
    else:
        sh("grim", "-o", geo.name, before, check=True)
    log["state_before"], log["layers_before"] = st, lay
    problems = precondition(t, st, lay, ws, geo)
    if log.get("settled") is False:
        problems.append("the screen kept changing before the gesture")
    if log["temp_ready"] is not None and log["temp_ready"] > THERMAL_LIMIT:
        problems.append("the phone stayed at %.0f C, above %.0f C, where touches arrive late"
                        % (log["temp_ready"], THERMAL_LIMIT))
    # 03 and 04 are about the strip and the end of the list: they only mean
    # something when the list reaches the strip.
    if not problems and t["gesture"] in ("last-row", "body") and page:
        try:
            reach = page["y"] + page["h"] - last_row_y(before, page, geo)
            log["list_reach"] = round(reach)
            if reach > 110:
                problems.append("the list ends %d px above the page's bottom, too short to reach the strip"
                                " (needs more networks in range)" % reach)
        except RuntimeError as e:
            problems.append(str(e))
    log["precondition"] = {"ok": not problems, "problems": problems}
    if problems:
        log["result"] = "SKIP"
    else:
        pts = gesture_points(t, geo, page, before)
        annotate(before, os.path.join(d, "gesture.png"), geo, pts)
        log["temp_gesture"] = hottest()
        log["touch"] = finger.swipe(geo, *pts, label="gesture")
        time.sleep(1.8)
        log["state_after"] = state()
        log["layers_after"] = layers(geo)
        log["got"] = {k: log["state_after"].get(k) for k in t["want"]}
        log["result"], log["recents"] = gesture_result(t, log["got"], log["layers_after"])
        if log["recents"]:
            log["note"] = "Recents opened: the touch reached the home strip"
    after = os.path.join(d, "after.png")
    sh("grim", "-o", geo.name, after)
    # A page that should stay open also stays open when the touch never
    # arrived, so its pass needs evidence computed from the pixels: the
    # content moved up with the drag (scrolled_with). Otherwise INCONCLUSIVE.
    if log["result"] == "PASS" and keep_open:
        drag = pts[1] - pts[3]
        found = shift_up(profile(before, geo, rect), profile(after, geo, rect), round(400 * geo.scale),
                         near=round(drag * geo.scale))
        ok, log["evidence"] = scroll_evidence(found, geo.scale, drag)
        if not ok:
            ev = log["evidence"]
            log["result"] = "INCONCLUSIVE"
            log["note"] = ("the page stayed open, but its content did not move up with the drag"
                           " (dragged %d px, moved %d px%s)" % (ev["dragged"], ev["moved"],
                           "; rows that look alike line up as well at %s px"
                           % ", ".join(map(str, ev["also_lines_up_at"])) if "also_lines_up_at" in ev else ""))
    if rec:
        time.sleep(0.6)
        rec.send_signal(signal.SIGINT)
        try:
            rec.wait(timeout=20)
        except subprocess.TimeoutExpired:
            rec.kill()
    with open(os.path.join(d, "log.json"), "w") as f:
        json.dump(log, f, indent=2)
    return log


# ------------------------------------------------------------------ main

def say(line):
    """One line of progress. A terminal that went away (EIO, EPIPE) doesn't
    stop the run: the results still go to results.json."""
    try:
        print(line, flush=True)
    except OSError:
        sys.stdout = open(os.devnull, "w")  # nor Python's own flush at exit


def end_on_signals():
    """SIGTERM and SIGHUP end a run the way Ctrl-C does, through the cleanup
    in main's finally. SIGHUP is what a run gets when its SSH session or the
    USB link drops; by default Python would exit on it without any cleanup."""
    def end(sig, frame):
        raise SystemExit(128 + sig)
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, end)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("ids", nargs="*", help="test ids to run (default: all)")
    ap.add_argument("--record", action="store_true", help="a screen recording per test")
    ap.add_argument("--keep-tiles", action="store_true", help="leave the owner's tile layout in place")
    ap.add_argument("--loud", action="store_true", help="leave do-not-disturb off during the run")
    ap.add_argument("--out", help="output directory (default ~/.cache/phone-gesture-test/run-TIME)")
    ap.add_argument("--list", action="store_true", help="list the tests and exit")
    ap.add_argument("--cleanup", action="store_true",
                    help="only put back what an earlier run that didn't clean up left, and exit")
    a = ap.parse_args()
    tests = [t for t in TESTS if not a.ids or t["id"] in a.ids]
    if a.list:
        for t in TESTS:
            print("%s  %-5s %s -> %s" % (t["id"], t["ctx"], t["title"], t["expect"]))
        return 0
    need = CLEANUP_TOOLS if a.cleanup else needed_tools(tests, a.record, os.access("/dev/uinput", os.W_OK))
    missing = missing_tools(need, ENV.get("PATH"))
    if missing:
        sys.exit("phone-gesture-test: missing %s" % ", ".join(missing))
    rec = read_state()
    if rec is not None:
        recover(rec)
    elif a.cleanup:
        print("phone-gesture-test: no earlier run left anything to put back")
    if a.cleanup:
        return 0
    geo = Geometry()
    if geo.transform != 0:
        sys.exit("the display is rotated (transform %s): turn rotation back first" % geo.transform)
    if screen_locked():
        sys.exit("the screen is locked")
    out = a.out or os.path.expanduser(time.strftime("~/.cache/phone-gesture-test/run-%Y%m%d-%H%M%S"))
    os.makedirs(out, exist_ok=True)
    print("phone-gesture-test: %d tests on %s (%dx%d logical, scale %g). The screen is taken over until the end."
          % (len(tests), geo.name, geo.w, geo.h, geo.scale), flush=True)

    end_on_signals()
    build = shell_build()
    fx = Fixtures(a.keep_tiles, not a.loud)
    finger = None
    results = []
    interrupted = None
    try:
        fx.tiles()
        fx.workspaces()
        fx.quiet()
        finger = Finger(geo)
        if any(t["page"] == "sheet" for t in tests):
            fx.post_notifications(NOTIFICATIONS)
        for t in tests:
            if t["ctx"] == "app" and not fx.app:
                fx.open_app()
            try:
                log = run_test(t, fx, finger, geo, out, a.record)
            except Exception as e:  # one broken test doesn't stop the others
                log = {"id": t["id"], "name": t["name"], "result": "ERROR", "error": str(e)}
            results.append(log)
            why = {"SKIP": "; ".join(log.get("precondition", {}).get("problems", [])),
                   "ERROR": log.get("error", ""), "INCONCLUSIVE": log.get("note", ""),
                   "FAIL": log.get("note", "")}.get(log["result"], "")
            say("%s %-38s %s%s" % (t["id"], t["name"], log["result"], "  " + why if why else ""))
        if fx.history_before is not None:
            fx.forget_notifications()
    except KeyboardInterrupt:
        interrupted = "SIGINT"
    except SystemExit as e:  # end_on_signals
        interrupted = signal.Signals(e.code - 128).name if isinstance(e.code, int) and e.code > 128 else str(e.code)
    finally:
        # The cleanup runs to its end: a second Ctrl-C, or the SIGHUP that
        # follows a SIGTERM when the session goes, mustn't cut it short (sh()
        # has a timeout, so it can't hang either).
        for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(sig, signal.SIG_IGN)
        if finger:
            finger.close()
        fx.restore()
    summary = {
        "device": geo.info(),
        "shell": build,
        "time": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "tiles": "owner's" if a.keep_tiles else "package default",
        "interrupted": interrupted,
        "do_not_disturb": {"before": fx.dnd_before, "during": fx.dnd_during, "after": fx.dnd_after},
        "notifications": {"posted": fx.posted, "owner_history_kept": fx.history_kept},
        "cleanup": {"errors": fx.restore_errors, "touch_helper_left_running": bool(finger and finger.left_running)},
        "tests": [{k: r.get(k) for k in ("id", "name", "title", "expect", "result", "want", "got", "recents",
                                         "error", "evidence", "note", "temp_start", "temp_ready", "temp_gesture")}
                  for r in results],
    }
    with open(os.path.join(out, "results.json"), "w") as f:
        json.dump(summary, f, indent=2)
    if fx.history_kept is False:
        say("WARNING: a notification history file from before the run is gone")
    for e in fx.restore_errors:
        say("WARNING: not put back, %s (the next run tries again; or --cleanup)" % e)
    passed = sum(r["result"] == "PASS" for r in results)
    if interrupted:
        say("stopped by %s after %d of %d tests, everything put back; details in %s"
            % (interrupted, len(results), len(tests), out))
        return 130
    say("%d/%d passed; details in %s" % (passed, len(results), out))
    return 0 if passed == len(results) else 1


if __name__ == "__main__":
    sys.exit(main())
