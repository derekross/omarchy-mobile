def history_limit():
    """The notification service keeps only its newest historyLimit files and
    deletes the rest, so posting more than there is room for would push the
    owner's own notifications out for good."""
    try:
        with open(OMARCHY_SHELL + "/plugins/notifications/Service.qml") as f:
            return int(re.search(r"historyLimit:\s*(\d+)", f.read()).group(1))
    except (OSError, AttributeError):
        return 10


# ------------------------------------------------------------------ plumbing

def session_env():
    env = dict(os.environ)
    run = env.setdefault("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    if not env.get("HYPRLAND_INSTANCE_SIGNATURE"):
        sigs = sorted(glob.glob(run + "/hypr/*/"), key=os.path.getmtime)
        if sigs:
            env["HYPRLAND_INSTANCE_SIGNATURE"] = os.path.basename(sigs[-1].rstrip("/"))
    if not env.get("WAYLAND_DISPLAY"):
        socks = sorted(p for p in glob.glob(run + "/wayland-*") if not p.endswith(".lock"))
        if socks:
            env["WAYLAND_DISPLAY"] = os.path.basename(socks[0])
    return env


ENV = session_env()


def sh(*cmd, check=False, input=None):
    r = subprocess.run(cmd, capture_output=True, text=True, input=input, env=ENV)
    if check and r.returncode != 0:
        raise RuntimeError("%s failed: %s" % (" ".join(cmd), r.stderr.strip()))
    return r.stdout


def hypr(what):
    return json.loads(sh("hyprctl", "-j", what))


def dispatch(lua):
    sh("hyprctl", "dispatch", lua)


def shell(*args):
    return sh("omarchy-shell", "shell", *args)


def qs(method, arg=""):
    return shell("call", QS, method, arg)


def state():
    return json.loads(qs("state"))


def notifications(method, arg=None):
    """The Omarchy shell's notification service, through its own IPC target."""
    return sh("qs", "ipc", "-p", OMARCHY_SHELL, "call", "notifications", method, *([arg] if arg else [])).strip()


def shell_build():
    """Which shell ran: the package, and a hash of the quick-settings QML it
    loaded (two builds can carry the same version)."""
    d = os.path.realpath(os.path.expanduser("~/.config/omarchy/plugins/" + QS))
    h = hashlib.sha256()
    for f in ("QuickSettings.qml", "WifiPanel.qml", "BluetoothPanel.qml"):
        try:
            with open(os.path.join(d, f), "rb") as fh:
                h.update(fh.read())
        except OSError:
            h.update(b"-")
    return {"package": sh("pacman", "-Q", "omamobile-shell").strip(), "plugin_dir": d,
            "qml_sha256": h.hexdigest()[:16]}


class Geometry:
    """The focused output: its panel pixels, scale and logical size."""

    def __init__(self):
        m = next((m for m in hypr("monitors") if m.get("focused")), hypr("monitors")[0])
        self.name, self.transform = m["name"], m["transform"]
        self.pw, self.ph, self.scale = m["width"], m["height"], float(m["scale"])
        self.w, self.h = round(self.pw / self.scale), round(self.ph / self.scale)

    def px(self, x, y):
        return (min(self.pw - 1, max(0, round(x * self.scale))),
                min(self.ph - 1, max(0, round(y * self.scale))))

    def info(self):
        return {"output": self.name, "panel": [self.pw, self.ph], "scale": self.scale,
                "logical": [self.w, self.h]}


def layers(geo):
    out = []
    for lvl, ls in hypr("layers").get(geo.name, {}).get("levels", {}).items():
        for l in ls:
            out.append({"level": int(lvl), "ns": l["namespace"], "x": l["x"], "y": l["y"],
                        "w": l["w"], "h": l["h"]})
    return out


def clients_on(ws):
    return [c for c in hypr("clients") if c["workspace"]["name"] == ws]


def focus(ws):
    dispatch('hl.dsp.focus({ workspace = "%s" })' % ws)


# ------------------------------------------------------------------ the finger

class Finger:
    """phone-gesture-touch, started once for the run (root for /dev/uinput)."""

    def __init__(self, geo):
        args = [sys.executable, VT, str(geo.pw), str(geo.ph)]
        pw = None
        if not os.access("/dev/uinput", os.W_OK):
            pw = os.environ.get("GESTURE_TEST_SUDO_PW")
            if pw is None:
                subprocess.run(["sudo", "-v"], check=True)  # asks on the terminal, once
                args = ["sudo", "-n"] + args
            else:
                args = ["sudo", "-S", "-p", ""] + args
        self.p = subprocess.Popen(args, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, bufsize=1)
        if pw is not None:
            self.p.stdin.write(pw + "\n"); self.p.stdin.flush()
        ready = json.loads(self.p.stdout.readline() or "{}")
        if not ready.get("ready"):
            raise RuntimeError("the virtual touchscreen did not start")

    def swipe(self, geo, x0, y0, x1, y1, ms, label):
        (a, b), (c, d) = geo.px(x0, y0), geo.px(x1, y1)
        self.p.stdin.write(json.dumps({"x0": a, "y0": b, "x1": c, "y1": d, "ms": ms}) + "\n")
        self.p.stdin.flush()
        rec = json.loads(self.p.stdout.readline())
        if "error" in rec:
            raise RuntimeError("touch refused: %s" % rec)
        rec.update(label=label, logical=[x0, y0, x1, y1])
        return rec

    def close(self):
        try:
            self.p.stdin.close(); self.p.wait(timeout=5)
        except Exception:
            self.p.kill()


