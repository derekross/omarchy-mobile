#!/bin/bash
# SPDX-License-Identifier: MIT
# install-phone: install Omarchy Mobile on a phone in fastboot mode, from the
# laptop (docs/RELEASES.md §6). In a release bundle this file is "install";
# it also runs from a bundle's tools/ directory, where a guided installer
# can call it: first with --verify-only, then with --dry-run, then for the
# writes.
#
# What it writes, and nothing else:
#   - slot B's boot images, one "fastboot flash <image>_b" per BOOT_IMAGES
#     entry of the device descriptor, each checked against its storage-guard
#     allowlist (UFS_RW);
#   - "fastboot flash userdata" with the root image (this ERASES userdata:
#     stock Android on slot A needs a factory reset if it is ever booted again);
#   - "fastboot --set-active=b", then "fastboot reboot".
# It has no code path for any other partition, and never uses -w, --slot,
# "flashing" or an unsuffixed partition name. Slot A, the bootloader, radio,
# persist, efs, modem, devinfo and vbmeta are never touched.
#
# Before anything it checks: the phone answers in fastboot, its product is the
# descriptor's CODENAME, the bootloader is unlocked, both bootloader slots
# carry the same version, and each image fits its slot B partition (an
# AVB_FOOTERS image exactly). A bundle's manifest.json (tools/bundle-manifest)
# states the same checks and writes as data, for this script, a web flasher
# and a desktop installer alike; it is covered by the (signed) checksums and
# must match the descriptor and these rules exactly, or nothing is written.
# It asks for the user name, password, host name,
# time zone, optional Wi-Fi and the SSH public key, writes them as
# /etc/omamobile/firstboot.conf (and root's authorized_keys) into a LOCAL
# COPY of the root image with debugfs (no root needed), with
# /etc/omamobile/boot-update.conf (AUTO_WRITE defaults to yes; descriptors
# may set BOOT_UPDATE_AUTO_WRITE=no to keep development kernel updates off
# slot B, docs/RELEASES.md §5.3), shows exactly what it will run, and waits
# for the codename to be typed. The phone's first boot
# (omamobile-firstboot) creates the user from that file and deletes it.
# The key also goes into a copy of slot B's ramdisk image, as
# omamobile-boot-update appends it, so the initramfs's rescue SSH takes it.
#
#   install-phone [--dry-run] [options]
#     --dry-run              read the phone's variables (read-only) and prepare
#                            the image copy, then print every flash command
#                            instead of running it
#     --device CODENAME      repository mode: device/CODENAME/device.conf (default
#                            $DEVICE or cheetah); in a bundle, its device.conf
#     --images DIR           repository mode: the slot B images (default:
#                            $KERNEL_OUT/images, KERNEL_OUT=$KERNEL_BASE/out-int)
#     --rootfs FILE          the root image (.img.zst; default: the newest
#                            image for this device in out/, or the exact
#                            image named by a signed bundle's MANIFEST)
#     --work DIR             where the local image copy goes (default
#                            ~/.cache/omamobile-install; needs the image's size free)
#     --bootloader-slots-match VERSION
#                            when the bootloader reports no per-slot versions:
#                            you checked the other slot carries VERSION too
#                            (it must equal the current slot's)
#     --reinstall            slot B is the current slot and holds Omarchy Mobile
#                            (a reinstall); without it, a phone running from
#                            slot B is refused, since that is where stock
#                            Android runs after a system update
#     --unsigned             accept a bundle without SHA256SUMS.sig (development)
#     --serial SERIAL        the phone to install on, as "fastboot devices"
#                            names it: anything else in fastboot mode is
#                            refused before it is asked a single question. A
#                            caller that has already looked at the phone
#                            (the guided installer) passes it, so the phone
#                            it looked at is the one that is written
#     --verify-only          check the files (a bundle's signature, checksums,
#                            manifest.json, root image and slot B's ramdisk,
#                            read in a directory of its own in --work that
#                            it removes) and stop before the phone is
#                            contacted
#
# Answers are read from standard input, so they can be piped for tests and by
# the guided installer, which sets OMAMOBILE_INSTALL_GUIDED=1: the questions
# are then not printed again (it has asked them), nor the closing hints.
set -euo pipefail
shopt -s nullglob
# Byte-wise character ranges in the checks below ([ -~] is printable ASCII)
export LC_ALL=C

FASTBOOT=${FASTBOOT:-fastboot}
# Omarchy Mobile's keys (packages/omamobile-keyring): the release key, and the
# original package key until it is retired. A subkey's signature reports its
# primary's fingerprint, which is what is matched.
SIGNING_KEYS='20567593566EEEE2DD8864608632C8075EB94673|6C84FE3D240709E70E27CC94B301F5EA62B249FE'
here=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)

say() { printf '\e[1m==> %s\e[0m\n' "$*"; }
note() { printf '    %s\n' "$*"; }
die() { printf '\e[31merror:\e[0m %s\n' "$*" >&2; exit 1; }

dry=0 device="" images="" rootfs="" work="" slots_match="" unsigned=0 reinstall=0 verify_only=0 want_serial=""
guided=${OMAMOBILE_INSTALL_GUIDED:-}
while (($#)); do
  case $1 in
    --dry-run) dry=1 ;;
    --device) device=${2:?}; shift ;;
    --images) images=${2:?}; shift ;;
    --rootfs) rootfs=${2:?}; shift ;;
    --work) work=${2:?}; shift ;;
    --bootloader-slots-match) slots_match=${2:?}; shift ;;
    --reinstall) reinstall=1 ;;
    --unsigned) unsigned=1 ;;
    --verify-only) verify_only=1 ;;
    --serial) want_serial=${2:?}; [[ $want_serial =~ ^[!-~]+$ ]] || die "--serial takes a serial as 'fastboot devices' prints it"; shift ;;
    # Not tools/lib/usage.sh: the bundle ships this file alone, as install
    -h|--help) awk 'NR > 2 && !/^#/ { exit } NR > 2 { sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"; exit 0 ;;
    *) die "unknown argument $1 (see --help)" ;;
  esac
  shift
done

# --- Where things are: a release bundle, or this repository ------------------
# In a bundle this file is at its top, as "install", or in its tools/; the
# bundle is the directory with device.conf and images/.
if [[ ${here##*/} == tools && -f $here/../device.conf && -d $here/../images ]]; then
  here=$(cd -- "$here/.." && pwd)
fi
if [[ -f $here/device.conf && -d $here/images ]]; then
  mode=bundle
  conf=$here/device.conf
  [[ -z $images || $(readlink -f "$images") == "$here/images" ]] ||
    die "a bundle uses its own images; --images is only available in repository mode"
  images=${images:-$here/images}
  root_dirs=("$here/.." "$here")
else
  mode=repository
  repo=$(cd -- "$here/.." && pwd)
  device=${device:-${DEVICE:-cheetah}}
  [[ $device =~ ^[a-z0-9]+$ ]] || die "--device must be a codename"
  conf=$repo/device/$device/device.conf
  # KERNEL_BASE: ~/omamobile-kernel, or ~/android/mainline on older setups.
  if [[ -z ${KERNEL_BASE:-} ]]; then
    KERNEL_BASE=$HOME/omamobile-kernel
    [[ -d $KERNEL_BASE || ! -d $HOME/android/mainline ]] || KERNEL_BASE=$HOME/android/mainline
  fi
  images=${images:-${KERNEL_OUT:-$KERNEL_BASE/out-int}/images}
  root_dirs=("$repo/out")
fi
[[ -f $conf ]] || die "no device descriptor $conf"

# The descriptor is data (docs/RELEASES.md §3): parsed line by line, never sourced
declare -A D=()
n=0
while IFS= read -r line || [[ -n $line ]]; do
  n=$((n + 1))
  [[ $line =~ ^[[:space:]]*(#.*)?$ ]] && continue
  if [[ $line =~ ^([A-Z][A-Z0-9_]*)=\"([^\"\$\`\\]*)\"$ || $line =~ ^([A-Z][A-Z0-9_]*)=([^\"\$\`\\\'[:space:]]*)$ ]]; then
    D[${BASH_REMATCH[1]}]=${BASH_REMATCH[2]}
  else
    die "$conf:$n: not a KEY=value line"
  fi
done < "$conf"
CODENAME=${D[CODENAME]:-}
[[ $CODENAME =~ ^[a-z0-9]+$ ]] || die "$conf: no CODENAME"
BOOT_UPDATE_AUTO_WRITE=${D[BOOT_UPDATE_AUTO_WRITE]-yes}
[[ $BOOT_UPDATE_AUTO_WRITE == yes || $BOOT_UPDATE_AUTO_WRITE == no ]] ||\
  die "$conf: BOOT_UPDATE_AUTO_WRITE must be yes or no"
[[ $mode == bundle || $CODENAME == "$device" ]] || die "$conf: CODENAME=$CODENAME, expected $device"
# Legacy descriptors omit BOOT_METHOD; only their Android v4 path is installable.
# Refuse before image preparation or any fastboot query/write.
BOOT_METHOD=${D[BOOT_METHOD]-android-v4}
[[ $BOOT_METHOD == android-v4 ]] || die "$conf: unsupported BOOT_METHOD=$BOOT_METHOD; install-phone supports only android-v4"
# The descriptor names how ABL picks the base DTB: SOC_IDS (/soc_id, gs101
# and gs201) or SOC_COMPATIBLE (/soc_compatible, zuma), exactly one, as
# bin/omamobile checks. A staged descriptor names neither and is refused.
if [[ -n ${D[SOC_IDS]:-} && -n ${D[SOC_COMPATIBLE]:-} ]]; then
  die "$conf: SOC_IDS and SOC_COMPATIBLE are exclusive"
elif [[ -z ${D[SOC_IDS]:-} && -z ${D[SOC_COMPATIBLE]:-} ]]; then
  die "$conf: SOC_IDS is missing (or SOC_COMPATIBLE); this device can't be installed yet"
fi
# Images record the device they were built for, as flash and push check:
# out-int/images holds whichever device was built last.
if [[ $mode == repository ]]; then
  built_for=$(cat "$images/DEVICE" 2>/dev/null || true)
  [[ $built_for == "$CODENAME" ]] \
    || die "$images holds images for '${built_for:-an unknown device}', not $CODENAME (run: DEVICE=$CODENAME bin/omamobile images)"
fi
for tool in "$FASTBOOT" debugfs dumpe2fs e2fsck zstd openssl sha256sum lz4 cpio python3; do
  command -v "$tool" >/dev/null || die "$tool not found (fastboot: android-tools; debugfs: e2fsprogs; lz4: lz4; cpio: cpio)"
done
BOOT_IMAGES=${D[BOOT_IMAGES]:-} UFS_RW=${D[UFS_RW]:-}
[[ -n $BOOT_IMAGES && -n $UFS_RW ]] || die "$conf: BOOT_IMAGES and UFS_RW are required"
for p in $UFS_RW; do
  [[ $p == *_b || $p == userdata ]] || die "$conf: UFS_RW may hold only *_b partitions and userdata, not $p"
done
[[ " $UFS_RW " == *" userdata "* ]] || die "$conf: userdata is not on the storage-guard allowlist"
for p in $BOOT_IMAGES; do
  [[ $p =~ ^[a-z_]+$ ]] || die "$conf: bad image name $p"
  [[ " $UFS_RW " == *" ${p}_b "* ]] || die "$conf: ${p}_b is not on the storage-guard allowlist (UFS_RW)"
  [[ -f $images/$p.img ]] || die "missing $images/$p.img (bin/omamobile images)"
done
# An AVB_FOOTERS image is padded to the descriptor's partition size, and ABL
# reads the footer from the end of the partition, so that size must be the
# phone's exactly (checked against getvar below).
declare -A avb_size=()
for e in ${D[AVB_FOOTERS]:-}; do
  [[ $e =~ ^([a-z_]+):(0x[0-9a-f]{1,10}|[1-9][0-9]{0,11})$ ]] || die "$conf: AVB_FOOTERS entries are image:partition_size, not $e"
  avb_size[${BASH_REMATCH[1]}]=$((BASH_REMATCH[2]))
done
for p in "${!avb_size[@]}"; do
  [[ " $BOOT_IMAGES " == *" $p "* ]] || die "$conf: AVB_FOOTERS names $p, which is not in BOOT_IMAGES"
done

# --- Integrity of what will be written ---------------------------------------
say "Checking the files ($mode mode)"
root_digest="" root_name=""
if [[ $mode == bundle ]]; then
  [[ -f $here/SHA256SUMS ]] || die "the bundle has no SHA256SUMS"
  if [[ -f $here/SHA256SUMS.sig ]]; then
    command -v gpg >/dev/null || die "gpg is needed to check the bundle's signature"
    gnupg=$(mktemp -d)
    gpg --homedir "$gnupg" -q --batch --import "$here/omamobile.gpg" 2>/dev/null || die "the bundle has no omamobile.gpg"
    status=$(gpg --homedir "$gnupg" --batch --status-fd 1 --verify "$here/SHA256SUMS.sig" "$here/SHA256SUMS" 2>/dev/null || true)
    rm -rf "$gnupg"
    signer=$(grep -Eo "^\[GNUPG:\] VALIDSIG .* ($SIGNING_KEYS)\$" <<<"$status" | awk '{ print $NF }') ||
      die "SHA256SUMS is not signed by the Omarchy Mobile key (${SIGNING_KEYS//|/ or })"
    note "SHA256SUMS signed by $signer"
  else
    ((unsigned)) || die "the bundle is not signed (SHA256SUMS.sig); --unsigned accepts a development bundle"
    note "unsigned bundle (--unsigned)"
  fi
  (cd "$here" && sha256sum -c --quiet SHA256SUMS) || die "a bundle file doesn't match SHA256SUMS"
  note "bundle checksums match"
  if [[ -f $here/SHA256SUMS.sig ]]; then
    # The root image sits beside the bundle, outside SHA256SUMS. Only the
    # signed manifest can authorize its name and bytes; its .sha256 cannot.
    [[ $(grep -Ec '^[0-9a-f]{64} [ *](\./)?MANIFEST$' "$here/SHA256SUMS") == 1 ]] ||
      die "the signed checksums must cover MANIFEST exactly once"
    root_record=$(sed -n 's/^root image: //p' "$here/MANIFEST")
    root_pattern='^([A-Za-z0-9._-]+\.img\.zst) \(([0-9a-f]{64})\)$'
    [[ $root_record =~ $root_pattern ]] || die "the signed MANIFEST must name one root image and its SHA256"
    root_name=${BASH_REMATCH[1]} root_digest=${BASH_REMATCH[2]}
  fi

  # manifest.json (tools/bundle-manifest): the release and its install plan
  # as data, the one a web flasher or a desktop installer follows too. It
  # must agree exactly with the descriptor and with this script's own rules:
  # it can confirm what is written, never widen it.
  [[ -f $here/manifest.json ]] || die "the bundle has no manifest.json (tools/make-bundle writes it)"
  [[ $(grep -Ec '^[0-9a-f]{64} [ *](\./)?manifest\.json$' "$here/SHA256SUMS") == 1 ]] ||
    die "the checksums must cover manifest.json exactly once"
  command -v python3 >/dev/null || die "python3 is needed to read the bundle's manifest.json"
  # The parser checks types and characters only, and prints plain lines; the
  # rules are checked below, in this script.
  plan=$(python3 -I - "$here/manifest.json" <<'PY'
import json, re, sys

def bad(why):
    print("manifest.json: " + why, file=sys.stderr)
    sys.exit(1)

def s(v, pattern, what):
    if not isinstance(v, str) or not re.fullmatch(pattern, v):
        bad("%s is not valid" % what)
    return v

def n(v, what):
    if not isinstance(v, int) or isinstance(v, bool) or v < 0:
        bad("%s is not a size" % what)
    return v

def b(v, what):
    if not isinstance(v, bool):
        bad("%s is not true or false" % what)
    return "true" if v else "false"

try:
    m = json.load(open(sys.argv[1]))
except (OSError, ValueError) as e:
    bad("not JSON (%s)" % e)
if not isinstance(m, dict) or not isinstance(m.get("install"), dict):
    bad("no install plan")
NAME, HEX = r"[A-Za-z0-9._+-]+", r"[0-9a-f]{64}"
out = ["format=%d" % n(m.get("format"), "format"),
       "version=" + s(m.get("version"), NAME, "version"),
       "label=" + s(m.get("label"), r"[A-Za-z0-9 ._-]+", "label"),
       "codename=" + s((m.get("device") or {}).get("codename"), r"[a-z0-9]+", "device.codename"),
       "kernel_release=" + s((m.get("kernel") or {}).get("release"), NAME, "kernel.release")]
r = m.get("root_image") or {}
out += ["root_name=" + s(r.get("name"), r"[A-Za-z0-9._-]+\.img\.zst", "root_image.name"),
        "root_sha256=" + s(r.get("sha256"), HEX, "root_image.sha256")]
i = m["install"]
out += ["product=" + s(i.get("product"), r"[a-z0-9]+", "install.product"),
        "require_unlocked_bootloader=" + b(i.get("require_unlocked_bootloader"), "install.require_unlocked_bootloader"),
        "require_matching_bootloader_slots=" + b(i.get("require_matching_bootloader_slots"), "install.require_matching_bootloader_slots")]
allow = i.get("storage_guard_allowlist")
if not isinstance(allow, list):
    bad("install.storage_guard_allowlist is not a list")
out.append("allowlist=" + " ".join(s(p, r"[a-z_]+", "an allowlist entry") for p in allow))
after = i.get("after")
if not isinstance(after, list):
    bad("install.after is not a list")
out.append("after=" + ",".join(s(a, r"[a-z -]+", "an install.after step") for a in after))
writes = i.get("writes")
if not isinstance(writes, list):
    bad("install.writes is not a list")
for w in writes:
    if not isinstance(w, dict):
        bad("an install.writes entry is not an object")
    part = s(w.get("partition"), r"[a-z_]+", "a write's partition")
    src = s(w.get("source"), r"root_image|images/[a-z_]+\.img", "a write's source")
    size = "-" if src == "root_image" else str(n(w.get("size"), "a write's size"))
    psize = "-" if w.get("partition_size") is None else str(n(w.get("partition_size"), "a write's partition_size"))
    erases = b(w.get("erases_userdata", False), "erases_userdata")
    out.append("write %s %s %s %s %s" % (part, src, size, psize, erases))
files = m.get("files")
if not isinstance(files, list):
    bad("files is not a list")
for f in files:
    if not isinstance(f, dict):
        bad("a files entry is not an object")
    path = s(f.get("path"), r"[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*", "a file's path")
    if ".." in path.split("/"):
        bad("a file's path leaves the bundle")
    out.append("file %s %d %s" % (path, n(f.get("size"), "a file's size"), s(f.get("sha256"), HEX, "a file's sha256")))
print("\n".join(out))
PY
  ) || die "the bundle's manifest.json is not a valid release manifest"
  declare -A M=()
  m_writes=() m_files=()
  while IFS= read -r line; do
    case $line in
      "write "*) m_writes+=("${line#write }") ;;
      "file "*) m_files+=("${line#file }") ;;
      *=*) M[${line%%=*}]=${line#*=} ;;
    esac
  done <<<"$plan"
  [[ ${M[format]} == 1 ]] || die "manifest.json has format ${M[format]}; this installer reads format 1"
  [[ ${M[codename]} == "$CODENAME" && ${M[product]} == "$CODENAME" ]] ||
    die "manifest.json is for ${M[codename]} (product ${M[product]}), but the descriptor is $CODENAME"
  [[ ${M[require_unlocked_bootloader]} == true ]] || die "manifest.json must require an unlocked bootloader"
  [[ ${M[require_matching_bootloader_slots]} == true ]] || die "manifest.json must require both bootloader slots to match"
  read -ra allow <<<"$UFS_RW"
  [[ ${M[allowlist]} == "${allow[*]}" ]] || die "manifest.json's storage-guard allowlist (${M[allowlist]}) is not the descriptor's ($UFS_RW)"
  [[ ${M[after]} == "set-active b,reboot" ]] || die "manifest.json must end with set-active b and reboot, nothing else (has: ${M[after]})"
  # Exactly the descriptor's slot B images, in its order, then userdata
  want_writes=()
  for p in $BOOT_IMAGES; do
    want_writes+=("${p}_b images/$p.img $(stat -c %s "$here/images/$p.img") ${avb_size[$p]:--} false")
  done
  want_writes+=("userdata root_image - - true")
  [[ $(printf '%s\n' "${m_writes[@]}") == "$(printf '%s\n' "${want_writes[@]}")" ]] ||
    die "manifest.json's writes are not exactly slot B's images ($(for p in $BOOT_IMAGES; do printf '%s_b ' "$p"; done)) and userdata, with their sizes"
  # Every file of the bundle is listed with its size and SHA-256, and nothing else
  listed=() actual=()
  for entry in "${m_files[@]}"; do
    read -r path size sum <<<"$entry"
    [[ -f $here/$path ]] || die "manifest.json lists $path, which is not in the bundle"
    [[ $(stat -c %s "$here/$path") == "$size" ]] || die "$path is not the size manifest.json gives"
    [[ $(sha256sum < "$here/$path" | cut -d' ' -f1) == "$sum" ]] || die "$path does not match manifest.json"
    listed+=("$path")
  done
  mapfile -t actual < <(cd "$here" && find . -type f ! -name SHA256SUMS ! -name SHA256SUMS.sig ! -name manifest.json -printf '%P\n' | sort)
  [[ $(printf '%s\n' "${listed[@]}" | sort) == "$(printf '%s\n' "${actual[@]}")" ]] ||
    die "manifest.json does not list exactly the bundle's files"
  if [[ -f $here/SHA256SUMS.sig ]]; then
    [[ ${M[version]} =~ ^20[0-9]{2}\.(0[1-9]|1[0-2])\.(0[1-9]|[12][0-9]|3[01])(\.[1-9][0-9]*)?$ ]] ||
      die "a signed release is versioned by the calendar (YYYY.MM.DD), not ${M[version]}"
    [[ ${M[root_name]} == "$root_name" && ${M[root_sha256]} == "$root_digest" ]] ||
      die "manifest.json and MANIFEST name different root images"
    [[ ${M[kernel_release]} == "$(sed -n 's/^kernel release: //p' "$here/MANIFEST")" ]] ||
      die "manifest.json and MANIFEST name different kernels"
  fi
  note "manifest.json: Omarchy Mobile ${M[version]} (${M[label]}), its plan matches the descriptor"
fi
if [[ -z $rootfs ]]; then
  if [[ -n $root_name ]]; then
    for dir in "${root_dirs[@]}"; do
      [[ ! -f $dir/$root_name ]] || rootfs=$dir/$root_name
    done
  else
    # Read the device from the manifest, including images with legacy names.
    for dir in "${root_dirs[@]}"; do
      for f in "$dir"/omamobile-rootfs-*-aarch64.img.zst; do
        built_for=$(sed -n 's/^device: \([a-z0-9]*\).*/\1/p' "${f%.img.zst}.MANIFEST" 2>/dev/null || true)
        [[ $built_for != "$CODENAME" ]] || rootfs=$f
      done
    done
  fi
fi
[[ -n $rootfs && -f $rootfs ]] || die "no root image for $CODENAME${root_name:+ ($root_name)} (tools/build-rootfs makes one; or --rootfs FILE)"
if [[ -n $root_digest ]]; then
  [[ ${rootfs##*/} == "$root_name" ]] || die "root image must be $root_name, as named by the signed bundle"
  [[ $(sha256sum < "$rootfs" | cut -d' ' -f1) == "$root_digest" ]] || die "root image does not match the signed bundle"
  note "root image matches the signed bundle"
elif [[ -f $rootfs.sha256 ]]; then
  (cd "$(dirname "$rootfs")" && sha256sum -c --quiet "$(basename "$rootfs").sha256") || die "$rootfs doesn't match its .sha256"
  note "root image checksum matches"
else
  die "no $rootfs.sha256"
fi
manifest=${rootfs%.img.zst}.MANIFEST
if [[ -f $manifest ]]; then
  built_for=$(sed -n 's/^device: \([a-z0-9]*\).*/\1/p' "$manifest")
  [[ -z $built_for || $built_for == "$CODENAME" ]] || die "the root image was built for $built_for, not $CODENAME"
  # The kernel in the boot images must find its modules in the root image,
  # or it boots without its drivers (the GPU among them)
  modules_release=$(sed -n 's/^kernel modules: \([^ ]*\).*/\1/p' "$manifest")
  if [[ $mode == bundle ]]; then
    images_release=$(sed -n 's/^kernel release: //p' "$here/MANIFEST" 2>/dev/null || true)
  else
    images_release=$(cat "$images/../include/config/kernel.release" 2>/dev/null || true)
  fi
  if [[ -n $modules_release && -n $images_release && $modules_release != "$images_release" ]]; then
    die "the root image has modules for $modules_release, but the boot images are $images_release: rebuild one to match"
  fi
  if [[ -n $modules_release && -n $images_release ]]; then note "kernel $images_release, its modules in the root image"; fi
fi

# --- Slot B's shipped ramdisk ------------------------------------------------
# Read and listed before the phone is contacted, so --verify-only checks it
# too; the owner's key is appended to it further down. The read has a
# directory of its own in --work that only this run removes: another install
# may be waiting there for its answers, with its images staged.
work=${work:-${XDG_CACHE_HOME:-$HOME/.cache}/omamobile-install}
verify_dir=""
# vendor_ramdisk get IMG OUT, or vendor_ramdisk set IMG RAMDISK OUT (inline,
# because a bundle ships this script alone)
vendor_ramdisk() {
  python3 -I - "$@" <<'PY'
import struct, sys

def bad(why):
    print("%s: %s" % (sys.argv[2], why), file=sys.stderr)
    sys.exit(1)

img = open(sys.argv[2], "rb").read()
# vendor_boot_img_hdr_v4: magic, header_version, page_size, kernel_addr,
# ramdisk_addr, vendor_ramdisk_size (offset 24), cmdline[2048], tags_addr,
# name[16], header_size (2096), dtb_size, dtb_addr (u64),
# vendor_ramdisk_table_size (2112), _entry_num, _entry_size, bootconfig_size
if len(img) < 2128 or img[:8] != b"VNDRBOOT":
    bad("not an Android vendor boot image")
version, page, _, _, rd_size = struct.unpack_from("<5I", img, 8)
hdr_size, dtb_size = struct.unpack_from("<2I", img, 2096)
table_size, entries, entry_size, bootconfig_size = struct.unpack_from("<4I", img, 2112)
if version != 4 or hdr_size != 2128:
    bad("not a v4 vendor boot image")
if page < 2048 or page & (page - 1):
    bad("odd page size %d" % page)
if (entries, entry_size, table_size) != (1, 108, 108):
    bad("expected one vendor ramdisk, as bin/omamobile images builds")
pad = lambda n: -(-n // page) * page
o_rd = pad(2128)
o_dtb = o_rd + pad(rd_size)
o_table = o_dtb + pad(dtb_size)
if len(img) != o_table + pad(table_size) + pad(bootconfig_size):
    bad("its sections don't add up to its size (a footer?)")
if struct.unpack_from("<2I", img, o_table) != (rd_size, 0):
    bad("its ramdisk table doesn't match its header")
if sys.argv[1] == "get":
    open(sys.argv[3], "wb").write(img[o_rd:o_rd + rd_size])
    sys.exit(0)
ramdisk = open(sys.argv[3], "rb").read()
head, tail = bytearray(img[:o_rd]), bytearray(img[o_dtb:])
struct.pack_into("<I", head, 24, len(ramdisk))
struct.pack_into("<I", tail, o_table - o_dtb, len(ramdisk))
with open(sys.argv[4], "wb") as f:
    f.write(head + ramdisk + bytes(pad(len(ramdisk)) - len(ramdisk)) + tail)
PY
}
ramdisk_image=""
if [[ " $BOOT_IMAGES " == *" vendor_kernel_boot "* ]]; then ramdisk_image=vendor_kernel_boot
elif [[ " $BOOT_IMAGES " == *" vendor_boot "* ]]; then ramdisk_image=vendor_boot; fi
if [[ -n $ramdisk_image ]]; then
  [[ -z ${avb_size[$ramdisk_image]:-} ]] || die "$conf: AVB_FOOTERS names $ramdisk_image, which carries the ramdisk: the owner's key can't be added to a signed image"
  mkdir -p "$work"
  verify_dir=$(mktemp -d "$work/verify.XXXXXX")
  trap 'rm -rf "$verify_dir"' EXIT
  vendor_ramdisk get "$images/$ramdisk_image.img" "$verify_dir/shipped.cpio.lz4" || die "can't read the ramdisk of $ramdisk_image.img"
  lz4 -dc "$verify_dir/shipped.cpio.lz4" > "$verify_dir/shipped.cpio" || die "lz4 couldn't decompress $ramdisk_image.img's ramdisk"
  # With --quiet, cpio -it says nothing when it lists the archive; given bytes
  # that aren't one, it prints a line for every offset it tries and then its
  # reason, so the message carries only that last line.
  listing=$(cpio -it --quiet < "$verify_dir/shipped.cpio" 2> "$verify_dir/cpio.err") ||
    die "cpio couldn't list $ramdisk_image.img's ramdisk: $(tail -n 1 "$verify_dir/cpio.err")"
fi
if ((verify_only)); then
  say "The files check out (the phone was not contacted)"
  exit 0
fi

# --- The phone ---------------------------------------------------------------
say "Checking the phone"
mapfile -t serials < <("$FASTBOOT" devices 2>/dev/null | awk '$2 == "fastboot" {print $1}')
((${#serials[@]} == 1)) || die "expected one phone in fastboot mode, found ${#serials[@]} ('fastboot devices')"
serial=${serials[0]}
# Before any other command reaches it: the phone the caller looked at, or none
[[ -z $want_serial || $serial == "$want_serial" ]] ||
  die "the phone in fastboot mode is not the one this install was started for (--serial): connect only that phone"
fb() { "$FASTBOOT" -s "$serial" "$@"; }
vars=$(fb getvar all 2>&1 | sed -E 's/^\(bootloader\) //')
var() { awk -F: -v k="$1" '$1 == k { sub(/^[^:]*:[ ]*/, ""); print; exit }' <<<"$vars"; }
product=$(var product)
[[ $product == "$CODENAME" ]] || die "the phone is '${product:-unknown}', not $CODENAME (${D[NAME]:-}): wrong descriptor or wrong phone"
[[ $(var unlocked) == yes ]] || die "the bootloader is locked: unlock it first (this erases the phone; see CONTRIBUTING.md)"
current_slot=$(var current-slot)
current_bl=$(var version-bootloader)
[[ -n $current_bl ]] || die "the phone reports no version-bootloader"
# Per-slot bootloader versions, where the bootloader reports them
bl_a=$(sed -nE 's/^version-bootloader[-_:]a:[ ]*//p' <<<"$vars" | head -1)
bl_b=$(sed -nE 's/^version-bootloader[-_:]b:[ ]*//p' <<<"$vars" | head -1)
if [[ -n $bl_a && -n $bl_b ]]; then
  [[ $bl_a == "$bl_b" ]] || die "the bootloader slots differ (a: $bl_a, b: $bl_b). Never flash a bootloader partition by hand (CONTRIBUTING §3.1): from stock Android, sideload the full OTA for your build twice, so each slot gets the same bootloader, then rerun. If that doesn't make them match, stop and ask in an issue"
  note "bootloader $bl_a on both slots"
elif [[ -n $slots_match ]]; then
  [[ $slots_match == "$current_bl" ]] || die "--bootloader-slots-match $slots_match, but slot ${current_slot:-?} has $current_bl"
  note "bootloader $current_bl on slot ${current_slot:-?}; the other slot confirmed by you (--bootloader-slots-match)"
else
  die "the phone only reports slot ${current_slot:-?}'s bootloader ($current_bl). Setting slot B active runs slot B's bootloader, so both must match. Check the other slot (fastboot getvar version-bootloader while it is current), then rerun with --bootloader-slots-match $current_bl"
fi
note "$CODENAME, unlocked, current slot ${current_slot:-?}"
# Stock Android must be the one on slot A. An Android system update writes the
# other slot and switches to it, so a phone that took one can run stock from
# slot B, and writing slot B would overwrite the stock system in use. From
# fastboot alone a reinstall (Omarchy Mobile on B) looks the same, so the
# owner says which it is.
if [[ $current_slot == b && $reinstall != 1 ]]; then
  die "the phone runs from slot b. If stock Android is on slot b (after an Android system update), installing would overwrite it: make slot a active (fastboot --set-active=a), flash Google's factory image onto it, check Android starts, then rerun. If slot b holds Omarchy Mobile (a reinstall), rerun with --reinstall"
fi
[[ $current_slot == b ]] && note "slot b holds Omarchy Mobile (--reinstall): it will be replaced"
# Each image must fit its slot B partition, an AVB_FOOTERS image exactly.
declare -A part_size=()
for p in $BOOT_IMAGES; do
  psize=$(sed -nE "s/^partition-size:${p}_b:[ ]*(0x[0-9a-fA-F]{1,12})\$/\1/p" <<<"$vars" | head -1)
  [[ -n $psize ]] || die "the phone reports no partition-size for ${p}_b"
  psize=$((psize)) isize=$(stat -c %s "$images/$p.img")
  part_size[$p]=$psize
  ((isize <= psize)) || die "$p.img is $isize bytes, larger than ${p}_b ($psize bytes)"
  [[ -z ${avb_size[$p]:-} ]] || ((avb_size[$p] == psize)) \
    || die "$conf: AVB_FOOTERS pads $p to ${avb_size[$p]} bytes, but ${p}_b is $psize: its footer would not be at the end of the partition"
done

# --- The owner's answers -----------------------------------------------------
RESERVED='^(root|alarm|omamobile|omandroid|omarchy|bin|daemon|mail|ftp|http|nobody|dbus|systemd-.*|tss|uuidd|alpm|git|avahi|cups|cups-browsed|lp|_talkd|polkitd|rtkit|qemu|brltty|gluster|rpc|libvirt-qemu|pcscd|nvidia-persistenced|sddm|builder|admin)$'
USERNAME_RE='^[a-z_][a-z0-9_-]{0,31}$'
HOSTNAME_RE='^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$'
SSHKEY_RE='^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-nistp256@openssh\.com) [A-Za-z0-9+/]+={0,3}( [ -~]*)?$'
ask() { local prompt=$1 default=${2:-} answer; [[ -n $guided ]] || printf '%s%s: ' "$prompt" "${default:+ [$default]}" >&2; IFS= read -r answer || die "no answer"; printf '%s' "${answer:-$default}"; }
ask_secret() { local answer; [[ -n $guided ]] || printf '%s: ' "$1" >&2; IFS= read -rs answer || die "no answer"; [[ -n $guided ]] || printf '\n' >&2; printf '%s' "$answer"; }

say "About the phone's owner"
while true; do
  username=$(ask "User name")
  if [[ ! $username =~ $USERNAME_RE ]]; then echo "  lower-case letters, digits, - and _, starting with a letter or _ (at most 32)" >&2
  elif [[ $username =~ $RESERVED ]]; then echo "  '$username' is reserved; pick your own name" >&2
  else break; fi
done
while true; do
  password=$(ask_secret "Password or PIN (unlocks the phone, and for sudo)")
  again=$(ask_secret "Again")
  if [[ -z $password ]]; then echo "  it can't be empty" >&2
  elif [[ $password != "$again" ]]; then echo "  they don't match" >&2
  elif [[ $password == *$'\n'* ]]; then echo "  no line breaks" >&2
  else break; fi
done
credential=password
[[ $password =~ ^[0-9]+$ ]] && credential=pin
password_hash=$(printf '%s\n' "$password" | openssl passwd -6 -stdin)
unset password again
[[ $password_hash == '$6$'* ]] || die "openssl passwd -6 failed"
while true; do
  hostname=$(ask "Host name" "$username-phone")
  [[ $hostname =~ $HOSTNAME_RE ]] && break
  echo "  1-63 letters, digits or dashes, not starting or ending with a dash" >&2
done
tz_default=$(timedatectl show -p Timezone --value 2>/dev/null || true)
[[ -n $tz_default ]] || tz_default=$(readlink /etc/localtime 2>/dev/null | sed 's|.*/zoneinfo/||' || true)
while true; do
  timezone=$(ask "Time zone" "${tz_default:-UTC}")
  [[ $timezone =~ ^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$ && -f /usr/share/zoneinfo/$timezone ]] && break
  echo "  not a time zone (like Europe/Paris or America/New_York)" >&2
done
full_name=$(ask "Full name for git (optional)")
[[ $full_name != *[:,]* ]] || die "the full name can't contain : or ,"
email=$(ask "Email for git (optional)")
[[ -z $email || $email =~ ^[^[:space:]@]+@[^[:space:]@]+$ ]] || die "'$email' is not an email address"
wifi_ssid=$(ask "Wi-Fi network name (optional; Enter to skip)")
wifi_psk=""
if [[ -n $wifi_ssid ]]; then
  (( ${#wifi_ssid} <= 32 )) || die "a Wi-Fi network name is at most 32 characters"
  wifi_psk=$(ask_secret "Wi-Fi password (Enter for an open network)")
  [[ -z $wifi_psk || $wifi_psk =~ ^[\ -~]{8,63}$ || $wifi_psk =~ ^[0-9A-Fa-f]{64}$ ]] ||
    die "a Wi-Fi password is 8-63 printable characters"
fi
while true; do
  key_file=$(ask "SSH public key for root and $username" "$HOME/.ssh/id_ed25519.pub")
  key_file=${key_file/#\~/$HOME}
  if [[ -f $key_file ]] && [[ $(head -1 "$key_file") =~ $SSHKEY_RE ]] && [[ $(grep -c . "$key_file") == 1 ]]; then break; fi
  echo "  not a single OpenSSH public key file (a .pub, never the private key)" >&2
done
ssh_key=$(head -1 "$key_file")

# --- A local copy of the root image, with the owner's first-boot file -------
mkdir -p "$work"
chmod 700 "$work"
copy=$work/root.img sparse=$work/root.simg conf_file=$work/firstboot.conf keys_file=$work/authorized_keys
boot_conf=$work/boot-update.conf ramdisk_dir=$work/ramdisk
# The copy holds the password hash (and any Wi-Fi password): never left behind
cleanup() { rm -f "$conf_file" "$keys_file" "$boot_conf" "$copy" "$sparse"; rm -rf "$ramdisk_dir" "$verify_dir"; }
trap cleanup EXIT
(
  umask 077
  {
    echo "# Written by install-phone on the laptop; omamobile-firstboot reads and deletes it."
    echo "USERNAME=$username"
    echo "PASSWORD_HASH=$password_hash"
    echo "HOSTNAME=$hostname"
    echo "TIMEZONE=$timezone"
    echo "SSH_KEY=$ssh_key"
    echo "CREDENTIAL=$credential"
    [[ -n $full_name ]] && echo "FULL_NAME=$full_name"
    [[ -n $email ]] && echo "EMAIL=$email"
    if [[ -n $wifi_ssid ]]; then
      echo "WIFI_SSID=$wifi_ssid"
      [[ -n $wifi_psk ]] && echo "WIFI_PSK=$wifi_psk"
    fi
  } > "$conf_file"
  printf '%s\n' "$ssh_key" > "$keys_file"
  printf '%s\n' "# Written by install-phone: a release install takes kernel updates through" \
    "# omamobile-boot-update's pacman hook (docs/RELEASES.md §5.3). AUTO_WRITE=no stops it." \
    "AUTO_WRITE=$BOOT_UPDATE_AUTO_WRITE" > "$boot_conf"
)
unset wifi_psk

say "Preparing a local copy of the root image in $work"
rm -f "$copy" "$sparse"
zstd -q -d --sparse -f "$rootfs" -o "$copy"
[[ $(dumpe2fs -h "$copy" 2>/dev/null | sed -n 's/^Filesystem volume name: *//p') == omamobile-root ]] ||
  die "$rootfs is not an Omarchy Mobile root image (label omamobile-root)"
# debugfs's mkdir on a directory that already exists (a restored or
# lived-in root) still allocates the inode, then fails to link it, which
# leaves an unconnected directory: make only the missing ones.
mkdirs=""
for d in /etc/omamobile /root/.ssh; do
  debugfs -R "stat $d" "$copy" 2>/dev/null | grep -c '^Inode:' >/dev/null || mkdirs+="mkdir $d"$'\n'
done
# debugfs splits its commands at blanks: a host path goes in double quotes,
# with any double quote in it doubled
dq() { printf '"%s"' "${1//\"/\"\"}"; }
debugfs -w -f - "$copy" >/dev/null 2>&1 <<EOF || true
${mkdirs}rm /etc/omamobile/firstboot.conf
write $(dq "$conf_file") /etc/omamobile/firstboot.conf
sif /etc/omamobile/firstboot.conf mode 0100600
sif /etc/omamobile/firstboot.conf uid 0
sif /etc/omamobile/firstboot.conf gid 0
rm /etc/omamobile/boot-update.conf
write $(dq "$boot_conf") /etc/omamobile/boot-update.conf
sif /etc/omamobile/boot-update.conf mode 0100644
sif /etc/omamobile/boot-update.conf uid 0
sif /etc/omamobile/boot-update.conf gid 0
sif /root/.ssh mode 040700
sif /root/.ssh uid 0
sif /root/.ssh gid 0
rm /root/.ssh/authorized_keys
write $(dq "$keys_file") /root/.ssh/authorized_keys
sif /root/.ssh/authorized_keys mode 0100600
sif /root/.ssh/authorized_keys uid 0
sif /root/.ssh/authorized_keys gid 0
EOF
cmp -s <(debugfs -R "cat /etc/omamobile/firstboot.conf" "$copy" 2>/dev/null) "$conf_file" || die "writing firstboot.conf into the image copy failed"
cmp -s <(debugfs -R "cat /root/.ssh/authorized_keys" "$copy" 2>/dev/null) "$keys_file" || die "writing authorized_keys into the image copy failed"
cmp -s <(debugfs -R "cat /etc/omamobile/boot-update.conf" "$copy" 2>/dev/null) "$boot_conf" || die "writing boot-update.conf into the image copy failed"
e2fsck -fn "$copy" >/dev/null 2>&1 || die "the image copy doesn't check clean after the writes"
note "firstboot.conf, root's authorized_keys and boot-update.conf (AUTO_WRITE=$BOOT_UPDATE_AUTO_WRITE) written, file system checks clean"
userdata_image=$copy
if command -v img2simg >/dev/null; then
  img2simg "$copy" "$sparse"
  rm -f "$copy"
  userdata_image=$sparse
  note "converted to an Android sparse image ($(du -h "$sparse" | cut -f1))"
fi

# --- The owner's key in slot B's initramfs -----------------------------------
# omamobile-boot-update builds slot B's ramdisk with root's authorized_keys
# appended (docs/RELEASES.md §5.2). Without the same here, the initramfs's
# rescue SSH has no owner key until the hook first runs, and that run rewrites
# an image the bundle should already hold (§11 step 4, #564). So a copy of the
# ramdisk image gets what lib/omamobile-boot-images appends, by its commands
# with the modes pacman's umask gives them: a cpio holding the key, after the
# shipped archive in one lz4 stream; vendor_ramdisk then sets the new size in
# the copy's v4 header and ramdisk table, where mkbootimg puts it. With the
# phone's lz4 and cpio that is the hook's image byte for byte, under any umask
# (tests/install-phone-initramfs).
# A ramdisk that already holds authorized_keys (a development initramfs) is
# left as built.
declare -A image_file=()
for p in $BOOT_IMAGES; do image_file[$p]=$images/$p.img; done
if [[ -n $ramdisk_image ]]; then
  if grep -qE '^(\./)?root/\.ssh/authorized_keys$' <<<"$listing"; then
    note "$ramdisk_image.img's initramfs already holds SSH keys (a development build): left as built"
  else
    # omamobile-boot-images' commands. The hook runs under pacman's umask
    # (022), so root/ is 0755; its mode is set here because not every
    # install(1) ignores the umask for parents (uutils' follows it).
    rm -rf "$ramdisk_dir" && mkdir -p "$ramdisk_dir"
    extra=$ramdisk_dir/extra
    install -d -m 755 "$extra/root" && install -d -m 700 "$extra/root/.ssh" &&
      install -m 600 "$keys_file" "$extra/root/.ssh/authorized_keys" &&
      find "$extra" -exec touch -h -d @0 {} + || die "can't stage the owner's key for the initramfs"
    reproducible=()
    cpio --help 2>/dev/null | grep -c -- --reproducible >/dev/null && reproducible=(--reproducible)
    (cd "$extra" && find . -mindepth 1 | LC_ALL=C sort | cpio -o -H newc --owner=0:0 --quiet "${reproducible[@]}") > "$ramdisk_dir/extra.cpio" ||
      die "cpio couldn't pack the owner's key for the initramfs"
    cat "$verify_dir/shipped.cpio" "$ramdisk_dir/extra.cpio" | lz4 -l -9 -q > "$ramdisk_dir/initramfs.cpio.lz4" ||
      die "lz4 couldn't recompress $ramdisk_image.img's ramdisk with the owner's key"
    vendor_ramdisk set "$images/$ramdisk_image.img" "$ramdisk_dir/initramfs.cpio.lz4" "$ramdisk_dir/$ramdisk_image.img" ||
      die "rewriting $ramdisk_image.img with the new ramdisk failed"
    isize=$(stat -c %s "$ramdisk_dir/$ramdisk_image.img")
    ((isize <= part_size[$ramdisk_image])) ||
      die "$ramdisk_image.img with the owner's key is $isize bytes, larger than ${ramdisk_image}_b (${part_size[$ramdisk_image]} bytes)"
    image_file[$ramdisk_image]=$ramdisk_dir/$ramdisk_image.img
    note "the owner's key appended to $ramdisk_image.img's initramfs (as omamobile-boot-update appends it)"
  fi
fi

# --- What will be written ----------------------------------------------------
# The only way this script writes to the phone. PART must be one of the
# descriptor's boot images with _b on the allowlist, or userdata.
flash() {
  local part=$1 file=$2 ok=0 p
  for p in $BOOT_IMAGES; do [[ $part == "${p}_b" ]] && ok=1; done
  [[ $part == userdata ]] && ok=1
  ((ok)) && [[ " $UFS_RW " == *" $part "* ]] || die "refusing to write $part: not a slot B boot image or userdata on the allowlist"
  run flash "$part" "$file"
}
run() {
  if ((dry)); then
    printf '    would run: %s -s %s %s\n' "$FASTBOOT" "$serial" "$*"
  else
    printf '    %s %s\n' "$FASTBOOT" "$*"
    fb "$@" || die "fastboot $* failed; the phone is still in fastboot. Slot A is untouched; fix the cause and rerun"
  fi
}

say "The plan"
note "phone:     ${D[NAME]:-$CODENAME} ($CODENAME), serial $serial"
note "user:      $username ($credential), host $hostname, time zone $timezone"
note "Wi-Fi:     ${wifi_ssid:-none}"
note "SSH key:   ${ssh_key:0:40}... (root and $username)"
note "root image: $(basename "$rootfs")"
echo
echo "These commands, and only these, will run:"
for p in $BOOT_IMAGES; do echo "    fastboot flash ${p}_b ${image_file[$p]}"; done
echo "    fastboot flash userdata $userdata_image"
echo "    fastboot --set-active=b"
echo "    fastboot reboot"
echo
echo "userdata will be ERASED: stock Android's data is lost, and stock Android on"
echo "slot A will need a factory reset if you ever boot it again. Slot A itself,"
echo "the bootloader, radio, persist, efs, modem and devinfo are not touched."
echo
answer=$(ask "Type the phone's codename ($CODENAME) to go ahead")
[[ $answer == "$CODENAME" ]] || die "not confirmed; nothing was written"

((dry)) && say "Dry run: printing the commands instead of running them" || say "Flashing"
for p in $BOOT_IMAGES; do flash "${p}_b" "${image_file[$p]}"; done
flash userdata "$userdata_image"
run --set-active=b
run reboot
if ((dry)); then
  say "Dry run done: nothing was written to the phone"
else
  say "Done. The phone boots slot B; the first boot sets up $username (a few minutes)."
  if [[ -z $guided ]]; then
    echo "    Watch it:  tools/phone-ssh 'journalctl -fu omamobile-firstboot'"
    echo "    Then:      tools/nv-backup DIR, then tools/phone-provision --first-install --nv-backup DIR FACTORY.zip"
    echo "               (firmware, per-phone data; a reinstall with a phone-config.tar: --restore DIR)"
  fi
fi
