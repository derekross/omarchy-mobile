slot_probe_lost() {  # SLOT WHEN
  probe_restore=""
  printf '\e[31merror:\e[0m %s\n' "the phone was not seen to leave and come back to its bootloader screen within $SLOT_PROBE_TIMEOUT s after $2. Nothing more is sent to it, and slot $probe_other was not measured" >&2
  {
    echo "    Slot $probe_other may be the active slot now. To make slot $1 active again:"
    slot_probe_recovery "$1"
    echo "    Nothing was flashed or erased; the bootloader's slot flags changed."
  } >&2
  exit 3
}
slot_probe_undo() {
  local rc=$? slot=$probe_restore
  trap - EXIT INT TERM HUP
  if [[ -n $slot ]]; then
    probe_restore=""
    if ! phone_listed; then
      {
        echo "    The phone no longer answers in fastboot, so nothing more is sent to it. To make slot $slot active again:"
        slot_probe_recovery "$slot"
      } >&2
    elif pfb --set-active="$slot"; then
      {
        echo "    The check stopped early: slot $slot was set active again (fastboot --set-active=$slot). Nothing was flashed or erased; the bootloader's slot flags changed."
        case $probe_stage in
          0) echo "    The phone is still on slot $slot's bootloader screen." ;;
          2) echo "    The phone is on slot $probe_other's bootloader screen with slot $slot active: restart it into the bootloader ($FASTBOOT -s $serial reboot bootloader) before running the installer again." ;;
          *) echo "    The phone may be on slot $probe_other's bootloader screen with slot $slot active: read $FASTBOOT -s $serial getvar current-slot, and if it isn't $slot, restart it into the bootloader ($FASTBOOT -s $serial reboot bootloader) before running the installer again." ;;
        esac
      } >&2
    else
      {
        echo "    Setting slot $slot active again failed. To do it by hand:"
        slot_probe_recovery "$slot"
      } >&2
    fi
  fi
  exit "$rc"
}
slot_probe() {
  local x=$current_slot other=b other_bl answer="" step s f changed=""
  [[ $x == a ]] || other=a
  probe_other=$other
  slot_flags_read before
  say "Checking slot $other's bootloader (the phone reports only slot $x's)"
  note "Both slots must carry the same bootloader version before slot B is used, and"
  note "this phone reports only the current slot's. To read the other one, the phone"
  note "restarts into its bootloader screen twice: once on slot $other, then back on"
  note "slot $x. That starts slot $other's bootloader before its version is known."
  note "Nothing is flashed or erased. The bootloader's own record of the two slots"
  note "does change (stock Android's slot can lose its \"successful\" mark; what that"
  note "costs later has not been measured). It is shown here, and again afterwards:"
  slot_flags_line before "now"
  note "Leave the cable in and the buttons alone. If this is interrupted (the"
  note "installer killed, the cable pulled), slot $other may be left active. Then:"
  slot_probe_recovery "$x"
  note "The commands:"
  for step in "--set-active=$other" "getvar all" "reboot bootloader" "getvar all" "--set-active=$x" "reboot bootloader" "getvar all"; do
    if ((dry)); then printf '    would run: %s -s %s %s\n' "$FASTBOOT" "$serial" "$step"; else printf '    %s -s %s %s\n' "$FASTBOOT" "$serial" "$step"; fi
  done
  if ((dry)); then
    slot_probe_dry=1
    note "dry run: none of it was run, so slot $other's bootloader was not measured"
    return 0
  fi
  # The yes comes from a terminal or from the caller's option, never from
  # piped answers, where a line meant for another question could be taken.
  if ((measure_ok)); then
    note "agreed to by the caller (--measure-other-slot)"
  elif [[ -t 0 ]]; then
    printf 'Type yes to run this check: ' >&2
    IFS= read -r answer || answer=""
    [[ $answer == yes ]] || probe_die "not run; nothing was sent to the phone. To install without it, check the other slot yourself, then rerun with --bootloader-slots-match $current_bl"
  else
    probe_die "not run; nothing was sent to the phone. The slot check needs a yes typed in a terminal, or --measure-other-slot from the tool that asked the owner. To install without it, check the other slot yourself, then rerun with --bootloader-slots-match $current_bl"
  fi
  probe_restore=$x slot_probe_ran=1
  trap slot_probe_undo EXIT
  trap 'exit 130' INT TERM HUP
  pfb --set-active="$other" || probe_die "fastboot --set-active=$other failed"
  vars=$(pfb getvar all 2>&1 | sed -E 's/^\(bootloader\) //') || probe_die "the phone did not answer getvar all after --set-active=$other"
  [[ $(var current-slot) == "$x" ]] || probe_die "before any restart the phone already reports current slot '$(var current-slot)': on this bootloader current-slot follows the active slot, so it can't show whose bootloader is running. Slot $other was not measured"
  pfb reboot bootloader || probe_die "fastboot reboot bootloader failed"
  probe_stage=1
  slot_probe_wait || slot_probe_lost "$x" "the first restart"
  vars=$(pfb getvar all 2>&1 | sed -E 's/^\(bootloader\) //') || probe_die "the phone did not answer getvar all after the first restart"
  [[ $(var current-slot) == "$other" ]] || probe_die "after the first restart the phone reports current slot '$(var current-slot)', not $other"
  probe_stage=2
  other_bl=$(var version-bootloader)
  [[ -n $other_bl ]] || probe_die "the phone reports no version-bootloader on slot $other"
  slot_flags_read during
  pfb --set-active="$x" || probe_die "fastboot --set-active=$x failed"
  pfb reboot bootloader || probe_die "fastboot reboot bootloader failed"
  probe_stage=3
  slot_probe_wait || slot_probe_lost "$x" "the second restart"
  vars=$(pfb getvar all 2>&1 | sed -E 's/^\(bootloader\) //') || probe_die "the phone did not answer getvar all after the second restart"
  [[ $(var current-slot) == "$x" ]] || probe_die "after the second restart the phone reports current slot '$(var current-slot)', not $x"
  [[ $(var version-bootloader) == "$current_bl" ]] || probe_die "slot $x reported bootloader $current_bl before the check and $(var version-bootloader) after it"
  slot_flags_read after
  probe_restore=""
  trap - EXIT INT TERM HUP
  note "the phone is back on slot $x. Slot flags:"
  slot_flags_line before "before"
  slot_flags_line during "on slot $other"
  slot_flags_line after "after"
  for s in a b; do
    for f in successful unbootable retry-count fastboot-ok; do
      [[ ${slot_flags[before $f $s]} == "${slot_flags[after $f $s]}" ]] ||
        changed+="${changed:+, }slot-$f:$s ${slot_flags[before $f $s]:-?} -> ${slot_flags[after $f $s]:-?}"
    done
  done
  note "changed by the check: ${changed:-nothing}"
  if [[ $x == a ]]; then bl_a=$current_bl bl_b=$other_bl; else bl_a=$other_bl bl_b=$current_bl; fi
  [[ $bl_a == "$bl_b" ]] || probe_die "the bootloader slots differ (a: $bl_a, b: $bl_b). $SLOTS_DIFFER"
  note "bootloader $current_bl on both slots (slot $other measured)"
  note "a rerun can skip this check: --bootloader-slots-match $current_bl"
}
SLOTS_DIFFER="Never flash a bootloader partition by hand (CONTRIBUTING §3.1): from stock Android, sideload the full OTA for your build twice, so each slot gets the same bootloader, then rerun. If that doesn't make them match, stop and ask in an issue"
refuse_stock_on_b() {
  die "the phone runs from slot b. If stock Android is on slot b (after an Android system update), installing would overwrite it: make slot a active (fastboot --set-active=a), flash Google's factory image onto it, check Android starts, then rerun. If slot b holds Omarchy Mobile (a reinstall), rerun with --reinstall"
}

# --- The phone ---------------------------------------------------------------
say "Checking the phone"
mapfile -t serials < <("$FASTBOOT" devices 2>/dev/null | awk '$2 == "fastboot" {print $1}')
((${#serials[@]} == 1)) || die "expected one phone in fastboot mode, found ${#serials[@]} ('fastboot devices')"
serial=${serials[0]}
# Before any other command reaches it: the phone the caller looked at, or none
[[ -z $want_serial || $serial == "$want_serial" ]] ||
  die "the phone in fastboot mode is not the one this install was started for (--serial): connect only that phone"
fb() { "$FASTBOOT" -s "$serial" "$@"; }
# The phone's variables (read-only); read again before a format 2 install's
# first flash and after its writes
read_vars() { vars=$(fb getvar all 2>&1 | sed -E 's/^\(bootloader\) //'); }
read_vars
var() { awk -F: -v k="$1" '$1 == k { sub(/^[^:]*:[ ]*/, ""); print; exit }' <<<"$vars"; }
product=$(var product)
[[ $product == "$CODENAME" ]] || die "the phone is '${product:-unknown}', not $CODENAME (${D[NAME]:-}): wrong descriptor or wrong phone"
[[ $(var unlocked) == yes ]] || die "the bootloader is locked: unlock it first (this erases the phone; see CONTRIBUTING.md)"
current_slot=$(var current-slot)
# Slot b is refused below without --reinstall, so a phone that doesn't say
# which slot it runs from can't be let through as if it had said slot a; and
# format 2 writes the slot it names
[[ $current_slot == a || $current_slot == b ]] ||
  die "the phone doesn't report its current slot as a or b (current-slot: '$current_slot'). Which slot is written depends on it, so the installer goes on only when it knows which slot the phone runs from"
current_bl=$(var version-bootloader)
[[ -n $current_bl ]] || die "the phone reports no version-bootloader"
if ((fmt == 2)); then
  # The running slot (format 2): the bootloader that starts Omarchy Mobile is
  # the one answering now, so the other slot's version, the slot check,
  # --bootloader-slots-match and --reinstall have no part in it. The slot
  # must be one the descriptor accepts; the stop names no way round it, and
  # never "--set-active": that would start the other slot's bootloader at a
  # version nothing here has read.
  [[ " $ACTIVE_SLOTS " == *" $current_slot "* ]] ||
    die "the phone runs from slot $current_slot, and this release installs only on slot ${ACTIVE_SLOTS// / or } (current-slot-not-accepted): installing on slot $current_slot is not supported yet. Don't switch the phone's slot to get past this; ask in an issue (https://github.com/derekross/omarchy-mobile/issues)"
  target=$current_slot
  ((reinstall == 0 && measure_ok == 0)) && [[ -z $slots_match ]] ||
    note "--reinstall, --bootloader-slots-match and --measure-other-slot are not used: this release installs on the slot the phone runs from"
  other=b
  [[ $target == b ]] && other=a
  slot_flags_read before
  note "bootloader $current_bl on slot $target, the slot the phone runs from; it starts Omarchy Mobile, and no slot is switched"
  note "$CODENAME, unlocked, current slot $current_slot"
  slot_flags_line before "slot flags"
  if [[ $(slot_flag successful "$other") == yes && $(slot_flag unbootable "$other") != yes ]]; then
    note "slot $other reads as a system that has started (stock Android after a system update, or a development install): it is left as it is"
  fi
fi
# Format 1 (slot B): both bootloader slots must match, and slot B is stock's
# after a system update unless the owner says it is a reinstall
if ((fmt == 1)); then
  # Per-slot bootloader versions, where the bootloader reports them
  bl_a=$(sed -nE 's/^version-bootloader[-_:]a:[ ]*//p' <<<"$vars" | head -1)
  bl_b=$(sed -nE 's/^version-bootloader[-_:]b:[ ]*//p' <<<"$vars" | head -1)
  if [[ -n $bl_a && -n $bl_b ]]; then
    [[ $bl_a == "$bl_b" ]] || die "the bootloader slots differ (a: $bl_a, b: $bl_b). $SLOTS_DIFFER"
    note "bootloader $bl_a on both slots"
  elif [[ -n $slots_match ]]; then
    [[ $slots_match == "$current_bl" ]] || die "--bootloader-slots-match $slots_match, but slot $current_slot has $current_bl"
    note "bootloader $current_bl on slot $current_slot; the other slot confirmed by you (--bootloader-slots-match)"
  elif [[ $current_slot == b && $reinstall == 1 ]]; then
    # The reinstall rule (decided 2026-11-13): the version reported is slot
    # B's own, the one this phone already starts from, and --set-active=b
    # below switches no slot, so no other bootloader comes into play
    note "bootloader $current_bl: slot B's bootloader, which the phone already runs; the install switches no slot (--reinstall)"
  else
    unmeasured="the phone only reports slot ${current_slot}'s bootloader ($current_bl). Setting slot B active runs slot B's bootloader, so both must match. Check the other slot (fastboot getvar version-bootloader while it is current), then rerun with --bootloader-slots-match $current_bl"
    # Today's stop, unless this device's descriptor turns the round trip on
    [[ $SLOT_PROBE == yes ]] || die "$unmeasured"
    if ((reinstall)); then
      die "$unmeasured. With --reinstall the installer does not switch slots to measure it: that clears slot B's successful mark, which on some phones costs boot tries and can end in a fallback that erases userdata"
    elif [[ $current_slot == b ]]; then
      refuse_stock_on_b
    fi
    # "First install" is all fastboot can show of it: on slot a, no --reinstall,
    # and slot b not looking like a system that has started and can still
    # start. That look (successful yes, unbootable no) is an installed Omarchy
    # Mobile with the phone sent back to slot a, and also stock after a system
    # update; the two can't be told apart from here, so neither gets the round
    # trip. Flags the phone doesn't report count as that look too.
    if [[ $(slot_flag unbootable b) != yes && $(slot_flag successful b) != no ]]; then
      die "$unmeasured. The installer does not switch slots to measure it on this phone as it is: slot b reads successful '$(slot_flag successful b)', unbootable '$(slot_flag unbootable b)', and a slot that has started and can still start is what an installed Omarchy Mobile looks like from fastboot (stock Android after a system update looks the same). Switching slots would clear that mark. If slot b holds Omarchy Mobile, this is a reinstall: say --reinstall as well"
    fi
    slot_probe
  fi
  note "$CODENAME, unlocked, current slot $current_slot"
  # Stock Android must be the one on slot A. An Android system update writes the
  # other slot and switches to it, so a phone that took one can run stock from
  # slot B, and writing slot B would overwrite the stock system in use. From
  # fastboot alone a reinstall (Omarchy Mobile on B) looks the same, so the
  # owner says which it is.
  if [[ $current_slot == b && $reinstall != 1 ]]; then
    refuse_stock_on_b
  fi
  [[ $current_slot == b ]] && note "slot b holds Omarchy Mobile (--reinstall): it will be replaced"
fi
# Each image must fit the partition it is written to (slot B's, or the
# running slot's), an AVB_FOOTERS image exactly.
declare -A part_size=()
for p in $BOOT_IMAGES; do
  psize=$(sed -nE "s/^partition-size:${p}_$target:[ ]*(0x[0-9a-fA-F]{1,12})\$/\1/p" <<<"$vars" | head -1)
  [[ -n $psize ]] || die "the phone reports no partition-size for ${p}_$target"
  psize=$((psize)) isize=$(stat -c %s "$images/$p.img")
  part_size[$p]=$psize
  ((isize <= psize)) || die "$p.img is $isize bytes, larger than ${p}_$target ($psize bytes)"
  [[ -z ${avb_size[$p]:-} ]] || ((avb_size[$p] == psize)) \
    || die "$conf: AVB_FOOTERS pads $p to ${avb_size[$p]} bytes, but ${p}_$target is $psize: its footer would not be at the end of the partition"
done

# --- The owner's answers -----------------------------------------------------
RESERVED='^(root|alarm|omamobile|omandroid|omarchy|bin|daemon|mail|ftp|http|nobody|dbus|systemd-.*|tss|uuidd|alpm|git|avahi|cups|cups-browsed|lp|_talkd|polkitd|rtkit|qemu|brltty|gluster|rpc|libvirt-qemu|pcscd|nvidia-persistenced|sddm|builder|admin)$'
USERNAME_RE='^[a-z_][a-z0-9_-]{0,31}$'
HOSTNAME_RE='^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?$'
SSHKEY_RE='^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-nistp256@openssh\.com) [A-Za-z0-9+/]+={0,3}( [ -~]*)?$'
ask() { local prompt=$1 default=${2:-} answer; [[ -n $guided ]] || printf '%s%s: ' "$prompt" "${default:+ [$default]}" >&2; IFS= read -r answer || die "no answer"; printf '%s' "${answer:-$default}"; }
ask_secret() { local answer; [[ -n $guided ]] || printf '%s: ' "$1" >&2; IFS= read -rs answer || die "no answer"; [[ -n $guided ]] || printf '\n' >&2; printf '%s' "$answer"; }

say "About the phone's owner"
while true; do
  username=$(ask "User name")
  if [[ ! $username =~ $USERNAME_RE ]]; then echo "  lower-case letters, digits, - and _, starting with a letter or _ (at most 32)" >&2
  elif [[ $username =~ $RESERVED ]]; then echo "  '$username' is reserved; pick your own name" >&2
  else break; fi
done
while true; do
  password=$(ask_secret "Password or PIN (unlocks the phone, and for sudo)")
  again=$(ask_secret "Again")
  if [[ -z $password ]]; then echo "  it can't be empty" >&2
  elif [[ $password != "$again" ]]; then echo "  they don't match" >&2
  elif [[ $password == *$'\n'* ]]; then echo "  no line breaks" >&2
  else break; fi
done
credential=password
[[ $password =~ ^[0-9]+$ ]] && credential=pin
password_hash=$(printf '%s\n' "$password" | openssl passwd -6 -stdin)
unset password again
[[ $password_hash == '$6$'* ]] || die "openssl passwd -6 failed"
while true; do
  hostname=$(ask "Host name" "$username-phone")
  [[ $hostname =~ $HOSTNAME_RE ]] && break
  echo "  1-63 letters, digits or dashes, not starting or ending with a dash" >&2
done
tz_default=$(timedatectl show -p Timezone --value 2>/dev/null || true)
[[ -n $tz_default ]] || tz_default=$(readlink /etc/localtime 2>/dev/null | sed 's|.*/zoneinfo/||' || true)
while true; do
  timezone=$(ask "Time zone" "${tz_default:-UTC}")
  [[ $timezone =~ ^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$ && -f /usr/share/zoneinfo/$timezone ]] && break
  echo "  not a time zone (like Europe/Paris or America/New_York)" >&2
done
full_name=$(ask "Full name for git (optional)")
[[ $full_name != *[:,]* ]] || die "the full name can't contain : or ,"
email=$(ask "Email for git (optional)")
[[ -z $email || $email =~ ^[^[:space:]@]+@[^[:space:]@]+$ ]] || die "'$email' is not an email address"
wifi_ssid=$(ask "Wi-Fi network name (optional; Enter to skip)")
wifi_psk=""
if [[ -n $wifi_ssid ]]; then
  (( ${#wifi_ssid} <= 32 )) || die "a Wi-Fi network name is at most 32 characters"
  wifi_psk=$(ask_secret "Wi-Fi password (Enter for an open network)")
  [[ -z $wifi_psk || $wifi_psk =~ ^[\ -~]{8,63}$ || $wifi_psk =~ ^[0-9A-Fa-f]{64}$ ]] ||
    die "a Wi-Fi password is 8-63 printable characters"
fi
while true; do
  key_file=$(ask "SSH public key for root and $username" "$HOME/.ssh/id_ed25519.pub")
  key_file=${key_file/#\~/$HOME}
  if [[ -f $key_file ]] && [[ $(head -1 "$key_file") =~ $SSHKEY_RE ]] && [[ $(grep -c . "$key_file") == 1 ]]; then break; fi
  echo "  not a single OpenSSH public key file (a .pub, never the private key)" >&2
done
ssh_key=$(head -1 "$key_file")

# --- A local copy of the root image, with the owner's first-boot file -------
mkdir -p "$work"
chmod 700 "$work"
copy=$work/root.img sparse=$work/root.simg conf_file=$work/firstboot.conf keys_file=$work/authorized_keys
boot_conf=$work/boot-update.conf ramdisk_dir=$work/ramdisk
# The copy holds the password hash (and any Wi-Fi password): never left behind
cleanup() { rm -f "$conf_file" "$keys_file" "$boot_conf" "$copy" "$sparse"; rm -rf "$ramdisk_dir" "$verify_dir"; }
trap cleanup EXIT
(
  umask 077
  {
    echo "# Written by install-phone on the laptop; omamobile-firstboot reads and deletes it."
    echo "USERNAME=$username"
    echo "PASSWORD_HASH=$password_hash"
    echo "HOSTNAME=$hostname"
    echo "TIMEZONE=$timezone"
    echo "SSH_KEY=$ssh_key"
    echo "CREDENTIAL=$credential"
    [[ -n $full_name ]] && echo "FULL_NAME=$full_name"
    [[ -n $email ]] && echo "EMAIL=$email"
    if [[ -n $wifi_ssid ]]; then
      echo "WIFI_SSID=$wifi_ssid"
      [[ -n $wifi_psk ]] && echo "WIFI_PSK=$wifi_psk"
    fi
  } > "$conf_file"
  printf '%s\n' "$ssh_key" > "$keys_file"
  # Format 2: SLOT=, the slot the install wrote and kernel updates write
  # (absent means b, so a format 1 install's file stays as it always was).
  # Its place before AUTO_WRITE is harmless either way; it is kept first
  # for readability.
  slot_line=()
  ((fmt == 1)) || slot_line=("SLOT=$target")
  printf '%s\n' "# Written by install-phone: a release install takes kernel updates through" \
    "# omamobile-boot-update's pacman hook (docs/RELEASES.md §5.3). AUTO_WRITE=no stops it." \
    "${slot_line[@]}" "AUTO_WRITE=$BOOT_UPDATE_AUTO_WRITE" > "$boot_conf"
)
unset wifi_psk

say "Preparing a local copy of the root image in $work"
rm -f "$copy" "$sparse"
zstd -q -d --sparse -f "$rootfs" -o "$copy"
[[ $(dumpe2fs -h "$copy" 2>/dev/null | sed -n 's/^Filesystem volume name: *//p') == omamobile-root ]] ||
  die "$rootfs is not an Omarchy Mobile root image (label omamobile-root)"
# debugfs's mkdir on a directory that already exists (a restored or
# lived-in root) still allocates the inode, then fails to link it, which
# leaves an unconnected directory: make only the missing ones.
mkdirs=""
for d in /etc/omamobile /root/.ssh; do
  debugfs -R "stat $d" "$copy" 2>/dev/null | grep -c '^Inode:' >/dev/null || mkdirs+="mkdir $d"$'\n'
done
# debugfs splits its commands at blanks: a host path goes in double quotes,
# with any double quote in it doubled
dq() { printf '"%s"' "${1//\"/\"\"}"; }
debugfs -w -f - "$copy" >/dev/null 2>&1 <<EOF || true
${mkdirs}rm /etc/omamobile/firstboot.conf
write $(dq "$conf_file") /etc/omamobile/firstboot.conf
sif /etc/omamobile/firstboot.conf mode 0100600
sif /etc/omamobile/firstboot.conf uid 0
sif /etc/omamobile/firstboot.conf gid 0
rm /etc/omamobile/boot-update.conf
write $(dq "$boot_conf") /etc/omamobile/boot-update.conf
sif /etc/omamobile/boot-update.conf mode 0100644
sif /etc/omamobile/boot-update.conf uid 0
sif /etc/omamobile/boot-update.conf gid 0
sif /root/.ssh mode 040700
sif /root/.ssh uid 0
sif /root/.ssh gid 0
rm /root/.ssh/authorized_keys
write $(dq "$keys_file") /root/.ssh/authorized_keys
sif /root/.ssh/authorized_keys mode 0100600
sif /root/.ssh/authorized_keys uid 0
sif /root/.ssh/authorized_keys gid 0
EOF
cmp -s <(debugfs -R "cat /etc/omamobile/firstboot.conf" "$copy" 2>/dev/null) "$conf_file" || die "writing firstboot.conf into the image copy failed"
cmp -s <(debugfs -R "cat /root/.ssh/authorized_keys" "$copy" 2>/dev/null) "$keys_file" || die "writing authorized_keys into the image copy failed"
cmp -s <(debugfs -R "cat /etc/omamobile/boot-update.conf" "$copy" 2>/dev/null) "$boot_conf" || die "writing boot-update.conf into the image copy failed"
e2fsck -fn "$copy" >/dev/null 2>&1 || die "the image copy doesn't check clean after the writes"
note "firstboot.conf, root's authorized_keys and boot-update.conf (AUTO_WRITE=$BOOT_UPDATE_AUTO_WRITE$( ((fmt == 1)) || printf ', SLOT=%s' "$target")) written, file system checks clean"
# userdata is always flashed as an Android sparse image: one path, the one
# the dry run prints. The sparse copy takes about the raw copy's used blocks
# (decompressed with --sparse, so far fewer than its apparent size): check
# for that much free plus 1 GiB rather than let img2simg run out of room.
used_bytes=$(du -k "$copy" | awk '{printf "%.0f\n", $1 * 1024}')
free_bytes=$(df -Pk "$work" | awk 'NR == 2 {printf "%.0f\n", $4 * 1024}')
[[ $used_bytes =~ ^[0-9]+$ && $free_bytes =~ ^[0-9]+$ ]] ||
  die "can't tell the image copy's size or the free space in $work"
need=$((used_bytes + 1073741824))
((free_bytes >= need)) ||
  die "$work has $free_bytes bytes free; the sparse copy needs $need (give a --work DIR on a larger file system)"
img2simg "$copy" "$sparse" || die "img2simg failed to convert the image copy in $work"
rm -f "$copy"
userdata_image=$sparse
note "converted to an Android sparse image ($(du -h "$sparse" | cut -f1))"

# --- The owner's key in slot B's initramfs -----------------------------------
# omamobile-boot-update builds slot B's ramdisk with root's authorized_keys
# appended (docs/RELEASES.md §5.2). Without the same here, the initramfs's
# rescue SSH has no owner key until the hook first runs, and that run rewrites
# an image the bundle should already hold (§11 step 4, #564). So a copy of the
# ramdisk image gets what lib/omamobile-boot-images appends, by its commands
# with the modes pacman's umask gives them: a cpio holding the key, after the
# shipped archive in one lz4 stream; vendor_ramdisk then sets the new size in
# the copy's v4 header and ramdisk table, where mkbootimg puts it. With the
# phone's lz4 and cpio that is the hook's image byte for byte, under any umask
# (tests/install-phone-initramfs).
# A ramdisk that already holds authorized_keys (a development initramfs) is
# left as built.
declare -A image_file=()
for p in $BOOT_IMAGES; do image_file[$p]=$images/$p.img; done
if [[ -n $ramdisk_image ]]; then
  if grep -qE '^(\./)?root/\.ssh/authorized_keys$' <<<"$listing"; then
    note "$ramdisk_image.img's initramfs already holds SSH keys (a development build): left as built"
  else
    # omamobile-boot-images' commands. The hook runs under pacman's umask
    # (022), so root/ is 0755; its mode is set here because not every
    # install(1) ignores the umask for parents (uutils' follows it).
    rm -rf "$ramdisk_dir" && mkdir -p "$ramdisk_dir"
    extra=$ramdisk_dir/extra
    install -d -m 755 "$extra/root" && install -d -m 700 "$extra/root/.ssh" &&
      install -m 600 "$keys_file" "$extra/root/.ssh/authorized_keys" &&
      find "$extra" -exec touch -h -d @0 {} + || die "can't stage the owner's key for the initramfs"
    reproducible=()
    cpio --help 2>/dev/null | grep -c -- --reproducible >/dev/null && reproducible=(--reproducible)
    (cd "$extra" && find . -mindepth 1 | LC_ALL=C sort | cpio -o -H newc --owner=0:0 --quiet "${reproducible[@]}") > "$ramdisk_dir/extra.cpio" ||
      die "cpio couldn't pack the owner's key for the initramfs"
    cat "$verify_dir/shipped.cpio" "$ramdisk_dir/extra.cpio" | lz4 -l -9 -q > "$ramdisk_dir/initramfs.cpio.lz4" ||
      die "lz4 couldn't recompress $ramdisk_image.img's ramdisk with the owner's key"
    vendor_ramdisk set "$images/$ramdisk_image.img" "$ramdisk_dir/initramfs.cpio.lz4" "$ramdisk_dir/$ramdisk_image.img" ||
      die "rewriting $ramdisk_image.img with the new ramdisk failed"
    isize=$(stat -c %s "$ramdisk_dir/$ramdisk_image.img")
    ((isize <= part_size[$ramdisk_image])) ||
      die "$ramdisk_image.img with the owner's key is $isize bytes, larger than ${ramdisk_image}_$target (${part_size[$ramdisk_image]} bytes)"
    image_file[$ramdisk_image]=$ramdisk_dir/$ramdisk_image.img
    note "the owner's key appended to $ramdisk_image.img's initramfs (as omamobile-boot-update appends it)"
  fi
fi

# --- What will be written ----------------------------------------------------
# The only way this script writes to the phone. PART must be one of the
# descriptor's boot images on the target slot (slot B, or for format 2 the
# slot the phone runs from) whose slot-B name is on the allowlist (UFS_RW's
# slot form), or userdata on the allowlist. The other slot is never one.
flash() {
  local part=$1 file=$2 ok=0 p
  [[ $target == a || $target == b ]] || die "refusing to write $part: no target slot"
  ((fmt == 2)) || [[ $target == b ]] || die "refusing to write $part: a format 1 install writes slot B only"
  for p in $BOOT_IMAGES; do [[ $part == "${p}_$target" && " $UFS_RW " == *" ${p}_b "* ]] && ok=1; done
  [[ $part == userdata && " $UFS_RW " == *" userdata "* ]] && ok=1
  ((ok)) || die "refusing to write $part: not one of slot $target's boot images or userdata on the allowlist"
  run flash "$part" "$file"
}
if ((fmt == 2)); then
  failed_tail="Android on slot $target may already be partly overwritten and the phone may start no system until the install runs again whole. Don't restart the phone: fix the cause and run this again from Fastboot Mode, or put Android back with Google's factory image"
else
  failed_tail="Slot A is untouched; fix the cause and rerun"
fi
run() {
  if ((dry)); then
    printf '    would run: %s -s %s %s\n' "$FASTBOOT" "$serial" "$*"
  else
    printf '    %s %s\n' "$FASTBOOT" "$*"
    fb "$@" || die "fastboot $* failed; the phone is still in fastboot. $failed_tail"
  fi
}

say "The plan"
note "phone:     ${D[NAME]:-$CODENAME} ($CODENAME), serial $serial"
note "user:      $username ($credential), host $hostname, time zone $timezone"
note "Wi-Fi:     ${wifi_ssid:-none}"
note "SSH key:   ${ssh_key:0:40}... (root and $username)"
note "root image: $(basename "$rootfs")"
echo
echo "These commands, and only these, will run:"
for p in $BOOT_IMAGES; do echo "    fastboot flash ${p}_$target ${image_file[$p]}"; done
echo "    fastboot flash userdata $userdata_image"
((fmt == 2)) || echo "    fastboot --set-active=b"
echo "    fastboot reboot"
echo
if ((fmt == 2)); then
  echo "Android on this phone is REPLACED: Omarchy Mobile is written over the system"
  echo "the phone runs from (slot $target), and userdata is ERASED, so Android and its"
  echo "data are gone. The phone keeps starting from slot $target; no slot is switched."
  echo "The way back to Android is Google's factory image for this phone (Google's"
  echo "Android Flash Tool, or the factory image's flash-all), from a computer. If the"
  echo "install is cut off, the phone starts no system until it runs again whole."
  echo "Slot $other, the bootloader, radio, persist, efs, modem, devinfo and vbmeta are not touched."
else
  echo "userdata will be ERASED: stock Android's data is lost, and stock Android on"
  echo "slot A will need a factory reset if you ever boot it again. Slot A itself,"
  echo "the bootloader, radio, persist, efs, modem and devinfo are not touched."
fi
echo
answer=$(ask "Type the phone's codename ($CODENAME) to go ahead")
if [[ $answer != "$CODENAME" ]]; then
  ((slot_probe_ran)) || die "not confirmed; nothing was written"
  die "not confirmed; nothing was flashed or erased. The slot check above did change the bootloader's slot flags (listed there), and slot $current_slot is the active slot"
fi

((dry)) && say "Dry run: printing the commands instead of running them" || say "Flashing"
# Format 2's gate: the same phone, on the same slot, just before the first
# flash. The owner may have taken minutes over the answers; a phone that
# restarted onto the other slot meanwhile would have its target change.
if ((fmt == 2 && !dry)); then
  phone_listed || die "the phone (serial $serial) is no longer in fastboot mode; nothing was written"
  read_vars
  [[ $(var product) == "$CODENAME" ]] || die "the phone no longer reports product $CODENAME; nothing was written"
  [[ -z $(var serialno) || $(var serialno) == "$serial" ]] || die "the phone reports another serial than $serial; nothing was written"
  [[ $(var current-slot) == "$target" ]] ||
    die "the phone's current slot changed from $target to '$(var current-slot)' since it was checked; nothing was written. Run the install again"
fi
for p in $BOOT_IMAGES; do flash "${p}_$target" "${image_file[$p]}"; done
flash userdata "$userdata_image"
((fmt == 2)) || run --set-active=b
if ((fmt == 2 && !dry)); then
  # Read back (read-only): still the same slot, and its flags after the writes
  read_vars
  [[ $(var current-slot) == "$target" ]] ||
    die "after the writes the phone reports current slot '$(var current-slot)', not $target: it is not restarted. Ask in an issue before you restart it (https://github.com/derekross/omarchy-mobile/issues)"
  slot_flags_read after
  slot_flags_line after "after the writes"
fi
run reboot
if ((dry)); then
  if ((slot_probe_dry)); then
    say "Dry run done: nothing was written to the phone, and the other bootloader slot was not checked (the real run checks it first)"
  else
    say "Dry run done: nothing was written to the phone"
  fi
else
  if ((fmt == 2)); then
    say "Done. The phone starts Omarchy Mobile from slot $target; the first boot sets up $username (a few minutes)."
  else
    say "Done. The phone boots slot B; the first boot sets up $username (a few minutes)."
  fi
  if [[ -z $guided ]]; then
    echo "    Watch it:  tools/phone-ssh 'journalctl -fu omamobile-firstboot'"
    echo "    Then:      tools/nv-backup DIR, then tools/phone-provision --first-install --nv-backup DIR FACTORY.zip"
    echo "               (firmware, per-phone data; a reinstall with a phone-config.tar: --restore DIR)"
  fi
fi
