#!/bin/bash
# SPDX-License-Identifier: MIT
# extract-vendor-chroot: build the read-only Android tree for one of
# Omarchy Mobile's vendor-chroot profiles (packages/omamobile-gnss/lib/omamobile-vendor-chroot)
# out of a Google factory image for the Pixel 7 Pro (cheetah) or, with
# -d tegu, the Pixel 9a, on the user's own machine.
#
# Grown from tools/extract-fingerprint-vendor (same closure walk, same
# output layout); the fingerprint profile still uses that tool.
#
# Profiles:
#   gnss   Broadcom's lhd and gpsd (the GNSS engine), SensorHub.patch, their
#          configuration, servicemanager (gpsd links libbinder_ndk) and the
#          system CA store (SUPL over TLS). device/cheetah/GNSS-PLAN.md.
#   modem  Samsung's cbd (modem boot) and rfsd (NV file service) with their
#          init and fstab files, for reference, plus the shell and toybox
#          (cbd runs tar and a few file commands through the shell while it
#          boots the modem). No binder. The modem firmware and NV are not in
#          it: they are read on the phone, into RAM, at start.
#          device/cheetah/MODEM-PLAN.md M3.
#  waves  Waves' speaker tuning host libraries (libmahalcontroller.so and
#          the coefficient converter libAlgFx_HiFi3z.so) with their preset
#          and config files, for omamobile-waves-host. Libraries only: no
#          vendor or system binaries, no binder, no device nodes.
#          device/cheetah/AOC-TUNING-RESEARCH.md.
#
# These binaries are Google's and not ours to redistribute, so Omarchy Mobile
# never ships them: this tool takes exactly what the profile needs from an
# image the user already has and nothing else.
#
# The output is the chroot's read-only image tree:
#   OUT/root/{system,vendor,apex/com.android.runtime}
#   OUT/MANIFEST         one line per file: sha256, mode, path
#   OUT/SOURCE           the vendor build fingerprint it came from
# Nothing here touches the phone.
#
# Needs: unzip, debugfs (e2fsprogs), readelf (binutils) or llvm-readelf,
# sha256sum; simg2img and lpunpack (android-tools) for sparse or super images.
set -euo pipefail
# debugfs and friends live in /sbin on Debian-like hosts
export PATH=$PATH:/usr/sbin:/sbin

DEVICE="cheetah"
PROFILE=""
STUB_LIBS=()

RUNTIME_APEX="system/apex/com.android.runtime.apex"
RUNTIME_FILES=(bin/linker64 lib64/bionic/libc.so lib64/bionic/libm.so
               lib64/bionic/libdl.so lib64/bionic/libdl_android.so)

# Entry points, relative to their partition root, per profile. VENDOR_LIBS
# are libraries something of ours dlopen()s: copied with their closure.
profile_lists() {
  VENDOR_LIBS=()
  case $1 in
    gnss)
      VENDOR_BINS=(bin/hw/lhd bin/hw/gpsd)
      VENDOR_FILES=(firmware/SensorHub.patch etc/gnss/lhd.conf etc/gnss/gps.xml
                    etc/gnss/gps.cer build.prop)
      VENDOR_DIRS=(etc/vintf)
      SYSTEM_BINS=(system/bin/servicemanager)
      SYSTEM_FILES=(system/build.prop)
      SYSTEM_DIRS=(system/etc/vintf system/etc/security/cacerts)
      # libandroid_net (gpsd) needs one symbol from the tethering APEX, a
      # compressed APEX we don't unpack: the shim build provides a stub.
      STUB_LIBS=(libcom.android.tethering.connectivity_native.so)
      ;;
    modem)
      VENDOR_BINS=(bin/cbd bin/rfsd)
      # gs201 keeps the modem image mount in fstab.modem, gs101 in its main fstab
      if [[ $DEVICE == raven ]]; then MODEM_FSTAB=etc/fstab.gs101; else MODEM_FSTAB=etc/fstab.modem; fi
      VENDOR_FILES=(etc/init/cbd.rc etc/init/rfsd.rc "$MODEM_FSTAB" build.prop)
      VENDOR_DIRS=()
      SYSTEM_BINS=(system/bin/sh system/bin/toybox)
      SYSTEM_FILES=(system/build.prop)
      SYSTEM_DIRS=()
      # The 9a's GNSS is the S5300's own Kepler core: Samsung's gnssd, its
      # patch file and configuration run in the same chroot once the CP is
      # ONLINE (device/tegu/MODEM-PLAN.md F5).
      if [[ $DEVICE == tegu ]]; then
        VENDOR_BINS+=(bin/hw/gnssd)
        VENDOR_FILES+=(firmware/kepler.bin etc/gnss/gps.cfg etc/gnss/ca.pem
                       etc/init/init.gnss.rc)
        SYSTEM_DIRS+=(system/etc/security/cacerts)
        # libandroid_net (gnssd) needs one symbol from the tethering APEX,
        # as gpsd on cheetah: the shim build provides a stub.
        STUB_LIBS=(libcom.android.tethering.connectivity_native.so)
      fi
      ;;
    gnss-slsi)
      # The 9a's GNSS HAL: Samsung's android.hardware.gnss-service, the
      # client of the modem chroot's gnssd (abstract socket @GNSSND), with
      # servicemanager and the VINTF manifests that declare IGnss/default.
      # device/tegu/MODEM-PLAN.md G3.
      VENDOR_BINS=(bin/hw/android.hardware.gnss-service bin/vndservicemanager)
      VENDOR_FILES=(etc/gnss/gps.cfg etc/gnss/ca.pem build.prop)
      VENDOR_DIRS=(etc/vintf)
      SYSTEM_BINS=(system/bin/servicemanager)
      SYSTEM_FILES=(system/build.prop)
      SYSTEM_DIRS=(system/etc/vintf)
      ;;
    waves)
      VENDOR_BINS=()
      VENDOR_LIBS=(lib64/libmahalcontroller.so lib64/libAlgFx_HiFi3z.so)
      VENDOR_FILES=(etc/waves_preset.mps etc/waves_config.ini build.prop)
      VENDOR_DIRS=()
      SYSTEM_BINS=()
      SYSTEM_FILES=(system/build.prop)
      SYSTEM_DIRS=()
      ;;
    *) die "unknown profile '$1' (known: gnss, gnss-slsi, modem, waves)" ;;
  esac
}

# Profile sanity checks on the finished tree ($1).
profile_check() {
  case $PROFILE in
    gnss)
      grep -aq 'LheBbdPacket' "$1/vendor/bin/hw/lhd" ||
        die "lhd does not look like Broadcom's location hub daemon"
      grep -q '^LhePatch=/vendor/firmware/SensorHub.patch' "$1/vendor/etc/gnss/lhd.conf" ||
        die "lhd.conf does not load /vendor/firmware/SensorHub.patch"
      grep -q 'NmeaOutName=' "$1/vendor/etc/gnss/gps.xml" ||
        die "gps.xml has no NmeaOutName (the NMEA output the bridge reads)"
      ;;
    modem)
      grep -aq 'CP Boot Daemon' "$1/vendor/bin/cbd" ||
        die "cbd does not look like Samsung's CP boot daemon"
      grep -aq '/dev/umts_rfs0' "$1/vendor/bin/rfsd" ||
        die "rfsd does not use /dev/umts_rfs0"
      grep -q 'modem_img' "$1/vendor/$MODEM_FSTAB" ||
        die "${MODEM_FSTAB##*/} has no modem image mount"
      ;;
    waves)
      local f
      for f in ma_create ma_destroy ma_initialize ma_get_version ma_set_data ma_flush \
               ma_wait_for_flush ma_on_dsp_wakeup; do
        grep -aq "$f" "$1/vendor/lib64/libmahalcontroller.so" ||
          die "libmahalcontroller.so has no $f (not the Waves controller omamobile-waves-host knows)"
      done
      grep -q '^AlgFxPath64=/vendor/lib64/libAlgFx_HiFi3z.so' "$1/vendor/etc/waves_config.ini" ||
        die "waves_config.ini does not load /vendor/lib64/libAlgFx_HiFi3z.so"
      grep -q '^SPEAKER_INSTANCE *= *INSTANCE:1' "$1/vendor/etc/waves_config.ini" ||
        die "waves_config.ini has no speaker instance 1"
      grep -q '^\[CUSTOM_ACTION_258\]' "$1/vendor/etc/waves_config.ini" ||
        die "waves_config.ini has no custom action 258 (preset selection)"
      ;;
  esac
}

usage() {
  cat <<USAGE
Usage: extract-vendor-chroot -p PROFILE [-d DEVICE] [-o OUTDIR] [-w WORKDIR] [-f] SOURCE

  SOURCE   Google factory zip (DEVICE-*-factory-*.zip) or the
           image-DEVICE-*.zip inside it
  -p NAME  profile: gnss, gnss-slsi (tegu), modem, waves
  -o DIR   output directory (default: ./out/vendor-chroot-PROFILE)
  -w DIR   scratch directory for vendor.img and system.img, about 2.5 GB
           (default: a temp dir in \$TMPDIR)
  -d DEV   cheetah (default), raven (gnss and modem so far) or tegu
           (gnss-slsi and modem so far)
  -f       skip the device checks

Install on the phone (from the omamobile repo), e.g. for gnss:
  tar -C OUTDIR -cf - root MANIFEST SOURCE |
    tools/phone-ssh 'mkdir -p /usr/lib/omamobile-vendor/gnss && tar -C /usr/lib/omamobile-vendor/gnss -xf -'
USAGE
}

say() { printf '==> %s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "$1 not found ($2)"; }

OUT="" WORK="" FORCE=""
while getopts "p:o:w:d:fh" opt; do
  case $opt in
    p) PROFILE=$OPTARG ;;
    d) DEVICE=$OPTARG ;;
    o) OUT=$OPTARG ;;
    w) WORK=$OPTARG ;;
    f) FORCE=1 ;;
    h) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))
[[ $# -eq 1 && -n $PROFILE ]] || { usage >&2; exit 2; }
case $DEVICE in
  cheetah) ;;
  raven) [[ $PROFILE == gnss || $PROFILE == modem ]] || die "raven: gnss and modem profiles only so far" ;;
  tegu) [[ $PROFILE == gnss-slsi || $PROFILE == modem ]] || die "tegu: gnss-slsi and modem profiles only so far" ;;
  *) die "unknown device $DEVICE (cheetah, raven or tegu)" ;;
esac
profile_lists "$PROFILE"
[[ -n $OUT ]] || OUT="./out/vendor-chroot-$PROFILE"
SRC=$(readlink -f "$1")
[[ -f "$SRC" ]] || die "no such file: $1"

need unzip "install unzip"
need debugfs "install e2fsprogs"
need sha256sum "install coreutils"
if command -v readelf >/dev/null; then READELF=readelf
elif command -v llvm-readelf >/dev/null; then READELF=llvm-readelf
else die "readelf not found (install binutils or llvm)"; fi

if [[ -n "$WORK" ]]; then
  mkdir -p "$WORK"
  WORK=$(mktemp -d "$WORK/xvc.XXXXXX")
else
  WORK=$(mktemp -d "${TMPDIR:-/tmp}/xvc.XXXXXX")
fi
trap 'rm -rf "$WORK"' EXIT

magic_at() { od -An -tx4 -j "$2" -N4 "$1" | tr -d ' \n'; }
zip_member() { unzip -Z1 "$1" | grep -E "(^|/)$2\$" | head -1 || true; }

unsparse() {
  if [[ "$(magic_at "$1" 0)" == ed26ff3a ]]; then
    need simg2img "install android-tools"
    simg2img "$1" "$1.raw" && mv "$1.raw" "$1"
  fi
}

# Get vendor.img and system.img out of SOURCE into $WORK.
fetch_images() {
  local src=$1 m inner part
  [[ "$(magic_at "$src" 0)" == 04034b50 ]] || die "$(basename "$src") is not a zip"
  inner=$(zip_member "$src" "image-[^/]*\.zip")
  if [[ -n "$inner" ]]; then
    say "Unpacking $inner from the factory zip"
    unzip -p "$src" "$inner" > "$WORK/image.zip"
    src="$WORK/image.zip"
  fi
  m=$(zip_member "$src" "android-info\.txt")
  if [[ -n "$m" && -z "$FORCE" ]]; then
    unzip -p "$src" "$m" | grep -qE "^require board=(.*\|)?$DEVICE(\|.*)?\$" ||
      die "this image is not for $DEVICE (android-info.txt); use -f to override"
  fi
  for part in vendor system; do
    m=$(zip_member "$src" "$part\.img")
    if [[ -n "$m" ]]; then
      say "Unpacking $part.img"
      unzip -p "$src" "$m" > "$WORK/$part.img"
      unsparse "$WORK/$part.img"
      continue
    fi
    m=$(zip_member "$src" "super\.img")
    [[ -n "$m" ]] || die "no $part.img or super.img in $(basename "$src")"
    need lpunpack "install android-tools"
    if [[ ! -f "$WORK/super.img" ]]; then
      say "Unpacking super.img"
      unzip -p "$src" "$m" > "$WORK/super.img"
      unsparse "$WORK/super.img"
    fi
    mkdir -p "$WORK/super"
    lpunpack -p "${part}_a" "$WORK/super.img" "$WORK/super" 2>/dev/null ||
      lpunpack -p "$part" "$WORK/super.img" "$WORK/super"
    mv "$WORK/super/$part"*.img "$WORK/$part.img"
  done
  rm -rf "$WORK/super" "$WORK/super.img" "$WORK/image.zip"
}

is_ext4() { [[ "$(od -An -tx2 -j 1080 -N2 "$1" | tr -d ' ')" == ef53 ]]; }

# rdump one path ($2, no leading /) from ext4 image $1 into directory $3.
# Symlinks are kept as symlinks.
rdump() {
  mkdir -p "$3"
  debugfs -R "rdump /$2 $3" "$1" 2>&1 |
    grep -v -e '^debugfs ' -e 'Operation not permitted while changing ownership' >&2 || true
}

fetch_images "$SRC"
for part in vendor system; do
  is_ext4 "$WORK/$part.img" ||
    die "$part.img is not ext4 (EROFS images need fsck.erofs --extract; not supported yet)"
done

# The vendor partition says which device it was built for.
mkdir -p "$WORK/v"
debugfs -R "dump /build.prop $WORK/v/build.prop" "$WORK/vendor.img" 2>/dev/null
[[ -s "$WORK/v/build.prop" ]] || die "vendor.img has no build.prop"
dev=$(sed -n 's/^ro.product.vendor.device=//p' "$WORK/v/build.prop" | head -1)
[[ "$dev" == "$DEVICE" || -n "$FORCE" ]] ||
  die "vendor partition is for '${dev:-unknown}', not $DEVICE; use -f to override"
fp=$(sed -n 's/^ro.vendor.build.fingerprint=//p' "$WORK/v/build.prop" | head -1)
say "Vendor partition: $fp"

# Stage whole lib directories and the entry points into $WORK/{v,s,r}, then
# copy only the closure into the output.
say "Reading the vendor partition"
for d in bin lib64 firmware etc; do rdump "$WORK/vendor.img" "$d" "$WORK/v"; done
say "Reading the system partition"
mkdir -p "$WORK/s/system"
for d in bin lib64 etc apex; do
  [[ $d == apex ]] && { mkdir -p "$WORK/s/system/apex"
    debugfs -R "dump /system/apex/com.android.runtime.apex $WORK/s/system/apex/com.android.runtime.apex" \
      "$WORK/system.img" 2>/dev/null; continue; }
  rdump "$WORK/system.img" "system/$d" "$WORK/s/system"
done
debugfs -R "dump /system/build.prop $WORK/s/system/build.prop" "$WORK/system.img" 2>/dev/null
[[ -s "$WORK/s/$RUNTIME_APEX" ]] || die "no $RUNTIME_APEX in system.img"

say "Reading com.android.runtime"
unzip -p "$WORK/s/$RUNTIME_APEX" apex_payload.img > "$WORK/runtime.img"
is_ext4 "$WORK/runtime.img" || die "com.android.runtime payload is not ext4"
mkdir -p "$WORK/r"
for d in bin lib64; do rdump "$WORK/runtime.img" "$d" "$WORK/r"; done

# Where a library lives inside the chroot, searching like the chroot's
# LD_LIBRARY_PATH does: vendor binaries see /vendor first, system binaries
# /system first; bionic itself always comes from the runtime APEX.
declare -A PICKED=()
lib_path() { # $1 soname, $2 vendor|system -> "<stage dir>|<chroot path>"
  local n=$1 order c
  case $n in
    libc.so|libm.so|libdl.so|libdl_android.so)
      echo "$WORK/r/lib64/bionic/$n|apex/com.android.runtime/lib64/bionic/$n"; return ;;
  esac
  if [[ $2 == vendor ]]; then order="v:lib64 v:lib64/hw s:system/lib64"
  else order="s:system/lib64 v:lib64"; fi
  for c in $order; do
    local tree=${c%%:*} dir=${c#*:} prefix
    [[ $tree == v ]] && prefix=vendor/ || prefix=
    if [[ -e "$WORK/$tree/$dir/$n" ]]; then
      echo "$WORK/$tree/$dir/$n|$prefix$dir/$n"; return
    fi
  done
}

# Follow a staged symlink the way it resolves inside the chroot.
stage_target() {
  local f=$1 t
  while [[ -L $f ]]; do
    t=$(readlink "$f")
    case $t in
      /apex/com.android.runtime/*) f="$WORK/r/${t#/apex/com.android.runtime/}" ;;
      /system/*) f="$WORK/s$t" ;;
      /vendor/*) f="$WORK/v/${t#/vendor/}" ;;
      /*) die "$f points outside the chroot: $t" ;;
      *) f="$(dirname "$f")/$t" ;;
    esac
  done
  echo "$f"
}

needed() { "$READELF" -d "$1" 2>/dev/null | sed -n 's/.*(NEEDED).*\[\(.*\)\]/\1/p'; }

missing=()
walk() { # $1 file on disk, $2 vendor|system
  local n hit src dst
  while read -r n; do
    [[ -n $n ]] || continue
    [[ -n "${PICKED[$2:$n]:-}" ]] && continue
    if [[ " ${STUB_LIBS[*]} " == *" $n "* ]]; then PICKED[$2:$n]=stub; continue; fi
    hit=$(lib_path "$n" "$2")
    if [[ -z $hit ]]; then missing+=("$n"); PICKED[$2:$n]=missing; continue; fi
    PICKED[$2:$n]=${hit#*|}
    src=${hit%%|*}
    walk "$(stage_target "$src")" "$2"
  done < <(needed "$1")
}

for b in "${VENDOR_BINS[@]}" "${VENDOR_LIBS[@]}"; do
  [[ -f "$WORK/v/$b" ]] || die "/vendor/$b is missing from this image"
  walk "$WORK/v/$b" vendor
done
for b in "${SYSTEM_BINS[@]}"; do
  [[ -f "$WORK/s/$b" ]] || die "/$b is missing from this image"
  walk "$WORK/s/$b" system
done
((${#missing[@]} == 0)) || die "unresolved libraries: ${missing[*]}"

# Copy into the output tree. A library picked through a symlink into the
# runtime APEX (system/lib64/libc.so -> /apex/...) keeps the symlink.
root="$OUT/root"
rm -rf "$root"; mkdir -p "$root"
put() { # $1 source on disk, $2 path in chroot
  mkdir -p "$root/$(dirname "$2")"
  if [[ -L "$1" ]]; then cp -P "$1" "$root/$2"; else cp "$1" "$root/$2"; fi
}
for b in "${VENDOR_BINS[@]}" "${VENDOR_LIBS[@]}" "${VENDOR_FILES[@]}"; do put "$WORK/v/$b" "vendor/$b"; done
for d in "${VENDOR_DIRS[@]}"; do mkdir -p "$root/vendor/$d"; cp -a "$WORK/v/$d/." "$root/vendor/$d/"; done
for b in "${SYSTEM_BINS[@]}" "${SYSTEM_FILES[@]}"; do put "$WORK/s/$b" "$b"; done
for d in "${SYSTEM_DIRS[@]}"; do mkdir -p "$root/$d"; cp -a "$WORK/s/$d/." "$root/$d/"; done
for f in "${RUNTIME_FILES[@]}"; do put "$WORK/r/$f" "apex/com.android.runtime/$f"; done
mkdir -p "$root/system/bin"
ln -sfn /apex/com.android.runtime/bin/linker64 "$root/system/bin/linker64"
# Bootstrap binaries (servicemanager: those Android starts before the
# runtime APEX is mounted) name /system/bin/bootstrap/linker64 as their
# interpreter. In the chroot the runtime APEX is always there, so they get
# the same linker as everything else, and with it the same bionic.
mkdir -p "$root/system/bin/bootstrap"
ln -sfn /apex/com.android.runtime/bin/linker64 "$root/system/bin/bootstrap/linker64"
# The modem profile: the toybox commands cbd runs, as Android links them,
# and tar under /vendor/bin too. A shell that is itself a symlink (to mksh)
# brings its target.
if [[ $PROFILE == modem ]]; then
  if [[ -L "$root/system/bin/sh" ]]; then
    t=$(readlink "$root/system/bin/sh")
    [[ $t == */* ]] || put "$WORK/s/system/bin/$t" "system/bin/$t"
  fi
  for n in tar timeout gunzip mkdir chmod rm cp mv; do
    [[ -e "$root/system/bin/$n" ]] || ln -s toybox "$root/system/bin/$n"
  done
  mkdir -p "$root/vendor/bin"
  ln -sfn /system/bin/toybox "$root/vendor/bin/tar"
fi
for key in "${!PICKED[@]}"; do
  dst=${PICKED[$key]}
  [[ $dst == stub ]] && continue
  [[ $dst == apex/* || -e "$root/$dst" || -L "$root/$dst" ]] && continue
  case $dst in
    vendor/*) put "$WORK/v/${dst#vendor/}" "$dst" ;;
    *)        put "$WORK/s/$dst" "$dst" ;;
  esac
done
# /system/lib64 also needs the bionic symlinks for system binaries.
for n in libc.so libm.so libdl.so libdl_android.so; do
  ln -sfn "/apex/com.android.runtime/lib64/bionic/$n" "$root/system/lib64/$n"
done
chmod -R u+w,go-w "$root"

# Every executable's interpreter (PT_INTERP) must exist inside the chroot.
interp() { "$READELF" -lW "$1" 2>/dev/null | sed -n 's/.*\[Requesting program interpreter: \(.*\)\]/\1/p'; }
while read -r f; do
  i=$(interp "$f")
  [[ -z $i ]] && continue
  [[ -e "$root$i" || -L "$root$i" ]] || die "${f#"$root"/} needs the interpreter $i, missing from the chroot"
done < <(find "$root/system/bin" "$root/vendor/bin" -type f 2>/dev/null)

# Every symlink must resolve inside the chroot.
while read -r l; do
  t=$(readlink "$l")
  [[ $t == /* ]] && t="$root$t" || t="$(dirname "$l")/$t"
  [[ -e "$t" ]] || die "dangling symlink in the chroot: ${l#"$root"/} -> $(readlink "$l")"
done < <(find "$root" -type l)

profile_check "$root"

(cd "$root" && find . -type f -printf '%m %P\n' | sort -k2 |
  while read -r mode path; do
    printf '%s %s %s\n' "$(sha256sum "$path" | cut -d' ' -f1)" "$mode" "$path"
  done) > "$OUT/MANIFEST"
echo "$fp" > "$OUT/SOURCE"
printf '%s\n' "${STUB_LIBS[@]}" > "$OUT/STUBS"

say "$(wc -l < "$OUT/MANIFEST") files, $(du -sh "$root" | cut -f1), in $root"
say "Source: $fp"
echo "These are Google's proprietary binaries from your own factory image. Do not redistribute them."
