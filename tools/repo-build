#!/bin/bash
# SPDX-License-Identifier: MIT
# Opt-in shortcut: build [omamobile] packages natively on a connected phone,
# into out/repo/aarch64, each signed with the release key (keys/gnupg.release),
# plus a signed omamobile.db. The default build needs no phone:
# tools/build-packages (an Arch Linux ARM container on the laptop). Use this
# only to save hours on big packages (Mesa, Hyprland, libcamera).
#   tools/repo-build [package-dir...]   (default: every package but mesa)
# Mesa takes hours to build, so its already-built packages are collected from
# the phone's build directory instead (packages/mesa/README.md).
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

# The release key (docs/RELEASES.md §10), with a clear error without it
source tools/lib/signing.sh
signing_key_load "$PWD" || exit 1
key=$SIGNING_KEY
repo=out/repo/aarch64
ssh=tools/phone-ssh
# The phone's account: whoever is logged in on its screen (as tools/acpm-stage
# and tools/speaker-trip-burst find it), or PHONE_USER=<name>. makepkg runs
# as that user, in its home; no account name is built in.
phone_user=${PHONE_USER:-$("$ssh" "loginctl list-users --no-legend | awk '\$2 != \"root\" {print \$2; exit}'")}
[[ -n $phone_user ]] || { echo "No user is logged in on the phone: log in on its screen, or set PHONE_USER=<name>" >&2; exit 1; }
phone_home=$("$ssh" "getent passwd '$phone_user' | cut -d: -f6")
[[ -n $phone_home ]] || { echo "No account '$phone_user' on the phone" >&2; exit 1; }
build=$phone_home/build/pkgs

dirs=("$@")
((${#dirs[@]})) || dirs=(packages/omamobile-keyring packages/omamobile-shell packages/omamobile-device-cheetah)

mkdir -p "$repo"
fetch() { "$ssh" "cat '$1'" >"$repo/$(basename "$1")"; }

for dir in "${dirs[@]}"; do
  name=$(basename "$dir")
  echo "==> $name"
  "$ssh" "rm -rf $build/$name && mkdir -p $build && chown '$phone_user': $build"
  tar cf - --exclude="./$name/pkg" --exclude="./$name/src/build" --exclude="*.pkg.tar.*" \
    -C "$(dirname "$dir")" "./$name" | "$ssh" "tar xf - -C $build --no-same-owner && chown -R '$phone_user': $build/$name"
  # --nodeps: runtime dependencies (e.g. omamobile-keyring) come from this
  # very repository, so they needn't be installed on the builder.
  "$ssh" "su - '$phone_user' -c 'cd $build/$name && makepkg -f --nodeps --noconfirm' 2>&1 | tail -1"
  files=$("$ssh" "ls $build/$name/*.pkg.tar.* 2>/dev/null" || true)
  [[ -n $files ]] || { echo "$name: no package built" >&2; exit 1; }
  for file in $files; do fetch "$file"; done
done

echo "==> mesa (prebuilt on the phone)"
for file in $("$ssh" "ls $phone_home/build/mesa/*.pkg.tar.* 2>/dev/null"); do
  [[ -f $repo/$(basename "$file") ]] || fetch "$file"
done

echo "==> signing"
for package in "$repo"/*.pkg.tar.*; do
  [[ $package == *.sig ]] && continue
  [[ -f $package.sig ]] || gpg --batch --yes --local-user "$key" --detach-sign "$package"
done

echo "==> database"
rm -f "$repo"/omamobile.db* "$repo"/omamobile.files*
repo-add --quiet --sign --key "$key" "$repo/omamobile.db.tar.gz" $(ls "$repo"/*.pkg.tar.* | grep -v '\.sig$')
ls -1 "$repo" | grep -v '\.sig$'
