#!/bin/bash
# SPDX-License-Identifier: MIT
# Build Omarchy Mobile's root file system image (docs/RELEASES.md §6):
#   out/omamobile-rootfs-<device>-<version>-aarch64.img.zst   ext4, label omamobile-root
#   out/omamobile-rootfs-<device>-<version>-aarch64.img.zst.sha256
#   out/omamobile-rootfs-<device>-<version>-aarch64.MANIFEST  contents and versions
#
# Inside an Arch Linux ARM container (tools/lib/alarm.sh) it pacstraps:
#   rootfs/packages.base       Arch Linux ARM's base, sshd, NetworkManager,
#                              ufw, SDDM, and Omarchy itself from [omarchy]
#   Omarchy's own list         install/omarchy-base.packages from the omarchy
#                              package, as Omarchy's ISO installs it, minus
#                              rootfs/packages.omarchy-skip and whatever isn't
#                              built for aarch64 (listed in the MANIFEST)
#   rootfs/packages.omamobile  ours, from out/repo (tools/build-packages), plus
#                              the device package and the board's own ones
#                              (PACKAGE and ROOTFS_PACKAGES in device.conf)
# then adds the [omamobile] repository itself (a copy in
# /var/lib/omamobile/repo), sets the [omamobile] channel the phone follows
# (--channel), and the kernel modules from the current kernel build. A
# device whose package ships boot files (its install reads
# OMAMOBILE_BOOT_FILES; cheetah) gets linux-omamobile and
# omamobile-boot-update from out/repo too, so a release install can take
# its kernel updates through pacman (RELEASES §5.3, §12 decision 10): the
# package's modules replace the tarball, and its release must be
# KERNEL_OUT's, since the bundle's boot images come from KERNEL_OUT
# (--allow-missing linux-omamobile falls back to the tarball). Omarchy's pending
# patches come with omamobile-omarchy, whose pacman hook applies them as it
# does after every Omarchy upgrade on a phone (build-inside checks that they
# are in place). Device packages are installed, not just cached:
# there is one device so far, and the first boot then has no package step
# that can fail (RELEASES §12, decision 6).
#
# The image has no user but root (locked), no alarm account, no SSH or host
# keys, no pacman keyring, no machine id, no Google file and no per-phone
# data. tools/install-phone adds the owner's firstboot.conf to a copy of it;
# omamobile-firstboot does the rest on the phone, and the initramfs grows it
# to the whole userdata partition on the first boot.
#
#   tools/build-rootfs [--version V] [--allow-missing "PKG..."] [--keep-raw]
#                      [--local NAME] [--channel stable|development|local]
#                      [--install-link]
#     DEVICE       device/<codename>/device.conf (default cheetah)
#     KERNEL_OUT   kernel build with modules-<release>.tar.zst
#                  (default $KERNEL_BASE/out-int: bin/omamobile modules)
#     --allow-missing   build even if these packages of ours aren't in out/repo
#                       (say "mesa hyprland libcamera libcamera-ipa
#                       gst-plugin-libcamera vulkan-panfrost" for a test image
#                       without the slow builds; the MANIFEST lists them)
#     --local NAME      a contributor's image for device NAME (review lesson
#                       L-7): the repository is out/NAME/repo (build-packages
#                       --local NAME), the image goes to out/NAME/, and the
#                       build image trusts keys/NAME's public key. DEVICE
#                       defaults to NAME. The phone does not trust that key:
#                       see docs/RELEASES.md §10
#     --channel C       where the phone's [omamobile] comes from after the
#                       install (its /etc/pacman.d/omamobile-mirrorlist):
#                       stable (the default; release images, pkgs.omamobile.org),
#                       development (every day's build, for builders), or local
#                       (the image's own copy, kept up to date by
#                       tools/repo-push; the default with --local). The phone
#                       switches later with: sudo omamobile-update channel C
#     --install-link    an image for the install link (docs/INSTALL-LINK-PLAN.md):
#                       the marker /etc/omamobile/install-link, which makes the
#                       phone offer the link at its first start, and the two
#                       packages it needs (omamobile-install-link, in every
#                       image, and omamobile-provision). Only for a device whose
#                       descriptor says INSTALL_LINK=yes, or INSTALL_LINK=test
#                       for a development or local image (the plan's runbook,
#                       R7 to R10, before any release carries the marker). The
#                       MANIFEST says "install link: protocol N (marker ...)",
#                       and tools/make-bundle puts install_link in manifest.json
set -euo pipefail
# debugfs and friends live in /sbin on Debian-like hosts
export PATH=$PATH:/usr/sbin:/sbin
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
ROOT=$PWD
source tools/lib/alarm.sh

DEVICE_SET=${DEVICE:+1}  # --local defaults DEVICE to its codename
DEVICE=${DEVICE:-cheetah}
# The kernel clone, its worktrees and build outputs live in KERNEL_BASE:
# ~/omamobile-kernel, or ~/android/mainline on setups from before 2026-10-29.
if [[ -z ${KERNEL_BASE:-} ]]; then
  KERNEL_BASE=$HOME/omamobile-kernel
  [[ -d $KERNEL_BASE || ! -d $HOME/android/mainline ]] || KERNEL_BASE=$HOME/android/mainline
fi
KERNEL_OUT=${KERNEL_OUT:-$KERNEL_BASE/out-int}
VERSION=$(date +%Y.%m.%d)
ALLOW_MISSING="" KEEP_RAW=0 LOCAL="" CHANNEL="" INSTALL_LINK=0
while (($#)); do
  case $1 in
    --version) VERSION=${2:?}; shift ;;
    --allow-missing) ALLOW_MISSING=${2:?}; shift ;;
    --keep-raw) KEEP_RAW=1 ;;
    --local) LOCAL=${2:?}; shift ;;
    --channel) CHANNEL=${2:?}; shift ;;
    --install-link) INSTALL_LINK=1 ;;
    -h|--help) source tools/lib/usage.sh; usage_from_header "$0"; exit 0 ;;
    *) alarm_die "unknown argument $1" ;;
  esac
  shift
done
[[ $VERSION =~ ^[0-9A-Za-z._-]+$ ]] || alarm_die "bad version '$VERSION'"
if [[ -z $CHANNEL ]]; then
  if [[ -n $LOCAL ]]; then CHANNEL=local; else CHANNEL=stable; fi
fi
[[ $CHANNEL =~ ^(stable|development|local)$ ]] || alarm_die "--channel is stable, development or local, not '$CHANNEL'"
outrel=out
if [[ -n $LOCAL ]]; then
  [[ $LOCAL =~ ^[a-z0-9]+$ ]] || alarm_die "--local needs a device codename"
  [[ -n $DEVICE_SET ]] || DEVICE=$LOCAL
  [[ $DEVICE == "$LOCAL" ]] || alarm_die "--local $LOCAL builds device $LOCAL, not DEVICE=$DEVICE"
  [[ -f keys/$LOCAL/public.asc ]] || alarm_die "no keys/$LOCAL/public.asc (run: tools/local-key-init $LOCAL)"
  export ALARM_LOCAL_KEY=$ROOT/keys/$LOCAL/public.asc
  outrel=out/$LOCAL
fi
[[ $DEVICE =~ ^[a-z0-9]+$ ]] || alarm_die "DEVICE must be a codename"
conf=device/$DEVICE/device.conf
[[ -f $conf ]] || alarm_die "no $conf"
DEVICE_PACKAGE=$(sed -n 's/^PACKAGE=\([a-z0-9-]*\)$/\1/p' "$conf")
[[ -n $DEVICE_PACKAGE ]] || alarm_die "$conf has no PACKAGE"
ROOTFS_PACKAGES=$(sed -n 's/^ROOTFS_PACKAGES="\(.*\)"$/\1/p' "$conf")
# Boot files in the device package: the kernel comes as a package
KERNEL_PACKAGE=0
grep -c 'OMAMOBILE_BOOT_FILES' "packages/$DEVICE_PACKAGE/install" >/dev/null 2>&1 && KERNEL_PACKAGE=1
[[ $ROOTFS_PACKAGES =~ ^[a-z0-9\ -]*$ ]] || alarm_die "$conf: ROOTFS_PACKAGES may hold only package names"
# The install link is offered only where the descriptor says it may be
# (INSTALL-LINK-PLAN §10): yes once the plan's runbook has passed on the
# device, test for the runbook's own images, which never follow stable
if ((INSTALL_LINK)); then
  link_ok=$(sed -n 's/^INSTALL_LINK=\([a-z]*\)$/\1/p' "$conf")
  case $link_ok in
    yes) ;;
    test) [[ $CHANNEL != stable ]] ||
            alarm_die "$conf says INSTALL_LINK=test: an image for the link follows development or local until it says yes (--channel)" ;;
    *) alarm_die "$conf does not say INSTALL_LINK=yes (or test): no image for the install link (docs/INSTALL-LINK-PLAN.md §10)" ;;
  esac
fi

repo=$outrel/repo/aarch64
[[ -f $repo/omamobile.db ]] ||
  alarm_die "no [omamobile] repository in $outrel/repo: build it first with tools/build-packages${LOCAL:+ --local $LOCAL} (or tools/repo-build)"
[[ -f $KERNEL_OUT/include/config/kernel.release ]] || alarm_die "no kernel build in $KERNEL_OUT (KERNEL_OUT=...)"
release=$(cat "$KERNEL_OUT/include/config/kernel.release")
modules=$KERNEL_OUT/modules-$release.tar.zst
[[ -f $modules ]] || alarm_die "no $modules: run KERNEL_OUT=$KERNEL_OUT bin/omamobile modules"

name=omamobile-rootfs-$DEVICE-$VERSION-aarch64
out=$ROOT/$outrel
mkdir -p "$out"
# Keep the lock file: unlinking it could let two callers lock different inodes.
command -v flock >/dev/null || alarm_die "flock not found (util-linux)"
exec {lock}>"$out/.$name.lock"
flock -n "$lock" || alarm_die "already building $name in $out"
work=$(mktemp -d "$out/.$name.XXXXXX")
volume=""
cleanup() {
  [[ -z $volume ]] || docker volume rm -f "$volume" >/dev/null 2>&1 || true
  rm -rf "$work"
}
trap cleanup EXIT

alarm_fetch
image=$(alarm_build_image "$ROOT")
volume=omamobile-rootfs-target-$$
docker volume create "$volume" >/dev/null

start=$(date +%s)
for_link=""; ((INSTALL_LINK == 0)) || for_link=", for the install link"
alarm_say "Building $name for $DEVICE (kernel $release, [omamobile] channel $CHANNEL$for_link)"
commit=$(git rev-parse --short=12 HEAD)$(git diff --quiet HEAD -- rootfs packages tools device 2>/dev/null || echo "-dirty")
docker run --rm --privileged --platform linux/arm64 \
  -v "$ROOT:/src:ro" -v "$ROOT/$outrel/repo:/repo:ro" -v "$modules:/modules:ro" \
  -v "$volume:/target" -v "$work:/out" -v "$ALARM_CACHE/pkg:/var/cache/pacman/pkg" \
  -e VERSION="$VERSION" -e DEVICE="$DEVICE" -e DEVICE_PACKAGE="$DEVICE_PACKAGE" \
  -e ROOTFS_PACKAGES="$ROOTFS_PACKAGES" -e KERNEL_PACKAGE="$KERNEL_PACKAGE" \
  -e KERNEL_RELEASE="$release" -e MODULES_SHA256="$(sha256sum < "$modules" | cut -d' ' -f1)" \
  -e GIT_COMMIT="$commit" -e ALARM_SHA256="$(sha256sum < "$ALARM_TARBALL" | cut -d' ' -f1)" \
  -e OMARCHY_CHANNEL="$OMARCHY_CHANNEL" -e CHANNEL="$CHANNEL" -e ALLOW_MISSING="$ALLOW_MISSING" \
  -e INSTALL_LINK="$INSTALL_LINK" \
  "$image" bash /src/rootfs/build-inside

alarm_say "Compressing"
zstd -q -T0 -12 "$work/rootfs.img" -o "$work/$name.img.zst"
(cd "$work" && sha256sum "$name.img.zst" > "$name.img.zst.sha256")
mv "$work/MANIFEST" "$work/$name.MANIFEST"

alarm_say "Checking the image"
tests/rootfs-smoke "$work/$name.img.zst"
# Publish only a complete, checked build. A failed rebuild leaves the old one.
mv "$work/$name.img.zst" "$work/$name.MANIFEST" "$out/"
mv "$work/$name.img.zst.sha256" "$out/"
if ((KEEP_RAW)); then mv "$work/rootfs.img" "$out/$name.img"; fi
echo
ls -lh "$out/$name".*
echo "built in $(( ($(date +%s) - start) / 60 )) min"
