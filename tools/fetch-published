#!/bin/bash
# SPDX-License-Identifier: MIT
# Download Omamobile's published packages (pkgs.omamobile.org,
# docs/RELEASES.md §10) with their signatures, for a contributor's local
# repository: tools/build-packages --local CODENAME --import DIR keeps those
# signatures, so only the port's own packages carry the local key.
#
#   tools/fetch-published [--channel development|stable] DIR
#
# The index and every package must be signed by a key that
# packages/omamobile-keyring trusts and has not revoked, and every package
# must match the SHA-256 the signed index gives for it; anything else stops
# the run. So does an omamobile-revoked not in the form docs/RELEASES.md §10
# gives, before any download (tools/lib/signing.sh's revoked_list).
# Files already in DIR that still verify are not downloaded again. One run
# writes DIR at a time (a second run refuses before downloading). Each
# package is verified in a private folder first and placed into DIR only
# once its SHA-256 and signature pass, so a failed download or check leaves
# DIR as it was (packages placed earlier in the run stay). For a package
# being placed, a stop after unlinking the old package and before the last
# rename can leave a lone .sig (old or new), which --import skips; a stop
# partway can also leave a hidden .fetch-published.* folder (any unplaced
# verified files), which --import never takes and no later run removes.
# Once all of them verify, each package file directly in DIR (*.pkg.tar.zst
# or .xz, or a link to one: the link goes, never its target) whose name the
# index doesn't list goes, with its .sig file, so DIR holds only the
# published set; other files and sub-directories stay. A run that stops
# before then removes no unlisted package. A DIR that holds a repository
# index (omamobile.db or omamobile.db.tar.gz) is refused before any download.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
die() { printf 'error: %s\n' "$*" >&2; exit 1; }

channel=development dir=""
while (($#)); do
  case $1 in
    --channel) channel=${2:?}; shift ;;
    -h|--help) source tools/lib/usage.sh; usage_from_header "$0"; exit 0 ;;
    -*) die "unknown option $1" ;;
    *) [[ -z $dir ]] || die "one DIR only"; dir=$1 ;;
  esac
  shift
done
[[ $channel =~ ^(development|stable)$ ]] || die "--channel is development or stable"
[[ -n $dir ]] || die "usage: tools/fetch-published [--channel development|stable] DIR"
[[ ! -e $dir/omamobile.db && ! -e $dir/omamobile.db.tar.gz ]] ||
  die "$dir is a package repository (it holds omamobile.db): give fetch-published a folder of its own, such as out/<codename>/published"
url=${OMAMOBILE_PKGS_URL:-https://pkgs.omamobile.org}/$channel/aarch64
command -v gpgv >/dev/null && command -v curl >/dev/null && command -v flock >/dev/null || die "gpgv, curl and flock are needed"

keyring=packages/omamobile-keyring
tmp=$(mktemp -d) stage=""
cleanup() {
  rm -rf -- "$tmp"
  [[ -z $stage ]] || rmdir -- "$stage" 2>/dev/null || true
}
trap cleanup EXIT
mkdir -m 700 "$tmp/gnupg"
GNUPGHOME=$tmp/gnupg gpg --batch --quiet --no-default-keyring --keyring "$tmp/omamobile.kbx" \
  --import "$keyring/omamobile.gpg" 2>/dev/null || die "cannot read $keyring/omamobile.gpg"
mapfile -t trusted < <(cut -d: -f1 "$keyring/omamobile-trusted" | grep -E '^[0-9A-F]{40}$')
source tools/lib/signing.sh
revoked=()
revoked_lines=$(revoked_list .) || die "$revoked_lines"
[[ -z $revoked_lines ]] || mapfile -t revoked <<<"$revoked_lines"
((${#trusted[@]})) || die "no trusted keys in $keyring/omamobile-trusted"

# verify SIG FILE: the primary key behind a good signature must be trusted
# and not revoked (a subkey's VALIDSIG names its primary last). gpgv says
# VALIDSIG for a revoked or expired subkey's signature too, with REVKEYSIG
# or EXPKEYSIG in place of GOODSIG, and pacman refuses those, so GOODSIG it
# must be (a rotated subkey, docs/RELEASES.md §10).
verify() {
  local primary
  primary=$(gpgv --keyring "$tmp/omamobile.kbx" --status-fd 1 "$1" "$2" 2>/dev/null \
    | awk '$2 == "GOODSIG" {good = 1} $2 == "VALIDSIG" {p = $NF} END {if (good) print p}') || true
  [[ -n $primary && " ${trusted[*]} " == *" $primary "* && " ${revoked[*]} " != *" $primary "* ]]
}

mkdir -p "$dir"
exec {lock}<"$dir"
flock -n "$lock" || die "another fetch-published is writing $dir"
echo "==> $url"
curl -fsS --globoff -o "$tmp/omamobile.db" "$url/omamobile.db" || die "cannot fetch the index"
curl -fsS --globoff -o "$tmp/omamobile.db.sig" "$url/omamobile.db.sig" || die "the index has no signature"
verify "$tmp/omamobile.db.sig" "$tmp/omamobile.db" || die "the index is not signed by a trusted Omamobile key"

mkdir -p "$tmp/db" && tar -xzf "$tmp/omamobile.db" -C "$tmp/db"
# The globs below decide what is listed and what goes, so glob options bash
# took from the caller's exported BASHOPTS must not change what they match
shopt -u nullglob failglob dotglob nocaseglob
n=0
declare -A listed=()
for desc in "$tmp"/db/*/desc; do
  [[ -e $desc ]] || die "the index lists no package"
  file=$(awk '/^%FILENAME%$/ {getline; print; exit}' "$desc")
  sum=$(awk '/^%SHA256SUM%$/ {getline; print; exit}' "$desc")
  [[ $file =~ ^[A-Za-z0-9@._+:-]+\.pkg\.tar\.(zst|xz)$ && $sum =~ ^[0-9a-f]{64}$ ]] \
    || die "$(basename "$(dirname "$desc")"): unexpected index entry"
  if [[ -f $dir/$file && -f $dir/$file.sig ]] \
     && [[ $(sha256sum < "$dir/$file" | cut -d' ' -f1) == "$sum" ]] && verify "$dir/$file.sig" "$dir/$file"; then
    echo "    have $file"
  else
    [[ ! -d $dir/$file.sig || -L $dir/$file.sig ]] || die "$dir/$file.sig is a directory"
    [[ ! -d $dir/$file || -L $dir/$file ]] || die "$dir/$file is a directory"
    curl -fsS --globoff -o "$tmp/pkg" "$url/$file" || die "cannot fetch $file"
    curl -fsS --globoff -o "$tmp/pkg.sig" "$url/$file.sig" || die "$file has no signature"
    [[ $(sha256sum < "$tmp/pkg" | cut -d' ' -f1) == "$sum" ]] || die "$file does not match the index"
    verify "$tmp/pkg.sig" "$tmp/pkg" || die "$file is not signed by a trusted Omamobile key"
    [[ -n $stage ]] || stage=$(mktemp -d "$dir/.fetch-published.XXXXXX")
    mv -f -- "$tmp/pkg" "$tmp/pkg.sig" "$stage/"
    [[ ! -e $dir/$file && ! -L $dir/$file ]] || rm -f -- "$dir/$file"
    mv -fT -- "$stage/pkg.sig" "$dir/$file.sig"
    mv -fT -- "$stage/pkg" "$dir/$file"
    echo "    got  $file"
  fi
  listed[$file]=1 n=$((n + 1))
done
# A package the index no longer lists (an older version, a dropped package)
# would otherwise be imported beside the current one
for f in "$dir"/*.pkg.tar.zst "$dir"/*.pkg.tar.xz; do
  [[ -f $f ]] || continue
  file=${f##*/}
  [[ -z ${listed[$file]+x} ]] || continue
  rm -f -- "$f"
  [[ ! -f $f.sig ]] || rm -f -- "$f.sig"
  echo "    gone $file"
done
echo "==> $n packages in $dir, each signed by a trusted Omamobile key"
