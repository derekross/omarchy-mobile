#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""sit-sim: a scripted S5300 for testing omamobile-sitd offline.

Speaks SIT as /dev/umts_ipc0 delivers it (the 12-byte request/response
header, the 8-byte indication header, one message per read) over a
SOCK_SEQPACKET Unix socket, and answers AT on a second one in place of
/dev/umts_router. Point the RIL at it with
  OMAMOBILE_SIT_DEVICE=unix:IPC OMAMOBILE_SIT_ROUTER=unix:ROUTER OMAMOBILE_SIT_BOOT=none

The layouts are the ones the RIL uses on the phone (the stock 983-byte data
call, the 292-byte data call response, IMS registration and call status),
packed here independently of the RIL's code.

Script: one READY USIM; after AT+CFUN=1 packet registration "searching" for
--search-polls polls, then home on NR (RAT 21) until the NR mode byte is set
to 0, then LTE (14); bearers get documentation-range addresses; ADD_PDN_INFO
is followed by an IMS registration (state 2, voice|SMS); a dial goes
dialing -> active, a hangup ends it; --incoming-sms delivers one SMS after
the IMS registration. GET_RADIO_POWER answers POWER_OFF (3) until the
first AT+CFUN, then STOP_NETWORK (1) or START_NETWORK (2), each change
announced with IND_RADIO_STATE_CHANGED. Every value is made up: numbers are
fictional 555-01xx ones, addresses are from the documentation ranges.

  tools/sit-sim --ipc PATH --router PATH [--transcript FILE] [--search-polls N]
                [--incoming-sms] [--no-sim] [--reject-setup CAUSE]
                [--no-ims-registration] [--control PATH]
                [--bearer-ip ipv4v6|ipv4|ipv6] [--sim-pin]

--bearer-ip is what the internet bearer comes back as: IPv4v6 (the default,
PDP type 3), IPv4 only (1) or IPv6 only (2, a global /64 address and two
IPv6 DNS64 servers, as an IPv6-only carrier with 464XLAT answers).
--sim-pin makes the USIM ask for its PIN (made-up 2468, three tries, then
PUK) until VERIFY_SIM_PIN carries it; the transcript logs each try's
outcome, never the digits.
--no-ims-registration accepts ADD_PDN_INFO but never registers IMS (a
carrier whose IMS values differ). --control PATH is a datagram socket for tests: "ring" (an incoming IMS call),
"remote-hangup" (the far end ends the current call), "sms" (one text
message), "wap-push" (one MMS notification: an 8-bit SMS to port 2948).

The transcript is JSON lines: every message in and out, and a "violation"
line for a request outside the RIL's allow-list, on the do-not-send list,
or of an unexpected length.
"""
import argparse
import hashlib
import heapq
import ipaddress
import json
import os
import select
import socket
import struct
import sys
import time

TEST_SENDER = '+12025550123'        # fictional
# Identifiers the RIL must never log or publish (made up; MCC/MNC 001/01 is
# the test network): an ICCID-like AID tail, a label, and the IMS public
# identity the registration indication carries.
TEST_AID = bytes.fromhex('a0000000871002ff') + b'8901260000000000017'[:8]
TEST_LABEL = b'SIMSIM-LABEL'
TEST_IMS_URI = b'sip:001010000000017@ims.mnc001.mcc001.3gppnetwork.org;tel:+12025550100'
# The do-not-send list (MODEM-SIT-RESEARCH section 5), by ID.
DENIED = {0x0947, 0x0937, 0x0948, 0x0907, 0x0908, 0x0910, 0x093A, 0x0942, 0x0940, 0x0406,
          0x072E, 0x0766, 0x4600, 0x024C, 0x020A, 0x0205, 0x0206, 0x0207, 0x0931, 0x0760,
          0x0762, 0x0401, 0x0402}
DENIED_FAMILIES = (0x0E, 0x13)
# Expected request lengths (the stock builders').
LENGTHS = {0x0600: 983, 0x0603: 251, 0x0613: 246, 0x0d00: 12 + 679, 0x0d1b: 272,
           0x0d08: 12 + 679, 0x0102: 21, 0x0d1d: 21, 0x0748: 13, 0x0710: 13, 0x0625: 14,
           0x061b: 16, 0x0201: 38, 0x0d39: 14, 0x0d03: 15, 0x0d02: 18, 0x0d0a: 15, 0x0902: 16, 0x0928: 16}


def addr(text):
    return ipaddress.ip_address(text).packed


class Sim:
    def __init__(self, a):
        self.a = a
        self.radio = 0
        self.radio_state = 3                     # POWER_OFF until AT+CFUN
        self.polls = 0
        self.nr_mode = 3
        self.ps_service = 1
        self.pin_locked = a.sim_pin
        self.pin_tries = 3
        self.sessions = 0
        self.bearers = {}
        self.calls = {}
        self.timers = []
        self.conn = None
        self.tlog = open(a.transcript, 'a') if a.transcript else None

    def log(self, **kw):
        kw['t'] = round(time.monotonic(), 3)
        if self.tlog:
            self.tlog.write(json.dumps(kw) + '\n')
            self.tlog.flush()
        if self.a.verbose:
            print('sit-sim:', kw, file=sys.stderr)

    def after(self, delay, fn):
        heapq.heappush(self.timers, (time.monotonic() + delay, id(fn), fn))

    def respond(self, mid, token, err=0, params=b''):
        raw = struct.pack('<BBHHIBB', 1, 0, mid, 12 + len(params), token, err, 0) + params
        self.log(dir='out', type='resp', id=mid, len=len(raw), err=err)
        if self.conn:
            self.conn.send(raw)

    def indicate(self, mid, params=b''):
        raw = struct.pack('<BBHHH', 2, 0, mid, 8 + len(params), 0) + params
        self.log(dir='out', type='ind', id=mid, len=len(raw))
        if self.conn:
            self.conn.send(raw)

    # ---- AT on the router channel ----------------------------------------

    def at(self, conn, data):
        for line in data.decode('ascii', 'replace').split('\r'):
            if not line:
                continue
            self.log(dir='in', type='at', cmd=line)
            if line in ('AT+CFUN=1', 'AT+CFUN=0'):
                if line == 'AT+CFUN=1' and not self.radio:
                    self.after(0.5, self.signal_report)
                self.radio = int(line[-1])
                self.radio_state = 2 if self.radio else 1
                conn.send(b'\r\nOK\r\n')
                self.indicate(0x0802, struct.pack('<I', self.radio_state))
            elif line == 'AT+CFUN?':
                conn.send(b'\r\n+CFUN: %d\r\n\r\nOK\r\n' % self.radio)
            else:
                self.log(violation='unexpected AT command', cmd=line)
                conn.send(b'\r\nERROR\r\n')

    # ---- SIT ---------------------------------------------------------------

    def handle(self, raw):
        typ, _, mid, length, token, _err, _ = struct.unpack_from('<BBHHIBB', raw)
        self.log(dir='in', type='req', id=mid, len=len(raw))
        if typ != 0 or length != len(raw):
            self.log(violation='bad header', id=mid)
            return
        if mid in DENIED or (mid >> 8) in DENIED_FAMILIES:
            self.log(violation='do-not-send', id=mid)
            return self.respond(mid, token, 22)
        if mid in LENGTHS and len(raw) != LENGTHS[mid]:
            self.log(violation='length %d, expected %d' % (len(raw), LENGTHS[mid]), id=mid)
        fn = getattr(self, 'r_%04x' % mid, None)
        if fn is None:
            self.log(violation='unexpected request', id=mid)
            return self.respond(mid, token, 6)
        fn(mid, token, raw[12:])

    def ok(self, mid, token, p):
        self.respond(mid, token)

    r_0603 = r_0613 = r_0625 = r_0d39 = r_0d1d = r_0102 = r_0902 = r_0928 = ok

    def r_0d07(self, mid, token, p):            # AIMS_HIDDEN_MENU
        self.log(event='hidden_menu', sha256=hashlib.sha256(p).hexdigest())
        self.respond(mid, token)

    def r_0200(self, mid, token, p):            # GET_SIM_STATUS
        if self.a.no_sim:
            return self.respond(mid, token, 0, bytes([0, 0, 0]))
        app = bytearray(63)
        app[0], app[1] = 2, (5 if not self.pin_locked else 2 if self.pin_tries else 3)   # USIM
        app[3], app[4:4 + len(TEST_AID)] = len(TEST_AID), TEST_AID
        app[20], app[21:21 + len(TEST_LABEL)] = len(TEST_LABEL), TEST_LABEL
        app[59], app[60] = self.pin_tries, 10    # PIN and PUK tries left
        self.respond(mid, token, 0, bytes([1, 0, 1]) + bytes(app))

    def registered(self):
        return (self.radio == 1 and self.polls > self.a.search_polls and not self.a.no_sim
                and not self.pin_locked)

    def r_0201(self, mid, token, p):            # VERIFY_SIM_PIN
        pin = p[1:1 + p[0]].decode('ascii', 'replace') if p and p[0] <= 8 else ''
        aid = p[10:10 + p[9]] if len(p) >= 26 and p[9] <= 16 else b''
        if not self.pin_locked or not self.pin_tries:
            self.log(event='verify_pin', outcome='not asked for')
            return self.respond(mid, token, 6)
        if aid != TEST_AID[:16]:
            self.log(violation='VERIFY_SIM_PIN without the USIM AID')
        if pin == '2468':
            self.pin_locked = False
            self.log(event='verify_pin', outcome='accepted')
            self.respond(mid, token, 0, struct.pack('<I', self.pin_tries))
        else:
            self.pin_tries -= 1
            self.log(event='verify_pin', outcome='rejected', left=self.pin_tries)
            self.respond(mid, token, 3, struct.pack('<I', self.pin_tries))
        self.indicate(0x0210)

    def r_0701(self, mid, token, p):            # GET_PS_REG_STATE
        if self.radio == 1:
            self.polls += 1
        reg = 1 if self.registered() else (2 if self.radio == 1 else 0)
        rat = (21 if self.nr_mode else 14) if reg == 1 else 0
        payload = bytearray(0x36 - 12)
        payload[0], payload[3] = reg, rat
        self.respond(mid, token, 0, bytes(payload))

    def r_0702(self, mid, token, p):            # GET_OPERATOR
        payload = bytearray(0x77 - 12)
        payload[0:6] = b'00101#'
        payload[6:10] = b'Test'
        self.respond(mid, token, 0, bytes(payload))

    def r_0801(self, mid, token, p):            # GET_RADIO_POWER
        self.respond(mid, token, 0, struct.pack('<I', self.radio_state))

    def r_0749(self, mid, token, p):
        self.respond(mid, token, 0, bytes([self.nr_mode]))

    def r_0748(self, mid, token, p):
        self.nr_mode = p[0]
        self.respond(mid, token)

    def r_0711(self, mid, token, p):
        self.respond(mid, token, 0, bytes([self.ps_service]))

    def r_0710(self, mid, token, p):
        self.ps_service = p[0]
        self.respond(mid, token)

    def r_061a(self, mid, token, p):            # ALLOC_PDU_SESSION
        self.sessions += 1
        self.respond(mid, token, 0, struct.pack('<i', self.sessions))

    def r_061b(self, mid, token, p):
        self.respond(mid, token)

    def r_0602(self, mid, token, p):            # GET_DATA_CALL_LIST
        records = b''
        for cid in sorted(self.bearers):
            record = bytearray(292)
            record[2], record[3] = cid, 2
            records += bytes(record)
        self.respond(mid, token, 0, bytes([len(self.bearers)]) + records)

    def r_0600(self, mid, token, p):            # SETUP_DATA_CALL
        cid, apn = p[0], p[4:0xd9 - 12].split(b'\0')[0].decode()
        self.log(event='setup_data_call', cid=cid, apn=apn, ip=p[0xda - 12])
        if not self.registered():
            return self.respond(mid, token, 9)
        r = bytearray(292)
        if self.a.reject_setup:
            struct.pack_into('<HBBB', r, 0, self.a.reject_setup, cid, 0, 0)
            return self.respond(mid, token, 0, bytes(r))
        ims = cid == 2
        pdp = 2 if ims else {'ipv4v6': 3, 'ipv4': 1, 'ipv6': 2}[self.a.bearer_ip]
        struct.pack_into('<HBBB', r, 0, 0, cid, 2, pdp)
        if not ims and pdp in (1, 3):
            r[5:9] = addr('192.0.2.2')
            r[0x1a:0x1e] = addr('192.0.2.53')
            r[0x2e:0x32] = addr('192.0.2.54')
        if not ims and pdp == 2:
            r[9:25] = addr('2001:db8:64::2')
            r[0x1e:0x2e] = addr('2001:db8:64::53')
            r[0x32:0x42] = addr('2001:db8:64::54')
        elif pdp != 1:
            r[9:25] = addr('2001:db8::2' if not ims else '2001:db8:1::2')
        if ims:
            r[0x42] = 2
            r[0x4f:0x5f] = addr('2001:db8:1::10')
        self.bearers[cid] = True
        self.respond(mid, token, 0, bytes(r))

    def r_0601(self, mid, token, p):
        self.bearers.pop(p[0], None)
        self.respond(mid, token)

    def r_0d08(self, mid, token, p):            # AIMS_ADD_PDN_INFO
        self.respond(mid, token)

        def registered():
            self.indicate(0x0d05, struct.pack('<BBIHHH', 2, 3, 3, 0, len(TEST_IMS_URI), 0) + TEST_IMS_URI)
            if self.a.incoming_sms:
                self.after(0.3, self.incoming_sms)
        if not self.a.no_ims_registration:
            self.after(0.1, registered)

    def r_0108(self, mid, token, p):            # GET_SMSC_ADDR
        self.respond(mid, token, 0, bytes([7, 0x91]) + bytes.fromhex('2120550521f3') + bytes(5))

    def r_0d1b(self, mid, token, p):            # AIMS_SEND_SMS
        self.log(event='send_sms', tpdu_len=p[13])
        self.respond(mid, token, 0, bytes(253))

    def r_0000(self, mid, token, p):            # GET_CURRENT_CALLS
        self.respond(mid, token, 0, struct.pack('<I', len(self.calls)))

    def call_status(self, call_id, state, cause=0):
        body = struct.pack('<HBBBBBB', 1, call_id, state, 0, 0, 0, cause) + bytes(4)
        self.indicate(0x0d04, body)

    def r_0d00(self, mid, token, p):            # AIMS_DIAL
        call_id = 1
        self.calls[call_id] = 'dialing'
        self.respond(mid, token)
        self.after(0.05, lambda: self.call_status(call_id, 2))
        self.after(0.2, lambda: self.call_status(call_id, 0))

    def r_0d03(self, mid, token, p):            # AIMS_HANGUP
        self.calls.pop(p[0], None)
        self.respond(mid, token)
        self.after(0.05, lambda: self.call_status(p[0], 6, 16))

    def r_0d02(self, mid, token, p):            # AIMS_ANSWER
        ringing = [c for c, state in self.calls.items() if state == 'ringing-in']
        if not ringing:
            return self.respond(mid, token, 6)
        self.calls[ringing[0]] = 'active'
        self.respond(mid, token)
        self.after(0.05, lambda: self.call_status(ringing[0], 0))

    def r_0d0a(self, mid, token, p):            # AIMS_SEND_DTMF
        self.log(event='dtmf', call=p[0], key=chr(p[2]) if len(p) > 2 else '')
        self.respond(mid, token)

    def signal_report(self):
        # IND_SIGNAL_STRENGTH in the stock V2 layout (u16 RAT mask, then
        # s32 fields; LTE at body 0x3c: ss 20, RSRP 95, RSRQ 10, RSSNR 12.0 dB),
        # once a second while registered, as the modem does with the screen on.
        if self.radio != 1:
            return
        if self.registered():
            body = bytearray(struct.pack('<i', 0x7fffffff) * 27)
            struct.pack_into('<4i', body, 0x3c, 20, 95, 10, 120)
            self.indicate(0x0906, struct.pack('<H', 0x04) + bytes(body))
        self.after(1.0, self.signal_report)

    # ---- the test control socket ---------------------------------------

    def control(self, command):
        self.log(event='control', command=command)
        if command == 'ring':
            call_id, caller = 2, TEST_SENDER.encode()
            self.calls[call_id] = 'ringing-in'
            self.indicate(0x0d01, struct.pack('<HBH', 1, call_id, len(caller)) + caller)
            self.after(0.05, lambda: self.call_status(call_id, 4))
        elif command == 'remote-hangup':
            for call_id in list(self.calls):
                self.calls.pop(call_id)
                self.call_status(call_id, 6, 16)
        elif command == 'sms':
            self.incoming_sms()
        elif command == 'wap-push':
            self.wap_push()
        else:
            self.log(violation='unknown control command', command=command)

    def incoming_sms(self):
        tpdu = bytes.fromhex('000b912120550521f300006290922143650005e8329bfd06')   # "hello"
        data = bytes.fromhex('07912120550521f3') + tpdu
        self.indicate(0x0d1e, bytes([7, len(data)]) + data)

    def wap_push(self):
        # An 8-bit SMS-DELIVER with a port header (destination 2948, the WAP
        # push port): the user data is a made-up WSP push, not a real MMS.
        body = bytes.fromhex('0106226170706c69636174696f6e2f766e642e7761702e6d6d732d6d65737361676500') + b'omamobile-test'
        ud = bytes.fromhex('0605040b8423f0') + body
        tpdu = bytes.fromhex('440b912120550521f3000462909221436500') + bytes([len(ud)]) + ud
        data = bytes.fromhex('07912120550521f3') + tpdu
        self.indicate(0x0d1e, bytes([8, len(data)]) + data)


def listen(path, kind):
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    s = socket.socket(socket.AF_UNIX, kind)
    s.bind(path)
    s.listen(2)
    return s


def main():
    p = argparse.ArgumentParser(description='SIT modem simulator')
    p.add_argument('--ipc', required=True)
    p.add_argument('--router', required=True)
    p.add_argument('--transcript')
    p.add_argument('--search-polls', type=int, default=2)
    p.add_argument('--incoming-sms', action='store_true')
    p.add_argument('--no-sim', action='store_true')
    p.add_argument('--reject-setup', type=int, default=0)
    p.add_argument('--no-ims-registration', action='store_true')
    p.add_argument('--control')
    p.add_argument('--sim-pin', action='store_true')
    p.add_argument('--bearer-ip', choices=('ipv4v6', 'ipv4', 'ipv6'), default='ipv4v6')
    p.add_argument('-v', '--verbose', action='store_true')
    a = p.parse_args()
    ipc = listen(a.ipc, socket.SOCK_SEQPACKET)
    router = listen(a.router, socket.SOCK_SEQPACKET)
    sim = Sim(a)
    sim.log(event='listening')
    at_conns = []
    control = None
    if a.control:
        try:
            os.unlink(a.control)
        except FileNotFoundError:
            pass
        control = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        control.bind(a.control)
    while True:
        timeout = max(0, sim.timers[0][0] - time.monotonic()) if sim.timers else None
        watch = [ipc, router] + at_conns + ([sim.conn] if sim.conn else []) + ([control] if control else [])
        ready, _, _ = select.select(watch, [], [], timeout)
        now = time.monotonic()
        while sim.timers and sim.timers[0][0] <= now:
            heapq.heappop(sim.timers)[2]()
        for r in ready:
            if r is control:
                sim.control(control.recv(256).decode('ascii', 'replace').strip())
            elif r is ipc:
                sim.conn, _ = ipc.accept()
                sim.log(event='connected')
            elif r is router:
                at_conns.append(router.accept()[0])
            elif r is sim.conn:
                data = r.recv(65568)
                if not data:
                    sim.conn.close()
                    sim.conn = None
                    sim.log(event='disconnected')
                else:
                    sim.handle(data)
            else:
                data = r.recv(4096)
                if not data:
                    at_conns.remove(r)
                    r.close()
                else:
                    sim.at(r, data)


if __name__ == '__main__':
    main()
