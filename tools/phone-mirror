#!/bin/bash
# SPDX-License-Identifier: MIT
# phone-mirror: the phone's screen in a window on this computer, with mouse
# and keyboard input, over the USB link (like scrcpy, over VNC).
#
#   tools/phone-mirror [--keep] [--fit] [--viewer tigervnc|gvncviewer|remmina] [--height PX]
#
# Starts mirroring on the phone (omamobile-mirror on, package omamobile-mirror),
# opens a VNC viewer on 172.16.42.1:5900 titled "Omarchy Mobile phone", and turns
# mirroring off again when the viewer closes (--keep leaves it on).
#   --fit      the whole phone in the window, no scrolling: TigerVNC runs inside
#              gamescope on this computer, which scales its 1440x3120 picture
#              down to the window (and the mouse back up); needs gamescope
#   --viewer   pick a viewer; default: tigervnc, then gvncviewer (remmina only on request;
#              its VNC plugin rejects the phone's 1440x3120 frame)
#   --height   window height in pixels (default 900); the width follows the
#              phone's 1440:3120 portrait shape
# For OBS: add a "Window Capture (PipeWire)" source and pick the viewer window.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

ADDRESS=172.16.42.1
PORT=5900
TITLE="Omarchy Mobile phone"
PHONE_W=1440 PHONE_H=3120	# the panel in pixels, what wayvnc sends (portrait): read from the phone below
KEEP=0 FIT=0 VIEWER= HEIGHT=900

usage() { sed -n '3,19s/^# \{0,1\}//p' "$0" >&2; exit 2; }
die() { echo "phone-mirror: $*" >&2; exit 1; }
while [[ $# -gt 0 ]]; do
  case $1 in
    --keep) KEEP=1 ;;
    --fit) FIT=1 ;;
    --viewer) VIEWER=${2:?}; shift ;;
    --height) HEIGHT=${2:?}; shift ;;
    -h|--help) usage ;;
    *) usage ;;
  esac
  shift
done
[[ $HEIGHT =~ ^[0-9]+$ ]] && (( HEIGHT >= 200 )) || die "--height takes a number of pixels"

have() { command -v "$1" >/dev/null; }
remmina_vnc() { # Remmina without libvncserver has no VNC plugin
  [[ -e /usr/lib/remmina/plugins/remmina-plugin-vnc.so ]] || ls /usr/lib*/remmina/plugins/*vnc* >/dev/null 2>&1
}
missing() {
  cat >&2 <<EOF
phone-mirror: no VNC viewer found on this computer. Install one:
  sudo pacman -S tigervnc               # recommended: vncviewer, fast and full quality (no scaling: scroll)
  sudo pacman -S gamescope              # with tigervnc: --fit shows the whole phone in the window
  sudo pacman -S gtk-vnc                # gvncviewer: works, but slower
(Remmina's VNC plugin refuses the phone's full-size frame, "Rect too large",
and reports a time-out; it is only used when asked for with --viewer remmina.)
EOF
  exit 1
}
if [[ -z $VIEWER ]] && (( FIT )); then
  VIEWER=tigervnc
elif [[ -z $VIEWER ]]; then
  # TigerVNC first: tested against the phone (2026-10-13). Remmina's VNC
  # plugin (libvncclient) rejects the 1440x3120 frame ("Rect too large").
  if have vncviewer; then VIEWER=tigervnc
  elif have gvncviewer; then VIEWER=gvncviewer
  else missing; fi
fi
case $VIEWER in
  remmina) have remmina || die "remmina is not installed: sudo pacman -S remmina libvncserver"
           remmina_vnc || die "remmina has no VNC plugin: sudo pacman -S libvncserver" ;;
  tigervnc) have vncviewer || die "vncviewer is not installed: sudo pacman -S tigervnc" ;;
  gvncviewer) have gvncviewer || die "gvncviewer is not installed (gtk-vnc's example viewer)" ;;
  *) die "unknown viewer $VIEWER (remmina, tigervnc, gvncviewer)" ;;
esac
if (( FIT )); then
  [[ $VIEWER == tigervnc ]] || die "--fit works with tigervnc (gvncviewer scales by itself; remmina can't show the phone)"
  have gamescope || die "--fit needs gamescope: sudo pacman -S gamescope"
fi

tools/phone-ssh true 2>/dev/null || die "the phone does not answer on $ADDRESS (USB cable, tools/phone-ssh)"
# The panel's own mode (the Pixel 7 Pro is 1440x3120, the Pixel 9a 1080x2424)
mode=$(tools/phone-ssh 'cat /sys/class/drm/card*-DSI-*/modes 2>/dev/null | head -1' 2>/dev/null || true)
[[ $mode =~ ^([0-9]+)x([0-9]+) ]] && PHONE_W=${BASH_REMATCH[1]} PHONE_H=${BASH_REMATCH[2]}
WIDTH=$(( HEIGHT * PHONE_W / PHONE_H ))
tools/phone-ssh command -v omamobile-mirror >/dev/null ||
  die "omamobile-mirror is not installed on the phone: tools/phone-install-package packages/omamobile-mirror"

tmp=$(mktemp -d)
cleanup() {
  rm -rf "$tmp"
  if (( KEEP )); then
    echo "phone-mirror: mirroring stays on (tools/phone-ssh omamobile-mirror off to stop it)"
  else
    tools/phone-ssh omamobile-mirror off >/dev/null 2>&1 && echo "phone-mirror: mirroring off" ||
      echo "phone-mirror: could not turn mirroring off: tools/phone-ssh omamobile-mirror off" >&2
  fi
}
trap cleanup EXIT
trap 'exit 130' INT TERM

tools/phone-ssh omamobile-mirror on || die "omamobile-mirror on failed on the phone"
for _ in $(seq 1 20); do
  timeout 1 bash -c "exec 3<>/dev/tcp/$ADDRESS/$PORT" 2>/dev/null && break
  sleep 0.5
done
timeout 1 bash -c "exec 3<>/dev/tcp/$ADDRESS/$PORT" 2>/dev/null ||
  die "nothing listens on $ADDRESS:$PORT (on the phone: journalctl --user -u omamobile-mirror)"

case $VIEWER in
  remmina)
    # The profile's name is the window title.
    cat > "$tmp/omamobile-phone.remmina" <<EOF
[remmina]
name=$TITLE
protocol=VNC
server=$ADDRESS:$PORT
colordepth=32
quality=9
scale=1
viewmode=1
window_width=$WIDTH
window_height=$HEIGHT
window_maximize=0
showcursor=0
viewonly=0
disableclipboard=0
disablepasswordstoring=1
EOF
    remmina -c "$tmp/omamobile-phone.remmina" >/dev/null 2>&1 || true ;;
  tigervnc)
    if (( FIT )); then
      # TigerVNC can't scale, and the phone can't send a smaller picture
      # (Hyprland gives a mirrored output no wl_output for wayvnc to capture;
      # packages/omamobile-mirror/README.md). So TigerVNC runs full screen on a
      # 1440x3120 screen nested in gamescope, and gamescope scales that screen
      # into a WIDTHxHEIGHT window here, on this computer's GPU, mapping the
      # mouse back. The window is gamescope's: close it to stop.
      gamescope -W "$WIDTH" -H "$HEIGHT" -w "$PHONE_W" -h "$PHONE_H" -S fit -F linear -- \
        vncviewer -FullScreen=1 -RemoteResize=0 -Shared=1 "$ADDRESS::$PORT" || true
    else
      # Title "Omarchy Mobile phone - TigerVNC". TigerVNC does not scale: the
      # window shows the phone at full size and scrolls (--fit: no scrolling).
      vncviewer -geometry "${WIDTH}x${HEIGHT}" -RemoteResize=0 -Shared=1 "$ADDRESS::$PORT" || true
    fi ;;
  gvncviewer)
    gvncviewer "$ADDRESS:$(( PORT - 5900 ))" || true ;;
esac

# A viewer that was already running (Remmina is single-instance) hands the
# connection over and returns at once: wait until no connection is left.
while ss -Htn state established dst "$ADDRESS" "dport = :$PORT" 2>/dev/null | grep . >/dev/null; do
  sleep 1
done
