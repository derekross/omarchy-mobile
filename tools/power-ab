#!/bin/bash
# SPDX-License-Identifier: MIT
#
# power-ab: measure battery drain on the phone for two settings, A and B,
# alternated in rounds so slow drift (battery voltage, temperature, a
# background job) cancels out. Runs ON the phone, detached, because the USB
# cable has to be out while it measures (and USB may not come back after an
# unplug until the next boot): the results go to a file on the root
# filesystem.
#
# Usage (on the phone, as root):
#   power-ab [options] TEST
#
# TEST:
#   baseline    A and B identical (shows the noise floor)
#   c2          A = C2 idle state disabled on every CPU, B = enabled
#               (needs a DTB with the power-c2-* overlay)
#   ufs-gate    A = UFS clock gating (and so idle Hibern8) off, B = on
#   ufs-delay   A = Hibern8 after 150 ms idle (kernel default), B = after
#               --delay-ms (default 4, the stock Android value)
#   s2idle      A = awake, B = frozen in s2idle for the whole phase
#               (rtcwake -m freeze, frozen again after an early wake). Turn
#               the screen off after unplugging: both phases assume it off.
#               Nothing runs while frozen, so both phases are measured
#               from the gauge's charge counter (1 mAh steps: use phases of
#               10 minutes or more); A is also sampled as usual
#   units       A = the --units system units and --user-units of --user
#               stopped, B = started (units not active at the start are
#               left alone)
#
# Options:
#   --unplug SECS   wait before the first phase, to pull the cable (default 60)
#   --phase SECS    length of each phase (default 120)
#   --settle SECS   seconds at the start of each phase not counted (default 20)
#   --rounds N      A/B rounds (default 4)
#   --delay-ms MS   B value for ufs-delay (default 4)
#   --units "U..."  system units for the units test
#   --user-units "U..."  user units for the units test
#   --user NAME     whose user units (default: the first logged-in user)
#   --detach        re-run itself with setsid/nohup and return at once
#
# Output: /var/lib/omamobile/power/<time>-<test>.csv (one sample a second:
# time, phase, voltage_now uV, current_now uA, current_avg uA,
# charge_counter uAh; s2idle's B phase writes one row as it freezes and one
# as it ends) and <time>-<test>.txt (mean current and power per phase, then
# A vs B; for s2idle, the mean current from the charge counter too).
# Every setting the test changes is restored at the end, also on SIGTERM.
#
# See device/cheetah/POWER-PLAN.md, section 4.

set -uo pipefail

unplug=60 phase=120 settle=20 rounds=4 delay_ms=4 detach=0 test=
units= user_units= uname=

usage() { sed -n '/^# Usage/,/^# See /p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

while (($#)); do
  case "$1" in
    --unplug) unplug="${2:?}"; shift ;;
    --phase) phase="${2:?}"; shift ;;
    --settle) settle="${2:?}"; shift ;;
    --rounds) rounds="${2:?}"; shift ;;
    --delay-ms) delay_ms="${2:?}"; shift ;;
    --units) units="${2?}"; shift ;;
    --user-units) user_units="${2?}"; shift ;;
    --user) uname="${2?}"; shift ;;
    --detach) detach=1 ;;
    -h|--help) usage ;;
    baseline|c2|ufs-gate|ufs-delay|s2idle|units) test="$1" ;;
    *) usage 1 ;;
  esac
  shift
done
[[ -n "$test" ]] || usage 1
[[ $EUID -eq 0 ]] || { echo "power-ab: run as root" >&2; exit 1; }

if ((detach)); then
  args=(--unplug "$unplug" --phase "$phase" --settle "$settle" --rounds "$rounds" --delay-ms "$delay_ms"
        --units "$units" --user-units "$user_units" --user "$uname" "$test")
  setsid nohup "$0" "${args[@]}" > /dev/null 2>&1 < /dev/null &
  echo "power-ab: started (pid $!); unplug within ${unplug} s"
  exit 0
fi

# The battery: the power supply of type Battery that reports current_now
bat=
for d in /sys/class/power_supply/*; do
  [[ "$(cat "$d/type" 2>/dev/null)" == Battery && -r "$d/current_now" ]] && { bat=$d; break; }
done
[[ -n "$bat" ]] || { echo "power-ab: no battery with current_now (is max17042_battery loaded?)" >&2; exit 1; }

ufs=$(ls -d /sys/bus/platform/devices/*.ufs 2>/dev/null | head -n1)
idle_states=(/sys/devices/system/cpu/cpu[0-7]/cpuidle/state1/disable)

case "$test" in
  c2)
    [[ -e "${idle_states[0]}" ]] || { echo "power-ab: no cpuidle state1 (boot a DTB with the C2 overlay)" >&2; exit 1; } ;;
  ufs-gate|ufs-delay)
    [[ -n "$ufs" && -w "$ufs/clkgate_enable" ]] || { echo "power-ab: no UFS clock gating attributes" >&2; exit 1; } ;;
  s2idle)
    command -v rtcwake >/dev/null && grep -qw s2idle /sys/power/mem_sleep \
      || { echo "power-ab: needs rtcwake and s2idle" >&2; exit 1; }
    [[ -r "$bat/charge_counter" ]] || { echo "power-ab: the gauge has no charge_counter" >&2; exit 1; } ;;
  units)
    [[ -n "$units$user_units" ]] || { echo "power-ab: units needs --units or --user-units" >&2; exit 1; } ;;
esac

# The units test touches only units that are active now
[[ -z "$uname" ]] && uname=$(loginctl list-users --no-legend 2>/dev/null | awk '$2 != "root" {print $2; exit}')
usys=() uusr=()
for u in $units; do systemctl -q is-active "$u" && usys+=("$u"); done
if [[ -n "$user_units" && -n "$uname" ]]; then
  for u in $user_units; do
    systemctl --user -M "$uname@.host" -q is-active "$u" 2>/dev/null && uusr+=("$u")
  done
fi
units_start() {
  ((${#usys[@]})) && systemctl start "${usys[@]}"
  ((${#uusr[@]})) && systemctl --user -M "$uname@.host" start "${uusr[@]}"
}
units_stop() {
  ((${#uusr[@]})) && systemctl --user -M "$uname@.host" stop "${uusr[@]}"
  ((${#usys[@]})) && systemctl stop "${usys[@]}"
}

# Save what we may change, restore it on exit
declare -A saved
save() { [[ -r "$1" ]] && saved["$1"]=$(cat "$1"); }
for f in "${idle_states[@]}"; do [[ -e "$f" ]] && save "$f"; done
[[ -n "$ufs" ]] && { save "$ufs/clkgate_enable"; save "$ufs/clkgate_delay_ms"; }
restore() {
  local f
  for f in "${!saved[@]}"; do echo "${saved[$f]}" > "$f" 2>/dev/null; done
  [[ $test == units ]] && units_start > /dev/null 2>&1
}
trap 'restore; exit 1' TERM INT HUP
trap restore EXIT

set_cfg() { # A|B
  local v f
  case "$test" in
    baseline) : ;;
    c2)
      [[ $1 == A ]] && v=1 || v=0
      for f in "${idle_states[@]}"; do echo "$v" > "$f"; done ;;
    ufs-gate)
      [[ $1 == A ]] && v=0 || v=1
      echo "$v" > "$ufs/clkgate_enable" ;;
    ufs-delay)
      [[ $1 == A ]] && v=150 || v=$delay_ms
      echo 1 > "$ufs/clkgate_enable"
      echo "$v" > "$ufs/clkgate_delay_ms" ;;
    units)
      if [[ $1 == A ]]; then units_stop; else units_start; fi > /dev/null 2>&1 ;;
  esac
}

out=/var/lib/omamobile/power
mkdir -p "$out"
stamp=$(date +%Y%m%d-%H%M%S)
csv="$out/$stamp-$test.csv" txt="$out/$stamp-$test.txt"

{
  echo "# power-ab $test: phase ${phase}s settle ${settle}s rounds $rounds unplug ${unplug}s delay_ms $delay_ms"
  echo "# kernel $(uname -r); battery $bat; ufs ${ufs:-none}"
  [[ $test == units ]] && echo "# units: ${usys[*]}; user units ($uname): ${uusr[*]}"
  echo "time,phase,voltage_uv,current_ua,current_avg_ua,charge_counter_uah,charge_now_uah"
} > "$csv"

sleep "$unplug"
if grep -qsx 1 /sys/class/power_supply/*/online; then
  echo "# warning: a supply reports online=1 at start (cable still in?)" >> "$csv"
fi

sample() { # TAG
  printf '%s,%s,%s,%s,%s,%s,%s\n' "$(date +%s)" "$1" \
    "$(cat "$bat/voltage_now")" "$(cat "$bat/current_now")" \
    "$(cat "$bat/current_avg" 2>/dev/null || echo)" \
    "$(cat "$bat/charge_counter" 2>/dev/null || echo)" \
    "$(cat "$bat/charge_now" 2>/dev/null || echo)" >> "$csv"
}

freeze_phase() { # one B phase of s2idle: frozen until the phase is over
  local t0 left
  t0=$(date +%s)
  sample B-freeze
  sync
  while left=$(( phase - ($(date +%s) - t0) )); (( left > 5 )); do
    rtcwake -m freeze -s "$left" > /dev/null 2>&1 || { echo "# rtcwake failed at $(date +%s)" >> "$csv"; sleep 1; }
  done
  sample B-end
}

for ((r = 1; r <= rounds; r++)); do
  for p in A B; do
    set_cfg "$p"
    if [[ $test == s2idle && $p == B ]]; then freeze_phase; sync; continue; fi
    t0=$(date +%s)
    while (( $(date +%s) - t0 < phase )); do
      t=$(( $(date +%s) - t0 ))
      tag=$p
      (( t < settle )) && tag="${p}-settle"
      sample "$tag"
      sleep 1
    done
    sync
  done
done

restore
trap - EXIT

# Summary: mean current and power per phase. Discharge current is negative.
awk -F, -v test="$test" '
  /^#/ || $1 == "time" { next }
  $2 == "A" || $2 == "B" {
    n[$2]++; i[$2] += $4; pw[$2] += ($3 / 1e6) * ($4 / 1e6)
  }
  END {
    printf "test %s\n", test
    for (p in n)
      printf "%s: %d samples, mean current %.1f mA, mean power %.0f mW\n",
        p, n[p], i[p] / n[p] / 1000, pw[p] / n[p] * 1000
    if (n["A"] && n["B"])
      printf "B - A: %+.1f mA, %+.0f mW (positive = B draws less)\n",
        (i["B"] / n["B"] - i["A"] / n["A"]) / 1000,
        (pw["B"] / n["B"] - pw["A"] / n["A"]) * 1000
  }' "$csv" > "$txt"
# From the charge counter (column 6, QH) and, as a cross-check, the
# reported remaining charge (column 7, RepCap, which the gauge's model also
# corrects): the charge used per phase over its duration. A phase spans its
# first counted sample (after the settle) to its last; B (s2idle) its
# B-freeze row to its B-end row. 1 mAh steps: longer phases, finer numbers.
for col in 6:"charge counter" 7:"reported charge"; do
awk -F, -v c="${col%%:*}" -v name="${col#*:}" '
  /^#/ || $1 == "time" || $c == "" { next }
  $2 == "A" { if (!inA) { a0t = $1; a0q = $c; inA = 1 } a1t = $1; a1q = $c; next }
  inA { qa += a0q - a1q; ta += a1t - a0t; inA = 0 }
  $2 == "B-freeze" { b0t = $1; b0q = $c }
  $2 == "B-end" { qb += b0q - $c; tb += $1 - b0t }
  END {
    if (inA) { qa += a0q - a1q; ta += a1t - a0t }
    if (ta) printf "A (%s): %.1f mAh over %d s, mean %.1f mA\n", name, qa / 1000, ta, qa / ta * 3.6
    if (tb) printf "B (%s): %.1f mAh over %d s, mean %.1f mA\n", name, qb / 1000, tb, qb / tb * 3.6
  }' "$csv" >> "$txt"
done
sync
