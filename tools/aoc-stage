#!/bin/bash
# SPDX-License-Identifier: MIT
#
# aoc-stage: run one staged AoC bring-up step (device/cheetah/AOC-PLAN.md,
# section 7) and keep every kernel line on the laptop, even if the phone hangs.
#
# A first SSH connection streams /dev/kmsg into logs/aoc-<time>-<stage>.log
# BEFORE a second one touches the hardware. Every step prints what it is about
# to do into the kernel log first ("aoc-stage: ...").
#
# Needs a kernel with omamobile-aoc and a DTB with the aoc-boot-test overlay.
# The device is read from the phone's DT: cheetah (gs201) or raven (gs101,
# device/raven/AUDIO-PLAN.md). Raven has no c3 or rails stage: its AoC rails
# are regulators in the DT, which the AoC driver enables itself.
# The modules (gsa, gs201_aoc_sysmmu, gs201_aoc_boot, gs201_aoc_rails) must be
# blacklisted from autoload (/etc/modprobe.d/omamobile-aoc-bringup.conf).
#
# Usage:
#   tools/aoc-stage [options] STAGE
#
# Stages (in order; each needs the previous one to have passed):
#   c2   read-only: load the three AoC modules (probing touches no AoC
#        register), then: aoc_req and its acknowledge, the GSA's AoC state
#        (mailbox command 91), chip id, the GSA S2MPU's CTRL0 (under a GSA
#        wakelock), the carve-out in /proc/iomem; and, only if BLK_AOC is
#        already on, the AoC System MMU registers and the AoC S2MPU's CTRL0
#   c2p  as c2, but first ask the APM to power BLK_AOC (aoc_req = 1), the
#        one write in the step. Only if c2 found BLK_AOC off.
#   c3   read-only: the S2MPG12/13 chip ids and the five AoC LDOs over ACPM
#   c4a  load: copy aoc.bin to the phone if missing, write the hang marker,
#        then load (power, AoC S2MPU off, System MMU windows, body into the
#        carve-out, GSA authentication, boot parameters). The AoC stays in
#        reset: the GSA state must become "loaded".
#   c4b  start: GSA_AOC_START over the mailbox, wait for the firmware's
#        control block, list the services; clears the hang marker on success
#   stop GSA_AOC_SHUTDOWN (back to "loaded")
#   diag read-only, registers already read fine on the phone: info, the
#        AoC S2MPU's CTRL0 and the System MMU (kernel log), the control block
#   ramdump  read-only, not yet tried: hex dump of the ramdump header
#        (carve-out + 32 MiB, boot breadcrumbs) and of the IPC area
#   release  GSA_AOC_RELEASE_RESET (5): only after a start that left GSA
#        state 4 without a control block (AOC-PLAN.md C4b-2)
#   trusty   load Trusty (trusty_core, trusty_log, trusty_ipc, then
#        trusty_virtio) and check /dev/trusty-ipc-dev0; needs the /trusty node
#        (overlay fingerprint-trusty). Before c2 --trusty.
#   gsa      load gsa alone (probe masks the GSA mailbox interrupts, nothing
#        else), then read sjtag_status and, through Trusty, aoc_state_tz.
#        After trusty. Needs no AoC node (raven R1, device/raven/AUDIO-PLAN.md)
#   mbox     read-only: the three AoC mailboxes (AP side), in the kernel log
#   cycle    raven: toggle aoc_req (0, then 1). Its acknowledge comes back,
#        but it doesn't power BLK_AOC (PMU custom words unchanged, R2.1e;
#        BLK_AOC stays off, R2.1f): use pd for that. After c2; the AoC must
#        be inactive.
#   tzpc     withdrawn: the D_TZPC_AOC SMC hung the SoC both as a restore
#        (R2.1c) and as a save (R2.1d), most likely EL3 touching the
#        powered-off block. pd is what makes BLK_AOC reachable (R2.1g); the
#        stage refuses to run.
#   pmu      read-only: the AoC's PMU handshake words (custom out/in), through
#        the kernel's PMU regmap. After c2.
#   bus0     read-only: CMU_BUS0's Q-channels for the AP's ports into the GSA
#        (reference) and BLK_AOC, each logged before it is read. After c2.
#   pd       raven: switch BLK_AOC's power domain (PMU AOC_CONFIGURATION, through
#        the kernel regmap) on, or off with PD=0, and wait for AOC_STATUS.
#   core     raven R3: the AoC through aoc_core, as cheetah's omamobile-aoc-start
#        does it without its rails step (raven's sensor rails are DT
#        regulators): Trusty, gsa, the AoC drivers in cheetah's order, then
#        aoc.bin through aoc_core's firmware file; waits for the services.
#        Fresh boot only, never with gs201_aoc_boot loaded.
#   s2mpu    read-only: the AoC S2MPU's CTRL0 alone. On raven it reads the
#        PMU first and refuses unless AOC_STATUS says BLK_AOC is on (run pd
#        first): a read of the powered-off block aborts the SoC (R2.1f/g)
#   rails    turn the five AoC LDOs on (gs201_aoc_rails enable=1; stock
#        voltages, never changed). Before c4a, for C4b-3.
#
# Options:
#   --watchdog   arm the hardware watchdog (about 15 s) with a feeder loop on the
#                phone; a hang then resets the phone by itself
#   --trusty     c2: AoC state commands through Trusty's hwmgr.aoc (gsa
#                without aoc_cmd_mbox); run the trusty stage first
#   --fw FILE    aoc.bin to copy for c4a (default: the extracted stock vendor one;
#                raven: ~/android/vendor-firmware-raven, from extract-vendor-firmware -d raven -o)
#   --pstore     after a watchdog reset: save /sys/fs/pstore
#
# Never use tools/devmem (/usr/local/bin/devmem on the phone) for any of this:
# its usage is "devmem ADDRESS [VALUE]" and a second argument WRITES.

set -uo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
SSH="$ROOT/tools/phone-ssh"
LOGDIR="$ROOT/logs"
FW=
DBG=/sys/kernel/debug/aoc
GSADBG=/sys/kernel/debug/17c90000.gsa
MARKER=/var/lib/omamobile/aoc-bringup-started

watchdog=0 stage= pstore=0 trusty=0

usage() { sed -n '/^# Usage:/,/^#   --pstore/p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }
say() { printf '\e[1m==> %s\e[0m\n' "$*"; }
warn() { printf '\e[33m==> %s\e[0m\n' "$*"; }
die() { printf '\e[31merror:\e[0m %s\n' "$*" >&2; exit 1; }

while (($#)); do
  case "$1" in
    --watchdog) watchdog=1 ;;
    --fw) FW="${2:?}"; shift ;;
    --trusty) trusty=1 ;;
    --pstore) pstore=1 ;;
    -h|--help) usage ;;
    c2|c2p|c3|c4a|c4b|stop|diag|ramdump|release|rails|trusty|gsa|mbox|cycle|tzpc|s2mpu|pmu|bus0|pd|core) stage="$1" ;;
    *) usage 1 ;;
  esac
  shift
done
# Before anything reaches the phone
[[ $stage == tzpc ]] && die "tzpc is withdrawn: the D_TZPC_AOC SMC hung the SoC as a restore and as a save (device/raven/AUDIO-PLAN.md R2.1c/d); run pd to make BLK_AOC reachable (R2.1g)"

mkdir -p "$LOGDIR"
stamp=$(date +%Y%m%d-%H%M%S)

phone() { timeout 60 "$SSH" -o ServerAliveInterval=2 -o ServerAliveCountMax=3 "$@"; }
mark() { phone "echo 'aoc-stage: $*' > /dev/kmsg"; }

if ((pstore)); then
  out="$LOGDIR/aoc-pstore-$stamp"
  mkdir -p "$out"
  phone 'ls -l /sys/fs/pstore/' || die "phone not reachable"
  for f in $(phone 'ls /sys/fs/pstore/'); do
    phone "cat /sys/fs/pstore/$f" > "$out/$f"
  done
  say "saved to $out"
  grep -h 'aoc\|gsa\|sysmmu' "$out"/console-* 2>/dev/null | tail -20
  exit 0
fi

[[ -n "$stage" ]] || usage 1
log="$LOGDIR/aoc-$stamp-$stage.log"

say "phone check"
phone 'uname -r' || die "phone not reachable over $SSH"
if phone 'grep -q gs101-raven /sys/firmware/devicetree/base/compatible'; then
  device=raven AOCNODE=aoc@175d0000
  : "${FW:=$HOME/android/vendor-firmware-raven/usr/lib/firmware/updates/aoc.bin}"
  [[ $stage == c3 || $stage == rails ]] && die "raven has no $stage stage: its AoC rails are DT regulators"
else
  device=cheetah AOCNODE=aoc@181d0000
  : "${FW:=$HOME/android/omamobile/vendor/google/cheetah/proprietary/vendor/firmware/aoc.bin}"
fi
say "device: $device"
# These switch power domains and call EL3 on raven's AoC; cheetah's AoC
# has its own path, and cycle would power its BLK_AOC down
case $stage in
  cycle|tzpc|pd|s2mpu) [[ $device == raven ]] || die "$stage is a raven stage (device/raven/AUDIO-PLAN.md R2), not for $device" ;;
esac
# trusty and gsa need no AoC node: they are the first steps on a new SoC
[[ $stage == trusty || $stage == gsa ]] ||
phone "grep -q okay /sys/firmware/devicetree/base/soc@0/$AOCNODE/status 2>/dev/null" ||
  die "the running DTB has no enabled AoC node: push the aoc-boot-test overlay first (AOC-PLAN.md 7)"

say "streaming the phone's kernel log to $log"
{
  echo "# aoc-stage $stamp stage=$stage watchdog=$watchdog"
  "$SSH" -T -o ServerAliveInterval=1 -o ServerAliveCountMax=5 'exec cat /dev/kmsg' 2>&1 |
  while IFS= read -r line; do printf '%s %s\n' "$(date +%T.%3N)" "$line"; done
  echo "# $(date +%T.%3N) log stream ended (connection closed or phone gone)"
} >> "$log" &
logger=$!
# The stream's ssh is a child of the subshell: kill it too, or it keeps
# the tool's stdout open and a caller's pipe never ends
stop_logger() { pkill -P "$logger" 2>/dev/null; kill "$logger" 2>/dev/null; }
trap stop_logger EXIT
sleep 2
mark "start $stage" || die "phone stopped answering before the test"

if ((watchdog)); then
  say "arming the hardware watchdog (feeder every 2 s)"
  phone 'nohup sh -c "exec 3>/dev/watchdog0
    trap \"printf V >&3; exit 0\" TERM
    while :; do printf k >&3; sleep 2; done" >/dev/null 2>&1 &
    echo $! > /run/aoc-wd.pid' || warn "could not arm the watchdog"
fi

# Load the three modules once; aoc_cmd_mbox: AoC state commands on the GSA
# mailbox (C1 showed command 91 answers); s2mpu_probe: GSA S2MPU CTRL0 in debugfs.
if ((trusty)); then mb=N; mbp=0; else mb=Y; mbp=1; fi
load_modules='if lsmod | grep -q "^gsa "; then
    grep -q '$mb' /sys/module/gsa/parameters/aoc_cmd_mbox || { lsmod | grep -q "^gs201_aoc_boot " || rmmod gsa; };
  fi;
  lsmod | grep -q "^gsa " || modprobe gsa aoc_cmd_mbox='$mbp' s2mpu_probe=1;
  grep -q '$mb' /sys/module/gsa/parameters/aoc_cmd_mbox || echo "gsa is loaded in the other aoc_cmd_mbox mode: reboot";
  lsmod | grep -q "^gs201_aoc_sysmmu " || modprobe gs201_aoc_sysmmu;
  lsmod | grep -q "^gs201_aoc_boot " || modprobe gs201_aoc_boot;
  test -d '$DBG' && echo modules-ok'
readout="cat $DBG/info; echo; cat $GSADBG/s2mpu_ctrl0;
  awk '/System RAM/ { split(\$1, a, \"-\"); s = strtonum(\"0x\" a[1]); e = strtonum(\"0x\" a[2]);
    if (s <= 0x96ffffff && e >= 0x94000000) { print \"carve-out OVERLAPS System RAM: \" \$0; bad = 1 } }
    END { if (!bad) print \"carve-out 94000000-96ffffff: not System RAM\" }' /proc/iomem"

result=ok
case "$stage" in
  c2|c2p)
    mark "about to load gsa, gs201_aoc_sysmmu, gs201_aoc_boot (no AoC register is touched)"
    phone "$load_modules" | tee -a "$log" | grep -c modules-ok >/dev/null || result=fail
    if [[ $stage == c2p ]]; then
      mark "about to request BLK_AOC power (aoc_req = 1)"
      phone "echo 1 > $DBG/power; echo power-exit=\$?" | tee -a "$log" || result=fail
    fi
    mark "about to read aoc_req, the GSA AoC state, chip id, GSA S2MPU CTRL0 (wakelock)"
    phone "$readout" | tee -a "$log" || result=fail
    if [[ $device == raven ]]; then
      # R2.1 (AUDIO-PLAN.md): the AoC S2MPU's CTRL0 aborted with BLK_AOC on
      warn "raven: not reading blk (the AoC S2MPU read aborts the SoC)"
    else
      mark "about to read the AoC System MMU and AoC S2MPU, only if BLK_AOC is on"
      phone "cat $DBG/blk" | tee -a "$log" || result=fail
    fi
    ;;
  c3)
    mark "about to load gs201_aoc_rails (reads only)"
    phone 'lsmod | grep -q "^gs201_aoc_rails " && rmmod gs201_aoc_rails;
      modprobe gs201_aoc_rails; echo modprobe-exit=$?; rmmod gs201_aoc_rails' | tee -a "$log" || result=fail
    ;;
  c4a)
    phone "test -d $DBG" || die "run c2 first"
    want=$(sha256sum < "$FW" | cut -d' ' -f1)
    got=$(phone 'sha256sum < /usr/lib/firmware/updates/aoc.bin 2>/dev/null | cut -d" " -f1')
    if [[ "$want" != "$got" ]]; then
      say "copying $(basename "$FW") to /usr/lib/firmware/updates/aoc.bin"
      phone 'mkdir -p /usr/lib/firmware/updates && cat > /usr/lib/firmware/updates/aoc.bin' < "$FW" ||
        die "copy failed"
    fi
    phone "test -e $MARKER" && die "$MARKER exists: an earlier load or start never finished. Reboot, then remove it by hand."
    phone "mkdir -p ${MARKER%/*} && date > $MARKER && sync"
    mark "about to load aoc.bin (power, S2MPU, System MMU windows, carve-out, GSA authentication)"
    phone "echo aoc.bin > $DBG/load; echo load-exit=\$?; cat $DBG/info" | tee -a "$log" || result=fail
    ;;
  c4b)
    phone "test -e $MARKER" || warn "no hang marker: was c4a run in this boot?"
    mark "about to start the AoC (GSA_AOC_START on the mailbox)"
    phone "echo 1 > $DBG/start; echo start-exit=\$?; cat $DBG/info; cat $DBG/control" | tee -a "$log" || result=fail
    sleep 3
    phone "dmesg | grep -c 'blocked' ; cat $DBG/info" | tee -a "$log" || result=fail
    [[ $result == ok ]] && phone "rm -f $MARKER; sync"
    ;;
  trusty)
    phone 'grep -q okay /sys/firmware/devicetree/base/trusty/status 2>/dev/null' ||
      die "the /trusty node is not enabled: add the fingerprint-trusty overlay"
    mark "about to load trusty_core (first calls into the secure world)"
    phone 'modprobe trusty_core; echo modprobe-exit=$?; dmesg | grep -i "trusty" | tail -3' | tee -a "$log" || result=fail
    mark "about to load trusty_log, trusty_ipc, trusty_virtio"
    phone 'modprobe trusty_log; modprobe trusty_ipc && modprobe trusty_virtio; sleep 1;
      ls -l /dev/trusty-ipc-dev0; dmesg | grep -iE "trusty|virtio" | tail -6' | tee -a "$log" || result=fail
    ;;
  gsa)
    phone 'test -e /dev/trusty-ipc-dev0' || die "run the trusty stage first"
    mark "about to load gsa (probe masks the GSA mailbox interrupts)"
    phone "modprobe gsa; echo modprobe-exit=\$?; dmesg | grep -i gsa | tail -3;
      cat $GSADBG/sjtag_status; cat $GSADBG/aoc_state_tz" | tee -a "$log" || result=fail
    ;;
  cycle)
    phone "test -d $DBG" || die "run c2 first"
    phone "grep -q 'state 0' $GSADBG/aoc_state_tz" || die "the AoC is not inactive: not cycling BLK_AOC"
    mark "about to power BLK_AOC down (aoc_req = 0)"
    phone "echo 0 > $DBG/power; echo power0-exit=\$?; cat $DBG/info" | tee -a "$log" || result=fail
    mark "about to power BLK_AOC up (aoc_req = 1)"
    out=$(phone "echo 1 > $DBG/power; echo power1-exit=\$?; cat $DBG/info" | tee -a "$log") || result=fail
    echo "$out"
    [[ $out == *power1-exit=0* ]] || result=fail
    ;;
  core)
    [[ $device == raven ]] || die "core is raven's R3 (cheetah: omamobile-aoc-start)"
    phone 'lsmod | grep -q "^gs201_aoc_boot "' && die "gs201_aoc_boot is loaded: reboot first (it owns the AoC node)"
    phone 'test -e /usr/lib/firmware/updates/aoc.bin' || die "no aoc.bin on the phone (run c4a once, or copy it)"
    node=/sys/bus/platform/devices/175d0000.aoc
    mark "about to load Trusty, gsa and the AoC drivers (aoc_core path)"
    phone "for m in trusty_core trusty_log trusty_ipc trusty_virtio gsa gs201_aoc_sysmmu mailbox_wc aoc_core aoc_channel_dev aoc_alsa_dev aoc_char_dev; do
        modprobe \$m || echo modprobe-fail=\$m; done; ls $node/firmware && echo core-bound" | tee -a "$log" | grep -c core-bound >/dev/null || result=fail
    if [[ $result == ok ]]; then
      mark "about to load aoc.bin through aoc_core"
      phone "echo aoc.bin > $node/firmware; echo fw-exit=\$?;
        for i in \$(seq 75); do grep -q '^Services : [1-9]' $node/services 2>/dev/null && break; sleep 0.2; done;
        head -1 $node/services; cat $node/revision 2>/dev/null | head -1; ls /dev/acd-* 2>/dev/null | wc -l;
        cat /proc/asound/cards" | tee -a "$log" || result=fail
    fi
    ;;
  pd)
    phone "test -e $DBG/pd" || die "run c2 first (and a kernel with the pd file)"
    mark "about to switch BLK_AOC's power domain to ${PD:-1}"
    phone "echo ${PD:-1} > $DBG/pd; echo pd-exit=\$?; cat $DBG/pmu; dmesg | grep blkpwr_aoc | tail -1" | tee -a "$log" || result=fail
    ;;
  bus0)
    phone "test -e $DBG/bus0" || die "run c2 first (and a kernel with the bus0 file)"
    mark "about to read CMU_BUS0's AoC and GSA Q-channels"
    phone "cat $DBG/bus0" | tee -a "$log" || result=fail
    ;;
  pmu)
    phone "test -e $DBG/pmu" || die "run c2 first (and a kernel with the pmu file)"
    mark "about to read the AoC's PMU words (kernel regmap)"
    phone "cat $DBG/pmu; cat $DBG/info" | tee -a "$log" || result=fail
    ;;
  s2mpu)
    phone "test -e $DBG/s2mpu" || die "run c2 first (and a kernel with the s2mpu file)"
    phone "test -e $DBG/pmu" || die "no pmu file: needs a kernel with it (the s2mpu read needs AOC_STATUS first)"
    # Read just before the S2MPU, so the answer can't be stale
    pmu=$(phone "cat $DBG/pmu" | tee -a "$log")
    st=$(sed -n 's/^pmu aoc configuration [0-9a-fx]* status \(0x[0-9a-f]*\|0\)$/\1/p' <<<"$pmu")
    [[ -n $st ]] || die "can't read AOC_STATUS from $DBG/pmu"
    (( st & 1 )) || die "BLK_AOC is off (AOC_STATUS $st): run pd first; the AoC S2MPU read of a powered-off block aborts the SoC (AUDIO-PLAN.md R2.1f/g)"
    mark "about to read the AoC S2MPU CTRL0 (one register)"
    phone "cat $DBG/s2mpu" | tee -a "$log" || result=fail
    ;;
  mbox)
    phone "test -d $DBG" || die "run c2 first"
    mark "about to read the AoC mailboxes (reads only)"
    phone "cat $DBG/mbox" | tee -a "$log" || result=fail
    ;;
  diag)
    phone "test -d $DBG" || die "run c2 first"
    mark "diagnostics (reads only)"
    phone "cat $DBG/info; cat $DBG/blk; cat $DBG/control" | tee -a "$log" || result=fail
    ;;
  ramdump)
    phone "test -d $DBG" || die "run c2 first"
    mark "about to read the ramdump header (carve-out + 32 MiB) and the IPC area"
    phone "cat $DBG/ramdump" | tee -a "$log" || result=fail
    ;;
  release)
    phone "test -d $DBG" || die "run c2 first"
    mark "about to send GSA_AOC_RELEASE_RESET (5)"
    phone "echo 5 > $DBG/cmd; echo release-exit=\$?; cat $DBG/info; cat $DBG/control" | tee -a "$log" || result=fail
    phone "dmesg | grep -c 'blocked'" | tee -a "$log" || result=fail
    ;;
  rails)
    mark "about to turn the AoC LDOs on (enable bits only)"
    phone 'lsmod | grep -q "^gs201_aoc_rails " && rmmod gs201_aoc_rails;
      modprobe gs201_aoc_rails enable=1; echo modprobe-exit=$?; rmmod gs201_aoc_rails;
      modprobe gs201_aoc_rails; rmmod gs201_aoc_rails' | tee -a "$log" || result=fail
    ;;
  stop)
    mark "about to shut the AoC down (GSA_AOC_SHUTDOWN)"
    phone "echo 1 > $DBG/shutdown; echo stop-exit=\$?; cat $DBG/info" | tee -a "$log" || result=fail
    ;;
esac

sleep 2
alive=0
phone 'true' && alive=1
if ((alive)); then
  say "phone alive"
  if ((watchdog)); then
    phone 'kill $(cat /run/aoc-wd.pid) && rm /run/aoc-wd.pid' ||
      warn "could not stop the watchdog feeder: the phone resets in about 15 s unless /dev/watchdog0 is fed"
  fi
else
  result=hang
  warn "PHONE NOT ANSWERING: the last kernel lines that reached the laptop are below."
  if ((watchdog)); then
    warn "Wait about 15 s for the watchdog reset; after boot run: $0 --pstore"
  else
    warn "Recover by holding Power about 30 s (a cold reset; pstore will be empty)."
  fi
fi

sleep 1
stop_logger
trap - EXIT

echo
say "summary ($log): $result"
sed -n "/aoc-stage: start $stage/,\$p" "$log" |
  grep -E 'aoc|gsa|sysmmu|s2mpu|S2MPU|rails|LDO|CHIPID|blocked|-exit|watchdog|crumbs|ipc|pcu' |
  sed -E 's/^([0-9:.]+) [0-9]+,[0-9]+,[0-9]+,[^;]*;/\1 /' | tail -80
