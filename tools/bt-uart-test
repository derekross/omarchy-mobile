#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
#
# bt-uart-test: gate BT1 of device/cheetah/BLUETOOTH-PLAN.md. Runs ON THE
# PHONE, with the bt-uart-test overlay (APM USI1 UART up as a plain tty, no
# Bluetooth driver bound). Python standard library only, so nothing to install.
# Stream it from the laptop:
#
#   tools/phone-ssh python3 - loop      < tools/bt-uart-test
#   tools/phone-ssh python3 - hci       < tools/bt-uart-test
#
# Commands:
#   loop [--tty T]          UART internal loopback (TIOCM_LOOP) at 115200 and
#                           3000000: proves the UART IP, its pclk and its IRQ.
#                           The chip stays off.
#   hci [--tty T] [--baud B] [--on-ms MS] [--wake BANK:LINE]
#                           power the BCM4389 BT core (BT_DEV_WAKE high, then
#                           BT_REG_ON high), send HCI_Reset, Read Local Version
#                           and Broadcom Read Verbose Config, print the answers,
#                           then BT_REG_ON low again. Proves the pins, the baud
#                           clock (115200 is the chip's power-on rate) and RTS/CTS.
#                           --wake: BT_DEV_WAKE's bank and line; by default
#                           the board's own, from its compatible (cheetah
#                           gpp16:3, raven gpp14:3). Another board needs
#                           --wake: the tool refuses to guess a pin.
#   patch FILE [--tty T] [--wake BANK:LINE] [--oper-baud B]
#                           power the BT core as hci does, then download the
#                           .hcd patch raw: Download Minidriver, every Write
#                           RAM record streamed with RTS/CTS and no per-record
#                           wait (the stock HAL's "fast download"), Launch RAM,
#                           and Read Local Version again. Separates the chip's
#                           download protocol from the kernel's btbcm path.
#                           The file must be Write RAM records (0xfc4c) ending
#                           in one Launch RAM (0xfc4e), or nothing is powered.
#                           --oper-baud: switch host and chip to this rate
#                           (BCM 0xfc18) before the download, as btbcm does;
#                           default 115200, the power-on rate (no switch).
#   gpio                    print which gpiochip carries gpp16 (no line changes)
#
# Every step prints before it touches anything. Nothing here reads or writes
# CMU or PMU registers; the only hardware it drives is the tty and two GPIOs.

import array
import fcntl
import os
import select
import struct
import sys
import termios
import time

DEF_TTY = "/dev/ttySAC0"
BT_BANK = "gpp16"
BT_REG_ON = 2      # gpp16-2, active high
BT_DEV_WAKE = 3    # gpp16-3, active high
# BT_DEV_WAKE per board (first compatible). BT_REG_ON is gpp16-2 on both.
# On raven gpp16-3 is a USI8 pin: driving cheetah's line there is wrong.
WAKE_BY_BOARD = {
    "google,gs201-cheetah": f"{BT_BANK}:{BT_DEV_WAKE}",
    "google,gs101-raven": "gpp14:3",
}


def board():
    try:
        with open("/proc/device-tree/compatible", "rb") as f:
            return f.read().split(b"\0")[0].decode()
    except OSError:
        return ""


def say(msg):
    print("==> " + msg, flush=True)


def die(msg):
    print("error: " + msg, file=sys.stderr, flush=True)
    sys.exit(1)


# ---- ioctl numbers (asm-generic, arm64) ------------------------------------

def _ioc(direction, typ, nr, size):
    return (direction << 30) | (size << 16) | (typ << 8) | nr


def _iowr(typ, nr, size):
    return _ioc(3, typ, nr, size)


def _ior(typ, nr, size):
    return _ioc(2, typ, nr, size)


TIOCM_LOOP = 0x8000
TIOCM_RTS = 0x004
TIOCMBIS = 0x5416
TIOCMBIC = 0x5417
TIOCMGET = 0x5415

# <linux/gpio.h> character device, uAPI v2
GPIO_GET_CHIPINFO_IOCTL = _ior(0xB4, 0x01, 68)
GPIO_V2_LINE_REQUEST_SIZE = 592
GPIO_V2_GET_LINE_IOCTL = _iowr(0xB4, 0x07, GPIO_V2_LINE_REQUEST_SIZE)
GPIO_V2_LINE_SET_VALUES_IOCTL = _iowr(0xB4, 0x0F, 16)
GPIO_V2_LINE_FLAG_OUTPUT = 1 << 3
GPIO_V2_LINE_ATTR_ID_OUTPUT_VALUES = 2

BAUD = {115200: termios.B115200, 921600: termios.B921600,
        3000000: termios.B3000000}


# ---- tty --------------------------------------------------------------------

def open_tty(path, baud, rtscts):
    if baud not in BAUD:
        die(f"unsupported baud {baud}")
    say(f"open {path} raw 8N1 {baud} rtscts={int(rtscts)}")
    fd = os.open(path, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
    attr = termios.tcgetattr(fd)
    attr[0] = 0                                   # iflag
    attr[1] = 0                                   # oflag
    attr[2] = termios.CS8 | termios.CREAD | termios.CLOCAL
    if rtscts:
        attr[2] |= termios.CRTSCTS
    attr[3] = 0                                   # lflag
    attr[4] = attr[5] = BAUD[baud]
    attr[6][termios.VMIN] = 0
    attr[6][termios.VTIME] = 0
    termios.tcsetattr(fd, termios.TCSANOW, attr)
    termios.tcflush(fd, termios.TCIOFLUSH)
    return fd


def set_baud(fd, baud):
    attr = termios.tcgetattr(fd)
    attr[4] = attr[5] = BAUD[baud]
    termios.tcsetattr(fd, termios.TCSANOW, attr)


def mctrl(fd, req, bits):
    fcntl.ioctl(fd, req, struct.pack("I", bits))


def read_exact(fd, n, timeout):
    buf = b""
    end = time.monotonic() + timeout
    while len(buf) < n:
        left = end - time.monotonic()
        if left <= 0:
            break
        r, _, _ = select.select([fd], [], [], left)
        if r:
            buf += os.read(fd, n - len(buf))
    return buf


def hexs(b):
    return " ".join(f"{x:02x}" for x in b)


# ---- gpio (uAPI v2) ---------------------------------------------------------

def find_chip(label):
    for name in sorted(os.listdir("/dev")):
        if not name.startswith("gpiochip"):
            continue
        path = "/dev/" + name
        try:
            fd = os.open(path, os.O_RDWR)
        except OSError:
            continue
        buf = bytearray(68)
        fcntl.ioctl(fd, GPIO_GET_CHIPINFO_IOCTL, buf)
        chip_label = buf[32:64].split(b"\0")[0].decode()
        lines = struct.unpack_from("I", buf, 64)[0]
        if chip_label == label:
            return fd, path, lines
        os.close(fd)
    return None, None, 0


class Lines:
    """Request lines of one chip as outputs, initially low."""

    def __init__(self, chip_fd, offsets, consumer):
        req = bytearray(GPIO_V2_LINE_REQUEST_SIZE)
        struct.pack_into(f"{len(offsets)}I", req, 0, *offsets)
        req[256:256 + len(consumer)] = consumer.encode()
        # config: flags, num_attrs, padding, attrs[0] = output values all 0
        struct.pack_into("QI", req, 288, GPIO_V2_LINE_FLAG_OUTPUT, 1)
        struct.pack_into("IIQQ", req, 288 + 32,
                         GPIO_V2_LINE_ATTR_ID_OUTPUT_VALUES, 0, 0,
                         (1 << len(offsets)) - 1)
        struct.pack_into("I", req, 560, len(offsets))      # num_lines
        fcntl.ioctl(chip_fd, GPIO_V2_GET_LINE_IOCTL, req)
        self.fd = struct.unpack_from("i", req, 588)[0]
        self.offsets = offsets
        self.bits = 0

    def set(self, offset, value):
        i = self.offsets.index(offset)
        self.bits = (self.bits | (1 << i)) if value else (self.bits & ~(1 << i))
        vals = bytearray(struct.pack("QQ", self.bits, 1 << i))
        fcntl.ioctl(self.fd, GPIO_V2_LINE_SET_VALUES_IOCTL, vals)

    def close(self):
        os.close(self.fd)


# ---- commands -----------------------------------------------------------------

def cmd_loop(tty):
    fd = open_tty(tty, 115200, rtscts=False)
    ok = True
    try:
        say("set TIOCM_LOOP (UCON loopback: TX is fed back to RX inside the UART)")
        mctrl(fd, TIOCMBIS, TIOCM_LOOP)
        for baud in (115200, 3000000):
            set_baud(fd, baud)
            termios.tcflush(fd, termios.TCIOFLUSH)
            pattern = bytes(range(256))
            say(f"{baud}: write 256 bytes")
            os.write(fd, pattern)
            got = read_exact(fd, len(pattern), 2.0)
            if got == pattern:
                say(f"{baud}: PASS, 256 bytes back intact")
            else:
                ok = False
                say(f"{baud}: FAIL, got {len(got)} bytes; first: {hexs(got[:16])}")
    finally:
        mctrl(fd, TIOCMBIC, TIOCM_LOOP)
        os.close(fd)
    say("loopback " + ("PASS" if ok else "FAIL"))
    return 0 if ok else 1


def hci_cmd(fd, opcode, params=b"", timeout=2.0):
    pkt = bytes([0x01, opcode & 0xff, opcode >> 8, len(params)]) + params
    say(f"HCI cmd 0x{opcode:04x}: {hexs(pkt)}")
    os.write(fd, pkt)
    head = read_exact(fd, 3, timeout)
    if len(head) < 3:
        say(f"  no answer ({len(head)} bytes: {hexs(head)})")
        return None
    body = read_exact(fd, head[2], timeout)
    evt = head + body
    say(f"  event: {hexs(evt)}")
    if head[0] != 0x04 or head[1] != 0x0e or len(body) < 4:
        say("  not a Command Complete event")
        return None
    if body[1] | (body[2] << 8) != opcode:
        say("  Command Complete for another opcode")
        return None
    if body[3] != 0:
        say(f"  status 0x{body[3]:02x}")
        return None
    return body[3:]          # status + return parameters


class WakeLine:
    """BT_DEV_WAKE, in BT_REG_ON's bank or in its own."""

    def __init__(self, lines, wake_lines, offset):
        self.lines, self.wake_lines, self.offset = lines, wake_lines, offset

    def set(self, value):
        (self.wake_lines or self.lines).set(self.offset, value)


def cmd_hci(tty, baud, on_ms, wake):
    wake_bank, wake_line = wake.split(":")
    wake_line = int(wake_line)
    chip_fd, path, _ = find_chip(BT_BANK)
    if chip_fd is None:
        die(f"no gpiochip labelled {BT_BANK}: is the PERIC0 pin controller enabled?")
    wake_fd = wake_lines = None
    if wake_bank == BT_BANK:
        say(f"{BT_BANK} is {path}; request lines {BT_REG_ON} (BT_REG_ON) and "
            f"{wake_line} (BT_DEV_WAKE) as outputs, low")
        lines = Lines(chip_fd, [BT_REG_ON, wake_line], "bt-uart-test")
    else:
        wake_fd, wake_path, _ = find_chip(wake_bank)
        if wake_fd is None:
            die(f"no gpiochip labelled {wake_bank}")
        say(f"{BT_BANK} is {path} (line {BT_REG_ON}, BT_REG_ON), {wake_bank} is "
            f"{wake_path} (line {wake_line}, BT_DEV_WAKE); outputs, low")
        lines = Lines(chip_fd, [BT_REG_ON], "bt-uart-test")
        wake_lines = Lines(wake_fd, [wake_line], "bt-uart-test")
    dev_wake = WakeLine(lines, wake_lines, wake_line)
    fd = open_tty(tty, baud, rtscts=True)
    rc = 1
    try:
        say("BT_DEV_WAKE high (keep the controller awake)")
        dev_wake.set(1)
        say("BT_REG_ON high (power the BT core); Wi-Fi's WL_REG_ON is not touched")
        lines.set(BT_REG_ON, 1)
        time.sleep(on_ms / 1000)
        junk = read_exact(fd, 64, 0.1)
        if junk:
            say(f"bytes after power-on (ignored): {hexs(junk)}")
        termios.tcflush(fd, termios.TCIFLUSH)

        if hci_cmd(fd, 0x0c03) is None:              # HCI_Reset
            say("HCI_Reset FAIL. If 0 bytes: check RTS/CTS (try --baud 3000000 "
                "only if the chip was left running), BT_REG_ON, the baud clock")
            return 1
        say("HCI_Reset PASS")

        ver = hci_cmd(fd, 0x1001)                    # Read Local Version
        if ver and len(ver) >= 9:
            hci_ver, hci_rev, lmp_ver, manuf, subver = struct.unpack_from("<BHBHH", ver, 1)
            say(f"version: HCI {hci_ver} rev 0x{hci_rev:04x} LMP {lmp_ver} "
                f"manufacturer {manuf} LMP subversion 0x{subver:04x} "
                f"({(subver >> 13) & 7}.{(subver >> 8) & 0x1f}.{subver & 0xff})")

        cfg = hci_cmd(fd, 0xfc79)                    # BCM Read Verbose Config
        if cfg and len(cfg) >= 2:
            say(f"BCM chip id {cfg[1]} (btbcm prints this as 'BCM: chip id')")
        rc = 0
    finally:
        say("BT_REG_ON low, BT_DEV_WAKE low")
        lines.set(BT_REG_ON, 0)
        dev_wake.set(0)
        lines.close()
        os.close(chip_fd)
        if wake_lines:
            wake_lines.close()
            os.close(wake_fd)
        os.close(fd)
    say("hci " + ("PASS" if rc == 0 else "FAIL"))
    return rc


def set_baud(fd, baud):
    attrs = termios.tcgetattr(fd)
    speed = getattr(termios, f"B{baud}")
    attrs[4] = attrs[5] = speed
    termios.tcsetattr(fd, termios.TCSADRAIN, attrs)


HCD_WRITE_RAM, HCD_LAUNCH_RAM = 0xfc4c, 0xfc4e


def read_hcd(hcd):
    """The .hcd's HCI command records, checked before the chip is touched."""
    try:
        data = open(hcd, "rb").read()
    except OSError as e:
        die(f"{hcd}: {e.strerror}")
    records, i = [], 0
    while i < len(data):
        if i + 3 > len(data) or i + 3 + data[i + 2] > len(data):
            die(f"{hcd}: truncated record at byte {i}: not an .hcd patch")
        records.append(data[i:i + 3 + data[i + 2]])
        i += 3 + data[i + 2]
    if len(records) < 2:
        die(f"{hcd}: {len(records)} records: not an .hcd patch")
    ops = [r[0] | r[1] << 8 for r in records]
    if ops[-1] != HCD_LAUNCH_RAM:
        die(f"{hcd}: last record is 0x{ops[-1]:04x}, not Launch RAM (0x{HCD_LAUNCH_RAM:04x})")
    bad = [n for n, op in enumerate(ops[:-1]) if op != HCD_WRITE_RAM]
    if bad:
        die(f"{hcd}: record {bad[0]} is 0x{ops[bad[0]]:04x}, not Write RAM (0x{HCD_WRITE_RAM:04x})")
    return records


def cmd_patch(tty, hcd, wake, oper):
    records = read_hcd(hcd)
    say(f"{hcd}: {len(records) - 1} Write RAM records and Launch RAM")
    if not hasattr(termios, f"B{oper}"):
        die(f"--oper-baud {oper}: not a rate this host's termios knows")
    wake_bank, wake_line = wake.split(":")
    wake_line = int(wake_line)
    chip_fd, path, _ = find_chip(BT_BANK)
    if chip_fd is None:
        die(f"no gpiochip labelled {BT_BANK}: is the PERIC0 pin controller enabled?")
    wake_fd, wake_path, _ = find_chip(wake_bank)
    if wake_fd is None:
        os.close(chip_fd)
        die(f"no gpiochip labelled {wake_bank}")
    say(f"{BT_BANK} is {path} (line {BT_REG_ON}, BT_REG_ON), {wake_bank} is "
        f"{wake_path} (line {wake_line}, BT_DEV_WAKE); outputs, low")
    lines = Lines(chip_fd, [BT_REG_ON], "bt-uart-test")
    wake_lines = Lines(wake_fd, [wake_line], "bt-uart-test")
    fd = open_tty(tty, 115200, rtscts=True)
    rc = 1
    try:
        say("BT_DEV_WAKE high (keep the controller awake)")
        wake_lines.set(wake_line, 1)
        say("BT_REG_ON high (power the BT core); Wi-Fi's WL_REG_ON is not touched")
        lines.set(BT_REG_ON, 1)
        time.sleep(0.2)
        termios.tcflush(fd, termios.TCIFLUSH)
        if hci_cmd(fd, 0x0c03) is None:
            say("HCI_Reset FAIL")
            return 1
        ver = hci_cmd(fd, 0x1001)
        if ver and len(ver) >= 9:
            say(f"before: HCI rev 0x{struct.unpack_from('<H', ver, 2)[0]:04x} LMP subversion 0x{struct.unpack_from('<H', ver, 7)[0]:04x}")
        if oper != 115200:
            # BCM Update UART Baud Rate: 2 bytes 0, then the rate (LE32)
            if hci_cmd(fd, 0xfc18, b"\x00\x00" + struct.pack("<I", oper)) is None:
                say("Update baud rate FAIL")
                return 1
            set_baud(fd, oper)
            time.sleep(0.01)
            say(f"host and chip at {oper}")
            if hci_cmd(fd, 0x1001) is None:
                say("Read Local Version at the new rate FAIL")
                return 1
        if hci_cmd(fd, 0xfc2e) is None:                # Download Minidriver
            say("Download Minidriver FAIL")
            return 1
        time.sleep(0.05)
        t0, answers = time.time(), 0
        for rec in records[:-1]:
            buf = b"\x01" + rec
            while buf:
                select.select([], [fd], [], 1.0)
                try:
                    buf = buf[os.write(fd, buf):]
                except BlockingIOError:
                    pass
            answers += len(read_exact(fd, 256, 0))
        termios.tcdrain(fd)
        say(f"{len(records) - 1} Write RAM records sent in {time.time() - t0:.1f} s, {answers} bytes came back meanwhile")
        time.sleep(0.1)
        termios.tcflush(fd, termios.TCIFLUSH)
        launch = records[-1]
        # the patch's Launch RAM reboots the chip at 115200

        os.write(fd, b"\x01" + launch)
        ev = read_exact(fd, 7, 2.0)
        say(f"Launch RAM answer: {hexs(ev) if ev else 'none'}")
        time.sleep(0.25)
        if oper != 115200:
            set_baud(fd, 115200)
        termios.tcflush(fd, termios.TCIFLUSH)
        if hci_cmd(fd, 0x0c03) is None:
            say("HCI_Reset after launch FAIL")
            return 1
        ver = hci_cmd(fd, 0x1001)
        if ver and len(ver) >= 9:
            say(f"after: HCI rev 0x{struct.unpack_from('<H', ver, 2)[0]:04x} LMP subversion 0x{struct.unpack_from('<H', ver, 7)[0]:04x}")
            rc = 0
    finally:
        say("BT_REG_ON low, BT_DEV_WAKE low")
        lines.set(BT_REG_ON, 0)
        wake_lines.set(wake_line, 0)
        lines.close()
        wake_lines.close()
        os.close(chip_fd)
        os.close(wake_fd)
        os.close(fd)
    say("patch " + ("PASS" if rc == 0 else "FAIL"))
    return rc


def cmd_gpio():
    chip_fd, path, lines = find_chip(BT_BANK)
    if chip_fd is None:
        die(f"no gpiochip labelled {BT_BANK}")
    os.close(chip_fd)
    say(f"{BT_BANK}: {path}, {lines} lines")
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print("usage: bt-uart-test loop|hci|patch FILE|gpio [--tty T] [--baud B] [--on-ms MS]\n"
              "       [--wake BANK:LINE] [--oper-baud B]\n"
              "(see the header of tools/bt-uart-test)")
        return 0
    cmd, args = argv[0], argv[1:]
    args_file = None
    if cmd == "patch":
        if not args:
            die("patch needs the .hcd file")
        args_file = args.pop(0)
    opts = {"--tty": DEF_TTY, "--baud": "115200", "--on-ms": "200",
            "--wake": None, "--oper-baud": "115200"}
    while args:
        key = args.pop(0)
        if key not in opts or not args:
            die(f"bad option {key}")
        opts[key] = args.pop(0)
    if cmd in ("hci", "patch") and opts["--wake"] is None:
        b = board()
        if b not in WAKE_BY_BOARD:
            die(f"no BT_DEV_WAKE default for board {b or 'unknown'}: give --wake BANK:LINE")
        opts["--wake"] = WAKE_BY_BOARD[b]
        say(f"{b}: BT_DEV_WAKE {opts['--wake']}")
    if cmd == "loop":
        return cmd_loop(opts["--tty"])
    if cmd == "patch":
        return cmd_patch(opts["--tty"], args_file, opts["--wake"], int(opts["--oper-baud"]))
    if cmd == "hci":
        return cmd_hci(opts["--tty"], int(opts["--baud"]), int(opts["--on-ms"]),
                       opts["--wake"])
    if cmd == "gpio":
        return cmd_gpio()
    die(f"unknown command {cmd}")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
