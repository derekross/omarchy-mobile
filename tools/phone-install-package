#!/bin/bash
# SPDX-License-Identifier: MIT
# Build one of our packages natively on the phone and install it with pacman.
#   tools/phone-install-package packages/omamobile-shell
# Until there's a package repository for `omarchy update`, this is how new
# versions reach the phone.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

dir=${1:?Usage: tools/phone-install-package packages/<name>}
name=$(basename "$dir")
[[ -f $dir/PKGBUILD ]] || { echo "No PKGBUILD in $dir" >&2; exit 1; }

ssh=${PHONE_SSH:-tools/phone-ssh}   # tests/phone-install-package stands in for the phone
# The phone's account: whoever is logged in on its screen (as tools/acpm-stage
# and tools/speaker-trip-burst find it), or PHONE_USER=<name>. makepkg runs
# as that user, in its home; no account name is built in.
phone_user=${PHONE_USER:-$("$ssh" "loginctl list-users --no-legend | awk '\$2 != \"root\" {print \$2; exit}'")}
[[ -n $phone_user ]] || { echo "No user is logged in on the phone: log in on its screen, or set PHONE_USER=<name>" >&2; exit 1; }
phone_home=$("$ssh" "getent passwd '$phone_user' | cut -d: -f6")
[[ -n $phone_home ]] || { echo "No account '$phone_user' on the phone" >&2; exit 1; }
build=$phone_home/build/pkgs

"$ssh" "rm -rf $build/$name && mkdir -p $build && chown '$phone_user': $build"
# makepkg's own work dirs (pkg/, src/ at the top) and old packages stay home.
tar cf - --exclude="./$name/pkg" --exclude="./$name/src/build" --exclude="*.pkg.tar.*" \
  -C "$(dirname "$dir")" "./$name" | "$ssh" "tar xf - -C $build --no-same-owner && chown -R '$phone_user': $build/$name"
# Build-only dependencies (makedepends, checkdepends) that aren't installed
# yet go in for the build and out again afterwards, like makepkg -s -r
# (makepkg runs as the user, so pacman runs here as root). Runtime
# depends are pacman -U's job below. Without this, qt6-tools stayed after a
# libcamera build and put four Qt developer apps in the phone's drawer.
srcinfo=$("$ssh" "su - '$phone_user' -c 'cd $build/$name && makepkg --printsrcinfo'")
want=$(awk '$1 ~ /^(depends|makedepends|checkdepends)$/ {print $3}' <<<"$srcinfo" | sort -u | tr '\n' ' ')
buildonly=$(awk '$1 ~ /^(makedepends|checkdepends)$/ {print $3}' <<<"$srcinfo" | sort -u | tr '\n' ' ')
# Each one goes to the phone's shell in single quotes: unquoted, a versioned
# one (omarchy>=4.0.6) was a redirect there, so pacman -T's answer went into
# a file named "=4.0.6" and the missing ones were never installed.
quoted() { printf "'%s' " "$@"; }
missing=""
[[ -n ${want// } ]] && missing=$("$ssh" "pacman -T $(quoted $want)" || true)
# pacman -T also names an installed package that is older than a version
# asks for. Updating it here would be a partial upgrade, --asdeps would make
# it a dependency, and a build-only one would be removed afterwards: that is
# the phone's own update to do.
old=""
if [[ -n $missing ]]; then
  installed=$("$ssh" "pacman -Qq")
  for dep in $missing; do
    grep -qx -- "${dep%%[<>=]*}" <<<"$installed" && old+="$dep "
  done
fi
[[ -z $old ]] || { echo "The phone's packages are older than ${old% } asks for: update it (omarchy update), then run this again" >&2; exit 1; }
if [[ -n $missing ]]; then
  echo "build dependencies: $(tr '\n' ' ' <<<"$missing")"
  "$ssh" "OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -S --needed --noconfirm --asdeps $(quoted $missing) >/dev/null"
fi
remove=""
for dep in $missing; do
  [[ " $buildonly " == *" $dep "* ]] && remove+="${dep%%[<>=]*} "
done
cleanup() {
  [[ -n $remove ]] && "$ssh" "OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -Rns --noconfirm $remove >/dev/null 2>&1 && echo 'removed build dependencies: $remove'"
  return 0
}
trap cleanup EXIT
"$ssh" "su - '$phone_user' -c 'cd $build/$name && makepkg -f --noconfirm' 2>&1 | tail -2"
"$ssh" "OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -U --noconfirm $build/$name/$name-*.pkg.tar.* 2>&1 | grep -E '^error|installing|upgrading|reinstalling' ; pacman -Q $name"
