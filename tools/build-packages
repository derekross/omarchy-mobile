#!/bin/bash
# SPDX-License-Identifier: MIT
# Build Omarchy Mobile's packages for aarch64 on this laptop, without a phone:
# makepkg in an Arch Linux ARM container (Docker + qemu-user, tools/lib/alarm.sh),
# then sign them and the database with the release key (keys/gnupg.release,
# tools/lib/signing.sh; docs/RELEASES.md §10), into the
# [omamobile] repository at out/repo/aarch64 (as tools/repo-build does with
# the phone as the builder). tools/build-rootfs puts that repository into the
# root image; tools/repo-push still copies it to a running phone.
#
#   tools/build-packages [options] [packages/<name>...]
#     (no names)     every package in packages/ except the slow ones below
#     --all          every package, the slow ones too
#     --force        rebuild even when out/repo has this version already
#     --nocheck      skip the package tests
#     --check-in-container
#                    run the PKGBUILDs' check() under emulation instead of the
#                    package's test/all natively on this laptop (the default:
#                    the tests are the same, and some time out under qemu)
#                    A package whose test/host-tools names a command this
#                    machine lacks runs its check() in the container anyway
#     --import DIR   copy prebuilt *.pkg.tar.{zst,xz} from DIR into the repository
#                    (for example Mesa from an earlier build), then sign it
#     --list         print what would be built and what is up to date
#     --resign       build nothing: sign every package in out/repo and the
#                    database again with the release key, replacing older
#                    signatures (from the original key, keys/gnupg). Then
#                    tools/repo-publish --no-build development publishes them
#     --local NAME   a contributor's build for device NAME (review lesson L-7):
#                    the repository is out/NAME/repo/aarch64, the signing key
#                    keys/NAME (tools/local-key-init), and the build image also
#                    trusts that key. Imported packages keep their own .sig
#                    (tools/fetch-published), so only what is built here
#                    carries the local key. Never the maintainer's keys/ or
#                    out/repo
#
# Upstream packages pinned in rootfs/packages.pinned (the Omarchy version
# our patches were checked against) are added by every maintainer's run: fetched
# once, checked against the SHA-256 listed there, and signed with the release
# key like our own; out/repo keeps them, and a line removed there takes its
# package out at the next run. A --local repository gets them from
# tools/fetch-published instead.
#
# Mesa, Hyprland and libcamera are large C/C++ builds: under qemu-user on a
# laptop they take hours (Mesa the longest). They're built only when named or
# with --all, and only once per version, since out/repo keeps them.
#
# linux-omamobile packs a kernel build instead of compiling one
# (docs/RELEASES.md §4). It is built only when named, never by default or
# with --all (so a prebuilt/ staged for a test is never published as a side
# effect), and only after `packages/linux-omamobile/stage --verify` confirms
# the staged build is a kernel-<date> tag on the published omamobile branch.
#
# A device package that ships boot files (its install reads
# OMAMOBILE_BOOT_FILES) refuses to build without its boot-files/; before it
# is built here, tools/stage-boot-files --check must find them matching this
# tree. If they are missing or stale, that one package is skipped (the
# repository keeps its older version), everything else is built and signed,
# and the run exits non-zero at the end, so the daily publish still reaches
# every other phone and its timer shows the failure.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
ROOT=$PWD
source tools/lib/alarm.sh

SLOW=(mesa hyprland libcamera)
# Packed from a staged kernel build: built only when named (see above)
NAMED_ONLY=(linux-omamobile)
repo=out/repo/aarch64
# Exit 3 means exactly "built and signed everything but the skipped device
# packages", which <repo>/../.skipped then lists: any other exit with 3 (a
# gpg, tar or repo-add that happened to return it) becomes 1. Set before
# anything can fail; the old list goes once the repository is known
# (--local moves it, and never touches out/repo).
skipfile=$(dirname "$repo")/.skipped
trap 'rc=$?; if ((rc == 3)) && [[ ! -s $skipfile ]]; then exit 1; fi' EXIT
all=0 force=0 nocheck=0 container_check=0 list=0 resign=0 imports=() dirs=() local_name=
while (($#)); do
  case $1 in
    --all) all=1 ;;
    --force) force=1 ;;
    --nocheck) nocheck=1 ;;
    --check-in-container) container_check=1 ;;
    --list) list=1 ;;
    --resign) resign=1 ;;
    --import) imports+=("${2:?--import needs a directory}"); shift ;;
    --local) local_name=${2:?--local needs a device codename}; shift ;;
    -h|--help) source tools/lib/usage.sh; usage_from_header "$0" 2; exit 0 ;;
    -*) alarm_die "unknown option $1" ;;
    *) dirs+=("${1%/}") ;;
  esac
  shift
done

# Default order: dependencies of our own packages first (check() of a later
# package can then install an earlier one from the repository being built).
ORDER=(omamobile-keyring libfprint neard omacam omamobile-apps omamobile-device-cheetah omamobile-device-felix omamobile-device-lynx omamobile-device-raven omamobile-device-panther omamobile-audio
       omamobile-sensors omamobile-gnss omamobile-fingerprint omamobile-mirror omamobile-omarchy omamobile-owl-widgets omamobile-shell
       omamobile-modem omamobile-modem-sit omamobile-mmd omamobile-speaker-tuning omamobile-waydroid
       omamobile-firstboot omamobile-boot-update linux-omamobile mesa hyprland libcamera)
if ((resign)) && ((${#dirs[@]} + ${#imports[@]} + list + force + all)); then
  alarm_die "--resign builds, imports and lists nothing: use it alone"
fi
if ((${#dirs[@]} == 0)) && ((${#imports[@]} == 0)) && ((resign == 0)); then
  for name in "${ORDER[@]}"; do
    [[ -d packages/$name ]] || continue
    ((all)) || [[ " ${SLOW[*]} " != *" $name "* ]] || continue
    [[ " ${NAMED_ONLY[*]} " != *" $name "* ]] || continue
    dirs+=("packages/$name")
  done
  for d in packages/*/; do
    name=$(basename "$d")
    [[ " ${ORDER[*]} " == *" $name "* ]] || dirs+=("packages/$name")
  done
fi
for d in "${dirs[@]}"; do [[ -f $d/PKGBUILD ]] || alarm_die "no PKGBUILD in $d"; done

if [[ -n $local_name ]]; then
  # A contributor's own key, never the maintainer's (review lesson L-7)
  [[ $local_name =~ ^[a-z0-9]+$ && -f device/$local_name/device.conf ]] \
    || alarm_die "--local needs a device codename with a device/<codename>/device.conf"
  ((resign == 0)) || alarm_die "--resign is for the maintainer's out/repo, not --local"
  repo=out/$local_name/repo/aarch64
  skipfile=$(dirname "$repo")/.skipped
  keydir=keys/$local_name
  [[ -f $keydir/fingerprint && -d $keydir/gnupg && -f $keydir/public.asc ]] \
    || alarm_die "no local key in $keydir (run: tools/local-key-init $local_name)"
  export ALARM_LOCAL_KEY=$ROOT/$keydir/public.asc
  mkdir -p "$repo"
  export GNUPGHOME=$ROOT/$keydir/gnupg
  key=$(cat "$keydir/fingerprint")
else
  # The release key (docs/RELEASES.md §10), with a clear error without it
  source tools/lib/signing.sh
  signing_key_load "$ROOT" || exit 1
  key=$SIGNING_KEY
  mkdir -p "$repo"
fi
rm -f "$skipfile"

# The version makepkg will produce, from the PKGBUILD's own fields. Our
# PKGBUILDs read pkgver from a version file through $startdir.
pkg_version() {
  (
    cd "$1"
    startdir=$PWD
    # shellcheck disable=SC1091
    source ./PKGBUILD >/dev/null 2>&1
    echo "${epoch:+$epoch:}$pkgver-$pkgrel"
  )
}
pkg_names() { ( cd "$1"; startdir=$PWD; source ./PKGBUILD >/dev/null 2>&1; echo "${pkgname[@]}" ); }
up_to_date() {
  local dir=$1 want name f
  want=$(pkg_version "$dir")
  for name in $(pkg_names "$dir"); do
    f=$(ls "$repo/$name-$want"-*.pkg.tar.* 2>/dev/null | grep -v '\.sig$' | head -1)
    [[ -n $f ]] || return 1
  done
}

if ((list)); then
  for d in "${dirs[@]}"; do
    if up_to_date "$d"; then echo "up to date  $d $(pkg_version "$d")"; else echo "to build    $d $(pkg_version "$d")"; fi
  done
  for name in "${SLOW[@]}"; do
    [[ " ${dirs[*]} " == *" packages/$name "* ]] && continue
    up_to_date "packages/$name" || echo "missing     packages/$name $(pkg_version "packages/$name") (slow: name it or use --all, or --import a build)"
  done
  for name in "${NAMED_ONLY[@]}"; do
    [[ -d packages/$name && " ${dirs[*]} " != *" packages/$name "* ]] || continue
    echo "named only  packages/$name (stage a release with packages/$name/stage, then name it)"
  done
  exit 0
fi

# A package's .PKGINFO: bsdtar where installed (Arch), GNU tar otherwise
# (Debian), which detects the compression itself but needs the zstd
# program for .pkg.tar.zst.
command -v bsdtar >/dev/null || command -v zstd >/dev/null ||
  alarm_die "reading packages needs bsdtar, or GNU tar and zstd"
pkginfo() {
  if command -v bsdtar >/dev/null; then bsdtar -xOf "$1" .PKGINFO; else tar -xOf "$1" .PKGINFO; fi
}

# Put package files in the repository, replacing older files of the same name.
# A local build keeps an imported package's own signature (its .sig beside
# it); everything else is signed by sign_and_index.
add_to_repo() {
  local file name base
  for file; do
    base=${file##*/}
    name=$(pkginfo "$file" | sed -n 's/^pkgname = //p')
    [[ -n $name ]] || alarm_die "$base: no .PKGINFO"
    for old in "$repo/$name"-*.pkg.tar.*; do
      [[ -e $old && $old != *.sig ]] || continue
      [[ $(pkginfo "$old" | sed -n 's/^pkgname = //p') == "$name" ]] || continue
      [[ ${old##*/} == "$base" ]] || rm -f "$old" "$old.sig"
    done
    cp -f "$file" "$repo/$base"
    rm -f "$repo/$base.sig"
    if [[ -n $local_name && -f $file.sig ]]; then cp -f "$file.sig" "$repo/$base.sig"; fi
    echo "    $base"
  done
}

for dir in "${imports[@]}"; do
  alarm_say "Importing prebuilt packages from $dir"
  files=()
  for f in "$dir"/*.pkg.tar.*; do [[ $f == *.sig ]] || files+=("$f"); done
  ((${#files[@]})) || alarm_die "no packages in $dir"
  for f in "${files[@]}"; do
    [[ $(pkginfo "$f" | sed -n 's/^arch = //p') =~ ^(aarch64|any)$ ]] || alarm_die "$f is not an aarch64 package"
  done
  add_to_repo "${files[@]}"
done

# Pinned upstream packages (rootfs/packages.pinned): what that file lists is
# in out/repo with its listed checksum, and what it listed before and no
# longer does (out/repo/.pinned) is taken out. Each line is a SHA-256 and one
# or more URLs of the same file, tried in order (Omarchy's, then our
# published copy, for when upstream prunes it). A pin never takes the name
# of a package we build: add_to_repo would replace ours with it.
pinlist=rootfs/packages.pinned
pinstate=$(dirname "$repo")/.pinned
pins_changed=0
our_names() {
  local d
  for d in packages/*/PKGBUILD; do pkg_names "${d%/PKGBUILD}"; done | tr ' ' '\n' | sed '/^$/d' | sort -u
}
sync_pins() {
  local sum urls url base name want=() f tmp ours="" got
  while read -r sum urls; do
    base=
    [[ $sum =~ ^[0-9a-f]{64}$ && -n $urls ]] || alarm_die "$pinlist: not \"<sha256> <url>...\": $sum $urls"
    for url in $urls; do
      [[ $url =~ ^(https|file)://[^[:space:]]+/[^/[:space:]]+\.pkg\.tar\.(zst|xz)$ ]] ||
        alarm_die "$pinlist: not the URL of a package file: $url"
      [[ -z $base || ${url##*/} == "$base" ]] || alarm_die "$pinlist: one line's URLs name different files: $urls"
      base=${url##*/}
    done
    want+=("$base")
    if [[ -f $repo/$base && $(sha256sum < "$repo/$base" | cut -d' ' -f1) == "$sum" ]]; then continue; fi
    alarm_say "Pinned: $base"
    tmp=$(mktemp -d) got=0
    for url in $urls; do
      if curl -fsSL --retry 3 --connect-timeout 30 --max-time 1800 -o "$tmp/$base" "$url" &&
         [[ $(sha256sum < "$tmp/$base" | cut -d' ' -f1) == "$sum" ]]; then got=1; break; fi
      echo "    $url: not fetched, or not the listed SHA-256" >&2
    done
    ((got)) || { rm -rf "$tmp"; alarm_die "$pinlist: no URL gave $base with its SHA-256; nothing added"; }
    [[ $(pkginfo "$tmp/$base" | sed -n 's/^arch = //p') =~ ^(aarch64|any)$ ]] ||
      { rm -rf "$tmp"; alarm_die "$pinlist: $base is not an aarch64 package"; }
    name=$(pkginfo "$tmp/$base" | sed -n 's/^pkgname = //p')
    [[ -n $ours ]] || ours=$(our_names)
    ! grep -qxF "$name" <<<"$ours" ||
      { rm -rf "$tmp"; alarm_die "$pinlist: $base is $name, which packages/ builds: a pin never replaces our own package"; }
    add_to_repo "$tmp/$base"
    rm -rf "$tmp"
    pins_changed=1
  done < <(sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$pinlist" 2>/dev/null || true)
  if [[ -f $pinstate ]]; then
    while read -r f; do
      [[ -n $f && " ${want[*]} " != *" $f "* && -e $repo/$f ]] || continue
      rm -f "$repo/$f" "$repo/$f.sig"
      echo "    unpinned: $f"
      pins_changed=1
    done < "$pinstate"
  fi
  printf '%s\n' ${want[@]+"${want[@]}"} | sed '/^$/d' > "$pinstate"
}
if [[ -z $local_name ]] && ((resign == 0)); then sync_pins; fi

build=()
for d in "${dirs[@]}"; do
  if ((force == 0)) && up_to_date "$d"; then
    echo "up to date: $d $(pkg_version "$d")"
  else
    build+=("$d")
  fi
done

# Staged inputs, checked before anything is built: a release kernel from a
# published tag (named only, so a refusal stops the run), and boot files
# that match this tree (a refusal skips that package and fails the run at
# the end)
skipped=() kept=() warned=()
for d in "${build[@]}"; do
  name=$(basename "$d")
  if [[ " ${NAMED_ONLY[*]} " == *" $name "* ]]; then
    "$d/stage" --verify "$d/prebuilt" || alarm_die "$name: the staged kernel is not a published release; nothing built"
  fi
  if grep -c 'OMAMOBILE_BOOT_FILES' "$d/install" >/dev/null 2>&1 && ! tools/stage-boot-files --check "$d/boot-files"; then
    echo "SKIPPED: $name $(pkg_version "$d"): its boot files are missing or stale (DEVICE=<codename> KERNEL_OUT=<build> tools/stage-boot-files); building the rest" >&2
    skipped+=("$name")
    continue
  fi
  kept+=("$d")
done
build=("${kept[@]}")

# The tarball is also where repo-add comes from on a host without it, even
# when the run only imports packages
if ((${#build[@]})) || ! command -v repo-add >/dev/null; then
  alarm_fetch
fi
if ((${#build[@]})); then
  image=$(alarm_build_image "$ROOT")
fi

sign_and_index() {
  local package
  for package in "$repo"/*.pkg.tar.*; do
    [[ -e $package && $package != *.sig ]] || continue
    [[ -f $package.sig ]] || gpg --batch --yes --local-user "$key" --detach-sign "$package"
  done
  rm -f "$repo"/omamobile.db* "$repo"/omamobile.files*
  local packages=() f
  for f in "$repo"/*.pkg.tar.*; do [[ $f == *.sig ]] || packages+=("${f##*/}"); done
  if command -v repo-add >/dev/null; then
    (cd "$repo" && repo-add --quiet --sign --key "$key" omamobile.db.tar.gz "${packages[@]}")
  else
    # Not an Arch machine: pacman's repo-add from the Arch Linux ARM image,
    # with the same key. It runs as the container's root and hands /repo
    # back to the owner it arrived with, as the build does: under rootless
    # Docker the container's root is this user and a container uid such as
    # this user's is a subordinate uid on the host, which can't read the
    # keyring (mode 700), so `-u $(id -u)` failed there with "The key ...
    # does not exist in your keyring"; under rootful Docker root reads it
    # and the chown keeps the index this user's.
    docker run --rm --platform linux/arm64 \
      -v "$ROOT/$repo:/repo" -v "$GNUPGHOME:/gnupg" -e GNUPGHOME=/gnupg -e HOME=/tmp -w /repo \
      "$(alarm_base_image)" bash -c 'owner=$(stat -c %u:%g /repo); trap "chown -R $owner /repo" EXIT
        repo-add --quiet --sign --key "$0" omamobile.db.tar.gz "$@"' "$key" "${packages[@]}"
  fi
}

# A changed pin is in the index before the first build, which resolves its
# dependencies from it (omamobile-omarchy depends on omarchy)
if ((pins_changed)); then
  alarm_say "Indexing the pinned packages"
  sign_and_index
fi

if ((resign)); then
  [[ -f $repo/omamobile.db ]] || alarm_die "$repo has no index to sign again"
  alarm_say "Signing every package in $repo again with $key"
  # New signatures beside the old ones first; the old ones are replaced only
  # when every package has one, so a failure leaves the repository as it was.
  for package in "$repo"/*.pkg.tar.*; do
    [[ -e $package && $package != *.sig && $package != *.sig.new ]] || continue
    gpg --batch --yes --local-user "$key" --detach-sign -o "$package.sig.new" "$package" \
      || { rm -f "$repo"/*.sig.new; alarm_die "signing ${package##*/} failed; nothing was replaced"; }
  done
  for new in "$repo"/*.sig.new; do mv -f "$new" "${new%.new}"; done
  command -v repo-add >/dev/null || alarm_fetch
  sign_and_index
  echo "    $(ls "$repo" | grep -c '\.pkg\.tar\.[a-z]*\.sig$') package signatures and the index, by $key"
  exit 0
fi

for dir in "${build[@]}"; do
  name=$(basename "$dir")
  alarm_say "$name $(pkg_version "$dir")"
  work=$(mktemp -d)
  # The package directory as it is (including gitignored prebuilt files the
  # PKGBUILDs install), minus makepkg's work directories and old packages.
  tar cf - --exclude="./$name/pkg" --exclude="./$name/src/build" --exclude='*.pkg.tar.*' \
    -C "$(dirname "$dir")" "./$name" | tar xf - -C "$work"
  out=$work/out && mkdir -p "$out"
  incheck=0
  if ((nocheck == 0)); then
    # test/host-tools names the commands a package's test/all needs beyond
    # a shell (Settings compiles its tests with Qt's qmake6). A builder
    # without one of them, such as the publish machine on Ubuntu, runs that
    # package's check() in the container, where its dependencies are
    # installed, instead of failing the whole run
    lacking=
    if [[ -f $dir/test/host-tools ]]; then
      for tool in $(grep -v '^#' "$dir/test/host-tools"); do
        command -v "$tool" >/dev/null 2>&1 || lacking+=" $tool"
      done
    fi
    if ((container_check)) || [[ ! -x $dir/test/all ]]; then
      incheck=1
    elif [[ -n $lacking ]]; then
      incheck=1
      echo "    this machine lacks$lacking: check() runs in the container"
    else
      "$dir/test/all" > "$work/test.log" 2>&1 || { tail -20 "$work/test.log"; rm -rf "$work"; alarm_die "$name: test/all failed"; }
      echo "    test/all passed ($(grep -c '^ok' "$work/test.log") checks, natively)"
    fi
  fi
  # The upstream signers a PKGBUILD names (validpgpkeys), fetched here on the
  # host (cached) so makepkg in the container can verify .sig sources
  pgp=$work/pgp.asc
  : > "$pgp"
  keys=$(sed -n '/^validpgpkeys=(/,/)/p' "$dir/PKGBUILD" | grep -oE '[0-9A-F]{40}' || true)
  if [[ -n $keys ]]; then
    kr=$ALARM_CACHE/pgp && mkdir -p "$kr" && chmod 700 "$kr"
    for k in $keys; do
      GNUPGHOME=$kr gpg -q --batch --list-keys "$k" >/dev/null 2>&1 ||
        GNUPGHOME=$kr gpg -q --batch --keyserver "$ALARM_KEYSERVER" --recv-keys "$k" ||
        echo "    warning: could not fetch upstream key $k"
    done
    GNUPGHOME=$kr gpg -q --batch --armor --export $keys > "$pgp" 2>/dev/null || true
  fi
  # Our own earlier packages resolve from the repository being built
  have_repo=0
  [[ -f $repo/omamobile.db ]] && have_repo=1
  start=$(date +%s)
  docker run --rm --platform linux/arm64 \
    -v "$work:/work" -v "$ROOT/$repo:/repo/aarch64:ro" \
    -v "$ALARM_CACHE/pkg:/var/cache/pacman/pkg" -v "$ALARM_CACHE/src:/srcdest" \
    -e NAME="$name" -e HAVE_REPO="$have_repo" -e INCHECK="$incheck" \
    "$image" bash -c '
      set -euo pipefail
      # Hand every bind mount back to the owner it arrived with. Under
      # rootless Docker the container uid 1000 (builder) is a subordinate uid on
      # the host, so leaving /work owned by builder makes the package
      # unreadable to the user running this script (issue #73).
      owner=$(stat -c %u:%g /work) cache_owner=$(stat -c %u:%g /var/cache/pacman/pkg) src_owner=$(stat -c %u:%g /srcdest)
      trap "chown -R $owner /work; chown -R $cache_owner /var/cache/pacman/pkg; chown -R $src_owner /srcdest" EXIT
      if [[ $HAVE_REPO == 1 ]]; then
        sed -i "0,/^\[omarchy\]/s//[omamobile]\nServer = file:\/\/\/repo\/\$arch\n\n[omarchy]/" /etc/pacman.conf
      fi
      pacman -Sy >/dev/null
      chown -R builder: /work /srcdest
      cd /work/$NAME
      info=$(su builder -c "makepkg --printsrcinfo")
      # Every dependency a repository can provide goes in (the build-time
      # ones always; runtime ones so check() can run). Ours that are not
      # built yet are left out: makepkg runs with --nodeps.
      wanted=$(awk "\$1 ~ /^(depends|makedepends|checkdepends)\$/ {print \$3}" <<<"$info" | sed "s/[<>=].*//" | sort -u)
      install=()
      for dep in $wanted; do
        pacman -Sp --print-format %n "$dep" >/dev/null 2>&1 && install+=("$dep")
      done
      # The build image is made once and kept, so it falls behind the
      # repositories, and installing current packages into it is a partial
      # upgrade. Usually that works. When the distribution moves a library
      # (openssl 3 to its compat package openssl-3, 2026-11-12: "openssl-3:
      # /usr/lib/libcrypto.so.3 exists in filesystem (owned by openssl)") it
      # cannot: then bring this container up to date first and try once more.
      deps() { pacman -S --noconfirm --needed --asdeps --overwrite "/usr/share/pacman/keyrings/*" "${install[@]}" >/dev/null; }
      if ((${#install[@]})) && ! deps; then
        echo "the build image is behind the repositories: upgrading it for this build, then installing again" >&2
        pacman -Su --noconfirm --overwrite "/usr/share/pacman/keyrings/*" >/dev/null
        deps
      fi
      [[ -s /work/pgp.asc ]] && su builder -c "gpg -q --batch --import /work/pgp.asc"
      flags=(-f --nodeps --noconfirm)
      [[ $INCHECK == 1 ]] || flags+=(--nocheck)
      su builder -c "SRCDEST=/srcdest PKGDEST=/work/out PKGEXT=.pkg.tar.zst makepkg ${flags[*]}" 2>&1 | tail -25
      ls /work/out/*.pkg.tar.zst >/dev/null
    ' || { rm -rf "$work"; alarm_die "$name: build failed"; }
  add_to_repo "$out"/*.pkg.tar.zst
  rm -rf "$work"
  # omamobile-gnss packages without the Pixel 9a's HAL client when
  # bionic/prebuilt/ has none (it isn't committed), and on a 9a Location
  # then fails at its start. Its install script says so in the middle of the
  # build output; say it again where a publish run is read.
  [[ $name == omamobile-gnss && ! -f $dir/bionic/prebuilt/omamobile-gnss-client ]] &&
    warned+=("omamobile-gnss was built without the Pixel 9a's HAL client: no Location on a 9a from this package (make -C packages/omamobile-gnss/bionic, then build it again)")
  echo "    built in $(( ($(date +%s) - start) / 60 )) min"
  # Index after each package, so the next one can depend on it
  sign_and_index
done

alarm_say "Signing and indexing $repo"
sign_and_index
ls -1 "$repo" | grep -E '\.pkg\.tar\.zst$'
for w in "${warned[@]}"; do printf '\e[33mwarning:\e[0m %s\n' "$w" >&2; done
# Exit 3: everything else is built and signed (tools/repo-publish publishes
# it, then fails too); any other failure exits 1 earlier
if ((${#skipped[@]})); then
