#!/bin/bash
# SPDX-License-Identifier: MIT
# extract-vendor-firmware: copy the Wi-Fi, Bluetooth, haptics and speaker
# amplifier firmware the Pixel 7 Pro (cheetah) needs out of a Google factory
# image, on the user's own machine.
#
# Google's firmware is not ours to redistribute, so Omarchy Mobile never ships it.
# Like LineageOS's extract-files, this pulls it from an image the user already
# has (the factory zip from developers.google.com/android/images, or the
# image-*.zip inside it) and renames it to what the mainline drivers request:
#
#   vendor/firmware/fw_bcmdhd.bin     -> brcm/brcmfmac4389c1-pcie.<board>.bin       (brcmfmac)
#   vendor/firmware/bcmdhd.cal        -> brcm/brcmfmac4389c1-pcie.<board>.txt       (NVRAM)
#   vendor/firmware/bcmdhd_clm.blob   -> brcm/brcmfmac4389c1-pcie.<board>.clm_blob  (regulatory)
#   vendor/firmware/brcm/BCM.hcd      -> brcm/BCM.<board>.hcd                       (btbcm)
#   vendor/firmware/aoc.bin           -> aoc.bin                 (the AoC DSP: audio and sensors; GSA-authenticated)
#   vendor/etc/sensors/registry/      -> /usr/share/omamobile/sensors/registry/  (the AoC's sensor list)
#   vendor/firmware/cs40l26.wmfw      -> cs40l26.wmfw            (cs40l26-vibra, RAM firmware)
#   vendor/firmware/cs40l26.bin       -> cs40l26.bin             (cs40l26-vibra, wavetable)
#   vendor/firmware/cs40l26-svc.bin   -> cs40l26-svc.bin         (tuning, not loaded yet)
#   vendor/firmware/cs40l26-dvl.bin   -> cs40l26-dvl.bin         (tuning, not loaded yet)
#   vendor/firmware/cs40l26-calib.wmfw -> cs40l26-calib.wmfw     (calibration firmware, not loaded yet)
#   vendor/firmware/cs35l41-dsp1-spk-prot.wmfw   -> cirrus/cs35l41-dsp1-spk-prot-cheetah.wmfw        (both amplifiers)
#   vendor/firmware/cs35l41-dsp1-spk-prot.bin    -> cirrus/cs35l41-dsp1-spk-prot-cheetah-top.bin     (top speaker tuning)
#   vendor/firmware/R-cs35l41-dsp1-spk-prot.bin  -> cirrus/cs35l41-dsp1-spk-prot-cheetah-bottom.bin  (bottom speaker tuning)
#   vendor/firmware/fast_switch3.txt   -> cirrus/cs35l41-cheetah-top-media-delta.txt     (stock media "Bypass FIR" delta, top)
#   vendor/firmware/fast_switch4.txt   -> cirrus/cs35l41-cheetah-bottom-media-delta.txt  (the same, bottom)
#
# <board> is the first string of the DT root compatible ("google,gs201-cheetah"),
# which brcmfmac and btbcm both try before the generic name. The CS40L26 files
# keep their names (the haptics chip has no board-specific lookup). The
# CS35L41 files get the names mainline wm_adsp requests for the DT's
# cirrus,subsystem-id "cheetah" and the amplifiers' name prefixes Top/Bottom:
# stock's unprefixed tuning belongs to the unprefixed (left, top) amplifier and
# its "R-" one to the right (bottom) one. No unsuffixed .bin is installed, so a
# missing tuning fails to load instead of falling back to the other speaker's
# (or to linux-firmware's generic cirrus/cs35l41-dsp1-spk-prot.bin).
#
# Output is a tree rooted at /, under usr/lib/firmware/updates (searched before
# linux-firmware's files, and not owned by any package). Nothing touches the phone.
#
# Needs: unzip, debugfs (e2fsprogs); simg2img if vendor.img is sparse;
# lpunpack if the image only has super.img; fsck.erofs (erofs-utils) if vendor is EROFS.
set -euo pipefail
# debugfs and friends live in /sbin on Debian-like hosts
export PATH=$PATH:/usr/sbin:/sbin

BOARD="google,gs201-cheetah"
DEVICE="cheetah"
FW_BASE="brcmfmac4389c1-pcie"
DEST_REL="usr/lib/firmware/updates"

# source path in the vendor partition -> path under $DEST_REL
MAP=(
  "firmware/fw_bcmdhd.bin|brcm/$FW_BASE.$BOARD.bin"
  "firmware/bcmdhd.cal|brcm/$FW_BASE.$BOARD.txt"
  "firmware/bcmdhd_clm.blob|brcm/$FW_BASE.$BOARD.clm_blob"
  "firmware/brcm/BCM.hcd|brcm/BCM.$BOARD.hcd"
  "firmware/aoc.bin|aoc.bin"
  "firmware/cs40l26.wmfw|cs40l26.wmfw"
  "firmware/cs40l26.bin|cs40l26.bin"
  "firmware/cs40l26-svc.bin|cs40l26-svc.bin"
  "firmware/cs40l26-dvl.bin|cs40l26-dvl.bin"
  "firmware/cs40l26-calib.wmfw|cs40l26-calib.wmfw"
  "firmware/cs35l41-dsp1-spk-prot.wmfw|cirrus/cs35l41-dsp1-spk-prot-$DEVICE.wmfw"
  "firmware/cs35l41-dsp1-spk-prot.bin|cirrus/cs35l41-dsp1-spk-prot-$DEVICE-top.bin"
  "firmware/R-cs35l41-dsp1-spk-prot.bin|cirrus/cs35l41-dsp1-spk-prot-$DEVICE-bottom.bin"
  "firmware/fast_switch3.txt|cirrus/cs35l41-$DEVICE-top-media-delta.txt"
  "firmware/fast_switch4.txt|cirrus/cs35l41-$DEVICE-bottom-media-delta.txt"
)

usage() {
  cat <<USAGE
Usage: extract-vendor-firmware [-o OUTDIR] [-w WORKDIR] [-f] SOURCE

  SOURCE   Google factory zip (cheetah-*-factory-*.zip), the image-cheetah-*.zip
           inside it, or a raw/sparse vendor.img
  -o DIR   staging root to write into (default: ./out/vendor-firmware)
  -w DIR   scratch directory for the ~1 GB vendor.img (default: a temp dir in \$TMPDIR)
  -d DEV   cheetah (default) or raven
  -f       skip the android-info.txt board=$DEVICE check
  -c FILE  also copy the camera HAL APEX (/vendor/apex/com.google.pixel.camera.hal.apex)
           to FILE, for tools/extract-camera-data --apex (tools/phone-provision uses it)

Install on the phone (from the omamobile repo):
  tar -C OUTDIR -cf - usr | tools/phone-ssh 'tar -C / -xf -'
USAGE
}

say() { printf '==> %s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "$1 not found ($2)"; }

OUT="./out/vendor-firmware" WORK="" FORCE="" CAMERA_APEX="" DEVICE_OPT=cheetah
while getopts "o:w:c:d:fh" opt; do
  case $opt in
    o) OUT=$OPTARG ;;
    d) DEVICE_OPT=$OPTARG ;;
    c) CAMERA_APEX=$(realpath -m -- "$OPTARG") ;;
    w) WORK=$OPTARG ;;
    f) FORCE=1 ;;
    h) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))
[[ $# -eq 1 ]] || { usage >&2; exit 2; }
case $DEVICE_OPT in
  cheetah) ;;
  raven)
    # Pixel 6 Pro: Wi-Fi, Bluetooth, the AoC, the speaker amplifiers'
    # protection firmware and the AoC's sensor registry (device/raven/WIFI-PLAN.md,
    # AUDIO-PLAN.md). The _ROW
    # NVRAM and CLM are the global model's (SKU GLU0G). Raven's vendor has no
    # fast_switch tunings, and its haptics (cs40l25a_*) are not mapped yet.
    BOARD="google,gs101-raven"
    DEVICE="raven"
    MAP=(
      "firmware/fw_bcmdhd.bin|brcm/$FW_BASE.$BOARD.bin"
      "firmware/bcmdhd.cal_ROW|brcm/$FW_BASE.$BOARD.txt"
      "firmware/bcmdhd_clm.blob_ROW|brcm/$FW_BASE.$BOARD.clm_blob"
      "firmware/brcm/BCM.hcd|brcm/BCM.$BOARD.hcd"
      "firmware/aoc.bin|aoc.bin"
      "firmware/cs35l41-dsp1-spk-prot.wmfw|cirrus/cs35l41-dsp1-spk-prot-$DEVICE.wmfw"
      "firmware/cs35l41-dsp1-spk-prot.bin|cirrus/cs35l41-dsp1-spk-prot-$DEVICE-top.bin"
      "firmware/R-cs35l41-dsp1-spk-prot.bin|cirrus/cs35l41-dsp1-spk-prot-$DEVICE-bottom.bin"
    ) ;;
  *) die "unknown device $DEVICE_OPT (cheetah or raven)" ;;
esac
# The camera data flow (tools/extract-camera-data) exists for cheetah only
[[ $DEVICE == cheetah || -z $CAMERA_APEX ]] || die "-c is cheetah's (no camera support for $DEVICE yet)"
SRC=$(readlink -f "$1")
[[ -f "$SRC" ]] || die "no such file: $1"
# Absolute, because the checksum step runs from inside the staging dir
OUT=$(realpath -m -- "$OUT")

if [[ -n "$WORK" ]]; then
  mkdir -p "$WORK"
  WORK=$(mktemp -d "$WORK/xvf.XXXXXX")
else
  WORK=$(mktemp -d "${TMPDIR:-/tmp}/xvf.XXXXXX")
fi
trap 'rm -rf "$WORK"' EXIT

# Read 4 bytes at an offset as a little-endian hex word.
magic_at() { od -An -tx4 -j "$2" -N4 "$1" | tr -d ' \n'; }

# A zip member whose name ends in $2 (first match), or nothing.
zip_member() { unzip -Z1 "$1" | grep -E "(^|/)$2\$" | head -1 || true; }

# Get vendor.img out of SOURCE into $WORK/vendor.img.
fetch_vendor() {
  local src=$1 m inner
  case "$(magic_at "$src" 0)" in
    04034b50) ;;                                  # zip
    *) cp --reflink=auto "$src" "$WORK/vendor.img"; return ;;
  esac
  need unzip "install unzip"
  # The outer factory zip wraps image-<device>-*.zip; the inner one has the images.
  inner=$(zip_member "$src" "image-[^/]*\.zip")
  if [[ -n "$inner" ]]; then
    say "Unpacking $inner from the factory zip"
    unzip -p "$src" "$inner" > "$WORK/image.zip"
    src="$WORK/image.zip"
  fi
  m=$(zip_member "$src" "android-info\.txt")
  if [[ -n "$m" && -z "$FORCE" ]]; then
    unzip -p "$src" "$m" | grep -qE "^require board=(.*\|)?$DEVICE(\|.*)?\$" ||
      die "this image is not for $DEVICE (android-info.txt); use -f to override"
  fi
  m=$(zip_member "$src" "vendor\.img")
  if [[ -n "$m" ]]; then
    say "Unpacking vendor.img"
    unzip -p "$src" "$m" > "$WORK/vendor.img"
    return
  fi
  m=$(zip_member "$src" "super\.img")
  [[ -n "$m" ]] || die "no vendor.img or super.img in $(basename "$src")"
  need lpunpack "install android-tools"
  say "Unpacking super.img and its vendor partition"
  unzip -p "$src" "$m" > "$WORK/super.img"
  if [[ "$(magic_at "$WORK/super.img" 0)" == ed26ff3a ]]; then
    need simg2img "install android-tools"
    simg2img "$WORK/super.img" "$WORK/super.raw" && mv "$WORK/super.raw" "$WORK/super.img"
  fi
  mkdir -p "$WORK/super"
  lpunpack -p vendor_a "$WORK/super.img" "$WORK/super" 2>/dev/null ||
    lpunpack -p vendor "$WORK/super.img" "$WORK/super"
  mv "$WORK/super/"vendor*.img "$WORK/vendor.img"
  rm -rf "$WORK/super" "$WORK/super.img"
}

fetch_vendor "$SRC"
img="$WORK/vendor.img"
if [[ "$(magic_at "$img" 0)" == ed26ff3a ]]; then
  need simg2img "install android-tools"
  say "Converting sparse vendor.img"
  simg2img "$img" "$img.raw" && mv "$img.raw" "$img"
fi

# Copy one file out of the vendor filesystem ($1, no leading /) to $2.
if [[ "$(od -An -tx2 -j 1080 -N2 "$img" | tr -d ' ')" == ef53 ]]; then
  need debugfs "install e2fsprogs"
  say "vendor.img is ext4; reading it with debugfs (no mount)"
  get_file() {
    debugfs -R "dump /$1 $2" "$img" 2>/dev/null
    [[ -s "$2" ]]
  }
  get_dir() { mkdir -p "$2" && debugfs -R "rdump /$1 $2" "$img" 2>/dev/null && [[ -d "$2/$(basename "$1")" ]]; }
elif [[ "$(magic_at "$img" 1024)" == e0f5e1e2 ]]; then
  need fsck.erofs "install erofs-utils"
  say "vendor.img is EROFS; extracting it with fsck.erofs"
  fsck.erofs --extract="$WORK/vendor" --no-preserve "$img" >/dev/null
  get_file() { [[ -s "$WORK/vendor/$1" ]] && cp "$WORK/vendor/$1" "$2"; }
  get_dir() { [[ -d "$WORK/vendor/$1" ]] && mkdir -p "$2" && cp -r "$WORK/vendor/$1" "$2/"; }
else
  die "vendor.img is neither ext4 nor EROFS"
fi

# The board list in android-info.txt is shared by pantah devices; the vendor
# partition itself says which device it was built for.
if get_file build.prop "$WORK/build.prop"; then
  dev=$(sed -n 's/^ro.product.vendor.device=//p' "$WORK/build.prop" | head -1)
  [[ "$dev" == "$DEVICE" || -n "$FORCE" ]] ||
    die "vendor partition is for '${dev:-unknown}', not $DEVICE; use -f to override"
  say "Vendor partition: $(sed -n 's/^ro.vendor.build.fingerprint=//p' "$WORK/build.prop" | head -1)"
fi

dest="$OUT/$DEST_REL"
mkdir -p "$dest/brcm" "$dest/cirrus"
for entry in "${MAP[@]}"; do
  from=${entry%%|*} to=${entry#*|}
  get_file "$from" "$dest/$to" || die "/vendor/$from is missing from this image"
  chmod 0644 "$dest/$to"
  printf '  /vendor/%-28s -> /%s/%s\n' "$from" "$DEST_REL" "$to"
done

# The AoC's sensor registry (which sensors this board has, their buses and
# settings), read by omamobile-sensor-proxy; without it only virtual sensors.
reg="$OUT/usr/share/omamobile/sensors"
get_dir etc/sensors/registry "$reg" || die "/vendor/etc/sensors/registry is missing from this image"
chmod -R u=rwX,go=rX "$reg"
printf '  /vendor/%-28s -> /%s\n' "etc/sensors/registry/" "usr/share/omamobile/sensors/registry/"

if [[ -n $CAMERA_APEX ]]; then
  get_file apex/com.google.pixel.camera.hal.apex "$CAMERA_APEX" ||
    die "/vendor/apex/com.google.pixel.camera.hal.apex is missing from this image"
  say "Camera HAL APEX copied to $CAMERA_APEX"
fi

# Sanity checks: right chip, text NVRAM, Cirrus file formats.
brcm="$dest/brcm"
grep -aq '4389c1-roml' "$brcm/$FW_BASE.$BOARD.bin" ||
  die "fw_bcmdhd.bin is not a BCM4389C1 PCIe firmware"
grep -aq 'BCM4389C1' "$brcm/BCM.$BOARD.hcd" ||
  die "BCM.hcd is not a BCM4389C1 Bluetooth patch"
grep -aq '^NVRAMRev=' "$brcm/$FW_BASE.$BOARD.txt" ||
  die "bcmdhd.cal does not look like a Broadcom text NVRAM"
# The speaker amplifiers' protection firmware, on both phones
wmfw_halo() { # WMFW, Halo core (4): what cs_dsp accepts for this part
  [[ "$(head -c4 "$dest/$1")" == WMFW && "$(od -An -tu1 -j10 -N1 "$dest/$1" | tr -d ' ')" == 4 ]] ||
    die "$1 is not a Halo Core WMFW firmware"
}
wmfw_halo "cirrus/cs35l41-dsp1-spk-prot-$DEVICE.wmfw"
grep -aq 'FIRMWARE_HALO_CSPL' "$dest/cirrus/cs35l41-dsp1-spk-prot-$DEVICE.wmfw" ||
  die "cs35l41-dsp1-spk-prot.wmfw is not the CS35L41 speaker protection firmware"
grep -aq 'CAL_CHECKSUM' "$dest/cirrus/cs35l41-dsp1-spk-prot-$DEVICE.wmfw" ||
  die "cs35l41-dsp1-spk-prot.wmfw has no calibration controls"
cmp -s "$dest/cirrus/cs35l41-dsp1-spk-prot-$DEVICE-top.bin" "$dest/cirrus/cs35l41-dsp1-spk-prot-$DEVICE-bottom.bin" &&
  die "the top and bottom speaker tunings are the same file"
for f in top bottom; do
  [[ "$(head -c4 "$dest/cirrus/cs35l41-dsp1-spk-prot-$DEVICE-$f.bin")" == WMDR ]] ||
    die "the $f speaker tuning is not a WMDR coefficient file"
done
# Cheetah's haptics and media deltas
if [[ $DEVICE == cheetah ]]; then
  for f in cs40l26.wmfw cs40l26-calib.wmfw; do wmfw_halo "$f"; done
  grep -aq 'FIRMWARE_CS40L26' "$dest/cs40l26.wmfw" ||
    die "cs40l26.wmfw is not a CS40L26 firmware"
  grep -aq 'BUZZ_EFFECTS2_BUZZ_LEVEL' "$dest/cs40l26.wmfw" ||
    die "cs40l26.wmfw has no buzz generator (cs40l26-vibra needs BUZZGEN)"
  # The media deltas: comma-separated integers, the first the word count
  # (vendor mixer_paths.xml "speaker-post"; Google's cs35l41 driver parses them)
  for f in top bottom; do
    python3 -I -c 'import sys; w = [int(x) for x in open(sys.argv[1]).read().replace(" ", "").strip().split(",")]; sys.exit(w[0] != len(w))' \
      "$dest/cirrus/cs35l41-$DEVICE-$f-media-delta.txt" || die "the $f media delta is not a word list"
  done
  for f in cs40l26.bin cs40l26-svc.bin cs40l26-dvl.bin; do
    [[ "$(head -c4 "$dest/$f")" == WMDR ]] || die "$f is not a WMDR coefficient file"
  done
fi

ver=$(grep -ao 'Version=[0-9.]* ([^)]*)' "$brcm/$FW_BASE.$BOARD.bin" | head -1)
bt=$(grep -ao 'BCM4389C1 [^[]*' "$brcm/BCM.$BOARD.hcd" | head -1)
(cd "$dest" && find . -type f -printf '%P\n' | sort | xargs sha256sum -- > "$OUT/vendor-firmware.sha256")
say "Wi-Fi firmware: ${ver:-unknown version}"
say "Bluetooth patch: ${bt:-unknown version}"
[[ $DEVICE == cheetah ]] &&
  say "Haptics firmware: cs40l26.wmfw ($(stat -c %s "$dest/cs40l26.wmfw") bytes) and its wavetable"
say "Speaker protection: cs35l41-dsp1-spk-prot-$DEVICE.wmfw and the top and bottom tunings"
say "Staged in $OUT (checksums in $OUT/vendor-firmware.sha256)"
echo "This is Google's proprietary firmware from your own factory image. Do not redistribute it."
