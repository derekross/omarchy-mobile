#!/bin/bash
# SPDX-License-Identifier: MIT
# extract-vendor-firmware: copy the Wi-Fi, Bluetooth, haptics and speaker
# amplifier firmware the Pixel 7 Pro (cheetah) needs out of a Google factory
# image, on the user's own machine. The Pixel 7 (panther), the Pixel 6 Pro
# (raven), the Pixel 9a (tegu) and the Pixel 8 Pro (husky, Wi-Fi only) are
# options (-d).
#
# Google's firmware is not ours to redistribute, so Omarchy Mobile never ships it.
# Like LineageOS's extract-files, this pulls it from an image the user already
# has (the factory zip from developers.google.com/android/images, or the
# image-*.zip inside it) and renames it to what the mainline drivers request:
#
#   vendor/firmware/fw_bcmdhd.bin     -> brcm/brcmfmac4389c1-pcie.<board>.bin       (brcmfmac)
#   vendor/firmware/bcmdhd.cal        -> brcm/brcmfmac4389c1-pcie.<board>.txt       (NVRAM)
#   vendor/firmware/bcmdhd_clm.blob   -> brcm/brcmfmac4389c1-pcie.<board>.clm_blob  (regulatory)
#   vendor/firmware/brcm/BCM.hcd      -> brcm/BCM.<board>.hcd                       (btbcm)
#   vendor/firmware/aoc.bin           -> aoc.bin                 (the AoC DSP: audio and sensors; GSA-authenticated)
#   vendor/etc/sensors/registry/      -> /usr/share/omamobile/sensors/registry/  (the AoC's sensor list)
#   vendor/firmware/cs40l26.wmfw      -> cs40l26.wmfw            (cs40l26-vibra, RAM firmware)
#   vendor/firmware/cs40l26.bin       -> cs40l26.bin             (cs40l26-vibra, wavetable)
#   vendor/firmware/cs40l26-svc.bin   -> cs40l26-svc.bin         (tuning, not loaded yet)
#   vendor/firmware/cs40l26-dvl.bin   -> cs40l26-dvl.bin         (tuning, not loaded yet)
#   vendor/firmware/cs40l26-calib.wmfw -> cs40l26-calib.wmfw     (calibration firmware, not loaded yet)
#   vendor/firmware/cs35l41-dsp1-spk-prot.wmfw   -> cirrus/cs35l41-dsp1-spk-prot-cheetah.wmfw        (both amplifiers)
#   vendor/firmware/cs35l41-dsp1-spk-prot.bin    -> cirrus/cs35l41-dsp1-spk-prot-cheetah-top.bin     (top speaker tuning)
#   vendor/firmware/R-cs35l41-dsp1-spk-prot.bin  -> cirrus/cs35l41-dsp1-spk-prot-cheetah-bottom.bin  (bottom speaker tuning)
#   vendor/firmware/fast_switch3.txt   -> cirrus/cs35l41-cheetah-top-media-delta.txt     (stock media "Bypass FIR" delta, top)
#   vendor/firmware/fast_switch4.txt   -> cirrus/cs35l41-cheetah-bottom-media-delta.txt  (the same, bottom)
#
# <board> is the first string of the DT root compatible ("google,gs201-cheetah"),
# which brcmfmac and btbcm both try before the generic name. The CS40L26 files
# keep their names (the haptics chip has no board-specific lookup). The
# CS35L41 files get the names mainline wm_adsp requests for the DT's
# cirrus,subsystem-id "cheetah" and the amplifiers' name prefixes Top/Bottom:
# stock's unprefixed tuning belongs to the unprefixed (left, top) amplifier and
# its "R-" one to the right (bottom) one. No unsuffixed .bin is installed, so a
# missing tuning fails to load instead of falling back to the other speaker's
# (or to linux-firmware's generic cirrus/cs35l41-dsp1-spk-prot.bin).
#
# The Pixel 9a (-d tegu; <board> is "google,zumapro-tegu"):
#
#   vendor/firmware/fw_bcmdhd.bin             -> brcm/brcmfmac4383-pcie.<board>.bin         (brcmfmac)
#   vendor/firmware/bcmdhd.cal_4383_a3        -> brcm/brcmfmac4383-pcie.<board>.txt         (NVRAM)
#   vendor/firmware/bcmdhd_clm.blob_4383_a3   -> brcm/brcmfmac4383-pcie.<board>.clm_blob    (regulatory)
#   vendor/firmware/bcmdhd_txcap.blob_4383_a3 -> brcm/brcmfmac4383-pcie.<board>.txcap_blob  (TX capabilities)
#   vendor/firmware/brcm/BCM.hcd              -> brcm/BCM.<board>.hcd                       (btbcm)
#   vendor/firmware/aoc.bin                   -> aoc-tegu.bin            (the AoC DSP, under the 9a's own name)
#   vendor/etc/sensors/registry/              -> /usr/share/omamobile/sensors/registry/
#   vendor/firmware/cs40l26*.{wmfw,bin}       -> the same five files as cheetah's
#
# The 9a's radio is a BCM4383 A3, and stock's "_4383_a3" NVRAM, CLM and TX
# capability files are the production silicon's (fw_bcmdhd.bin is the same
# file as fw_bcmdhd.bin_4383_a3; the _EVT and _PROTO NVRAMs are pre-production
# boards'). brcmfmac requests the txcap_blob on this chip, through the same
# board-name lookup as the other three, so all four get the board suffix:
# linux-firmware ships nothing for the 4383 today, and a generic file that
# lands there later must not shadow the owner's. The AoC firmware is named
# aoc-tegu.bin because the 9a's AoC start script requests that name
# (device/tegu/GSA-PLAN.md F1): the AoC firmware is matched to its SoC and
# authenticated by the GSA, and the name keeps a 7 Pro aoc.bin from ever
# being fed to the 9a. Two of the 9a's needs come from linux-firmware, not
# from the image: the Mali CSF firmware (arm/mali/arch11.8/mali_csffw.bin)
# and the TAS2572 amplifiers' RCA profile (ti/audio/tas257x/tas2572-1-1amp-reg.bin,
# installed as Top- and Bottom-tas2572RCA1.bin; stock's tismartpa_driver_tuning.bin
# is in another format, device/tegu/AUDIO-PLAN.md). The modem's and GNSS's
# files are tools/extract-vendor-chroot's.
#
# The Pixel 8 Pro (-d husky; <board> is "google,zuma-husky"), Wi-Fi only:
#
#   vendor/firmware/fw_bcmdhd.bin_4398_d0     -> brcm/brcmfmac4398d0-pcie.<board>.bin         (brcmfmac)
#   vendor/firmware/bcmdhd.cal_<region>       -> brcm/brcmfmac4398d0-pcie.<board>.txt         (NVRAM)
#   vendor/firmware/bcmdhd_clm.blob_4398_d0   -> brcm/brcmfmac4398d0-pcie.<board>.clm_blob    (regulatory)
#   vendor/firmware/bcmdhd_txcap.blob_4398_d0 -> brcm/brcmfmac4398d0-pcie.<board>.txcap_blob  (TX capabilities)
#
# The radio is a BCM4398 D0. Stock picks the CLM and TX capability files by
# chip revision (_4398_d0), but the NVRAM by the phone's hardware SKU
# (androidboot.hardware.sku): Google's bcmdhd (dhd_custom_google.c) maps it to
# a region and loads bcmdhd.cal_<region> when there is one. -s SKU does the
# same: MMW, ROW or NA, else, as on stock, the module's own NVRAM
# (bcmdhd.cal_USI_G5SN_9957_V17, the same bytes as _ROW). The regions differ
# only in their energy-detect thresholds. Read the SKU with
# `grep hardware.sku /proc/bootconfig` on the phone, or
# `adb shell getprop ro.boot.hardware.sku` on Android. Bluetooth and the
# other files wait for drivers (device/husky/ROADMAP.md). An OTA's vendor.img
# (from its payload.bin) works as SOURCE as well as a factory image.
#
# Output is a tree rooted at /, under usr/lib/firmware/updates (searched before
# linux-firmware's files, and not owned by any package). Nothing touches the phone.
# Each run builds a whole new generation in a staging directory inside OUTDIR,
# checks every file and the checksum list, and only then replaces the paths
# this script owns there (usr/lib/firmware/updates, usr/share/omamobile/sensors,
# vendor-firmware.sha256 and the -c file). A failed run, a failed replacement
# included, leaves the previous outputs as they were (if putting them back
# fails too, the error names the directory holding them), and a reused OUTDIR
# keeps no file from an earlier run (another device's firmware, an old sensor
# registry); the rest of OUTDIR is left alone. An OUTDIR that is / (or
# resolves to it) is refused before anything is written.
#
# Needs: unzip, debugfs (e2fsprogs); simg2img if vendor.img is sparse;
# lpunpack if the image only has super.img; fsck.erofs (erofs-utils) if vendor is EROFS.
set -euo pipefail
# debugfs and friends live in /sbin on Debian-like hosts
export PATH=$PATH:/usr/sbin:/sbin

BOARD="google,gs201-cheetah"
DEVICE="cheetah"
FW_BASE="brcmfmac4389c1-pcie"
# The chip strings the sanity checks expect in fw_bcmdhd.bin ("<chip>-roml")
# and in BCM.hcd ("BCM<CHIP> <release>")
WIFI_CHIP="4389c1"
BT_CHIP="BCM4389C1"
DEST_REL="usr/lib/firmware/updates"

# source path in the vendor partition -> path under $DEST_REL
MAP=(
  "firmware/fw_bcmdhd.bin|brcm/$FW_BASE.$BOARD.bin"
  "firmware/bcmdhd.cal|brcm/$FW_BASE.$BOARD.txt"
  "firmware/bcmdhd_clm.blob|brcm/$FW_BASE.$BOARD.clm_blob"
  "firmware/brcm/BCM.hcd|brcm/BCM.$BOARD.hcd"
  "firmware/aoc.bin|aoc.bin"
  "firmware/cs40l26.wmfw|cs40l26.wmfw"
  "firmware/cs40l26.bin|cs40l26.bin"
  "firmware/cs40l26-svc.bin|cs40l26-svc.bin"
  "firmware/cs40l26-dvl.bin|cs40l26-dvl.bin"
  "firmware/cs40l26-calib.wmfw|cs40l26-calib.wmfw"
  "firmware/cs35l41-dsp1-spk-prot.wmfw|cirrus/cs35l41-dsp1-spk-prot-$DEVICE.wmfw"
  "firmware/cs35l41-dsp1-spk-prot.bin|cirrus/cs35l41-dsp1-spk-prot-$DEVICE-top.bin"
  "firmware/R-cs35l41-dsp1-spk-prot.bin|cirrus/cs35l41-dsp1-spk-prot-$DEVICE-bottom.bin"
  "firmware/fast_switch3.txt|cirrus/cs35l41-$DEVICE-top-media-delta.txt"
  "firmware/fast_switch4.txt|cirrus/cs35l41-$DEVICE-bottom-media-delta.txt"
)

usage() {
  cat <<USAGE
Usage: extract-vendor-firmware [-o OUTDIR] [-w WORKDIR] [-f] SOURCE

  SOURCE   Google factory zip (<device>-*-factory-*.zip), the image-<device>-*.zip
           inside it, or a raw/sparse vendor.img
  -o DIR   staging root to write into (default: ./out/vendor-firmware); a
           successful run replaces this script's earlier outputs there
  -w DIR   scratch directory for the ~1 GB vendor.img (default: a temp dir in \$TMPDIR)
  -d DEV   cheetah (default), panther, raven, tegu or husky
  -s SKU   husky: the hardware SKU (androidboot.hardware.sku), which picks the NVRAM
  -f       skip the device checks (android-info.txt board=$DEVICE, the vendor build.prop)
  -c FILE  also copy the camera HAL APEX (/vendor/apex/com.google.pixel.camera.hal.apex)
           to FILE, for tools/extract-camera-data --apex (tools/phone-provision uses it)

Install on the phone (from the omamobile repo):
  tar -C OUTDIR -cf - usr | tools/phone-ssh 'tar -C / -xf -'
USAGE
}

say() { printf '==> %s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "$1 not found ($2)"; }

OUT="./out/vendor-firmware" WORK="" FORCE="" CAMERA_APEX="" DEVICE_OPT=cheetah
SKU=""
while getopts "o:w:c:d:s:fh" opt; do
  case $opt in
    o) OUT=$OPTARG ;;
    d) DEVICE_OPT=$OPTARG ;;
    s) SKU=$OPTARG ;;
    c) CAMERA_APEX=$(realpath -m -- "$OPTARG") ;;
    w) WORK=$OPTARG ;;
    f) FORCE=1 ;;
    h) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done
shift $((OPTIND - 1))
[[ $# -eq 1 ]] || { usage >&2; exit 2; }
case $DEVICE_OPT in
  cheetah) ;;
  panther)
    # Pixel 7: the same gs201 vendor files as cheetah, under the same names
    # (device/panther/NOTES.md); only the board and codename differ.
    BOARD="google,gs201-panther"
    DEVICE="panther"
    MAP=("${MAP[@]//google,gs201-cheetah/$BOARD}")
    MAP=("${MAP[@]//cheetah/$DEVICE}") ;;
  raven)
    # Pixel 6 Pro: Wi-Fi, Bluetooth, the AoC, the speaker amplifiers'
    # protection firmware and the AoC's sensor registry (device/raven/WIFI-PLAN.md,
    # AUDIO-PLAN.md). The _ROW
    # NVRAM and CLM are the global model's (SKU GLU0G). Raven's vendor has no
    # fast_switch tunings. The haptics: cs40l25-vibra loads the CLAB RAM
    # firmware and the default wavetable; the CLAB configuration (braking)
    # isn't loaded yet (device/raven/HAPTICS-TORCH-PLAN.md).
    BOARD="google,gs101-raven"
    DEVICE="raven"
    MAP=(
      "firmware/fw_bcmdhd.bin|brcm/$FW_BASE.$BOARD.bin"
      "firmware/bcmdhd.cal_ROW|brcm/$FW_BASE.$BOARD.txt"
      "firmware/bcmdhd_clm.blob_ROW|brcm/$FW_BASE.$BOARD.clm_blob"
      "firmware/brcm/BCM.hcd|brcm/BCM.$BOARD.hcd"
      "firmware/aoc.bin|aoc.bin"
      "firmware/cs35l41-dsp1-spk-prot.wmfw|cirrus/cs35l41-dsp1-spk-prot-$DEVICE.wmfw"
      "firmware/cs35l41-dsp1-spk-prot.bin|cirrus/cs35l41-dsp1-spk-prot-$DEVICE-top.bin"
      "firmware/R-cs35l41-dsp1-spk-prot.bin|cirrus/cs35l41-dsp1-spk-prot-$DEVICE-bottom.bin"
      "firmware/cs40l25a_clab.wmfw|cs40l25a_clab.wmfw"
      "firmware/cs40l20.bin|cs40l20.bin"
      "firmware/cs40l25a_clab.bin|cs40l25a_clab.bin"
    ) ;;
  tegu)
    # Pixel 9a: Wi-Fi (BCM4383 A3, with the TX capability blob brcmfmac
    # requests on this chip), Bluetooth, the AoC under the 9a's own name,
    # the haptics files and the AoC's sensor registry (the header). Its
    # speaker amplifiers (TAS2572) and GPU take linux-firmware's files.
    BOARD="google,zumapro-tegu"
    DEVICE="tegu"
    FW_BASE="brcmfmac4383-pcie"
    WIFI_CHIP="4383a3"
    BT_CHIP="BCM4383A3"
    MAP=(
      "firmware/fw_bcmdhd.bin|brcm/$FW_BASE.$BOARD.bin"
      "firmware/bcmdhd.cal_4383_a3|brcm/$FW_BASE.$BOARD.txt"
      "firmware/bcmdhd_clm.blob_4383_a3|brcm/$FW_BASE.$BOARD.clm_blob"
      "firmware/bcmdhd_txcap.blob_4383_a3|brcm/$FW_BASE.$BOARD.txcap_blob"
      "firmware/brcm/BCM.hcd|brcm/BCM.$BOARD.hcd"
      "firmware/aoc.bin|aoc-tegu.bin"
      "firmware/cs40l26.wmfw|cs40l26.wmfw"
      "firmware/cs40l26.bin|cs40l26.bin"
      "firmware/cs40l26-svc.bin|cs40l26-svc.bin"
      "firmware/cs40l26-dvl.bin|cs40l26-dvl.bin"
      "firmware/cs40l26-calib.wmfw|cs40l26-calib.wmfw"
    ) ;;
  husky)
    # Pixel 8 Pro: Wi-Fi (BCM4398 D0) only, with the NVRAM for the SKU's
    # region (the header).
    BOARD="google,zuma-husky"
    DEVICE="husky"
    FW_BASE="brcmfmac4398d0-pcie"
    WIFI_CHIP="4398d0"
    BT_CHIP=""
    # Google's SKU table (dhd_custom_google.c); husky's vendor has NVRAMs for
    # MMW, ROW and NA only, so the others take the module's default, as on stock
    case $SKU in
      G9S9B|G8V0U|GFQM1|GB62Z|GE2AE|GQML3|GKWS6|G1MNW) nvram=bcmdhd.cal_MMW ;;
      GB7N6|GLU0G|GNA8F|GX7AS|GP4BC|GVU6C|GPJ41|GC3VE) nvram=bcmdhd.cal_ROW ;;
      G9BQD) nvram=bcmdhd.cal_NA ;;
      *) nvram=bcmdhd.cal_USI_G5SN_9957_V17 ;;
    esac
    MAP=(
      "firmware/fw_bcmdhd.bin_4398_d0|brcm/$FW_BASE.$BOARD.bin"
      "firmware/$nvram|brcm/$FW_BASE.$BOARD.txt"
      "firmware/bcmdhd_clm.blob_4398_d0|brcm/$FW_BASE.$BOARD.clm_blob"
      "firmware/bcmdhd_txcap.blob_4398_d0|brcm/$FW_BASE.$BOARD.txcap_blob"
    ) ;;
  *) die "unknown device $DEVICE_OPT (cheetah, panther, raven, tegu or husky)" ;;
esac
[[ $DEVICE == husky || -z $SKU ]] || die "-s is for husky only"
# The camera data flow (tools/extract-camera-data) exists for cheetah only
[[ $DEVICE == cheetah || -z $CAMERA_APEX ]] || die "-c is cheetah's (no camera support for $DEVICE yet)"
SRC=$(readlink -f "$1")
[[ -f "$SRC" ]] || die "no such file: $1"
# Absolute, because the checksum step runs from inside the staging dir
OUT=$(realpath -m -- "$OUT")
# Publishing replaces whole directories under OUT, so OUT=/ would replace this
# machine's own; refuse before anything is written (WORK included)
[[ $OUT != / ]] || die "-o resolves to /: publishing would replace this machine's own directories"
[[ -z $CAMERA_APEX || ( -d $(dirname -- "$CAMERA_APEX") && ! -d $CAMERA_APEX ) ]] ||
  die "-c needs a file name in an existing directory: $CAMERA_APEX"
case $CAMERA_APEX in
  "$OUT/$DEST_REL"/*|"$OUT/usr/share/omamobile/sensors"/*|"$OUT/vendor-firmware.sha256")
    die "-c must not be inside the outputs this script replaces in $OUT" ;;
esac

if [[ -n "$WORK" ]]; then
  mkdir -p "$WORK"
  WORK=$(mktemp -d "$WORK/xvf.XXXXXX")
else
  WORK=$(mktemp -d "${TMPDIR:-/tmp}/xvf.XXXXXX")
fi
stage="" cam_new="" publishing="" aside=() published=()
# A failed publish puts the previous outputs back (restore); only if that
# fails too does the staging directory stay, holding them.
restore() {
  local p
  for p in "${published[@]}"; do rm -rf -- "${OUT:?}/$p" || return 1; done
  for p in "${aside[@]}"; do mv -T -- "$stage/old/$p" "$OUT/$p" || return 1; done
}
cleanup() {
  [[ -z $cam_new ]] || rm -f -- "$cam_new"
  if [[ -n $publishing ]] && ! restore; then
    printf 'error: publishing failed; the previous outputs are in %s\n' "$stage/old" >&2
  else
    [[ -z $publishing ]] || printf 'error: publishing failed; the previous outputs are back in place\n' >&2
    [[ -z $stage ]] || rm -rf "$stage"
  fi
  rm -rf "$WORK"
}
trap cleanup EXIT

# Read 4 bytes at an offset as a little-endian hex word.
magic_at() { od -An -tx4 -j "$2" -N4 "$1" | tr -d ' \n'; }

# A zip member whose name ends in $2 (first match), or nothing.
zip_member() { unzip -Z1 "$1" | grep -E "(^|/)$2\$" | head -1 || true; }

# Get vendor.img out of SOURCE into $WORK/vendor.img.
fetch_vendor() {
  local src=$1 m inner
  case "$(magic_at "$src" 0)" in
    04034b50) ;;                                  # zip
    *) cp --reflink=auto "$src" "$WORK/vendor.img"; return ;;
  esac
  need unzip "install unzip"
  # The outer factory zip wraps image-<device>-*.zip; the inner one has the images.
  inner=$(zip_member "$src" "image-[^/]*\.zip")
  if [[ -n "$inner" ]]; then
    say "Unpacking $inner from the factory zip"
    unzip -p "$src" "$inner" > "$WORK/image.zip"
    src="$WORK/image.zip"
  fi
  m=$(zip_member "$src" "android-info\.txt")
  if [[ -n "$m" && -z "$FORCE" ]]; then
    unzip -p "$src" "$m" | grep -cE "^require board=(.*\|)?$DEVICE(\|.*)?\$" >/dev/null ||
      die "this image is not for $DEVICE (android-info.txt); use -f to override"
  fi
  m=$(zip_member "$src" "vendor\.img")
  if [[ -n "$m" ]]; then
    say "Unpacking vendor.img"
    unzip -p "$src" "$m" > "$WORK/vendor.img"
    return
  fi
  m=$(zip_member "$src" "super\.img")
  [[ -n "$m" ]] || die "no vendor.img or super.img in $(basename "$src")"
  need lpunpack "install android-tools"
  say "Unpacking super.img and its vendor partition"
  unzip -p "$src" "$m" > "$WORK/super.img"
  if [[ "$(magic_at "$WORK/super.img" 0)" == ed26ff3a ]]; then
    need simg2img "install android-tools"
    simg2img "$WORK/super.img" "$WORK/super.raw" && mv "$WORK/super.raw" "$WORK/super.img"
  fi
  mkdir -p "$WORK/super"
  lpunpack -p vendor_a "$WORK/super.img" "$WORK/super" 2>/dev/null ||
    lpunpack -p vendor "$WORK/super.img" "$WORK/super"
  mv "$WORK/super/"vendor*.img "$WORK/vendor.img"
  rm -rf "$WORK/super" "$WORK/super.img"
}

fetch_vendor "$SRC"
img="$WORK/vendor.img"
if [[ "$(magic_at "$img" 0)" == ed26ff3a ]]; then
  need simg2img "install android-tools"
  say "Converting sparse vendor.img"
  simg2img "$img" "$img.raw" && mv "$img.raw" "$img"
fi

# Copy one file out of the vendor filesystem ($1, no leading /) to $2.
if [[ "$(od -An -tx2 -j 1080 -N2 "$img" | tr -d ' ')" == ef53 ]]; then
  need debugfs "install e2fsprogs"
  say "vendor.img is ext4; reading it with debugfs (no mount)"
  # debugfs exits 0 when a copy fails (a missing file, a short write on a
  # full disk) and says so on stderr: anything there but its banner, or
  # rdump's notes that it can't give the files the image's owners (as a
  # user), fails the copy. The copy goes to a new path, so no older file
  # can stand in for it.
  dfs() {
    local err line
    err=$(debugfs -R "$1" "$img" 2>&1 >/dev/null) || return 1
    while [[ -n $err ]]; do   # line by line in the shell: nothing here can fail
      line=${err%%$'\n'*}
      if [[ $err == *$'\n'* ]]; then err=${err#*$'\n'}; else err=""; fi
      case $line in
        "" | "debugfs "[0-9]*) ;;
        "dump_file: Operation not permitted while changing ownership of "*) ;;
        "rdump: Operation not permitted while changing ownership of "*) ;;
        *) return 1 ;;
      esac
    done
  }
  # debugfs splits its command at blanks: a host path goes in double
  # quotes, with any double quote in it doubled
  dq() { printf '"%s"' "${1//\"/\"\"}"; }
  get_file() { dfs "dump /$1 $(dq "$2")" && [[ -s "$2" ]]; }
  get_dir() { mkdir -p "$2" && dfs "rdump /$1 $(dq "$2")" && [[ -d "$2/$(basename "$1")" ]]; }
elif [[ "$(magic_at "$img" 1024)" == e0f5e1e2 ]]; then
  need fsck.erofs "install erofs-utils"
  say "vendor.img is EROFS; extracting it with fsck.erofs"
  fsck.erofs --extract="$WORK/vendor" --no-preserve "$img" >/dev/null
  get_file() { [[ -s "$WORK/vendor/$1" ]] && cp "$WORK/vendor/$1" "$2"; }
  get_dir() { [[ -d "$WORK/vendor/$1" ]] && mkdir -p "$2" && cp -r "$WORK/vendor/$1" "$2/"; }
else
  die "vendor.img is neither ext4 nor EROFS"
fi

# The board list in android-info.txt is shared by pantah devices; the vendor
# partition itself says which device it was built for.
if get_file build.prop "$WORK/build.prop"; then
  dev=$(sed -n 's/^ro.product.vendor.device=//p' "$WORK/build.prop" | head -1)
  [[ "$dev" == "$DEVICE" || -n "$FORCE" ]] ||
    die "vendor partition is for '${dev:-unknown}', not $DEVICE; use -f to override"
  say "Vendor partition: $(sed -n 's/^ro.vendor.build.fingerprint=//p' "$WORK/build.prop" | head -1)"
else
  [[ -n "$FORCE" ]] || die "build.prop can't be read from vendor.img; use -f to override"
fi

# The new generation: everything below is written into $new, which starts
# empty, so no file from an earlier run can stand in for a missing one.
mkdir -p "$OUT"
stage=$(mktemp -d "$OUT/.extract-vendor-firmware.XXXXXX")
new="$stage/new"
dest="$new/$DEST_REL"
for entry in "${MAP[@]}"; do
  from=${entry%%|*} to=${entry#*|}
  mkdir -p "$dest/$(dirname "$to")"
  get_file "$from" "$dest/$to" || die "/vendor/$from is missing from this image or could not be copied"
  chmod 0644 "$dest/$to"
  printf '  /vendor/%-28s -> /%s/%s\n' "$from" "$DEST_REL" "$to"
done

# The AoC's sensor registry (which sensors this board has, their buses and
# settings), read by omamobile-sensor-proxy; without it only virtual sensors.
# husky has no AoC driver yet, so it skips the registry.
if [[ $DEVICE != husky ]]; then
  reg="$new/usr/share/omamobile/sensors"
  get_dir etc/sensors/registry "$reg" ||
    die "/vendor/etc/sensors/registry is missing from this image or could not be copied"
  chmod -R u=rwX,go=rX "$reg"
  printf '  /vendor/%-28s -> /%s\n' "etc/sensors/registry/" "usr/share/omamobile/sensors/registry/"
fi

# The camera APEX goes to a new file beside -c, renamed into place below
if [[ -n $CAMERA_APEX ]]; then
  cam_new=$(mktemp "$CAMERA_APEX.XXXXXX")
  get_file apex/com.google.pixel.camera.hal.apex "$cam_new" ||
    die "/vendor/apex/com.google.pixel.camera.hal.apex is missing from this image or could not be copied"
  chmod 0644 "$cam_new"
fi

# Sanity checks: right chip, text NVRAM, Cirrus file formats.
brcm="$dest/brcm"
grep -aq "$WIFI_CHIP-roml" "$brcm/$FW_BASE.$BOARD.bin" ||
  die "fw_bcmdhd.bin is not a $WIFI_CHIP PCIe firmware"
[[ -z $BT_CHIP ]] || grep -aq "$BT_CHIP" "$brcm/BCM.$BOARD.hcd" ||
  die "BCM.hcd is not a $BT_CHIP Bluetooth patch"
grep -aq '^NVRAMRev=' "$brcm/$FW_BASE.$BOARD.txt" ||
  die "bcmdhd.cal does not look like a Broadcom text NVRAM"
wmfw_halo() { # WMFW, Halo core (4): what cs_dsp accepts for this part
  [[ "$(head -c4 "$dest/$1")" == WMFW && "$(od -An -tu1 -j10 -N1 "$dest/$1" | tr -d ' ')" == 4 ]] ||
    die "$1 is not a Halo Core WMFW firmware"
}
# The speaker amplifiers' protection firmware, on the CS35L41 phones
if [[ $DEVICE == cheetah || $DEVICE == panther || $DEVICE == raven ]]; then
  wmfw_halo "cirrus/cs35l41-dsp1-spk-prot-$DEVICE.wmfw"
  grep -aq 'FIRMWARE_HALO_CSPL' "$dest/cirrus/cs35l41-dsp1-spk-prot-$DEVICE.wmfw" ||
    die "cs35l41-dsp1-spk-prot.wmfw is not the CS35L41 speaker protection firmware"
  grep -aq 'CAL_CHECKSUM' "$dest/cirrus/cs35l41-dsp1-spk-prot-$DEVICE.wmfw" ||
    die "cs35l41-dsp1-spk-prot.wmfw has no calibration controls"
  cmp -s "$dest/cirrus/cs35l41-dsp1-spk-prot-$DEVICE-top.bin" "$dest/cirrus/cs35l41-dsp1-spk-prot-$DEVICE-bottom.bin" &&
    die "the top and bottom speaker tunings are the same file"
  for f in top bottom; do
    [[ "$(head -c4 "$dest/cirrus/cs35l41-dsp1-spk-prot-$DEVICE-$f.bin")" == WMDR ]] ||
      die "the $f speaker tuning is not a WMDR coefficient file"
  done
fi
# The CS40L26 haptics (the gs201 phones and tegu)
if [[ $DEVICE == cheetah || $DEVICE == panther || $DEVICE == tegu ]]; then
  for f in cs40l26.wmfw cs40l26-calib.wmfw; do wmfw_halo "$f"; done
  grep -aq 'FIRMWARE_CS40L26' "$dest/cs40l26.wmfw" ||
    die "cs40l26.wmfw is not a CS40L26 firmware"
  grep -aq 'BUZZ_EFFECTS2_BUZZ_LEVEL' "$dest/cs40l26.wmfw" ||
    die "cs40l26.wmfw has no buzz generator (cs40l26-vibra needs BUZZGEN)"
fi
# The gs201 phones' media deltas
if [[ $DEVICE == cheetah || $DEVICE == panther ]]; then
  # The media deltas: comma-separated integers, the first the word count
  # (vendor mixer_paths.xml "speaker-post"; Google's cs35l41 driver parses them)
  for f in top bottom; do
    python3 -I -c 'import sys; w = [int(x) for x in open(sys.argv[1]).read().replace(" ", "").strip().split(",")]; sys.exit(w[0] != len(w))' \
      "$dest/cirrus/cs35l41-$DEVICE-$f-media-delta.txt" || die "the $f media delta is not a word list"
  done
fi
if [[ $DEVICE == cheetah || $DEVICE == panther || $DEVICE == tegu ]]; then
  for f in cs40l26.bin cs40l26-svc.bin cs40l26-dvl.bin; do
    [[ "$(head -c4 "$dest/$f")" == WMDR ]] || die "$f is not a WMDR coefficient file"
  done
fi

ver=$(grep -ao 'Version=[0-9.]* ([^)]*)' "$brcm/$FW_BASE.$BOARD.bin" | head -1)
bt=""
[[ -z $BT_CHIP ]] || bt=$(grep -ao "$BT_CHIP [^[]*" "$brcm/BCM.$BOARD.hcd" | head -1)
(cd "$dest" && find . -type f -printf '%P\n' | sort | xargs sha256sum -- > "$new/vendor-firmware.sha256")
# The checksum list names exactly the mapped files
for entry in "${MAP[@]}"; do printf '%s\n' "${entry#*|}"; done | sort > "$stage/expected"
cut -c67- "$new/vendor-firmware.sha256" | cmp -s - "$stage/expected" ||
  die "the staged firmware is not exactly the mapped files"

say "Wi-Fi firmware: ${ver:-unknown version}"
if [[ $DEVICE == husky ]]; then
  say "NVRAM: /vendor/firmware/$nvram${SKU:+ (SKU $SKU)}"
  [[ -n $SKU ]] || say "No -s SKU: stock's default NVRAM; pass the phone's SKU for its region's"
fi
[[ -z $BT_CHIP ]] || say "Bluetooth patch: ${bt:-unknown version}"
[[ $DEVICE == cheetah || $DEVICE == panther || $DEVICE == tegu ]] &&
  say "Haptics firmware: cs40l26.wmfw ($(stat -c %s "$dest/cs40l26.wmfw") bytes) and its wavetable"
[[ $DEVICE == tegu ]] &&
  say "AoC firmware: aoc-tegu.bin ($(stat -c %s "$dest/aoc-tegu.bin") bytes)"
[[ $DEVICE == cheetah || $DEVICE == panther || $DEVICE == raven ]] &&
  say "Speaker protection: cs35l41-dsp1-spk-prot-$DEVICE.wmfw and the top and bottom tunings"
# Publish: move the previous outputs aside, then the new ones into place, all
# renames within OUTDIR, then the -c file. A failed move puts it all back.
publishing=1
for p in "$DEST_REL" usr/share/omamobile/sensors vendor-firmware.sha256; do
  if [[ -e $OUT/$p || -L $OUT/$p ]]; then   # -L: a dangling symlink too
    mkdir -p "$stage/old/$(dirname "$p")"
    mv -T -- "$OUT/$p" "$stage/old/$p"
    aside+=("$p")
  fi
  if [[ -e $new/$p ]]; then
    mkdir -p "$OUT/$(dirname "$p")"
    mv -T -- "$new/$p" "$OUT/$p"
    published+=("$p")
  fi
done
if [[ -n $CAMERA_APEX ]]; then
  mv -fT -- "$cam_new" "$CAMERA_APEX"
  cam_new=""
fi
publishing=""   # published: nothing below may undo it
[[ -z $CAMERA_APEX ]] || say "Camera HAL APEX copied to $CAMERA_APEX"
say "Staged in $OUT (checksums in $OUT/vendor-firmware.sha256)"
echo "This is Google's proprietary firmware from your own factory image. Do not redistribute it."
