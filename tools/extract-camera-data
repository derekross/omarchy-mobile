#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""
extract-camera-data: build a camera's sensor data file from the user's own
phone software.

The Sony IMX386 (the Pixel 7 Pro ultrawide) needs a manufacturer-specific
initialisation and readout-mode register settings that are not public. The
stock camera HAL carries them, built at run time by small functions in
liblyric_hwl.so. This tool runs those functions in an AArch64 CPU emulator
(unicorn), on the user's machine, reads back the register lists they build
and writes them, with the mode geometry computed from the standard CCS
registers in each list, into the data file the imx386 kernel driver loads
(/usr/lib/firmware/omamobile/camera/imx386-uw.bin).

Nothing from Google's software is stored in the Omarchy Mobile repository: this
tool only knows how to find the functions (CAMERA-PLAN.md section 5.3). The
output is for the user's own phone; don't redistribute it.

The Samsung sensors work the same way: the main camera's S5KGN1
(s5kgn1-main.bin), the front S5K3J1 (s5k3j1-front.bin) and the telephoto
S5KGM5 (s5kgm5-tele.bin). Each one's default initialisation and mode
lists are found from its model-ID function through the sensor driver's
virtual table (for the 3J1, through the settings object its driver holds),
the HAL's static initialisers that build the mode lists are run, and the
output is data file version 2 (16-bit values).

Every run also writes the DC-PHY receive settings (gs201-dcphy.bin), for
D-PHY and C-PHY links alike: the HAL's PHY setup function is run once per
rate with a stand-in register writer that records what it writes; the
writes that change with the rate become a rate table. The kernel's PHY
driver needs this file for every camera.

From the Pixel 9a's HAL (zumapro) the same pass writes zumapro-dcphy.bin
in the same format, found automatically: there the HAL's CSIS PHY/link
context is run once per rate and its PHY transaction recorded, with the
receive equaliser at the HAL's defaults for a camera without a preset
(see ZumaproPhy). For the PHY file alone, give --sensor none.

Usage:
  tools/extract-camera-data --apex PATH/com.google.pixel.camera.hal.apex [-d DIR]
  tools/extract-camera-data --hal PATH/liblyric_hwl.so [-d DIR]
  tools/extract-camera-data --hal ... --sensor imx386|s5kgn1|s5k3j1|s5kgm5|imx712|s5kgn8|none [-o OUT]
      [--phy-output OUT | --no-phy] [--with-pd] [--list]
The Pixel 9a's ultrawide, a Sony IMX712 (imx712-uw.bin), is found the same
way as the Samsung parts (its driver's virtual table) and written as data
file version 1; give it with --sensor imx712 --no-phy. Its main camera, a
Samsung S5KGN8 (s5kgn8-main.bin, data file version 2), is found as the
S5K3J1 is, through the settings object its driver holds: --sensor s5kgn8
--no-phy.

Without --sensor it writes all four sensors' files and the PHY file into
DIR; install them in /usr/lib/firmware/omamobile/camera/.

Needs python3 with the unicorn and pyelftools packages, for example in a
virtual environment:
  python3 -m venv ~/.cache/omamobile-venv
  ~/.cache/omamobile-venv/bin/pip install unicorn pyelftools
  ~/.cache/omamobile-venv/bin/python tools/extract-camera-data --hal ...
--apex also needs unzip and debugfs (e2fsprogs).
"""

import argparse
import hashlib
import os
import struct
import subprocess
import sys
import tempfile

try:
    import unicorn
    from unicorn import arm64_const as A
    from elftools.elf.elffile import ELFFile
except ImportError as e:
    sys.exit(f"error: {e}; install unicorn and pyelftools (see --help)")

# The sensor's model-ID function in the HAL: "bti c; mov w0, #0x386; ret".
# The 16 bytes before it are the mode-list function: it picks one of three
# builders by its argument (0, 2, other).
MODEL_ID_FN = bytes.fromhex("5f2403d5c0708052c0035fd6")
CHIP_ID = 0x0386

STACK_BASE, STACK_SIZE = 0x7000_0000, 0x0020_0000
HEAP_BASE, HEAP_SIZE = 0x5000_0000, 0x1000_0000
TLS_BASE = 0x6000_0000
TRAP_BASE = 0x6800_0000
IMPORT_DATA = 0x6900_0000   # zero-filled stand-ins for imported data
RET_TRAP = TRAP_BASE + 0xfff0

FW_MAGIC = 0x5343534F  # "OSCS"
FW_VERSION = 1
EXCK_HZ = 24_576_000   # the board's sensor clock (stock: CIS_CLK0 from the oscillator)


def die(msg):
    sys.exit(f"error: {msg}")


class Emu:
    def __init__(self, path):
        self.data = open(path, "rb").read()
        self.elf = ELFFile(open(path, "rb"))
        self.uc = unicorn.Uc(unicorn.UC_ARCH_ARM64, unicorn.UC_MODE_ARM)
        # The library uses Armv8.3 RCpc loads (LDAPR) on its static-guard
        # bytes; the default CPU model faults on them.
        self.uc.ctl_set_cpu_model(A.UC_CPU_ARM64_MAX)
        top = 0
        for seg in self.elf.iter_segments():
            if seg["p_type"] == "PT_LOAD":
                top = max(top, seg["p_vaddr"] + seg["p_memsz"])
        top = (top + 0xFFFF) & ~0xFFFF
        self.uc.mem_map(0, top)
        for seg in self.elf.iter_segments():
            if seg["p_type"] == "PT_LOAD":
                self.uc.mem_write(seg["p_vaddr"], seg.data())
        self.uc.mem_map(STACK_BASE, STACK_SIZE)
        self.uc.mem_map(HEAP_BASE, HEAP_SIZE)
        self.uc.mem_map(TLS_BASE, 0x10000)
        self.uc.mem_map(TRAP_BASE, 0x10000)
        self.uc.mem_map(IMPORT_DATA, 0x100000)
        self.import_next = IMPORT_DATA
        self.heap = HEAP_BASE
        self.allocs = []
        self.traps = {}
        self.handlers = {}
        self.unknown_calls = set()
        self._bind_plt()
        self._bind_dyn()
        self.uc.hook_add(unicorn.UC_HOOK_CODE, self._on_trap,
                         begin=TRAP_BASE, end=TRAP_BASE + 0xFFFF)

    def _bind_plt(self):
        """Point every PLT slot at a trap address so imported calls stop here."""
        rela = self.elf.get_section_by_name(".rela.plt")
        dynsym = self.elf.get_section_by_name(".dynsym")
        if rela is None or dynsym is None:
            die("no .rela.plt/.dynsym: not the expected library")
        for i, rel in enumerate(rela.iter_relocations()):
            name = dynsym.get_symbol(rel["r_info_sym"]).name
            trap = TRAP_BASE + 16 * (i + 1)
            self.traps[trap] = name
            self.uc.mem_write(rel["r_offset"], struct.pack("<Q", trap))

    def _bind_dyn(self):
        """Apply .rela.dyn (Android packed APS2): imported data symbols point
        at zero-filled stand-ins, imported functions at traps, relative
        relocations at load base 0."""
        sec = self.elf.get_section_by_name(".rela.dyn")
        dynsym = self.elf.get_section_by_name(".dynsym")
        if sec is None:
            return
        raw = sec.data()
        if raw[:4] != b"APS2":
            return
        pos = 4

        def sleb():
            nonlocal pos
            result = shift = 0
            while True:
                b = raw[pos]
                pos += 1
                result |= (b & 0x7F) << shift
                shift += 7
                if not b & 0x80:
                    if b & 0x40:
                        result -= 1 << shift
                    return result

        count, offset = sleb(), sleb()
        info = addend = 0
        done = 0
        stand_ins = {}
        while done < count:
            gsize, gflags = sleb(), sleb()
            by_info, by_off, by_add, has_add = (gflags & 1, gflags & 2, gflags & 4,
                                                gflags & 8)
            goff = sleb() if by_off else 0
            if by_info:
                info = sleb()
            if has_add and by_add:
                addend += sleb()
            elif not has_add:
                addend = 0
            for _ in range(gsize):
                offset += goff if by_off else sleb()
                if not by_info:
                    info = sleb()
                if has_add and not by_add:
                    addend += sleb()
                rtype, rsym = info & 0xFFFFFFFF, info >> 32
                if rtype == 1027:                       # R_AARCH64_RELATIVE
                    val = addend
                elif rtype in (257, 1025):             # ABS64, GLOB_DAT
                    sym = dynsym.get_symbol(rsym)
                    if sym["st_shndx"] != "SHN_UNDEF":
                        val = sym["st_value"] + addend
                    else:
                        key = sym.name
                        if key not in stand_ins:
                            if sym["st_info"]["type"] == "STT_FUNC":
                                trap = TRAP_BASE + 0x8000 + 16 * len(stand_ins)
                                self.traps[trap] = key
                                stand_ins[key] = trap
                            else:
                                stand_ins[key] = self.import_next
                                self.import_next += 0x100
                        val = stand_ins[key] + addend
                else:
                    continue
                self.uc.mem_write(offset, struct.pack("<Q", val & (2**64 - 1)))
            done += gsize

    def _alloc(self, size):
        addr = self.heap
        self.heap += (max(size, 1) + 0x3F) & ~0x3F
        if self.heap > HEAP_BASE + HEAP_SIZE:
            raise RuntimeError("emulated heap exhausted")
        self.allocs.append((addr, size))
        return addr

    def _on_trap(self, uc, addr, size, _):
        if addr == RET_TRAP:
            uc.emu_stop()
            return
        name = self.traps.get(addr, "?")
        x0, x1, x2 = (uc.reg_read(r) for r in (A.UC_ARM64_REG_X0, A.UC_ARM64_REG_X1,
                                                 A.UC_ARM64_REG_X2))
        ret = 0
        if name in self.handlers:
            ret = self.handlers[name](uc)
        elif name in ("_Znwm", "_Znam", "malloc"):
            ret = self._alloc(x0)
        elif name == "calloc":
            ret = self._alloc(x0 * x1)
        elif name in ("memcpy", "memmove", "__memcpy_chk", "__memmove_chk"):
            uc.mem_write(x0, bytes(uc.mem_read(x1, x2)))
            ret = x0
        elif name in ("memset", "__memset_chk"):
            uc.mem_write(x0, bytes([x1 & 0xFF]) * x2)
            ret = x0
        elif name in ("_ZdlPv", "_ZdaPv", "free", "_ZdlPvm"):
            pass
        elif name == "__cxa_guard_acquire":
            # 1: "initialise it now", so a function-local static list is
            # built by the function that returns it
            ret = 1
        elif name == "__stack_chk_fail":
            raise RuntimeError("stack check failed in emulation")
        else:
            self.unknown_calls.add(name)
        uc.reg_write(A.UC_ARM64_REG_X0, ret)
        uc.reg_write(A.UC_ARM64_REG_PC, uc.reg_read(A.UC_ARM64_REG_LR))

    def call(self, fn, *args):
        uc = self.uc
        uc.reg_write(A.UC_ARM64_REG_SP, STACK_BASE + STACK_SIZE - 0x1000)
        uc.reg_write(A.UC_ARM64_REG_TPIDR_EL0, TLS_BASE + 0x1000)
        uc.reg_write(A.UC_ARM64_REG_LR, RET_TRAP)
        for i, v in enumerate(args):
            uc.reg_write(A.UC_ARM64_REG_X0 + i, v)
        uc.emu_start(fn, RET_TRAP, count=50_000_000)
        return uc.reg_read(A.UC_ARM64_REG_X0)

    def read(self, addr, size):
        return bytes(self.uc.mem_read(addr, size))

    def u64(self, addr):
        return struct.unpack("<Q", self.read(addr, 8))[0]


def find_function_start(emu, addr):
    """Walk back to the function's first instruction (paciasp or bti c)."""
    d = emu.data
    for a in range(addr & ~3, max(addr - 0x10000, 0), -4):
        ins = struct.unpack_from("<I", d, a)[0]
        if ins in (0xD503233F, 0xD503245F):   # paciasp, bti c
            prev = struct.unpack_from("<I", d, a - 4)[0]
            if prev not in (0xD503233F, 0xD503245F):
                return a
    return None


def branch_target(word, pc):
    if word & 0xFC000000 in (0x14000000, 0x94000000):   # b / bl
        imm = word & 0x3FFFFFF
        if imm & (1 << 25):
            imm -= 1 << 26
        return pc + 4 * imm
    return None


def _bl_name(emu, a):
    t = branch_target(struct.unpack_from("<I", emu.data, a)[0], a)
    if t is None or struct.unpack_from("<I", emu.data, a)[0] & 0xFC000000 != 0x94000000:
        return None
    # a PLT stub: adrp x16; ldr x17, [x16, #off]; add; br x17
    w0, w1 = struct.unpack_from("<II", emu.data, t)
    if w0 & 0x9F00001F != 0x90000010:
        return None
    immlo, immhi = (w0 >> 29) & 3, (w0 >> 5) & 0x7FFFF
    page = (t & ~0xFFF) + (((immhi << 2) | immlo) << 12)
    slot = page + ((w1 >> 10) & 0xFFF) * 8
    return emu.traps.get(emu.u64(slot))


def locate(emu):
    d = emu.data
    pos = d.find(MODEL_ID_FN)
    if pos < 0 or d.find(MODEL_ID_FN, pos + 1) >= 0:
        die("IMX386 model-ID function not found exactly once: unknown HAL version")
    # The mode dispatcher sits just before it: cbz w0, L0; cmp w0, #2;
    # b.ne Lx; b B2; L0: b B0; Lx: b Bx. Variant 0 is the cbz target's branch.
    b0 = None
    for a in range(pos - 0x40, pos, 4):
        w = struct.unpack_from("<I", d, a)[0]
        if w & 0xFF00001F == 0x34000000:        # cbz w0
            imm = (w >> 5) & 0x7FFFF
            tgt = a + 4 * (imm - (1 << 19) if imm & (1 << 18) else imm)
            b0 = branch_target(struct.unpack_from("<I", d, tgt)[0], tgt)
            break
    if b0 is None:
        die("mode dispatcher not found next to the model-ID function")

    # The init builders: nearby functions that allocate a vector header
    # (24 bytes) and then N * 16 bytes of {register, value} pairs.
    inits = []
    for a in range(pos - 0x20000, pos + 0x20000, 4):
        w = struct.unpack_from("<I", d, a)[0]
        if w != 0x52800300:                     # mov w0, #0x18
            continue
        if _bl_name(emu, a + 4) != "_Znwm":
            continue
        for k in range(2, 5):
            w2 = struct.unpack_from("<I", d, a + 4 * k)[0]
            if w2 & 0xFFE0001F == 0x52800000 and _bl_name(emu, a + 4 * k + 4) == "_Znwm":
                n = (w2 >> 5) & 0xFFFF
                if n % 16 == 0 and n >= 0x400:
                    fn = find_function_start(emu, a)
                    if fn is not None:
                        inits.append(fn)
                break
    return b0, sorted(set(inits))


def vec_triples(emu, base, size):
    """(begin, end) heap pointer pairs inside a struct that look like vectors."""
    out = []
    for off in range(0, size - 16, 8):
        b, e = emu.u64(base + off), emu.u64(base + off + 8)
        if HEAP_BASE <= b <= e < HEAP_BASE + HEAP_SIZE and (e - b) % 16 == 0 and e > b:
            out.append((off, b, e))
    return out


def read_regs(emu, b, e):
    regs = []
    for a in range(b, e, 16):
        reg, val = struct.unpack("<QQ", emu.read(a, 16))
        if reg > 0xFFFF or val > 0xFF:
            return None
        regs.append((reg, val))
    return regs


def regs_dict(regs):
    return {r: v for r, v in regs}


def r16(rd, a):
    return (rd.get(a, 0) << 8) | rd.get(a + 1, 0)


def mode_info(regs):
    rd = regs_dict(regs)
    w, h = r16(rd, 0x034C), r16(rd, 0x034E)
    fll, llp = r16(rd, 0x0340), r16(rd, 0x0342)
    pre_vt, mult_vt = rd.get(0x0305, 0), r16(rd, 0x0306)
    vt_pix, vt_sys = rd.get(0x0301, 0), rd.get(0x0303, 0)
    pre_op, mult_op = rd.get(0x030D, 0), r16(rd, 0x030E)
    op_sys = rd.get(0x030B, 0) or 1
    if not all((w, h, fll, llp, pre_vt, mult_vt, vt_pix, vt_sys, pre_op, mult_op)):
        return None
    # [I] 4 pixels per video timing clock: the frame rates this gives match
    # the HAL's own names for the modes (30 and 60 fps).
    pixel_rate = EXCK_HZ * mult_vt // pre_vt // (vt_pix * vt_sys) * 4
    lane_rate = EXCK_HZ * mult_op // pre_op // op_sys
    return dict(width=w, height=h, fll=fll, llp=llp, pixel_rate=pixel_rate,
                link_freq=lane_rate // 2, binning=rd.get(0x0900, 0),
                fps=pixel_rate / (fll * llp))


def build(hal, with_pd):
    emu = Emu(hal)
    b0, cands = locate(emu)
    # Of the candidate builders, the init lists are the ones that set the
    # sensor's external clock (0x0136); without PD is the shorter one.
    lists = []
    for fn in cands:
        vec = emu.call(fn)
        regs = read_regs(emu, emu.u64(vec), emu.u64(vec + 8))
        if regs and 0x0136 in regs_dict(regs) and 0x034C not in regs_dict(regs):
            lists.append(regs)
    if len(lists) != 2:
        die(f"expected two init lists, found {len(lists)}")
    lists.sort(key=len)
    init = lists[1 if with_pd else 0]

    modes_vec = emu.call(b0)
    begin, end = emu.u64(modes_vec), emu.u64(modes_vec + 8)
    modes = []
    stride = None
    # The mode records' size: the distance between two register vectors
    cand = vec_triples(emu, begin, end - begin)
    lists = [(off, b, e) for off, b, e in cand if read_regs(emu, b, e)]
    if not lists:
        die("no mode register lists found")
    for off, b, e in lists:
        regs = read_regs(emu, b, e)
        info = mode_info(regs)
        if info:
            modes.append((info, regs))
    if not modes:
        die("mode register lists without standard geometry registers")
    if emu.unknown_calls:
        print("note: imported calls ignored in emulation:",
              ", ".join(sorted(emu.unknown_calls)), file=sys.stderr)
    return init, modes


def write_fw(path, init, modes, chip_id=CHIP_ID, bayer=0):
    hdr_size = 28
    mode_size = 28
    regs_blob = bytearray()

    def add_regs(regs):
        off = len(regs_blob)
        for r, v in regs:
            if r == 0x0100:          # the driver starts streaming itself
                continue
            regs_blob.extend(struct.pack("<HBB", r, v, 0))
        return off, (len(regs_blob) - off) // 4

    base = hdr_size + mode_size * len(modes)
    init_off, init_n = add_regs(init)
    mode_recs = bytearray()
    for info, regs in modes:
        off, n = add_regs(regs)
        mode_recs += struct.pack("<HHHHIIBBHII", info["width"], info["height"],
                                 info["llp"], info["fll"], info["pixel_rate"],
                                 info["link_freq"], 10, info["binning"], 0,
                                 base + off, n)
    # IMX386: RGGB as read out with no flip [I]; analogue gain code 0..480 [I]
    hdr = struct.pack("<IHHHHHHHHII", FW_MAGIC, FW_VERSION, len(modes), chip_id,
                      bayer, 0, 480, 10, 0, base + init_off, init_n)
    assert len(hdr) == hdr_size and len(mode_recs) == mode_size * len(modes)
    with open(path, "wb") as f:
        f.write(hdr + mode_recs + regs_blob)


# --- Samsung S5KGN1 (main camera) -------------------------------------------

GN1_CHIP_ID = 0x08E1
GN1_MODEL_ID_FN = bytes.fromhex("5f2403d5") + struct.pack("<I", 0x52800000 | GN1_CHIP_ID << 5) \
    + bytes.fromhex("c0035fd6")
# The driver's virtual table, relative to its model-ID slot [HAL layout]:
# the init list selector and the mode list selector. Both pick a variant by
# debug flags in the driver object; with the flags clear they return the
# defaults.
GN1_SLOT_INIT = -1
GN1_SLOT_MODES = -4
GN1_THIS_SIZE = 0x4000
GN1_BAYER = 1           # GRBG [I: CAM-M checks it with the solid colour pattern]
GN1_AGAIN = (0x20, 0x200)
GN1_EXPOSURE_MARGIN = 16  # [I]
GN1_PIXELS_PER_CLOCK = 8  # [I: gives the frame rates the HAL names its modes with]
GN1_DROP = (0x0100, 0x6010)  # the driver writes streaming and the soft reset


def _section(emu, name):
    sec = emu.elf.get_section_by_name(name)
    if sec is None:
        die(f"no {name} section")
    return sec["sh_addr"], sec["sh_size"]


def read_regs16(emu, b, e):
    regs = []
    for a in range(b, e, 16):
        reg, val = struct.unpack("<QQ", emu.read(a, 16))
        if reg > 0xFFFF or val > 0xFFFF:
            return None
        regs.append((reg, val))
    return regs


def gn1_vtables(emu, fn):
    """Virtual tables that hold the model-ID function (several drivers of
    the same part may share it)."""
    base, size = _section(emu, ".data.rel.ro")
    blob = emu.read(base, size)
    key = struct.pack("<Q", fn)
    out, pos = [], blob.find(key)
    while pos >= 0:
        if pos % 8 == 0:
            out.append(base + pos)
        pos = blob.find(key, pos + 1)
    return out


def gn1_run_initialisers(emu, near):
    """Run the library's static initialisers close to the driver: one of
    them builds the default mode list. Failures are skipped."""
    base, size = _section(emu, ".init_array")
    ran = 0
    for i in range(size // 8):
        fn = emu.u64(base + 8 * i)
        if abs(fn - near) > 0x80000:
            continue
        try:
            emu.call(fn)
            ran += 1
        except unicorn.UcError:
            pass
    return ran


def gn1_mode_records(emu, begin, end):
    """Register lists inside the mode records, with their record stride."""
    lists = []
    for off, b, e in vec_triples(emu, begin, end - begin):
        regs = read_regs16(emu, b, e)
        if regs and 0x034C in dict(regs) and 0x0340 in dict(regs):
            lists.append((off, regs))
    return lists


def gn1_mode_info(init, regs):
    rd = dict(init)
    rd.update(dict(regs))
    w, h, fll, llp = rd.get(0x034C), rd.get(0x034E), rd.get(0x0340), rd.get(0x0342)
    pre, mult, vt_pix = rd.get(0x0304), rd.get(0x0306), rd.get(0x0300)
    if not all((w, h, fll, llp, pre, mult, vt_pix)):
        return None
    pixel_rate = EXCK_HZ * mult // pre // vt_pix * GN1_PIXELS_PER_CLOCK
    return dict(width=w, height=h, fll=fll, llp=llp, pixel_rate=pixel_rate,
                binning=rd.get(0x0900, 0) & 0xFF, fps=pixel_rate / (fll * llp))


def build_gn1(hal):
    emu = Emu(hal)
    d = emu.data
    fn = d.find(GN1_MODEL_ID_FN)
    if fn < 0 or d.find(GN1_MODEL_ID_FN, fn + 1) >= 0:
        die("S5KGN1 model-ID function not found exactly once: unknown HAL version")
    tables = gn1_vtables(emu, fn)
    if not tables:
        die("no virtual table holds the S5KGN1 model-ID function")
    gn1_run_initialisers(emu, fn)

    this = emu._alloc(GN1_THIS_SIZE)
    emu.uc.mem_write(this, bytes(GN1_THIS_SIZE))
    found = []
    for vt in tables:
        init_fn = emu.u64(vt + 8 * GN1_SLOT_INIT)
        modes_fn = emu.u64(vt + 8 * GN1_SLOT_MODES)
        try:
            ptr = emu.call(init_fn, this)
            count = emu.uc.reg_read(A.UC_ARM64_REG_X1)
            init = read_regs16(emu, ptr, ptr + 16 * count) if 0 < count < 20000 else None
            mptr = emu.call(modes_fn, this)
        except unicorn.UcError:
            continue
        if not init or 0x0136 not in dict(init):
            continue
        # The mode selector returns the records' begin; its vector's end is
        # the next word of the static vector it read. Find that vector.
        modes = None
        for a in range(HEAP_BASE, emu.heap, 8):
            if emu.u64(a) == mptr:
                end = emu.u64(a + 8)
                if mptr < end <= emu.heap:
                    modes = gn1_mode_records(emu, mptr, end)
                    if modes:
                        break
        if modes:
            found.append((init, modes))
    if not found:
        die("S5KGN1 init and mode lists not found")
    # The phone's own driver is the one whose init list sets C-PHY lanes
    # (0x0114) and whose modes all share it; take the first that does.
    found.sort(key=lambda f: dict(f[0]).get(0x0114) != 0x0201)   # 3 trios first
    init, lists = found[0]
    info_modes = []
    for _, regs in lists:
        info = gn1_mode_info(init, regs)
        if info:
            info_modes.append((info, regs))
    return init, info_modes, emu


def gn1_link_freq(init):
    """[I] Half the C-PHY symbol rate. The HAL's mode records carry a rate
    that the OP PLL registers don't explain to us; until CAM-M measures it,
    the device tree and this file use one fixed value."""
    return 931229968


# --- Samsung S5K3J1 (front) and S5KGM5 (telephoto) ----------------------------

# Per part: chip ID, Bayer order as read out without flips [I], analogue
# gain code range [I], exposure margin [I], the data file name, and the
# writes the kernel driver makes itself at the start of its init list
# (the soft reset), which must be the list's first entries.
SAMSUNG_PARTS = {
    "s5k3j1": dict(chip=0x30A1, bayer=1, again=(0x20, 0x200), margin=16,
                   out="s5k3j1-front.bin",
                   reset=[(0xFCFC, 0x4000), (0x6010, 0x0001)]),
    "s5kgm5": dict(chip=0x08D5, bayer=1, again=(0x20, 0x200), margin=16,
                   out="s5kgm5-tele.bin", reset=[]),
    # The Pixel 9a's main camera (stock sensor-barghest), model 0x08E8: its
    # init list starts with the soft reset through the direct page (10 ms
    # after it), its mode records have the IMX712's 1264-byte layout, and
    # each record carries the link's raw10 throughput, which gives the C-PHY
    # rate on its three trios (see samsung_mode_info).
    # RGGB [V: the colour bars on the Pixel 9a read red at (0,0), blue at (1,1)]
    "s5kgn8": dict(chip=0x08E8, bayer=0, again=(0x20, 0x200), margin=16,
                   out="s5kgn8-main.bin",
                   reset=[(0xFCFC, 0x4000), (0x6010, 0x0001)],
                   rec=(1264, 0x148), link_rec=0x150, trios=3),
}
SAMSUNG_THIS_SIZE = 0x4000
SAMSUNG_PAGE = 0xFCFC           # direct-access page; 0x4000 holds the CCS registers
SAMSUNG_CCS_PAGE = 0x4000
SAMSUNG_DELAY = 2**64 - 1       # a list record that is a delay in us, not a write
# The HAL's mode records [HAL layout]: 1424 bytes, the pixel rate (pixels/s)
# as a 32-bit word at 0x150. A part's "rec" overrides both.
SAMSUNG_REC_SIZE = 1424
SAMSUNG_REC_PIXEL_RATE = 0x150


def samsung_model_fn(emu, chip):
    pat = (bytes.fromhex("5f2403d5") + struct.pack("<I", 0x52800000 | chip << 5) +
           bytes.fromhex("c0035fd6"))
    fn = emu.data.find(pat)
    if fn < 0 or emu.data.find(pat, fn + 1) >= 0:
        die(f"model-ID function for 0x{chip:04x} not found exactly once: "
            "unknown HAL version")
    return fn


def samsung_delegate(emu, fn):
    """A selector that forwards to a settings object the driver holds:
    'bti c; ldr x0, [x0, #off]; ldr x8, [x0]; ldr x16, [x8, #slot]; br x16'.
    Returns (offset, slot) or None."""
    w = struct.unpack_from("<5I", emu.data, fn)
    if w[0] != 0xD503245F or w[1] & 0xFFC003FF != 0xF9400000 or \
            w[2] != 0xF9400008 or w[3] & 0xFFC003FF != 0xF9400110 or w[4] != 0xD61F0200:
        return None
    return ((w[1] >> 10) & 0xFFF) * 8, ((w[3] >> 10) & 0xFFF) * 8


def samsung_providers(emu, near, holder_off):
    """Virtual tables of the settings objects handed to the driver's
    constructor: the constructor stores its argument at holder_off, and its
    callers allocate the 8-byte object just before ('mov w0, #8; bl
    operator new; adrp x8; add x8, x8, #lo', the table at lo + 0x10)."""
    d = emu.data
    ctors = set()
    for a in range(near - 0x40000, near + 0x40000, 4):
        w = struct.unpack_from("<I", d, a)[0]
        if w & 0xFFC00000 == 0xF9000000 and ((w >> 10) & 0xFFF) * 8 == holder_off:
            fn = find_function_start(emu, a)
            if fn is not None:
                ctors.add(fn)
    text, size = _section(emu, ".text")
    words = struct.unpack_from(f"<{size // 4}I", d, text)
    found = []
    for i, w in enumerate(words):
        if w & 0xFC000000 != 0x94000000:
            continue
        pc = text + 4 * i
        if branch_target(w, pc) not in ctors:
            continue
        for k in range(i - 64, i):
            if words[k] & 0xFC000000 != 0x94000000 or \
                    _bl_name(emu, text + 4 * k) != "_Znwm" or \
                    0x52800100 not in words[k - 3:k]:
                continue
            adrp = [j for j in range(k + 1, k + 4) if words[j] & 0x9F00001F == 0x90000008]
            if not adrp:
                continue
            j = adrp[0]
            add = [words[m] for m in range(j + 1, j + 4)
                   if words[m] & 0xFFC003FF == 0x91000108]
            if not add:
                continue
            w, p = words[j], text + 4 * j
            page = (p & ~0xFFF) + ((((w >> 5) & 0x7FFFF) << 2 | (w >> 29) & 3) << 12)
            found.append(page + ((add[0] >> 10) & 0xFFF) + 0x10)
    if not found:
        found = _samsung_providers_built(emu, words, text, ctors)
    return sorted(set(found))


def _adrp_vtable(words, text, j):
    """The table address of 'adrp xN, page; add xN, xN, #lo; add xM, xN,
    #0x10' starting at word j, or None."""
    w = words[j]
    if w & 0x9F000000 != 0x90000000:
        return None
    rn = w & 0x1F
    p = text + 4 * j
    page = (p & ~0xFFF) + ((((w >> 5) & 0x7FFFF) << 2 | (w >> 29) & 3) << 12)
    for m in range(j + 1, min(j + 4, len(words))):
        a = words[m]
        if a & 0xFFC00000 == 0x91000000 and (a >> 5) & 0x1F == rn and a & 0x1F == rn:
            lo = (a >> 10) & 0xFFF
            for n in range(m + 1, min(m + 5, len(words))):
                b = words[n]
                if b & 0xFFC00000 == 0x91000000 and (b >> 5) & 0x1F == rn and \
                        (b >> 10) & 0xFFF == 0x10:
                    return page + lo + 0x10
            return None
    return None


def _samsung_providers_built(emu, words, text, ctors):
    """The settings object built away from 'operator new' (the Pixel 9a's
    GN8): the caller allocates a small object (8 to 64 bytes), then either
    stores a table it loads a few instructions later, or calls the object's
    own constructor, which stores it."""
    found = []
    for i, w in enumerate(words):
        if w & 0xFC000000 != 0x94000000 or \
                branch_target(w, text + 4 * i) not in ctors:
            continue
        for k in range(max(i - 96, 3), i):
            if words[k] & 0xFC000000 != 0x94000000 or \
                    _bl_name(emu, text + 4 * k) != "_Znwm":
                continue
            sizes = [(x >> 5) & 0xFFFF for x in words[k - 3:k]
                     if x & 0xFFE0001F == 0x52800000]
            if not sizes or not 8 <= sizes[-1] <= 0x40:
                continue
            for j in range(k + 1, min(k + 40, i)):
                vt = _adrp_vtable(words, text, j)
                if vt is not None:
                    found.append(vt)
                    break
                x = words[j]
                if x & 0xFC000000 == 0x94000000 and _bl_name(emu, text + 4 * j) is None:
                    ta = branch_target(x, text + 4 * j)
                    t = (ta - text) // 4
                    if ta in ctors or not 0 <= t < len(words):
                        continue
                    for m in range(t, min(t + 16, len(words))):
                        vt = _adrp_vtable(words, text, m)
                        if vt is not None:
                            found.append(vt)
                            break
                    if vt is not None:
                        break
    return found


def samsung_list(emu, ptr, count):
    """A {u64 register, u64 value} list; delay records become the delay (ms,
    rounded up) after the write before them."""
    out = []
    for a in range(ptr, ptr + 16 * count, 16):
        reg, val = struct.unpack("<QQ", emu.read(a, 16))
        if reg == SAMSUNG_DELAY:
            if not out or val > 255000:
                return None
            r, v, dly = out[-1]
            out[-1] = (r, v, min(255, dly + (val + 999) // 1000))
            continue
        if reg > 0xFFFF or val > 0xFFFF:
            return None
        out.append((reg, val, 0))
    return out


def samsung_mode_vector(emu, begin):
    """The [begin, end) vector a mode selector returned the begin of."""
    for a in range(HEAP_BASE, emu.heap, 8):
        if emu.u64(a) == begin:
            end = emu.u64(a + 8)
            if begin < end <= emu.heap:
                recs = gn1_mode_records(emu, begin, end)
                if recs:
                    return recs
    return None


def samsung_ccs(regs, page=SAMSUNG_CCS_PAGE):
    """The CCS registers a list leaves, following the page register; also
    the page it ends in."""
    view = {}
    for r, v, *_ in regs:
        if r == SAMSUNG_PAGE:
            page = v
        elif page == SAMSUNG_CCS_PAGE:
            view[r] = v
    return view, page


def samsung_candidates(emu, chip, rec_size=SAMSUNG_REC_SIZE):
    """(init, [(record address, mode list)]) per driver variant."""
    fn = samsung_model_fn(emu, chip)
    tables = gn1_vtables(emu, fn)
    if not tables:
        die(f"no virtual table holds the 0x{chip:04x} model-ID function")
    gn1_run_initialisers(emu, fn)
    out = []
    for vt in tables:
        init_sel = emu.u64(vt + 8 * GN1_SLOT_INIT)
        modes_sel = emu.u64(vt + 8 * GN1_SLOT_MODES)
        di, dm = samsung_delegate(emu, init_sel), samsung_delegate(emu, modes_sel)
        calls = []
        if di and dm and di[0] == dm[0]:
            for pvt in samsung_providers(emu, fn, di[0]):
                obj = emu._alloc(64)
                emu.uc.mem_write(obj, struct.pack("<Q", pvt))
                calls.append((emu.u64(pvt + di[1]), emu.u64(pvt + dm[1]), obj))
        else:
            this = emu._alloc(SAMSUNG_THIS_SIZE)
            emu.uc.mem_write(this, bytes(SAMSUNG_THIS_SIZE))
            calls.append((init_sel, modes_sel, this))
        for init_fn, modes_fn, obj in calls:
            try:
                ptr = emu.call(init_fn, obj)
                count = emu.uc.reg_read(A.UC_ARM64_REG_X1)
                init = samsung_list(emu, ptr, count) if 0 < count < 20000 else None
                begin = emu.call(modes_fn, obj)
            except unicorn.UcError:
                continue
            recs = samsung_mode_vector(emu, begin) if init else None
            if not recs:
                continue
            offs = [off for off, _ in recs]
            stride = offs[1] - offs[0] if len(offs) > 1 else rec_size
            if stride != rec_size or any(b - a != stride for a, b in
                                                 zip(offs, offs[1:])):
                die(f"mode records of {stride} bytes: unknown HAL version")
            first = offs[0] % stride
            out.append((init, [(begin + off - first, [(r, v, 0) for r, v in regs])
                               for off, regs in recs]))
    return out


def samsung_mode_info(emu, init, rec, regs, part=None):
    """Geometry from the CCS registers; the pixel rate from the HAL's mode
    record; the link rate (Mbps per lane, or Msps per trio) from the output
    PLL: EXCK x multiplier (0x0310) / pre-divider (0x030e) / post (0x0312) [I].
    A part with link_rec has the link's raw10 throughput (pixels/s) in its
    records [HAL layout, as the IMX712's]; on C-PHY trios that is
    throughput x 10 x 7/16 / trios symbols/s per trio, which must be the
    output PLL or twice it: the PLL value is taken."""
    p = part or {}
    pr_off = p.get("rec", (SAMSUNG_REC_SIZE, SAMSUNG_REC_PIXEL_RATE))[1]
    view, _ = samsung_ccs(init)
    mview, _ = samsung_ccs(regs)
    view.update(mview)
    w, h, fll, llp = (view.get(r) for r in (0x034C, 0x034E, 0x0340, 0x0342))
    pre, mult, post = view.get(0x030E), view.get(0x0310), view.get(0x0312) or 1
    if not all((w, h, fll, llp, pre, mult)):
        return None
    pixel_rate = struct.unpack("<I", emu.read(rec + pr_off, 4))[0]
    fps = pixel_rate / (fll * llp)
    if not 5 <= fps <= 480:
        die(f"mode {w}x{h}: pixel rate {pixel_rate} gives {fps:.1f} fps: "
            "unknown HAL version")
    rate_hz = EXCK_HZ * mult // pre // post
    if "rec" in p:
        # the record's first words: its minimum and maximum frame rate
        # (floats) and its output size [HAL layout]
        _, max_fps, rw, rh = struct.unpack("<ffII", emu.read(rec, 16))
        if (rw, rh) != (w, h) or abs(max_fps - fps) > fps / 200:
            die(f"mode {w}x{h}: the record says {rw}x{rh} at {max_fps:.2f} fps, "
                f"the registers {fps:.2f}: unknown HAL version")
    if "link_rec" in p:
        tput = struct.unpack("<I", emu.read(rec + p["link_rec"], 4))[0]
        sym = tput * 10 * 7 / 16 / p["trios"]
        for k in (1, 2):
            if abs(k * rate_hz - sym) <= sym / 1000:
                rate_hz *= k
                break
        else:
            die(f"mode {w}x{h}: the record's link ({sym / 1e6:.1f} Msps a trio) "
                f"doesn't match the output PLL ({rate_hz / 1e6:.1f} MHz): "
                "unknown HAL version")
    return dict(width=w, height=h, fll=fll, llp=llp, binning=view.get(0x0900, 0) & 0xFF,
                pixel_rate=pixel_rate, fps=fps, rate_hz=rate_hz)


def build_samsung(hal, part):
    p = SAMSUNG_PARTS[part]
    emu = Emu(hal)
    cands = samsung_candidates(emu, p["chip"], p.get("rec", (SAMSUNG_REC_SIZE,))[0])
    cands = [c for c in cands if len(c[0]) >= 100]
    if not cands:
        die(f"{part}: init and mode lists not found")
    # The camera's own driver has the most modes; others (a "virtual"
    # sensor sharing the model ID) have fewer or none.
    cands.sort(key=lambda c: -len(c[1]))
    if len(cands) > 1 and len(cands[0][1]) == len(cands[1][1]):
        die(f"{part}: {len(cands)} drivers with {len(cands[0][1])} modes, can't choose")
    init, recs = cands[0]
    n = len(p["reset"])
    if [(r, v) for r, v, _ in init[:n]] != p["reset"]:
        die(f"{part}: the init list doesn't start with the expected soft reset")
    if n and init[n - 1][2]:
        print(f"{part.upper()} soft reset: the HAL waits {init[n - 1][2]} ms after it")
    init = init[n:]
    modes = []
    for addr, regs in recs:
        info = samsung_mode_info(emu, init, addr, regs, p)
        if not info:
            continue
        modes.append((info, regs, addr))
    return init, modes, emu, cands[0]


def write_fw_v2(path, chip_id, bayer, again, margin, init, modes, link_freq=None):
    """Data file version 2 (16-bit values). Register entries are (address,
    value) or (address, value, delay in ms after the write); link_freq None
    takes each mode's own."""
    hdr_size, mode_size = 28, 28
    regs_blob = bytearray()

    def add_regs(regs):
        off = len(regs_blob)
        for r, v, *delay in regs:
            if r in GN1_DROP:
                continue
            regs_blob.extend(struct.pack("<HHBBH", r, v, delay[0] if delay else 0, 2, 0))
        return off, (len(regs_blob) - off) // 8

    base = hdr_size + mode_size * len(modes)
    init_off, init_n = add_regs(init)
    recs = bytearray()
    for info, regs in modes:
        off, n = add_regs(regs)
        recs += struct.pack("<HHHHIIBBHII", info["width"], info["height"], info["llp"],
                            info["fll"], info["pixel_rate"],
                            link_freq or info["link_freq"], 10,
                            info["binning"], 0, base + off, n)
    hdr = struct.pack("<IHHHHHHHHII", FW_MAGIC, 2, len(modes), chip_id, bayer,
                      again[0], again[1], margin, 0, base + init_off, init_n)
    with open(path, "wb") as f:
        f.write(hdr + recs + regs_blob)


# --- Sony IMX712 (Pixel 9a ultrawide; the front camera shares the part) -------

IMX712_CHIP_ID = 0x0712
IMX712_BAYER = 3                # BGGR, as the modes read out
# The HAL's mode records [HAL layout]: 1264 bytes apart; the record's own
# pixel rate (pixels/s) as a 32-bit word at 0x148 agrees with the CCS PLL.
IMX712_REC_SIZE = 1264
IMX712_REC_PIXEL_RATE = 0x148


def build_imx712(hal):
    """Init and mode lists of the IMX712 driver. Its virtual table has the
    Samsung parts' layout (init selector at slot -1, mode selector at -4);
    of the drivers that hold the model-ID function, the one whose selectors
    don't delegate returns the lists directly. Values are 8-bit (Sony CCS),
    the geometry and rates come from the standard registers as for the
    IMX386, and the record's pixel rate cross-checks them."""
    emu = Emu(hal)
    fn = samsung_model_fn(emu, IMX712_CHIP_ID)
    tables = gn1_vtables(emu, fn)
    if not tables:
        die("no virtual table holds the IMX712 model-ID function")
    gn1_run_initialisers(emu, fn)
    found = []
    for vt in tables:
        init_sel = emu.u64(vt + 8 * GN1_SLOT_INIT)
        modes_sel = emu.u64(vt + 8 * GN1_SLOT_MODES)
        if samsung_delegate(emu, init_sel) or samsung_delegate(emu, modes_sel):
            continue
        this = emu._alloc(SAMSUNG_THIS_SIZE)
        emu.uc.mem_write(this, bytes(SAMSUNG_THIS_SIZE))
        try:
            ptr = emu.call(init_sel, this)
            count = emu.uc.reg_read(A.UC_ARM64_REG_X1)
            init = read_regs(emu, ptr, ptr + 16 * count) if 0 < count < 20000 else None
            begin = emu.call(modes_sel, this)
        except unicorn.UcError:
            continue
        if not init or 0x0136 not in regs_dict(init):
            continue
        recs = samsung_mode_vector(emu, begin)
        if recs:
            found.append((init, begin, recs))
    if len(found) != 1:
        die(f"IMX712: {len(found)} drivers with lists, expected one: unknown HAL version")
    init, begin, recs = found[0]
    offs = [off for off, _ in recs]
    if any(b - a != IMX712_REC_SIZE for a, b in zip(offs, offs[1:])):
        die("IMX712 mode records not 1264 bytes apart: unknown HAL version")
    first = offs[0] % IMX712_REC_SIZE
    modes = []
    for off, regs in recs:
        if any(v > 0xFF for _, v in regs):
            die("IMX712 mode list with 16-bit values: unknown HAL version")
        merged = regs_dict(init)
        merged.update(regs_dict(regs))
        info = mode_info(list(merged.items()))
        if not info:
            continue
        rec = begin + off - first
        hal_rate = struct.unpack("<I", emu.read(rec + IMX712_REC_PIXEL_RATE, 4))[0]
        if abs(hal_rate - info["pixel_rate"]) > info["pixel_rate"] // 1000:
            die(f"IMX712 mode {info['width']}x{info['height']}: pixel rate "
                f"{info['pixel_rate']} vs the HAL's {hal_rate}: unknown HAL version")
        info["lanes"] = merged.get(0x0114, 0) + 1
        modes.append((info, regs))
    if not modes:
        die("IMX712 mode lists without standard geometry registers")
    return init, samsung_dedupe(modes)


# --- DC-PHY receive settings (every link, D-PHY and C-PHY) -------------------

DCPHY_MAGIC = 0x4850444F    # "ODPH", read by phy-gs201-mipi-dcphy-rx
DCPHY_VERSION = 1
DCPHY_DPHY, DCPHY_CPHY = 0, 1                       # section types
DCPHY_BIAS, DCPHY_LANE, DCPHY_CLOCK = 0, 1, 2       # register blocks
DCPHY_WRITE, DCPHY_UPDATE, DCPHY_RATE = 0, 1, 2     # operations
# The HAL's PHY setup function writes through a register-access object
# (HAL layout): region 10 is the DC-PHY, the bias block at 0x1000; from the
# link's base, its clock lane (D-PHY) and then one 0x100 block per data lane
# or trio. The access object's virtual table has a write at 0x60 and a
# masked write at 0x70. Its arguments: (this, lanes or trios, rate in Hz
# (signed 32-bit), C-PHY flag, base).
PHY_REGION = 0xA
PHY_SLOT_WRITE, PHY_SLOT_UPDATE = 0x60, 0x70
PHY_BIAS = 0x1000
PHY_LANE = 0x100
PHY_GNR_CON0 = 0x00         # lane enable
PHY_MAX_RATE = 2147         # Mbps or Msps: the rate argument is a signed 32-bit Hz count
PHY_MIN_RATE = {DCPHY_DPHY: 80, DCPHY_CPHY: 1}
PHY_MAX_LANES = {DCPHY_DPHY: 4, DCPHY_CPHY: 3}
PHY_OBJ_SIZE = 0x1000


def phy_candidates(emu):
    """gs201: functions that write a trio's register 0x64 (base + 0x100 +
    0x64) to region 10."""
    d = emu.data
    text, size = _section(emu, ".text")
    hits = set()
    for a in range(text, text + size - 16, 4):
        w = struct.unpack_from("<I", d, a)[0]
        # add w2, wN, #0x164
        if w & 0xFFFFFC1F != 0x11000000 | (0x164 << 10) | 2:
            continue
        near = struct.unpack_from("<8I", d, a - 16)
        if 0x52800001 | (PHY_REGION << 5) in near:      # mov w1, #10
            fn = find_function_start(emu, a)
            if fn is not None:
                hits.add(fn)
    return hits


def phy_locate(emu):
    """The PHY setup function: the only one that writes a trio's register
    0x64 (base + 0x100 + 0x64) to region 10."""
    hits = phy_candidates(emu)
    if len(hits) != 1:
        die(f"DC-PHY setup function: {len(hits)} candidates, expected one: "
            "unknown HAL version")
    return hits.pop()


def phy_run(emu, fn, kind, lanes, rate):
    """Run the setup once; returns [(slot, region, offset, value, mask)]."""
    calls = []

    def slot_handler(slot):
        def h(uc):
            r = [uc.reg_read(A.UC_ARM64_REG_X0 + i) & 0xFFFFFFFF for i in range(5)]
            calls.append((slot, r[1], r[2], r[3], r[4]))
            uc.mem_write(uc.reg_read(A.UC_ARM64_REG_X8), bytes(16))   # OK status
            return 0
        return h

    if not hasattr(emu, "phy_obj"):
        # One stand-in object: every word of 'this' points at it, every
        # word of it at its virtual table, whose slots are traps.
        vt = emu._alloc(0x200)
        dev = emu._alloc(PHY_OBJ_SIZE)
        this = emu._alloc(PHY_OBJ_SIZE)
        for off in range(0, 0x200, 8):
            trap = TRAP_BASE + 0xC000 + 2 * off
            emu.traps[trap] = f"phy-slot-{off:#x}"
            emu.uc.mem_write(vt + off, struct.pack("<Q", trap))
        emu.uc.mem_write(dev, struct.pack("<Q", vt) * (PHY_OBJ_SIZE // 8))
        emu.uc.mem_write(this, struct.pack("<Q", dev) * (PHY_OBJ_SIZE // 8))
        emu.phy_obj = this
    for off in range(0, 0x200, 8):
        emu.handlers[f"phy-slot-{off:#x}"] = slot_handler(off)
    emu.call(fn, emu.phy_obj, lanes, rate * 1_000_000, kind == DCPHY_CPHY, 0)
    return calls


def phy_ops(calls, kind, lanes):
    """The writes as (block, op, offset, value, mask), checked to come as
    bias, then the clock lane (D-PHY), then each lane with the same writes.
    The lane-disable writes ahead of the bias block are dropped: the driver
    turns the lanes off itself first. Returns one lane's operations."""
    out = []
    started = False
    for slot, region, off, val, mask in calls:
        if region != PHY_REGION:
            die(f"PHY setup wrote region {region}, expected {PHY_REGION}")
        if slot not in (PHY_SLOT_WRITE, PHY_SLOT_UPDATE):
            die(f"PHY setup: unexpected call slot {slot:#x}")
        if PHY_BIAS <= off < PHY_BIAS + PHY_LANE:
            block, lane, o = DCPHY_BIAS, None, off - PHY_BIAS
            started = True
        elif off < PHY_LANE * (lanes + 1):
            lane, o = divmod(off, PHY_LANE)
            block = DCPHY_CLOCK if lane == 0 else DCPHY_LANE
            lane -= 1
            if block == DCPHY_CLOCK and kind == DCPHY_CPHY:
                die("C-PHY setup wrote a clock lane")
        else:
            die(f"PHY setup wrote unexpected offset {off:#x}")
        if not started:
            if slot != PHY_SLOT_WRITE or o != PHY_GNR_CON0 or val:
                die("PHY setup: a write other than a lane disable before the bias block")
            continue
        if slot == PHY_SLOT_WRITE:
            out.append((block, lane, DCPHY_WRITE, o, val, 0))
        else:
            if not mask or val & ~mask:
                die(f"PHY setup: masked write {val:#x}/{mask:#x}")
            out.append((block, lane, DCPHY_UPDATE, o, val, mask))
    # order: bias, clock, lane 0, lane 1, ...
    order = [(b, -1 if ln is None else ln) for b, ln, *_ in out]
    rank = [(0 if b == DCPHY_BIAS else 1 if b == DCPHY_CLOCK else 2 + ln)
            for b, ln in order]
    if rank != sorted(rank):
        die("PHY setup: writes not in bias, clock lane, data lane order")
    per_lane = [[op[2:] for op in out if op[0] == DCPHY_LANE and op[1] == i]
                for i in range(lanes)]
    if any(p != per_lane[0] for p in per_lane) or not per_lane[0]:
        die("PHY setup: the lanes' writes differ")
    return ([(b, *op[2:]) for op in out for b in [op[0]] if b != DCPHY_LANE] +
            [(DCPHY_LANE, *op) for op in per_lane[0]])


def build_phy_section(emu, fn, kind):
    """One section: the operations, with the masked writes whose value
    changes with the rate as table columns, and the rate table."""
    lo = PHY_MIN_RATE[kind]
    runs = []
    for rate in range(lo, PHY_MAX_RATE + 1):
        runs.append((rate, phy_ops(phy_run(emu, fn, kind, 1, rate), kind, 1)))
    for rate in (lo, 1000, PHY_MAX_RATE):
        n = PHY_MAX_LANES[kind]
        if phy_ops(phy_run(emu, fn, kind, n, rate), kind, n) != \
                [r for r in runs if r[0] == rate][0][1]:
            die(f"PHY setup: {n} lanes differ from one at {rate}")
    ref = runs[0][1]
    shape = [(b, op, o, m) for b, op, o, v, m in ref]
    varying = set()
    for rate, ops in runs:
        if [(b, op, o, m) for b, op, o, v, m in ops] != shape:
            die(f"PHY setup: a different sequence at {rate}")
        for i, (r, x) in enumerate(zip(ref, ops)):
            if r[3] != x[3]:
                if r[1] != DCPHY_UPDATE:
                    die(f"PHY setup: a plain write changes with the rate at {rate}")
                varying.add(i)
    cols = sorted(varying)
    ops = []
    for i, (b, op, o, v, m) in enumerate(ref):
        if i in varying:
            ops.append((b, DCPHY_RATE, o, cols.index(i), m))
        else:
            ops.append((b, op, o, v, m))
    table = []
    for rate, run in runs:
        row = tuple(run[i][3] for i in cols)
        if not table or table[-1][1] != row:
            table.append((rate, row))
    return dict(kind=kind, ops=ops, table=table, cols=len(cols),
                min_rate=lo, max_rate=PHY_MAX_RATE)


def build_phy(hal, emu=None):
    emu = emu or Emu(hal)
    fn = phy_locate(emu)
    return [build_phy_section(emu, fn, k) for k in (DCPHY_DPHY, DCPHY_CPHY)]


def build_phy_auto(hal, ctle=None):
    """(soc, sections): gs201's setup function if the HAL has it, else
    zumapro's PHY/link context."""
    emu = Emu(hal)
    if len(phy_candidates(emu)) == 1:
        if ctle:
            die("--phy-camera is for the zumapro HAL")
        return "gs201", build_phy(hal, emu)
    if str_xrefs(emu, ZP_SETTLE_PROP):
        return "zumapro", build_phy_zumapro(emu, ctle)
    phy_locate(emu)         # the gs201 error


def phy_settle(sect, rate):
    """The settle count (TIME_CON0 7:0) at a rate, for the summary."""
    row = [r for m, r in sect["table"] if m <= rate][-1]
    for b, op, o, v, m in sect["ops"]:
        if b == DCPHY_LANE and o == 0x30 and m == 0xFF:
            return row[v] if op == DCPHY_RATE else v
    # zumapro: whole-register writes
    for b, op, o, v, m in sect["ops"]:
        if b == DCPHY_LANE and o == 0x30 and op != DCPHY_UPDATE:
            return (row[v] if op == DCPHY_RATE else v) & 0xFF
    return None


def phy_summary(sects):
    for s in sects:
        name = "D-PHY" if s["kind"] == DCPHY_DPHY else "C-PHY"
        unit = "Mbps" if s["kind"] == DCPHY_DPHY else "Msps"
        print(f"{name}: {len(s['ops'])} register writes, {s['cols']} by rate in "
              f"{len(s['table'])} ranges ({s['min_rate']}-{s['max_rate']} {unit})")
        for rate in ((1548, 1665) if s["kind"] == DCPHY_DPHY else (1802, 1862)):
            print(f"  settle at {rate} {unit}: {phy_settle(s, rate)}")


def write_phy(path, sects):
    blob = struct.pack("<IHHI", DCPHY_MAGIC, DCPHY_VERSION, len(sects), 0)
    for s in sects:
        blob += struct.pack("<BBHHHII", s["kind"], s["cols"], len(s["ops"]),
                            len(s["table"]), 0, s["min_rate"], s["max_rate"])
        for b, op, o, v, m in s["ops"]:
            blob += struct.pack("<BBHII", b, op, o, v, m)
        for rate, row in s["table"]:
            blob += struct.pack("<I", rate) + b"".join(struct.pack("<I", x) for x in row)
    with open(path, "wb") as f:
        f.write(blob)


# --- zumapro (Tensor G4, Pixel 9a) DC-PHY receive settings -------------------
#
# The zumapro HAL doesn't write the PHY through a setup function with the
# rate as an argument, as gs201's does. Its CSIS PHY/link context
# (zuma_csis_phy_link_context.cc) builds one LWIS transaction of plain
# register writes from fields of its own object: the link number, lane or
# trio count, MIPI rate and C-PHY flag, the receive equaliser (CTLE)
# settings, and the PHY's offset in the csis-link-phy window. The
# per-link lane blocks come from a table the library's static initialisers
# build. So the pass runs that function on a stand-in object, once per
# rate, and records the transaction's entries.
#
# HAL layout of the context object (checked against the function's code):
ZP_LINK = 0x480          # s32 link number, then s32 lanes or trios
ZP_RATE = 0x488          # s64 MIPI rate, bits (or symbols) per second
ZP_CPHY = 0x4A8          # u8 C-PHY
ZP_CTLE_EN = 0x4C8       # u8 receive CTLE enable
ZP_LINK_BASE = 0x4B8     # u64 the link's offset in csis-link-phy
ZP_PHY_BASE = 0x4C0      # u64 the PHY's offset in csis-link-phy
ZP_DEVICE = 0x538        # the LWIS device the transaction goes to
ZP_ZUMAPRO = 0x680       # u8 ro.board.platform is "zumapro" (the Pixel 9a)
ZP_OBJ_SIZE = 0x1000
# the CTLE preset's optional<u32> fields, in the protobuf's order:
# control_rout, nc_coef, cap_control, rsel_control, bias_control
# (the HAL logs them as CntRout, NcCoef, CapCnt, RselCnt, BiasCon)
ZP_CTLE_FIELDS = (0x4CC, 0x4D4, 0x4DC, 0x4E4, 0x4EC)
# A transaction entry: {u32 type, u32 block, u64 offset, u64 value, 16 bytes
# zero}; a plain write to block 1 (csis-link-phy) is type 2.
ZP_ENTRY = struct.pack("<II", 2, 1)
ZP_LINK_STAND_IN = 0x100000     # outside the PHY's offsets: link writes stand out
ZP_SETTLE_PROP = "vendor.camera.debug.rx_settle"
ZP_SETTLE_PROP2 = "vendor.camera.debug.use_settle_mode1"
ZP_CTLE_OFF_LOG = " Disable Rx CTLE settings"
ZP_RATES = {DCPHY_DPHY: (80, 4500), DCPHY_CPHY: (1, 3500)}
# Reference links for the data file: link 0 drives slave 0 (clock lane and
# four data lanes, or three trios); the others are cross-checked.
ZP_REF_LINK = 0
ZP_CHECK = {DCPHY_DPHY: ((1, 4), (2, 4), (4, 4), (6, 4), (5, 2), (7, 2), (10, 2)),
            DCPHY_CPHY: ((1, 3), (2, 3), (4, 3), (6, 3), (3, 1), (8, 1), (11, 1))}


def str_xrefs(emu, text_str):
    """Addresses of 'adrp xN; add xN, xN, #lo' pairs that point at the
    NUL-terminated string (any copy of it)."""
    d = emu.data
    key = text_str.encode() + b"\0"
    targets, pos = [], d.find(key)
    while pos >= 0:
        if pos and d[pos - 1] == 0:
            targets.append(pos)
        pos = d.find(key, pos + 1)
    text, size = _section(emu, ".text")
    out = []
    for t in targets:
        for rd in range(31):
            pat = struct.pack("<I", 0x91000000 | ((t & 0xFFF) << 10) | (rd << 5) | rd)
            a = d.find(pat, text, text + size)
            while a >= 0:
                if a % 4 == 0:
                    for back in range(1, 5):
                        w = struct.unpack_from("<I", d, a - 4 * back)[0]
                        if w & 0x9F00001F == 0x90000000 | rd:
                            immlo, immhi = (w >> 29) & 3, (w >> 5) & 0x7FFFF
                            imm = ((immhi << 2) | immlo) << 12
                            if imm & (1 << 32):
                                imm -= 1 << 33
                            if ((a - 4 * back) & ~0xFFF) + imm == t & ~0xFFF:
                                out.append(a - 4 * back)
                            break
                a = d.find(pat, a + 1, text + size)
    return out


def _function_end(emu, fn):
    """The next function's start: a paciasp or bti c after a return."""
    d = emu.data
    for a in range(fn + 4, fn + 0x10000, 4):
        if struct.unpack_from("<I", d, a)[0] in (0xD503233F, 0xD503245F):
            prev = struct.unpack_from("<I", d, a - 4)[0]
            if prev not in (0xD503233F, 0xD503245F):
                return a
    die("zumapro PHY function: no end found")


def _ldst_imm(w):
    """(kind, base, offset, rt) of an unsigned-offset load: ldrb, ldr w or
    ldrsw, ldr x."""
    for mask, op, kind, scale in ((0xFFC00000, 0x39400000, "ldrb", 1),
                                  (0xFFC00000, 0xB9400000, "ldrw", 4),
                                  (0xFFC00000, 0xB9800000, "ldrw", 4),     # ldrsw
                                  (0xFFC00000, 0xF9400000, "ldrx", 8)):
        if w & mask == op:
            return kind, (w >> 5) & 31, ((w >> 10) & 0xFFF) * scale, w & 31
    return None


def _cbz_target(w, pc):
    imm = (w >> 5) & 0x7FFFF
    if imm & 0x40000:
        imm -= 0x80000
    return pc + 4 * imm


def zp_locate(emu):
    """The PHY/link setup function (it reads both settle debug properties)
    and the CTLE defaults block of the caller (it ends where the caller
    logs " Disable Rx CTLE settings"). Returns (fn, end, frag, frag_end,
    frag_base_reg, cfg_delta)."""
    fns = [{find_function_start(emu, a) for a in str_xrefs(emu, p)} - {None}
           for p in (ZP_SETTLE_PROP, ZP_SETTLE_PROP2)]
    both = fns[0] & fns[1]
    if len(both) != 1:
        die(f"zumapro PHY function: {len(both)} candidates, expected one: "
            "unknown HAL version")
    fn = both.pop()
    end = _function_end(emu, fn)
    loads = set()
    for a in range(fn, end, 4):
        ld = _ldst_imm(struct.unpack_from("<I", emu.data, a)[0])
        if ld and ld[1] == 19:
            loads.add(ld[:3])
    need = {("ldrw", 19, ZP_LINK), ("ldrx", 19, ZP_RATE), ("ldrb", 19, ZP_CPHY),
            ("ldrb", 19, ZP_CTLE_EN), ("ldrx", 19, ZP_PHY_BASE),
            ("ldrx", 19, ZP_LINK_BASE), ("ldrx", 19, ZP_DEVICE),
            ("ldrb", 19, ZP_ZUMAPRO)}
    if not need <= loads:
        die("zumapro PHY function: its object layout differs: unknown HAL version")
    # The caller's defaults: ldrb wE, [xR, #en]; ldrb wC, [xR, #cphy];
    # cbz wE, T; cbz wC, T; T clears the enable ("str wzr, [xR, #en]").
    xr = str_xrefs(emu, ZP_CTLE_OFF_LOG)
    found = []
    for x in xr:
        for a in range(x - 0x800, x, 4):
            w = struct.unpack_from("<4I", emu.data, a)
            l1, l2 = _ldst_imm(w[0]), _ldst_imm(w[1])
            if not (l1 and l2 and l1[0] == l2[0] == "ldrb" and l1[1] == l2[1]):
                continue
            if w[2] & 0xFF00001F != 0x34000000 | l1[3] or \
                    w[3] & 0xFF00001F != 0x34000000 | l2[3]:
                continue
            t2, t3 = _cbz_target(w[2], a + 8), _cbz_target(w[3], a + 12)
            if t2 != t3 or not a < t2 < x:
                continue
            clear = 0xB9000000 | ((l1[2] // 4) << 10) | (l1[1] << 5) | 31
            if clear not in struct.unpack_from("<8I", emu.data, t2):
                continue
            found.append((a, x, l1[1], l1[2], l2[2]))
    if len(found) != 1:
        die(f"zumapro CTLE defaults: {len(found)} candidates, expected one: "
            "unknown HAL version")
    frag, frag_end, reg, en, cphy = found[0]
    if en - cphy != ZP_CTLE_EN - ZP_CPHY:
        die("zumapro CTLE defaults: the caller's layout differs: unknown HAL version")
    return fn, end, frag, frag_end, reg, cphy - ZP_CPHY


class ZumaproPhy:
    def __init__(self, emu):
        self.emu = emu
        (self.fn, self.end, self.frag, self.frag_end, self.frag_reg,
         self.delta) = zp_locate(emu)
        gn1_run_initialisers(emu, self.fn)      # the links' lane tables
        self.cfg = emu._alloc(ZP_OBJ_SIZE + self.delta)
        self.obj = self.cfg + self.delta
        self.dev = emu._alloc(ZP_OBJ_SIZE)
        self.entries = None

        def no_property(uc):                     # every debug property unset
            uc.mem_write(uc.reg_read(A.UC_ARM64_REG_X8), struct.pack("<QQ", 2, 0))
            return 0
        for name in set(emu.traps.values()):
            if "SystemProperties" in name and "GetAs" in name:
                emu.handlers[name] = no_property
        d = emu.data
        for a in range(self.fn, self.end, 4):
            if struct.unpack_from("<I", d, a)[0] & 0xFC000000 == 0x94000000:
                emu.uc.hook_add(unicorn.UC_HOOK_CODE, self._on_call, begin=a, end=a)

    def _on_call(self, uc, addr, size, _):
        if self.entries is None:
            return
        x0, x1 = uc.reg_read(A.UC_ARM64_REG_X0), uc.reg_read(A.UC_ARM64_REG_X1)
        if x0 == self.dev and not self.started:
            # the transaction builder: start with an empty one
            uc.mem_write(uc.reg_read(A.UC_ARM64_REG_X8), bytes(0x70))
            uc.reg_write(A.UC_ARM64_REG_PC, addr + 4)
            self.started = True
            return
        if x1 == self.dev and self.started:
            uc.emu_stop()                        # the PHY transaction is submitted
            self.done = True
            return
        try:
            e = bytes(uc.mem_read(x1, 40))
        except unicorn.UcError:
            return
        if e[:8] == ZP_ENTRY:
            off, val = struct.unpack_from("<QQ", e, 8)
            if any(e[24:]) or val >> 32:
                die("zumapro PHY: a transaction entry that isn't a plain write")
            self.entries.append((off, val))

    def run(self, kind, link, lanes, rate, ctle=None):
        """One rate: the PHY transaction's writes as [(offset, value)],
        offsets from the PHY block's base. ctle: a camera's preset (five
        values, ZP_CTLE_FIELDS order); the HAL uses one only on C-PHY and
        clears it on D-PHY."""
        emu, uc = self.emu, self.emu.uc
        uc.mem_write(self.cfg, bytes(ZP_OBJ_SIZE + self.delta))
        uc.mem_write(self.obj + ZP_CPHY, bytes([kind == DCPHY_CPHY]))
        if ctle and kind == DCPHY_CPHY:
            uc.mem_write(self.obj + ZP_CTLE_EN, b"\1")
            for off, v in zip(ZP_CTLE_FIELDS, ctle):
                uc.mem_write(self.obj + off, struct.pack("<IB", v, 1))   # optional<u32>
        else:
            # the caller's defaults with no CTLE preset for the camera
            uc.reg_write(A.UC_ARM64_REG_X0 + self.frag_reg, self.cfg)
            uc.reg_write(A.UC_ARM64_REG_SP, STACK_BASE + STACK_SIZE - 0x1000)
            uc.emu_start(self.frag, self.frag_end, count=10_000)
        uc.mem_write(self.obj + ZP_LINK, struct.pack("<ii", link, lanes))
        uc.mem_write(self.obj + ZP_RATE, struct.pack("<q", rate * 1_000_000))
        uc.mem_write(self.obj + ZP_LINK_BASE, struct.pack("<QQ", ZP_LINK_STAND_IN, 0))
        uc.mem_write(self.obj + ZP_DEVICE, struct.pack("<Q", self.dev))
        uc.mem_write(self.obj + ZP_ZUMAPRO, b"\1")
        uc.reg_write(A.UC_ARM64_REG_X8, emu._alloc(0x40))
        self.entries, self.started, self.done = [], False, False
        emu.call(self.fn, self.obj)
        out, self.entries = self.entries, None
        if not self.done or not out:
            die(f"zumapro PHY: link {link} at {rate}: no transaction: unknown HAL version")
        if any(off >= ZP_LINK_STAND_IN for off, _ in out):
            die("zumapro PHY: link registers in the PHY transaction")
        return out


def zp_ops(writes, kind, lanes):
    """Split the writes into the bias block, the clock lane, any partner
    clock lane and the data lanes or trios, checked as phy_ops does.
    Returns (one lane's ops as (block, op, offset, value, mask), the
    blocks: dict(clock=, partner=, lanes=[...]))."""
    started = False
    seq = []
    for off, val in writes:
        blk, o = off & ~0xFF, off & 0xFF
        if blk == PHY_BIAS:
            started = True
        elif not started:
            if o != PHY_GNR_CON0 or val:
                die("zumapro PHY: a write other than a lane disable before the bias block")
            continue
        seq.append((blk, o, val))
    order = []
    for blk, _, _ in seq:
        if blk != PHY_BIAS and blk not in order:
            order.append(blk)
    per = {b: [(o, v) for bb, o, v in seq if bb == b] for b in order}
    blocks = dict(clock=None, partner=None, lanes=[])
    rest = order
    if kind == DCPHY_DPHY:
        blocks["clock"], rest = order[0], order[1:]
        if rest and [o for o, _ in per[rest[0]]] == [PHY_GNR_CON0]:
            blocks["partner"], rest = rest[0], rest[1:]
            if per[blocks["partner"]][0][1] != per[blocks["clock"]][-1][1]:
                die("zumapro PHY: the partner clock lane's enable differs from the clock lane's")
    blocks["lanes"] = rest
    if len(rest) != lanes:
        die(f"zumapro PHY: {len(rest)} lane blocks for {lanes} lanes")
    rank = {PHY_BIAS: 0}
    if blocks["clock"] is not None:
        rank[blocks["clock"]] = 1
    if blocks["partner"] is not None:
        rank[blocks["partner"]] = 1
    for i, b in enumerate(rest):
        rank[b] = 2 + i
    ranks = [rank[b] for b, _, _ in seq]
    if ranks != sorted(ranks):
        die("zumapro PHY: writes not in bias, clock lane, data lane order")
    if any(per[b] != per[rest[0]] for b in rest):
        die("zumapro PHY: the lanes' writes differ")
    ops = [(DCPHY_BIAS, DCPHY_WRITE, o, v, 0) for b, o, v in seq if b == PHY_BIAS]
    if blocks["clock"] is not None:
        ops += [(DCPHY_CLOCK, DCPHY_WRITE, o, v, 0) for o, v in per[blocks["clock"]]]
    ops += [(DCPHY_LANE, DCPHY_WRITE, o, v, 0) for o, v in per[rest[0]]]
    return ops, blocks


def zp_section(zp, kind, ctle=None):
    """One section: as build_phy_section, but the HAL writes whole
    registers, so a register that changes with the rate becomes a rate
    column with a full mask."""
    lo, hi = ZP_RATES[kind]
    n = PHY_MAX_LANES[kind]
    runs = [(rate, zp_ops(zp.run(kind, ZP_REF_LINK, 1, rate, ctle), kind, 1)[0])
            for rate in range(lo, hi + 1)]
    ref = runs[0][1]
    shape = [(b, o) for b, _, o, _, _ in ref]
    varying = set()
    for rate, ops in runs:
        if [(b, o) for b, _, o, _, _ in ops] != shape:
            die(f"zumapro PHY: a different sequence at {rate}")
        varying |= {i for i, (r, x) in enumerate(zip(ref, ops)) if r[3] != x[3]}
    by_rate = dict(runs)
    for rate in (lo, 1000, hi):
        if zp_ops(zp.run(kind, ZP_REF_LINK, n, rate, ctle), kind, n)[0] != by_rate[rate]:
            die(f"zumapro PHY: {n} lanes differ from one at {rate}")
        for link, lanes in ZP_CHECK[kind]:
            ops, _ = zp_ops(zp.run(kind, link, lanes, rate, ctle), kind, lanes)
            if ops != by_rate[rate]:
                die(f"zumapro PHY: link {link} differs from link {ZP_REF_LINK} at {rate}")
    cols = sorted(varying)
    if len(cols) > 8:
        die(f"zumapro PHY: {len(cols)} registers change with the rate, the data file holds 8")
    ops = [(b, DCPHY_RATE, o, cols.index(i), 0xFFFFFFFF) if i in varying else (b, op, o, v, m)
           for i, (b, op, o, v, m) in enumerate(ref)]
    table = []
    for rate, run in runs:
        row = tuple(run[i][3] for i in cols)
        if not table or table[-1][1] != row:
            table.append((rate, row))
    if len(table) > 256:
        die(f"zumapro PHY: {len(table)} rate ranges, the data file holds 256")
    return dict(kind=kind, ops=ops, table=table, cols=len(cols), min_rate=lo, max_rate=hi)


def zp_layout(zp):
    """The lane blocks each checked link uses at 1000 Mbps or Msps, as
    [(kind, link, lanes, blocks)], offsets from the PHY block's base."""
    out = []
    for kind in (DCPHY_DPHY, DCPHY_CPHY):
        for link, lanes in ((ZP_REF_LINK, PHY_MAX_LANES[kind]), *ZP_CHECK[kind]):
            out.append((kind, link, lanes,
                        zp_ops(zp.run(kind, link, lanes, 1000), kind, lanes)[1]))
    return out


def zp_layout_summary(layout):
    for kind, link, lanes, b in layout:
        name = "D-PHY" if kind == DCPHY_DPHY else "C-PHY"
        parts = []
        if b["clock"] is not None:
            parts.append(f"clock {b['clock']:#x}")
        if b["partner"] is not None:
            parts.append(f"partner clock {b['partner']:#x}")
        parts.append("lanes " + " ".join(f"{x:#x}" for x in b["lanes"]))
        print(f"  link {link} {name} x{lanes}: " + ", ".join(parts))


def _pb_fields(buf):
    """A protobuf message's fields as [(number, value)]: varints as ints,
    length-delimited as bytes."""
    out, pos = [], 0

    def varint():
        nonlocal pos
        r = shift = 0
        while True:
            b = buf[pos]
            pos += 1
            r |= (b & 0x7F) << shift
            shift += 7
            if not b & 0x80:
                return r
    while pos < len(buf):
        key = varint()
        num, wt = key >> 3, key & 7
        if wt == 0:
            out.append((num, varint()))
        elif wt == 2:
            n = varint()
            out.append((num, buf[pos:pos + n]))
            pos += n
        else:
            die("PHY settings file: an unexpected field type")
    return out


PB_POSITIONS = ("rear", "front", "front_inner", "front_outer")
PB_LENSES = ("normal", "wide", "tele")


def ctle_preset(path, camera):
    """The CTLE preset for camera "POSITION/LENS" (e.g. rear/normal) from
    the HAL's etc/camera/csis_phy_link_phy_settings.binarypb
    (lyric.phy_settings.PhySettingsSet: 2 = PhySettings {1 position, 2 lens,
    3 ctle {3 control_rout, 4 nc_coef, 5 cap_control, 6 rsel_control,
    7 bias_control}, 4 alternative_ctle, 5 rx_eq, 6 rate map}), or None."""
    pos, _, lens = camera.partition("/")
    if pos not in PB_POSITIONS or lens not in PB_LENSES:
        die(f"--phy-camera {camera}: give POSITION/LENS, e.g. rear/normal")
    want = (PB_POSITIONS.index(pos), PB_LENSES.index(lens))
    for num, msg in _pb_fields(open(path, "rb").read()):
        if num != 2:
            continue
        f = dict(_pb_fields(msg))
        if (f.get(1, 0), f.get(2, 0)) != want:
            continue
        if any(k in f for k in (4, 5, 6)):
            die("PHY settings: an alternative CTLE or RX EQ preset, which this tool doesn't handle")
        if 3 not in f:
            return None
        c = dict(_pb_fields(f[3]))
        if any(k not in c for k in range(3, 8)):
            die("PHY settings: a CTLE preset with missing fields, which this tool doesn't handle")
        return tuple(c[k] for k in range(3, 8))
    return None


def build_phy_zumapro(emu, ctle=None):
    zp = ZumaproPhy(emu)
    sects = [zp_section(zp, k, ctle) for k in (DCPHY_DPHY, DCPHY_CPHY)]
    print("zumapro PHY lane blocks (from the PHY block's base):")
    zp_layout_summary(zp_layout(zp))
    return sects


def from_apex_settings(apex, tmp):
    out = os.path.join(tmp, "csis_phy_link_phy_settings.binarypb")
    subprocess.run(["debugfs", "-R",
                    f"dump /etc/camera/csis_phy_link_phy_settings.binarypb {out}",
                    os.path.join(tmp, "apex_payload.img")], check=True,
                   stderr=subprocess.DEVNULL)
    if not os.path.exists(out) or not os.path.getsize(out):
        die("csis_phy_link_phy_settings.binarypb not found in the APEX payload")
    return out


def from_apex(apex, tmp):
    subprocess.run(["unzip", "-q", "-o", apex, "apex_payload.img", "-d", tmp], check=True)
    out = os.path.join(tmp, "liblyric_hwl.so")
    subprocess.run(["debugfs", "-R", f"dump /lib64/liblyric_hwl.so {out}",
                    os.path.join(tmp, "apex_payload.img")], check=True,
                   stderr=subprocess.DEVNULL)
    if not os.path.getsize(out):
        die("liblyric_hwl.so not found in the APEX payload")
    return out


def samsung_dedupe(modes):
    """One mode per output size: the HAL's first (its default) of each."""
    seen, out = set(), []
    for m in modes:
        key = (m[0]["width"], m[0]["height"])
        if key not in seen:
            seen.add(key)
            out.append(m)
    return out


def run_imx386(hal, args, out):
    init, modes = build(hal, args.with_pd)
    print(f"IMX386 init: {len(init)} register writes{' (with PD)' if args.with_pd else ''}")
    for info, regs in modes:
        print(f"  mode {info['width']}x{info['height']}: {len(regs)} writes, "
              f"FLL {info['fll']} LLP {info['llp']}, pixel rate {info['pixel_rate']}, "
              f"link {info['link_freq']} Hz, {info['fps']:.1f} fps, binning {info['binning']}")
    if not args.list:
        write_fw(out, init, modes)
        print(f"wrote {out}: install as {FW_DIR}/imx386-uw.bin")


def run_s5kgn1(hal, args, out):
