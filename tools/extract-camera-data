def run_samsung(hal, args, out, part):
    p = SAMSUNG_PARTS[part]
    init, modes, _, _ = build_samsung(hal, part)
    modes = samsung_dedupe(modes)
    print(f"{part.upper()} init: {len(init)} register writes")
    for info, regs, _ in modes:
        # [I] D-PHY: the output PLL is the lane bit rate; C-PHY: the trio
        # symbol rate. The link frequency is half of it either way.
        info["link_freq"] = info["rate_hz"] // 2
        print(f"  mode {info['width']}x{info['height']}: {len(regs)} writes, "
              f"FLL {info['fll']} LLP {info['llp']}, pixel rate {info['pixel_rate']}, "
              f"{info['fps']:.1f} fps, link {info['link_freq']} Hz [I], "
              f"binning 0x{info['binning']:02x}")
    if not args.list:
        write_fw_v2(out, p["chip"], p["bayer"], p["again"], p["margin"], init,
                    [(i, r) for i, r, _ in modes])
        print(f"wrote {out}: install as {FW_DIR}/{p['out']}")


def run_imx712(hal, args, out):
    init, modes = build_imx712(hal)
    print(f"IMX712 init: {len(init)} register writes")
    for info, regs in modes:
        print(f"  mode {info['width']}x{info['height']}: {len(regs)} writes, "
              f"FLL {info['fll']} LLP {info['llp']}, pixel rate {info['pixel_rate']}, "
              f"link {info['link_freq']} Hz on {info['lanes']} lanes, "
              f"{info['fps']:.1f} fps, binning {info['binning']}")
    if not args.list:
        # BGGR [V: the solid colour test pattern on the Pixel 9a's ultrawide
        # reads blue/green on even rows, green/red on odd ones]
        write_fw(out, init, modes, IMX712_CHIP_ID, bayer=IMX712_BAYER)
        print(f"wrote {out}: install as {FW_DIR}/imx712-uw.bin")


SENSORS = {
    "imx386": ("imx386-uw.bin", run_imx386),
    "s5kgn1": ("s5kgn1-main.bin", run_s5kgn1),
    "s5k3j1": ("s5k3j1-front.bin", lambda h, a, o: run_samsung(h, a, o, "s5k3j1")),
    "s5kgm5": ("s5kgm5-tele.bin", lambda h, a, o: run_samsung(h, a, o, "s5kgm5")),
    "s5kgn8": ("s5kgn8-main.bin", lambda h, a, o: run_samsung(h, a, o, "s5kgn8")),

    "imx712": ("imx712-uw.bin", run_imx712),
}
# The Pixel 7 Pro's four; the Pixel 9a's are named one at a time.
ALL_SENSORS = ("imx386", "s5kgn1", "s5k3j1", "s5kgm5")
FW_DIR = "/usr/lib/firmware/omamobile/camera"


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    src = ap.add_mutually_exclusive_group(required=True)
    src.add_argument("--hal", help="liblyric_hwl.so from your own phone's camera HAL APEX")
    src.add_argument("--apex", help="com.google.pixel.camera.hal.apex from your own image")
    ap.add_argument("--sensor", choices=(*SENSORS, "all", "none"), default="all",
                    help="imx386 (ultrawide), s5kgn1 (main), s5k3j1 (front), "
                    "s5kgm5 (telephoto) or all (default: those four, the Pixel 7 "
                    "Pro); imx712 and s5kgn8 are the Pixel 9a ultrawide and "
                    "main cameras; none writes only "
                    "the DC-PHY file")
    ap.add_argument("-o", "--output", help="the sensor's data file (one sensor only)")
    ap.add_argument("-d", "--dir", default=".",
                    help="where the files go (default: the current directory)")
    ap.add_argument("--phy-output",
                    help="the DC-PHY settings file (default DIR/gs201-dcphy.bin, "
                    "or DIR/zumapro-dcphy.bin from a Pixel 9a HAL)")
    ap.add_argument("--no-phy", action="store_true", help="don't write the DC-PHY file")
    ap.add_argument("--phy-camera", metavar="POSITION/LENS",
                    help="zumapro: the DC-PHY file for one camera with its receive "
                    "equaliser preset (e.g. rear/normal, the Pixel 9a main camera), "
                    "written as zumapro-dcphy-POSITION-LENS.bin")
    ap.add_argument("--phy-settings",
                    help="the HAL's csis_phy_link_phy_settings.binarypb (read from "
                    "the APEX with --apex)")
    ap.add_argument("--with-pd", action="store_true",
                    help="imx386: the init settings with phase detection on (default off)")
    ap.add_argument("--list", action="store_true", help="only print what was found")
    args = ap.parse_args()
    os.makedirs(args.dir, exist_ok=True)
    names = (list(ALL_SENSORS) if args.sensor == "all" else
             [] if args.sensor == "none" else [args.sensor])
    if args.output and len(names) > 1:
        ap.error("-o needs one --sensor")

    with tempfile.TemporaryDirectory() as tmp:
        hal = from_apex(args.apex, tmp) if args.apex else args.hal
        print(f"HAL sha256 {hashlib.sha256(open(hal, 'rb').read()).hexdigest()}")
        for name in names:
            out = args.output or os.path.join(args.dir, SENSORS[name][0])
            SENSORS[name][1](hal, args, out)
        if not args.no_phy:
            ctle = None
            if args.phy_camera:
                settings = args.phy_settings or (args.apex and from_apex_settings(args.apex, tmp))
                if not settings:
                    ap.error("--phy-camera needs --phy-settings or --apex")
                ctle = ctle_preset(settings, args.phy_camera)
                print(f"{args.phy_camera}: " + ("a CTLE preset" if ctle else
                                               "no CTLE preset, the defaults"))
            soc, sects = build_phy_auto(hal, ctle)
            phy_summary(sects)
            if not args.list:
                name = f"{soc}-dcphy.bin"
                if args.phy_camera:
                    name = f"{soc}-dcphy-{args.phy_camera.replace('/', '-')}.bin"
                out = args.phy_output or os.path.join(args.dir, name)
                write_phy(out, sects)
                print(f"wrote {out}: install as {FW_DIR}/{name}")


if __name__ == "__main__":
    main()
