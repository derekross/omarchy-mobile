#!/bin/bash
# SPDX-License-Identifier: MIT
# omamobile: set up, sync and build Omarchy Mobile (LineageOS + Omarchy) in a container.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
source "$ROOT/omamobile.conf"
[[ -f "$ROOT/omamobile.local.conf" ]] && source "$ROOT/omamobile.local.conf"

usage() {
  cat <<EOF
Usage: lineage-ref <command>

  doctor   Check the host has what the build needs
  image    Build the Ubuntu build-environment image
  sync     Download or update the LineageOS source ($BRANCH) into $SRC_DIR
  build    Build Omarchy Mobile for $DEVICE ($VARIANT)
  shell    Open a shell in the build environment, in the source tree
EOF
}

say() { printf '\e[1m==> %s\e[0m\n' "$*"; }
die() { printf '\e[31merror:\e[0m %s\n' "$*" >&2; exit 1; }

# Run a command inside the build container, with the source tree, this repo and ccache mounted.
in_container() {
  local tty=()
  [[ -t 0 && -t 1 ]] && tty=(-it)
  # Create the mount point ourselves, or Docker makes it (and vendor/) root-owned.
  mkdir -p "$SRC_DIR/vendor/omamobile" "$CCACHE_DIR"
  docker run --rm "${tty[@]}" \
    --hostname omamobile-build \
    -v "$SRC_DIR:$SRC_DIR" \
    -v "$ROOT/vendor/omamobile:$SRC_DIR/vendor/omamobile" \
    -v "$CCACHE_DIR:/ccache" \
    -v "$ROOT/manifests:/omamobile-manifests:ro" \
    -e GIT_NAME="$(git config --global user.name)" \
    -e GIT_EMAIL="$(git config --global user.email)" \
    -w "$SRC_DIR" \
    "$IMAGE" bash -c '
      git config --global user.name "$GIT_NAME"
      git config --global user.email "$GIT_EMAIL"
      git config --global color.ui false
      git config --global trailer.changeid.key Change-Id
      git lfs install --skip-repo >/dev/null
      eval "$1"' _ "$1"
}

cmd_doctor() {
  local ok=1
  check() { if eval "$2" >/dev/null 2>&1; then printf '  \e[32m✓\e[0m %s\n' "$1"; else printf '  \e[31m✗\e[0m %s — %s\n' "$1" "$3"; ok=0; fi; }
  say "Host checks"
  check "docker usable"        "docker info"                 "start docker and add yourself to the docker group"
  check "adb installed"        "command -v adb"              "sudo pacman -S android-tools"
  check "fastboot installed"   "command -v fastboot"         "sudo pacman -S android-tools"
  check "git identity set"     "git config --global user.email" "git config --global user.email you@example.com"
  local dir="$SRC_DIR"
  while [[ ! -d "$dir" ]]; do dir="$(dirname "$dir")"; done
  check "400 GB free for source" "(( \$(df --output=avail -B1G '$dir' | tail -1) >= 400 ))" "free up disk or change SRC_DIR"
  local mem swap
  mem=$(awk '/MemTotal/ {print int($2/1048576)}' /proc/meminfo)
  swap=$(awk '/SwapTotal/ {print int($2/1048576)}' /proc/meminfo)
  printf '  • RAM %s GB + swap %s GB (LineageOS asks for 64 GB RAM; JOBS=%s)\n' "$mem" "$swap" "$JOBS"
  (( mem + swap >= 64 )) || { printf '  \e[33m!\e[0m add swap or zram, or lower JOBS\n'; }
  (( ok )) && say "Ready" || exit 1
}

cmd_image() {
  say "Building $IMAGE"
  docker build --build-arg UID="$(id -u)" --build-arg GID="$(id -g)" -t "$IMAGE" "$ROOT/docker"
}

cmd_sync() {
  local init="repo init -u https://github.com/LineageOS/android.git -b $BRANCH --git-lfs --no-clone-bundle"
  # repo records the tree's branch as the manifest project's default
  # branch. On another branch, re-run repo init with -b only, so the
  # manifest URL and --depth stay (repo resets manifest groups on any
  # init without -g); none recorded (an interrupted first init) means the
  # full init.
  local recorded
  recorded=$(git config --file "$SRC_DIR/.repo/manifests.git/config" --get branch.default.merge 2>/dev/null) || recorded=
  if [[ $recorded == "refs/heads/$BRANCH" ]]; then
    init=:
  elif [[ -n $recorded ]]; then
    say "$SRC_DIR follows ${recorded#refs/heads/}; switching it to $BRANCH"
    init="repo init -b $BRANCH"
  fi
  say "Syncing LineageOS $BRANCH into $SRC_DIR (first run downloads well over 100 GB)"
  in_container "
    set -e
    $init
    mkdir -p .repo/local_manifests
    cp /omamobile-manifests/*.xml .repo/local_manifests/
    repo sync
    source build/envsetup.sh
    breakfast $DEVICE $VARIANT
  "
}

cmd_build() {
  [[ -f "$SRC_DIR/build/envsetup.sh" ]] || die "no source tree yet; run: lineage-ref sync"
  say "Building $DEVICE ($VARIANT) with $JOBS jobs"
  in_container "
    set -e
    ccache -M $CCACHE_SIZE >/dev/null
    source build/envsetup.sh
    breakfast $DEVICE $VARIANT
    m -j$JOBS bacon
    echo
    ls -lh \$OUT/lineage-*.zip \$OUT/{boot,vendor_boot,dtbo,vendor_kernel_boot}.img 2>/dev/null || true
  "
}

cmd_shell() {
  in_container "source build/envsetup.sh 2>/dev/null; exec bash"
}

case "${1:-}" in
  doctor|image|sync|build|shell) "cmd_$1" ;;
  *) usage ;;
esac
