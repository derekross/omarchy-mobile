#!/bin/bash
# SPDX-License-Identifier: MIT
# omamobile: Omarchy Mobile development tool (native Omarchy on Pixel).
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
source "$ROOT/omamobile.conf"
[[ -f "$ROOT/omamobile.local.conf" ]] && source "$ROOT/omamobile.local.conf"

WORK="${WORK:-$HOME/android}"
KERNEL_DIR="${KERNEL_DIR:-$WORK/mainline/linux}"
KERNEL_OUT="${KERNEL_OUT:-$WORK/mainline/out}"
REFERENCE_DIR="${REFERENCE_DIR:-$WORK/reference}"
CLANG_DIR="${CLANG_DIR:-$(ls -d "$SRC_DIR"/prebuilts/clang/host/linux-x86/clang-r* 2>/dev/null | sort | tail -1 || true)}"

usage() {
  cat <<USAGE
Usage: [DEVICE=<codename>] omamobile <command>

  The device is $DEVICE (DEVICE, default from omamobile.conf); its values come
  from device/<codename>/device.conf (docs/RELEASES.md).

  capture [name]   Save what the connected phone exposes (Android over adb, or fastboot)
                   into $REFERENCE_DIR/<name>
  initramfs        Build the M1 initramfs (Alpine + dropbear + our init) into $KERNEL_OUT
  initramfs-config <dir>
                   Write only the device's files for the shared init (storage-guard
                   allowlist, trigger, ...) into <dir>, to check what initramfs packs
  kernel           Build the mainline kernel ($KERNEL_DIR) with our config fragment
  modules          Package the kernel's modules (stripped) as a tarball for the Arch
                   root: $KERNEL_OUT/modules-<release>.tar.zst, unpacked under
                   /usr/lib/modules on the phone
  modules-push     Stream that tarball to the running phone, unpack it into
                   /usr/lib/modules/<release> and run depmod (no reboot)
  images           Pack the device's boot images (BOOT_IMAGES: boot, vendor_boot and
                   dtbo, plus init_boot and vendor_kernel_boot where the device has
                   them) for the experiment slot into $KERNEL_OUT/images
  kexec            Send the freshly built kernel and initramfs to the running phone
                   and jump into them (no reboot or fastboot). Device tree changes
                   still need: omamobile images, then flash the image holding the
                   DTB (vendor_kernel_boot, or vendor_boot without it)
  fastboot         Get the phone into fastboot without buttons (adb, reboot-to,
                   or crash until ABL falls back to stock Android on slot A)
  flash            Flash the experiment images to slot B and boot them
  push             Write the images into slot B from the running phone over SSH,
                   verify them, and reboot into them (no fastboot)
  kernel-shell     Open a shell in the build environment, in the kernel tree
USAGE
}

say() { printf '\e[1m==> %s\e[0m\n' "$*"; }
die() { printf '\e[31merror:\e[0m %s\n' "$*" >&2; exit 1; }

# Every name a descriptor's UFS_RW may hold: slot B's boot images and
# userdata. Never persist, efs*, modem*, devinfo, vbmeta*, bootloader, radio
# or anything in slot A. initramfs/init's ufs_rw_load accepts the same set.
UFS_RW_ALLOWED="boot_b init_boot_b vendor_boot_b vendor_kernel_boot_b dtbo_b userdata"

# Load device/$DEVICE/device.conf into DEV_* variables. The descriptor is data,
# not shell: only KEY=value and KEY="value" lines, no $, backticks or
# backslashes, so other tools can read it too. Nothing in it is executed.
load_device() {
  local file="$ROOT/device/$DEVICE/device.conf" line n=0 key p
  local quoted='^([A-Z][A-Z0-9_]*)="([^"$`\\]*)"$' bare='^([A-Z][A-Z0-9_]*)=([^"$`\\'"'"'[:space:]]*)$'
  DEV_BOOT_METHOD=android-v4  # legacy descriptors omit it
  [[ $DEVICE =~ ^[a-z0-9]+$ ]] || die "DEVICE must be a codename, not '$DEVICE'"
  [[ -f $file ]] || die "no device descriptor $file (see docs/RELEASES.md)"
  while IFS= read -r line || [[ -n $line ]]; do
    n=$((n + 1))
    [[ $line =~ ^[[:space:]]*(#.*)?$ ]] && continue
    if [[ $line =~ $quoted || $line =~ $bare ]]; then
      printf -v "DEV_${BASH_REMATCH[1]}" '%s' "${BASH_REMATCH[2]}"
    else
      die "$file:$n: not a KEY=value line"
    fi
  done < "$file"
  [[ $DEV_BOOT_METHOD == android-v4 ]] \
    || die "$file: unsupported BOOT_METHOD=$DEV_BOOT_METHOD; this command supports only android-v4"
  for key in CODENAME SOC PACKAGE DTB DTBO_SOURCE DTBO_BOARD_ID DTBO_BOARD_REV VENDOR_CMDLINE \
      VENDOR_PAGESIZE OS_VERSION OS_PATCH_LEVEL BOOT_IMAGES UFS_RW INITRAMFS_INIT PANEL_SIZE; do
    p="DEV_$key"
    [[ -n ${!p:-} ]] || die "$file: $key is missing"
  done
  # ABL picks the base DTB by /soc_id (gs101, gs201) or by /soc_compatible
  # (zuma): a descriptor names exactly one of the two.
  if [[ -n ${DEV_SOC_IDS:-} && -n ${DEV_SOC_COMPATIBLE:-} ]]; then
    die "$file: SOC_IDS and SOC_COMPATIBLE are exclusive; name the one this bootloader matches on"
  elif [[ -z ${DEV_SOC_IDS:-} && -z ${DEV_SOC_COMPATIBLE:-} ]]; then
    die "$file: SOC_IDS is missing (or SOC_COMPATIBLE, for a bootloader that matches /soc_compatible)"
  fi
  local sc='^[a-z0-9]+(-[a-z0-9]+)*:0x[0-9a-f]+:[0-9]+:[0-9]+:[0-9]+$' labels=" "
  for p in ${DEV_SOC_COMPATIBLE:-}; do
    [[ $p =~ $sc ]] || die "$file: SOC_COMPATIBLE entries are label:product_id:major:minor:pkg_mode, not $p"
    # One child node per entry: the label names it, so it must be unique
    [[ $labels != *" ${p%%:*} "* ]] || die "$file: SOC_COMPATIBLE names ${p%%:*} twice"
    labels+="${p%%:*} "
  done
  [[ $DEV_CODENAME == "$DEVICE" ]] || die "$file: CODENAME=$DEV_CODENAME, expected $DEVICE"
  # Safety: the guard's allowlist may name slot B's boot images and userdata
  # only, must hold userdata, and every boot image we write must be on it.
  # initramfs packs this list into the image, and the init checks it again.
  local rw_chars='^[a-z0-9_ ]+$' seen_rw=" "
  [[ $DEV_UFS_RW =~ $rw_chars ]] || die "$file: UFS_RW may hold only partition names ([a-z0-9_]) separated by spaces"
  for p in $DEV_UFS_RW; do
    [[ $p == *_b || $p == userdata ]] || die "$file: UFS_RW may hold only *_b partitions and userdata, not $p"
    [[ " $UFS_RW_ALLOWED " == *" $p "* ]] \
      || die "$file: UFS_RW may hold only slot B boot images ($UFS_RW_ALLOWED), not $p"
    [[ $seen_rw != *" $p "* ]] || die "$file: UFS_RW names $p twice"
    seen_rw+="$p "
  done
  [[ $seen_rw == *" userdata "* ]] || die "$file: UFS_RW must include userdata"
  for p in $DEV_BOOT_IMAGES; do slot_b_allowed "$p" || die "$file: ${p}_b is not in UFS_RW"; done
  # images builds one of two layouts from these names: a typo must not
  # quietly pick the other one.
  local seen=" "
  for p in $DEV_BOOT_IMAGES; do
    [[ " boot init_boot vendor_boot vendor_kernel_boot dtbo " == *" $p "* ]] \
      || die "$file: BOOT_IMAGES may hold only boot, init_boot, vendor_boot, vendor_kernel_boot and dtbo, not $p"
    [[ $seen != *" $p "* ]] || die "$file: BOOT_IMAGES names $p twice"
    seen+="$p "
  done
  for p in boot vendor_boot dtbo; do
    [[ $seen == *" $p "* ]] || die "$file: BOOT_IMAGES must include $p"
  done
  # AVB hash footers, for a bootloader whose vbmeta chains these partitions
  # (zuma): image:partition_size, each a boot image, named once, the size
  # a whole number of 4 KiB blocks. Their rollback index and security patch
  # come with them, and only with them.
  local avb=" "
  for p in ${DEV_AVB_FOOTERS:-}; do
    # Short enough that no size wraps around 64 bits
    [[ $p =~ ^([a-z_]+):(0x[0-9a-f]{1,10}|[1-9][0-9]{0,11})$ ]] \
      || die "$file: AVB_FOOTERS entries are image:partition_size, not $p"
    [[ $seen == *" ${BASH_REMATCH[1]} "* ]] || die "$file: AVB_FOOTERS names ${BASH_REMATCH[1]}, which is not in BOOT_IMAGES"
    [[ $avb != *" ${BASH_REMATCH[1]} "* ]] || die "$file: AVB_FOOTERS names ${BASH_REMATCH[1]} twice"
    (( BASH_REMATCH[2] > 0 && BASH_REMATCH[2] % 4096 == 0 )) \
      || die "$file: AVB_FOOTERS: ${BASH_REMATCH[1]}'s partition size must be a positive multiple of 4096"
    avb+="${BASH_REMATCH[1]} "
  done
  if [[ -n ${DEV_AVB_FOOTERS:-} ]]; then
    [[ ${DEV_AVB_ROLLBACK_INDEX:-} =~ ^[0-9]+$ ]] || die "$file: AVB_FOOTERS needs AVB_ROLLBACK_INDEX (a number)"
    [[ ${DEV_AVB_SECURITY_PATCH:-} =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] \
      || die "$file: AVB_FOOTERS needs AVB_SECURITY_PATCH (YYYY-MM-DD)"
  elif [[ -n ${DEV_AVB_ROLLBACK_INDEX:-}${DEV_AVB_SECURITY_PATCH:-} ]]; then
    die "$file: AVB_ROLLBACK_INDEX and AVB_SECURITY_PATCH belong with AVB_FOOTERS"
  fi
}

# The images in $1 were built for $DEVICE: flash and push must not write
# another device's images (images records the codename in DEVICE).
images_for_device() {
  local got
  got=$(cat "$1/DEVICE" 2>/dev/null || true)
  [[ $got == "$DEVICE" ]] || die "$1 holds images for '${got:-an unknown device}', not $DEVICE (run: DEVICE=$DEVICE omamobile images)"
}

# Is <image>_b on the device's storage-guard allowlist?
slot_b_allowed() { [[ " $DEV_UFS_RW " == *" ${1}_b "* ]]; }

# Does the device have this boot image? gs101 phones have no init_boot or
# vendor_kernel_boot.
has_image() { [[ " $DEV_BOOT_IMAGES " == *" $1 "* ]]; }

# Run a command in the build container with the work tree and this repo mounted.
in_container() {
  local tty=()
  [[ -t 0 && -t 1 ]] && tty=(-it)
  docker run --rm "${tty[@]}" \
    --hostname omamobile-build \
    -v "$WORK:$WORK" -v "$ROOT:$ROOT" \
    -e PATH="$CLANG_DIR/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    -w "$KERNEL_DIR" \
    "$IMAGE" bash -c "$1"
}

cmd_capture() {
  local name="${1:-$DEVICE-$(date +%Y%m%d-%H%M)}" dir
  dir="$REFERENCE_DIR/$name"
  mkdir -p "$dir"
  if fastboot devices | grep -c . >/dev/null; then
    say "Capturing bootloader variables into $dir"
    fastboot -s "$(fastboot_serial)" getvar all > "$dir/fastboot-getvar-all.txt" 2>&1
  elif adb get-state >/dev/null 2>&1; then
    say "Capturing Android state into $dir"
    local root=""
    [[ "$(adb shell id -u)" == 0 ]] && root=1
    adb shell getprop > "$dir/getprop.txt"
    adb shell 'ls -l /dev/block/by-name/' > "$dir/partitions-by-name.txt"
    adb shell cat /proc/cpuinfo /proc/meminfo /proc/cmdline > "$dir/proc.txt" 2>&1
    adb shell 'ls -lR /vendor/lib/modules /vendor_dlkm/lib/modules' > "$dir/vendor-modules.txt" 2>&1
    if [[ -n "$root" ]]; then
      say "Root available: device tree, kernel log, modules, interrupts, memory map"
      adb shell cat /sys/firmware/fdt > "$dir/live.dtb"
      adb shell dmesg > "$dir/dmesg.txt"
      adb shell cat /proc/modules /proc/interrupts /proc/iomem > "$dir/proc-root.txt" 2>&1
      adb shell 'ls /vendor/firmware' > "$dir/vendor-firmware.txt" 2>&1
    else
      echo "  (no root: skipping device tree, dmesg and memory map)"
    fi
  else
    die "no phone found over adb or fastboot"
  fi
  ls -la "$dir"
}

cmd_kernel() {
  [[ -d "$KERNEL_DIR" ]] || die "no kernel tree at $KERNEL_DIR"
  [[ -n "$CLANG_DIR" ]] || die "no clang found; run 'lineage-ref sync' first or set CLANG_DIR"
  # The codename goes into a path below, as in load_device
  [[ $DEVICE =~ ^[a-z0-9]+$ ]] || die "DEVICE must be a codename, not '$DEVICE'"
  local fragment="$ROOT/device/$DEVICE/kernel.config"
  say "Building $KERNEL_DIR into $KERNEL_OUT"
  mkdir -p "$KERNEL_OUT"
  in_container "
    set -e
    make ARCH=arm64 LLVM=1 O=$KERNEL_OUT defconfig
    scripts/kconfig/merge_config.sh -m -O $KERNEL_OUT $KERNEL_OUT/.config $ROOT/kernel/configs/omamobile.config
    # The device's own options on top, where they would break another device
    if [ -f $fragment ]; then
      scripts/kconfig/merge_config.sh -m -O $KERNEL_OUT $KERNEL_OUT/.config $fragment
    fi
    make ARCH=arm64 LLVM=1 O=$KERNEL_OUT olddefconfig
    make ARCH=arm64 LLVM=1 O=$KERNEL_OUT -j$JOBS Image.gz dtbs modules
    ls -lh $KERNEL_OUT/arch/arm64/boot/Image.gz
    ls $KERNEL_OUT/arch/arm64/boot/dts/exynos/google/
  "
}

# Kernel release of the build in $KERNEL_OUT (what uname -r will print).
kernel_release() {
  [[ -f "$KERNEL_OUT/include/config/kernel.release" ]] || die "build the kernel first: omamobile kernel"
  cat "$KERNEL_OUT/include/config/kernel.release"
}

cmd_modules() {
  local rel stage="$KERNEL_OUT/modules-staging" tarball
  rel=$(kernel_release)
  tarball="$KERNEL_OUT/modules-$rel.tar.zst"
  say "Installing modules for $rel into $stage (stripped)"
  rm -rf "$stage" && mkdir -p "$stage"
  in_container "make ARCH=arm64 LLVM=1 O=$KERNEL_OUT INSTALL_MOD_PATH=$stage INSTALL_MOD_STRIP=1 modules_install >/dev/null"
  [[ -d "$stage/lib/modules/$rel" ]] || die "modules_install produced no lib/modules/$rel"
  # build/source point into this machine's kernel tree; useless on the phone
  rm -f "$stage/lib/modules/$rel/build" "$stage/lib/modules/$rel/source"
  # Paths in the tarball are relative to /usr/lib/modules: <release>/kernel/...
  tar -C "$stage/lib/modules" --owner=0 --group=0 --numeric-owner -cf - "$rel" | zstd -q -19 -T0 -f -o "$tarball"
  say "$(find "$stage/lib/modules/$rel" -name '*.ko*' | wc -l) modules"
  ls -lh "$tarball"
}

cmd_modules_push() {
  local rel tarball ssh="$ROOT/tools/phone-ssh" running
  rel=$(kernel_release)
  tarball="$KERNEL_OUT/modules-$rel.tar.zst"
  [[ -f "$tarball" ]] || die "missing $tarball (run: omamobile modules)"
  "$ssh" true || die "phone not reachable at 172.16.42.1"
  "$ssh" 'test -d /usr/lib/modules && command -v depmod >/dev/null' || die "phone is not in the Arch root (no /usr/lib/modules or depmod)"
  running=$("$ssh" 'uname -r')
  [[ "$running" == "$rel" ]] || echo "  note: phone runs $running; installing $rel for the next boot"
  say "Unpacking modules into /usr/lib/modules/$rel on the phone"
  # Replace the whole tree so modules dropped from the config don't linger
  "$ssh" "set -e; rm -rf /usr/lib/modules/.$rel.new; mkdir -p /usr/lib/modules/.$rel.new
    zstd -dc | tar -C /usr/lib/modules/.$rel.new -xf -
    rm -rf /usr/lib/modules/$rel; mv /usr/lib/modules/.$rel.new/$rel /usr/lib/modules/$rel
    rmdir /usr/lib/modules/.$rel.new; depmod -a $rel
    echo $(sha256sum < "$tarball" | cut -d' ' -f1) > /usr/lib/modules/$rel/.omamobile-tarball; sync" < "$tarball"
  "$ssh" "find /usr/lib/modules/$rel -name '*.ko*' | wc -l; ls /usr/lib/modules/$rel/modules.dep"
}

# The per-device files the shared init reads, written into $1 (the
# initramfs's /etc). Without $1 it only checks the descriptor's values.
initramfs_config() {
  local etc=${1:-} rw
  # Every board-specific step in the init checks the board against COMPATIBLE
  local board_step=""
  [[ -n ${DEV_SIMPLEFB_TRIG_CON:-}${DEV_BRINGUP_PROBE:-}${DEV_INITRAMFS_MODULES:-}${DEV_USB_SWITCH:-} ]] && board_step=1
  if [[ -n $board_step ]]; then
    [[ -n ${DEV_COMPATIBLE:-} ]] || die "COMPATIBLE is missing"
  fi
  if [[ -n ${DEV_USB_SWITCH:-} ]]; then
    [[ $DEV_USB_SWITCH =~ ^[0-9a-f]+\.i2c[[:space:]]+0x[0-9a-fA-F]{2}$ ]] \
      || die "USB_SWITCH must be \"<controller>.i2c 0xADDR\" (the MAX77759 TCPC)"
    [[ ${DEV_INITRAMFS_I2C_TOOLS:-} == 1 ]] || die "USB_SWITCH needs INITRAMFS_I2C_TOOLS=1"
  fi
  if [[ -n ${DEV_INITRAMFS_FB_WAIT:-} ]]; then
    [[ $DEV_INITRAMFS_FB_WAIT == 1 ]] || die "INITRAMFS_FB_WAIT must be 1 or absent"
  fi
  if [[ -n ${DEV_SIMPLEFB_TRIG_CON:-} ]]; then
    local rest=$DEV_SIMPLEFB_TRIG_CON trig_pairs=()
    while [[ -n $rest ]]; do
      [[ $rest =~ ^(0x[0-9a-fA-F]+)[[:space:]]+(0x[0-9a-fA-F]+)[[:space:]]*(.*)$ ]] \
        || die "SIMPLEFB_TRIG_CON must be \"0xADDR 0xVALUE\" pairs"
      trig_pairs+=("${BASH_REMATCH[1]} ${BASH_REMATCH[2]}")
      rest=${BASH_REMATCH[3]}
    done
    DEV_SIMPLEFB_TRIG_LINES=$(printf '%s\n' "${trig_pairs[@]}")
  fi
  if [[ -n ${DEV_BRINGUP_PROBE:-} ]]; then
    [[ $DEV_BRINGUP_PROBE == 1 ]] || die "BRINGUP_PROBE must be 1 or absent"
  fi
  # load_device has checked UFS_RW (names, slot B boot images, userdata);
  # pack it as one line with single spaces, the form the init accepts
  read -ra rw <<<"$DEV_UFS_RW"
  # The USB gadget's product string: USB_PRODUCT, else NAME. Neither: no
  # file, and the init says "Omarchy Mobile". A USB string descriptor holds
  # at most 126 characters; printable ASCII keeps it one plain line.
  local product=${DEV_USB_PRODUCT:-${DEV_NAME:-}}
  if [[ -n $product ]]; then
    if (( ${#product} > 126 )) || LC_ALL=C grep -q '[^ -~]' <<<"$product"; then
      die "USB_PRODUCT (or NAME) must be printable ASCII, at most 126 characters"
    fi
  fi
  [[ -n $etc ]] || return 0
  mkdir -p "$etc"

  # This device's simplefb triggers, and nothing else's. The init writes
  # each pair, and only when the board matches COMPATIBLE.
  # Absent or empty: it writes no display register. The bring-up probe,
  # the module loader and the USB switch use the same COMPATIBLE file, so it
  # is packed for any of them.
  if [[ -n $board_step ]]; then
    printf '%s\n' "$DEV_COMPATIBLE" > "$etc/omamobile-compatible"
  fi
  # The MAX77759 USB switch's I2C controller and address, for usb_switch
  if [[ -n ${DEV_USB_SWITCH:-} ]]; then
    printf '%s\n' "$DEV_USB_SWITCH" > "$etc/omamobile-usb-switch"
  fi
  # Draw the splash once fb0 exists rather than at once
  if [[ -n ${DEV_INITRAMFS_FB_WAIT:-} ]]; then
    : > "$etc/omamobile-fb-wait"
  fi
  if [[ -n ${DEV_SIMPLEFB_TRIG_CON:-} ]]; then
    printf '%s\n' "$DEV_SIMPLEFB_TRIG_LINES" > "$etc/omamobile-simplefb-trig"
  fi
  # DPP and watchdog reads. Off unless the descriptor asks, and the init
  # still refuses them when the board does not match COMPATIBLE.
  if [[ -n ${DEV_BRINGUP_PROBE:-} ]]; then
    : > "$etc/omamobile-bringup-probe"
  fi
  # The storage guard's allowlist. Without this file the init leaves every
  # partition read-only.
  printf '%s\n' "${rw[*]}" > "$etc/omamobile-ufs-rw"
  if [[ -n $product ]]; then
    printf '%s\n' "$product" > "$etc/omamobile-usb-product"
  fi
}

cmd_initramfs_config() {
  [[ -n ${1:-} ]] || die "usage: omamobile initramfs-config <dir>"
  load_device
  initramfs_config "$1"
  ls -l "$1"
}

cmd_initramfs() {
  local dl="$WORK/downloads/alpine" stage="$KERNEL_OUT/initramfs" ver=3.24.2
  load_device
  # A leading slash is repo-root relative, so devices share initramfs/init.
  # Anything else is relative to device/<codename>/.
  local init
  if [[ $DEV_INITRAMFS_INIT == /* ]]; then
    init="$ROOT$DEV_INITRAMFS_INIT"
  else
    init="$ROOT/device/$DEVICE/$DEV_INITRAMFS_INIT"
  fi
  [[ -f $init ]] || die "no init script $init"
  # Every per-device value is checked before anything is downloaded or built
  initramfs_config
  local tarball="alpine-minirootfs-$ver-aarch64.tar.gz"
  local sum=9bf70a7f18ea44094cbb5f70c58f9af129c8214745743db0e68e5502cc2ce773
  mkdir -p "$dl"
  if [[ ! -f "$dl/$tarball" ]]; then
    say "Downloading $tarball"
    curl -fsSL -o "$dl/$tarball" "https://dl-cdn.alpinelinux.org/alpine/v${ver%.*}/releases/aarch64/$tarball"
  fi
  echo "$sum  $dl/$tarball" | sha256sum -c --quiet || die "checksum mismatch for $tarball"

  say "Staging initramfs in $stage"
  rm -rf "$stage" && mkdir -p "$stage"
  tar -xzf "$dl/$tarball" -C "$stage"
  local apk
  # e2fsprogs-extra: resize2fs and dumpe2fs, to grow a freshly flashed root
  # to the whole userdata partition on its first boot (init, boot_arch)
  for apk in $(python3 -I "$ROOT/tools/alpine-fetch.py" "$ver" "$dl/apks" dropbear kexec-tools e2fsprogs e2fsprogs-extra); do
    tar -xzf "$apk" -C "$stage" --exclude='.PKGINFO' --exclude='.SIGN.*' --exclude='.*.sh' 2>/dev/null || true
  done
  # INITRAMFS_I2C_TOOLS=1: i2cget and i2cset (and their libi2c) for a device
  # whose init talks to a chip before any driver runs; nothing else from
  # i2c-tools (its perl scripts can't run here)
  if [[ ${DEV_INITRAMFS_I2C_TOOLS:-} == 1 ]]; then
    local i2c f
    i2c=$(mktemp -d)
    for apk in $(python3 -I "$ROOT/tools/alpine-fetch.py" "$ver" "$dl/apks" i2c-tools); do
      tar -xzf "$apk" -C "$i2c" --exclude='.PKGINFO' --exclude='.SIGN.*' --exclude='.*.sh' 2>/dev/null || true
    done
    for f in usr/sbin/i2cget usr/sbin/i2cset; do
      [[ -f $i2c/$f ]] || { rm -rf "$i2c"; die "INITRAMFS_I2C_TOOLS: no $f in Alpine's i2c-tools"; }
      install -Dm755 "$i2c/$f" "$stage/$f"
    done
    cp -a "$i2c"/usr/lib/libi2c.so.0* "$stage/usr/lib/"
    rm -rf "$i2c"
  elif [[ -n ${DEV_INITRAMFS_I2C_TOOLS:-} ]]; then
    die "INITRAMFS_I2C_TOOLS must be 1 or absent"
  fi
  for f in sbin/e2fsck usr/sbin/resize2fs usr/sbin/dumpe2fs; do
    [[ -x $stage/$f ]] || die "the initramfs has no /$f"
  done
  install -m 755 "$init" "$stage/init"

  initramfs_config "$stage/etc"
  # Modules the init loads before anything else (INITRAMFS_MODULES, in load
  # order), from this kernel build's modules_install: the directory of this
  # build's release, never an older one left in modules-staging
  local m ko mdir rel
  if [[ -n ${DEV_INITRAMFS_MODULES:-} ]]; then
    rel=$(cat "$KERNEL_OUT/include/config/kernel.release" 2>/dev/null) ||
      die "INITRAMFS_MODULES needs a kernel build: omamobile kernel"
    mdir=$KERNEL_OUT/modules-staging/lib/modules/$rel
    [[ -d $mdir ]] || die "INITRAMFS_MODULES needs this build's modules ($rel): omamobile modules"
    mkdir -p "$stage/lib/modules/omamobile"
    for m in $DEV_INITRAMFS_MODULES; do
      [[ $m =~ ^[a-z0-9_-]+$ ]] || die "INITRAMFS_MODULES: bad module name '$m'"
      ko=$(find "$mdir" -name "$m.ko" | head -1)
      [[ -n $ko ]] || die "INITRAMFS_MODULES: no $m.ko in $mdir"
      cp "$ko" "$stage/lib/modules/omamobile/"
      echo "$m" >> "$stage/lib/modules/omamobile/order"
    done
    echo "$rel" > "$KERNEL_OUT/initramfs.release"
    say "Initramfs modules ($rel): $DEV_INITRAMFS_MODULES"
  fi

  # Boot logo, drawn by init straight onto the framebuffer until Plymouth
  # takes over: Omarchy's Plymouth screen (logo centred on #1a1b26, at scale
  # 1), rendered from the theme installed on this Omarchy machine.
  # SPLASH_BGRA_GZ: the same picture, rendered elsewhere (a build host
  # without Omarchy's theme or ImageMagick), raw BGRA at PANEL_SIZE, gzipped.
  local logo=/usr/share/plymouth/themes/omarchy/logo.png
  if [[ -n ${SPLASH_BGRA_GZ:-} ]]; then
    [[ -f $SPLASH_BGRA_GZ ]] || die "SPLASH_BGRA_GZ: no file $SPLASH_BGRA_GZ"
    [[ ${DEV_PANEL_SIZE:-} =~ ^([0-9]+)x([0-9]+)$ ]] || die "SPLASH_BGRA_GZ needs the device's PANEL_SIZE"
    # init writes it to /dev/fb0 unchecked, so it must be one exact frame
    gzip -t "$SPLASH_BGRA_GZ" 2>/dev/null || die "SPLASH_BGRA_GZ: not a valid gzip file"
    local want=$((BASH_REMATCH[1] * BASH_REMATCH[2] * 4)) got
    got=$(gzip -dc "$SPLASH_BGRA_GZ" | wc -c)
    ((got == want)) || die "SPLASH_BGRA_GZ: $got bytes, a ${DEV_PANEL_SIZE} BGRA frame is $want"
    say "Splash: $SPLASH_BGRA_GZ (sha256 $(sha256sum < "$SPLASH_BGRA_GZ" | cut -d' ' -f1))"
    cp "$SPLASH_BGRA_GZ" "$stage/splash.bgra.gz"
  elif [[ -f $logo ]] && command -v magick >/dev/null; then
    magick -size "$DEV_PANEL_SIZE" xc:'#1a1b26' "$logo" -gravity center -composite \
      -alpha off -alpha on -depth 8 BGRA:- | gzip -9 > "$stage/splash.bgra.gz"
  else
    say "No Omarchy Plymouth logo or ImageMagick here: building without the early splash"
  fi

  # devmem and bootctl are built against Alpine's musl with the Android
  # clang when the device package ships bootctl. reboot-to has one source,
  # inside the cheetah package, so a copied package builds and every
  # initramfs links that same file. The Android clang is used when that
  # sysroot is already in use, otherwise the host clang against the same
  # musl sysroot. A first-light device has no bootctl.
  alpine_sysroot() {
    local sysroot="$WORK/downloads/alpine/sysroot" apk
    if [[ ! -f $sysroot/usr/lib/crt1.o ]]; then
      mkdir -p "$sysroot"
      tar -xzf "$dl/$tarball" -C "$sysroot"
      for apk in $(python3 -I "$ROOT/tools/alpine-fetch.py" "$ver" "$dl/apks" musl-dev); do
        tar -xzf "$apk" -C "$sysroot" 2>/dev/null || true
      done
    fi
    [[ -f $sysroot/usr/lib/libc.a ]] || die "alpine musl sysroot has no libc.a"
    printf '%s\n' "$sysroot"
  }
  local sysroot builtins reboot_src="$ROOT/packages/omamobile-device-cheetah/src/reboot-to.c"
  [[ -f $reboot_src ]] || die "missing $reboot_src"
  mkdir -p "$stage/usr/local/bin"
  if [[ -f $ROOT/packages/$DEV_PACKAGE/src/omamobile-bootctl.c ]]; then
    [[ -n ${CLANG_DIR:-} && -d $CLANG_DIR ]] || die "no clang found; run 'lineage-ref sync' first or set CLANG_DIR"
    sysroot=$(alpine_sysroot)
    builtins=$(find "$CLANG_DIR/lib/clang" -name 'libclang_rt.builtins-aarch64-android.a' | head -1)
    "$CLANG_DIR/bin/clang" --target=aarch64-linux-musl --sysroot="$sysroot" -fuse-ld=lld -static -nostdlib -O2 \
      -o "$stage/usr/local/bin/devmem" "$sysroot/usr/lib/crt1.o" "$sysroot/usr/lib/crti.o" \
      "$ROOT/tools/devmem.c" -L"$sysroot/usr/lib" -lc "$builtins" "$sysroot/usr/lib/crtn.o"
    "$CLANG_DIR/bin/clang" --target=aarch64-linux-musl --sysroot="$sysroot" -fuse-ld=lld -static -nostdlib -O2 \
      -o "$stage/usr/local/bin/reboot-to" "$sysroot/usr/lib/crt1.o" "$sysroot/usr/lib/crti.o" \
      "$reboot_src" -L"$sysroot/usr/lib" -lc "$builtins" "$sysroot/usr/lib/crtn.o"
    # A/B slot metadata in devinfo (Apache-2.0 port of Google's boot HAL). Not called by init yet.
    "$CLANG_DIR/bin/clang" --target=aarch64-linux-musl --sysroot="$sysroot" -fuse-ld=lld -static -nostdlib -O2 \
      -o "$stage/usr/local/bin/omamobile-bootctl" "$sysroot/usr/lib/crt1.o" "$sysroot/usr/lib/crti.o" \
      "$ROOT/packages/$DEV_PACKAGE/src/omamobile-bootctl.c" -L"$sysroot/usr/lib" -lc "$builtins" "$sysroot/usr/lib/crtn.o"
  else
    # No Android clang. Freestanding devmem avoids a libc; a host clang that
    # enables the stack protector by default will not link it otherwise.
    # reboot-to links against musl with no Android builtins.
    command -v clang >/dev/null || die "no clang on PATH; needed to build devmem and reboot-to"
    command -v ld.lld >/dev/null || die "no ld.lld on PATH; needed to build devmem and reboot-to"
    clang --target=aarch64-linux-gnu -nostdlib -static -ffreestanding -fno-builtin \
      -fno-stack-protector -fno-pie -fuse-ld=lld -O2 \
      -o "$stage/usr/local/bin/devmem" "$ROOT/tools/devmem-freestanding.c" \
      || die "freestanding devmem failed to link"
    sysroot=$(alpine_sysroot)
    clang --target=aarch64-linux-musl --sysroot="$sysroot" -nostdinc -isystem "$sysroot/usr/include" \
      -static -nostdlib -O2 -fno-stack-protector -fno-pie -fuse-ld=lld \
      -o "$stage/usr/local/bin/reboot-to" \
      "$sysroot/usr/lib/crt1.o" "$sysroot/usr/lib/crti.o" \
      "$reboot_src" "$sysroot/usr/lib/libc.a" "$sysroot/usr/lib/crtn.o" \
      || die "reboot-to failed to link"
    say "No $DEV_PACKAGE bootctl; built freestanding devmem and musl reboot-to"
  fi
  mkdir -p "$stage/root/.ssh"
  cat "$HOME"/.ssh/*.pub > "$stage/root/.ssh/authorized_keys"
  chmod 700 "$stage/root/.ssh" && chmod 600 "$stage/root/.ssh/authorized_keys"

  (cd "$stage" && find . | cpio -o -H newc --owner=0:0 --quiet) | lz4 -l -9 -q > "$KERNEL_OUT/initramfs.cpio.lz4"
  ls -lh "$KERNEL_OUT/initramfs.cpio.lz4"
}

cmd_images() {
  load_device
  local img="$KERNEL_OUT/images" tools="$SRC_DIR/system/tools/mkbootimg"
  local dtc="$KERNEL_OUT/scripts/dtc/dtc" boot="$KERNEL_OUT/arch/arm64/boot"
  local dtb="$boot/dts/$DEV_DTB"
  [[ -f "$boot/Image" && -f "$dtb" ]] || die "build the kernel first: omamobile kernel"
  [[ -f "$KERNEL_OUT/initramfs.cpio.lz4" ]] || die "build the initramfs first: omamobile initramfs"
  # The init insmods INITRAMFS_MODULES, which only load into the kernel they
  # were built with: an initramfs from an older build loses them silently.
  if [[ -n ${DEV_INITRAMFS_MODULES:-} ]]; then
    [[ $(cat "$KERNEL_OUT/initramfs.release" 2>/dev/null) == "$(cat "$KERNEL_OUT/include/config/kernel.release")" ]] ||
      die "the initramfs modules are not from this kernel build: omamobile modules && omamobile initramfs"
  fi
  mkdir -p "$img" && rm -rf "$img"/*

  # The descriptor's bring-up overlays, compiled from device/<codename>/overlays
  # and applied onto the kernel's DTB, in order. The kernel's own DTB is left
  # as built; the images carry the overlaid copy.
  if [[ -n ${DEV_DTB_OVERLAYS:-} ]]; then
    local ov ovdir="$img/overlays" ovs=() fdtoverlay="$KERNEL_OUT/scripts/dtc/fdtoverlay"
    mkdir -p "$ovdir"
    say "DTB overlays: $DEV_DTB_OVERLAYS"
    for ov in $DEV_DTB_OVERLAYS; do
      [[ $ov =~ ^[a-z0-9-]+$ ]] || die "DTB_OVERLAYS: bad overlay name '$ov'"
      [[ -f "$ROOT/device/$DEVICE/overlays/$ov.dtso" ]] || die "no overlay device/$DEVICE/overlays/$ov.dtso"
      "$dtc" -q -@ -I dts -O dtb -o "$ovdir/$ov.dtbo" "$ROOT/device/$DEVICE/overlays/$ov.dtso" || die "overlay $ov does not compile"
      ovs+=("$ovdir/$ov.dtbo")
    done
    "$fdtoverlay" -i "$dtb" -o "$img/$DEV_CODENAME-overlaid.dtb" "${ovs[@]}" || die "applying the overlays failed"
    dtb="$img/$DEV_CODENAME-overlaid.dtb"
  fi

  say "Kernel: Image.lz4"
  lz4 -l -9 -f -q "$boot/Image" "$img/Image.lz4"

  local entry label id base="" out dtbs=()
  if [[ -n ${DEV_SOC_COMPATIBLE:-} ]]; then
    # ABL matches the base DTB on the children of /soc_compatible (product_id,
    # major, minor, pkg_mode), and one DTB can carry several: ship the DTB
    # once, after checking it holds exactly the descriptor's entries.
    say "DTB: one copy, /soc_compatible $DEV_SOC_COMPATIBLE"
    "$dtc" -q -I dtb -O dts "$dtb" | python3 -I -c '
import re, sys
want = {}
for e in sys.argv[1].split():
    label, pid, major, minor, pkg = e.split(":")
    want[label.upper().replace("-", "_")] = (int(pid, 16), int(major), int(minor), int(pkg))
# dtc -@ restores labels from __symbols__: "a: b: name {"
lab = r"(?:[A-Za-z_][A-Za-z0-9_]*: )*"
lines = sys.stdin.read().split("\n")
start = [i for i, l in enumerate(lines) if re.fullmatch(r"\t" + lab + r"soc_compatible \{", l)]
if not start:
    sys.exit("no /soc_compatible node")
# Every line at depth 2 must open or close a child, or be the phandle -@
# gives a labelled node: anything else would let an unchecked entry by
got, cur = {}, None
for l in lines[start[0] + 1:]:
    if l == "\t};":
        break
    if cur is None and re.fullmatch(r"\t\tphandle = <0x[0-9a-f]+>;", l):
        continue
    if not l or (cur is not None and l.startswith("\t\t\t")):
        m = re.fullmatch(r"\t\t\t(product_id|major|minor|pkg_mode) = <(0x[0-9a-f]+)>;", l)
        if m:
            vals[m.group(1)] = int(m.group(2), 16)
        continue
    m = re.fullmatch(r"\t\t" + lab + r"([^\s:{};]+) \{", l)
    if m and cur is None:
        cur, vals = m.group(1), {}
        if cur in got:
            sys.exit("/soc_compatible has %s twice" % cur)
    elif l == "\t\t};" and cur is not None:
        got[cur] = tuple(vals.get(k, -1) for k in ("product_id", "major", "minor", "pkg_mode"))
        cur = None
    else:
        sys.exit("/soc_compatible: cannot parse %r" % l.strip())
else:
    sys.exit("/soc_compatible is not closed")
if got != want:
    sys.exit("/soc_compatible holds %s, the descriptor wants %s" % (sorted(got.items()), sorted(want.items())))
' "$DEV_SOC_COMPATIBLE" || die "$DEV_DTB does not match SOC_COMPATIBLE"
    cp "$dtb" "$img/$DEV_CODENAME.dtb"
    dtbs+=("$img/$DEV_CODENAME.dtb")
  fi
  # ABL matches the base DTB on soc_id: ship one copy per SOC_IDS entry. The
  # first is the value the DTB was built with; the others are rewrites of it.
  # grep -c, not -q: with pipefail, grep -q exiting early SIGPIPEs dtc on larger trees
  [[ -n ${DEV_SOC_IDS:-} ]] && say "DTB: one copy per soc_id ($DEV_SOC_IDS)"
  for entry in ${DEV_SOC_IDS:-}; do
    label=${entry%%:*} id=${entry#*:}
    out="$img/$DEV_CODENAME-$label.dtb"
    if [[ -z $base ]]; then
      base=$id
      "$dtc" -q -I dtb -O dts "$dtb" | grep -c "soc_id = <$base " >/dev/null || die "$DEV_DTB is not built with soc_id $base"
      cp "$dtb" "$out"
    else
      "$dtc" -q -I dtb -O dts "$dtb" | sed "s/soc_id = <$base /soc_id = <$id /" \
        | "$dtc" -q -I dts -O dtb -o "$out" -
      "$dtc" -q -I dtb -O dts "$out" | grep -c "soc_id = <$id " >/dev/null || die "soc_id rewrite to $id failed"
    fi
    dtbs+=("$out")
  done
  cat "${dtbs[@]}" > "$img/dtb.img"

  # ABL applies the dtbo entry matching board_id/board_rev; ours changes nothing
  local dtbo_src="$ROOT/device/$DEVICE/$DEV_DTBO_SOURCE" dtbo
  dtbo="$img/$(basename "$DEV_DTBO_SOURCE" .dts).dtbo"
  grep -c "board_id = <$DEV_DTBO_BOARD_ID>;" "$dtbo_src" >/dev/null || die "$dtbo_src: board_id is not $DEV_DTBO_BOARD_ID"
  grep -c "board_rev = <$DEV_DTBO_BOARD_REV>;" "$dtbo_src" >/dev/null || die "$dtbo_src: board_rev is not $DEV_DTBO_BOARD_REV"
  say "dtbo: empty board overlay"
  "$dtc" -q -@ -I dts -O dtb -o "$dtbo" "$dtbo_src"
  python3 -I "$SRC_DIR/system/libufdt/utils/src/mkdtboimg.py" create "$img/dtbo.img" \
    --page_size=4096 --id="$DEV_DTBO_BOARD_ID" --rev="$DEV_DTBO_BOARD_REV" "$dtbo"

  # Two layouts, picked by BOOT_IMAGES. With vendor_kernel_boot (cheetah), it
  # carries the DTB and our initramfs, vendor_boot only the command line, and
  # the OS version sits on init_boot. Without it (Pixel 6), vendor_boot
  # carries all three and the OS version sits on boot.
  say "Boot images (header v4): $DEV_BOOT_IMAGES"
  : | cpio -o -H newc --quiet > "$img/empty.cpio"
  local cmdline="$DEV_VENDOR_CMDLINE"
  # The generic ramdisk (empty) and the OS version go in init_boot where the
  # device has one, and in boot otherwise.
  if has_image init_boot; then
    python3 "$tools/mkbootimg.py" --header_version 4 --kernel "$img/Image.lz4" --cmdline '' --output "$img/boot.img"
    python3 "$tools/mkbootimg.py" --header_version 4 --ramdisk "$img/empty.cpio" \
      --os_version "$DEV_OS_VERSION" --os_patch_level "$DEV_OS_PATCH_LEVEL" --output "$img/init_boot.img"
  else
    python3 "$tools/mkbootimg.py" --header_version 4 --kernel "$img/Image.lz4" --ramdisk "$img/empty.cpio" --cmdline '' \
      --os_version "$DEV_OS_VERSION" --os_patch_level "$DEV_OS_PATCH_LEVEL" --output "$img/boot.img"
  fi
  # The DTB and our initramfs go in vendor_kernel_boot where the device has
  # one, leaving vendor_boot empty, and in vendor_boot otherwise.
  if has_image vendor_kernel_boot; then
    python3 "$tools/mkbootimg.py" --header_version 4 --pagesize "$DEV_VENDOR_PAGESIZE" --vendor_cmdline "$cmdline" \
      --ramdisk_type 1 --ramdisk_name '' --vendor_ramdisk_fragment "$img/empty.cpio" --vendor_boot "$img/vendor_boot.img"
    python3 "$tools/mkbootimg.py" --header_version 4 --pagesize "$DEV_VENDOR_PAGESIZE" --vendor_cmdline '' \
      --dtb "$img/dtb.img" --ramdisk_type 1 --ramdisk_name '' --vendor_ramdisk_fragment "$KERNEL_OUT/initramfs.cpio.lz4" \
      --vendor_boot "$img/vendor_kernel_boot.img"
  else
    python3 "$tools/mkbootimg.py" --header_version 4 --pagesize "$DEV_VENDOR_PAGESIZE" --vendor_cmdline "$cmdline" \
      --dtb "$img/dtb.img" --ramdisk_type 1 --ramdisk_name '' --vendor_ramdisk_fragment "$KERNEL_OUT/initramfs.cpio.lz4" \
      --vendor_boot "$img/vendor_boot.img"
  fi
  [[ -n ${DEV_AVB_FOOTERS:-} ]] && avb_footers "$img"
  printf '%s\n' "$DEV_CODENAME" > "$img/DEVICE"
  ls -lh "$img"/*.img
}

# Give each AVB_FOOTERS image a hash footer, padding it to its partition.
# With the bootloader unlocked, ABL accepts any key and a stale hash but
# refuses a chained partition with no footer at all, so AOSP's test key
# does. The rollback index and the security patch are stock's, and the salt
# is the image's own hash, so the same input gives the same bytes.
avb_footers() {
  local img=$1 avbtool=${AVBTOOL:-$SRC_DIR/external/avb/avbtool.py} key=${AVB_KEY:-$SRC_DIR/external/avb/test/data/testkey_rsa4096.pem}
  local entry name size salt
  [[ -f $avbtool ]] || die "no avbtool at $avbtool (AOSP platform/external/avb under SRC_DIR, or set AVBTOOL); $DEV_CODENAME's AVB_FOOTERS need it"
  [[ -f $key ]] || die "no AVB key at $key (set AVB_KEY)"
  # The footer records avbtool's version, so another avbtool gives other bytes
  say "AVB footers: $(python3 -I "$avbtool" version)"
  for entry in $DEV_AVB_FOOTERS; do
    name=${entry%%:*} size=$((${entry#*:}))
    say "AVB footer: $name.img, padded to its $size-byte partition"
    salt=$(sha256sum "$img/$name.img" | cut -d' ' -f1)
    python3 -I "$avbtool" add_hash_footer --image "$img/$name.img" --partition_name "$name" \
      --partition_size "$size" --algorithm SHA256_RSA4096 --key "$key" --salt "$salt" \
      --rollback_index "$DEV_AVB_ROLLBACK_INDEX" \
      --prop "com.android.build.$name.os_version:${DEV_OS_VERSION%%.*}" \
      --prop "com.android.build.$name.security_patch:$DEV_AVB_SECURITY_PATCH" \
      || die "avbtool could not add $name's footer"
  done
}

cmd_kexec() {
  local boot="$KERNEL_OUT/arch/arm64/boot" stage="$KERNEL_OUT/initramfs" ssh="$ROOT/tools/phone-ssh"
  [[ -f "$boot/Image" && -f "$KERNEL_OUT/initramfs.cpio.lz4" ]] || die "build the kernel and initramfs first"
  "$ssh" true || die "phone not reachable at 172.16.42.1"

  say "Copying kernel, initramfs and kexec to the phone"
  "$ssh" 'rm -rf /run/kexec && mkdir -p /run/kexec/lib'
  # dropbear has no sftp/scp server, so stream each file over ssh
  local f
  for f in "$boot/Image" "$KERNEL_OUT/initramfs.cpio.lz4" "$stage/usr/sbin/kexec"; do
    "$ssh" "cat > /run/kexec/${f##*/}" < "$f"
  done
  for f in "$stage"/usr/lib/liblzma.so.5 "$stage"/usr/lib/libzstd.so.1; do
    "$ssh" "cat > /run/kexec/lib/${f##*/}" < "$(readlink -f "$f")"
  done
  "$ssh" 'chmod 755 /run/kexec/kexec'

  say "Jumping into the new kernel (keeps the bootloader's device tree and command line)"
  "$ssh" 'cd /run/kexec && LD_LIBRARY_PATH=/run/kexec/lib ./kexec -l Image --initrd=initramfs.cpio.lz4 --reuse-cmdline --append=fbcon=font:TER16x32 \
    && sync && (sleep 1; LD_LIBRARY_PATH=/run/kexec/lib ./kexec -e) >/dev/null 2>&1 &' || true
  say "Waiting for the phone to come back"
  local i
  for i in $(seq 1 60); do
    sleep 2
    if "$ssh" 'uname -v; cat /proc/uptime' 2>/dev/null; then return 0; fi
  done
  die "phone did not come back after kexec"
}

in_fastboot() { timeout 3 fastboot devices 2>/dev/null | grep -c . >/dev/null; }

# The one phone in fastboot, by serial, so every check and write reaches
# the same phone: with two in fastboot (a contributor's and the
# maintainer's on one desk) an unpinned call can reach either. Several
# are refused unless FASTBOOT_SERIAL names one of them.
fastboot_serial() {
  local serials n
  serials=$(timeout 3 fastboot devices 2>/dev/null | awk '$2 == "fastboot" {print $1}')
  n=$(grep -c . <<<"$serials" || true)
  if [[ -n ${FASTBOOT_SERIAL:-} ]]; then
    grep -qxF -- "$FASTBOOT_SERIAL" <<<"$serials" || die "FASTBOOT_SERIAL is not a phone in fastboot"
    printf '%s\n' "$FASTBOOT_SERIAL"
    return
  fi
  ((n == 1)) || die "$n phones in fastboot: unplug the others, or set FASTBOOT_SERIAL to the one to flash"
  printf '%s\n' "$serials"
}

cmd_fastboot() {
  local ssh="$ROOT/tools/phone-ssh" i
  in_fastboot && { say "Already in fastboot"; return 0; }
  for i in $(seq 1 12); do
    if adb get-state 2>/dev/null | grep -q device; then
      say "Stock Android: adb reboot bootloader"
      adb reboot bootloader
    elif "$ssh" true 2>/dev/null; then
      say "Our Linux: reboot-to bootloader"
      # dropbear's login PATH omits /usr/local/bin, where the initramfs installs reboot-to
      "$ssh" '(sleep 1; PATH=/usr/local/bin:$PATH reboot-to bootloader) >/dev/null 2>&1 &' || true
      sleep 25
      if ! in_fastboot && "$ssh" true 2>/dev/null; then
        say "Bootloader ignored the reason; crashing so it falls back to slot A"
        "$ssh" '(sleep 1; echo c > /proc/sysrq-trigger) >/dev/null 2>&1 &' || true
      fi
    fi
    local t
    for t in $(seq 1 40); do
      in_fastboot && { say "In fastboot"; return 0; }
      adb get-state 2>/dev/null | grep -q device && break
      "$ssh" true 2>/dev/null && break
      sleep 2
    done
  done
  die "could not reach fastboot; use the buttons (Power 30 s, then Volume Down + Power 20 s)"
}

cmd_flash() {
  local img="$KERNEL_OUT/images" p
  load_device
  images_for_device "$img"
  in_fastboot || die "phone not in fastboot (try: omamobile fastboot)"
  local serial
  serial=$(fastboot_serial) || exit 1
  # Every image and allowlist entry first: never start writing slot B and
  # find out halfway that a later image is missing.
  for p in $DEV_BOOT_IMAGES; do
    slot_b_allowed "$p" || die "${p}_b is not on device/$DEVICE's storage-guard allowlist; refusing"
    [[ -f "$img/$p.img" ]] || die "missing $img/$p.img (run: omamobile images)"
  done
  local out rc
  for p in $DEV_BOOT_IMAGES; do
    rc=0
    out=$(timeout 60 fastboot -s "$serial" flash "${p}_b" "$img/$p.img" 2>&1) || rc=$?
    echo "$out" | grep -E 'OKAY|FAIL' | tail -1 | sed "s/^/$p: /" || true
    # Stop before activating or rebooting into a half-written slot B
    ((rc == 0)) || die "flashing ${p}_b failed (exit $rc): slot B is incomplete, flash again before rebooting"
  done
  timeout 20 fastboot -s "$serial" --set-active=b >/dev/null 2>&1
  timeout 20 fastboot -s "$serial" reboot >/dev/null 2>&1
  say "Booting slot B; waiting for SSH"
  local i
  for i in $(seq 1 45); do
    "$ROOT/tools/phone-ssh" 'uname -v; cut -d" " -f1 /proc/uptime' 2>/dev/null && return 0
    sleep 2
  done
  die "no SSH after boot (the safety net returns to fastboot within about a minute)"
}

cmd_push() {
  local img="$KERNEL_OUT/images" ssh="$ROOT/tools/phone-ssh" p dev want got rel
  load_device
  images_for_device "$img"
  "$ssh" true || die "phone not reachable at 172.16.42.1"
  # Refuse before any write. A phone whose initramfs has no reboot-to would
  # otherwise take the images, swallow the reboot, and report success while
  # the old kernel is still running.
  local booted id
  booted=$("$ssh" 'cat /proc/sys/kernel/random/boot_id') || die "cannot read the phone's boot id"
  # dropbear's login PATH omits /usr/local/bin, where the initramfs installs reboot-to
  "$ssh" 'PATH=/usr/local/bin:$PATH command -v reboot-to >/dev/null' || die "phone has no reboot-to; refusing to write"
  # A kernel whose modules aren't installed boots without its drivers (the GPU
  # among them): install them first. A config change can keep the release
  # name, so compare the tarball's checksum, not just the directory.
  rel=$(kernel_release)
  want=$(sha256sum < "$KERNEL_OUT/modules-$rel.tar.zst" | cut -d' ' -f1)
  [[ "$("$ssh" "cat /usr/lib/modules/$rel/.omamobile-tarball 2>/dev/null")" == "$want" ]] || cmd_modules_push
  # Check every image before writing any. Each must fit its partition, and an
  # AVB_FOOTERS image is padded to the descriptor's partition size, with its
  # footer at the end, so that size must be the partition's exactly.
  local -A devs=()
  local sectors bytes avb e
  for p in $DEV_BOOT_IMAGES; do
    slot_b_allowed "$p" || die "${p}_b is not on device/$DEVICE's storage-guard allowlist; refusing"
    [[ -f "$img/$p.img" ]] || die "missing $img/$p.img (run: omamobile images)"
    # Find the partition by GPT name; the init guard leaves only these writable
    dev=$("$ssh" "for s in /sys/block/sda/sda*; do grep -qx 'PARTNAME=${p}_b' \$s/uevent && echo /dev/\${s##*/}; done; true")
    [[ -n "$dev" ]] || die "${p}_b not found on the phone"
    [[ "$("$ssh" "cat /sys/block/sda/${dev#/dev/}/ro")" == 0 ]] || die "$dev (${p}_b) is read-only; refusing"
    # sysfs counts 512-byte sectors, whatever the device's block size
    sectors=$("$ssh" "cat /sys/block/sda/${dev#/dev/}/size")
    [[ $sectors =~ ^[0-9]{1,15}$ ]] || die "cannot read the size of $dev (${p}_b)"
    bytes=$((sectors * 512))
    (($(stat -c %s "$img/$p.img") <= bytes)) || die "$p.img is larger than ${p}_b ($dev, $bytes bytes); refusing"
    avb=""
    for e in ${DEV_AVB_FOOTERS:-}; do [[ ${e%%:*} != "$p" ]] || avb=$((${e#*:})); done
    [[ -z $avb ]] || ((avb == bytes)) \
      || die "AVB_FOOTERS pads $p to $avb bytes, but ${p}_b ($dev) is $bytes: its footer would not be at the end of the partition; refusing"
    devs[$p]=$dev
  done
  for p in $DEV_BOOT_IMAGES; do
    dev=${devs[$p]}
    "$ssh" "dd of=$dev bs=1M conv=fsync 2>/dev/null" < "$img/$p.img"
    want=$(sha256sum < "$img/$p.img" | cut -d' ' -f1)
    got=$("$ssh" "head -c $(stat -c %s "$img/$p.img") $dev | sha256sum" | cut -d' ' -f1)
    [[ "$want" == "$got" ]] || die "verify failed for ${p}_b ($dev)"
    say "${p}_b ($dev) written and verified"
  done
  say "Rebooting into the new images"
  "$ssh" 'sync; (sleep 1; PATH=/usr/local/bin:$PATH reboot-to omamobile) >/dev/null 2>&1 &' || true
  sleep 15
  # Judge by the last answer only: a phone that still answered with the old
  # boot id just before it went down did reboot, and then never came back.
  local i last=none
  for i in $(seq 1 45); do
    if id=$("$ssh" 'cat /proc/sys/kernel/random/boot_id' 2>/dev/null); then
      if [[ $id == "$booted" ]]; then
        last=same
      else
        last=new
        "$ssh" 'uname -v; cut -d" " -f1 /proc/uptime' && return 0
      fi
    else
      last=none
    fi
    sleep 2
  done
  if [[ $last == same ]]; then
    die "same boot id: the reboot did not happen"
  fi
  die "no SSH after reboot (the safety net crashes back to slot A within about a minute)"
}

cmd_kernel_shell() {
  in_container "exec bash"
}

case "${1:-}" in
  capture) shift; cmd_capture "$@" ;;
  initramfs) cmd_initramfs ;;
  initramfs-config) shift; cmd_initramfs_config "$@" ;;
  kernel) cmd_kernel ;;
  modules) cmd_modules ;;
  modules-push) cmd_modules_push ;;
  images) cmd_images ;;
  kexec) cmd_kexec ;;
  fastboot) cmd_fastboot ;;
  flash) cmd_flash ;;
  push) cmd_push ;;
  kernel-shell) cmd_kernel_shell ;;
  *) usage ;;
esac
