#!/bin/bash
# SPDX-License-Identifier: MIT
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
python3 - <<'PYTEST'
"""Exercise same-version rebuild cache invalidation without Docker/signing."""
from pathlib import Path
import subprocess
import tempfile

root = Path.cwd()
source = (root / 'tools/build-packages').read_text()
a = source.index('add_to_repo() {')
b = source.index('\n}\n', a) + 3
function = source[a:b]
with tempfile.TemporaryDirectory() as directory:
    p = Path(directory)
    for name in ('repo', 'cache/pkg', 'built'):
        (p / name).mkdir(parents=True)
    base = 'device-0.1.0-1-aarch64.pkg.tar.zst'
    rebuilt = p / 'built' / base
    rebuilt.write_text('pkgname = device\nnew bytes\n')
    cached = p / 'cache/pkg' / base
    signature = Path(str(cached) + '.sig')
    unrelated = p / 'cache/pkg/other.pkg.tar.zst'
    unrelated.write_text('untouched')
    command = '''set -euo pipefail
repo=$1/repo; ALARM_CACHE=$1/cache
local_name=${2:-}
pkginfo() { cat "$1"; }
alarm_die() { exit 99; }
''' + function + '\nadd_to_repo "$1/built/' + base + '"\n'
    cached.write_text('pkgname = device\nstale bytes\n')
    signature.write_text('stale signature')
    subprocess.run(['bash', '-c', command, 'test', str(p)], check=True,
                   stdout=subprocess.DEVNULL)
    assert not cached.exists() and not signature.exists()
    assert unrelated.read_text() == 'untouched'
    assert (p / 'repo' / base).read_bytes() == rebuilt.read_bytes()
    cached.write_bytes(rebuilt.read_bytes())
    signature.write_text('matching signature')
    subprocess.run(['bash', '-c', command, 'test', str(p)], check=True,
                   stdout=subprocess.DEVNULL)
    assert cached.exists() and signature.read_text() == 'matching signature'
    imported_signature = Path(str(rebuilt) + '.sig')
    imported_signature.write_text('imported signature')
    subprocess.run(['bash', '-c', command, 'test', str(p), 'comet'], check=True,
                   stdout=subprocess.DEVNULL)
    assert (p / 'repo' / (base + '.sig')).read_text() == 'imported signature'
print('ok - forced same-version rebuild removes stale cached bytes and signature')
print('ok - identical and unrelated cache entries remain')
print('ok - a local import retains its supplied signature')

PYTEST
