#!/bin/bash
# SPDX-License-Identifier: MIT
# Tests for tools/extract-vendor-chroot and tools/extract-fingerprint-vendor
# with made-up images (no factory image, no Google files): small files with
# the ext4 magic stand in for vendor.img and system.img in an image zip, a
# stand-in unzip reads it with Python's zipfile, and a stand-in debugfs
# fails the copy of build.prop as real debugfs does on a full work
# directory (an error message, an empty file, exit 0). Checked: each tool
# then says build.prop can't be read, not that the image has none, and
# passes on debugfs's own last line, the reason; a failed copy where
# debugfs said nothing but its banner gets no reason. With mkfs.ext4 and
# debugfs on the host, the same on real ext4 images: one without
# build.prop, and one cut short. Also checked: -o resolving to / (including a
# bind mount of / or one whose name ends in a newline when the host can create
# a user+mount namespace) or an empty -o in extract-fingerprint-vendor is
# refused before reading SOURCE or creating -w, while nested, scratch-local ..,
# newline-ending, dash-prefixed and default output paths proceed.
# XVC=path and XFP=path run other copies of the tools (a negative control).
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
XVC=$(realpath -- "${XVC:-tools/extract-vendor-chroot}")
XFP=$(realpath -- "${XFP:-tools/extract-fingerprint-vendor}")
failed=0
fail() { printf 'not ok - %s\n' "$1" >&2; failed=$((failed + 1)); }
pass() { printf 'ok - %s\n' "$1"; }
t=$(mktemp -d)
trap 'rm -rf "$t"' EXIT

mkdir -p "$t/bin" "$t/fake"
cat > "$t/bin/unzip" <<'EOF'
#!/bin/bash
# unzip -Z1 ZIP (list) or unzip -p ZIP MEMBER (to stdout)
exec python3 -I -c '
import sys, zipfile
with zipfile.ZipFile(sys.argv[2]) as z:
    if sys.argv[1] == "-Z1":
        print("\n".join(z.namelist()))
    else:
        sys.stdout.buffer.write(z.read(sys.argv[3]))
' "$@"
EOF
cat > "$t/fake/debugfs" <<'EOF'
#!/bin/bash
# debugfs -R "dump /build.prop OUT" IMG on a full disk: real debugfs's
# messages, an empty OUT, exit 0; DFS_REASON="" prints only the banner
read -r _ _ out <<<"$2"
out=${out#\"}; out=${out%\"}; out=${out//\"\"/\"}   # debugfs's quoting
: > "$out"
echo "debugfs 1.47.2 (stand-in)" >&2
[[ -z ${DFS_REASON-x} ]] || echo "${DFS_REASON-dump: No space left on device while writing file}" >&2
exit 0
EOF
chmod +x "$t/bin/unzip" "$t/fake/debugfs"

head -c 4096 /dev/zero > "$t/ext4.img"
printf '\x53\xef' | dd of="$t/ext4.img" bs=1 seek=1080 conv=notrunc status=none
# zipimg ZIP VENDOR SYSTEM: an image zip with those two images in it
zipimg() {
  python3 -I -c '
import sys, zipfile
with zipfile.ZipFile(sys.argv[1], "w") as z:
    z.write(sys.argv[2], "vendor.img")
    z.write(sys.argv[3], "system.img")
' "$@"
}
zipimg "$t/image-cheetah-fictional.zip" "$t/ext4.img" "$t/ext4.img"

# check_one TOOL NAME ZIP LINE [OUT [DIR]]: TOOL exits non-zero and prints
# LINE as its error (comparing bytes, including trailing blanks from debugfs
# and embedded newlines). VERDICT overrides the pass suffix; EXPECT_NO_WORK=1
# also checks -w was never created; NO_OUT=1 omits -o; WRAP prefixes the run.
WRAP=()
check_one() {
  local tool=$1 label=${2//$'\n'/\\n} name=${1##*/} args=() dir=${6:-.} disp=${4//$'\n'/\\n}
  [[ $tool != "$XVC" ]] || args=(-p gnss)
  [[ -n ${NO_OUT:-} ]] || args+=(-o "${5-$t/out}")
  rm -rf "$t/work" "$t/out"
  if (cd "$dir" && PATH=$t/bin:$PATH "${WRAP[@]}" "$tool" "${args[@]}" -w "$t/work" "$3") > "$t/log" 2>&1; then
    fail "$name: $label: refused"
  elif [[ $(sed -n '/^error: /,$p' "$t/log") != "$4" ]]; then
    cat "$t/log"; fail "$name: $label: says $disp"
  elif [[ -n ${EXPECT_NO_WORK:-} && -e $t/work ]]; then
    cat "$t/log"; fail "$name: $label: created work dir before refusing"
  else
    pass "$name: $label: ${VERDICT:-refused, says $disp}"
  fi
}
refused() { local tool; for tool in "$XVC" "$XFP"; do check_one "$tool" "$@"; done; }
msg="error: build.prop can't be read from vendor.img"
PATH=$t/fake:$PATH refused "a build.prop whose copy fails" "$t/image-cheetah-fictional.zip" \
  "$msg: dump: No space left on device while writing file"
DFS_REASON="" PATH=$t/fake:$PATH refused "a failed copy with only debugfs's banner" \
  "$t/image-cheetah-fictional.zip" "$msg"

# -o resolving to / (or a bind mount of /) is refused before reading SOURCE
# or creating -w; nested, scratch-local .., newline-ending, dash-prefixed and
# default output paths proceed.
nl_bind=$t/root-nl$'\n'
mkdir -p "$t/a/b" "$t/root-bind" "$nl_bind"
rel=$(realpath --relative-to="$t/a/b" /)
ln -s / "$t/link-to-root"
zip=$t/image-cheetah-fictional.zip
refused_root() { # LABEL OUT [DIR [ZIP]]
  EXPECT_NO_WORK=1 PATH=$t/fake:$PATH refused "$1" "${4:-$zip}" \
    "error: -o '$2' resolves to /: would remove /root" "$2" "${3:-.}"
}
for out in / /// /tmp/.. /no-such/.. "$t/link-to-root" "$t/link-to-root/no-such/../.."; do
  refused_root "-o ${out#"$t/"}" "$out"
done
refused_root "-o $rel (from a/b)" "$rel" "$t/a/b"
refused_root "-o . (from /)" "." "/"
refused_root "-o / with missing source" "/" "." "$t/missing.zip"
EXPECT_NO_WORK=1 PATH=$t/fake:$PATH check_one "$XFP" "-o '' (empty)" \
  "$zip" "error: can't resolve -o ''" ""
bwrap_cmd=(bwrap --ro-bind / / --dev /dev --proc /proc --bind "$t" "$t" --ro-bind / "$t/root-bind" --ro-bind / "$nl_bind")
if "${bwrap_cmd[@]}" bash -c '[[ $1 -ef / && $2 -ef / ]]' _ "$t/root-bind" "$nl_bind" 2>/dev/null; then
  WRAP=("${bwrap_cmd[@]}")
elif unshare --user --map-root-user --mount \
     bash -c 'mount --bind / "$1" && mount --bind / "$2" && [[ $1 -ef / && $2 -ef / ]]' _ "$t/root-bind" "$nl_bind" 2>/dev/null; then
  WRAP=(unshare --user --map-root-user --mount bash -c 'mount --bind / "$1" && mount --bind / "$2" && shift 2 && exec "$@"' _ "$t/root-bind" "$nl_bind")
fi
if ((${#WRAP[@]})); then
  refused_root "-o root-bind (bind mount of /)" "$t/root-bind"
  refused_root "-o root-nl\\n (bind mount of /)" "$nl_bind"
  WRAP=()
else
  echo "ok - # skip: no user+mount namespace for bind-mount of / check"
fi
VERDICT="gets past the -o check"
dfs_err="$msg: dump: No space left on device while writing file"
for out in "$t/new/dir" "$t/x/../out" "$t/new-nl"$'\n' $'/\n'; do
  PATH=$t/fake:$PATH refused "-o ${out#"$t/"}" "$zip" "$dfs_err" "$out"
done
PATH=$t/fake:$PATH refused "-o -x (from scratch)" "$zip" "$dfs_err" "-x" "$t"
NO_OUT=1 PATH=$t/fake:$PATH check_one "$XVC" "default -o (from scratch)" "$zip" "$dfs_err" "" "$t"
VERDICT=""

# --- Real ext4 images (made-up files), when the host can make them ------------
mkdir -p "$t/v" "$t/s/system"
printf 'ro.product.vendor.device=cheetah\n' > "$t/v/build.prop"
if command -v debugfs >/dev/null && mkfs.ext4 -q -F -d "$t/s" "$t/system.img" 4M >/dev/null 2>&1 &&
   mkfs.ext4 -q -F -d "$t/v" "$t/vendor.img" 8M >/dev/null 2>&1 &&
   mkfs.ext4 -q -F -d "$t/s" "$t/noprop.img" 8M >/dev/null 2>&1; then
  cp "$t/vendor.img" "$t/short.img"; truncate -s 1M "$t/short.img"
  zipimg "$t/image-noprop.zip" "$t/noprop.img" "$t/system.img"
  zipimg "$t/image-short.zip" "$t/short.img" "$t/system.img"
  for image in noprop short; do
    err=$(debugfs -R "dump /build.prop \"$t/probe.prop\"" "$t/$image.img" 2>&1 >/dev/null)
    reason=${err##*$'\n'}
    if [[ -z $reason || $reason == "debugfs "[0-9]* || -s $t/probe.prop ]]; then
      fail "real ext4 $image: direct debugfs must fail to copy with a reason"
      continue
    fi
    refused "real ext4 $image" "$t/image-$image.zip" "$msg: $reason"
  done
else
  echo "ok - # skip: no mkfs.ext4 -d and debugfs for the real ext4 checks"
fi
((failed == 0)) || { echo "$failed check(s) failed" >&2; exit 1; }
