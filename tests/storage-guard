pass "the lun lists on slot A: boot_a writable on sde, boot_b there read-only"

fake_disks
cp "$t/etc-lun/omamobile-ufs-rw" "$B/etc/"
guard
disk_checks "lun without its LUN list"
pass "without UFS_RW_LUNS, sde stays read-only at the disk level, as before"

for bad in 'sde sda' 'sde;sdf' '/dev/sde' 'sde1' 'SDE'; do
  fake_disks
  cp "$t/etc-lun/omamobile-ufs-rw" "$B/etc/"
  printf '%s\n' "$bad" > "$B/etc/omamobile-ufs-rw-luns"
  guard
  grep -q "malformed LUN list" "$B/dev/kmsg" || { cat "$B/dev/kmsg"; fail "LUN list '$bad': says so on kmsg"; }
  disk_checks "LUN list '$bad'"
  [[ $(writable) == "boot_b userdata" ]] || fail "LUN list '$bad': sda keeps its allowlist (got: $(writable))"
done
pass "a malformed LUN list leaves every LUN but sda read-only"

fake_disks
printf 'boot_b userdata persist\n' > "$B/etc/omamobile-ufs-rw"; printf 'sde\n' > "$B/etc/omamobile-ufs-rw-luns"
