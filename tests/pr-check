#!/bin/bash
# SPDX-License-Identifier: MIT
# tools/pr-check against a throwaway repository: a clean change passes, and
# each kind of problem fails on its own and is named.
set -euo pipefail
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
t=$(mktemp -d)
trap 'rm -rf "$t"' EXIT
fail() { echo "not ok - $*" >&2; exit 1; }

r=$t/repo
mkdir -p "$r/tools"
cp "$here/tools/pr-check" "$r/tools/pr-check"
cd "$r"
git init -q -b main
git config user.name Tester
git config user.email tester@example.org
echo "# readme" > README.md
git add -A && git commit -q -m "base"

# One branch per case, each one commit on main; pr-check runs from the
# branch's checkout against main.
check() { # name expect(0|1) [pattern [pattern2 [absent]]]
  local out status=0
  out=$(tools/pr-check main 2>&1) || status=$?
  [[ $status == "$2" ]] || { echo "$out"; fail "$1: exit $status, expected $2"; }
  [[ -z ${3:-} ]] || grep -c -- "$3" <<<"$out" >/dev/null || { echo "$out"; fail "$1: says '$3'"; }
  [[ -z ${4:-} ]] || grep -c -- "$4" <<<"$out" >/dev/null || { echo "$out"; fail "$1: says '$4'"; }
  [[ -z ${5:-} ]] || ! grep -c -- "$5" <<<"$out" >/dev/null || { echo "$out"; fail "$1: must not say '$5'"; }
}
case_branch() { git checkout -q main && git checkout -q -b "$1"; }

case_branch clean
printf '#!/bin/bash\necho hi\n' > tools/hello && chmod +x tools/hello
echo "made-up address 02:10:42:00:00:01 and <MAC>" > notes.md
git add -A && git commit -q -m "tools: hello" -m "Signed-off-by: A Human <a@example.org>" -m "Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>"
check "a clean change" 0
echo "ok - a clean change passes, with a made-up MAC and an AI Co-Authored-By"

case_branch mac
echo "wlan0 at 3c:28:6d:aa:bb:cc" > notes.md
git add -A && git commit -q -m "notes"
check "a real MAC" 1 "MAC or Bluetooth addresses" "rewrite the named commit and force-push"
echo "ok - a real MAC fails and prints the rewrite hint"

case_branch mac-doc
echo "example 00:00:5E:00:53:01, none 00:00:00:00:00:00" > notes.md
git add -A && git commit -q -m "notes"
check "documentation and all-zero MACs" 0
echo "ok - RFC 7042's documentation range and all zeros pass"

case_branch mac-mixed
echo "example 00:00:5e:00:53:01 then 3c:28:6d:aa:bb:cc" > notes.md
git add -A && git commit -q -m "notes"
check "a real MAC beside an exempt one" 1 "MAC or Bluetooth addresses"
echo "ok - an exempt MAC doesn't hide a real one on the same line"

# Other spellings of an address (review lesson L-634): after a label colon,
# with hyphens, in upper case, and as 12 bare hex digits in a MAC record.
# Built here so that tools/release's scan of this file finds none of them.
V=$(printf '%s:%s' 10:20:30 40:50:60) L=02:00:00:00:00:01 D=$(printf '%s:%s' 00:00:5e 00:53:01)
H=${V//:/-} B=${V//:/} DH=${D//:/-}
j=0
line_case() { # line expect [pattern [file]]
  local f=${4:-notes.md}
  case_branch "line-form-$((j += 1))"
  printf '%s\n' "$1" > "$f"
  git add -A && git commit -q -m "notes"
  check "${4:+$f: }$1" "$2" "${3:-}"
}
for line in "mac:$V" "tag:$V" "id:$V" "wlan0 at $H" "HWaddr ${H^^}" "mac=$B" "bd_addr: $B" \
  "\"mac_address\": \"${B^^}\"" "Intf0MacAddress=$B" "link/ether $B" "mac-address $B" "bd-addr=$B" \
  "mac:$L then mac:$H" "id:$D then bdaddr $B"; do
  line_case "$line" 1 "MAC or Bluetooth addresses"
done
echo "ok - a MAC after a label colon, with hyphens, in upper case or bare in a MAC record fails"
for line in "mac:$L" "${L//:/-}" "mac=${L//:/}" "00-00-00-00-00-00" "macaddr=000000000000" "mac:$D" "${DH^^}" "hwaddr ${D//:/}" \
  "$V:70" "a0:$V" "$H-70" "a0-$H" "10:20-30:40-50:60" "fe80::1020:3040:5060" "${B:0:8}-5060-7080-90a0-$B" \
  "commit $B${B}1020304050607080" "build $B" "mac=${B}7" "together $B"; do
  line_case "$line" 0
done
echo "ok - made-up and documentation MACs in those forms, longer runs, mixed separators, IPv6, UUIDs and bare hex outside a MAC record pass"

# Six decimal fields joined by hyphens that read as YY-MM-DD-HH-MM-SS are a
# timestamp, such as a screenshot's name (#842). Past a range's edge, with a
# hex letter, with colons or bare in a MAC record, they are still an address,
# and a timestamp hides no address beside it, starting in its last field or
# after an exempt one that starts there.
ts() { local IFS=-; echo "$*"; }
tc() { local IFS=:; echo "$*"; }
S=$(ts 25 11 15 10 20 30) A=$(ts 00 1a 2b 3c 4d 5e)
C=${A#00-}
for line in "screenshot-$S.png" "screenshot-$(ts 26 11 15 10 20 30).png" "$(ts 25 01 15 10 20 30)" "$(ts 25 12 15 10 20 30)" \
  "$(ts 25 11 01 10 20 30)" "$(ts 25 11 31 10 20 30)" "$(ts 25 11 15 00 00 00)" "$(ts 25 11 15 23 59 59)"; do
  line_case "$line" 0
done
echo "ok - a hyphenated date and time passes, at each range's edges"
for line in "wlan0 at $A" "$(ts 25 00 15 10 20 30)" "$(ts 25 13 15 10 20 30)" "$(ts 25 11 00 10 20 30)" "$(ts 25 11 32 10 20 30)" \
  "$(ts 25 11 15 24 20 30)" "$(ts 25 11 15 10 60 30)" "$(ts 25 11 15 10 20 60)" "$(ts 2c 11 15 10 20 30)" "$(ts 25 1b 15 10 20 30)" \
  "$(ts 25 11 1d 10 20 30)" "$(ts 25 11 15 1f 20 30)" "$(ts 25 11 15 10 2e 30)" "$(ts 25 11 15 10 20 3a)" "${S//-/:}" "mac=${S//-/}" \
  "screenshot-$S.png wlan0 at $A" "$S:${C//-/:}" "screenshot-$(ts 25 11 15 10 20 26):$(tc 1a 2b 3c 4d):$A" \
  "$(ts 25 11 15 10 20 32):$(tc 10 20 30 40):$(ts 50 1a 2b 3c 4d 5e)" "$(ts 25 11 15 10 20 26):$(tc 1a 2b 3c 4d):$(ts 50 1a 2b 3c 4d 5e)"; do
  line_case "$line" 1 "MAC or Bluetooth addresses"
done
echo "ok - past a range's edge, with a hex letter, with colons or in a MAC record, the same digits fail, and so does an address beside a timestamp, in its last field or after an exempt one there"

# Locally administered unicast addresses (first octet x2, x6, xA, xE) and
# all-ones pass in every spelling; x3, x7, xB and xF also set the group bit
# and fail in every spelling, including ff:... other than all ones and beside
# an exempt address. Built from octets so neither scanner finds a literal
# address in this file.
tail_c=$(tc 1a 2b 3c 4d 5e) tail_h=${tail_c//:/-} tail_b=${tail_c//:/}
mac_forms() {
  local o=$1 O=${1^^}
  printf '%s\n' \
    "$o:$tail_c" "$O:${tail_c^^}" \
    "mac:$o:$tail_c" "tag:$O:${tail_c^^}" "id:$o:$tail_c" \
    "$o-$tail_h" "$O-${tail_h^^}" "wlan0-$o-$tail_h" \
    "mac=$o$tail_b" "mac=$O${tail_b^^}" "bd_addr: $o$tail_b" \
    "ether $O${tail_b^^}" "\"mac_address\": \"$O${tail_b^^}\""
}
for o in 02 16 ca fe; do
  while IFS= read -r line; do
    line_case "$line" 0
  done < <(mac_forms "$o")
done
for line in "ff:ff:ff:ff:ff:ff" "FF:FF:FF:FF:FF:FF" "mac:ff:ff:ff:ff:ff:ff" \
  "ff-ff-ff-ff-ff-ff" "FF-FF-FF-FF-FF-FF" "wlan0-ff-ff-ff-ff-ff-ff" \
  "mac=ffffffffffff" "bd_addr: FFFFFFFFFFFF" "ether FFFFFFFFFFFF" \
  "\"mac_address\": \"FFFFFFFFFFFF\""; do
  line_case "$line" 0
done
echo "ok - locally administered unicast MACs (x2, x6, xA, xE) and all-ones pass in every spelling"
for o in 03 17 cb ef ff; do
  while IFS= read -r line; do
    line_case "$line" 1 "MAC or Bluetooth addresses"
  done < <(mac_forms "$o")
  line_case "$L $o:$tail_c" 1 "MAC or Bluetooth addresses"
done
near_all_ones=$(printf '%s:%s' ff:ff:ff ff:ff:fe)
for line in "$near_all_ones" "${near_all_ones//:/-}" "mac=${near_all_ones//:/}"; do
  line_case "$line" 1 "MAC or Bluetooth addresses"
done
echo "ok - group-bit first octets (x3, x7, xB, xF, including ff:... not all-ones) fail in every spelling"

case_branch getprop
echo "[ro.boot.hardware.revision]: [MP1.0]" > notes.md
git add -A && git commit -q -m "notes"
check "a getprop dump" 1 "getprop output"
echo "ok - getprop output fails"

case_branch serial
echo 'androidboot.serialno=27141FDH2001AB' > notes.md
git add -A && git commit -q -m "notes"
check "a serial" 1 "serial numbers"
out=$(tools/pr-check main 2>&1 || true)
[[ $(grep -c 'notes.md: androidboot.serialno=27141FDH2001AB' <<<"$out" || true) == 1 ]] || { echo "$out"; fail "a serial: reported more than once"; }
git checkout -q main && git checkout -q -b serial-placeholder
echo 'androidboot.serialno=<SERIAL>; SERIAL=${serial}' > notes.md
git add -A && git commit -q -m "notes"
check "a serial placeholder" 0
echo "ok - a serial fails, a placeholder passes"

# A grep-matched line with no exempt term fails as before; on a line with
# one, each assignment in the added text (after "<sha> <path>: ", using
# ASCII white space around : or =) is judged on its own value so an exempt
# value (<SERIAL>, SERIAL_PLACEHOLDER, FAKE..., $var, ${var}) hides no
# literal serial beside it. Non-ASCII bytes stay ordinary characters
# inside a value, do not act as white space around : or =, and do not
# fold into ASCII exemptions (U+0130, U+212A).
for line in \
  'androidboot.serialno=<SERIAL> ro.serialno=27141FDH2001AB' \
  'ro.serialno=27141FDH2001AB androidboot.serialno=<SERIAL>' \
  'androidboot.serialno=<SERIAL>;ro.serialno=27141FDH2001AB' \
  'ro.serialno=27141FDH2001AB;androidboot.serialno=<SERIAL>' \
  'serialno=SERIAL_PLACEHOLDER serialno=27141FDH2001AB' \
  'serialno=27141FDH2001AB,serialno=SERIAL_PLACEHOLDER' \
  'serialno=FAKE12345678 serialno=27141FDH2001AB' \
  'serialno=27141FDH2001AB serialno=FAKE12345678' \
  'serialno=FAKE12345678;serialno=27141FDH2001AB' \
  'serialno=FAKE12345678,serialno=27141FDH2001AB' \
  'serialno=FAKE12345678serialno=27141FDH2001AB' \
  'serialno=27141FDH2001ABserialno=FAKE12345678' \
  'SERIAL=$serial serialno=27141FDH2001AB' \
  'serialno=27141FDH2001AB SERIAL=$serial' \
  'SERIAL=${serial} serialno=27141FDH2001AB' \
  'serialno=27141FDH2001AB SERIAL=${serial}' \
  'SERIAL=${serial};serialno=27141FDH2001AB' \
  'serialno=27141FDH2001AB;SERIAL=${serial}' \
  'serialno=ABCDEFGH${suffix}serialno=27141FDH2001AB' \
  'serialno="27141FDH2001AB"${suffix}' \
  '${x:-serialno=27141FDH2001AB}$y' \
  '{serialno=27141FDH2001AB}$var' \
  'serialno=27141FDH2001AB}${var}' \
  'serialno=27141FDH2001AB{$var}' \
  $'serialno=27141FDH2001AB\t$var' \
  $'serialno=27141FDH2001AB\r$var' \
  $'serialno=27141FDH2001AB\f$var' \
  $'serialno=27141FDH2001AB\v$var' \
  $'serialno\t=27141FDH2001AB serialno=FAKE12345678' \
  $'serialno=\t27141FDH2001AB serialno=FAKE12345678' \
  $'serialno=27141FDH2001AB$\xc4\xb0' \
  $'serialno=27141FDH2001AB$\xc4\xb0 serialno=FAKE12345678' \
  $'serialno=27141FDH2001ABFA\xe2\x84\xaaE' \
  $'serialno=27141FDH2001ABFA\xe2\x84\xaaE serialno=FAKE12345678' \
  $'serialno=FAKE12345678\xc2\xa0serialno=27141FDH2001AB'; do
  line_case "$line" 1 "serial numbers"
done
echo "ok - an exempt serial value hides no literal serial beside it on the same line"
for line in \
  'serialno=FAKE12345678' \
  'serialno=FAKE1234_DEV' \
  'serialno=FAKE12345678_1' \
  'serialno=FAKE12345678$1' \
  'serialno=FAKE12345678}' \
  '${opt:-serialno=FAKE12345678}' \
  '{serialno=FAKE12345678}' \
  'serialno=FAKE12345678serial_number=FAKE99999999' \
  'serialno="EXAMPLE1-${suffix}"' \
  $'serialno="EXAMPLE1\xe2\x80\x94${suffix}"' \
  'serialno=ABCDEFGH${suffix}' \
  'serialno=ABCDEFGH$suffix' \
  'serialno=ABCDEFGH-$x' \
  'serialno="ABCDEFGH${suffix}"' \
  'serialno=27141FDH2001ABFAKE' \
  'serialno=EXAMPLESERIAL_PLACEHOLDER' \
  'serialno=ABCDEFGH<serial>' \
  $'serialno=\tFAKE12345678' \
  $'serialno=\rFAKE12345678' \
  $'serialno=\fFAKE12345678' \
  $'serialno=\vFAKE12345678' \
  $'serial: \xe2\x80\x9cdocument\xe2\x80\x9d serialno=FAKE12345678' \
  'serialno=FAKE12345678; androidboot.serialno=<SERIAL>; SERIAL=${serial}; serial=ABCDEFGH$suffix'; do
  line_case "$line" 0
done
echo "ok - FAKE..., <SERIAL>, SERIAL_PLACEHOLDER and shell variables within a value still pass, alone or together"
line_case 'ABCDEFGH12' 1 'serial numbers' serial
line_case 'Document serialno=FAKE12345678' 0 '' serial
line_case 'Document serialno=<SERIAL>' 0 '' serial
line_case 'Document serialno=FAKE12345678' 0 '' fake-serial.md
line_case 'serialno=27141FDH2001AB' 1 'serial numbers' fake-notes.md
line_case $'serial\xce\xb2 = previous_value; serialno = "FAKE12345678"' 0 '' fixture.py
echo "ok - a file path neither exempts a literal serial nor creates a false serial match, and non-ASCII around : or = does not invent one"
if LC_ALL=tr_TR.UTF-8 grep -ci 'serialno' <<<$'SER\xc4\xb0ALNO=X' >/dev/null 2>&1; then
  for line in \
    $'SER\xc4\xb0ALNO=EXAMPLE1234 # <SERIAL>' \
    $'SER\xc4\xb0ALNO=EXAMPLE1234 # $ID' \
    $'serialno:\xe2\x80\x83EXAMPLE1234 # <SERIAL>'; do
    LC_ALL=tr_TR.UTF-8 line_case "$line" 1 "serial numbers"
  done
  echo "ok - base-flagged serial lines under tr_TR.UTF-8 still fail"
else
  echo "ok - tr_TR.UTF-8 serial locale regression skipped (no tr_TR.UTF-8 locale)"
fi

case_branch imei
echo "IMEI: 356938035643809" > notes.md
git add -A && git commit -q -m "notes"
check "an IMEI" 1 "IMEIs"
echo "ok - an IMEI fails"

case_branch blob
head -c 4096 /dev/urandom > modem.bin
git add -A && git commit -q -m "firmware"
check "a blob" 1 "modem.bin"
git checkout -q main && git checkout -q -b image
head -c 4096 /dev/urandom > shot.png
git add -A && git commit -q -m "a screenshot"
check "a screenshot" 0
echo "ok - a firmware blob fails, an image passes"

case_branch sob
echo change > notes.md
git add -A && git commit -q -m "notes" -m "Signed-off-by: Claude <noreply@anthropic.com>"
check "an AI sign-off" 1 "Signed-off-by from an AI agent"
echo "ok - an AI Signed-off-by fails"

# An AI's name is matched as a whole word: a person whose name or address
# only contains one (Tillman, Claudette, Geminiani, precursor) signs off;
# every AI form still fails.
i=0
sob_case() { # who expect [pattern]
  case_branch "sob-$((i += 1))"
  echo change > notes.md
  git add -A && git commit -q -m "notes" -m "Signed-off-by: $1"
  check "Signed-off-by: $1" "$2" "${3:-}"
}
sob_case "Robin Tillman <robin.tillman@example.org>" 0
sob_case "Claudette Lovell <claudette@precursor.example.org>" 0
sob_case "Dana Geminiani <dana.geminiani@example.org>" 0
for who in "Claude Opus 5.5 <noreply@anthropic.com>" "Anthropic <helper@example.org>" "OpenAI <helper@example.org>" \
  "GitHub Copilot <copilot@users.noreply.github.com>" "Codex <helper@example.org>" "ChatGPT <chatgpt@example.org>" \
  "Cursor Agent <cursoragent@cursor.com>" "Gemini <gemini@example.org>" "An LLM <llm@example.org>" \
  "Claude3 <helper@example.org>" "dependabot[bot] <dependabot[bot]@users.noreply.github.com>" \
  "Helper <noreply@github.com> (bot)"; do
  sob_case "$who" 1 "Signed-off-by from an AI agent"
done
echo "ok - a name that only contains an AI's name passes; each AI form fails"

case_branch script
printf '#!/bin/bash\nif then\n' > tools/broken && chmod +x tools/broken
git add -A && git commit -q -m "tools: broken"
check "a broken script" 1 "tools/broken" "" "rewrite the named commit"
echo "ok - a script that doesn't parse fails without the rewrite hint"

# A touched file shorter than 64 bytes, with a head on PATH that writes once
# more after the data, as uutils' head (the build machine's) writes again at
# the end of a short file, after the reader of its first line may have gone.
mkdir "$t/bin"
cat > "$t/bin/head" <<'EOF'
#!/bin/bash
PATH=${PATH#*:}
[[ $1 == -c ]] || exec head "$@"
head "$@"; sleep 1; echo
EOF
chmod +x "$t/bin/head"
case_branch short-file
printf '#!/bin/bash\necho hi\n' > tools/hi && chmod +x tools/hi
git add -A && git commit -q -m "tools: hi"
PATH=$t/bin:$PATH check "a script shorter than 64 bytes" 0 "touched scripts parse"
echo "ok - a script shorter than 64 bytes passes when head writes again at end of file"

# Only the first 64 bytes are looked at, NULs included: an image whose NULs
# push a shebang past byte 64 is not a script.
case_branch nul-window
{ head -c 60 /dev/zero; printf '#!/bin/bash\nif then\n'; } > tools/looks.png
git add -A && git commit -q -m "tools: an image"
check "a shebang past byte 64" 0 "touched scripts parse"
echo "ok - a shebang after 60 NUL bytes is past the 64-byte window"

# Every commit in the range is scanned, not just the combined diff: an
# identifier or blob added in one commit and removed in a later commit still
# fails and names the commit that added it, not the one that removed it.
add_remove_id() { # branch label line expect-msg
  local add_sha rm_sha
  case_branch "$1"
  printf '%s\n' "$3" > notes.md
  git add notes.md && git commit -q -m "notes: add $2"
  add_sha=$(git rev-parse --short HEAD)
  printf 'clean\n' > notes.md
  git add notes.md && git commit -q -m "notes: remove $2"
  rm_sha=$(git rev-parse --short HEAD)
  check "added-then-removed $2" 1 "$4" "$add_sha notes.md:" "$rm_sha "
}
add_remove_id mac-removed "MAC" "wlan0 at $V" "MAC or Bluetooth addresses"
add_remove_id mac-plusplus-removed "MAC on a ++ line" "++ $V" "MAC or Bluetooth addresses"
add_remove_id getprop-removed "getprop" "[ro.boot.hardware.revision]: [MP1.0]" "getprop output"
add_remove_id serial-removed "serial" "androidboot.serialno=27141FDH2001AB" "serial numbers"
add_remove_id imei-removed "IMEI" "IMEI: 356938035643809" "IMEIs"
echo "ok - added-then-removed MAC, getprop, serial and IMEI fail and name the adding commit"

case_branch blob-removed
head -c 4096 /dev/zero > modem.bin
git add modem.bin && git commit -q -m "firmware: add modem.bin"
add_sha=$(git rev-parse --short HEAD)
git rm -q modem.bin && git commit -q -m "firmware: remove modem.bin"
rm_sha=$(git rev-parse --short HEAD)
check "added-then-removed binary blob" 1 "binaries or vendor files" "$add_sha modem.bin" "$rm_sha "

case_branch named-blob-removed
printf 'placeholder text\n' > stub.bin
git add stub.bin && git commit -q -m "firmware: add stub.bin"
add_sha=$(git rev-parse --short HEAD)
git rm -q stub.bin && git commit -q -m "firmware: remove stub.bin"
rm_sha=$(git rev-parse --short HEAD)
check "added-then-removed text blob extension" 1 "binaries or vendor files" "$add_sha stub.bin" "$rm_sha "
echo "ok - added-then-removed binary and named blobs fail and name the adding commit"

case_branch multi-clean
printf 'first clean commit with %s\n' "$L" > notes.md
git add notes.md && git commit -q -m "notes: first clean commit"
printf 'second clean commit\n' >> notes.md
git add notes.md && git commit -q -m "notes: second clean commit"
check "clean multi-commit branch" 0
echo "ok - a clean multi-commit branch passes"

# Merging main into a branch does not blame main's own identifiers or blobs
# on the PR, while a new identifier or blob introduced by the merge commit
# itself (e.g. during conflict resolution) still fails and names the merge.
case_branch merge-clean
printf 'shared from feature\n' > shared.md
git add shared.md && git commit -q -m "feature: before merge"
git checkout -q main
printf 'upstream mac %s\n' "$V" > upstream.md
head -c 4096 /dev/zero > upstream.bin
printf 'upstream stub\n' > upstream.fw
printf 'shared main mac %s\n' "$V" > shared.md
git add upstream.md upstream.bin upstream.fw shared.md && git commit -q -m "main: upstream mac and blobs"
main_sha=$(git rev-parse --short HEAD)
git checkout -q merge-clean
git merge -q --no-commit main >/dev/null 2>&1 || true
printf 'shared from feature\nshared main mac %s\nshared resolved cleanly\n' "$V" > shared.md
chmod +x upstream.bin
git add shared.md upstream.bin && git commit -q -m "merge main cleanly"
git rev-parse -q --verify HEAD^2 >/dev/null || fail "merge-clean: not a merge commit"
printf 'after merge\n' > after.md
git add after.md && git commit -q -m "feature: after merge"
check "clean merge of main carrying MAC and blobs" 0
echo "ok - merging main carrying a real MAC and blobs does not blame main on the PR"

git checkout -q merge-clean~2
git checkout -q -b merge-evil-mac
git merge -q --no-commit main >/dev/null 2>&1 || true
printf 'resolved with %s\n' "$V" > shared.md
git add shared.md && git commit -q -m "merge main with new mac"
git rev-parse -q --verify HEAD^2 >/dev/null || fail "merge-evil-mac: not a merge commit"
merge_sha=$(git rev-parse --short HEAD)
check "merge introducing new MAC" 1 "MAC or Bluetooth addresses" "$merge_sha shared.md:" "$main_sha "

git checkout -q merge-clean~2
git checkout -q -b merge-evil-binary
git merge -q --no-commit main >/dev/null 2>&1 || true
printf 'resolved cleanly\n' > shared.md
head -c 4096 /dev/zero > evil.dat
git add shared.md evil.dat && git commit -q -m "merge main with new binary"
git rev-parse -q --verify HEAD^2 >/dev/null || fail "merge-evil-binary: not a merge commit"
merge_sha=$(git rev-parse --short HEAD)
check "merge introducing new binary" 1 "binaries or vendor files" "$merge_sha evil.dat" "$main_sha "

git checkout -q merge-clean~2
git checkout -q -b merge-evil-named-blob
git merge -q --no-commit main >/dev/null 2>&1 || true
printf 'resolved cleanly\n' > shared.md
printf 'new stub\n' > evil.fw
git add shared.md evil.fw && git commit -q -m "merge main with new .fw"
git rev-parse -q --verify HEAD^2 >/dev/null || fail "merge-evil-named-blob: not a merge commit"
merge_sha=$(git rev-parse --short HEAD)
check "merge introducing new named blob" 1 "binaries or vendor files" "$merge_sha evil.fw" "$main_sha "
echo "ok - a merge commit introducing a new MAC or blob fails and names the merge commit"

# Renaming an already-tracked text file with a blob extension passes, while
# adding one and renaming it in a later commit still fails and names the
# adding commit (not the rename commit), and adding a non-blob file then
# renaming it into a blob extension (pure rename or rename with edit) fails
# and names the rename commit.
case_branch rename-tracked-named-blob
git mv upstream.fw renamed.fw
git commit -q -m "firmware: rename tracked stub"
check "renaming tracked text blob extension" 0

case_branch add-then-rename-named-blob
printf 'new stub\n' > new.fw
git add new.fw && git commit -q -m "firmware: add new.fw"
add_sha=$(git rev-parse --short HEAD)
git mv new.fw moved.fw
git commit -q -m "firmware: rename new.fw"
mv_sha=$(git rev-parse --short HEAD)
check "added-then-renamed text blob extension" 1 "binaries or vendor files" "$add_sha new.fw" "$mv_sha "

case_branch add-txt-then-rename-to-blob
printf 'plain text\n' > plain_fw
git add plain_fw && git commit -q -m "notes: add plain_fw"
add_sha=$(git rev-parse --short HEAD)
git mv plain_fw plain.fw
git commit -q -m "notes: rename plain_fw to plain.fw"
mv_sha=$(git rev-parse --short HEAD)
check "added non-blob then renamed to blob extension" 1 "binaries or vendor files" "$mv_sha plain.fw" "$add_sha "

case_branch add-txt-then-rename-edit-to-blob
printf 'line 1\nline 2\nline 3\nline 4\n' > plain.txt
git add plain.txt && git commit -q -m "notes: add plain.txt"
add_sha=$(git rev-parse --short HEAD)
git mv plain.txt edited.fw
printf 'line 1\nline 2\nline 3\nline 4 edited\n' > edited.fw
git add edited.fw && git commit -q -m "notes: rename and edit plain.txt to edited.fw"
mv_sha=$(git rev-parse --short HEAD)
check "added text then renamed with edit to blob extension" 1 "binaries or vendor files" "$mv_sha edited.fw" "$add_sha "
echo "ok - renaming a tracked blob-extension text file passes; adding then renaming one blames the add; renaming a non-blob file into a blob extension blames the rename"

# An unrelated history merged into a branch brings a root commit into the
# range; pr-check must scan it even when log.showRoot=false is set.
git checkout -q --orphan orphan-root
git rm -rfq .
printf 'orphan mac %s\n' "$V" > orphan.md
head -c 4096 /dev/zero > orphan.dat
printf 'orphan stub\n' > orphan.fw
git add orphan.md orphan.dat orphan.fw && git commit -q -m "orphan: root with mac and blobs"
root_sha=$(git rev-parse --short HEAD)
case_branch merge-orphan
git merge -q --allow-unrelated-histories -m "merge orphan history" orphan-root
git rev-parse -q --verify HEAD^2 >/dev/null || fail "merge-orphan: not a merge commit"
GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=log.showRoot GIT_CONFIG_VALUE_0=false \
  check "unrelated root commit MAC under log.showRoot=false" 1 "MAC or Bluetooth addresses" "$root_sha orphan.md:"
GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=log.showRoot GIT_CONFIG_VALUE_0=false \
  check "unrelated root commit binary under log.showRoot=false" 1 "binaries or vendor files" "$root_sha orphan.dat"
GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=log.showRoot GIT_CONFIG_VALUE_0=false \
  check "unrelated root commit named blob under log.showRoot=false" 1 "binaries or vendor files" "$root_sha orphan.fw"
echo "ok - an unrelated root commit's MAC, binary and named blob fail even under log.showRoot=false"

# History simplification would drop a side branch discarded by a merge
# (e.g. git merge -s ours); --full-history keeps its commits in the scan.
case_branch side-mac
printf 'side mac %s\n' "$V" > side.md
git add side.md && git commit -q -m "side: add real MAC"
side_sha=$(git rev-parse --short HEAD)
case_branch merge-ours-discard
git merge -q --no-ff -s ours -m "discard side branch" side-mac
git rev-parse -q --verify HEAD^2 >/dev/null || fail "merge-ours-discard: not a merge commit"
check "side-branch MAC discarded by merge -s ours" 1 "MAC or Bluetooth addresses" "$side_sha side.md:"
echo "ok - a side-branch MAC discarded by git merge -s ours still fails and names the side commit"

# A range with only merge commits (no non-merge commits) must still be
# scanned rather than treated as "no commits to check".
case_branch merge-only-evil
printf 'merge-only mac %s\n' "$V" > merge-only.md
git add merge-only.md
tree=$(git write-tree)
merge_only=$(git commit-tree "$tree" -p main -p main~1 -m "merge-only evil mac")
git reset -q --hard "$merge_only"
[[ -z $(git rev-list --no-merges main..HEAD) ]] || fail "merge-only-evil: expected no non-merge commits"
[[ -n $(git rev-list --merges main..HEAD) ]] || fail "merge-only-evil: expected a merge commit"
merge_sha=$(git rev-parse --short HEAD)
check "merge-only range introducing new MAC" 1 "MAC or Bluetooth addresses" "$merge_sha merge-only.md:" "no commits to check"
echo "ok - a merge-only range introducing a real MAC fails and does not say 'no commits to check'"

git checkout -q main
check "nothing to check" 0 "no commits"
echo "ok - no commits, nothing to check"
