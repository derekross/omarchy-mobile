#!/bin/bash
# SPDX-License-Identifier: MIT
# An unsigned development bundle, assembled to the end (no phone, nothing
# signed): it carries the install guide and tools/phone-provision with
# everything that tool runs (tools/phone-ssh and the extract-* tools), so a
# user provisions from the bundle without the repository; those files are in
# SHA256SUMS and in manifest.json like every other bundle file; README.txt
# points to them; and the bundled phone-provision finds its tools inside the
# bundle (its dry run, with a stand-in NV backup and factory image). The
# one-file download: omamobile-<codename>-<version>.tar holds exactly the
# bundle directory and the root image's three files, unpacks to the layout
# the installer expects, matches its .tar.sha256, has no signature when the
# bundle is unsigned, and is the same bytes when the bundle is made again
# (sorted names, fixed mtime, owner and modes, whatever the umask and the
# files' times). A rebuild replaces the bundle directory and leaves nothing
# else in out/bundle, and one that fails moving the new directory in puts
# the old one back; after a run killed there, the next run puts it back,
# even one an input check refuses. A second run for the same bundle while
# one runs is refused, and the first one completes. The bundled nv-backup
# reads the bundle's device.conf.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
SRC=$PWD
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
for tool in python3 flock; do command -v "$tool" >/dev/null || { echo "ok - # skip: no $tool"; exit 0; }; done
t=$(mktemp -d)
trap 'rm -rf "$t"' EXIT
r=$t/repo k=$t/kernel
tools="phone-provision nv-backup phone-ssh phone-ssh-proxy extract-vendor-firmware extract-vendor-chroot extract-fingerprint-vendor extract-camera-data"
mkdir -p "$r/tools/lib" "$r/docs" "$r/device/testdev" "$r/packages/omamobile-keyring" "$r/out" \
  "$k/include/config" "$k/images"
cp tools/make-bundle tools/bundle-manifest tools/install-phone "$r/tools/"
cp tools/lib/signing.sh tools/lib/bundle-tar.sh "$r/tools/lib/"
for f in $tools; do cp "tools/$f" "$r/tools/"; done
cp docs/INSTALL.md "$r/docs/"
printf 'CODENAME=testdev\nNAME="Test device"\nBOOT_IMAGES="boot dtbo"\nUFS_RW="boot_b dtbo_b userdata"\n' > "$r/device/testdev/device.conf"
: > "$r/packages/omamobile-keyring/omamobile.gpg"
git -C "$r" init -q && git -C "$r" -c user.name=t -c user.email=t@example.invalid commit -q --allow-empty -m init
echo test-release > "$k/include/config/kernel.release"
echo testdev > "$k/images/DEVICE"
printf boot > "$k/images/boot.img"
printf dtbo > "$k/images/dtbo.img"
root=$r/out/omamobile-rootfs-testdev-2026.11.01-aarch64.img.zst
printf root > "$root"
(cd "$r/out" && sha256sum "$(basename "$root")" > "$(basename "$root").sha256")
printf 'device: testdev\nkernel modules: test-release\nomamobile channel: development\n' > "${root%.img.zst}.MANIFEST"

out=$(DEVICE=testdev KERNEL_OUT=$k KERNEL_DIR=$r "$r/tools/make-bundle" --unsigned --version 2026.11.01 --rootfs "$root" 2>&1) ||
  fail "an unsigned bundle assembles: $out"
b=$r/out/bundle/omamobile-testdev-2026.11.01
[[ -f $b/install && -f $b/manifest.json && -f $b/SHA256SUMS && ! -e $b/SHA256SUMS.sig ]] || fail "the bundle has install, manifest.json and SHA256SUMS, no signature"
pass "an unsigned development bundle assembles"

for f in $tools; do
  [[ -x $b/tools/$f ]] || fail "the bundle has an executable tools/$f"
  cmp -s "$b/tools/$f" "tools/$f" || fail "tools/$f is the repository's"
done
cmp -s "$b/INSTALL.md" docs/INSTALL.md || fail "the bundle carries docs/INSTALL.md as INSTALL.md"
pass "the bundle carries INSTALL.md and phone-provision with everything it runs"

# Exercise the bundled wrapper's explicit transport without SSH/network IO.
mkdir -p "$t/stubs"
cat >"$t/stubs/ssh" <<'SH'
#!/bin/sh
printf '%s\n' "$@"
SH
chmod +x "$t/stubs/ssh"
PATH="$t/stubs:$PATH" OMAMOBILE_SSH_CONFIG=/dev/null OMAMOBILE_SSH_INTERFACE=usb-fixture \
  "$b/tools/phone-ssh" --fresh true >"$t/bundle-transport"
grep -F -- '--relay usb-fixture 172.16.42.1' "$t/bundle-transport" >/dev/null || fail "bundled wrapper finds its direct transport helper"
pass "bundled phone-ssh resolves its helper with no checkout or network"


(cd "$b" && sha256sum -c --quiet SHA256SUMS) || fail "SHA256SUMS checks"
for f in INSTALL.md $(printf 'tools/%s ' $tools); do
  [[ $(grep -cE "^[0-9a-f]{64}  $f\$" "$b/SHA256SUMS") == 1 ]] || fail "SHA256SUMS covers $f once"
done
python3 -I - "$b" $tools <<'PY' || fail "manifest.json lists the provisioning tools and INSTALL.md with size and checksum"
import hashlib, json, os, sys
b, tools = sys.argv[1], sys.argv[2:]
files = {f["path"]: f for f in json.load(open(os.path.join(b, "manifest.json")))["files"]}
for p in ["INSTALL.md"] + ["tools/" + t for t in tools]:
    data = open(os.path.join(b, p), "rb").read()
    assert files[p]["size"] == len(data), p
    assert files[p]["sha256"] == hashlib.sha256(data).hexdigest(), p
PY
pass "SHA256SUMS and manifest.json cover the new files"

grep -c 'tools/phone-provision --first-install --nv-backup DIR FACTORY.zip' "$b/README.txt" >/dev/null || fail "README.txt gives the provisioning command"
grep -c 'from this directory' "$b/README.txt" >/dev/null || fail "README.txt says to run it from the bundle"
if grep -c 'from the repository' "$b/README.txt" >/dev/null; then fail "README.txt no longer sends the user to the repository"; fi
grep -c 'INSTALL.md' "$b/README.txt" >/dev/null || fail "README.txt points to INSTALL.md"
grep -c '  bash tools/nv-backup DIR$' "$b/README.txt" >/dev/null || fail "README.txt gives the backup command"
grep -c 'run "bash install" from this directory' "$b/README.txt" >/dev/null || fail "README.txt says bash install"
if grep -c '\./install' "$b/README.txt" >/dev/null; then fail "README.txt no longer says ./install"; fi
grep -c 'sha256sum -c omamobile-testdev-2026.11.01.tar.sha256' "$b/README.txt" >/dev/null || fail "README.txt names the one-file download's check"
pass "README.txt points to INSTALL.md, the bundled nv-backup and phone-provision, and says bash install"

# The bundled phone-provision runs from the bundle: its dry run (no phone)
# names the bundle's own extract tools. HOME is a scratch directory, so no
# real backup on this machine is found.
nv=$t/nv
mkdir -p "$nv" "$t/home"
for p in modem_a modem_b efs efs_backup modem_userdata persist; do
  printf '%064d  %s.img\n' 0 "$p" >> "$nv/SHA256SUMS"
done
: > "$t/factory.zip"
out=$(cd "$t" && HOME=$t/home PHONE_SSH=false "$b/tools/phone-provision" --dry-run --work "$t/work" \
  --first-install --nv-backup "$nv" "$t/factory.zip" 2>&1) || fail "the bundled phone-provision's dry run: $out"
grep -c 'would run: tools/extract-vendor-firmware' <<<"$out" >/dev/null || fail "the dry run names the extract tools: $out"
pass "the bundled phone-provision runs from the bundle"

# --- The one-file download --------------------------------------------------
tarball=$r/out/bundle/omamobile-testdev-2026.11.01.tar
[[ -f $tarball && -f $tarball.sha256 && ! -e $tarball.sha256.sig ]] || fail "an unsigned bundle has a .tar and .tar.sha256, no signature"
(cd "$r/out/bundle" && sha256sum -c --quiet --strict "${tarball##*/}.sha256") || fail "the .tar matches its .tar.sha256"
[[ $(cat "$tarball.sha256") =~ ^[0-9a-f]{64}\ \ omamobile-testdev-2026\.11\.01\.tar$ ]] || fail "the .tar.sha256 is one sha256sum line naming the tar"
members=$(tar -tf "$tarball")
expected=$( (cd "$r/out/bundle" && find omamobile-testdev-2026.11.01 \( -type d -printf '%p/\n' \) -o \( -type f -printf '%p\n' \)
  printf '%s\n' omamobile-rootfs-testdev-2026.11.01-aarch64.img.zst omamobile-rootfs-testdev-2026.11.01-aarch64.img.zst.sha256 \
    omamobile-rootfs-testdev-2026.11.01-aarch64.MANIFEST) | LC_ALL=C sort)
[[ $(LC_ALL=C sort <<<"$members") == "$expected" ]] || fail "the tar holds exactly the bundle and the root image's three files: $members"
tar -tvf "$tarball" | awk '$2 != "0/0" { bad = 1 } END { exit bad }' || fail "every member is owned by 0/0"
[[ $(TZ=UTC tar -tvf "$tarball" | awk '{ print $4 }' | sort -u) == 2026-11-01 ]] || fail "every mtime is the release date"
tar -tvf "$tarball" omamobile-testdev-2026.11.01/install | grep -c '^-rwxr-xr-x' >/dev/null || fail "install keeps its execute bit in the tar"
tar -tvf "$tarball" omamobile-testdev-2026.11.01/README.txt | grep -c '^-rw-r--r--' >/dev/null || fail "README.txt is 644 in the tar"
mkdir "$t/unpacked"
tar -C "$t/unpacked" -xf "$tarball"
(cd "$t/unpacked/omamobile-testdev-2026.11.01" && sha256sum -c --quiet SHA256SUMS) || fail "the unpacked bundle checks against its SHA256SUMS"
cmp -s "$t/unpacked/omamobile-rootfs-testdev-2026.11.01-aarch64.img.zst" "$root" || fail "the root image unpacks beside the bundle"
pass "the .tar holds the bundle and the root image side by side, 0/0, one mtime, and matches its .tar.sha256"

first=$(cat "$tarball.sha256")
touch -d '2001-02-03 04:05' "$r/docs/INSTALL.md" "$root"
chmod 600 "$root.sha256"
: > "$b/left-over"
out=$(umask 077 && DEVICE=testdev KERNEL_OUT=$k KERNEL_DIR=$r "$r/tools/make-bundle" --unsigned --version 2026.11.01 --rootfs "$root" 2>&1) ||
  fail "the bundle assembles again: $out"
[[ $(cat "$tarball.sha256") == "$first" ]] || fail "the tar is the same bytes when made again with another umask and file times"
pass "the .tar is deterministic"
[[ ! -e $b/left-over ]] || fail "the rebuild replaces the bundle directory"
listing=$(printf '%s\n' omamobile-rootfs-testdev-2026.11.01-aarch64.MANIFEST omamobile-rootfs-testdev-2026.11.01-aarch64.img.zst \
  omamobile-rootfs-testdev-2026.11.01-aarch64.img.zst.sha256 omamobile-testdev-2026.11.01 omamobile-testdev-2026.11.01.tar \
  omamobile-testdev-2026.11.01.tar.sha256)
[[ $(LC_ALL=C ls -A "$r/out/bundle") == "$listing" ]] || fail "the rebuild leaves the bundle, its .tar and the root image, nothing else: $(ls -A "$r/out/bundle")"
pass "a rebuild replaces the bundle directory and leaves nothing else in out/bundle"
# The bundle checks out and out/bundle holds what it held after the rebuild
intact() { (cd "$b" && sha256sum -c --quiet SHA256SUMS) && [[ $(LC_ALL=C ls -A "$r/out/bundle") == "$listing" ]]; }

# A stand-in mv that fails the move of the new directory into place
mkdir "$t/failmv"
printf '#!/bin/sh\ncase "$*" in *".new/omamobile-testdev-2026.11.01 "*) exit 1 ;; esac\nPATH=${PATH#*:} exec mv "$@"\n' > "$t/failmv/mv"
chmod +x "$t/failmv/mv"
out=$(PATH=$t/failmv:$PATH DEVICE=testdev KERNEL_OUT=$k KERNEL_DIR=$r "$r/tools/make-bundle" --unsigned --version 2026.11.01 --rootfs "$root" 2>&1) &&
  fail "a rebuild whose move into place fails says so: $out"
intact || fail "a failed move into place puts the old bundle back: $(ls -A "$r/out/bundle")"
pass "a rebuild that fails moving the new bundle in puts the old one back"

# A run killed (SIGKILL, no trap) between the two renames leaves the old
# bundle in the build directory; the next run puts it back, even one that an
# input check refuses, and a run that goes on starts from an empty build
# directory (here the killed run's SHA256SUMS.sig, from a signed build)
mkdir "$t/killmv"
printf '#!/bin/sh\ncase "$*" in *".new/omamobile-testdev-2026.11.01 "*) kill -KILL $PPID; exit 1 ;; esac\nPATH=${PATH#*:} exec mv "$@"\n' > "$t/killmv/mv"
chmod +x "$t/killmv/mv"
kill_between_renames() {
  { PATH=$t/killmv:$PATH DEVICE=testdev KERNEL_OUT=$k KERNEL_DIR=$r "$r/tools/make-bundle" --unsigned --version 2026.11.01 --rootfs "$root" >/dev/null 2>&1; } 2>/dev/null &&
    fail "the stand-in mv kills the rebuild"
  [[ ! -e $b && -d $r/out/bundle/.omamobile-testdev-2026.11.01.new/old ]] || fail "the killed rebuild left the old bundle aside"
}
kill_between_renames
echo otherdev > "$k/images/DEVICE"
out=$(DEVICE=testdev KERNEL_OUT=$k KERNEL_DIR=$r "$r/tools/make-bundle" --unsigned --version 2026.11.01 --rootfs "$root" 2>&1) &&
  fail "a rebuild with another device's images is refused: $out"
echo testdev > "$k/images/DEVICE"
intact || fail "a refused run after a killed one puts the old bundle back: $(ls -A "$r/out/bundle")"
kill_between_renames
: > "$r/out/bundle/.omamobile-testdev-2026.11.01.new/omamobile-testdev-2026.11.01/SHA256SUMS.sig"
out=$(DEVICE=testdev KERNEL_OUT=$k KERNEL_DIR=$r "$r/tools/make-bundle" --unsigned --version 2026.11.01 --rootfs "$root" 2>&1) ||
  fail "the bundle assembles after a killed run: $out"
[[ ! -e $b/SHA256SUMS.sig ]] && intact || fail "a run after a killed one starts from an empty build directory: $(ls -A "$b" "$r/out/bundle")"
pass "after a run killed between the renames, the next run puts the old bundle back, refused or not"

# Two runs for the same bundle at once: the second (here one an input check
# refuses) is refused before its start-up cleanup, so the first one's build
# directory stays and the first build completes; a run for another version
# builds meanwhile. A stand-in install holds the first build at its first
# copy until the FIFO $t/hold is written.
mkdir "$t/slow"
mkfifo "$t/hold"
printf '#!/bin/sh\nif [ -p "$HOLD" ]; then echo held; read -r _ < "$HOLD"; rm -f "$HOLD"; fi\nPATH=${PATH#*:} exec install "$@"\n' > "$t/slow/install"
chmod +x "$t/slow/install"
HOLD=$t/hold PATH=$t/slow:$PATH DEVICE=testdev KERNEL_OUT=$k KERNEL_DIR=$r "$r/tools/make-bundle" --unsigned --version 2026.11.01 --rootfs "$root" > "$t/first" 2>&1 &
pid=$!
timeout 30 sh -c 'until grep -c held "$1" >/dev/null; do sleep 0.1; done' - "$t/first" || held=no
second=$(DEVICE=testdev KERNEL_OUT=$t/no-kernel timeout 30 "$r/tools/make-bundle" --unsigned --version 2026.11.01 --rootfs "$root" 2>&1) || true
other=$(DEVICE=testdev KERNEL_OUT=$k KERNEL_DIR=$r timeout 30 "$r/tools/make-bundle" --unsigned --version 2026.11.02 --rootfs "$root" 2>&1) || other="failed: $other"
[[ ! -p $t/hold ]] || timeout 5 sh -c 'echo go > "$1"' - "$t/hold" || true
wait "$pid" && first=ok || first=$(cat "$t/first")
[[ -z ${held:-} ]] || fail "the stand-in install holds the first build: $(cat "$t/first")"
grep -c "already building omamobile-testdev-2026.11.01 in out/bundle" <<<"$second" >/dev/null || fail "a second run for the same bundle is refused: $second"
[[ $other != failed:* ]] || fail "a run for another version builds while the first one runs: $other"
[[ $first == ok ]] || fail "the first build completes after a second run was refused: $first"
rm -rf "$r/out/bundle/omamobile-testdev-2026.11.02" "$r/out/bundle/omamobile-testdev-2026.11.02.tar" "$r/out/bundle/omamobile-testdev-2026.11.02.tar.sha256"
intact || fail "the first build is in place, nothing else: $(ls -A "$r/out/bundle")"
pass "a second run for the same bundle is refused and the first one completes; another version builds meanwhile"

# The bundled nv-backup runs from the bundle with the bundle's descriptor
# (testdev names no NV_PARTS, so it says so and contacts no phone)
out=$(PHONE_SSH=false "$b/tools/nv-backup" --list 2>&1) && fail "nv-backup refuses a descriptor without NV_PARTS"
grep -c "device.conf names no NV_PARTS" <<<"$out" >/dev/null || fail "the bundled nv-backup reads the bundle's device.conf: $out"
pass "the bundled nv-backup reads the bundle's device.conf"
