#!/bin/bash
# SPDX-License-Identifier: MIT
# Tests for tools/phone-provision with a synthetic backup in the old layout
# (no real phone data, no factory image): the dry run's path mapping (old
# names to new, the old account's home to the user's), that it touches
# nothing in a dry run, --fingerprint from a backup directory with a space
# in its path, and, when Docker is available, a real run against a
# throwaway Arch Linux container standing in for the phone: files land
# under the new names owned by root (tar --no-same-owner), the fingerprint
# tree keeps its Android owners, the home import belongs to the user, a
# second run is idempotent, and differing fingerprint state is never replaced
# without --force. The run is named on the command line (--restore DIR or
# --first-install), never guessed: with neither it is refused, also on a
# machine whose home holds the old default backup, and --first-install there
# takes nothing from that backup. A first install with a stand-in NV
# backup (made-up sums): its dry run, its refusals (no --nv-backup, one of
# the six NV lines missing or not in sha256sum's format, no SHA256SUMS, an
# option that needs phone-config.tar, an unsafe PHONE_BOOTCONFIG); without
# Docker, against a stand-in that runs only the board id check, a missing,
# empty or malformed androidboot.cdt_hwid refused before any push, the six
# lines staged, and the value in no output or command; and in the container
# the board id from a stand-in bootconfig into props.conf (root's, mode
# 600, its other lines kept on a second run), the six lines into
# modem-nv.sha256, the refusals with nothing written, and the value never in
# the output, a bash -x trace or the laptop's staging.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
SRC=$PWD
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
t=$(mktemp -d)
container=""
cleanup() { [[ -n $container ]] && docker rm -f "$container" >/dev/null 2>&1; rm -rf "$t"; }
trap cleanup EXIT

# A backup shaped like the 2026-10-13 one, with made-up contents
B=$t/backup; S=$t/src
mkdir -p "$B" "$S/var/lib/omandroid-vendor/modem" "$S/etc/omandroid" "$S/usr/lib/firmware/omandroid/camera" \
         "$S/etc/NetworkManager/system-connections" "$S/home/omandroid/.config/omandroid/widgets/my.test-widget" \
         "$S/home/omandroid/.config/omarchy"
echo 'ro.boot.cdt_hwid=0xTEST' > "$S/var/lib/omandroid-vendor/modem/props.conf"
echo '0000  modem_userdata' > "$S/etc/omandroid/modem-nv.sha256"
echo 'stage = media' > "$S/etc/omandroid/speaker.conf"
echo 'stage = old' > "$S/etc/omandroid/speaker.conf.pacnew"
echo 'camera data' > "$S/usr/lib/firmware/omandroid/camera/imx386-uw.bin"
printf '[connection]\nid=test\n' > "$S/etc/NetworkManager/system-connections/test.nmconnection"
chmod 600 "$S/etc/NetworkManager/system-connections/test.nmconnection"
echo '{"pages": [{"plugin": "omandroid.home"}]}' > "$S/home/omandroid/.config/omandroid/home.json"
echo '{"tiles": ["omandroid.wifi"]}' > "$S/home/omandroid/.config/omandroid/quicksettings.json"
echo 'import qs.Omandroid' > "$S/home/omandroid/.config/omandroid/widgets/my.test-widget/Widget.qml"
echo '{}' > "$S/home/omandroid/.config/omarchy/shell.json"
tar -C "$S" -cf "$B/phone-config.tar" var/lib/omandroid-vendor/modem/props.conf etc/omandroid usr/lib/firmware/omandroid \
  etc/NetworkManager/system-connections home/omandroid/.config/omandroid home/omandroid/.config/omarchy/shell.json
(cd "$B" && sha256sum phone-config.tar > phone-config.tar.sha256)
F=$t/fp/omandroid-fp
mkdir -p "$F/persist-ss" "$F/data/vendor/omandroid-fp" "$F/data/vendor/ss"
echo 'secure storage' > "$F/persist-ss/0"
echo 'tamper-detect' > "$F/data/vendor/ss/0"
echo 'calibration' > "$F/mfg_data.img"
echo 'secret' > "$F/data/vendor/omandroid-fp/secret"
tar -C "$t/fp" --numeric-owner --owner=0 --group=0 -cf "$B/var-lib-omandroid-fp.tar" omandroid-fp/mfg_data.img omandroid-fp/data
tar -C "$t/fp" --numeric-owner --owner=1000 --group=1000 -rf "$B/var-lib-omandroid-fp.tar" omandroid-fp/persist-ss
(cd "$B" && sha256sum var-lib-omandroid-fp.tar > var-lib-omandroid-fp.tar.sha256)

# A dry run contacts no phone: the fake ssh fails the test if it's called
cat > "$t/no-ssh" <<'EOF'
#!/bin/bash
echo "ssh called: $*" >> "$T/ssh.calls"; exit 1
EOF
chmod +x "$t/no-ssh"
export T=$t
out=$(PHONE_SSH=$t/no-ssh tools/phone-provision --dry-run --skip-extract --restore "$B" --work "$t/work" \
      --user alice --import-home --restore-config --restore-wifi --fingerprint 2>&1) || { echo "$out"; fail "the dry run succeeds"; }
[[ ! -e $t/ssh.calls ]] || fail "a dry run never contacts the phone"
for line in \
  "var/lib/omandroid-vendor/modem/props.conf -> /var/lib/omamobile-vendor/modem/props.conf" \
  "etc/omandroid/modem-nv.sha256 -> /etc/omamobile/modem-nv.sha256" \
  "usr/lib/firmware/omandroid/camera/imx386-uw.bin -> /usr/lib/firmware/omamobile/camera/imx386-uw.bin" \
  "etc/omandroid/speaker.conf -> /etc/omamobile/speaker.conf" \
  "etc/NetworkManager/system-connections/test.nmconnection -> /etc/NetworkManager/system-connections/test.nmconnection" \
  "home/omandroid/.config/omandroid/home.json -> /home/alice/.config/omamobile/home.json" \
  "home/omandroid/.config/omandroid/widgets -> /home/alice/.config/omamobile/widgets" \
  "/var/lib/omandroid-fp/mfg_data.img -> /var/lib/omamobile-fp/mfg_data.img" \
  "/var/lib/omandroid-fp/persist-ss/0 -> /var/lib/omamobile-fp/persist-ss/0" \
  "would stop omamobile-fp.service"; do
  grep -qF -- "$line" <<<"$out" || { echo "$out"; fail "maps: $line"; }
done
grep -q 'pacnew' <<<"$out" && fail "never restores .pacnew files"
grep -q 'never starts omamobile-fp' <<<"$out" || fail "says it never starts the fingerprint service"
grep -q 'data/vendor' <<<"$out" && fail "without --restore-td, no TD or Gatekeeper secret is restored"
out=$(PHONE_SSH=$t/no-ssh tools/phone-provision --dry-run --skip-extract --restore "$B" --work "$t/work" \
      --user alice --fingerprint --restore-td 2>&1) || { echo "$out"; fail "the --restore-td dry run succeeds"; }
grep -qF "/var/lib/omandroid-fp/data/vendor/omandroid-fp/secret -> /var/lib/omamobile-fp/data/vendor/omamobile-fp/secret" <<<"$out" ||
  fail "--restore-td restores the Gatekeeper secret"
grep -qF "/var/lib/omandroid-fp/data/vendor/ss/0 -> /var/lib/omamobile-fp/data/vendor/ss/0" <<<"$out" || fail "--restore-td restores TD"
grep -q 'no storageproxyd ran' <<<"$out" || fail "--restore-td states the no-run-in-between rule"
out=$(PHONE_SSH=$t/no-ssh tools/phone-provision --dry-run --skip-extract --restore "$B" --work "$t/work" --restore-td 2>&1) &&
  fail "--restore-td without --fingerprint is refused"
[[ -z $(ls -A "$t/work") ]] || fail "the staging (per-phone data) is removed"
pass "dry run: old paths mapped to new names and the user's home, phone untouched; fingerprint: calibration and persist:/ss only, TD only with --restore-td"

# A backup directory with a space in its path: --fingerprint checks the
# fingerprint archive as one file, as it does the config archive
mkdir "$t/backup with space"
cp "$B"/* "$t/backup with space/"
out=$(PHONE_SSH=$t/no-ssh tools/phone-provision --dry-run --skip-extract --restore "$t/backup with space" --work "$t/work" \
      --user alice --fingerprint 2>&1) || { echo "$out"; fail "--fingerprint restores from a backup directory with a space"; }
grep -qF "var-lib-omandroid-fp.tar: checksum matches" <<<"$out" || { echo "$out"; fail "checks the fingerprint archive's checksum"; }
grep -qF "/var/lib/omandroid-fp/mfg_data.img -> /var/lib/omamobile-fp/mfg_data.img" <<<"$out" || { echo "$out"; fail "maps the fingerprint state"; }
[[ ! -e $t/ssh.calls ]] || fail "a dry run never contacts the phone"
pass "--fingerprint works from a backup directory with a space in its path"

# Raven's run does none of cheetah's backup or fingerprint steps: each of
# their options is refused before anything runs, not ignored. The fake
# ssh records any call, so a call made before the refusal is caught even
# if the tool ignores its failure
: > "$t/factory.zip"
for o in --fingerprint "--fingerprint --restore-td" --import-home --restore-config --restore-wifi --with-waves --force "--restore $t" "--backup $t"; do
  # shellcheck disable=SC2086 # the --restore and --backup cases are two words on purpose
  if out=$(PHONE_SSH=$t/no-ssh tools/phone-provision -d raven --dry-run --work "$t/work" $o "$t/factory.zip" 2>&1); then
    fail "-d raven refuses $o"
  fi
  named=${o%% *}; [[ $named == --backup ]] && named=--restore
  grep -qF -- "-d raven doesn't support $named" <<<"$out" || { echo "$out"; fail "says it refuses $o"; }
  [[ ! -e $t/ssh.calls ]] || { cat "$t/ssh.calls"; fail "-d raven refuses $o without contacting the phone"; }
done
pass "-d raven refuses cheetah's backup and fingerprint options"

out=$(PHONE_SSH=$t/no-ssh tools/phone-provision --dry-run --skip-extract --restore "$B" --work "$t/work" --user alice 2>&1)
grep -q 'speaker.conf\|nmconnection\|home.json\|omamobile-fp' <<<"$out" && fail "config, Wi-Fi, home and fingerprint stay opt-in"
cp "$B/phone-config.tar.sha256" "$t/sum"
echo "0000  phone-config.tar" > "$B/phone-config.tar.sha256"
PHONE_SSH=$t/no-ssh tools/phone-provision --dry-run --skip-extract --restore "$B" --work "$t/work" --user alice >/dev/null 2>&1 &&
  fail "refuses a backup that doesn't match its checksum"
cp "$t/sum" "$B/phone-config.tar.sha256"
tools/phone-provision --dry-run --restore "$B" --work "$t/work" >/dev/null 2>&1 && fail "needs a factory image or --skip-extract"
pass "opt-in steps stay off by default; a bad backup checksum or a missing factory image is refused"

# --backup DIR is --restore DIR's older spelling: the same run
old=$(PHONE_SSH=$t/no-ssh tools/phone-provision --dry-run --skip-extract --backup "$B" --work "$t/work" --user alice --restore-config 2>&1) ||
  { echo "$old"; fail "--backup DIR still runs a restore"; }
new=$(PHONE_SSH=$t/no-ssh tools/phone-provision --dry-run --skip-extract --restore "$B" --work "$t/work" --user alice --restore-config 2>&1)
[[ $(sed -E 's|/run\.[A-Za-z0-9]{6}|/run.X|g' <<<"$old") == "$(sed -E 's|/run\.[A-Za-z0-9]{6}|/run.X|g' <<<"$new")" ]] || { diff <(echo "$old") <(echo "$new") || true; fail "--backup DIR and --restore DIR do the same"; }
grep -c 'etc/omandroid/speaker.conf -> /etc/omamobile/speaker.conf' <<<"$old" >/dev/null || fail "--backup DIR restores from DIR"
pass "--backup DIR is still accepted, as --restore DIR"

# The run is never guessed (INSTALL-EXPERIENCE-PLAN G1). M is a home like the
# maintainer's, with a phone-config.tar where the tool used to look by
# default; H (below) is an empty one, like everyone else's. In both, a run
# that names neither --first-install nor --restore is refused before the
# phone is contacted or anything is staged, and says what to give
M=$t/maintainer-home H=$t/home
mkdir -p "$M/android/reference" "$H"
cp -r "$B" "$M/android/reference/phone-backup-20261013"
for home in "$M" "$H"; do
  for args in "--user alice $t/factory.zip" "--skip-extract" "--skip-extract --fingerprint" "--dry-run --user alice $t/factory.zip"; do
    # shellcheck disable=SC2086 # args is several words on purpose
    if out=$(HOME=$home PHONE_SSH=$t/no-ssh tools/phone-provision --work "$t/work" $args 2>&1); then
      echo "$out"; fail "a run with neither --first-install nor --restore is refused ($args, HOME ${home##*/})"
    fi
    grep -cF -- "say which run this is" <<<"$out" >/dev/null || { echo "$out"; fail "says to name the run ($args)"; }
    grep -cF -- "--first-install --nv-backup DIR" <<<"$out" >/dev/null || { echo "$out"; fail "names --first-install --nv-backup DIR ($args)"; }
    grep -cF -- "--restore DIR" <<<"$out" >/dev/null || { echo "$out"; fail "names --restore DIR ($args)"; }
    if grep -cF 'phone-backup-20261013' <<<"$out" >/dev/null; then echo "$out"; fail "no default backup directory is looked at or named ($args)"; fi
    [[ ! -e $t/ssh.calls ]] || fail "the refusal never contacts the phone ($args)"
    [[ ! -e $t/work || -z $(ls -A "$t/work") ]] || fail "the refusal stages nothing ($args)"
  done
done
if grep -n 'android/reference/phone-backup' tools/phone-provision; then fail "tools/phone-provision carries no default backup directory"; fi
pass "with neither --first-install nor --restore the run is refused, with or without the old default backup in the home"

# A first install on cheetah: no phone-config.tar, so the owner's read-only
# NV backup instead. A stand-in SHA256SUMS with made-up sums, devinfo
# included as in a real one. HOME is an empty directory
N=$t/nv-backup
mkdir -p "$N" "$t/nv-short"
for p in persist modem_a modem_b efs efs_backup modem_userdata devinfo; do
  printf '%s  %s.img\n' "$(printf 'made up %s' "$p" | sha256sum | cut -d' ' -f1)" "$p"
done > "$N/SHA256SUMS"
grep -v ' devinfo\.img$' "$N/SHA256SUMS" > "$t/nv-six"
fresh() { HOME=${FRESH_HOME:-$H} PHONE_SSH=$t/no-ssh tools/phone-provision --work "$t/work" --first-install "$@" 2>&1; }
out=$(fresh --dry-run --user alice --nv-backup "$N" "$t/factory.zip") || { echo "$out"; fail "a first install's dry run succeeds"; }
# the same run on a machine whose home holds the old default backup: still
# a first install, nothing from that backup (it used to become a restore)
out_m=$(FRESH_HOME=$M fresh --dry-run --user alice --nv-backup "$N" "$t/factory.zip") || { echo "$out_m"; fail "a first install's dry run succeeds beside an old backup"; }
same() { sed -E 's|/run\.[A-Za-z0-9]{6}|/run.X|g' <<<"$1"; }   # the staging directory's name differs per run
[[ $(same "$out_m") == "$(same "$out")" ]] || { diff <(same "$out") <(same "$out_m") || true; fail "--first-install does the same whatever backup this computer holds"; }
if grep -cF 'from the backup' <<<"$out_m" >/dev/null; then echo "$out_m"; fail "--first-install takes nothing from a backup in the home"; fi
[[ ! -e $t/ssh.calls ]] || fail "a first install's dry run never contacts the phone"
for line in \
  "Checking the NV backup in $N" \
  "SHA256SUMS: one line for each of modem_a modem_b efs efs_backup modem_userdata persist" \
  "would run: tools/extract-vendor-firmware -o" \
  "no phone-config.tar to fall back on" \
  "/etc/omamobile/modem-nv.sha256: the six NV lines of $N/SHA256SUMS" \
  "would push 1 files to / (merge)" \
  "would write /var/lib/omamobile-vendor/modem/props.conf (root's, mode 600) on the phone, from androidboot.cdt_hwid in its /proc/bootconfig"; do
  grep -qF -- "$line" <<<"$out" || { echo "$out"; fail "first install, dry run: $line"; }
done
if grep -qF 'from the backup' <<<"$out"; then echo "$out"; fail "a first install takes nothing from a backup"; fi
while read -r sum _; do
  if grep -qF "$sum" <<<"$out"; then fail "the NV checksums aren't printed"; fi
done < "$N/SHA256SUMS"
[[ -z $(ls -A "$t/work") ]] || fail "the staging is removed"
pass "first install, dry run: the six NV lines and props.conf from the phone's bootconfig, phone untouched, nothing from a backup"

# Refusals, all before the phone is contacted (these runs aren't dry runs)
if out=$(fresh --user alice "$t/factory.zip"); then fail "a first install without --nv-backup is refused"; fi
grep -qF -- "--first-install needs --nv-backup DIR: take the read-only backup of the modem's partitions with tools/nv-backup DIR (docs/INSTALL.md step 6)" <<<"$out" ||
  { echo "$out"; fail "says to give --nv-backup"; }
# --nv-backup alone is the published 2026.11.08 command: a first install,
# the same as with --first-install, also beside an old backup in the home
out_old=$(HOME=$M PHONE_SSH=$t/no-ssh tools/phone-provision --work "$t/work" --dry-run --user alice --nv-backup "$N" "$t/factory.zip" 2>&1) ||
  { echo "$out_old"; fail "--nv-backup alone runs as a first install"; }
out_new=$(FRESH_HOME=$M fresh --dry-run --user alice --nv-backup "$N" "$t/factory.zip") || { echo "$out_new"; fail "the explicit first install runs"; }
[[ $(same "$out_old") == "$(same "$out_new")" ]] || { diff <(same "$out_new") <(same "$out_old") || true; fail "--nv-backup alone does what --first-install --nv-backup does"; }
for o in "--restore $B" "--backup $B"; do
  # shellcheck disable=SC2086 # two words on purpose
  if out=$(fresh --user alice --nv-backup "$N" $o "$t/factory.zip"); then fail "--first-install with $o is refused"; fi
  grep -qF -- "--first-install and --restore DIR are two different runs" <<<"$out" || { echo "$out"; fail "says they are two runs ($o)"; }
done
if out=$(PHONE_SSH=$t/no-ssh tools/phone-provision --skip-extract --restore "$H" --work "$t/work" --user alice 2>&1); then
  fail "--restore DIR without a phone-config.tar is refused"
fi
grep -qF -- "no $H/phone-config.tar (--restore DIR" <<<"$out" || { echo "$out"; fail "says DIR has no phone-config.tar"; }
if out=$(PHONE_SSH=$t/no-ssh tools/phone-provision --skip-extract --restore "$B" --restore "$H" --work "$t/work" --user alice 2>&1); then
  fail "two backup directories are refused"
fi
for p in modem_a modem_b efs efs_backup modem_userdata persist; do
  grep -v "  $p\\.img\$" "$N/SHA256SUMS" > "$t/nv-short/SHA256SUMS"
  if out=$(fresh --user alice --nv-backup "$t/nv-short" "$t/factory.zip"); then fail "refuses an NV backup without $p.img"; fi
  grep -qE "none or more than one for $p\\.img\$" <<<"$out" || { echo "$out"; fail "names the missing $p.img"; }
done
cat "$N/SHA256SUMS" <(grep ' modem_a\.img$' "$N/SHA256SUMS") > "$t/nv-short/SHA256SUMS"
if out=$(fresh --user alice --nv-backup "$t/nv-short" "$t/factory.zip"); then fail "refuses an NV backup with modem_a.img twice"; fi
grep -qE 'none or more than one for modem_a\.img$' <<<"$out" || { echo "$out"; fail "names the repeated modem_a.img"; }
for o in --fingerprint --import-home --restore-config --restore-wifi --force; do
  if out=$(fresh --user alice --nv-backup "$N" $o "$t/factory.zip"); then fail "a first install refuses $o"; fi
  grep -qF -- "--first-install doesn't support $o (a restore from a phone-config.tar: --restore DIR)" <<<"$out" || { echo "$out"; fail "says it refuses $o"; }
done
if out=$(PHONE_SSH=$t/no-ssh tools/phone-provision --skip-extract --restore "$B" --work "$t/work" --user alice --nv-backup "$N" 2>&1); then
  fail "--nv-backup with --restore is refused"
fi
grep -qF -- "--nv-backup goes with --first-install" <<<"$out" || { echo "$out"; fail "says --nv-backup goes with --first-install"; }
[[ ! -e $t/ssh.calls ]] || fail "a refused first install never contacts the phone"
pass "first install: refused without --nv-backup, together with --restore, with one of the six NV lines missing or repeated, with an option that needs phone-config.tar; --restore refused without a phone-config.tar or with --nv-backup"

# The SHA256SUMS file and its line format (sha256sum's own: lower-case hex,
# two spaces), PHONE_BOOTCONFIG (it goes into the command run on the phone)
mkdir -p "$t/nv-none"
if out=$(fresh --user alice --nv-backup "$t/nv-none" "$t/factory.zip"); then fail "refuses an NV backup with no SHA256SUMS"; fi
grep -qF "no $t/nv-none/SHA256SUMS (--nv-backup DIR" <<<"$out" || { echo "$out"; fail "says there is no SHA256SUMS"; }
for how in upper one-space binary; do
  case $how in
    upper) sed -E '/ modem_a\.img$/ s/^[0-9a-f]+/\U&/' "$N/SHA256SUMS" ;;
    one-space) sed -E '/ modem_a\.img$/ s/  / /' "$N/SHA256SUMS" ;;
    binary) sed -E '/ modem_a\.img$/ s/  / */' "$N/SHA256SUMS" ;;
  esac > "$t/nv-short/SHA256SUMS"
  cmp -s "$N/SHA256SUMS" "$t/nv-short/SHA256SUMS" && fail "the $how line differs from sha256sum's"
  if out=$(fresh --user alice --nv-backup "$t/nv-short" "$t/factory.zip"); then fail "refuses a modem_a line that isn't sha256sum's format ($how)"; fi
  grep -qE "none or more than one for modem_a\\.img\$" <<<"$out" || { echo "$out"; fail "names modem_a.img ($how)"; }
done
for b in relative/bootconfig "/proc/boot config" "/x;reboot" "/x'y"; do
  if out=$(PHONE_BOOTCONFIG=$b fresh --user alice --nv-backup "$N" "$t/factory.zip"); then fail "refuses PHONE_BOOTCONFIG=$b"; fi
  grep -qF "PHONE_BOOTCONFIG must be an absolute path" <<<"$out" || { echo "$out"; fail "says why ($b)"; }
done
[[ ! -e $t/ssh.calls ]] || fail "these refusals never contact the phone"
rel=$(realpath --relative-to="$t" "$SRC")
help=$(cd "$t" && "$rel/tools/phone-provision" --help) || fail "--help works by a relative path from another directory"
grep -qF "PHONE_BOOTCONFIG, the file on the phone" <<<"$help" || { echo "$help"; fail "--help prints the whole header"; }
if grep -qF 'set -euo pipefail' <<<"$help"; then fail "--help stops at the end of the header"; fi
pass "first install: refused with no SHA256SUMS, a line not in sha256sum's format, or an unsafe PHONE_BOOTCONFIG; --help prints the whole header"

# The board id check and the staged NV lines, without Docker (CI has none).
# A stand-in phone answers the connection, user and kernel checks, and runs
# the board id check here: that part only reads the stand-in bootconfig and
# exits before any write. Everything else it only logs, as a push, and
# doesn't run
hwid=0x7e57b0a2d1d000000000000000c0ffee
cat > "$t/check-ssh" <<'EOF'
#!/bin/bash
case $* in
  true | "getent passwd 'alice' >/dev/null") exit 0 ;;
  "uname -r") echo 7.3.0-test; exit 0 ;;
  "BOOTCONFIG='"*"' ACTION=check sh -s") exec sh -c "$1" ;;
esac
printf '%s\n' "$*" >> "$T/pushes"
cat > /dev/null
EOF
chmod +x "$t/check-ssh"
check_run() {
  HOME=$H PHONE_SSH=$t/check-ssh PHONE_BOOTCONFIG=$t/bootconfig tools/phone-provision --skip-extract --user alice \
    --first-install --nv-backup "$N" --work "$t/work" "$@" < /dev/null 2>&1
}
for how in missing absent empty blank no-0x not-hex; do
  rm -f "$t/pushes" "$t/bootconfig"
  why="no androidboot.cdt_hwid in the phone's $t/bootconfig, or an empty one"
  case $how in
    missing) ;;
    absent) printf 'androidboot.mode = "normal"\nandroidboot.cdt_hwidx = "%s"\n' "$hwid" > "$t/bootconfig" ;;
    empty) printf 'androidboot.mode = "normal"\nandroidboot.cdt_hwid = ""\n' > "$t/bootconfig" ;;
    blank) printf 'androidboot.cdt_hwid = "   "\n' > "$t/bootconfig" ;;
    no-0x) printf 'androidboot.cdt_hwid = "%s"\n' "${hwid#0x}" > "$t/bootconfig" ;;
    not-hex) printf 'androidboot.cdt_hwid = "%sz"\n' "$hwid" > "$t/bootconfig" ;;
  esac
  case $how in blank | no-0x | not-hex) why="androidboot.cdt_hwid in the phone's $t/bootconfig isn't 0x and hex digits (not shown)" ;; esac
  if out=$(check_run); then echo "$out"; fail "refuses a phone whose androidboot.cdt_hwid is $how"; fi
  grep -qF "$why" <<<"$out" || { echo "$out"; fail "says why ($how)"; }
  [[ ! -e $t/pushes ]] || { cat "$t/pushes"; fail "nothing is pushed when androidboot.cdt_hwid is $how"; }
  if grep -qF "${hwid#0x}" <<<"$out"; then fail "the value isn't printed ($how)"; fi
done
pass "first install, no Docker: a missing, empty or malformed androidboot.cdt_hwid is refused before any push, the value never printed"

printf 'androidboot.mode = "normal"\nandroidboot.cdt_hwid = "%s"\nandroidboot.slot_suffix = "_b"\n' "$hwid" > "$t/bootconfig"
rm -f "$t/pushes"
out=$(check_run --keep) || { echo "$out"; fail "a first install against the logging stand-in succeeds"; }
grep -qF "board id: androidboot.cdt_hwid is in the phone's $t/bootconfig (not shown)" <<<"$out" || { echo "$out"; fail "says the board id is there"; }
grep -qF 'camera data: none from this run (--skip-extract, and no phone-config.tar to take it from); camera files already on the phone stay' <<<"$out" ||
  { echo "$out"; fail "says this run pushes no camera data"; }
# what went to the phone, in order: the staged tree, its check, then the
# board id written there from its own bootconfig. Never the value
expect="set -e; mkdir -p '/'; tar -C '/' -xf - --no-same-owner --no-overwrite-dir
cd '/' && sha256sum -c --quiet
BOOTCONFIG='$t/bootconfig' ACTION=write sh -s"
[[ $(cat "$t/pushes") == "$expect" ]] || { cat "$t/pushes"; fail "pushes the six lines, checks them, then writes props.conf on the phone"; }
if grep -qF "${hwid#0x}" "$t/pushes"; then fail "the board id is in no command sent to the phone"; fi
if grep -qF "${hwid#0x}" <<<"$out"; then fail "the board id isn't printed"; fi
staged=("$t"/work/run.*/modem-stage/etc/omamobile/modem-nv.sha256)
cmp -s "${staged[0]}" "$t/nv-six" || { cat "${staged[0]}"; fail "modem-nv.sha256 is exactly the six NV lines, devinfo's left out"; }
[[ $(stat -c %a "${staged[0]}") == 644 ]] || fail "modem-nv.sha256 is staged mode 644"
[[ $(find "$t"/work/run.* -type f | wc -l) == 1 ]] || { find "$t/work"; fail "modem-nv.sha256 is the only file staged"; }
rm -rf "${t:?}/work/"run.*
pass "first install, no Docker: the six NV lines staged (mode 644), then props.conf written on the phone, the value in no command"

# Raven's NV backup check and staging: same per-image sha256sum strictness as
# cheetah's first install, exercised through a dry run under umask 077 so the
# mode-644 assertion fails if chmod is dropped (extraction is skipped and the
# phone is never contacted; --keep keeps the staged files to inspect)
printf '[%s]: [%s]\n' ro.boot.cdt_hwid 0xTEST ro.hardware raven ro.boot.hardware.platform gs101 > "$t/raven-getprop.txt"
raven() {
  (umask 077 && HOME=$H PHONE_SSH=$t/no-ssh tools/phone-provision -d raven --dry-run \
    --getprop "$t/raven-getprop.txt" --work "$t/work" "$@" "$t/factory.zip") 2>&1
}
raven_staged_ok() {
  local staged=("$t"/work/run.*/modem-stage/etc/omamobile/modem-nv.sha256)
  cmp -s "${staged[0]}" "$t/nv-six" || { cat "${staged[0]}"; fail "raven stages exactly the six NV lines ($1)"; }
  [[ $(stat -c %a "${staged[0]}") == 644 ]] || fail "raven stages modem-nv.sha256 mode 644 ($1)"
  rm -rf "${t:?}/work/"run.*
}
no_nv_sums() {
  local sum
  while read -r sum _; do
    if grep -qF "$sum" <<<"$out"; then fail "$1"; fi
  done < "$N/SHA256SUMS"
}
out=$(raven --keep --nv-backup "$N") || { echo "$out"; fail "raven dry run succeeds with a valid NV backup"; }
[[ ! -e $t/ssh.calls ]] || fail "raven dry run never contacts the phone"
for line in \
  "SHA256SUMS: one line for each of modem_a modem_b efs efs_backup modem_userdata persist" \
  "modem: board id from raven-getprop.txt, NV checksums from nv-backup" \
  "would write /var/lib/omamobile-vendor/modem/props.conf and /etc/omamobile/modem-nv.sha256" \
  "Done (raven)"; do
  grep -qF -- "$line" <<<"$out" || { echo "$out"; fail "raven dry run: $line"; }
done
no_nv_sums "raven dry run doesn't print NV checksums"
raven_staged_ok "valid backup, devinfo left out"
# Extra non-matching lines (commented, suffix-extended, or holding a NUL byte)
# aren't staged and never break staging
modem_a_line=$(grep ' modem_a\.img$' "$N/SHA256SUMS")
{ cat "$N/SHA256SUMS"; printf '# %s\n%s.bak\n' "$modem_a_line" "$modem_a_line"; } > "$t/nv-short/SHA256SUMS"
out=$(raven --keep --nv-backup "$t/nv-short") || { echo "$out"; fail "raven accepts extra commented and suffixed lines beside the six valid NV lines"; }
raven_staged_ok "extra commented and suffixed lines"
{ cat "$N/SHA256SUMS"; printf 'extra\0line\n'; } > "$t/nv-short/SHA256SUMS"
out=$(raven --keep --nv-backup "$t/nv-short") || { echo "$out"; fail "raven accepts an extra NUL-byte line beside the six valid NV lines"; }
raven_staged_ok "extra NUL-byte line"
pass "raven dry run: valid SHA256SUMS passes the per-image check and stages exactly the six NV lines (mode 644), incl. beside a NUL line"

# Refusals on raven: missing image, repeated image (including six of efs.img
# and missing-plus-repeated totalling six lines), and malformed checksum lines,
# all before anything is staged in modem-stage or the phone is contacted
raven_refused() {
  local want=$1 why=$2 staged
  if out=$(raven --keep --nv-backup "$t/nv-short"); then echo "$out"; fail "raven refuses $why"; fi
  grep -qE "needs one '<sha256>  NAME\\.img' line for each of the six NV images; none or more than one for ${want//./\\.}\$" <<<"$out" || { echo "$out"; fail "raven names $want ($why)"; }
  staged=("$t"/work/run.*/modem-stage)
  [[ ! -e ${staged[0]} ]] || fail "raven stages nothing ($why)"
  [[ ! -e $t/ssh.calls ]] || fail "raven never contacts the phone ($why)"
  rm -rf "${t:?}/work/"run.*
}
: > "$t/nv-short/SHA256SUMS"
raven_refused "modem_a.img modem_b.img efs.img efs_backup.img modem_userdata.img persist.img" "empty SHA256SUMS"
for p in modem_a modem_b efs efs_backup modem_userdata persist; do
  grep -v "  $p\\.img\$" "$N/SHA256SUMS" > "$t/nv-short/SHA256SUMS"
  raven_refused "$p.img" "missing $p.img"
done
{ cat "$N/SHA256SUMS"; printf '%s\n' "$modem_a_line"; } > "$t/nv-short/SHA256SUMS"
raven_refused "modem_a.img" "modem_a.img repeated"
{ grep -v '  efs\.img$' "$N/SHA256SUMS"; printf '%s\n' "$modem_a_line"; } > "$t/nv-short/SHA256SUMS"
raven_refused "modem_a.img efs.img" "efs.img missing with modem_a.img repeated (six lines)"
efs_line=$(grep '  efs\.img$' "$N/SHA256SUMS")
printf '%s\n' "$efs_line" "$efs_line" "$efs_line" "$efs_line" "$efs_line" "$efs_line" > "$t/nv-short/SHA256SUMS"
raven_refused "modem_a.img modem_b.img efs.img efs_backup.img modem_userdata.img persist.img" "six efs.img lines"
for how in upper one-space binary short prefix trailing-space crlf; do
  case $how in
    upper) sed -E '/ modem_a\.img$/ s/^[0-9a-f]+/\U&/' "$N/SHA256SUMS" ;;
    one-space) sed -E '/ modem_a\.img$/ s/  / /' "$N/SHA256SUMS" ;;
    binary) sed -E '/ modem_a\.img$/ s/  / */' "$N/SHA256SUMS" ;;
    short) sed -E '/ modem_a\.img$/ s/^[0-9a-f]//' "$N/SHA256SUMS" ;;
    prefix) sed -E '/ modem_a\.img$/ s/^/junk /' "$N/SHA256SUMS" ;;
    trailing-space) sed -E '/ modem_a\.img$/ s/$/ /' "$N/SHA256SUMS" ;;
    crlf) sed -E '/ modem_a\.img$/ s/$/\r/' "$N/SHA256SUMS" ;;
  esac > "$t/nv-short/SHA256SUMS"
  raven_refused "modem_a.img" "malformed modem_a.img ($how)"
done
cp "$N/SHA256SUMS" "$t/nv-short/SHA256SUMS"
chmod 000 "$t/nv-short/SHA256SUMS"
if [[ ! -r $t/nv-short/SHA256SUMS ]]; then
  if out=$(raven --keep --nv-backup "$t/nv-short"); then echo "$out"; fail "raven refuses unreadable SHA256SUMS"; fi
  grep -qF "cannot read $t/nv-short/SHA256SUMS" <<<"$out" || { echo "$out"; fail "raven reports one clear read error"; }
  [[ $(grep -c "^grep:" <<<"$out" || true) == 1 ]] || { echo "$out"; fail "unreadable SHA256SUMS reports one read error, not six"; }
  rm -rf "${t:?}/work/"run.*
fi
chmod 644 "$t/nv-short/SHA256SUMS"
[[ ! -e $t/ssh.calls ]] || fail "refused raven runs never contact the phone"
pass "raven dry run: refused before staging for empty, missing, repeated (incl. six efs.img), malformed or unreadable NV checksum lines"
# Non-ASCII letters (64 é) must be refused even under a UTF-8 locale where
# GNU grep's [0-9a-f] matches them (en_US.UTF-8 on GNU/Linux; C.UTF-8 does not)
e64=$(printf '%.0s\xc3\xa9' {1..64})
utf8_locale=""
if LC_ALL=en_US.UTF-8 grep -aE -q -e '^[0-9a-f]{64}$' <<<"$e64" 2>/dev/null; then
  utf8_locale=en_US.UTF-8
elif command -v locale >/dev/null; then
  while IFS= read -r loc; do
    LC_ALL=$loc grep -aE -q -e '^[0-9a-f]{64}$' <<<"$e64" 2>/dev/null && { utf8_locale=$loc; break; }
  done < <(locale -a 2>/dev/null | grep -iE 'utf-?8$' || true)
fi
if [[ -n $utf8_locale ]]; then
  { grep -v '  modem_a\.img$' "$N/SHA256SUMS"; printf '%s  modem_a.img\n' "$e64"; } > "$t/nv-short/SHA256SUMS"
  LC_ALL=$utf8_locale raven_refused "modem_a.img" "non-ASCII 64-letter hash under $utf8_locale"
  pass "raven dry run: non-ASCII 64-letter hash refused under locale $utf8_locale"
else
  echo "ok - # skip: no installed UTF-8 locale where grep [0-9a-f] matches non-ASCII letters"
fi

# Non-dry Raven run with stand-in extractors and the logging stand-in phone:
# (1) a bad SHA256SUMS refuses before any extraction runs; (2) SHA256SUMS is
# read once, so changing the file during extraction cannot alter what is staged
mkdir -p "$t/raven-repo/tools"
cp tools/phone-provision "$t/raven-repo/tools/phone-provision"
cat > "$t/raven-repo/tools/extract-vendor-firmware" <<'EOF'
#!/bin/bash
set -euo pipefail
echo "fw" >> "$T/extract.calls"
out=""
while (($#)); do [[ $1 == -o ]] && out=$2; shift; done
mkdir -p "$out/usr/lib/firmware/updates" "$out/usr/share/omamobile/sensors/registry"
: > "$out/usr/lib/firmware/updates/fw.bin"
: > "$out/usr/share/omamobile/sensors/registry/reg.json"
[[ -z ${MUTATE_SUMS:-} ]] || sed -i -E 's/^0/1/; t; s/^./0/' "$MUTATE_SUMS"
EOF
cat > "$t/raven-repo/tools/extract-vendor-chroot" <<'EOF'
#!/bin/bash
set -euo pipefail
echo "chroot" >> "$T/extract.calls"
out=""
while (($#)); do [[ $1 == -o ]] && out=$2; shift; done
mkdir -p "$out"
: > "$out/MANIFEST"
EOF
chmod +x "$t/raven-repo/tools/extract-vendor-firmware" "$t/raven-repo/tools/extract-vendor-chroot"
raven_real() {
  (umask 077 && HOME=$H PHONE_SSH=$t/check-ssh "$t/raven-repo/tools/phone-provision" -d raven --user alice \
    --getprop "$t/raven-getprop.txt" --work "$t/work" "$@" "$t/factory.zip" < /dev/null) 2>&1
}
rm -f "$t/extract.calls" "$t/pushes"
grep -v '  efs\.img$' "$N/SHA256SUMS" > "$t/nv-short/SHA256SUMS"
if out=$(raven_real --nv-backup "$t/nv-short"); then echo "$out"; fail "real raven run refuses bad SHA256SUMS"; fi
grep -qE 'none or more than one for efs\.img$' <<<"$out" || { echo "$out"; fail "real raven run names missing efs.img"; }
[[ ! -e $t/extract.calls ]] || { cat "$t/extract.calls"; fail "real raven run refuses bad SHA256SUMS before extraction"; }
[[ ! -e $t/pushes ]] || { cat "$t/pushes"; fail "real raven run pushes nothing on bad SHA256SUMS"; }
cp "$N/SHA256SUMS" "$t/nv-short/SHA256SUMS"
out=$(MUTATE_SUMS="$t/nv-short/SHA256SUMS" raven_real --keep --nv-backup "$t/nv-short") || { echo "$out"; fail "real raven run succeeds when SHA256SUMS changes after check"; }
[[ -s $t/extract.calls ]] || fail "real raven run invokes stand-in extractors"
raven_staged_ok "single read despite later file change"
rm -f "$t/extract.calls" "$t/pushes"
pass "raven real run (no Docker): refuses bad SHA256SUMS before extraction and reads SHA256SUMS once"

# Under bash -x, neither Raven nor cheetah first-install traces any NV checksum,
# and xtrace stays active after the NV helpers return
for dev in raven cheetah; do
  extra=(--user alice --first-install)
  [[ $dev != raven ]] || extra=(-d raven --getprop "$t/raven-getprop.txt")
  out=$(HOME=$H PHONE_SSH=$t/no-ssh bash -x tools/phone-provision "${extra[@]}" \
    --dry-run --nv-backup "$N" --work "$t/work" "$t/factory.zip" 2>&1) ||
    { echo "$out"; fail "$dev dry run under bash -x succeeds"; }
  grep -qE "^\+ say '?Done" <<<"$out" || { echo "$out"; fail "bash -x trace stayed active after NV helpers ($dev)"; }
  no_nv_sums "NV checksums never appear in a bash -x trace ($dev)"
done
[[ ! -e $t/ssh.calls ]] || fail "bash -x dry runs never contact the phone"
pass "bash -x dry runs (raven and cheetah first-install): succeed with no NV checksum in the trace"

# --- a real run against a container standing in for the phone -----------------
if ! command -v docker >/dev/null || ! docker image inspect archlinux:latest >/dev/null 2>&1; then
  echo "ok - # skip: no docker or archlinux:latest image for the end-to-end run"
  exit 0
fi
container=omamobile-provision-test-$$
docker run -d --name "$container" --network none archlinux:latest sleep 600 >/dev/null
docker exec "$container" bash -c 'useradd -m -u 1000 alice && mkdir -p /var/lib/omamobile/firstboot /usr/lib/omamobile-vendor/modem &&
  echo alice > /var/lib/omamobile/firstboot/user && echo package-file > /usr/lib/omamobile-vendor/modem/profile.conf'
# docker keeps the caller's HOME (the first-install runs below change it)
cat > "$t/phone-ssh" <<EOF
#!/bin/bash
HOME=$(printf %q "$HOME") exec docker exec -i $container bash -c "\$*"
EOF
chmod +x "$t/phone-ssh"
prov() { PHONE_SSH=$t/phone-ssh tools/phone-provision --skip-extract --restore "$B" --work "$t/work" "$@" > "$t/out" 2>&1; }
prov --import-home --restore-config --fingerprint || { cat "$t/out"; fail "a run against the stand-in phone succeeds"; }
on() { docker exec "$container" bash -c "$*"; }
[[ $(on 'cat /var/lib/omamobile-vendor/modem/props.conf') == 'ro.boot.cdt_hwid=0xTEST' ]] || fail "props.conf restored"
[[ $(on 'stat -c %u:%g /var/lib/omamobile-vendor/modem/props.conf /etc/omamobile/modem-nv.sha256 /usr/lib/firmware/omamobile/camera/imx386-uw.bin' | sort -u) == 0:0 ]] ||
  fail "system files belong to root (tar --no-same-owner)"
[[ $(on 'stat -c %u:%g /usr /usr/lib /etc') == $'0:0\n0:0\n0:0' ]] || fail "existing directories keep their owner"
[[ $(on 'cat /usr/lib/omamobile-vendor/modem/profile.conf') == package-file ]] || fail "package files beside the restored ones stay"
on 'test ! -e /etc/omandroid && test ! -e /var/lib/omandroid-vendor && test ! -e /var/lib/omandroid-fp' || fail "nothing lands under the old names"
[[ $(on 'stat -c %U /home/alice/.config/omamobile/home.json /home/alice/.config/omamobile/widgets/my.test-widget/Widget.qml' | sort -u) == alice ]] ||
  fail "the imported home files belong to the user"
on 'grep -q omamobile.home /home/alice/.config/omamobile/home.json && grep -q qs.Omamobile /home/alice/.config/omamobile/widgets/my.test-widget/Widget.qml' ||
  fail "ids in the imported files are renamed"
[[ $(on 'stat -c %u:%g /var/lib/omamobile-fp/persist-ss/0') == 1000:1000 ]] || fail "the fingerprint secure storage keeps its Android owner"
on 'test ! -e /var/lib/omamobile-fp/data/vendor/omamobile-fp/secret && test ! -e /var/lib/omamobile-fp/data/vendor/ss/0' ||
  fail "without --restore-td, neither TD nor the Gatekeeper secret is restored"
[[ $(on 'stat -c %a /var/lib/omamobile-fp') == 700 ]] || fail "the fingerprint state is private"
pass "a real run: new names, root-owned system files, user-owned home files, Android owners for the fingerprint state"

prov --import-home --restore-config --fingerprint || { cat "$t/out"; fail "a second run succeeds"; }
pass "running again is idempotent"
on 'echo enrolled-since > /var/lib/omamobile-fp/persist-ss/0'
prov --fingerprint && fail "differing fingerprint state is never replaced without --force"
grep -q -- '--force' "$t/out" || fail "says how to replace it"
[[ $(on 'cat /var/lib/omamobile-fp/persist-ss/0') == enrolled-since ]] || fail "the phone's newer state is untouched"
pass "differing fingerprint state is kept unless --force"
on 'echo secure storage > /var/lib/omamobile-fp/persist-ss/0'
prov --fingerprint --restore-td || { cat "$t/out"; fail "--restore-td runs"; }
[[ $(on 'stat -c %u:%g /var/lib/omamobile-fp/data/vendor/omamobile-fp/secret') == 0:0 ]] || fail "the fingerprint secret stays root's"
[[ $(on 'cat /var/lib/omamobile-fp/data/vendor/ss/0') == tamper-detect ]] || fail "--restore-td restores TD"
on 'echo newer > /var/lib/omamobile-fp/data/vendor/ss/0'
prov --fingerprint --restore-td && fail "a TD already on the phone is never replaced without --force"
[[ $(on 'cat /var/lib/omamobile-fp/data/vendor/ss/0') == newer ]] || fail "the phone's TD is untouched"
pass "--restore-td restores TD and the secret, and never over a TD already there without --force"

# A first install against the stand-in phone: the board id from a stand-in
# bootconfig (PHONE_BOOTCONFIG), the NV checksums from the stand-in backup.
# The made-up board id (hwid, above) must never show in the output or the
# laptop's staging
on 'rm -rf /var/lib/omamobile-vendor /etc/omamobile/modem-nv.sha256'
bootconfig() { docker exec -i "$container" sh -c 'cat > /run/test-bootconfig'; }
fresh_on() { HOME=$H PHONE_SSH=$t/phone-ssh PHONE_BOOTCONFIG=/run/test-bootconfig tools/phone-provision --skip-extract --first-install --nv-backup "$N" --work "$t/work" "$@" > "$t/out" 2>&1; }
for how in missing absent empty not-hex; do
  why="no androidboot.cdt_hwid in the phone's /run/test-bootconfig, or an empty one"
  case $how in
    missing) on 'rm -f /run/test-bootconfig' ;;
    absent) printf 'androidboot.mode = "normal"\nandroidboot.cdt_hwidx = "%s"\n' "$hwid" | bootconfig ;;
    empty) printf 'androidboot.mode = "normal"\nandroidboot.cdt_hwid = ""\n' | bootconfig ;;
    not-hex) printf 'androidboot.cdt_hwid = "%s "\n' "$hwid" | bootconfig
      why="androidboot.cdt_hwid in the phone's /run/test-bootconfig isn't 0x and hex digits (not shown)" ;;
  esac
  if fresh_on; then cat "$t/out"; fail "refuses a phone whose androidboot.cdt_hwid is $how"; fi
  grep -qF "$why" "$t/out" || { cat "$t/out"; fail "says why ($how)"; }
  on 'test ! -e /var/lib/omamobile-vendor && test ! -e /etc/omamobile/modem-nv.sha256' || fail "nothing is written when androidboot.cdt_hwid is $how"
  if grep -qF "${hwid#0x}" "$t/out"; then fail "a near-miss key's value isn't printed ($how)"; fi
done
pass "first install: a missing, empty or malformed androidboot.cdt_hwid is refused before anything is written"

printf 'androidboot.mode = "normal"\nandroidboot.cdt_hwid = "%s"\nandroidboot.slot_suffix = "_b"\n' "$hwid" | bootconfig
# under bash -x, so the trace is checked for the value too; --keep leaves
# the staging to look at
HOME=$H PHONE_SSH=$t/phone-ssh PHONE_BOOTCONFIG=/run/test-bootconfig bash -x tools/phone-provision --skip-extract --first-install --nv-backup "$N" \
  --work "$t/work" --keep > "$t/out" 2>&1 || { cat "$t/out"; fail "a first install against the stand-in phone succeeds"; }
# props_ok LABEL [LINES]: props.conf is root's, mode 600, and holds LINES
# (other lines kept from before), then both keys set to the board id
props_ok() {
  [[ $(on 'stat -c %a:%u:%g /var/lib/omamobile-vendor/modem/props.conf') == 600:0:0 ]] || fail "props.conf is root's, mode 600 ($1)"
  [[ $(on 'cat /var/lib/omamobile-vendor/modem/props.conf') == "${2:-}ro.boot.cdt_hwid=$hwid"$'\n'"persist.vendor.modem.cdt_hwid=$hwid" ]] ||
    { on 'cat /var/lib/omamobile-vendor/modem/props.conf' | sed "s/${hwid#0x}/<the value>/"; fail "props.conf holds both keys, set to bootconfig's androidboot.cdt_hwid ($1)"; }
  [[ $(on 'ls -A /var/lib/omamobile-vendor/modem') == props.conf ]] || fail "no temporary file is left beside props.conf ($1)"
}
props_ok "first run"
[[ $(on 'LC_ALL=C sort /etc/omamobile/modem-nv.sha256') == "$(LC_ALL=C sort "$t/nv-six")" ]] || fail "modem-nv.sha256 holds exactly the six NV lines"
[[ $(on 'stat -c %a:%u:%g /etc/omamobile/modem-nv.sha256') == 644:0:0 ]] || fail "modem-nv.sha256 is root's, mode 644"
grep -qF "wrote /var/lib/omamobile-vendor/modem/props.conf on the phone from its /run/test-bootconfig (root's, mode 600; the board id isn't shown)" "$t/out" ||
  { cat "$t/out"; fail "says it wrote props.conf"; }
grep -qF 'camera data: none from this run (--skip-extract, and no phone-config.tar to take it from); camera files already on the phone stay' "$t/out" ||
  { cat "$t/out"; fail "says this run pushes no camera data"; }
if grep -qF "${hwid#0x}" "$t/out"; then fail "the board id never shows in the output, not even under bash -x"; fi
[[ -n $(ls -A "$t/work") ]] || fail "--keep kept the staging"
if grep -rqF "${hwid#0x}" "$t/work"; then fail "the board id never reaches the laptop's staging"; fi
rm -rf "${t:?}/work/"run.*
pass "first install: props.conf (root's, mode 600) with both keys from bootconfig, the six NV lines, and the board id never on the laptop"

# a second run (as after a fresh backup, REINSTALL-RUNBOOK N3) over stale
# keys and a per-phone tweak, mode 644: the keys are replaced, the tweak
# and the line with no newline at the end stay
on 'printf "ro.boot.cdt_hwid=0x0ld\nper.phone.tweak=kept\npersist.vendor.modem.cdt_hwid=0x0ld\nno.newline=kept" > /var/lib/omamobile-vendor/modem/props.conf &&
  chmod 644 /var/lib/omamobile-vendor/modem/props.conf'
fresh_on || { cat "$t/out"; fail "a second first-install run succeeds"; }
props_ok "second run" $'per.phone.tweak=kept\nno.newline=kept\n'
if grep -qF "${hwid#0x}" "$t/out"; then fail "the board id never shows in the output (second run)"; fi
pass "running a first install again replaces the stale keys, keeps props.conf's other lines, root's and mode 600 again"
