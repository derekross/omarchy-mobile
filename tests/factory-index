#!/bin/bash
# SPDX-License-Identifier: MIT
# tools/factory-index, the build index of Google's factory images
# (docs/INSTALL-EXPERIENCE-PLAN.md §6.1), against a made-up factory zip built here (no
# file of Google's, no network): add reads the zip's name, size, SHA-256
# and android-info.txt; a zip for another board, with another name or with
# files that disagree is refused; tested and untested change the mark; the
# reader refuses an index that breaks any rule (an address or page that
# isn't Google's, a name without the digest, a tested build without its
# release, another format or device, a build listed twice); match picks the
# build with the phone's bootloader and baseband and no other (never a build
# with the same bootloader alone), and names the builds that share both; the
# list is kept newest first by the date in the build id, whatever order the
# builds are added in, and a list that isn't is refused; match says whether
# an Android update would land on a tested build (the newest one); match and
# entry name the build's address on Google's server, which is Google's or
# the index is refused; and sign makes a detached signature gpg verifies,
# reads the index once, keeps the source intact in place and through symlinks
# or hard links, refuses when .sig is the source, and writes nothing when the
# index is invalid, the release key can't be loaded or gpg fails.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
command -v python3 >/dev/null || { echo "ok - # skip: no python3"; exit 0; }
t=$(mktemp -d)
cleanup() {
  [[ ! -d $t/repo/keys/gnupg.release ]] || gpgconf --homedir "$t/repo/keys/gnupg.release" --kill gpg-agent 2>/dev/null || true
  rm -rf "$t"
}
trap cleanup EXIT
r=$t/repo
mkdir -p "$r/tools/lib" "$r/device/testdev" "$r/packages/omamobile-keyring"
cp tools/factory-index "$r/tools/"
cp tools/lib/signing.sh "$r/tools/lib/"
printf 'CODENAME=testdev\n' > "$r/device/testdev/device.conf"
fx() { python3 -I -B "$r/tools/factory-index" "$@"; }
idx=$r/device/testdev/factory-builds.json

# factory BUILD BOARD BOOTLOADER BASEBAND [RADIO-FILE-VERSION [INNER-BUILD]]:
# a zip laid out as Google's, named with the first eight digits of its SHA-256
factory() {
  python3 -I -B - "$t" "$@" <<'PY'
import hashlib, io, os, sys, zipfile
t, build, board, bl, bb = sys.argv[1:6]
radio = sys.argv[6] if len(sys.argv) > 6 else bb
inner_build = sys.argv[7] if len(sys.argv) > 7 else build
top = "testdev-%s" % build
inner = io.BytesIO()
with zipfile.ZipFile(inner, "w") as z:
    z.writestr("android-info.txt", "require board=%s\n\nrequire version-bootloader=%s\nrequire version-baseband=%s\n" % (board, bl, bb))
    z.writestr("boot.img", b"not an image")
tmp = os.path.join(t, "tmp.zip")
with zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED) as z:
    z.writestr(top + "/flash-all.sh", "#!/bin/sh\n")
    z.writestr(top + "/bootloader-testdev-%s.img" % bl, b"bl")
    z.writestr(top + "/radio-testdev-%s.img" % radio, b"radio")
    z.writestr(top + "/image-testdev-%s.zip" % inner_build, inner.getvalue())
digest = hashlib.sha256(open(tmp, "rb").read()).hexdigest()
out = os.path.join(t, "testdev-%s-factory-%s.zip" % (build, digest[:8]))
os.replace(tmp, out)
print(out)
PY
}

z1=$(factory ab1c.230101.001 testdev testloader-1.0-111 testband-9.9-222)
out=$(fx add -d testdev "$z1") || fail "add takes a factory zip"
sum=$(sha256sum < "$z1" | cut -d' ' -f1)
grep -cF "$sum" <<<"$out" >/dev/null || fail "add prints the SHA-256 to compare with Google's page"
python3 -I -B - "$idx" "$z1" "$sum" <<'PY' || fail "the entry holds the build, both versions, the name, size, SHA-256, Google's address and page"
import json, os, sys
m = json.load(open(sys.argv[1])); b = m["builds"][0]; name = os.path.basename(sys.argv[2])
assert m["format"] == 1 and m["codename"] == "testdev" and len(m["builds"]) == 1
assert b == {"build": "AB1C.230101.001", "bootloader": "testloader-1.0-111", "baseband": "testband-9.9-222",
             "zip": name, "url": "https://dl.google.com/dl/android/aosp/" + name,
             "page": "https://developers.google.com/android/images#testdev",
             "sha256": sys.argv[3], "size": os.path.getsize(sys.argv[2]), "tested": False}, b
PY
[[ ! -e $r/device/testdev/$(basename "$z1") ]] && [[ $(find "$r" -name '*.zip' | wc -l) == 0 ]] || fail "nothing of the zip is kept"
pass "add: the build's metadata from a factory zip, and nothing of the zip"

if fx add -d testdev "$z1" 2>/dev/null; then fail "a build is added once"; fi
z2=$(factory ab1c.230201.002 testdev testloader-1.0-111 otherband-1.0-333)
fx add -d testdev --tested 2026.11.01 "$z2" >/dev/null || fail "add --tested"
[[ $(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["builds"][0]["build"])' "$idx") == AB1C.230201.002 ]] || fail "the newest build is first"
bad=$(factory ab1c.230301.003 otherboard testloader-1.0-111 testband-9.9-222)
if fx add -d testdev "$bad" 2>"$t/err"; then fail "a zip for another board is refused"; fi
grep -c 'is for board otherboard' "$t/err" >/dev/null || fail "says which board the zip is for"
bad=$(factory ab1c.230301.003 testdev testloader-1.0-111 testband-9.9-222 anotherband-2)
if fx add -d testdev "$bad" 2>"$t/err"; then fail "a zip whose radio image disagrees with android-info.txt is refused"; fi
# The same bytes under another build's name: the eight digits are right, so
# only the look inside the zip can tell
other=$t/testdev-ab1c.230101.009-factory-${sum:0:8}.zip
cp "$z1" "$other"
if fx add -d testdev "$other" 2>"$t/err"; then fail "a zip that holds another build than its name says is refused"; fi
grep -c 'holds testdev-ab1c.230101.001, not the build its name says' "$t/err" >/dev/null || { cat "$t/err" >&2; fail "says which build the zip holds"; }
! grep -c '230101.009' "$idx" >/dev/null || fail "the build a zip's name claims is not added"
# Matching outer name and top folder, but the inner image zip names another
# build (different patch, carrier suffix, and precedence behind digest/duplicate)
cp "$idx" "$t/idx-before.json"
bad1=$(factory ab1c.230101.004 testdev testloader-1.0-111 testband-9.9-222 testband-9.9-222 ab1c.230101.009)
bad2=$(factory ab1c.230101.004 testdev testloader-1.0-111 testband-9.9-222 testband-9.9-222 ab1c.230101.004.a1)
cp "$bad1" "$t/testdev-ab1c.230101.004-factory-00000000.zip"
dup=$(factory ab1c.230101.001 testdev testloader-1.0-111 testband-9.9-222 testband-9.9-222 ab1c.230101.009)
refused_inner() { # KIND ZIP WANT
  local rc=0
  fx add -d testdev "$2" >/dev/null 2>"$t/err" || rc=$?
  [[ $rc -eq 1 ]] || fail "$1 is refused with exit 1 (got $rc)"
  grep -cF "$3" "$t/err" >/dev/null || { cat "$t/err" >&2; fail "$1 prints expected message"; }
  cmp -s "$idx" "$t/idx-before.json" || fail "$1 leaves the index byte-identical"
}
refused_inner "patch mismatch" "$bad1" "holds testdev-ab1c.230101.004/image-testdev-ab1c.230101.009.zip, not the build its name says"
refused_inner "carrier-suffix mismatch" "$bad2" "holds testdev-ab1c.230101.004/image-testdev-ab1c.230101.004.a1.zip, not the build its name says"
refused_inner "wrong digest + inner mismatch" "$t/testdev-ab1c.230101.004-factory-00000000.zip" "first eight digits"
refused_inner "duplicate build + inner mismatch" "$dup" "AB1C.230101.001 is already in"
cp "$z1" "$t/testdev-ab1c.230101.001-factory-00000000.zip"
if fx add -d testdev "$t/testdev-ab1c.230101.001-factory-00000000.zip" 2>"$t/err"; then fail "a zip whose name carries other digits than its SHA-256 is refused"; fi
grep -c "first eight digits" "$t/err" >/dev/null || fail "says the name's digits aren't the file's"
cp "$z1" "$t/renamed.zip"
if fx add -d testdev "$t/renamed.zip" 2>/dev/null; then fail "a zip not named as Google names it is refused"; fi
if fx add -d testdev --tested latest "$z1" 2>/dev/null; then fail "--tested takes a release version"; fi
[[ $(fx check -d testdev | grep -c 'bootloader') == 2 ]] || fail "refused zips add nothing"
pass "add refuses a second copy, another board, files that disagree, another build inside, another name"

m() { fx match --index "$idx" --codename testdev --bootloader "$1" --baseband "$2"; }
out=$(m testloader-1.0-111 testband-9.9-222)
grep -cx 'match=exact' <<<"$out" >/dev/null && grep -cx 'build=AB1C.230101.001' <<<"$out" >/dev/null && grep -cx "sha256=$sum" <<<"$out" >/dev/null &&
  grep -cx 'tested=false' <<<"$out" >/dev/null || fail "the exact build is named, with its mark"
grep -cx 'newer_tested=AB1C.230201.002' <<<"$out" >/dev/null || fail "for a build that isn't tested, the newest tested build above it is named"
grep -cx 'newer_tested=' <<<"$(m testloader-1.0-111 otherband-1.0-333)" >/dev/null || fail "a tested build needs no newer one"
# A tested build with the same bootloader and another baseband is no match:
# its mark was earned with its own baseband
[[ $(m testloader-1.0-111 unknownband) == match=none* ]] || fail "the same bootloader with another baseband matches nothing, tested or not"
! grep -c '^build=' <<<"$(m testloader-1.0-111 unknownband)" >/dev/null || fail "no build is offered without an exact match"
fx untested -d testdev AB1C.230201.002 >/dev/null
grep -cx 'tested=false' <<<"$(m testloader-1.0-111 otherband-1.0-333)" >/dev/null || fail "untested takes the mark back"
grep -cx 'newer_tested=' <<<"$(m testloader-1.0-111 testband-9.9-222)" >/dev/null || fail "no newer build is named when none above is tested"
fx tested -d testdev AB1C.230101.001 2026.11.08 >/dev/null
grep -cx 'newer_tested=' <<<"$(m testloader-1.0-111 otherband-1.0-333)" >/dev/null || fail "a tested build below is older: it is never named as the one to update to"
fx untested -d testdev AB1C.230101.001 >/dev/null
fx tested -d testdev AB1C.230201.002 2026.11.08 >/dev/null
grep -c 'tested with 2026.11.08' <<<"$(fx check -d testdev)" >/dev/null || fail "tested marks a build with its release"
[[ $(m otherloader-2 testband-9.9-222) == match=none* ]] || fail "another bootloader matches nothing"
grep -cx "url=https://dl.google.com/dl/android/aosp/$(basename "$z1")" <<<"$(m testloader-1.0-111 testband-9.9-222)" >/dev/null || fail "match names the build's address on Google's server"
! grep -c '^url=' <<<"$(m testloader-1.0-111 unknownband)" >/dev/null || fail "no address is named without an exact match"
# entry: one build by its id, for an installer that recorded it
out=$(fx entry --index "$idx" --codename testdev --build AB1C.230101.001) || fail "entry prints a build by its id"
grep -cx 'build=AB1C.230101.001' <<<"$out" >/dev/null && grep -cx "sha256=$sum" <<<"$out" >/dev/null && grep -cx "zip=$(basename "$z1")" <<<"$out" >/dev/null &&
  grep -cx "url=https://dl.google.com/dl/android/aosp/$(basename "$z1")" <<<"$out" >/dev/null || fail "entry names the file, its SHA-256 and its address"
if fx entry --index "$idx" --codename testdev --build AB1C.990101.001 >/dev/null 2>&1; then fail "entry fails for a build the list doesn't have"; fi
grep -cx 'builds=2' <<<"$(fx info --index "$idx" --codename testdev)" >/dev/null || fail "info counts the builds"
grep -cx 'same_pair=' <<<"$(m testloader-1.0-111 testband-9.9-222)" >/dev/null || fail "a build alone with its versions shares them with none"
! grep -c 'share a bootloader' <<<"$(fx check -d testdev)" >/dev/null || fail "check notes nothing while every pair is one build's"
cp "$idx" "$t/good.json"   # the two-build index the reader's refusals below start from
# A carrier variant: another build with the same bootloader and baseband
z3=$(factory ab1c.230101.001.a1 testdev testloader-1.0-111 testband-9.9-222)
fx add -d testdev "$z3" >/dev/null || fail "add takes a build that shares another's versions"
out=$(m testloader-1.0-111 testband-9.9-222)
grep -cx 'build=AB1C.230101.001.A1' <<<"$out" >/dev/null && grep -cx 'same_pair=AB1C.230101.001' <<<"$out" >/dev/null ||
  fail "of builds that share both versions the first listed is printed when none is tested, and the others are named"
fx tested -d testdev AB1C.230101.001 2026.11.08 >/dev/null
out=$(m testloader-1.0-111 testband-9.9-222)
grep -cx 'build=AB1C.230101.001' <<<"$out" >/dev/null && grep -cx 'tested=true' <<<"$out" >/dev/null && grep -cx 'same_pair=AB1C.230101.001.A1' <<<"$out" >/dev/null &&
  grep -cx 'newer_tested=' <<<"$out" >/dev/null || fail "of builds that share both versions the tested one is printed, wherever it is listed"
fx untested -d testdev AB1C.230101.001 >/dev/null
grep -c 'note: AB1C.230101.001.A1, AB1C.230101.001 share a bootloader and baseband' <<<"$(fx check -d testdev)" >/dev/null ||
  fail "check names the builds a phone can't tell apart"
pass "match: the build with the phone's bootloader and baseband, never one with the bootloader alone; shared pairs named, a tested one first; the newer tested build for one that isn't"

# Newest first is a property the tool keeps, not a habit of whoever adds:
# "newer" is read from it. The newest build added first, then an older one,
# then one in between: each lands where its date belongs
ord=$t/order.json
ox() { fx "$1" --index "$ord" --codename testdev "${@:2}"; }
order() { python3 -I -c 'import json,sys; print(" ".join(b["build"] for b in json.load(open(sys.argv[1]))["builds"]))' "$ord"; }
om() { ox match --bootloader "$1" --baseband "$2"; }
n1=$(factory ab1c.230201.002 testdev testloader-1.0-111 otherband-1.0-333)
o1=$(factory ab1c.221201.003 testdev testloader-0.9-000 oldband-0.1-111)
ox add "$n1" >/dev/null || fail "add takes the newest build first"
ox add --tested 2026.11.01 "$o1" >/dev/null || fail "add takes an older build after a newer one"
[[ $(order) == "AB1C.230201.002 AB1C.221201.003" ]] || fail "an older build added later is listed below the newer one: $(order)"
ox add "$z1" >/dev/null
[[ $(order) == "AB1C.230201.002 AB1C.230101.001 AB1C.221201.003" ]] || fail "a build is put where its date belongs, between a newer and an older one: $(order)"
ox add "$z3" >/dev/null
[[ $(order) == "AB1C.230201.002 AB1C.230101.001.A1 AB1C.230101.001 AB1C.221201.003" ]] || fail "builds of one date stay together, the one added last first: $(order)"
ox check >/dev/null || fail "check accepts the list add keeps"
# The review's case: an older tested build and a newer untested one. The
# older one is never "newer", wherever it was added
out=$(om testloader-1.0-111 testband-9.9-222)
grep -cx 'newer_tested=' <<<"$out" >/dev/null || fail "a tested build that is older is never named as newer"
grep -cx 'newest=AB1C.230201.002' <<<"$out" >/dev/null && grep -cx 'newest_tested=false' <<<"$out" >/dev/null ||
  fail "the newest build is named, and an update is said not to land on a tested build while it isn't tested"
out=$(om nobody-1 nothing-2)
grep -cx 'match=none' <<<"$out" >/dev/null && grep -cx 'newest=AB1C.230201.002' <<<"$out" >/dev/null && grep -cx 'newest_tested=false' <<<"$out" >/dev/null ||
  fail "without a match the newest build and its mark are still printed"
grep -c 'newest: AB1C.230201.002. An Android update lands on a build that isn.t tested' <<<"$(ox check)" >/dev/null || fail "check says where an Android update lands"
ox tested AB1C.230201.002 2026.11.08 >/dev/null
out=$(om testloader-1.0-111 testband-9.9-222)
grep -cx 'newer_tested=AB1C.230201.002' <<<"$out" >/dev/null && grep -cx 'newest_tested=true' <<<"$out" >/dev/null || fail "with the newest build tested, an update lands on a tested build"
# Another build of the newest date (a carrier variant) with versions no
# tested build carries: which of the two a phone gets isn't known, so an
# update is no longer said to land on a tested build
n2=$(factory ab1c.230201.002.b1 testdev testloader-1.0-111 carrierband-7)
ox add "$n2" >/dev/null
grep -cx 'newest_tested=false' <<<"$(om testloader-1.0-111 testband-9.9-222)" >/dev/null || fail "an untested variant of the newest date with other versions: an update may land on it"
grep -cx 'newest=AB1C.230201.002' <<<"$(om testloader-1.0-111 testband-9.9-222)" >/dev/null || fail "of the newest date's builds the tested one is named"
ox untested AB1C.230201.002 >/dev/null; ox tested AB1C.230201.002.B1 2026.11.08 >/dev/null
grep -cx 'newest_tested=false' <<<"$(om nobody-1 nothing-2)" >/dev/null || fail "one tested variant of the newest date doesn't cover the other"
# A list in another order is refused by every reader, check and match included
python3 -I -c 'import json,sys; m=json.load(open(sys.argv[1])); m["builds"].reverse(); json.dump(m,open(sys.argv[2],"w"))' "$ord" "$t/reversed.json"
for sub in check info "match --bootloader testloader-1.0-111 --baseband testband-9.9-222"; do
  # shellcheck disable=SC2086 # the subcommand and its options are words
  if fx $sub --index "$t/reversed.json" --codename testdev >/dev/null 2>"$t/err"; then fail "$sub refuses a list that isn't newest first"; fi
  grep -c 'is listed below .*, which is older; the list is newest first' "$t/err" >/dev/null || { cat "$t/err" >&2; fail "$sub says which build is out of place"; }
done
pass "newest first by the build's date: add keeps it, every reader refuses another order, and 'newer' and 'newest' are read from the dates"

refuse() {  # WHY PYTHON-EDIT
  python3 -I -c "import json, sys; m = json.load(open(sys.argv[1])); b = m['builds'][0]; $2; json.dump(m, open(sys.argv[2], 'w'))" "$t/good.json" "$t/bad.json"
  if fx info --index "$t/bad.json" --codename testdev >/dev/null 2>&1; then fail "the reader refuses $1"; fi
}
refuse "a download address that isn't Google's" 'b["url"] = "https://example.org/" + b["zip"]'
refuse "an address for another file" 'b["url"] = "https://dl.google.com/dl/android/aosp/other.zip"'
refuse "a page that isn't Google's" 'b["page"] = "https://developers.google.com.example.org/android/images"'
refuse "a name without the SHA-256's digits" 'b["sha256"] = "0" * 64'
refuse "a tested build without its release" 'del b["tested_with"]'
refuse "an untested build with a release" 'm["builds"][1]["tested_with"] = "2026.11.01"'
refuse "a string for true" 'b["tested"] = "true"'
refuse "a size that isn't one" 'b["size"] = -1'
refuse "a zip named for another device" 'b["zip"] = b["zip"].replace("testdev", "other")'
refuse "another format" 'm["format"] = 2'
refuse "another device's index" 'm["codename"] = "other"'
refuse "a date that isn't one" 'm["updated"] = "yesterday"'
refuse "a newer build listed below an older one" 'm["builds"].reverse()'
refuse "a build listed twice" 'm["builds"].append(dict(m["builds"][0]))'
refuse "a build that isn't an object" 'm["builds"].append("x")'
echo '{' > "$t/bad.json"
if fx info --index "$t/bad.json" --codename testdev 2>/dev/null; then fail "the reader refuses a file that isn't JSON"; fi
fx info --index "$t/good.json" --codename testdev >/dev/null || fail "the unchanged index still reads"
pass "the reader refuses an index that breaks any rule"

# sign: a detached signature by the release key's layout (tools/lib/signing.sh)
if command -v gpg >/dev/null; then
  G=$r/keys/gnupg.release; mkdir -p -m700 "$G"
  gpg --homedir "$G" -q --batch --passphrase '' --quick-gen-key 'Test Release <test@example.org>' ed25519 sign never 2>/dev/null
  fpr=$(gpg --homedir "$G" --with-colons --list-keys 2>/dev/null | awk -F: '$1 == "fpr" { print $10; exit }')
  echo "$fpr" > "$r/keys/fingerprint.release"
  echo "$fpr:4:" > "$r/packages/omamobile-keyring/omamobile-trusted"
  : > "$r/packages/omamobile-keyring/omamobile-revoked"
  fx sign -d testdev --out "$t/signed" >/dev/null || fail "sign writes a signed copy"
  cmp -s "$t/signed/factory-builds.json" "$idx" || fail "the signed copy is the index"
  gpg --homedir "$G" --batch --verify "$t/signed/factory-builds.json.sig" "$t/signed/factory-builds.json" 2>/dev/null || fail "the signature verifies"
  # A sign the key loader refuses writes nothing: the copy and signature
  # already there stay a pair, and no folder is made. The index changes
  # first, so a copy written anyway would differ
  sums() { sha256sum "$t/signed/factory-builds.json" "$t/signed/factory-builds.json.sig"; }
  fx tested -d testdev AB1C.230101.001 2026.11.08 >/dev/null
  kept=$(sums)
  echo "${fpr,,}" > "$r/packages/omamobile-keyring/omamobile-revoked"
  if fx sign -d testdev --out "$t/signed" 2>"$t/err"; then fail "sign refuses a malformed omamobile-revoked"; fi
  grep -c 'omamobile-revoked is malformed at line 1' "$t/err" >/dev/null || { cat "$t/err" >&2; fail "sign says omamobile-revoked is malformed"; }
  [[ $(sums) == "$kept" ]] || fail "a sign refused for a malformed omamobile-revoked leaves the signed copy and its signature as they were"
  if fx sign -d testdev --out "$t/signed-malformed" 2>/dev/null; then fail "sign into a new folder refuses a malformed omamobile-revoked"; fi
  [[ ! -e $t/signed-malformed ]] || fail "a sign refused for a malformed omamobile-revoked makes no folder"
  : > "$r/packages/omamobile-keyring/omamobile-revoked"
  fx sign -d testdev --out "$t/signed" >/dev/null || fail "sign works again once omamobile-revoked is well formed"
  cmp -s "$t/signed/factory-builds.json" "$idx" &&
    gpg --homedir "$G" --batch --verify "$t/signed/factory-builds.json.sig" "$t/signed/factory-builds.json" 2>/dev/null ||
    fail "after a refused sign, a good one writes the new copy and a signature that verifies"
  fx untested -d testdev AB1C.230101.001 >/dev/null
  # Signing into the index's own folder, or where dest is a symlink or hard
  # link to the source (or --index is a symlink into --out), must leave the
  # source untouched; a .sig aliasing the source is refused before signing;
  # a gpg failure after the key loads must leave the source and any existing
  # copy/signature pair untouched.
  check_same() { # SOURCE INDEX OUT LABEL
    local dest=$3/factory-builds.json st
    touch -t 202001010000 "$1"
    st=$(stat -c '%d:%i:%Y' "$1")
    fx sign --index "$2" --codename testdev --out "$3" >/dev/null || fail "sign $4"
    cmp -s "$1" "$idx" || fail "$4 keeps the source bytes"
    [[ $(stat -L -c '%d:%i:%Y' "$dest") == "$st" ]] || fail "$4 leaves the source untouched"
    gpg --homedir "$G" --batch --verify "$dest.sig" "$idx" 2>/dev/null || fail "signature verifies $4"
  }
  mkdir -p "$t/same" "$t/sym" "$t/hlink" "$t/idxsym" "$t/sigsym" "$t/sighlink" "$t/fakebin"
  cp "$idx" "$t/same/factory-builds.json"
  check_same "$t/same/factory-builds.json" "$t/same/factory-builds.json" "$t/same" "into the index's own folder"
  cp "$idx" "$t/sym-src.json"
  ln -s "$t/sym-src.json" "$t/sym/factory-builds.json"
  check_same "$t/sym-src.json" "$t/sym-src.json" "$t/sym" "when dest is a symlink to the source"
  cp "$idx" "$t/hlink-src.json"
  ln "$t/hlink-src.json" "$t/hlink/factory-builds.json"
  check_same "$t/hlink-src.json" "$t/hlink-src.json" "$t/hlink" "when dest is a hard link of the source"
  cp "$idx" "$t/idxsym/factory-builds.json"
  ln -s "$t/idxsym/factory-builds.json" "$t/idxsym-link.json"
  check_same "$t/idxsym/factory-builds.json" "$t/idxsym-link.json" "$t/idxsym" "when --index is a symlink into --out"
