  # bytes even when the file is rewritten in place right after the first read
  raw_idx=$t/compact.json
  orig_idx=$t/compact.orig
  python3 -I -B - "$idx" "$raw_idx" "$orig_idx" "$r/tools/factory-index" sign --index "$raw_idx" --codename testdev --out "$t/signed-one-read" <<'PY' >/dev/null || fail "sign reads the index once"
