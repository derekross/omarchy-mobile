assert len(opens) == 1, f"expected 1 open of index, got {len(opens)}: {opens!r}"
PY
  cmp -s "$t/signed-one-read/factory-builds.json" "$orig_idx" || fail "one-read signed copy matches the original index bytes"
  gpg --homedir "$G" --batch --verify "$t/signed-one-read/factory-builds.json.sig" "$orig_idx" 2>/dev/null || fail "one-read signature verifies against the original index bytes"
