#!/bin/bash
# SPDX-License-Identifier: MIT
# tools/kernel-pr-check's commit checks against a stand-in kernel tree (a
# git repository with a fake scripts/checkpatch.pl): sign-offs, prefixes and
# checkpatch errors. Its device-tree comparison runs against a second
# stand-in whose make prints the messages each board file asks for; the
# real builds (clang, dtc, dt-validate) need a real tree and are run by hand.
set -euo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
t=$(mktemp -d)
trap 'rm -rf "$t"' EXIT
fail() { echo "not ok - $*" >&2; exit 1; }

k=$t/linux
mkdir -p "$k/scripts" "$k/drivers"
# checkpatch's stand-in: an ERROR for any added line with "BADSTYLE".
cat > "$k/scripts/checkpatch.pl" <<'EOF'
#!/usr/bin/perl
while (<STDIN>) { print "-:1: ERROR:CODE_STYLE: bad style\n" if /^\+.*BADSTYLE/; }
EOF
chmod +x "$k/scripts/checkpatch.pl"
cd "$k"
git init -q -b omamobile
git config user.name "A Human"
git config user.email human@example.org
echo base > drivers/a.c
git add -A && git commit -q -m "base"

run() { # name expect pattern
  local out status=0
  out=$("$here/tools/kernel-pr-check" -C "$k" omamobile HEAD 2>&1) || status=$?
  [[ $status == "$2" ]] || { echo "$out"; fail "$1: exit $status, expected $2"; }
  [[ -z ${3:-} ]] || grep -c -- "$3" <<<"$out" >/dev/null || { echo "$out"; fail "$1: says '$3'"; }
}
branch() { git checkout -q omamobile && git checkout -q -b "$1"; }

branch good
echo good >> drivers/a.c
git commit -q -am "drivers: a: a good change" -m "Signed-off-by: A Human <human@example.org>" -m "Assisted-by: Claude:claude-opus-5-5"
run "a good commit" 0
echo "ok - a signed-off, prefixed, clean commit passes (Assisted-by is fine)"

branch nosob
echo x >> drivers/a.c
git commit -q -am "drivers: a: unsigned"
run "no sign-off" 1 "no human Signed-off-by"
echo "ok - a commit without a sign-off fails"

branch other
echo x >> drivers/a.c
git commit -q -am "drivers: a: someone else signs" -m "Signed-off-by: Someone Else <else@example.org>"
run "not the author's sign-off" 1 "no Signed-off-by from the author"
echo "ok - a sign-off that isn't the author's fails"

branch aisob
echo x >> drivers/a.c
git commit -q -am "drivers: a: AI signs" -m "Signed-off-by: A Human <human@example.org>" -m "Signed-off-by: Claude <noreply@anthropic.com>"
run "an AI sign-off" 1 "from an AI agent"
echo "ok - an AI Signed-off-by fails"

branch noprefix
echo x >> drivers/a.c
git commit -q -am "Fix the thing" -m "Signed-off-by: A Human <human@example.org>"
run "no prefix" 1 "without a subsystem prefix"
echo "ok - a subject without a subsystem prefix fails"

branch style
echo "BADSTYLE" >> drivers/a.c
git commit -q -am "drivers: a: style" -m "Signed-off-by: A Human <human@example.org>"
run "a checkpatch error" 1 "checkpatch --strict errors"
echo "ok - a checkpatch error fails"

# CI runs `kernel-pr-check -C linux` from the directory that contains the
# kernel checkout. The path has to still work after the tool cds in.
rel_status=0
rel_out=$(cd "$t" && "$here/tools/kernel-pr-check" -C linux omamobile good 2>&1) || rel_status=$?
[[ $rel_status == 0 ]] || { echo "$rel_out"; fail "relative -C: exit $rel_status"; }
grep -q 'policy (tools/pr-check)' <<<"$rel_out" || { echo "$rel_out"; fail "relative -C did not run the policy check"; }
echo "ok - a relative -C still reaches the kernel tree"

miss_status=0
miss_out=$("$here/tools/kernel-pr-check" -C "$t/no-such-tree" omamobile HEAD 2>&1) || miss_status=$?
[[ $miss_status == 2 ]] || { echo "$miss_out"; fail "missing tree: exit $miss_status, expected 2"; }
grep -q 'no such tree' <<<"$miss_out" || { echo "$miss_out"; fail "missing tree: silent"; }
echo "ok - a missing -C is reported"

in_status=0
in_out=$("$here/tools/kernel-pr-check" -C "$k" --build "$k/out" omamobile HEAD 2>&1) || in_status=$?
[[ $in_status == 2 ]] || { echo "$in_out"; fail "--build inside the tree: exit $in_status, expected 2"; }
grep -q 'inside the kernel tree' <<<"$in_out" || { echo "$in_out"; fail "--build inside the tree: silent"; }
rel_build_status=0
rel_build_out=$(cd "$k" && "$here/tools/kernel-pr-check" -C . --build out omamobile HEAD 2>&1) || rel_build_status=$?
[[ $rel_build_status == 2 ]] || { echo "$rel_build_out"; fail "a relative --build inside the tree: exit $rel_build_status, expected 2"; }
echo "ok - --build is refused inside the kernel tree, relative or not"

# --merge: the base moves on after the branch is cut. A clean merge passes
# and says so; a conflict fails as "rebase needed" while the commit checks
# still run.
git checkout -q omamobile && git checkout -q -b newbase
echo other > drivers/b.c
git add -A && git commit -q -m "drivers: b: added on the base"
objs=$(git count-objects -v | grep -E '^(count|in-pack):')
m_status=0
m_out=$("$here/tools/kernel-pr-check" -C "$k" --merge newbase good 2>&1) || m_status=$?
[[ $m_status == 0 ]] || { echo "$m_out"; fail "--merge, clean: exit $m_status"; }
grep -q 'merges cleanly onto' <<<"$m_out" || { echo "$m_out"; fail "--merge, clean: silent"; }
[[ $(git count-objects -v | grep -E '^(count|in-pack):') == "$objs" ]] || fail "--merge wrote objects into the kernel tree"
echo "ok - --merge passes a branch that merges cleanly onto a newer base, and writes nothing to the tree"

echo conflicting > drivers/a.c
git commit -q -am "drivers: a: changed on the base"
c_status=0
c_out=$("$here/tools/kernel-pr-check" -C "$k" --merge newbase good 2>&1) || c_status=$?
[[ $c_status == 1 ]] || { echo "$c_out"; fail "--merge, conflict: exit $c_status, expected 1"; }
grep -q 'rebase needed' <<<"$c_out" && grep -q 'drivers/a.c' <<<"$c_out" || { echo "$c_out"; fail "--merge, conflict: doesn't name the rebase or the file"; }
grep -q 'signed off by their authors' <<<"$c_out" || { echo "$c_out"; fail "--merge, conflict: skipped the commit checks"; }
echo "ok - --merge fails a conflicting branch as 'rebase needed', and still checks its commits"

# ---------------------------------------------------------------- --build
# The device-tree comparison, with a stand-in make: each board's .dts lists
# the messages its build prints ("msg <text>", @B@ for the board's name),
# "broken" fails its build, and a board with no .dts stops make there, as
# the kernel's does when asked for a DTB it has no source for.
d=$t/dtk
mkdir -p "$d/scripts/kconfig" "$d/arch/arm64/boot/dts/exynos/google" "$t/bin"
cp "$k/scripts/checkpatch.pl" "$d/scripts/"
printf '#!/bin/sh\nexit 0\n' > "$d/scripts/kconfig/merge_config.sh"
cat > "$d/scripts/fake-dtbs" <<'EOF'
#!/bin/sh
for t; do
  f=arch/arm64/boot/dts/${t%.dtb}.dts b=$(basename "$t" .dtb)
  [ -e "$f" ] || { echo "make[5]: *** No rule to make target '$f'.  Stop." >&2; exit 2; }
  grep -q '^broken' "$f" && { echo "make[5]: *** [$t] Error 1" >&2; exit 2; }
  sed -n 's/^msg //p' "$f" | sed "s|@B@|$b|g; s|^|arch/arm64/boot/dts/$t: |"
done
EOF
chmod +x "$d/scripts/kconfig/merge_config.sh" "$d/scripts/fake-dtbs"
cat > "$d/Makefile" <<'EOF'
DTBS := $(filter %.dtb,$(MAKECMDGOALS))
.PHONY: defconfig olddefconfig $(DTBS)
defconfig olddefconfig:
	@mkdir -p $(O) && touch $(O)/.config
$(firstword $(DTBS)):
	@sh scripts/fake-dtbs $(DTBS)
$(wordlist 2,999,$(DTBS)):
	@:
EOF
# Builds are skipped without clang, ld.lld and dt-validate; the stand-in
# make calls none of them.
for b in clang ld.lld dt-validate; do printf '#!/bin/sh\nexit 0\n' > "$t/bin/$b"; chmod +x "$t/bin/$b"; done
g=$d/arch/arm64/boot/dts/exynos/google
soc="msg / (google,@B@): soc_id: b'\\t\\x85P\\x01' is not of type 'object'"
cd "$d"
git init -q -b omamobile
git config user.name "A Human"
git config user.email human@example.org
printf '%s\n' "$soc" > "$g/gs201-cheetah.dts"
printf '%s\n' "msg phy@11110000 (google,zuma-eusb2-phy): 'vdd-supply' is a required property" > "$g/zuma-husky.dts"
git add -A && git commit -q -m "base"
brun() { # name expect pattern [not-pattern]   ($merge: --merge or empty)
  local out status=0
  out=$(PATH=$t/bin:$PATH "$here/tools/kernel-pr-check" -C "$d" --build "$t/out" ${merge-} omamobile HEAD 2>&1) || status=$?
  [[ $status == "$2" ]] || { echo "$out"; fail "$1: exit $status, expected $2"; }
  grep -c -- "$3" <<<"$out" >/dev/null || { echo "$out"; fail "$1: doesn't say '$3'"; }
  [[ -z ${4:-} ]] || ! grep -c -- "$4" <<<"$out" >/dev/null || { echo "$out"; fail "$1: says '$4'"; }
}
dbranch() { git checkout -q omamobile && git checkout -q -b "$1"; }
merge=--merge

# kernel #108: a new gs201 board, whose only message is one cheetah has at
# the base. The base build was asked for the new board too and stopped
# there, before zuma-husky, so husky's warning read as new; and panther's
# soc_id message, cheetah's word for word, counted as new.
dbranch newboard
printf '%s\n' "$soc" > "$g/gs201-panther.dts"
git add -A && git commit -q -m "arm64: dts: exynos: google: add panther" -m "Signed-off-by: A Human <human@example.org>"
brun "a new board with a sibling's message" 0 "no new warnings" "zuma-husky"
brun "a new board with a sibling's message" 0 "^#   arch/arm64/boot/dts/exynos/google/gs201-panther.dtb: / (google,gs201-panther): soc_id"
echo "ok - a new board isn't failed for a base board it stopped the base build before, or for its sibling's message (kernel #108)"

dbranch newboard-own
printf '%s\n' "$soc" "msg / (google,@B@): 'foo' is a required property" > "$g/gs201-panther.dts"
git add -A && git commit -q -m "arm64: dts: exynos: google: add panther" -m "Signed-off-by: A Human <human@example.org>"
brun "a new board's own message" 1 "^    arch/arm64/boot/dts/exynos/google/gs201-panther.dtb: / (google,gs201-panther): 'foo' is a required"
echo "ok - a message no sibling has at the base is new on a new board"

dbranch oldboard
printf '%s\n' "$soc" "msg phy@11110000 (google,zuma-eusb2-phy): 'vdd-supply' is a required property" > "$g/zuma-husky.dts"
git commit -q -am "arm64: dts: exynos: google: zuma-husky: change" -m "Signed-off-by: A Human <human@example.org>"
brun "a sibling's message on a board the base has" 1 "zuma-husky.dtb: / (google,zuma-husky): soc_id"
echo "ok - a board the base has is compared with itself, not with its siblings"

# A base that doesn't build (here a pull request fixes it): the boards that
# did build are still compared, and the log says which didn't. Without
# --merge, so the base is the branch point. husky built nowhere at the base,
# so its message counts as new; cheetah's does not.
git checkout -q omamobile && echo broken >> "$g/zuma-husky.dts" && git commit -q -am "base: break husky"
dbranch fixbase
sed -i '/^broken/d' "$g/zuma-husky.dts"
git commit -q -am "arm64: dts: exynos: google: zuma-husky: fix" -m "Signed-off-by: A Human <human@example.org>"
merge="" brun "a base that doesn't build" 1 "the base's device trees don't all build"
merge="" brun "a base that doesn't build" 1 "^    arch/arm64/boot/dts/exynos/google/zuma-husky.dtb: phy" "^    .*gs201-cheetah.dtb"
echo "ok - a base that doesn't all build is compared where it did, and says so"
