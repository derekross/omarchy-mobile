#!/bin/bash
# SPDX-License-Identifier: MIT
# Unsupported boot methods must fail before touching a phone or preparing images.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
mkdir -p "$t/repo/bin" "$t/repo/tools" "$t/repo/device/probe" "$t/bin" "$t/bundle/images"
cp bin/omamobile "$t/repo/bin/"
cp tools/install-phone "$t/repo/tools/"
cp tools/install-phone "$t/bundle/install"
# shellcheck disable=SC2016 # fixture evaluated by the child, not this test
printf 'DEVICE=${DEVICE:-probe}\nSRC_DIR=/no-sources-needed\n' > "$t/repo/omamobile.conf"
# Any phone or container command is a failure, including read-only queries.
for cmd in fastboot ssh docker; do
  # shellcheck disable=SC2016 # fake command reads the exported fixture path
  printf '#!/bin/sh\necho called >> "$CALLS"\nexit 97\n' > "$t/bin/$cmd"
  chmod +x "$t/bin/$cmd"
done
export PATH="$t/bin:$PATH" CALLS="$t/calls"
unset KERNEL_OUT KERNEL_DIR KERNEL_BASE WORK || true
fail() { echo "not ok - $*" >&2; cat "$t/log" >&2; exit 1; }
for method in ram-only uboot-ext4 unknown ''; do
  printf 'CODENAME=probe\nBOOT_METHOD="%s"\nBOOT_IMAGES=""\nUFS_RW=""\n' "$method" > "$t/repo/device/probe/device.conf"
  cp "$t/repo/device/probe/device.conf" "$t/bundle/device.conf"
  for cmd in images flash push; do
    if DEVICE=probe "$t/repo/bin/omamobile" "$cmd" > "$t/log" 2>&1; then fail "$cmd accepts $method"; fi
    grep -q "unsupported BOOT_METHOD=$method;" "$t/log" || fail "$cmd fails for the wrong reason"
  done
  for installer in "$t/repo/tools/install-phone" "$t/bundle/install"; do
    for dry in '' --dry-run; do
      if "$installer" --device probe $dry --work "$t/work" > "$t/log" 2>&1; then fail "installer accepts $method"; fi
      grep -q "unsupported BOOT_METHOD=$method;" "$t/log" || fail "installer fails for the wrong reason"
    done
  done
  [[ ! -e $t/calls && ! -e $t/work ]] || fail "unsupported method accessed phone or prepared image"
  echo "ok - BOOT_METHOD='${method}' refused by images/flash/push and both installer modes before phone access"
done
# The shipped flame descriptor must remain outside all persistent paths too.
mkdir -p "$t/repo/device/flame"
cp device/flame/device.conf "$t/repo/device/flame/"
if "$t/repo/tools/install-phone" --device flame > "$t/log" 2>&1; then fail "flame installs"; fi
grep -q 'unsupported BOOT_METHOD=ram-only;' "$t/log" || fail "flame fails for the wrong reason"
echo 'ok - the shipped flame descriptor has no persistent installer path'

# qcom-abl is accepted by images only when device/$DEVICE/chainload/ exists
# (installer still refuses until a later PR). flash and push both refuse
# qcom-abl before phone access. A complete dodge-shaped descriptor with
# chainload must get past the BOOT_METHOD check; without a kernel build,
# images stops at "build the kernel first".
mkdir -p "$t/repo/device/abldev/chainload"
cat > "$t/repo/device/abldev/device.conf" <<'DEVEOF'
CODENAME=abldev
NAME="ABL probe"
SOC=sm8750
COMPATIBLE="oneplus,abldev"
PACKAGE=omamobile-device-abldev
BOOT_METHOD=qcom-abl
DTB=qcom/sm8750-oneplus-dodge.dtb
INITRAMFS_INIT=initramfs/init
PANEL_SIZE=1440x3168
BOOT_IMAGES=boot
UFS_RW="boot_b userdata"
OMAMOBILE_SLOT=b
DEVEOF
# Minimal chainload stubs so images reaches the kernel check.
printf '#!/bin/sh\n' > "$t/repo/device/abldev/chainload/init"
printf '# stub\n' > "$t/repo/device/abldev/chainload/stage2-dtb.py"
if DEVICE=abldev "$t/repo/bin/omamobile" images > "$t/log" 2>&1; then fail "images unexpectedly succeeded without a kernel"; fi
grep -q 'unsupported BOOT_METHOD=qcom-abl' "$t/log" && fail "images still refuses qcom-abl"
grep -q 'build the kernel first' "$t/log" || fail "images did not reach the kernel check for qcom-abl"
[[ ! -e $t/calls ]] || fail "qcom-abl images accessed the phone"
echo 'ok - BOOT_METHOD=qcom-abl accepted by images with chainload/ (stops before phone access)'

# Missing chainload/ must refuse before the kernel check.
rm -rf "$t/repo/device/abldev/chainload"
if DEVICE=abldev "$t/repo/bin/omamobile" images > "$t/log" 2>&1; then fail "images accepted qcom-abl without chainload"; fi
grep -q 'qcom-abl needs device/abldev/chainload/' "$t/log" || fail "images did not require chainload/"
[[ ! -e $t/calls ]] || fail "qcom-abl images without chainload accessed the phone"
echo 'ok - BOOT_METHOD=qcom-abl refused by images without device/$DEVICE/chainload/'

# Restore chainload for flash/push refuse checks (they load_device only).
mkdir -p "$t/repo/device/abldev/chainload"
printf '#!/bin/sh\n' > "$t/repo/device/abldev/chainload/init"
printf '# stub\n' > "$t/repo/device/abldev/chainload/stage2-dtb.py"

if DEVICE=abldev "$t/repo/bin/omamobile" flash > "$t/log" 2>&1; then fail "flash unexpectedly accepted qcom-abl"; fi
grep -q 'flash refuses BOOT_METHOD=qcom-abl' "$t/log" || fail "flash did not refuse qcom-abl"
grep -q 'no in-tree day-2 update path' "$t/log" || fail "flash message still points at a day-2 path"
[[ ! -e $t/calls ]] || fail "qcom-abl flash accessed the phone"
echo 'ok - BOOT_METHOD=qcom-abl refused by flash before phone access'

if DEVICE=abldev "$t/repo/bin/omamobile" push > "$t/log" 2>&1; then fail "push unexpectedly accepted qcom-abl"; fi
grep -q 'push refuses BOOT_METHOD=qcom-abl' "$t/log" || fail "push did not refuse qcom-abl"
[[ ! -e $t/calls ]] || fail "qcom-abl push accessed the phone"
echo 'ok - BOOT_METHOD=qcom-abl refused by push before phone access'

# slot_suffix resolver: bootconfig wins; bootargs fallback; empty if neither.
rs="device/dodge/chainload/resolve-slot-suffix.sh"
[[ -x $rs ]] || fail "resolve-slot-suffix.sh missing"
bc=$(mktemp); ba=$(mktemp)
printf 'androidboot.slot_suffix = "_b"\nother = 1\n' > "$bc"
printf 'rdinit=/init androidboot.slot_suffix=_a console=tty0\n' > "$ba"
got=$("$rs" "$bc" "$ba")
[[ $got == _b ]] || fail "bootconfig should win, got '$got'"
echo 'ok - slot_suffix from bootconfig wins over bootargs'
got=$("$rs" /nonexistent "$ba")
[[ $got == _a ]] || fail "bootargs fallback failed, got '$got'"
echo 'ok - slot_suffix falls back to chosen/bootargs'
got=$("$rs" /nonexistent /nonexistent)
[[ -z $got ]] || fail "expected empty suffix, got '$got'"
echo 'ok - slot_suffix empty when neither source has it'
got=$("$rs" "$bc" /nonexistent)
[[ $got == _b ]] || fail "bootconfig-only failed, got '$got'"
echo 'ok - slot_suffix from bootconfig alone'
rm -f "$bc" "$ba"
