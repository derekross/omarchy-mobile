#!/bin/bash
# SPDX-License-Identifier: MIT
# Validate host configuration without opening a connection.
# shellcheck disable=SC2016
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
scratch=$(mktemp -d)
scratch=$(cd "$scratch" && pwd -P)
trap 'rm -rf "$scratch"' EXIT
cat >"$scratch/ssh" <<'SH'
#!/bin/sh
printf '%s\n' "$@"
SH
chmod +x "$scratch/ssh"
# Install the route stand-in before ANY explicit /dev/null config case.
# No test may inspect the developer's actual routing table.
export PHONE_TEST_ROUTES='[]'
export PHONE_TEST_IP_CALLS="$scratch/ip-calls"
cat >"$scratch/ip" <<'SH'
#!/bin/sh
printf '%s\n' "$*" >> "$PHONE_TEST_IP_CALLS"
printf '%s\n' "$PHONE_TEST_ROUTES"
SH
chmod +x "$scratch/ip"
real_ssh=$(command -v ssh || true)
export PATH="$scratch:$PATH"
unset OMAMOBILE_SSH_HOST OMAMOBILE_SSH_KEY OMAMOBILE_SSH_KNOWN_HOSTS OMAMOBILE_SSH_SHARE OMAMOBILE_SSH_HOST_KEY_ALIAS OMAMOBILE_SSH_CONFIG OMAMOBILE_SSH_INTERFACE
tools/phone-ssh 'printf "%s" "$HOME"' >"$scratch/default"
grep -Fx root@172.16.42.1 "$scratch/default" >/dev/null
grep -Fx 'printf "%s" "$HOME"' "$scratch/default" >/dev/null
grep -Fx ConnectTimeout=6 "$scratch/default" >/dev/null
# Default stays as today: no host-key state (the USB address is answered by
# several SSH servers by design: the initramfs's dropbear, the installed system).
grep -Fx StrictHostKeyChecking=no "$scratch/default" >/dev/null
grep -Fx UserKnownHostsFile=/dev/null "$scratch/default" >/dev/null
echo 'ok - the default has no host-key state (unchanged behavior)'

# OMAMOBILE_SSH_KNOWN_HOSTS=tofu opts in to pinning. Every call here points
# XDG_DATA_HOME or HOME at the scratch directory, and nothing may touch the
# pin file of whoever runs the test.
caller_pin="${XDG_DATA_HOME:-${HOME:-}/.local/share}/omamobile/phone-ssh"
existed=0
if [[ -e $caller_pin ]]; then existed=1; fi
XDG_DATA_HOME="$scratch/xdg-data" OMAMOBILE_SSH_KNOWN_HOSTS=tofu tools/phone-ssh true >"$scratch/tofu" 2>"$scratch/tofu.err"
grep -Fx StrictHostKeyChecking=accept-new "$scratch/tofu" >/dev/null
grep -Fx -- 'UserKnownHostsFile="'"$scratch"'/xdg-data/omamobile/phone-ssh/known_hosts"' "$scratch/tofu" >/dev/null
[[ $(stat -c %a "$scratch/xdg-data/omamobile/phone-ssh") == 700 ]]
# The tool makes the directory only: ssh writes the key at its first connect.
[[ ! -e $scratch/xdg-data/omamobile/phone-ssh/known_hosts ]]
[[ ! -s $scratch/tofu.err ]]
echo 'ok - OMAMOBILE_SSH_KNOWN_HOSTS=tofu pins on first use (accept-new), in a directory of its own, 0700'
# With only HOME set, the pin file is under ~/.local/share: not straight under
# the home directory (review on #855).
env -u XDG_DATA_HOME HOME="$scratch/home-only" OMAMOBILE_SSH_KNOWN_HOSTS=tofu tools/phone-ssh true >"$scratch/tofu-home" 2>"$scratch/tofu-home.err"
grep -Fx -- 'UserKnownHostsFile="'"$scratch"'/home-only/.local/share/omamobile/phone-ssh/known_hosts"' "$scratch/tofu-home" >/dev/null
[[ ! -e $scratch/home-only/omamobile ]]
[[ ! -s $scratch/tofu-home.err ]]
echo 'ok - with only HOME set, the pin file is under ~/.local/share'
# A relative XDG_DATA_HOME is invalid (the XDG base directory specification)
# and is ignored: the pin file is under ~/.local/share, never in a directory
# that depends on where the tool was run from.
XDG_DATA_HOME=relative-data HOME="$scratch/home-relative" OMAMOBILE_SSH_KNOWN_HOSTS=tofu tools/phone-ssh true >"$scratch/tofu-relative" 2>"$scratch/tofu-relative.err"
grep -Fx -- 'UserKnownHostsFile="'"$scratch"'/home-relative/.local/share/omamobile/phone-ssh/known_hosts"' "$scratch/tofu-relative" >/dev/null
[[ ! -e $PWD/relative-data ]]
[[ ! -s $scratch/tofu-relative.err ]]
echo 'ok - a relative XDG_DATA_HOME is ignored'
# Pinning asked for and not to be had (no HOME, or a directory that can't be
# made): the call still goes out, without a host-key check, and says so.
unpinned='phone-ssh: OMAMOBILE_SSH_KNOWN_HOSTS=tofu: no pin file could be made, so this call goes out without a host-key check'
env -u HOME -u XDG_DATA_HOME OMAMOBILE_SSH_KNOWN_HOSTS=tofu tools/phone-ssh true >"$scratch/tofu-nohome" 2>"$scratch/tofu-nohome.err"
grep -Fx StrictHostKeyChecking=no "$scratch/tofu-nohome" >/dev/null
grep -Fx UserKnownHostsFile=/dev/null "$scratch/tofu-nohome" >/dev/null
grep -Fx "$unpinned" "$scratch/tofu-nohome.err" >/dev/null
: >"$scratch/not-a-directory"
XDG_DATA_HOME="$scratch/not-a-directory" OMAMOBILE_SSH_KNOWN_HOSTS=tofu tools/phone-ssh true >"$scratch/tofu-nodir" 2>"$scratch/tofu-nodir.err"
grep -Fx StrictHostKeyChecking=no "$scratch/tofu-nodir" >/dev/null
grep -Fx "$unpinned" "$scratch/tofu-nodir.err" >/dev/null
echo 'ok - tofu with no HOME, or no directory possible, goes out unpinned and says so on stderr'
# As for an explicit known-hosts file, the path must be literal: XDG_DATA_HOME
# with % or ${ is refused before anything is made, and ssh is not run.
for bad_home in "$scratch/data%h" "$scratch"'/data${HOME}'; do
  if XDG_DATA_HOME="$bad_home" OMAMOBILE_SSH_KNOWN_HOSTS=tofu tools/phone-ssh true >"$scratch/tofu-token" 2>"$scratch/tofu-token.err"; then
    echo 'not ok - a pin path with an OpenSSH expansion token was accepted' >&2; exit 1
  fi
  [[ ! -s $scratch/tofu-token ]]
  [[ ! -e $bad_home ]]
  grep -Fx 'phone-ssh: OMAMOBILE_SSH_KNOWN_HOSTS=tofu: XDG_DATA_HOME (or HOME) has a line break, % or ${, which OpenSSH would expand in the pin file'"'"'s path' "$scratch/tofu-token.err" >/dev/null
done
echo 'ok - a pin path with % or ${ is refused, and nothing is made for it'
# A pinned call is a connection context of its own. Sharing one with an
# unpinned call would let a master opened without the check carry it; one
# pinned elsewhere would carry it past a changed key. Calls pinned to the
# same file share among themselves, and --stop closes that master.
OMAMOBILE_SSH_SHARE=1 tools/phone-ssh true >"$scratch/shared-default" 2>/dev/null
OMAMOBILE_SSH_SHARE=1 XDG_DATA_HOME="$scratch/xdg-data" OMAMOBILE_SSH_KNOWN_HOSTS=tofu tools/phone-ssh true >"$scratch/shared-tofu" 2>/dev/null
OMAMOBILE_SSH_SHARE=1 XDG_DATA_HOME="$scratch/xdg-data" OMAMOBILE_SSH_KNOWN_HOSTS=tofu tools/phone-ssh true >"$scratch/shared-tofu-again" 2>/dev/null
OMAMOBILE_SSH_SHARE=1 XDG_DATA_HOME="$scratch/xdg-other" OMAMOBILE_SSH_KNOWN_HOSTS=tofu tools/phone-ssh true >"$scratch/shared-tofu-other" 2>/dev/null
OMAMOBILE_SSH_SHARE=1 env -u HOME -u XDG_DATA_HOME OMAMOBILE_SSH_KNOWN_HOSTS=tofu tools/phone-ssh true >"$scratch/shared-tofu-unpinned" 2>/dev/null
grep -Fx 'ControlPath='"${XDG_RUNTIME_DIR:-/tmp}"'/omamobile-ssh-%C' "$scratch/shared-default" >/dev/null
shared_default=$(sed -n '/^ControlPath=/p' "$scratch/shared-default")
shared_tofu=$(sed -n '/^ControlPath=/p' "$scratch/shared-tofu")
[[ $shared_tofu =~ /omamobile-ssh-[0-9a-f]{12}-%C$ ]]
[[ $shared_tofu != "$shared_default" ]]
[[ $(sed -n '/^ControlPath=/p' "$scratch/shared-tofu-again") == "$shared_tofu" ]]
[[ $(sed -n '/^ControlPath=/p' "$scratch/shared-tofu-other") != "$shared_tofu" ]]
[[ $(sed -n '/^ControlPath=/p' "$scratch/shared-tofu-unpinned") != "$shared_default" ]]
[[ $(sed -n '/^ControlPath=/p' "$scratch/shared-tofu-unpinned") != "$shared_tofu" ]]
# Not asked to share, a pinned call opens a connection of its own, as a call
# with an explicit known-hosts file does.
grep -Fx ControlMaster=no "$scratch/tofu" >/dev/null
grep -Fx ControlPath=none "$scratch/tofu" >/dev/null
XDG_DATA_HOME="$scratch/xdg-data" OMAMOBILE_SSH_KNOWN_HOSTS=tofu tools/phone-ssh --stop >"$scratch/tofu-stop" 2>"$scratch/tofu-stop.err"
grep -Fx -- "$shared_tofu" "$scratch/tofu-stop" >/dev/null
[[ ! -s $scratch/tofu-stop.err ]]
echo 'ok - a pinned call shares connections only with calls pinned to the same file'
if [[ -e $caller_pin && $existed == 0 ]]; then
  echo 'not ok - the test created a pin file in the home of whoever runs it' >&2; exit 1
fi
# What a refused key rests on is OpenSSH's, not this tool's: an explicit
# known-hosts file is checked strictly. The stand-in ssh only prints its
# options, so no second connection with a changed key is made here.
: >"$scratch/explicit-hosts"
OMAMOBILE_SSH_KNOWN_HOSTS="$scratch/explicit-hosts" tools/phone-ssh true >"$scratch/strict"
grep -Fx StrictHostKeyChecking=yes "$scratch/strict" >/dev/null
echo 'ok - an explicit known_hosts file is checked strictly'
OMAMOBILE_SSH_CONNECT_TIMEOUT=19 tools/phone-ssh true >"$scratch/timeout-override"
grep -Fx ConnectTimeout=19 "$scratch/timeout-override" >/dev/null
for bad_timeout in 0 -1 1.5 invalid 999x; do
  if OMAMOBILE_SSH_CONNECT_TIMEOUT=$bad_timeout tools/phone-ssh true >"$scratch/bad-timeout" 2>/dev/null; then
    echo 'not ok - invalid connection timeout accepted'; exit 1
  fi
  [[ ! -s $scratch/bad-timeout ]]
done
export OMAMOBILE_SSH_HOST='root@fe80::1234%usb-test'
export OMAMOBILE_SSH_KEY="$scratch/key with spaces"
printf 'fake identity\n' >"$OMAMOBILE_SSH_KEY"
export OMAMOBILE_SSH_KNOWN_HOSTS="$scratch/known hosts"
printf 'fake known host\n' >"$OMAMOBILE_SSH_KNOWN_HOSTS"
tools/phone-ssh 'uname -r' >"$scratch/configured"
grep -Fx -- "$OMAMOBILE_SSH_HOST" "$scratch/configured" >/dev/null
grep -Fx -- "$OMAMOBILE_SSH_KEY" "$scratch/configured" >/dev/null
grep -Fx -- 'UserKnownHostsFile="'"$OMAMOBILE_SSH_KNOWN_HOSTS"'"' "$scratch/configured" >/dev/null
grep -Fx StrictHostKeyChecking=yes "$scratch/configured" >/dev/null
grep -Fx ControlPath=none "$scratch/configured" >/dev/null
if OMAMOBILE_SSH_HOST=-V tools/phone-ssh true >"$scratch/bad" 2>/dev/null; then
  echo 'not ok - option-like SSH host accepted' >&2; exit 1
fi
[[ ! -s $scratch/bad ]]
export OMAMOBILE_SSH_SHARE=1
tools/phone-ssh 'uname -r' >"$scratch/shared"
grep -Fx ControlMaster=auto "$scratch/shared" >/dev/null
grep -Fx -- "$OMAMOBILE_SSH_HOST" "$scratch/shared" >/dev/null
shared=$(sed -n '/^ControlPath=/p' "$scratch/shared")
[[ $shared =~ /omamobile-ssh-[0-9a-f]{12}-%C$ ]]
# Native Linux and rescue can share the USB address but use separate pins.
OMAMOBILE_SSH_HOST_KEY_ALIAS=phone-native tools/phone-ssh true >"$scratch/native"
OMAMOBILE_SSH_HOST_KEY_ALIAS=phone-rescue tools/phone-ssh true >"$scratch/rescue"
grep -Fx HostKeyAlias=phone-native "$scratch/native" >/dev/null
native=$(sed -n '/^ControlPath=/p' "$scratch/native")
[[ $native != "$shared" && $native != $(sed -n '/^ControlPath=/p' "$scratch/rescue") ]]
OMAMOBILE_SSH_HOST_KEY_ALIAS=phone-native tools/phone-ssh --stop >"$scratch/native-stop"
grep -Fx -- "$native" "$scratch/native-stop" >/dev/null
OMAMOBILE_SSH_HOST_KEY_ALIAS=phone-native OMAMOBILE_SSH_SHARE=0 tools/phone-ssh true >"$scratch/native-fresh"
grep -Fx ControlPath=none "$scratch/native-fresh" >/dev/null
for bad in 'two names' $'name\nother' '-option'; do
  if OMAMOBILE_SSH_HOST_KEY_ALIAS=$bad tools/phone-ssh true >"$scratch/bad-alias" 2>/dev/null; then
    echo 'not ok - invalid host-key alias accepted'; exit 1
  fi
  [[ ! -s $scratch/bad-alias ]]
done
# OpenSSH appends a dot and 16 random characters while binding a master.
# Cover a normal Linux runtime directory and the longest decimal UID path.
for runtime in /run/user/1000 /run/user/4294967294; do
  XDG_RUNTIME_DIR=$runtime tools/phone-ssh true >"$scratch/socket-length"
  python3 - "$scratch/socket-length" <<'PY'
import sys
from pathlib import Path
options = Path(sys.argv[1]).read_text().splitlines()
path, = (option.removeprefix('ControlPath=') for option in options
         if option.startswith('ControlPath='))
expanded = path.replace('%C', 'a' * 40)
temporary = expanded + '.' + 'a' * 16
size = len(temporary.encode())
assert size <= 107, f'master socket needs {size} bytes, Linux permits 107: {temporary}'
print(f'ok - shared master socket with temporary suffix fits ({size}/107 bytes)')
PY
done
# -G reads only this fixture config: no connection or user ssh_config.
if [[ -n $real_ssh ]]; then
  OMAMOBILE_SSH_HOST=root@fixture.invalid tools/phone-ssh true >"$scratch/alias-options"
  python3 - "$real_ssh" "$scratch" <<'PY'
import subprocess, sys
from pathlib import Path
scratch = Path(sys.argv[2])
args = (scratch / 'alias-options').read_text().splitlines()
config = scratch / 'ssh_config'
def control_path(host, port):
    config.write_text(f'Host *\n  HostName {host}\n  Port {port}\n')
    result = subprocess.run([sys.argv[1], '-G', '-F', str(config), *args],
                            check=True, capture_output=True, text=True)
    path, = (line for line in result.stdout.splitlines()
             if line.startswith('controlpath '))
    return path
paths = (control_path('one.invalid', 2201), control_path('one.invalid', 2202),
         control_path('two.invalid', 2201))
assert len(set(paths)) == 3, 'SSH alias host/port changes must select separate masters'
print('ok - OpenSSH keeps alias host/port changes on separate masters')
PY
else
  echo 'ok - # skip: no OpenSSH for alias host/port configuration check'
fi
# Ask OpenSSH itself which known-hosts name it will use; never connect.
if [[ -n $real_ssh ]]; then
  python3 - "$real_ssh" "$scratch/native" <<'PY'
import subprocess, sys
from pathlib import Path
options = Path(sys.argv[2]).read_text().splitlines()
result = subprocess.run([sys.argv[1], '-G', '-F', '/dev/null', *options],
                        check=True, capture_output=True, text=True)
assert 'hostkeyalias phone-native' in result.stdout.splitlines()
assert 'stricthostkeychecking true' in result.stdout.splitlines()
print('ok - OpenSSH uses the explicit alias with strict host-key checking')
PY
fi
tools/phone-ssh --fresh 'uname -r' >"$scratch/fresh"
grep -Fx ControlPath=none "$scratch/fresh" >/dev/null
grep -Fx ControlMaster=no "$scratch/fresh" >/dev/null
if grep -Fx ControlMaster=auto "$scratch/fresh"; then exit 1; fi
tools/phone-ssh --stop >"$scratch/stop"
grep -Fx -- "$OMAMOBILE_SSH_HOST" "$scratch/stop" >/dev/null
grep -Fx -- "$shared" "$scratch/stop" >/dev/null
grep -Fx -- -O "$scratch/stop" >/dev/null
printf 'other fake identity\n' >"$scratch/other identity"
OMAMOBILE_SSH_KEY="$scratch/other identity" tools/phone-ssh true >"$scratch/other"
[[ $(sed -n '/^ControlPath=/p' "$scratch/other") != "$shared" ]]
printf 'changed host key\n' >"$OMAMOBILE_SSH_KNOWN_HOSTS"
tools/phone-ssh true >"$scratch/changed"
[[ $(sed -n '/^ControlPath=/p' "$scratch/changed") != "$shared" ]]
printf 'rotated fake identity\n' >"$OMAMOBILE_SSH_KEY"
tools/phone-ssh true >"$scratch/rotated"
[[ $(sed -n '/^ControlPath=/p' "$scratch/rotated") != $(sed -n '/^ControlPath=/p' "$scratch/changed") ]]
mkdir -p "$scratch/one" "$scratch/two"
printf 'first fake identity\n' >"$scratch/one/id"
printf 'second fake identity\n' >"$scratch/two/id"
repo=$PWD
(cd "$scratch/one"; OMAMOBILE_SSH_KEY=id "$repo/tools/phone-ssh" true) >"$scratch/relative-one"
(cd "$scratch/two"; OMAMOBILE_SSH_KEY=id "$repo/tools/phone-ssh" true) >"$scratch/relative-two"
[[ $(sed -n '/^ControlPath=/p' "$scratch/relative-one") != $(sed -n '/^ControlPath=/p' "$scratch/relative-two") ]]
printf 'fake key\n' >"$scratch/token%key"
if OMAMOBILE_SSH_KEY="$scratch/token%key" tools/phone-ssh true >"$scratch/token" 2>/dev/null; then
  echo 'not ok - ambiguous SSH expansion in explicit path'; exit 1
fi
[[ ! -s $scratch/token ]]
# Default connections retain upstream's socket and --stop target.
unset OMAMOBILE_SSH_HOST OMAMOBILE_SSH_KEY OMAMOBILE_SSH_KNOWN_HOSTS
tools/phone-ssh true >"$scratch/default-shared"
grep -Fx 'ControlPath='"${XDG_RUNTIME_DIR:-/tmp}"'/omamobile-ssh-%C' "$scratch/default-shared" >/dev/null
tools/phone-ssh --fresh true >"$scratch/default-fresh"
grep -Fx ControlPath=none "$scratch/default-fresh" >/dev/null
echo 'ok - phone SSH options preserve sharing/fresh/stop and isolate identity/host-key policy'
# A config override is explicit, normalized as a single argv value, and never
# silently enabled after a failure. No socket is opened by these fake calls.
if grep -Fx -- -F "$scratch/default-shared"; then exit 1; fi
export OMAMOBILE_SSH_CONFIG="$scratch/config with spaces"
printf 'Host *\n  HostName fixture.invalid\n  Port 2203\n' >"$OMAMOBILE_SSH_CONFIG"
tools/phone-ssh true >"$scratch/configured-file"
grep -Fx -- -F "$scratch/configured-file" >/dev/null
grep -Fx -- "$OMAMOBILE_SSH_CONFIG" "$scratch/configured-file" >/dev/null
config_shared=$(sed -n '/^ControlPath=/p' "$scratch/configured-file")
[[ $config_shared != $(sed -n '/^ControlPath=/p' "$scratch/default-shared") ]]
tools/phone-ssh --stop >"$scratch/configured-stop"
grep -Fx -- "$config_shared" "$scratch/configured-stop" >/dev/null
printf 'Host *\n  HostName fixture.invalid\n  Port 2204\n' >"$OMAMOBILE_SSH_CONFIG"
tools/phone-ssh true >"$scratch/config-rotated"
[[ $config_shared != $(sed -n '/^ControlPath=/p' "$scratch/config-rotated") ]]
cp "$OMAMOBILE_SSH_CONFIG" "$scratch/other config"
OMAMOBILE_SSH_CONFIG="$scratch/other config" tools/phone-ssh true >"$scratch/config-other-path"
[[ $(sed -n '/^ControlPath=/p' "$scratch/config-rotated") != $(sed -n '/^ControlPath=/p' "$scratch/config-other-path") ]]
: >"$PHONE_TEST_IP_CALLS"
OMAMOBILE_SSH_CONFIG=/dev/null tools/phone-ssh --fresh true >"$scratch/config-null"
grep -Fx -- '-j route show table main match 172.16.42.1/32' "$PHONE_TEST_IP_CALLS" >/dev/null
grep -Fx /dev/null "$scratch/config-null" >/dev/null
grep -Fx ControlPath=none "$scratch/config-null" >/dev/null
for bad_config in "$scratch/missing config" "$scratch" "$scratch/config%token" $'bad\nconfig'; do
    if OMAMOBILE_SSH_CONFIG="$bad_config" tools/phone-ssh true >"$scratch/config-rejected" 2>/dev/null; then
        echo 'not ok - invalid explicit config accepted'; exit 1
    fi
    [[ ! -s $scratch/config-rejected ]]
done
# -G inspects configuration only and makes no network connection.
if [[ -n $real_ssh ]]; then
    python3 - "$real_ssh" "$scratch/config-rotated" <<'PY'
import subprocess, sys
from pathlib import Path
args = Path(sys.argv[2]).read_text().splitlines()
result = subprocess.run([sys.argv[1], '-G', *args], check=True, capture_output=True, text=True)
assert 'hostname fixture.invalid' in result.stdout.splitlines()
assert 'port 2204' in result.stdout.splitlines()
print('ok - explicit SSH config reaches OpenSSH without changing default policy')
PY
fi
unset OMAMOBILE_SSH_CONFIG
tools/phone-ssh true >"$scratch/config-unset"
cmp "$scratch/default-shared" "$scratch/config-unset"
echo 'ok - explicit SSH config isolates path/content, fresh/stop, and default remains byte-identical'
# Relative spellings of the same explicit file select the same policy context.
(cd "$scratch"; OMAMOBILE_SSH_CONFIG='config with spaces' "$repo/tools/phone-ssh" true) >"$scratch/config-relative"
[[ $(sed -n '/^ControlPath=/p' "$scratch/config-relative") == $(sed -n '/^ControlPath=/p' "$scratch/config-rotated") ]]
if OMAMOBILE_SSH_CONFIG=/dev/zero tools/phone-ssh true >"$scratch/config-device" 2>/dev/null; then
    echo 'not ok - arbitrary nonregular SSH config device accepted'; exit 1
fi
[[ ! -s $scratch/config-device ]]
# An explicit config must not weaken a caller's pinned host-key options.
if [[ -n $real_ssh ]]; then
    printf 'Host *\n  StrictHostKeyChecking no\n' >"$scratch/config-untrusted-policy"
    OMAMOBILE_SSH_CONFIG="$scratch/config-untrusted-policy" OMAMOBILE_SSH_KNOWN_HOSTS="$scratch/known hosts" tools/phone-ssh --fresh true >"$scratch/config-pinned"
    python3 - "$real_ssh" "$scratch/config-pinned" <<'PY'
import subprocess, sys
from pathlib import Path
args = Path(sys.argv[2]).read_text().splitlines()
result = subprocess.run([sys.argv[1], '-G', *args], check=True, capture_output=True, text=True)
assert 'stricthostkeychecking true' in result.stdout.splitlines()
lines = result.stdout.splitlines()
assert 'controlmaster false' in lines
assert not any(line.startswith('controlpath ') and line != 'controlpath none' for line in lines)
print('ok - explicit config preserves pinned host-key policy and fresh connection')
PY
fi

unset OMAMOBILE_SSH_HOST OMAMOBILE_SSH_KEY OMAMOBILE_SSH_KNOWN_HOSTS OMAMOBILE_SSH_HOST_KEY_ALIAS
# Explicit direct transport never changes global routes or caller trust options.
OMAMOBILE_SSH_CONFIG=/dev/null OMAMOBILE_SSH_INTERFACE=usb-test tools/phone-ssh true >"$scratch/bound"
grep -F -- 'ProxyCommand=' "$scratch/bound" >/dev/null
grep -F -- '--relay usb-test 172.16.42.1' "$scratch/bound" >/dev/null
OMAMOBILE_SSH_CONFIG=/dev/null OMAMOBILE_SSH_INTERFACE=off tools/phone-ssh true >"$scratch/unbound"
if grep -F -- 'ProxyCommand=' "$scratch/unbound"; then exit 1; fi
[[ $(sed -n '/^ControlPath=/p' "$scratch/bound") != $(sed -n '/^ControlPath=/p' "$scratch/unbound") ]]
for invalid in 'bad interface' 'x;true' '-option' '0123456789abcdef'; do
    if OMAMOBILE_SSH_CONFIG=/dev/null OMAMOBILE_SSH_INTERFACE="$invalid" tools/phone-ssh true >"$scratch/invalid-interface" 2>/dev/null; then
        echo 'not ok - invalid interface accepted'; exit 1
    fi
    [[ ! -s $scratch/invalid-interface ]]
done
if OMAMOBILE_SSH_CONFIG="$scratch/config with spaces" OMAMOBILE_SSH_INTERFACE=usb-test tools/phone-ssh true >"$scratch/binding-config" 2>/dev/null; then
    echo 'not ok - binding overrode arbitrary SSH config transport'; exit 1
fi
[[ ! -s $scratch/binding-config ]]
# Discovery is deterministic and ignores non-link/ambiguous routes.
export PHONE_TEST_ROUTES='[{"dst":"172.16.42.0/24","dev":"usb-test","scope":"link","prefsrc":"172.16.42.2"}]'
OMAMOBILE_SSH_CONFIG=/dev/null tools/phone-ssh true >"$scratch/autobound"
grep -F -- '--relay usb-test 172.16.42.1' "$scratch/autobound" >/dev/null
