fi
unset OMAMOBILE_SSH_CONFIG
tools/phone-ssh true >"$scratch/config-unset"
cmp "$scratch/default-shared" "$scratch/config-unset"
echo 'ok - explicit SSH config isolates path/content, fresh/stop, and default remains byte-identical'
# Relative spellings of the same explicit file select the same policy context.
(cd "$scratch"; OMAMOBILE_SSH_CONFIG='config with spaces' "$repo/tools/phone-ssh" true) >"$scratch/config-relative"
[[ $(sed -n '/^ControlPath=/p' "$scratch/config-relative") == $(sed -n '/^ControlPath=/p' "$scratch/config-rotated") ]]
if OMAMOBILE_SSH_CONFIG=/dev/zero tools/phone-ssh true >"$scratch/config-device" 2>/dev/null; then
    echo 'not ok - arbitrary nonregular SSH config device accepted'; exit 1
fi
[[ ! -s $scratch/config-device ]]
