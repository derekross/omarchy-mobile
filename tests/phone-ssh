grep -F -- '--relay usb-test 172.16.42.1' "$scratch/autobound" >/dev/null
export PHONE_TEST_ROUTES='[{"dst":"172.16.42.0/24","dev":"usb-test","scope":"link","prefsrc":"172.16.42.2"},{"dst":"172.16.42.0/24","dev":"other-test","scope":"link","prefsrc":"172.16.42.2"}]'
OMAMOBILE_SSH_CONFIG=/dev/null tools/phone-ssh true >"$scratch/ambiguous"
