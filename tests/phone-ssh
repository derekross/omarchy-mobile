# OpenSSH appends a dot and 16 random characters while binding a master.
# Cover a normal Linux runtime directory and the longest decimal UID path.
for runtime in /run/user/1000 /run/user/4294967294; do
  XDG_RUNTIME_DIR=$runtime tools/phone-ssh true >"$scratch/socket-length"
  python3 - "$scratch/socket-length" <<'PY'
