unset OMAMOBILE_SSH_HOST OMAMOBILE_SSH_KEY OMAMOBILE_SSH_KNOWN_HOSTS
tools/phone-ssh true >"$scratch/default-shared"
grep -Fx 'ControlPath='"${XDG_RUNTIME_DIR:-/tmp}"'/omamobile-ssh-%C' "$scratch/default-shared" >/dev/null
tools/phone-ssh --fresh true >"$scratch/default-fresh"
grep -Fx ControlPath=none "$scratch/default-fresh" >/dev/null
echo 'ok - phone SSH options preserve sharing/fresh/stop and isolate identity/host-key policy'
# A config override is explicit, normalized as a single argv value, and never
# silently enabled after a failure. No socket is opened by these fake calls.
if grep -Fx -- -F "$scratch/default-shared"; then exit 1; fi
export OMAMOBILE_SSH_CONFIG="$scratch/config with spaces"
printf 'Host *\n  HostName fixture.invalid\n  Port 2203\n' >"$OMAMOBILE_SSH_CONFIG"
tools/phone-ssh true >"$scratch/configured-file"
grep -Fx -- -F "$scratch/configured-file" >/dev/null
grep -Fx -- "$OMAMOBILE_SSH_CONFIG" "$scratch/configured-file" >/dev/null
config_shared=$(sed -n '/^ControlPath=/p' "$scratch/configured-file")
[[ $config_shared != $(sed -n '/^ControlPath=/p' "$scratch/default-shared") ]]
tools/phone-ssh --stop >"$scratch/configured-stop"
grep -Fx -- "$config_shared" "$scratch/configured-stop" >/dev/null
printf 'Host *\n  HostName fixture.invalid\n  Port 2204\n' >"$OMAMOBILE_SSH_CONFIG"
tools/phone-ssh true >"$scratch/config-rotated"
[[ $config_shared != $(sed -n '/^ControlPath=/p' "$scratch/config-rotated") ]]
cp "$OMAMOBILE_SSH_CONFIG" "$scratch/other config"
OMAMOBILE_SSH_CONFIG="$scratch/other config" tools/phone-ssh true >"$scratch/config-other-path"
[[ $(sed -n '/^ControlPath=/p' "$scratch/config-rotated") != $(sed -n '/^ControlPath=/p' "$scratch/config-other-path") ]]
OMAMOBILE_SSH_CONFIG=/dev/null tools/phone-ssh --fresh true >"$scratch/config-null"
grep -Fx /dev/null "$scratch/config-null" >/dev/null
grep -Fx ControlPath=none "$scratch/config-null" >/dev/null
for bad_config in "$scratch/missing config" "$scratch" "$scratch/config%token" $'bad\nconfig'; do
    if OMAMOBILE_SSH_CONFIG="$bad_config" tools/phone-ssh true >"$scratch/config-rejected" 2>/dev/null; then
        echo 'not ok - invalid explicit config accepted'; exit 1
    fi
