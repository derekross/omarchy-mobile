grep -F -- 'ProxyCommand=' "$scratch/bound" >/dev/null
grep -F -- '--relay usb-test 172.16.42.1' "$scratch/bound" >/dev/null
OMAMOBILE_SSH_CONFIG=/dev/null OMAMOBILE_SSH_INTERFACE=off tools/phone-ssh true >"$scratch/unbound"
if grep -F -- 'ProxyCommand=' "$scratch/unbound"; then exit 1; fi
[[ $(sed -n '/^ControlPath=/p' "$scratch/bound") != $(sed -n '/^ControlPath=/p' "$scratch/unbound") ]]
for invalid in 'bad interface' 'x;true' '-option' '0123456789abcdef'; do
    if OMAMOBILE_SSH_CONFIG=/dev/null OMAMOBILE_SSH_INTERFACE="$invalid" tools/phone-ssh true >"$scratch/invalid-interface" 2>/dev/null; then
        echo 'not ok - invalid interface accepted'; exit 1
    fi
    [[ ! -s $scratch/invalid-interface ]]
done
if OMAMOBILE_SSH_CONFIG="$scratch/config with spaces" OMAMOBILE_SSH_INTERFACE=usb-test tools/phone-ssh true >"$scratch/binding-config" 2>/dev/null; then
    echo 'not ok - binding overrode arbitrary SSH config transport'; exit 1
fi
[[ ! -s $scratch/binding-config ]]
