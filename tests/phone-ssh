#!/bin/bash
# SPDX-License-Identifier: MIT
# Validate host configuration without opening a connection.
# shellcheck disable=SC2016
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
scratch=$(mktemp -d)
scratch=$(cd "$scratch" && pwd -P)
trap 'rm -rf "$scratch"' EXIT
cat >"$scratch/ssh" <<'SH'
#!/bin/sh
printf '%s\n' "$@"
SH
chmod +x "$scratch/ssh"
real_ssh=$(command -v ssh || true)
export PATH="$scratch:$PATH"
unset OMAMOBILE_SSH_HOST OMAMOBILE_SSH_KEY OMAMOBILE_SSH_KNOWN_HOSTS OMAMOBILE_SSH_SHARE
tools/phone-ssh 'printf "%s" "$HOME"' >"$scratch/default"
grep -Fx root@172.16.42.1 "$scratch/default" >/dev/null
grep -Fx 'printf "%s" "$HOME"' "$scratch/default" >/dev/null
export OMAMOBILE_SSH_HOST='root@fe80::1234%usb-test'
export OMAMOBILE_SSH_KEY="$scratch/key with spaces"
printf 'fake identity\n' >"$OMAMOBILE_SSH_KEY"
export OMAMOBILE_SSH_KNOWN_HOSTS="$scratch/known hosts"
printf 'fake known host\n' >"$OMAMOBILE_SSH_KNOWN_HOSTS"
tools/phone-ssh 'uname -r' >"$scratch/configured"
grep -Fx -- "$OMAMOBILE_SSH_HOST" "$scratch/configured" >/dev/null
grep -Fx -- "$OMAMOBILE_SSH_KEY" "$scratch/configured" >/dev/null
grep -Fx -- 'UserKnownHostsFile="'"$OMAMOBILE_SSH_KNOWN_HOSTS"'"' "$scratch/configured" >/dev/null
grep -Fx StrictHostKeyChecking=yes "$scratch/configured" >/dev/null
grep -Fx ControlPath=none "$scratch/configured" >/dev/null
if OMAMOBILE_SSH_HOST=-V tools/phone-ssh true >"$scratch/bad" 2>/dev/null; then
  echo 'not ok - option-like SSH host accepted' >&2; exit 1
fi
[[ ! -s $scratch/bad ]]
export OMAMOBILE_SSH_SHARE=1
tools/phone-ssh 'uname -r' >"$scratch/shared"
grep -Fx ControlMaster=auto "$scratch/shared" >/dev/null
grep -Fx -- "$OMAMOBILE_SSH_HOST" "$scratch/shared" >/dev/null
shared=$(sed -n '/^ControlPath=/p' "$scratch/shared")
[[ $shared =~ /omamobile-ssh-[0-9a-f]{12}-%C$ ]]
# OpenSSH appends a dot and 16 random characters while binding a master.
# Cover a normal Linux runtime directory and the longest decimal UID path.
for runtime in /run/user/1000 /run/user/4294967294; do
  XDG_RUNTIME_DIR=$runtime tools/phone-ssh true >"$scratch/socket-length"
  python3 - "$scratch/socket-length" <<'PY'
import sys
from pathlib import Path
options = Path(sys.argv[1]).read_text().splitlines()
path, = (option.removeprefix('ControlPath=') for option in options
         if option.startswith('ControlPath='))
expanded = path.replace('%C', 'a' * 40)
temporary = expanded + '.' + 'a' * 16
size = len(temporary.encode())
assert size <= 107, f'master socket needs {size} bytes, Linux permits 107: {temporary}'
print(f'ok - shared master socket with temporary suffix fits ({size}/107 bytes)')
PY
done
# -G reads only this fixture config: no connection or user ssh_config.
if [[ -n $real_ssh ]]; then
  OMAMOBILE_SSH_HOST=root@fixture.invalid tools/phone-ssh true >"$scratch/alias-options"
  python3 - "$real_ssh" "$scratch" <<'PY'
import subprocess, sys
from pathlib import Path
scratch = Path(sys.argv[2])
args = (scratch / 'alias-options').read_text().splitlines()
config = scratch / 'ssh_config'
def control_path(host, port):
    config.write_text(f'Host *\n  HostName {host}\n  Port {port}\n')
    result = subprocess.run([sys.argv[1], '-G', '-F', str(config), *args],
                            check=True, capture_output=True, text=True)
    path, = (line for line in result.stdout.splitlines()
             if line.startswith('controlpath '))
    return path
paths = (control_path('one.invalid', 2201), control_path('one.invalid', 2202),
         control_path('two.invalid', 2201))
assert len(set(paths)) == 3, 'SSH alias host/port changes must select separate masters'
print('ok - OpenSSH keeps alias host/port changes on separate masters')
PY
else
  echo 'ok - # skip: no OpenSSH for alias host/port configuration check'
fi
tools/phone-ssh --fresh 'uname -r' >"$scratch/fresh"
grep -Fx ControlPath=none "$scratch/fresh" >/dev/null
grep -Fx ControlMaster=no "$scratch/fresh" >/dev/null
if grep -Fx ControlMaster=auto "$scratch/fresh"; then exit 1; fi
tools/phone-ssh --stop >"$scratch/stop"
grep -Fx -- "$OMAMOBILE_SSH_HOST" "$scratch/stop" >/dev/null
grep -Fx -- "$shared" "$scratch/stop" >/dev/null
grep -Fx -- -O "$scratch/stop" >/dev/null
printf 'other fake identity\n' >"$scratch/other identity"
OMAMOBILE_SSH_KEY="$scratch/other identity" tools/phone-ssh true >"$scratch/other"
[[ $(sed -n '/^ControlPath=/p' "$scratch/other") != "$shared" ]]
printf 'changed host key\n' >"$OMAMOBILE_SSH_KNOWN_HOSTS"
tools/phone-ssh true >"$scratch/changed"
[[ $(sed -n '/^ControlPath=/p' "$scratch/changed") != "$shared" ]]
printf 'rotated fake identity\n' >"$OMAMOBILE_SSH_KEY"
tools/phone-ssh true >"$scratch/rotated"
[[ $(sed -n '/^ControlPath=/p' "$scratch/rotated") != $(sed -n '/^ControlPath=/p' "$scratch/changed") ]]
mkdir -p "$scratch/one" "$scratch/two"
printf 'first fake identity\n' >"$scratch/one/id"
printf 'second fake identity\n' >"$scratch/two/id"
repo=$PWD
(cd "$scratch/one"; OMAMOBILE_SSH_KEY=id "$repo/tools/phone-ssh" true) >"$scratch/relative-one"
(cd "$scratch/two"; OMAMOBILE_SSH_KEY=id "$repo/tools/phone-ssh" true) >"$scratch/relative-two"
[[ $(sed -n '/^ControlPath=/p' "$scratch/relative-one") != $(sed -n '/^ControlPath=/p' "$scratch/relative-two") ]]
printf 'fake key\n' >"$scratch/token%key"
if OMAMOBILE_SSH_KEY="$scratch/token%key" tools/phone-ssh true >"$scratch/token" 2>/dev/null; then
  echo 'not ok - ambiguous SSH expansion in explicit path'; exit 1
fi
[[ ! -s $scratch/token ]]
# Default connections retain upstream's socket and --stop target.
unset OMAMOBILE_SSH_HOST OMAMOBILE_SSH_KEY OMAMOBILE_SSH_KNOWN_HOSTS
tools/phone-ssh true >"$scratch/default-shared"
grep -Fx 'ControlPath='"${XDG_RUNTIME_DIR:-/tmp}"'/omamobile-ssh-%C' "$scratch/default-shared" >/dev/null
tools/phone-ssh --fresh true >"$scratch/default-fresh"
grep -Fx ControlPath=none "$scratch/default-fresh" >/dev/null
echo 'ok - phone SSH options preserve sharing/fresh/stop and isolate identity/host-key policy'
