from pathlib import Path
args = Path(sys.argv[2]).read_text().splitlines()
result = subprocess.run([sys.argv[1], '-G', *args], check=True, capture_output=True, text=True)
assert 'hostname fixture.invalid' in result.stdout.splitlines()
assert 'port 2204' in result.stdout.splitlines()
