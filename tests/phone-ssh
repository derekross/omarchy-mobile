python3 - <<'PYPROXYTEST'
#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Exercise the relay with real backpressure/half-close; no phone/network."""
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import socket
import subprocess
import threading
import unittest
from unittest.mock import patch

ROOT = Path.cwd()
loader = importlib.machinery.SourceFileLoader("phone_proxy", str(ROOT / "tools/phone-ssh-proxy"))
spec = importlib.util.spec_from_loader(loader.name, loader)
proxy = importlib.util.module_from_spec(spec)
loader.exec_module(proxy)


class RelayTests(unittest.TestCase):
    def test_bidirectional_backpressure_and_half_close(self):
        client, peer = socket.socketpair()
        client.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, 4096)
        peer.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, 4096)
        input_read, input_write = os.pipe()
        output_read, output_write = os.pipe()
        incoming = bytes(range(256)) * 8192
        outgoing = bytes(reversed(range(256))) * 8192
        received_input = bytearray()
        received_output = bytearray()
        failures = []

        def guarded(fn):
            def run():
                try:
                    fn()
                except BaseException as error:
                    failures.append(error)
            return run

        def source():
            with os.fdopen(input_write, "wb", buffering=0) as stream:
                stream.write(incoming)

        def output():
            with os.fdopen(output_read, "rb", buffering=0) as stream:
                while chunk := stream.read(65536):
                    received_output.extend(chunk)

        def peer_send():
            peer.sendall(outgoing)

        def peer_receive():
            while chunk := peer.recv(65536):
                received_input.extend(chunk)
            # Send a final acknowledgement only AFTER stdin EOF. A relay
            # that closes both directions at input EOF loses this response.
            sender.join(5)
            peer.sendall(b"after-eof")
            peer.shutdown(socket.SHUT_WR)

        def forward():
            try:
                proxy.relay(client, input_read, output_write)
            finally:
                os.close(output_write)

        sender = threading.Thread(target=guarded(peer_send), daemon=True)
        workers = [threading.Thread(target=guarded(fn), daemon=True)
                   for fn in [source, output, peer_receive, forward]]
        sender.start()
        for worker in workers:
            worker.start()
        for worker in [sender, *workers]:
            worker.join(10)
            self.assertFalse(worker.is_alive(), "relay deadlocked under backpressure")
        self.assertEqual(failures, [])
        self.assertEqual(received_input, incoming)
        self.assertEqual(received_output, outgoing + b"after-eof")
        os.close(input_read)
        client.close()
        peer.close()

    def test_peer_close_returns_even_with_open_stdin(self):
        client, peer = socket.socketpair()
        r, w = os.pipe()
        out = os.open(os.devnull, os.O_WRONLY)
        worker = threading.Thread(target=lambda: proxy.relay(client, r, out), daemon=True)
        worker.start()
        peer.close()
        worker.join(2)
        self.assertFalse(worker.is_alive())
        os.close(w)
        client.close()
        os.close(out)
        # Let the daemon input reader consume EOF before closing its fd.
        import time
        time.sleep(.01)
        os.close(r)

    def test_discovery_requires_unique_direct_link(self):
        cases = [
            ([{"dst": "172.16.42.0/24", "scope": "link", "prefsrc": "172.16.42.2", "dev": "usb-test"}], "usb-test"),
            ([{"dst": "172.16.42.0/24", "scope": "link", "prefsrc": "172.16.42.2", "dev": "usb-test", "gateway": "172.16.42.254"}], ""),
            ([{"dst": "default", "dev": "vpn-test"}], ""),
            ([{"dst": "172.16.42.0/24", "scope": "link", "dev": "wlan-test", "prefsrc": "172.16.42.9"}], ""),
            ([{"dst": "172.16.42.0/24", "scope": "link", "prefsrc": "172.16.42.2", "dev": "one"},
              {"dst": "172.16.42.0/24", "scope": "link", "prefsrc": "172.16.42.2", "dev": "two"}], ""),
        ]
        for routes, expected in cases:
            result = subprocess.CompletedProcess([], 0, json.dumps(routes), "")
            with patch.object(proxy.subprocess, "run", return_value=result):
                self.assertEqual(proxy.discover(), expected)
        with patch.object(proxy.subprocess, "run", side_effect=FileNotFoundError):
            self.assertEqual(proxy.discover(), "")

    def test_relay_binds_only_its_numeric_socket_before_connect(self):
        from unittest.mock import MagicMock
        for address, family, destination in [
            ("192.0.2.1", socket.AF_INET, ("192.0.2.1", 22)),
            ("2001:db8::1", socket.AF_INET6, ("2001:db8::1", 22, 0, 0)),
        ]:
            sock = MagicMock()
            sock.__enter__.return_value = sock
            with patch.object(proxy.socket, "getaddrinfo", return_value=[
                (family, socket.SOCK_STREAM, socket.IPPROTO_TCP, "", destination)
            ]) as resolve, patch.object(proxy.socket, "socket", return_value=sock), \
                 patch.object(proxy, "relay") as relay:
                proxy.main(["--relay", "usb-test", address])
                resolve.assert_called_once_with(address, 22, type=socket.SOCK_STREAM,
                                                flags=socket.AI_NUMERICHOST)
                self.assertEqual(sock.method_calls[:4], [
                    unittest.mock.call.setsockopt(socket.SOL_SOCKET, socket.SO_BINDTODEVICE, b"usb-test\0"),
                    unittest.mock.call.settimeout(6), unittest.mock.call.connect(destination),
                    unittest.mock.call.settimeout(None),
                ])
                relay.assert_called_once_with(sock)

    def test_binding_failure_cannot_fall_back_to_unbound_connect(self):
        from unittest.mock import MagicMock
        sock = MagicMock()
        sock.__enter__.return_value = sock
        sock.setsockopt.side_effect = PermissionError("fixture denied")
        with patch.object(proxy.socket, "getaddrinfo", return_value=[
            (socket.AF_INET, socket.SOCK_STREAM, socket.IPPROTO_TCP, "", ("192.0.2.1", 22))
        ]), patch.object(proxy.socket, "socket", return_value=sock), \
             patch.object(proxy, "relay") as relay:
            with self.assertRaises(PermissionError):
                proxy.main(["--relay", "usb-test", "192.0.2.1"])
            sock.connect.assert_not_called()
            relay.assert_not_called()

    def test_command_rejects_shell_input(self):
        for value in ["bad interface", "x;true", "$(true)", "-option", "a" * 16]:
            with self.assertRaises(ValueError):
                proxy.interface_name(value)
        for value in ["host;true", "$(true)", "host.invalid"]:
            with self.assertRaises(ValueError):
                proxy.main(["--command", "usb-test", value])


if __name__ == "__main__":
    unittest.main()

PYPROXYTEST
