    printf 'Host *\n  StrictHostKeyChecking no\n' >"$scratch/config-untrusted-policy"
    OMAMOBILE_SSH_CONFIG="$scratch/config-untrusted-policy" OMAMOBILE_SSH_KNOWN_HOSTS="$scratch/known hosts" tools/phone-ssh --fresh true >"$scratch/config-pinned"
    python3 - "$real_ssh" "$scratch/config-pinned" <<'PY'
