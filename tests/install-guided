says "hasn't come back" && [[ $(record restart_from) == aaaa-0001 ]] || fail "a restart that was sent is recorded"
echo aaaa-0002 > "$t/boot-id"
guided "" || fail "the install goes on when the phone is back"
once "after a slow restart"
pass "resume: a restart that was sent isn't sent again; one that failed is"

fresh; smoke bad
if guided "$ALL"; then fail "a failed required check fails the install"; fi
says "Something went wrong" && says "[!!]  Desktop is running: not working (Hyprland isn't running) - needed" && says "Never attach the radio backup" ||
  fail "a failed required check: said plainly, with the report and the warning about the backup"
says "read that row" && says "or this install's record" && ! says "To go on from here, run:" && says "checks the phone again, and changes nothing else" ||
  fail "a failed check: the report's dmesg row is to be read before posting, the record isn't to be attached, and a rerun only checks"
[[ -f $STATE/report.json && $(record check) == failed && -z $(record finished) ]] || fail "the report is saved and the install isn't finished"
smoke ok
guided "" || fail "the check passes on a rerun"
once "after the check"
[[ $(events '^phone-smoke') == 2 ]] || fail "only the check runs again"
pass "resume: a failed check saves a report with no identifiers; a rerun only checks again"

# --- After the write, every step is for the phone that was written -------------------
# The review's case: an install that stopped at the backup, a record left
# behind, and a different phone on the cable when it is run again. That
# phone is asked which one it is and nothing else.
other_phone() {  # other_phone WHAT: a rerun with another phone answering over USB changes nothing
  local before
  ssh_phone OTHER999
  before=$(grep -cE '^(nv-backup|phone-provision|phone RESTART|phone-smoke)' "$t/events" || true)
  if guided ""; then fail "$1: another phone can't go on with this phone's install"; fi
  says "is not the phone this install" && says "nothing was copied" || fail "$1: another phone is said plainly"
  [[ $(grep -cE '^(nv-backup|phone-provision|phone RESTART|phone-smoke)' "$t/events" || true) == "$before" ]] ||
    { tail -5 "$t/events" >&2; fail "$1: nothing is copied from, put on or restarted on the other phone"; }
  ! says "Your phone is ready" && [[ -z $(record finished) ]] || fail "$1: the install doesn't finish on another phone"
  ssh_phone FAKE123
}
fresh; touch "$t/fail-backup"
if guided "$ALL"; then fail "setup: an install stopped at the backup"; fi
rm "$t/fail-backup"
other_phone "at the backup"
[[ -z $(record backup) && -z $(record backup_dir) ]] || fail "no backup is recorded from the other phone"
guided "" || fail "with the right phone back, the install goes on"
BACKUPS=2 once "after another phone at the backup"

fresh; touch "$t/no-firstboot"
if guided "$ALL"; then fail "setup: an install stopped at the first start"; fi
touch "$t/firstboot-done"
other_phone "at the first start"
[[ -z $(record first_start) ]] || fail "another phone's finished first start isn't taken for this phone's"
fresh; touch "$t/fail-provision"
if guided "$ALL"; then fail "setup: an install stopped at provisioning"; fi
rm "$t/fail-provision"
other_phone "at provisioning"
fresh; touch "$t/fail-restart"
if guided "$ALL"; then fail "setup: an install stopped at the restart"; fi
rm "$t/fail-restart"
other_phone "at the restart"
fresh; touch "$t/no-comeback"
if guided "$ALL"; then fail "setup: an install waiting for its restart"; fi
echo bbbb-0009 > "$t/boot-id"   # another phone has another boot id
other_phone "waiting for the restart"
[[ -z $(record restart) ]] || fail "another phone's boot id isn't taken for this phone's return"
fresh; smoke bad
if guided "$ALL"; then fail "setup: an install stopped at the check"; fi
smoke ok
other_phone "at the check"
guided "" || fail "with the right phone back, the check passes"
once "after another phone at the check"

# A phone that doesn't answer is said to be that, not "another phone"
fresh; touch "$t/fail-backup"
if guided "$ALL"; then fail "setup: an install stopped at the backup"; fi
rm "$t/fail-backup"; touch "$t/ssh-down"
if guided ""; then fail "a phone that doesn't answer stops the install"; fi
says "The phone doesn't answer over the USB cable" && ! says "is not the phone this install" && [[ $(grep -c '^nv-backup' "$t/events") == 1 ]] ||
  fail "no answer over SSH at an identity check: said as no answer, nothing copied"
# A record that doesn't name the written phone by a digest is refused whole
rm "$t/ssh-down"; sed -i 's/^phone=.*/phone=FAKE123/' "$STATE/state"
cp "$t/events" "$t/events.before"
if guided ""; then fail "a record whose phone isn't a digest is refused"; fi
says "doesn't say which phone was written" && cmp -s "$t/events" "$t/events.before" || fail "a record without the written phone's digest: refused before anything is run"

# A phone that doesn't tell its serial number can't be the phone for certain
fresh; touch "$t/fail-backup"
if guided "$ALL"; then fail "setup: an install stopped at the backup"; fi
rm "$t/fail-backup"; ssh_phone FAKE123 none
if guided ""; then fail "a phone with no serial number to tell stops the install"; fi
says "doesn't tell its serial number" && ! says "To go on from here, run:" && [[ $(grep -c '^nv-backup' "$t/events") == 1 ]] ||
  fail "no serial over SSH: said plainly, nothing copied, no promise of a rerun"
# The serial is found wherever the kernel shows it
for where in cmdline dt bootconfig; do
  ssh_phone OTHER999 "$where"
  if guided ""; then fail "another phone is told apart by its serial from $where"; fi
  says "is not the phone this install" || fail "the serial is read from $where"
done
ssh_phone FAKE123 cmdline
guided "" || fail "the written phone is known by its serial on the kernel command line"
BACKUPS=2 once "with the serial on the command line"
! grep -rcE 'FAKE123|OTHER999' "$STATE" >/dev/null || fail "no serial number is ever stored, only its digest"
