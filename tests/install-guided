other_phone "waiting for the restart"
[[ -z $(record restart) ]] || fail "another phone's boot id isn't taken for this phone's return"
fresh; smoke bad
if guided "$ALL"; then fail "setup: an install stopped at the check"; fi
smoke ok
other_phone "at the check"
guided "" || fail "with the right phone back, the check passes"
once "after another phone at the check"

# A phone that doesn't answer is said to be that, not "another phone"
fresh; touch "$t/fail-backup"
if guided "$ALL"; then fail "setup: an install stopped at the backup"; fi
rm "$t/fail-backup"; touch "$t/ssh-down"
if guided ""; then fail "a phone that doesn't answer stops the install"; fi
says "The phone doesn't answer over the USB cable" && ! says "is not the phone this install" && [[ $(grep -c '^nv-backup' "$t/events") == 1 ]] ||
  fail "no answer over SSH at an identity check: said as no answer, nothing copied"
