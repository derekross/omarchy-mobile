  --version 2026.11.01 --kernel-release 7.3.0-test-1 --channel stable
(cd "$BD" && find . -type f ! -name SHA256SUMS -printf '%P\n' | sort | xargs sha256sum > SHA256SUMS)
bguided() {
  local answers=$1; shift
  printf '%b' "$answers" | env -u XDG_STATE_HOME -u XDG_CACHE_HOME -u OMAMOBILE_INDEX_URL HOME="$t/home" \
    PHONE_SSH="$t/bin/phone" NV_BACKUP="$t/bin/nv-backup" PHONE_PROVISION="$t/bin/phone-provision" \
    PHONE_SMOKE="$t/bin/phone-smoke" INSTALL_POLL="${POLL:-1}" INSTALL_WAIT_FIRST_START="${WAIT_FIRST:-2}" INSTALL_WAIT_RESTART=2 \
