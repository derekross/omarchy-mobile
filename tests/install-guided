says "Enter gets them; no goes on without the cameras." || fail "only Enter, yes or no answer the question"
[[ $(events '^venv-setup') == 0 && $(record camera_tools) == skipped ]] || fail "the modules are fetched only with consent, and 'no' is recorded as the owner's choice"
says "The cameras don't work because you chose to go on without" || fail "the end says why the cameras don't work"
once "without the camera's modules"
fresh; novenv
CAMERA_VENV_SETUP=$t/bin/venv-setup guided "${ALL}\n" || fail "an install that fetches the camera's modules"
