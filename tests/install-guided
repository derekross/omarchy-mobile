pass "resume: a failed radio backup is taken again; provisioning waits for it"

fresh; touch "$t/fail-provision"
if guided "$ALL"; then fail "failed provisioning stops the install"; fi
says "Adding the firmware stopped" && [[ $(events '^phone RESTART') == 0 ]] || fail "no restart after failed provisioning"
rm "$t/fail-provision"
guided "" || fail "the install goes on once provisioning works"
PROVISIONS=2 once "after provisioning"
says "saved earlier in" || fail "the backup isn't taken again"
pass "resume: failed provisioning runs again with the same backup; nothing before it repeats"

# The factory image is checked again just before it is unpacked
fresh; touch "$t/fail-provision"
if guided "$ALL"; then fail "failed provisioning stops the install"; fi
rm "$t/fail-provision"; head -c 3000 /dev/zero > "$t/home/Downloads/$zipname"
if guided ""; then fail "a factory image changed since it was checked is refused"; fi
says "changed since it was checked" && [[ $(grep -c '^phone-provision' "$t/events") == 1 ]] || fail "a changed factory image is never handed to phone-provision"
rm "$t/home/Downloads/$zipname"
guided "\n\n$t/factory.src\n" || fail "the install takes the factory image again, without the phone in Fastboot Mode"
PROVISIONS=2 once "after taking the factory image again"
pass "resume: a factory image that changed or went missing is refused and taken again"

fresh; touch "$t/fail-restart"
if guided "$ALL"; then fail "a failed restart stops the install"; fi
rm "$t/fail-restart"
guided "" || fail "the install goes on once the restart works"
RESTARTS=2 once "after the restart"
fresh; echo 1 > "$t/down-for"   # one silent answer: the suite waits 2 s for a restart
guided "$ALL" || fail "a phone that answers nothing while it restarts doesn't end the install"
[[ $(events '^phone DOWN') == 1 ]] && says "the phone is back" || fail "the installer keeps asking a silent phone until it is back"
