# --- A missing program stops the install before the phone is touched -----------------
# The same PATH without the stand-ins for the extract tools' programs, and
# without this computer's own copies of them
mkdir -p "$t/sys"
IFS=: read -ra dirs <<<"$BASE_PATH"
for d in "${dirs[@]}"; do
  for f in "$d"/*; do [[ -e $t/sys/${f##*/} || ! -x $f ]] || ln -s "$f" "$t/sys/${f##*/}"; done
done
for missing in lpunpack simg2img fsck.erofs readelf; do
  fresh
  rm -f "$t/sys/lpunpack" "$t/sys/simg2img" "$t/sys/fsck.erofs" "$t/sys/readelf" "$t/sys/llvm-readelf"
  mkdir -p "$t/extract-some"; rm -f "$t/extract-some/"*
  for c in lpunpack simg2img fsck.erofs readelf; do [[ $c == "$missing" ]] || cp "$t/extract-bin/$c" "$t/extract-some/"; done
  if PATH="$t/bin:$t/extract-some:$t/sys" guided "$ALL"; then fail "an install without $missing is stopped"; fi
  says "These programs are missing on this computer: $missing" && says "erofs-utils" || fail "a missing $missing is named, with the packages to install"
  [[ $(events '^fastboot') == 0 && -z $(writes) ]] || fail "a missing $missing stops the install before the phone is contacted"
done
pass "a program a later step needs (lpunpack, simg2img, fsck.erofs, readelf) stops the install at step 1, not after the write"

# --- The real tools/phone-provision takes what the installer hands it ---------------
# Everywhere above phone-provision is a stub, and a stub accepts anything:
# an option the real tool doesn't have would pass every test and fail on
# the first phone, after it was erased. So the installer's own call is run
# against the real tool once, in --dry-run and with an SSH that fails the
# test if it is called: PHONE_PROVISION is a wrapper that adds only
# --dry-run and --work in front of the arguments it was given. The real
# tool knows cheetah and raven, so this is a cheetah-shaped tree, with a
# record that has every step before provisioning done.
C=$t/crepo
mkdir -p "$C/tools" "$C/device/cheetah" "$C/out" "$C/packages/omamobile-keyring" "$t/cimages" "$t/nv" "$t/home/.local/state/omamobile-install/cheetah"
cp "$R/tools/"* "$C/tools/"
descriptor | sed 's/^CODENAME=testdev$/CODENAME=cheetah/' > "$C/device/cheetah/device.conf"
cp "$t/images/"*.img "$t/cimages/"; echo cheetah > "$t/cimages/DEVICE"
cimg=$C/out/omamobile-rootfs-cheetah-2026.11.01-aarch64.img.zst
cp "$img" "$cimg"
(cd "$C/out" && sha256sum "$(basename "$cimg")" > "$(basename "$cimg").sha256")
printf 'version: 2026.11.01\ndevice: cheetah (omamobile-device-cheetah)\n' > "${cimg%.img.zst}.MANIFEST"
for p in persist modem_a modem_b efs efs_backup modem_userdata devinfo; do
  printf '%s  %s.img\n' "$(printf 'made up %s' "$p" | sha256sum | cut -d' ' -f1)" "$p"
done > "$t/nv/SHA256SUMS"
printf '#!/bin/bash\necho "FORBIDDEN ssh from the real phone-provision: $*" >> "$T/events"\nexit 1\n' > "$t/bin/no-ssh"
cat > "$t/bin/real-phone-provision" <<EOF
#!/bin/bash
printf '%s\\0' "\$@" > "\$T/pp-args"
echo "phone-provision \$*" >> "\$T/events"
PHONE_SSH="\$T/bin/no-ssh" exec bash "$SRC/tools/phone-provision" --dry-run --work "\$T/pp-work" "\$@"
EOF
chmod +x "$t/bin/no-ssh" "$t/bin/real-phone-provision"
fresh
cat > "$t/home/.local/state/omamobile-install/cheetah/state" <<EOF
format=1
codename=cheetah
release=development
started=2026-11-01T00:00Z
phone=$(printf %s FAKE123 | sha256sum | cut -d' ' -f1)
warning=acknowledged 2026-11-01T00:00Z for release development
factory=done
factory_build=AB1C.230101.001
factory_name=$zipname
factory_page=https://developers.google.com/android/images#cheetah
factory_size=3000
factory_sha256=$fsum
factory_zip=$t/factory.src
write=done
network=done (already working)
first_start=done
backup=done
backup_dir=$t/nv
EOF
rm "$t/ssh-down"
printf '' | env -u XDG_STATE_HOME -u XDG_CACHE_HOME -u OMAMOBILE_INDEX_URL HOME="$t/home" \
  PHONE_SSH="$t/bin/phone" NV_BACKUP="$t/bin/nv-backup" PHONE_PROVISION="$t/bin/real-phone-provision" \
  PHONE_SMOKE="$t/bin/phone-smoke" INSTALL_POLL=1 INSTALL_WAIT_RESTART=2 INSTALL_WAIT_SETTLE=2 \
  bash "$C/tools/install-guided" --device cheetah --images "$t/cimages" --work "$t/work" > "$t/out" 2>&1 ||
  fail "the real tools/phone-provision accepts the arguments the installer builds (its --dry-run)"
mapfile -d '' -t got < "$t/pp-args"
want=(-d cheetah --first-install --nv-backup "$t/nv" "$t/factory.src")
[[ ${#got[@]} == "${#want[@]}" && "${got[*]}" == "${want[*]}" ]] || { printf '%s\n' "${got[@]}" >&2; fail "the installer's phone-provision call is: ${want[*]}"; }
says "Checking the NV backup in $t/nv" && says "would write /var/lib/omamobile-vendor/modem/props.conf" && says "dry run: nothing was changed on the phone" ||
  fail "the real tool ran those arguments as a first install, to the end of its dry run"
[[ $(events FORBIDDEN) == 0 && $(grep -c '^phone-provision ' "$t/events") == 1 ]] || { grep FORBIDDEN "$t/events" >&2; fail "the real tool's dry run contacted no phone"; }
says "Your phone is ready" || fail "the install goes on after the real tool's dry run"
rm -rf "$t/pp-work"
pass "the real tools/phone-provision accepts exactly the arguments the installer builds, and runs them as a first install"

# --- A bundle: "install" beside device.conf and images/, the tools in tools/ ---------
