if bguided "$ALL"; then fail "an unsigned bundle is refused"; fi
says "didn't pass its checks" && [[ $(events '^fastboot') == 0 ]] || fail "an unsigned bundle: refused before the phone is contacted"
bguided "$ALL" --unsigned || fail "a development bundle installs with --unsigned"
once "from a bundle"
says "Omarchy Mobile 2026.11.01 for the Test Phone" && says "release 2026.11.01 (developer preview)" || fail "a bundle names its release"
bguided "" --unsigned && says "bash install --start-over" && ! says "tools/install-guided" || fail "in a bundle the command it names is the bundle's: bash install"
grep -c '^nv-backup [^-]' "$t/events" >/dev/null || fail "in a bundle nv-backup reads the bundle's own descriptor"
[[ $(record release) == 2026.11.01 ]] || fail "the record names the bundle's release"
echo tampered >> "$BD/factory-builds.json"
fresh
if bguided "$ALL" --unsigned; then fail "a bundle whose build index changed is refused"; fi
says "didn't pass its checks" || fail "the bundle's checksums cover its build index"
pass "a bundle: install at its top runs tools/install-phone, checked first; its build index is under its checksums"

# --- The script itself ------------------------------------------------------------------
code=$(grep -v '^[[:space:]]*#' tools/install-guided)
! grep -nE '"\$FASTBOOT"[^|]*(flash |--set-active|erase|format| -w|--slot| oem |reboot)' <<<"$code" || fail "install-guided sends no fastboot write, erase, slot change or reboot"
[[ $(grep -cE '"\$FASTBOOT" (devices|-s)' <<<"$code") == 3 && $(grep -c '"$FASTBOOT"' <<<"$code") == 4 ]] ||
  fail "three fastboot calls (devices, getvar all, flashing get_unlock_ability), and the check that it is installed"
[[ $(grep -cE '"\$FASTBOOT".* flashing ' <<<"$code") == 1 && $(grep -cE '"\$FASTBOOT" -s "\$serial" flashing get_unlock_ability' <<<"$code") == 1 ]] ||
  fail "the one flashing command is the read-only get_unlock_ability"
! grep -nE '(curl|wget)[^#]*(B\[url\]|dl\.google)' <<<"$code" || fail "nothing fetches from Google's download host"
[[ $(grep -c 'run_provision' <<<"$code") == 2 ]] || fail "one place knows phone-provision's command line, called once"
! grep -n 'Nothing is lost' <<<"$code" || fail "no stop carries a fixed reassurance"
# tools/release's identifier scan reads every file of a bundle, and takes a
# line with the serial's kernel parameter in plain text for a leaked serial
! grep -nE '(ro\.serialno|androidboot\.serialno)' tools/install-guided tools/camera-requirements.txt || fail "no file a bundle would ship trips the release's serial scan"
[[ $(grep -cE '^[[:space:]]*written_phone$' <<<"$code") == 6 ]] || fail "six places ask the phone which one it is: the first start, the backup, provisioning, the restart (before and after) and the check"
[[ $(grep -c -- '--serial "\$serial"' <<<"$code") == 1 && $(grep -c 'bash "\$INSTALL_PHONE"' <<<"$code") == 2 ]] ||
  fail "install-phone is run from two places: the file check, and the one that always hands it the phone's serial"
pass "install-guided: read-only fastboot only, no download of Google's image, one phone-provision call"

# What it shares with the other files stays the same as theirs
nm=$(sed -n '/^nmcli connection add/,/[^\\]$/p' docs/INSTALL.md | tr -d '\\\n' | tr -s ' ')
[[ $nm == "nmcli connection add "*cdc_ncm* ]] || fail "docs/INSTALL.md gives the connection's command"
fresh; guided "yes\n${OWNER}testdev\nno\n" || true
grep -cF -- "$nm" "$t/out" >/dev/null || fail "the connection is the one docs/INSTALL.md gives: $nm"
state=$(sed -n 's/^STATE=\$ROOT\(.*\)$/\1/p' packages/omamobile-firstboot/bin/omamobile-firstboot)
grep -cFx "FIRSTBOOT_DONE=$state/done" tools/install-guided >/dev/null || fail "the first start's marker is omamobile-firstboot's ($state/done)"
grep -cF '$HOME/.cache/omamobile-venv' tools/phone-provision >/dev/null && grep -cFx 'CAMERA_VENV=$HOME/.cache/omamobile-venv' tools/install-guided >/dev/null ||
  fail "the camera's Python folder is the one phone-provision looks in"
pass "the connection, the first start's marker and the camera folder agree with INSTALL.md, omamobile-firstboot and phone-provision"

# Every question the installer asks is in the design, word for word (up to
# the first value it fills in)
asked=0
while IFS= read -r q; do
  q=${q%%\$*}; q=${q%%[*}; q=${q%% (*}
  q=$(sed -E 's/^[[:space:]]+//; s/[: ]+$//' <<<"$q")
  grep -cF -- "$q" docs/INSTALL-GUIDED.md >/dev/null || fail "docs/INSTALL-GUIDED.md has the question: $q"
  asked=$((asked + 1))
done < <(sed -nE 's/^[[:space:]]*ask(_secret)? "(.*)"$/\2/p' tools/install-guided)
((asked >= 15)) || fail "the questions are found in the script ($asked)"
pass "all $asked questions are in docs/INSTALL-GUIDED.md"
