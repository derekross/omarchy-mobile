fresh; SLOTS=$'version-bootloader-a:testloader-1.0-111\nversion-bootloader-b:testloader-0.9-000' vars
if guided "$ALL"; then fail "an unlocked phone with two different bootloaders stops"; fi
says "on this phone they differ" && ! says "leave it locked" && ! says "user name on the phone" && [[ -z $(writes) ]] ||
  fail "different bootloaders on an unlocked phone: stopped before the owner's questions, with no word about the lock"
fresh; sed -i 's/^partition-size:dtbo_b:.*/partition-size:dtbo_b: 0x4/' "$t/vars"
if guided "$ALL"; then fail "an unlocked phone with a file that doesn't fit stops"; fi
says "This download doesn't fit this phone" && ! says "Google's factory image for this phone" && [[ -z $(writes) ]] ||
  fail "a file that doesn't fit: stopped at the phone step, before the factory image is asked for"
# An option with a value is given once, so the early check of slot B's
# files and install-phone read the same folder. Here the second folder's
# dtbo is too large for its partition: with two folders accepted, the early
# check read the first and install-phone would have written from the last
fresh; vars no; mkdir -p "$t/images2"; cp "$t/images/"* "$t/images2/"; head -c $((0x1000001)) /dev/zero > "$t/images2/dtbo.img"
if guided "yes\n\n" --images "$t/images2"; then fail "--images given twice is refused"; fi
says "--images is given twice: give it once" && ! says "fastboot flashing unlock" && [[ $(events '^fastboot') == 0 ]] ||
  fail "--images twice: refused before the phone is looked for, and no unlock step is shown"
if guided "yes\n\n" --bootloader-slots-match "$BL" --bootloader-slots-match other-1; then fail "--bootloader-slots-match given twice is refused"; fi
says "--bootloader-slots-match is given twice" || fail "two versions for the other slot: refused, since nobody can tell which was read"
INSTALLER_ARGS_ONLY=1 guided "yes\n\n" --device testdev --work "$t/work" --images "$t/images2" && fail "a locked phone stops the install" || true
says "This download doesn't fit this phone" && says "dtbo.img" && ! says "fastboot flashing unlock" ||
  fail "the one --images folder is the one the early fit check reads"
rm -rf "$t/images2"
# A locked phone that passes every check is shown the unlock steps, after
# the checks; and a dry run judges the same way
fresh; vars no
if guided "yes\n\n"; then fail "a locked phone stops the install"; fi
[[ $(grep -n "this phone's bootloader and baseband match Google's build" "$t/out" | head -1 | cut -d: -f1) -lt $(grep -n 'fastboot flashing unlock' "$t/out" | head -1 | cut -d: -f1) ]] ||
  fail "the build is found in the index before the unlock steps are shown"
! says "leave it locked" || fail "a locked phone that can be installed is not told to leave it locked"
fresh; vars no b
if guided "yes\n" --dry-run; then fail "a dry run stops for a locked phone on slot B"; fi
says "running from its second system copy (slot B)" && ! says "fastboot flashing unlock" && ! says "leave it locked" && [[ ! -e $STATE ]] ||
  fail "a dry run judges a locked phone before the unlock steps too, and records nothing"
vars; echo 1 > "$t/ability"
pass "a locked phone: every stop (model, phone, slots, a file's fit, the build index) comes before the unlock steps, which are then never shown"

# The install belongs to one phone: another one of the same model is refused
fresh; touch "$t/fail-flash"
if guided "$ALL"; then fail "a failed write stops the install"; fi
rm "$t/fail-flash"; echo OTHER999 > "$t/fb-devices"
if guided "${OWNER}testdev\n\n"; then fail "another phone can't go on with this phone's install"; fi
says "not the phone this install was started on" || fail "another phone: said plainly"
! grep -c 'fastboot -s OTHER999 flash' "$t/events" >/dev/null || fail "the other phone is never written"
# Two phones are in play, and the words keep them apart: the one connected
# was sent nothing; the one the install is for may be half-written and is
# the one to finish; --start-over forgets it
says "Nothing was written to the phone connected now" && says "The other phone, the one this install is for, was being written" &&
  says "It may be half-written" && says "That is the phone to finish" && says "hold the test keys for a while" ||
  fail "after a write that began, another phone in Fastboot Mode: which phone is half-written, and that it is the one to plug back in"
says "--start-over\" makes this computer forget that install" && says "half-written phone then stays as it is" && says "Use it only if" ||
  fail "--start-over is offered with what it forgets and when it is right"
! says "An earlier try began writing the phone" && ! says "Nothing has been written to the phone." && ! says "To write it again, whole" ||
  fail "the footer about \"the phone\" isn't used where two phones are in play"
[[ $(record write) == started && $(record phone) == "$(printf %s FAKE123 | sha256sum | cut -d' ' -f1)" ]] || fail "the record still names the half-written phone"
echo FAKE123 > "$t/fb-devices"
guided "${OWNER}testdev\n\n" || fail "with the half-written phone back, the install finishes it"
[[ $(grep -c 'fastboot -s FAKE123 flash userdata' "$t/events") == 2 ]] || fail "the half-written phone is written again, whole"
# Before any write the same stop says nothing was written to either phone
fresh
if guided "yes\n${OWNER}nottestdev\n"; then fail "setup: an install stopped before the write"; fi
echo OTHER999 > "$t/fb-devices"
if guided "${OWNER}testdev\n\n"; then fail "another phone can't take over an install that hasn't written yet"; fi
says "Nothing has been written to either phone" && says "start again for it (it forgets" && says "only how far the other install got):" && ! says "half-written" && [[ -z $(writes) ]] ||
  fail "before the write, another phone: nothing written to either, and --start-over explained"
pass "the record is pinned to the phone it was started on, and the stop says which of the two phones is which"

# Only the phone that step 2 looked at is written. The fake fastboot swaps
# the phone after its Nth "devices": the installer looks (1), checks before
# the dry run (2), install-phone's dry run looks (3), the installer checks
# before the write (4), install-phone looks (5).
fresh; echo 1 > "$t/swap-after"
if guided "$ALL"; then fail "a phone swapped before the dry run stops the install"; fi
says "no longer the only one connected in Fastboot Mode" && [[ $(cat "$t/fb-count") == 2 ]] || fail "the installer's own check before the dry run catches the swap (install-phone isn't started)"
fresh; echo 2 > "$t/swap-after"
if guided "$ALL"; then fail "a phone swapped during the dry run's file checks stops the install"; fi
says "The dry run stopped" && says "not the one this install was started for" && [[ $(cat "$t/fb-count") == 3 && -z $(record write) ]] ||
  fail "install-phone's dry run, handed the serial, refuses the other phone"
fresh; echo 3 > "$t/swap-after"
if guided "$ALL"; then fail "a phone swapped after the dry run stops the install"; fi
says "no longer the only one connected in Fastboot Mode" && [[ $(cat "$t/fb-count") == 4 && -z $(record write) ]] ||
  fail "the installer's own check before the write catches the swap, with nothing recorded as started"
fresh; echo 4 > "$t/swap-after"
if guided "$ALL"; then fail "a phone swapped during the write's file checks stops the install"; fi
says "not the one this install was started for" && [[ $(cat "$t/fb-count") == 5 && $(record write) == started ]] || fail "install-phone, handed the serial, refuses the other phone"
for n in 1 2 3 4; do
  fresh; echo $n > "$t/swap-after"; guided "$ALL" || true
  [[ -z $(writes) && $(events 'fastboot -s OTHER999') == 0 ]] || { grep OTHER999 "$t/events" >&2; fail "a phone swapped in after look $n is never written, or asked anything"; }
done
pass "only the phone that was looked at is written: both of the installer's checks and install-phone's --serial each stop a swap"

# --- The warning ----------------------------------------------------------------
fresh
if guided "\n"; then fail "the warning must be accepted"; fi
says "The phone is erased" && says "replaces Android" && says "You can go back" && says "https://omamobile.org/devices/testdev" ||
  fail "the warning names the wipe, the new system and the way back"
[[ -z $(record warning) && -z $(writes) ]] || fail "a warning that wasn't accepted is not recorded, and nothing is written"
if guided "no\n"; then fail "'no' is not acceptance"; fi
guided "$ALL" || fail "the install goes on once the warning is accepted"
[[ $(grep -c 'Type yes to go on' "$t/out") == 1 ]] || fail "the warning is asked once"
[[ $(grep -n 'Step 2 of 11: Read this first' "$t/out" | cut -d: -f1) -lt $(grep -n 'Step 3 of 11: Finding the phone' "$t/out" | cut -d: -f1) ]] ||
  fail "the warning is step 2, before the phone is looked for"
[[ $(grep -n 'Type yes to go on' "$t/out" | cut -d: -f1) -lt $(grep -n 'would run: fastboot' "$t/out" | head -1 | cut -d: -f1) ]] ||
  fail "the warning comes before the dry run and the writes"
once "after the warning"
# A record from before the order changed (the phone found, the warning not
# yet shown), or one whose warning entry isn't an acknowledgement: the
# warning is shown, and nothing goes on without it
for old in "phone=$(printf %s FAKE123 | sha256sum | cut -d' ' -f1)" "warning=shown"; do
  fresh; mkdir -p "$STATE"
  printf 'format=1\ncodename=testdev\nrelease=development\nstarted=2026-11-01T00:00Z\n%s\n' "$old" > "$STATE/state"
  if guided "\n"; then fail "an older record can't skip the warning ($old)"; fi
  says "Type yes to go on" && says "Not accepted" && [[ $(events '^fastboot') == 0 && -z $(writes) ]] || fail "an older record ($old): the warning is shown first, and nothing happens without it"
  guided "$ALL" || fail "an older record goes on once the warning is accepted"
  [[ $(record warning) == "acknowledged "* ]] || fail "the acknowledgement is recorded in an older record"
done
pass "the warning: step 2, before the phone and any write, accepted with 'yes' only, recorded once; an older record can't skip it"

# --- The build index and the factory image ----------------------------------------
fresh; rm "$t/home/Downloads/$zipname"
head -c 3000 /dev/zero > "$t/home/Downloads/wrong.zip"       # the right size, other bytes
head -c 100 "$t/factory.src" > "$t/home/Downloads/partial.zip"
cp "$t/factory.src" "$t/elsewhere.zip"
if guided "yes\n\n\n\n$t/home/Downloads/partial.zip\n$t/home/Downloads/wrong.zip\n"; then fail "no factory image, no install"; fi
[[ $(events '^xdg-open https://developers.google.com/android/images#testdev$') == 1 ]] || fail "Google's page is opened, once, after Enter"
says "Accept Google's terms" && says "build AB1C.230101.001" && says "$zipname" || fail "it says what to do on Google's page: the terms, the build, the file"
says "isn't in $t/home/Downloads yet" && says "the download isn't complete" && says "is not the file Google publishes" ||
  fail "a missing, a partial and a wrong file are each refused, with the reason"
[[ -z $(record factory) && -z $(writes) ]] || fail "without the right file nothing is recorded or written"
[[ $(events 'dl.google.com') == 0 && $(events 'FORBIDDEN') == 0 ]] || fail "with Google's terms not accepted, the installer downloads nothing"
says "Not accepted, so the installer downloads nothing." && [[ -z $(record factory_terms) ]] || fail "Enter at the terms: said plainly, and no acceptance recorded"
guided "\n\n$t/elsewhere.zip\n${OWNER}testdev\n\n" || fail "the install goes on with the right file, typed"
[[ $(grep -c "Type yes to accept Google's terms" "$t/out") == 1 ]] || fail "terms that weren't accepted are shown again on the next run"
[[ $(record factory_from) == "a file saved by the owner" ]] || fail "the record says the file is one the owner saved"
! says "Type yes to go on" || fail "the warning isn't asked again"
[[ $(record factory_zip) == "$t/elsewhere.zip" && $(record factory_sha256) == "$fsum" && $(record factory_build) == AB1C.230101.001 ]] || fail "the file, its SHA-256 and the build are recorded"
once "after the factory image"
pass "the factory image without accepting the terms: Google's page opened, the saved file taken, refused unless size and SHA-256 match; resumes"

# --- The factory image, downloaded by the installer -------------------------------------
# Decided 2026-11-12 (plan D2): the installer downloads Google's factory
# image for the owner, from Google's own server, after showing Google's
# terms. "Google's server" here is the stand-in on this computer; nothing
# in this suite can reach Google (the curl stand-in refuses).
mkdir -p "$t/dl"
python3 -I "$t/dl-server.py" "$t/dl" >/dev/null 2>"$t/dl/err" &
echo $! > "$t/dl/pid"
for _ in $(seq 100); do [[ -s $t/dl/port ]] && break; sleep 0.1; done
[[ -s $t/dl/port ]] || fail "the stand-in for Google's server starts"
# nofile: a fresh install with no factory image on this computer, and the
# stand-in server answering for Google's
nofile() { fresh; rm "$t/home/Downloads/$zipname"; touch "$t/dl/on"; }
dl_calls() { events '^curl .*https://dl\.google\.com/'; }
KEPT=$t/work/factory/$zipname
URL=https://dl.google.com/dl/android/aosp/$zipname

nofile
guided "yes\nyes\n${OWNER}testdev\n\n" || fail "an install that downloads the factory image succeeds"
# Google's own sentences, as Google's, each with its address
says "\"Downloading of the system image and use of the device software is subject" && says "to the Google Terms of Service\"" && says "https://policies.google.com/terms" &&
  says "\"By continuing, you agree to the Google Terms of Service and Privacy Policy\"" && says "https://policies.google.com/privacy" &&
  says "\"may also be subject to certain third-party" && says "terms of service, which can be found in Settings > About phone > Legal" && says "information\"" && says "Google says:" ||
  fail "the terms step quotes Google's three sentences, with Google's addresses"
says "In our own words: Google's page says these files are for use only on your own" && says "Pixel and may not be redistributed." &&
  says "from Google to this computer, for this phone. Omarchy Mobile does not host" && says "Google's files and does not pass them on." ||
  fail "the terms step says in our own words what Google's page asks, and that the project hosts and passes on nothing"
says "https://developers.google.com/android/images#testdev" && says "$URL" && says "The file: $zipname" || fail "the terms step shows Google's page for the build, the file and where it comes from"
[[ $(grep -n "Type yes to accept Google's terms and download the file" "$t/out" | cut -d: -f1) -lt $(grep -n "downloading $zipname from Google" "$t/out" | cut -d: -f1) ]] ||
  fail "the terms are shown and accepted before the download starts"
[[ $(dl_calls) == 1 ]] && grep -cFx "GET /dl/android/aosp/$zipname range=" "$t/dl/log" >/dev/null || fail "one request, for the address the index names"
grep -c "^curl .*--max-redirs 0 .*--proto =https .*--proto-redir =https .*--max-filesize 3000 .* $URL\$" "$t/events" >/dev/null ||
  { grep '^curl' "$t/events" >&2; fail "the download follows no redirect by itself, is https only, and is told the file's size"; }
[[ -f $KEPT && ! -e $KEPT.part ]] && cmp -s "$KEPT" "$t/factory.src" || fail "the file is kept under the work directory, whole"
[[ $(stat -c %a "$KEPT") == 600 && $(stat -c %a "$t/work/factory") == 700 ]] || fail "the downloaded file is the owner's alone (600, in a 700 folder)"
[[ $(record factory_zip) == "$KEPT" && $(record factory_from) == "downloaded from Google by the installer" && $(record factory_sha256) == "$fsum" ]] || fail "the record names the downloaded file"
[[ $(record factory_terms) =~ ^accepted\ 20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}Z\ for\ build\ AB1C\.230101\.001$ ]] || fail "the acceptance is recorded with the time and the build: $(record factory_terms)"
[[ $(events '^xdg-open') == 0 ]] || fail "no page is opened when the installer downloads the file"
grep -cFx "phone-provision -d testdev --first-install --nv-backup $(record backup_dir) $KEPT" "$t/events" >/dev/null || fail "the firmware comes from the downloaded file"
once "with the factory image downloaded"
pass "the factory image downloaded: Google's terms shown and accepted first, one https request to the index's address, the file checked, kept private and recorded"

# Only a typed "yes" accepts: anything else is the owner's own download, never ours
for answer in y Yes YES "yes please" no accept; do
  nofile
  if guided "yes\n$answer\n"; then fail "'$answer' at the terms doesn't go on by itself"; fi
  says "Not accepted, so the installer downloads nothing." && says "Press Enter to open Google's page" || fail "'$answer' at the terms: not accepted, and the owner's own download is offered"
  [[ $(dl_calls) == 0 && -z $(record factory_terms) && ! -e $t/work/factory ]] || fail "'$answer' at the terms: nothing downloaded, nothing recorded as accepted"
done
pass "the terms: only 'yes' accepts; anything else downloads nothing and falls back to Google's page"

# A dry run downloads nothing, and says what the install would download
nofile
guided "yes\n${OWNER}" --dry-run || fail "a dry run without the factory image succeeds"
says "a dry run downloads nothing and opens no page" && says "once you accept them, download $zipname" && says "(3000 bytes, about 0 GB) from $URL" ||
  fail "a dry run says what it would download, its size and from where"
! says "Type yes to accept Google's terms" && [[ $(dl_calls) == 0 && $(events '^xdg-open') == 0 && ! -e $t/work/factory && ! -e $STATE ]] ||
  fail "a dry run asks no terms, downloads nothing, opens nothing and records nothing"
pass "dry run: no terms, no download, and what the install would download"

# A wrong file: removed, and the install stops
nofile; head -c 3000 /dev/zero > "$t/wrong.bin"; echo "$t/wrong.bin" > "$t/dl/body"
if guided "yes\nyes\n$REST"; then fail "a download whose SHA-256 differs stops the install"; fi
says "The file downloaded from Google is not the file the list names for build" && says "AB1C.230101.001: its SHA-256 differs." && says "expected:   $fsum" &&
  says "downloaded: $(sha256sum < "$t/wrong.bin" | cut -d' ' -f1)" && says "It has been removed, and nothing of it was used." || fail "a wrong download: said plainly, with both digests"
[[ ! -e $KEPT && ! -e $KEPT.part && -z $(record factory) && -z $(writes) ]] && ! says "user name on the phone" && ! says "Press Enter to open Google's page" ||
  fail "a wrong download is removed, and nothing goes on: no record, no question, no write"
echo "$t/factory.src" > "$t/dl/body"
guided "$REST" || fail "the next run downloads again and goes on"
! says "Type yes to accept Google's terms" && says "Google's terms for this download were accepted earlier" || fail "terms accepted once are not asked again for the same build"
once "after a wrong download"
pass "a download with another SHA-256 is removed and stops the install; the terms are asked once"

# More than the index's size: reading stops, whatever the server says
nofile; head -c 5000 /dev/zero > "$t/big.bin"; echo "$t/big.bin" > "$t/dl/body"
if guided "yes\nyes\n$REST"; then fail "a larger file than the list names stops the install"; fi
says "Google's server offered more than the 3000 bytes the list names for" && says "stopped reading and removed" || fail "a larger file: said plainly"
[[ ! -e $KEPT && ! -e $KEPT.part && -z $(record factory) && -z $(writes) ]] || fail "a larger file: nothing kept, recorded or written"
nofile; head -c $((64 << 20)) /dev/zero > "$t/big.bin"; echo "$t/big.bin" > "$t/dl/body"; touch "$t/dl/nolength"
if guided "yes\nyes\n$REST"; then fail "a body with no stated length that runs past the size stops the install"; fi
says "Google's server offered more than the 3000 bytes" && [[ ! -e $KEPT && ! -e $KEPT.part && -z $(record factory) ]] || fail "an unannounced larger body: stopped, nothing kept"
for _ in $(seq 50); do grep -c '^sent ' "$t/dl/log" >/dev/null && break; sleep 0.1; done
sent=$(sed -n 's/^sent \([0-9]*\) of .*/\1/p' "$t/dl/log" | tail -1)
[[ -n $sent ]] && ((sent < 64 << 20)) || fail "the installer stops reading past the size: the server got rid of $sent of $((64 << 20)) bytes"
# The same with a curl that doesn't stop by itself: the installer's own cap
# (one byte past what is missing) ends the reading
nofile; touch "$t/dl/nolength" "$t/dl/old-curl"; echo "$t/big.bin" > "$t/dl/body"
if guided "yes\nyes\n$REST"; then fail "a body that runs past the size stops the install, also when curl doesn't stop it"; fi
says "Google's server offered more than the 3000 bytes" && [[ ! -e $KEPT && ! -e $KEPT.part && -z $(record factory) ]] || fail "past the size with a curl that reads on: stopped by the installer, nothing kept"
for _ in $(seq 50); do grep -c '^sent ' "$t/dl/log" >/dev/null && break; sleep 0.1; done
sent=$(sed -n 's/^sent \([0-9]*\) of .*/\1/p' "$t/dl/log" | tail -1)
[[ -n $sent ]] && ((sent < 64 << 20)) || fail "the installer's own cap stops the reading: the server got rid of $sent of $((64 << 20)) bytes"
rm -f "$t/big.bin"
pass "a body larger than the index's size is not read to its end, and nothing of it is kept"

# A redirect is never followed by curl. One that leaves Google's host, or
# https, is refused; nothing is asked of the other address
for to in "https://example.org/dl/$zipname" "http://dl.google.com/dl/$zipname" "https://dl.google.com.example.org/$zipname" "https://dl.google.com:8443/$zipname" \
  "https://dl.google.com@example.org/$zipname" "//example.org/$zipname" "http://localhost:PORT/moved/$zipname"; do
  nofile; echo "$to" > "$t/dl/redirect"
  if guided "yes\nyes\n"; then fail "a redirect to $to doesn't go on by itself"; fi
  says "Google's server sent the download on to another address, and the installer only" && says "downloads from https://dl.google.com/: ${to/PORT/$(cat "$t/dl/port")}" && says "Nothing was fetched from there." ||
    fail "a redirect to $to: refused, and the address is named"
  [[ $(grep -c '^curl ' "$t/events") == 2 && $(dl_calls) == 1 && $(events FORBIDDEN) == 0 ]] || { grep '^curl' "$t/events" >&2; fail "a redirect to $to: one request to Google's host and none anywhere else"; }
  [[ $(grep -c '^GET ' "$t/dl/log") == 1 ]] || fail "a redirect to $to: the stand-in saw one request"
  [[ ! -e $KEPT && $(stat -c %s "$KEPT.part") == 0 ]] || fail "a redirect to $to: the redirect's own body is not kept"
  says "The installer could not download the file (above). You can get it yourself" && says "Press Enter to open Google's page" || fail "a redirect to $to: the owner's own download is offered"
done
# One that stays on https://dl.google.com/ is followed, by the installer, one step at a time
for to in "/moved/$zipname" "http://127.0.0.1:PORT/moved/deeper/$zipname?from=test"; do   # the second reaches the installer as https://dl.google.com/moved/...
  nofile; echo "$to" > "$t/dl/redirect"
  guided "yes\nyes\n${OWNER}testdev\n\n" || fail "a redirect within Google's host ($to) is followed"
  [[ $(dl_calls) == 2 ]] && grep -c "^curl .* https://dl\.google\.com/moved/" "$t/events" >/dev/null && cmp -s "$KEPT" "$t/factory.src" || fail "a redirect within Google's host: a second request, to the new address on the same host"
done
pass "redirects: curl follows none; another host, another port, plain http and a look-alike host are refused unasked; one within https://dl.google.com/ is followed"

# An interrupted download goes on from where it stopped on the next run,
# and the whole file is still hashed from its first byte
nofile; echo 1000 > "$t/dl/cut"
if guided "yes\nyes\n"; then fail "an interrupted download doesn't go on by itself"; fi
says "The download stopped before the end" && says "1000 of 3000 bytes are here." && says "They are kept, and running this command again goes on from there." &&
  says "The installer could not download the file (above). You can get it yourself" || fail "an interrupted download: said plainly, with both ways on"
[[ $(stat -c %s "$KEPT.part") == 1000 && $(stat -c %a "$KEPT.part") == 600 && ! -e $KEPT && -z $(record factory) && -n $(record factory_terms) ]] ||
  fail "an interrupted download: the part is kept, private, and nothing is recorded as taken"
guided "${OWNER}testdev\n\n" || fail "the next run goes on with the download and finishes"
says "going on with the download where it stopped: 1000 of 3000 bytes are here" && ! says "Type yes to accept Google's terms" || fail "the next run says it goes on, and asks no terms again"
grep -cFx "GET /dl/android/aosp/$zipname range=bytes=1000-" "$t/dl/log" >/dev/null && [[ $(grep -c '^GET ' "$t/dl/log") == 2 ]] || { cat "$t/dl/log" >&2; fail "the second request asks for the rest only"; }
cmp -s "$KEPT" "$t/factory.src" && [[ ! -e $KEPT.part ]] || fail "the two parts make the whole file"
once "after an interrupted download"
nofile; echo 1000 > "$t/dl/cut"
if guided "yes\nyes\n"; then fail "an interrupted download doesn't go on by itself"; fi
python3 -I -c 'import sys; f = open(sys.argv[1], "r+b"); b = f.read(1); f.seek(0); f.write(bytes([b[0] ^ 255]))' "$KEPT.part"   # the first byte, changed between the runs
if guided "$REST"; then fail "a resumed download whose first part changed stops the install"; fi
grep -cFx "GET /dl/android/aosp/$zipname range=bytes=1000-" "$t/dl/log" >/dev/null && says "its SHA-256 differs" && says "It has been removed" && [[ ! -e $KEPT && ! -e $KEPT.part && -z $(record factory) && -z $(writes) ]] ||
  fail "a resumed download is hashed from its first byte: a changed first part is caught, and the file removed"
# A server that won't resume: the part is dropped, and the next run starts over
nofile; echo 1000 > "$t/dl/cut"
if guided "yes\nyes\n"; then fail "an interrupted download doesn't go on by itself"; fi
touch "$t/dl/norange"
