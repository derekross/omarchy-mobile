guided "${OWNER}testdev\n" || fail "the install goes on once the other phone is unplugged"
ADDS=0 once "after unplugging the other phone"
pass "another phone answering at the USB address stops the install before anything is written"

fresh; touch "$t/no-firstboot"
if guided "$ALL"; then fail "a first start that doesn't finish stops the install"; fi
says "hasn't finished its first start" && says "hold the other test key" || fail "a first start that doesn't finish: said plainly, with the descriptor's keys"
[[ $(events '^nv-backup') == 0 ]] || fail "no backup before the first start has finished"
touch "$t/firstboot-done"
guided "" || fail "the install goes on once the first start has finished"
once "after the first start"
pass "resume: waits for the first start, and goes on from there"

# The limit is time on the clock, not passes of the loop. Each SSH call of
# this stand-in takes 3 s, as a connection that times out does; with a 4 s
# limit the wait ends after its first look (two calls, 6 s). Counted in
# passes of "poll + 1" it took three looks.
fresh; touch "$t/no-firstboot" "$t/keep-ssh-down"; echo omamobile-phone > "$t/nm-profiles"; echo 3 > "$t/ssh-slow"
if WAIT_FIRST=4 guided "$ALL"; then fail "a first start that doesn't finish stops the install, with a slow SSH too"; fi
