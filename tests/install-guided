# --- After the write, every step is for the phone that was written -------------------
# The review's case: an install that stopped at the backup, a record left
# behind, and a different phone on the cable when it is run again. That
# phone is asked which one it is and nothing else.
other_phone() {  # other_phone WHAT: a rerun with another phone answering over USB changes nothing
  local before
  ssh_phone OTHER999
  before=$(grep -cE '^(nv-backup|phone-provision|phone RESTART|phone-smoke)' "$t/events" || true)
  if guided ""; then fail "$1: another phone can't go on with this phone's install"; fi
  says "is not the phone this install" && says "nothing was copied" || fail "$1: another phone is said plainly"
  [[ $(grep -cE '^(nv-backup|phone-provision|phone RESTART|phone-smoke)' "$t/events" || true) == "$before" ]] ||
    { tail -5 "$t/events" >&2; fail "$1: nothing is copied from, put on or restarted on the other phone"; }
  ! says "Your phone is ready" && [[ -z $(record finished) ]] || fail "$1: the install doesn't finish on another phone"
  ssh_phone FAKE123
}
fresh; touch "$t/fail-backup"
if guided "$ALL"; then fail "setup: an install stopped at the backup"; fi
rm "$t/fail-backup"
other_phone "at the backup"
[[ -z $(record backup) && -z $(record backup_dir) ]] || fail "no backup is recorded from the other phone"
guided "" || fail "with the right phone back, the install goes on"
BACKUPS=2 once "after another phone at the backup"

fresh; touch "$t/no-firstboot"
if guided "$ALL"; then fail "setup: an install stopped at the first start"; fi
touch "$t/firstboot-done"
other_phone "at the first start"
[[ -z $(record first_start) ]] || fail "another phone's finished first start isn't taken for this phone's"
