# --- A missing program stops the install before the phone is touched -----------------
# The same PATH without the stand-ins for the extract tools' programs, and
# without this computer's own copies of them
mkdir -p "$t/sys"
IFS=: read -ra dirs <<<"$BASE_PATH"
for d in "${dirs[@]}"; do
  for f in "$d"/*; do [[ -e $t/sys/${f##*/} || ! -x $f ]] || ln -s "$f" "$t/sys/${f##*/}"; done
done
printf 'NAME="Arch Linux"\nID=arch\n' > "$t/os-arch"
printf 'NAME="Ubuntu"\nID=ubuntu\nID_LIKE=debian\n' > "$t/os-ubuntu"
printf 'NAME="Other"\nID=other\n' > "$t/os-other"
# missing ARCH-PACKAGE DEBIAN-PACKAGE (Debian's "-": none we know of)
for spec in "lpunpack android-tools -" "simg2img android-tools android-sdk-libsparse-utils" "fsck.erofs erofs-utils erofs-utils" "readelf binutils binutils"; do
  read -r missing arch deb <<<"$spec"
  rm -f "$t/sys/lpunpack" "$t/sys/simg2img" "$t/sys/fsck.erofs" "$t/sys/readelf" "$t/sys/llvm-readelf"
  mkdir -p "$t/extract-some"; rm -f "$t/extract-some/"*
  for c in lpunpack simg2img fsck.erofs readelf; do [[ $c == "$missing" ]] || cp "$t/extract-bin/$c" "$t/extract-some/"; done
  for os in arch ubuntu other; do
    fresh
    if OS_RELEASE=$t/os-$os PATH="$t/bin:$t/extract-some:$t/sys" guided "$ALL"; then fail "an install without $missing is stopped"; fi
    says "These programs are missing on this computer: $missing" || fail "a missing $missing is named"
    debcol=$deb; [[ $deb != - ]] || debcol="(none we know of)"
    grep -E "^ +$missing +$arch +" "$t/out" | grep -cF -- " $debcol" >/dev/null || fail "a missing $missing: its packages on Arch ($arch) and on Debian and Ubuntu ($deb) in the table"
    case $os in
      arch) says "    sudo pacman -S --needed $arch" || fail "on Arch, the one command that installs $missing" ;;
      ubuntu)
        if [[ $deb == - ]]; then
          says "We know of no Debian or Ubuntu package with $missing" && ! says "sudo apt install" || fail "on Ubuntu, $missing: no package is made up"
        else
          says "    sudo apt install $deb" || fail "on Ubuntu, the one command that installs $missing"
        fi ;;
      other) says "with your system's package manager" && ! says "sudo pacman" && ! says "sudo apt" || fail "another system: no command for a package manager it may not have" ;;
    esac
    [[ $(events '^fastboot') == 0 && -z $(writes) ]] || fail "a missing $missing stops the install before the phone is contacted"
    [[ $(tail -n 1 "$t/out") == "        tools/install-guided "* ]] || fail "a missing $missing: the stop ends with the command to run once it is installed"
  done
done
pass "a program a later step needs (lpunpack, simg2img, fsck.erofs, readelf) stops the install at step 1, named with its package on Arch and on Debian and Ubuntu, and the one install command for this system"

# --- The real tools/phone-provision takes what the installer hands it ---------------
# Everywhere above phone-provision is a stub, and a stub accepts anything:
# an option the real tool doesn't have would pass every test and fail on
# the first phone, after it was erased. So the installer's own call is run
# against the real tool once, in --dry-run and with an SSH that fails the
# test if it is called: PHONE_PROVISION is a wrapper that adds only
# --dry-run and --work in front of the arguments it was given. The real
# tool knows cheetah and raven, so this is a cheetah-shaped tree, with a
# record that has every step before provisioning done.
C=$t/crepo
mkdir -p "$C/tools" "$C/device/cheetah" "$C/out" "$C/packages/omamobile-keyring" "$t/cimages" "$t/nv" "$t/home/.local/state/omamobile-install/cheetah"
cp "$R/tools/"* "$C/tools/"
descriptor | sed 's/^CODENAME=testdev$/CODENAME=cheetah/' > "$C/device/cheetah/device.conf"
cp "$t/images/"*.img "$t/cimages/"; echo cheetah > "$t/cimages/DEVICE"
cimg=$C/out/omamobile-rootfs-cheetah-2026.11.01-aarch64.img.zst
cp "$img" "$cimg"
(cd "$C/out" && sha256sum "$(basename "$cimg")" > "$(basename "$cimg").sha256")
printf 'version: 2026.11.01\ndevice: cheetah (omamobile-device-cheetah)\n' > "${cimg%.img.zst}.MANIFEST"
for p in persist modem_a modem_b efs efs_backup modem_userdata devinfo; do
  printf '%s  %s.img\n' "$(printf 'made up %s' "$p" | sha256sum | cut -d' ' -f1)" "$p"
done > "$t/nv/SHA256SUMS"
printf '#!/bin/bash\necho "FORBIDDEN ssh from the real phone-provision: $*" >> "$T/events"\nexit 1\n' > "$t/bin/no-ssh"
cat > "$t/bin/real-phone-provision" <<EOF
#!/bin/bash
printf '%s\\0' "\$@" > "\$T/pp-args"
echo "phone-provision \$*" >> "\$T/events"
PHONE_SSH="\$T/bin/no-ssh" exec bash "$SRC/tools/phone-provision" --dry-run --work "\$T/pp-work" "\$@"
EOF
chmod +x "$t/bin/no-ssh" "$t/bin/real-phone-provision"
fresh
cat > "$t/home/.local/state/omamobile-install/cheetah/state" <<EOF
format=1
codename=cheetah
release=development
started=2026-11-01T00:00Z
phone=$(printf %s FAKE123 | sha256sum | cut -d' ' -f1)
warning=acknowledged 2026-11-01T00:00Z for release development
factory=done
factory_build=AB1C.230101.001
factory_name=$zipname
factory_page=https://developers.google.com/android/images#cheetah
factory_size=3000
factory_sha256=$fsum
factory_zip=$t/factory.src
write=done
network=done (already working)
first_start=done
backup=done
backup_dir=$t/nv
EOF
rm "$t/ssh-down"
printf '' | env -u XDG_STATE_HOME -u XDG_CACHE_HOME -u OMAMOBILE_INDEX_URL HOME="$t/home" \
  PHONE_SSH="$t/bin/phone" NV_BACKUP="$t/bin/nv-backup" PHONE_PROVISION="$t/bin/real-phone-provision" \
  PHONE_SMOKE="$t/bin/phone-smoke" INSTALL_POLL=1 INSTALL_WAIT_RESTART=2 INSTALL_WAIT_SETTLE=2 \
  bash "$C/tools/install-guided" --device cheetah --images "$t/cimages" --work "$t/work" > "$t/out" 2>&1 ||
  fail "the real tools/phone-provision accepts the arguments the installer builds (its --dry-run)"
mapfile -d '' -t got < "$t/pp-args"
want=(-d cheetah --first-install --nv-backup "$t/nv" "$t/factory.src")
[[ ${#got[@]} == "${#want[@]}" && "${got[*]}" == "${want[*]}" ]] || { printf '%s\n' "${got[@]}" >&2; fail "the installer's phone-provision call is: ${want[*]}"; }
says "Checking the NV backup in $t/nv" && says "would write /var/lib/omamobile-vendor/modem/props.conf" && says "dry run: nothing was changed on the phone" ||
  fail "the real tool ran those arguments as a first install, to the end of its dry run"
[[ $(events FORBIDDEN) == 0 && $(grep -c '^phone-provision ' "$t/events") == 1 ]] || { grep FORBIDDEN "$t/events" >&2; fail "the real tool's dry run contacted no phone"; }
says "Your phone is ready" || fail "the install goes on after the real tool's dry run"
rm -rf "$t/pp-work"
pass "the real tools/phone-provision accepts exactly the arguments the installer builds, and runs them as a first install"

# --- A release bundle, as tools/make-bundle makes it -----------------------------------
# The real make-bundle builds and signs it, with a key of the test's own that
# this copy of install-phone pins (as a release pins the release key); its
# one-file download is unpacked as a user unpacks it, and the install runs
# as a new user runs it: "bash install --guided" in the bundle's folder,
# with no option at all (the stand-ins are environment seams only)
M=$t/mrepo MK=$t/mkernel MG=$t/mrepo/keys/gnupg.release
mkdir -p "$M/tools/lib" "$M/docs" "$M/device/testdev" "$M/packages/omamobile-keyring" "$M/out" "$MK/include/config" "$MK/images"
mkdir -p -m 700 "$MG"
cp "$SRC/tools/make-bundle" "$SRC/tools/bundle-manifest" "$SRC/tools/install-phone" "$M/tools/"
cp "$SRC/tools/lib/signing.sh" "$SRC/tools/lib/bundle-tar.sh" "$M/tools/lib/"
ptools=$(sed -n 's/^provision_tools="\(.*\)"$/\1/p' "$SRC/tools/make-bundle")
for f in install-guided phone-smoke factory-index camera-requirements.txt; do
  [[ " $ptools " == *" $f "* ]] || fail "make-bundle ships tools/$f, which the guided install needs"
done
for f in $ptools; do cp "$SRC/tools/$f" "$M/tools/"; done
cp "$SRC/docs/INSTALL.md" "$M/docs/"
descriptor > "$M/device/testdev/device.conf"
index 2026-11-01 > "$M/device/testdev/factory-builds.json"
gpg --homedir "$MG" -q --batch --passphrase '' --quick-gen-key 'Test Release Key <test@example.org>' ed25519 sign never 2>/dev/null
mfpr=$(gpg --homedir "$MG" --with-colons --list-keys 2>/dev/null | awk -F: '$1 == "fpr" { print $10; exit }')
echo "$mfpr" > "$M/keys/fingerprint.release"
gpg --homedir "$MG" -q --batch --export > "$M/packages/omamobile-keyring/omamobile.gpg"
echo "$mfpr:4:" > "$M/packages/omamobile-keyring/omamobile-trusted"
: > "$M/packages/omamobile-keyring/omamobile-revoked"
sed -i "s/^SIGNING_KEYS=.*/SIGNING_KEYS='$mfpr'/" "$M/tools/install-phone"
git -C "$M" init -q && git -C "$M" -c user.name=t -c user.email=t@example.invalid commit -q --allow-empty -m init
echo 7.3.0-test-1 > "$MK/include/config/kernel.release"
cp "$t/rd.lz4" "$MK/initramfs.cpio.lz4"
touch -d '2001-01-01' "$MK/initramfs.cpio.lz4"
cp "$t/images/"*.img "$MK/images/"
echo testdev > "$MK/images/DEVICE"
mroot=$M/out/omamobile-rootfs-testdev-2026.11.01-aarch64.img.zst
cp "$img" "$mroot"
(cd "$M/out" && sha256sum "${mroot##*/}" > "${mroot##*/}.sha256")
printf 'version: 2026.11.01\ndevice: testdev (omamobile-device-testdev)\nomamobile channel: stable\n' > "${mroot%.img.zst}.MANIFEST"
(cd "$M" && DEVICE=testdev KERNEL_OUT=$MK KERNEL_DIR=$M tools/make-bundle --version 2026.11.01 --rootfs "$mroot") > "$t/mb.out" 2>&1 ||
  { cat "$t/mb.out" >&2; fail "make-bundle builds and signs the bundle"; }
gpgconf --homedir "$MG" --kill gpg-agent 2>/dev/null || true
U=$t/download
mkdir -p "$U"
tar -C "$U" -xf "$M/out/bundle/omamobile-testdev-2026.11.01.tar"
BD=$U/omamobile-testdev-2026.11.01
[[ -f $BD/SHA256SUMS.sig && -f $BD/tools/install-guided && -f $U/${mroot##*/} ]] || fail "the unpacked download: the signed bundle and the root image beside it"
[[ ! -e $BD/images/DEVICE ]] || fail "a bundle's images/ has no DEVICE file: its device is its signed device.conf"
for f in install-guided phone-smoke factory-index camera-requirements.txt; do
  [[ $(grep -cE "^[0-9a-f]{64}  tools/$f\$" "$BD/SHA256SUMS") == 1 ]] || fail "the signed SHA256SUMS covers tools/$f"
done
# bguided ANSWERS [ARGS]: in the bundle's folder, as a user runs it
bguided() {
  local answers=$1; shift
  printf '%b' "$answers" | (cd "$BD" && env -u XDG_STATE_HOME -u XDG_CACHE_HOME -u OMAMOBILE_INDEX_URL HOME="$t/home" \
    PHONE_SSH="$t/bin/phone" NV_BACKUP="$t/bin/nv-backup" PHONE_PROVISION="$t/bin/phone-provision" \
    PHONE_SMOKE="$t/bin/phone-smoke" INSTALL_POLL="${POLL:-1}" INSTALL_WAIT_FIRST_START="${WAIT_FIRST:-2}" INSTALL_WAIT_RESTART=2 \
    INSTALL_WAIT_SETTLE=2 INSTALL_WAIT_FASTBOOT=2 bash install --guided "$@") > "$t/out" 2>&1
}
fresh
bguided "$ALL" || fail "a signed bundle installs with bash install --guided and no option"
once "from a bundle"
says "Omarchy Mobile 2026.11.01 for the Test Phone" && says "release 2026.11.01 (developer preview)" || fail "a bundle names its release"
says "the download is complete and signed by Omarchy Mobile" || fail "the bundle's signature, checksums and root image are checked (install-phone --verify-only)"
grep -c '^nv-backup [^-]' "$t/events" >/dev/null || fail "in a bundle nv-backup reads the bundle's own descriptor"
[[ $(record release) == 2026.11.01 ]] || fail "the record names the bundle's release"
pass "a bundle as make-bundle makes it, unpacked: bash install --guided installs it with no option, from the bundle's own signed files"

# The finished install run again asks, instead of stopping for --start-over
cp "$t/events" "$t/events.finished"
bguided "" || fail "a finished install run again with no answer"
says "Install again from the start? This erases the phone. (yes/no)" && says "Nothing was changed" && [[ -f $STATE/state ]] &&
  cmp -s "$t/events" "$t/events.finished" || fail "a finished install, no answer: asked, nothing forgotten, nothing run"
bguided "no\n" && says "Nothing was changed" && [[ -n $(record finished) ]] || fail "a finished install, \"no\": nothing forgotten"
# 2026-11-13, as it went then: a reinstall of the phone the record names,
# which runs Omarchy Mobile from slot B and reports one bootloader version
# only. It needed --start-over, --reinstall and --bootloader-slots-match
# typed by hand; now it is three questions
: > "$t/events"; echo FAKE123 > "$t/fb-devices"; touch "$t/ssh-down"; rm -f "$t/firstboot-done"
SLOTS="" vars yes b
bguided "yes\nyes\nyes\n${OWNER}testdev\n" || fail "a reinstall from the bundle, answered with yes three times"
says "The record of the earlier install is forgotten" && says "Is this phone already running Omarchy Mobile? (yes/no)" &&
  says "slot B's bootloader, which the phone already runs; the install switches no slot" || fail "the reinstall: start again, slot B and its bootloader, each said"
ADDS=0 once "a reinstall from the bundle"
pass "a finished install run again asks \"Install again from the start?\"; a reinstall on slot B needs no option"

# Every stop ends with the one command to run next, the bundle's own
fresh; touch "$t/fail-backup"
if bguided "$ALL"; then fail "a stopped install from the bundle"; fi
[[ $(tail -n 2 "$t/out") == "    and go on from here, run:"*$'\n'"        bash install --guided" || $(tail -n 1 "$t/out") == "        bash install --guided" ]] ||
  fail "a stop in a bundle ends with the command to run, bash install --guided, on a line of its own"
rm "$t/fail-backup"
pass "a stop in a bundle ends with: bash install --guided"

# The repository's installer pointed at a bundle's images (as on 2026-11-13)
fresh
if INSTALLER_ARGS_ONLY=1 guided "$ALL" --device testdev --images "$BD/images" --work "$t/work"; then fail "the repository installer with a bundle's images stops"; fi
says "holds a release bundle's images" && says "        cd $BD" && says "        bash install --guided" && [[ $(events '^fastboot') == 0 ]] ||
  fail "a bundle's images given to the repository installer: it names the bundle's own command, and contacts no phone"
# The guided installer never runs itself through install-phone
if OMAMOBILE_INSTALL_GUIDED=1 bash "$BD/install" --guided > "$t/out" 2>&1; then fail "install --guided from the guided installer's own runs is refused"; fi
says "is not for the guided installer's own runs" || fail "says why --guided is refused there"
# The bundle's checksums cover its build index
echo tampered >> "$BD/factory-builds.json"
fresh
if bguided "$ALL"; then fail "a bundle whose build index changed is refused"; fi
says "didn't pass its checks" && [[ $(events '^fastboot') == 0 ]] || fail "the bundle's checksums cover its build index, checked before the phone is contacted"
pass "a bundle: the repository installer sends a bundle's images to the bundle's own command; its build index is under its signed checksums"

# --- A run that can't run says so --------------------------------------------------------
# With a tool missing the suite skips whole; in CI that fails
mkdir "$t/bare"; ln -s "$(command -v dirname)" "$t/bare/dirname"
bash_bin=$(command -v bash) env_bin=$(command -v env)
if "$env_bin" -i CI=true PATH="$t/bare" "$bash_bin" "$SRC/tests/install-guided" >"$t/skip.out" 2>&1; then fail "in CI a missing tool fails the suite"; fi
grep -c "^not ok - tests/install-guided can't run in CI: no debugfs" "$t/skip.out" >/dev/null || { cat "$t/skip.out" >&2; fail "in CI the suite names the tool it lacks"; }
"$env_bin" -i PATH="$t/bare" "$bash_bin" "$SRC/tests/install-guided" >"$t/skip.out" 2>"$t/skip.err" || fail "outside CI a missing tool skips the suite"
grep -c '^ok - # skip: no debugfs' "$t/skip.out" >/dev/null && grep -c 'SKIPPED, no debugfs: none of its cases ran' "$t/skip.err" >/dev/null ||
  fail "outside CI the skip is said on both streams"
pass "a suite that can't run: a failure in CI, a loud skip elsewhere"

# --- The script itself ------------------------------------------------------------------
code=$(grep -v '^[[:space:]]*#' tools/install-guided)
! grep -nE '"\$FASTBOOT"[^|]*(flash |--set-active|erase|format| -w|--slot| oem |reboot)' <<<"$code" || fail "install-guided sends no fastboot write, erase, slot change or reboot"
[[ $(grep -cE '"\$FASTBOOT" (devices|-s)' <<<"$code") == 3 && $(grep -c '"$FASTBOOT"' <<<"$code") == 4 ]] ||
  fail "three fastboot calls (devices, getvar all, flashing get_unlock_ability), and the check that it is installed"
[[ $(grep -cE '"\$FASTBOOT".* flashing ' <<<"$code") == 1 && $(grep -cE '"\$FASTBOOT" -s "\$serial" flashing get_unlock_ability' <<<"$code") == 1 ]] ||
  fail "the one flashing command is the read-only get_unlock_ability"
# Google's host is reached from one place, by a curl that follows no
# redirect by itself, speaks https only and is told the file's size; every
# address is judged against one pattern, anchored on the host
dl=$(grep -A1 -E '^[[:space:]]*curl -q -f -# ' <<<"$code" | tr -d '\\\n')
[[ $(grep -cE '^[[:space:]]*curl -q -f -# ' <<<"$code") == 1 && $dl == *" -L --max-redirs 0 --proto =https --proto-redir =https "* && $dl == *' --max-filesize "${B[size]}" '* ]] ||
  fail "one curl downloads from Google: no redirect followed, https only, the size given"
[[ $(grep -cE '(^|[^a-z_])(curl|wget) -' <<<"$code") == 2 ]] || fail "curl is run from two places: the look for a newer index, and the download"
! grep -E '(^|[^a-z_])curl -[^|]*' <<<"$code" | grep -E ' (-L|--location) ' | grep -v -- '--max-redirs 0' || fail "no curl follows redirects"
# -q comes first on every curl, so curl reads no ~/.curlrc: a "url" or
# "location" line there would add an address or a redirect nothing here checked
[[ $(grep -oE '(^|[^a-z_])curl -[a-zA-Z#]+' <<<"$code" | grep -cv 'curl -q$') == 0 ]] || fail "every curl starts with -q (no ~/.curlrc)"
grep -cFx "GOOGLE_DL='^https://dl\.google\.com/[A-Za-z0-9._~%/?&=+:,;@!-]*\$'" <<<"$code" >/dev/null || fail "the one pattern for Google's download host is anchored on https://dl.google.com/"
[[ $(grep -c 'fetch_factory' <<<"$code") == 2 && $(grep -c 'google_terms' <<<"$code") == 2 ]] && grep -B3 'if fetch_factory; then' <<<"$code" | grep -c 'elif google_terms; then' >/dev/null ||
  fail "the download has one caller, and it is reached only through the terms"
[[ $(grep -c 'run_provision' <<<"$code") == 2 ]] || fail "one place knows phone-provision's command line, called once"
! grep -n 'Nothing is lost' <<<"$code" || fail "no stop carries a fixed reassurance"
# tools/release's identifier scan reads every file of a bundle, and takes a
# line with the serial's kernel parameter in plain text for a leaked serial
! grep -nE '(ro\.serialno|androidboot\.serialno)' tools/install-guided tools/camera-requirements.txt tools/phone-smoke tools/factory-index || fail "no file a bundle would ship trips the release's serial scan"
[[ $(grep -cE '^[[:space:]]*written_phone$' <<<"$code") == 6 ]] || fail "six places ask the phone which one it is: the first start, the backup, provisioning, the restart (before and after) and the check"
[[ $(grep -c -- '--serial "\$serial"' <<<"$code") == 1 && $(grep -c 'bash "\$INSTALL_PHONE"' <<<"$code") == 2 ]] ||
  fail "install-phone is run from two places: the file check, and the one that always hands it the phone's serial"
pass "install-guided: read-only fastboot only, Google's image downloaded from one guarded place behind the terms, one phone-provision call"

# What it shares with the other files stays the same as theirs
nm=$(sed -n '/^nmcli connection add/,/[^\\]$/p' docs/INSTALL.md | tr -d '\\\n' | tr -s ' ')
[[ $nm == "nmcli connection add "*cdc_ncm* ]] || fail "docs/INSTALL.md gives the connection's command"
fresh; guided "yes\n${OWNER}testdev\nno\n" || true
grep -cF -- "$nm" "$t/out" >/dev/null || fail "the connection is the one docs/INSTALL.md gives: $nm"
state=$(sed -n 's/^STATE=\$ROOT\(.*\)$/\1/p' packages/omamobile-firstboot/bin/omamobile-firstboot)
grep -cFx "FIRSTBOOT_DONE=$state/done" tools/install-guided >/dev/null || fail "the first start's marker is omamobile-firstboot's ($state/done)"
grep -cF '$HOME/.cache/omamobile-venv' tools/phone-provision >/dev/null && grep -cFx 'CAMERA_VENV=$HOME/.cache/omamobile-venv' tools/install-guided >/dev/null ||
  fail "the camera's Python folder is the one phone-provision looks in"
pass "the connection, the first start's marker and the camera folder agree with INSTALL.md, omamobile-firstboot and phone-provision"

# Every question the installer asks is in the design, word for word (up to
# the first value it fills in)
asked=0
while IFS= read -r q; do
  q=${q%%\$*}; q=${q%%[*}; q=${q%% (*}
  q=$(sed -E 's/^[[:space:]]+//; s/[: ]+$//' <<<"$q")
  grep -cF -- "$q" docs/INSTALL-GUIDED.md >/dev/null || fail "docs/INSTALL-GUIDED.md has the question: $q"
  asked=$((asked + 1))
done < <(sed -nE 's/^[[:space:]]*ask(_secret)? "(.*)"$/\2/p' tools/install-guided)
((asked >= 15)) || fail "the questions are found in the script ($asked)"
pass "all $asked questions are in docs/INSTALL-GUIDED.md"
