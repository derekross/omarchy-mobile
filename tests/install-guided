  says "none of this computer's own traffic is sent through the phone" && says "The phone gets no internet through the cable" ||
  fail "the connection is described as the plain link it is: no sharing, no server, no forwarding, no route through the phone"
says "matched by driver (cdc_ncm)" && says "USB-C docks" && says "no saved" && says "priority (-100) is below every connection you have saved" && says "stays saved" ||
  fail "the description says what the driver match can catch, the priority, and that it stays"
! says "Nothing else on this computer changes" && ! says "applies only to" && ! says "shares this computer's internet" || fail "the connection's description makes no promise it can't keep"
says "Omarchy Mobile is written to the phone, and what the install has done so" && ! says "Nothing has been written" || fail "after the write, a stop says the phone is written"
touch "$t/fail-nmcli"
if guided "\n"; then fail "a connection NetworkManager refuses stops the install"; fi
rm "$t/fail-nmcli"
guided "\n" || fail "the install goes on once the connection is added"
! says "Type the phone" || fail "the phone isn't written again"
[[ $(grep '^nmcli connection add' "$t/events" | sort -u) == "nmcli connection add type ethernet con-name omamobile-phone match.driver cdc_ncm ipv4.method manual ipv4.addresses 172.16.42.2/24 ipv4.never-default yes ipv6.method disabled connection.autoconnect-priority -100" ]] ||
  { grep '^nmcli connection add' "$t/events" >&2; fail "the connection added is the plain link: manual, never the default route, priority -100, no sharing"; }
! grep -c '^nmcli .*shared' "$t/events" >/dev/null || fail "no shared connection is ever added"
ADDS=2 once "after the connection"   # the refused try and the one that worked
pass "resume: the USB connection is shown first, added only with consent, and the write isn't repeated"

# The connection saved by an earlier install: the written phone answers
# through it as soon as it has started
fresh; echo omamobile-phone > "$t/nm-profiles"
guided "yes\n${OWNER}testdev\n" || fail "an install with the connection already there"
[[ $(events '^nmcli connection add') == 0 ]] && ! says "Press Enter to add it" || fail "a connection that works is not added or asked about again"
ADDS=0 once "with the connection already there"
# One saved by an earlier guide shares the computer's internet: it is left
# alone, and said to be what it is
fresh; echo omamobile-phone > "$t/nm-profiles"; echo shared > "$t/nm-method"; touch "$t/keep-ssh-down"
guided "$ALL" || true
says "already saved on this computer, and is left as it is" && says "it shares this computer's internet connection with the phone" && [[ $(events '^nmcli connection (add|modify|delete)') == 0 ]] ||
  fail "a saved connection that shares the internet is named as such and not changed"
rm -f "$t/keep-ssh-down"
pass "a USB connection that already works is left alone"

# Something answers at the phone's USB address while the phone to install
# is in Fastboot Mode: another phone. Nothing is written until it is gone.
fresh; echo omamobile-phone > "$t/nm-profiles"; rm "$t/ssh-down"
if guided "$ALL"; then fail "another phone at the USB address stops the install before the write"; fi
says "Something already answers at the phone's USB address" && says "Unplug it" && [[ -z $(writes) && -z $(record write) ]] ||
  fail "another phone at the USB address: said plainly, nothing written"
! says "user name on the phone" || fail "it stops before the owner's questions"
[[ $(grep '^ssh-call' "$t/events" | sort -u) == "ssh-call true" ]] || fail "the phone that answers is sent nothing but the look"
