#!/bin/bash
# SPDX-License-Identifier: MIT
# A contributor's local builds (no phone, no network, no Docker): every run
# happens in a copy of the repository, so the real keys/ and out/ are never
# touched. tools/local-key-init makes keys/NAME once; tools/fetch-published
# takes only what a trusted, unrevoked Omamobile key signed, against a
# fake server (file://) and a test keyring; build-packages and build-rootfs
# --local refuse before any build without the local key, and never fall
# back to the maintainer's keys/ or out/repo.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
command -v gpg >/dev/null && command -v gpgv >/dev/null || { pass "# skip: no gpg"; exit 0; }
t=$(mktemp -d)
export ALARM_CACHE=$t/cache   # add_to_repo removes from the package cache: never the developer's own
export GNUPGHOME=$t/home && mkdir -m 700 "$GNUPGHOME"  # never the user's ~/.gnupg
trap 'gpgconf --homedir "$t/signer" --kill gpg-agent 2>/dev/null || true; gpgconf --homedir "$t/other" --kill gpg-agent 2>/dev/null || true; rm -rf "$t"' EXIT

R=$t/repo
mkdir -p "$R/tools/lib" "$R/device/panther" "$R/packages"
cp tools/local-key-init tools/fetch-published tools/build-packages tools/build-rootfs "$R/tools/"
cp tools/lib/alarm.sh tools/lib/alarm-setup "$R/tools/lib/"
cp device/panther/device.conf "$R/device/panther/"
cp -a packages/omamobile-device-panther "$R/packages/"
run() { (cd "$R" && "$@") > "$t/log" 2>&1; }

# --- tools/local-key-init ---
if run tools/local-key-init nosuch; then fail "local-key-init refuses a codename without a descriptor"; fi
run tools/local-key-init panther || { cat "$t/log"; fail "local-key-init makes keys/panther"; }
fpr=$(cat "$R/keys/panther/fingerprint")
[[ $fpr =~ ^[0-9A-F]{40}$ ]] || fail "the fingerprint is 40 hex digits"
[[ $(gpg --show-keys --with-colons "$R/keys/panther/public.asc" | awk -F: '$1 == "fpr" {print $10; exit}') == "$fpr" ]] \
  || fail "public.asc is the key named in fingerprint"
[[ $(stat -c %a "$R/keys/panther/gnupg") == 700 ]] || fail "the keyring directory is private"
if run tools/local-key-init panther; then fail "local-key-init refuses to replace an existing key"; fi
gpgconf --homedir "$R/keys/panther/gnupg" --kill gpg-agent 2>/dev/null || true
pass "local-key-init makes one signing key in keys/panther, once"

# --- tools/fetch-published ---
cp tools/lib/signing.sh "$R/tools/lib/"
mkdir -m 700 "$t/signer" "$t/other"
GNUPGHOME=$t/signer gpg --batch --quiet --passphrase '' --quick-generate-key "test signer <s@invalid>" ed25519 sign never
GNUPGHOME=$t/other gpg --batch --quiet --passphrase '' --quick-generate-key "someone else <o@invalid>" ed25519 sign never
signer=$(GNUPGHOME=$t/signer gpg --with-colons --list-keys | awk -F: '$1 == "fpr" {print $10; exit}')
kr=$R/packages/omamobile-keyring && mkdir -p "$kr"
GNUPGHOME=$t/signer gpg --batch --armor --export "$signer" > "$kr/omamobile.gpg"
echo "$signer:4:" > "$kr/omamobile-trusted"
: > "$kr/omamobile-revoked"

srv=$t/srv/development/aarch64 && mkdir -p "$srv"
sign() { GNUPGHOME=$t/$1 gpg --batch --yes --quiet --detach-sign -o "$2.sig" "$2"; }
make_index() {  # make_index KEY [FILE...]: an index of FILE (foo's by default) whose checksums match the files
  local key=$1 f sum entry; shift
  rm -rf "$t/db" && mkdir -p "$t/db"
  for f in "${@:-foo-1-1-any.pkg.tar.zst}"; do
    sum=$(sha256sum < "$srv/$f" | cut -d' ' -f1)
    entry=$t/db/${f%-any.pkg.tar.*} && mkdir -p "$entry"
    printf '%%FILENAME%%\n%s\n\n%%SHA256SUM%%\n%s\n' "$f" "$sum" > "$entry/desc"
  done
  tar -czf "$srv/omamobile.db" -C "$t/db" .
  sign "$key" "$srv/omamobile.db"
}
echo "package bytes" > "$srv/foo-1-1-any.pkg.tar.zst"
sign signer "$srv/foo-1-1-any.pkg.tar.zst"
make_index signer
fetch() { (cd "$R" && env "$@" OMAMOBILE_PKGS_URL=file://$t/srv tools/fetch-published "${into:-$t/got}") > "$t/log" 2>&1; }

fetch || { cat "$t/log"; fail "fetch-published takes a trusted index and package"; }
[[ -f $t/got/foo-1-1-any.pkg.tar.zst && -f $t/got/foo-1-1-any.pkg.tar.zst.sig ]] || fail "the package comes with its signature"
pass "fetch-published takes what a trusted key signed, with its .sig"

make_index other
if fetch; then fail "refuses an index signed by an untrusted key"; fi
grep -q 'index is not signed by a trusted' "$t/log" || { cat "$t/log"; fail "says the index is untrusted"; }
make_index signer
sign other "$srv/foo-1-1-any.pkg.tar.zst"
rm -rf "$t/got"
if fetch; then fail "refuses a package signed by an untrusted key"; fi
grep -q 'foo-1-1-any.pkg.tar.zst is not signed by a trusted' "$t/log" || { cat "$t/log"; fail "says the package is untrusted"; }
sign signer "$srv/foo-1-1-any.pkg.tar.zst"
echo "tampered" >> "$srv/foo-1-1-any.pkg.tar.zst"
rm -rf "$t/got"
if fetch; then fail "refuses a package that does not match the index"; fi
grep -q 'does not match the index' "$t/log" || { cat "$t/log"; fail "says the package does not match"; }
pass "fetch-published refuses an untrusted index, an untrusted package and a changed package"

echo "package bytes" > "$srv/foo-1-1-any.pkg.tar.zst"
sign signer "$srv/foo-1-1-any.pkg.tar.zst"
make_index signer
echo "$signer" > "$kr/omamobile-revoked"
if fetch; then fail "refuses a revoked key"; fi
grep -q 'index is not signed by a trusted' "$t/log" || { cat "$t/log"; fail "says the revoked key's index is untrusted"; }
pass "fetch-published refuses a revoked key"

# The published repository moves on: foo 0.2.9 becomes 0.2.10 and bar goes.
# DIR is then the published set again, so --import can't take the older foo
# beside the newer one; a fetch that stops removes nothing, and only package
# files directly in DIR go, with their .sig
: > "$kr/omamobile-revoked"
for f in foo-0.2.9-1-any.pkg.tar.zst foo-0.2.10-1-any.pkg.tar.zst bar-1-1-any.pkg.tar.xz baz-1-1-any.pkg.tar.zst; do
  echo "$f" > "$srv/$f" && sign signer "$srv/$f"
done
make_index signer foo-0.2.9-1-any.pkg.tar.zst bar-1-1-any.pkg.tar.xz
rm -rf "$t/got"
fetch || { cat "$t/log"; fail "fetch-published takes foo 0.2.9 and bar"; }
mkdir -p "$t/got/old.pkg.tar.zst" "$t/got/keep"
echo "notes" > "$t/got/NOTES.txt"
echo "by hand" > "$t/got/*.pkg.tar.zst"
cp "$t/got/foo-0.2.9-1-any.pkg.tar.zst" "$t/got/keep/"
listing() { (cd "$t/got" && find . -mindepth 1 | LC_ALL=C sort); }
before=$(listing)
tar -czf "$srv/omamobile.db" -T /dev/null && sign signer "$srv/omamobile.db"
if fetch; then fail "refuses an empty index"; fi
grep -q 'the index lists no package' "$t/log" || { cat "$t/log"; fail "says the index lists no package"; }
[[ $(listing) == "$before" ]] || fail "an empty index removes nothing"
# bash takes nullglob from an exported BASHOPTS, and the empty index's glob
# then gives no entry at all rather than one that can't be read
if fetch BASHOPTS=nullglob; then fail "refuses an empty index with nullglob inherited"; fi
grep -q 'the index lists no package' "$t/log" || { cat "$t/log"; fail "says the index lists no package with nullglob inherited"; }
[[ $(listing) == "$before" ]] || fail "an empty index removes nothing with nullglob inherited"
make_index signer foo-0.2.10-1-any.pkg.tar.zst
sign other "$srv/foo-0.2.10-1-any.pkg.tar.zst"
if fetch; then fail "refuses foo 0.2.10 signed by an untrusted key"; fi
[[ $(LC_ALL=C comm -23 <(echo "$before") <(listing)) == "" ]] || fail "a fetch that stops removes nothing"
sign signer "$srv/foo-0.2.10-1-any.pkg.tar.zst"
fetch || { cat "$t/log"; fail "fetch-published takes foo 0.2.10"; }
[[ $(listing) == "$(printf '%s\n' ./NOTES.txt ./foo-0.2.10-1-any.pkg.tar.zst ./foo-0.2.10-1-any.pkg.tar.zst.sig \
    ./keep ./keep/foo-0.2.9-1-any.pkg.tar.zst ./old.pkg.tar.zst | LC_ALL=C sort)" ]] \
  || { cat "$t/log"; listing; fail "DIR keeps only what the index lists, and what isn't a package file in DIR"; }
for f in foo-0.2.9-1-any.pkg.tar.zst bar-1-1-any.pkg.tar.xz '*.pkg.tar.zst'; do
  grep -qxF "    gone $f" "$t/log" || { cat "$t/log"; fail "names $f as removed"; }
done
pass "fetch-published removes, and names, the packages the index no longer lists, and nothing else"

# Three delisted entries that a looser cleanup gets wrong: a file named as
# two listed names joined by a space (a name is matched exactly, so it goes);
# a package-named symlink (it goes as the file would, since build-packages
# --import would take it, but only the link: its target outside DIR is never
# touched); a package whose .sig is a directory (the package goes, the
# directory stays, as sub-directories do, and the run ends as usual). The run
# inherits glob options, and ends as it would without them: DIR holds no
# .xz (failglob would stop there), and a hidden and an upper-case name that
# dotglob or nocaseglob would match stay
make_index signer baz-1-1-any.pkg.tar.zst foo-0.2.10-1-any.pkg.tar.zst
joined="baz-1-1-any.pkg.tar.zst foo-0.2.10-1-any.pkg.tar.zst"
echo "older foo" > "$t/got/$joined"
echo "by hand" > "$t/got/.hidden-1-1-any.pkg.tar.zst" && echo "by hand" > "$t/got/UPPER-1-1-ANY.PKG.TAR.ZST"
mkdir -p "$t/outside" && echo "linked bytes" > "$t/outside/linked-1-1-any.pkg.tar.zst"
target_sum=$(sha256sum < "$t/outside/linked-1-1-any.pkg.tar.zst")
ln -s "$t/outside/linked-1-1-any.pkg.tar.zst" "$t/got/linked-1-1-any.pkg.tar.zst"
echo "stale" > "$t/got/stale-1-1-any.pkg.tar.zst" && mkdir "$t/got/stale-1-1-any.pkg.tar.zst.sig"
fetch BASHOPTS=nullglob:failglob:dotglob:nocaseglob \
  || { cat "$t/log"; listing; fail "fetch-published finishes with a joined name, a symlink and a .sig directory in DIR"; }
[[ $(listing) == "$(printf '%s\n' ./.hidden-1-1-any.pkg.tar.zst ./NOTES.txt ./UPPER-1-1-ANY.PKG.TAR.ZST \
    ./baz-1-1-any.pkg.tar.zst ./baz-1-1-any.pkg.tar.zst.sig \
    ./foo-0.2.10-1-any.pkg.tar.zst ./foo-0.2.10-1-any.pkg.tar.zst.sig ./keep ./keep/foo-0.2.9-1-any.pkg.tar.zst \
    ./old.pkg.tar.zst ./stale-1-1-any.pkg.tar.zst.sig | LC_ALL=C sort)" ]] \
  || { cat "$t/log"; listing; fail "removes the joined name, the symlink and the package, and keeps the .sig directory, a hidden and an upper-case name"; }
for f in "$joined" linked-1-1-any.pkg.tar.zst stale-1-1-any.pkg.tar.zst; do
  grep -qxF "    gone $f" "$t/log" || { cat "$t/log"; fail "names $f as removed"; }
done
[[ $(sha256sum < "$t/outside/linked-1-1-any.pkg.tar.zst") == "$target_sum" ]] \
  || fail "leaves the symlink's target outside DIR byte for byte"
pass "fetch-published matches names exactly, removes a symlink but never its target, and keeps a .sig directory, under inherited glob options"

# A DIR that holds a repository index is a package repository given by mistake:
# it is refused before any download, the index's included (a curl on PATH logs
# every call, and a run into $t/got shows it does), and left as it was
real_curl=$(command -v curl) && mkdir -p "$t/bin"
cat > "$t/bin/curl" <<EOF
#!/bin/sh
echo "\$*" >> "$t/curl.log"
exec "$real_curl" "\$@"
EOF
chmod +x "$t/bin/curl"
state() { (cd "$1" && find . -mindepth 1 -printf '%y %p\n' | LC_ALL=C sort && find . -type f -exec sha256sum {} + | LC_ALL=C sort); }
for db in omamobile.db omamobile.db.tar.gz; do
  d=$t/local-$db && mkdir -p "$d"
  echo "a local index" > "$d/$db"
  echo "the port's own" > "$d/local-1-1-any.pkg.tar.zst" && echo "its signature" > "$d/local-1-1-any.pkg.tar.zst.sig"
  was=$(state "$d") && : > "$t/curl.log"
  if into=$d fetch PATH="$t/bin:$PATH"; then cat "$t/log"; fail "refuses a folder that holds $db"; fi
  grep -qxF "error: $d is a package repository (it holds omamobile.db): give fetch-published a folder of its own, such as out/<codename>/published" "$t/log" \
    || { cat "$t/log"; fail "says a folder that holds $db is a package repository"; }
  [[ ! -s $t/curl.log ]] || { cat "$t/curl.log"; fail "fetches nothing into a folder that holds $db"; }
  [[ $(state "$d") == "$was" ]] || { state "$d"; fail "leaves a folder that holds $db as it was"; }
done
fetch PATH="$t/bin:$PATH" || { cat "$t/log"; fail "fetch-published runs again into its own folder"; }
grep -q 'omamobile.db.sig$' "$t/curl.log" || { cat "$t/curl.log"; fail "the curl log sees the tool's index download"; }
pass "fetch-published refuses a folder that holds a repository index, before any download, and leaves it as it was"

# omamobile-revoked is read only in the form docs/RELEASES.md §10 gives: a
# line in another form (the signer in lowercase, which a looser read takes
# for no revocation), or a directory in the file's place, stops the run
# before any download, with the words of tools/lib/signing.sh's check
for bad in lowercase directory; do
  [[ $bad != lowercase || $signer == *[A-F]* ]] || { pass "# skip: the signer's fingerprint has no letter to lowercase"; continue; }
  if [[ $bad == lowercase ]]; then echo "${signer,,}" > "$kr/omamobile-revoked"
  else rm "$kr/omamobile-revoked" && mkdir "$kr/omamobile-revoked"; fi
  if why=$(source "$R/tools/lib/signing.sh" && revoked_file_check "$R"); then fail "the check refuses omamobile-revoked as a $bad"; fi
  d=$t/revoked-$bad && : > "$t/curl.log"
  if into=$d fetch PATH="$t/bin:$PATH"; then cat "$t/log"; fail "refuses omamobile-revoked as a $bad"; fi
  grep -qxF "error: $why" "$t/log" || { cat "$t/log"; fail "says why omamobile-revoked as a $bad is refused"; }
  [[ ! -s $t/curl.log ]] || { cat "$t/curl.log"; fail "fetches nothing with omamobile-revoked as a $bad"; }
  [[ ! -e $d ]] || fail "makes no DIR with omamobile-revoked as a $bad"
done
rmdir "$kr/omamobile-revoked" && : > "$kr/omamobile-revoked"
pass "fetch-published stops at an omamobile-revoked not in RELEASES §10's form, before any download, with the signing tools' words"

# A missing omamobile-revoked revokes nothing and writes nothing to stderr;
# if an existing file vanishes, becomes unreadable, turns into a directory,
# or changes to a malformed line between revoked_file_check and the read,
# fetch-published stops before any download rather than continuing with an
# empty or unparsed revocation list. A wc on PATH applies each fault after
# revoked_file_check's final wc -l succeeds.
rm -f "$kr/omamobile-revoked"
(cd "$R" && OMAMOBILE_PKGS_URL=file://$t/srv tools/fetch-published "$t/revoked-missing") \
  > "$t/log" 2> "$t/err" || { cat "$t/log" "$t/err"; fail "fetch-published allows a missing omamobile-revoked"; }
[[ ! -s $t/err ]] || { cat "$t/err"; fail "a missing omamobile-revoked writes nothing to stderr"; }
[[ -f $t/revoked-missing/baz-1-1-any.pkg.tar.zst && -f $t/revoked-missing/foo-0.2.10-1-any.pkg.tar.zst ]] \
  || { cat "$t/log"; fail "fetches packages when omamobile-revoked is missing"; }
real_wc=$(command -v wc) && mkdir -p "$t/bin-revoked"
cat > "$t/bin-revoked/wc" <<EOF
#!/bin/sh
"$real_wc" "\$@" || exit \$?
case "\${REVOKED_FAULT:-}" in
  rm) rm -f -- "$kr/omamobile-revoked" ;;
  chmod) chmod 000 -- "$kr/omamobile-revoked" ;;
  dir) rm -f -- "$kr/omamobile-revoked" && mkdir -- "$kr/omamobile-revoked" ;;
  swap) printf '%s:4:\n' "$signer" > "$kr/omamobile-revoked" ;;
  crlf) printf '%s\r\n' "$signer" > "$kr/omamobile-revoked" ;;
  blank) printf '%s\n\n' "$signer" > "$kr/omamobile-revoked" ;;
  nonl) printf '%s' "$signer" > "$kr/omamobile-revoked" ;;
esac
EOF
chmod +x "$t/bin-revoked/wc"
: > "$t/unreadable" && chmod 000 "$t/unreadable"
for fault in rm chmod dir swap crlf blank nonl; do
  if [[ $fault == chmod && -r $t/unreadable ]]; then
    pass "# skip: chmod 000 does not stop this user reading"
    continue
  fi
  echo "$signer" > "$kr/omamobile-revoked"
  d=$t/revoked-fault-$fault && : > "$t/curl.log"
  if into=$d fetch PATH="$t/bin-revoked:$t/bin:$PATH" REVOKED_FAULT="$fault"; then
    cat "$t/log"
    fail "stops when omamobile-revoked fails after the check ($fault)"
  fi
  case $fault in
    rm) [[ ! -e $kr/omamobile-revoked ]] || fail "the wc wrapper removed omamobile-revoked" ;;
    chmod)
      [[ ! -r $kr/omamobile-revoked ]] || fail "the wc wrapper made omamobile-revoked unreadable"
      chmod 644 "$kr/omamobile-revoked" ;;
    dir)
      [[ -d $kr/omamobile-revoked ]] || fail "the wc wrapper replaced omamobile-revoked with a directory"
      rmdir "$kr/omamobile-revoked" ;;
    swap) [[ $(cat "$kr/omamobile-revoked") == "$signer:4:" ]] || fail "the wc wrapper rewrote omamobile-revoked as malformed ($fault)" ;;
    crlf) [[ $(cat "$kr/omamobile-revoked") == $signer$'\r' ]] || fail "the wc wrapper rewrote omamobile-revoked as malformed ($fault)" ;;
    blank) [[ $(wc -l < "$kr/omamobile-revoked") == 2 ]] || fail "the wc wrapper rewrote omamobile-revoked as malformed ($fault)" ;;
    nonl) [[ $(wc -l < "$kr/omamobile-revoked") == 0 ]] || fail "the wc wrapper rewrote omamobile-revoked as malformed ($fault)" ;;
  esac
  case $fault in
    rm|chmod|dir) want="error: cannot read packages/omamobile-keyring/omamobile-revoked" ;;
    *) want="error: packages/omamobile-keyring/omamobile-revoked changed while reading" ;;
  esac
  grep -qxF "$want" "$t/log" \
    || { cat "$t/log"; fail "says why omamobile-revoked failed after the check ($fault)"; }
  [[ ! -s $t/curl.log ]] || { cat "$t/curl.log"; fail "fetches nothing when omamobile-revoked fails after the check ($fault)"; }
  [[ ! -e $d ]] || fail "makes no DIR when omamobile-revoked fails after the check ($fault)"
done
: > "$kr/omamobile-revoked"
pass "fetch-published allows a missing omamobile-revoked quietly, and stops before any download if it cannot be read or changes after the check"

# Failed fetches stage outside DIR: a missing .sig, a SHA-256 mismatch or an
# untrusted signature leaves no unverified bytes or .sig in DIR, keeps any
# existing verified pair byte for byte, and leaves no staging folder behind.
echo "verified v1" > "$srv/foo-1-1-any.pkg.tar.zst"
sign signer "$srv/foo-1-1-any.pkg.tar.zst"
make_index signer foo-1-1-any.pkg.tar.zst
d=$t/stage-keep
into=$d fetch || { cat "$t/log"; fail "fetch-published seeds a verified pair"; }
cp "$d/foo-1-1-any.pkg.tar.zst" "$t/keep-pkg" && cp "$d/foo-1-1-any.pkg.tar.zst.sig" "$t/keep-sig"
[[ $(ls -A "$d" | LC_ALL=C sort) == $'foo-1-1-any.pkg.tar.zst\nfoo-1-1-any.pkg.tar.zst.sig' ]] \
  || { ls -A "$d"; fail "a clean fetch leaves only the verified pair in DIR"; }

for bad in missing-sig bad-sha untrusted-sig; do
  echo "republished $bad" > "$srv/foo-1-1-any.pkg.tar.zst"
  make_index signer foo-1-1-any.pkg.tar.zst
  case $bad in
    missing-sig) rm -f "$srv/foo-1-1-any.pkg.tar.zst.sig"; want='foo-1-1-any.pkg.tar.zst has no signature' ;;
    bad-sha) sign signer "$srv/foo-1-1-any.pkg.tar.zst"; echo "tampered" >> "$srv/foo-1-1-any.pkg.tar.zst"; want='foo-1-1-any.pkg.tar.zst does not match the index' ;;
    untrusted-sig) sign other "$srv/foo-1-1-any.pkg.tar.zst"; want='foo-1-1-any.pkg.tar.zst is not signed by a trusted' ;;
  esac
  fresh=$t/stage-fresh-$bad
  if into=$fresh fetch; then cat "$t/log"; fail "refuses $bad into a fresh DIR"; fi
  grep -qF "$want" "$t/log" || { cat "$t/log"; fail "names the refusal for $bad into a fresh DIR"; }
  [[ -z $(ls -A "$fresh" 2>/dev/null) ]] || { ls -la "$fresh"; fail "leaves no files in a fresh DIR after $bad"; }
  if into=$d fetch; then cat "$t/log"; fail "refuses $bad over an existing verified pair"; fi
  grep -qF "$want" "$t/log" || { cat "$t/log"; fail "names the refusal for $bad over an existing pair"; }
  cmp -s "$d/foo-1-1-any.pkg.tar.zst" "$t/keep-pkg" && cmp -s "$d/foo-1-1-any.pkg.tar.zst.sig" "$t/keep-sig" \
    || fail "keeps the existing verified pair byte for byte after $bad"
  [[ $(ls -A "$d" | LC_ALL=C sort) == $'foo-1-1-any.pkg.tar.zst\nfoo-1-1-any.pkg.tar.zst.sig' ]] \
    || { ls -la "$d"; fail "leaves no extra or staging files in DIR after $bad"; }
done

# When a second package fails, the first (already verified) stays, the failed
# package and its .sig are absent, and no staging folder remains.
echo "first valid" > "$srv/aaa-1-1-any.pkg.tar.zst" && sign signer "$srv/aaa-1-1-any.pkg.tar.zst"
echo "second untrusted" > "$srv/zzz-1-1-any.pkg.tar.zst" && sign other "$srv/zzz-1-1-any.pkg.tar.zst"
make_index signer aaa-1-1-any.pkg.tar.zst zzz-1-1-any.pkg.tar.zst
d2=$t/stage-second
if into=$d2 fetch; then cat "$t/log"; fail "refuses an untrusted second package"; fi
grep -qF 'zzz-1-1-any.pkg.tar.zst is not signed by a trusted' "$t/log" \
  || { cat "$t/log"; fail "names the untrusted second package refusal"; }
[[ $(ls -A "$d2" | LC_ALL=C sort) == $'aaa-1-1-any.pkg.tar.zst\naaa-1-1-any.pkg.tar.zst.sig' ]] \
  || { ls -la "$d2"; fail "keeps only the verified first package, with no failed package or staging folder"; }
cmp -s "$d2/aaa-1-1-any.pkg.tar.zst" "$srv/aaa-1-1-any.pkg.tar.zst" && cmp -s "$d2/aaa-1-1-any.pkg.tar.zst.sig" "$srv/aaa-1-1-any.pkg.tar.zst.sig" \
  || fail "the verified first pair matches the server's bytes"

# Real directories at the target .sig or package name are refused before any
# package download and left intact (along with any old package beside a .sig
# directory). Symlinks at either target are replaced with regular files without
# touching their outside targets, and placement moves from an in-DIR stage.
echo "verified v2" > "$srv/foo-1-1-any.pkg.tar.zst" && sign signer "$srv/foo-1-1-any.pkg.tar.zst"
make_index signer foo-1-1-any.pkg.tar.zst

for kind in sig pkg; do
  d_dir=$t/stage-dir-$kind
  [[ $kind == sig ]] && target=foo-1-1-any.pkg.tar.zst.sig || target=foo-1-1-any.pkg.tar.zst
  mkdir -p "$d_dir/$target" && echo "keep" > "$d_dir/$target/marker"
  [[ $kind != sig ]] || cp "$t/keep-pkg" "$d_dir/foo-1-1-any.pkg.tar.zst"
  was=$(state "$d_dir") && : > "$t/curl.log"
  if into=$d_dir fetch PATH="$t/bin:$PATH"; then cat "$t/log"; fail "refuses a real directory at the $kind target"; fi
  grep -qF "$d_dir/$target is a directory" "$t/log" || { cat "$t/log"; fail "says the $kind target is a directory"; }
  ! grep -qF 'foo-1-1-any.pkg.tar.zst' "$t/curl.log" || { cat "$t/curl.log"; fail "stops before downloading when the $kind target is a directory"; }
  [[ -d $d_dir/$target && ! -L $d_dir/$target && $(state "$d_dir") == "$was" ]] \
    || { state "$d_dir"; fail "leaves the $kind directory and DIR unchanged"; }
  [[ $kind != sig ]] || cmp -s "$d_dir/foo-1-1-any.pkg.tar.zst" "$t/keep-pkg" \
    || fail "keeps the old package unchanged when the .sig target is a directory"
done

real_mv=$(command -v mv) && mkdir -p "$t/bin-mv"
cat > "$t/bin-mv/mv" <<EOF
#!/bin/bash
printf '%s\n' "\$*" >> "$t/mv.log"
[[ -n \${MV_FAIL_PKG:-} && \${!#} == */foo-1-1-any.pkg.tar.zst ]] && exit 1
exec "$real_mv" "\$@"
EOF
chmod +x "$t/bin-mv/mv"

d_sym=$t/stage-sym && mkdir -p "$d_sym" "$t/stage-out-dir"
echo "outside bytes" > "$t/stage-out-file"
ln -s "$t/stage-out-file" "$d_sym/foo-1-1-any.pkg.tar.zst"
ln -s "$t/stage-out-dir" "$d_sym/foo-1-1-any.pkg.tar.zst.sig"
: > "$t/mv.log"
into=$d_sym fetch PATH="$t/bin-mv:$PATH" || { cat "$t/log"; fail "replaces symlinks at package and .sig targets"; }
for f in foo-1-1-any.pkg.tar.zst foo-1-1-any.pkg.tar.zst.sig; do
  [[ -f $d_sym/$f && ! -L $d_sym/$f ]] || { ls -la "$d_sym"; fail "replaces the $f symlink with a regular file"; }
  cmp -s "$d_sym/$f" "$srv/$f" || fail "the replaced $f holds the server's bytes"
done
[[ $(cat "$t/stage-out-file") == "outside bytes" ]] || fail "leaves the outside file symlink target unchanged"
[[ -z $(ls -A "$t/stage-out-dir") ]] || { ls -la "$t/stage-out-dir"; fail "leaves the outside directory symlink target empty"; }
src=$(awk -v dst="$d_sym/foo-1-1-any.pkg.tar.zst" '$NF == dst {print $(NF-1)}' "$t/mv.log")
[[ $src == "$d_sym"/.fetch-published.*/pkg && ${src#"$d_sym/.fetch-published."} != */*/* ]] \
  || { cat "$t/mv.log"; fail "places the package from a .fetch-published.* stage inside DIR"; }

# While another process holds the exclusive flock on DIR, fetch-published
# refuses before downloading and leaves DIR byte for byte as before.
d_lock=$t/stage-lock && mkdir -p "$d_lock"
cp "$t/keep-pkg" "$d_lock/foo-1-1-any.pkg.tar.zst" && cp "$t/keep-sig" "$d_lock/foo-1-1-any.pkg.tar.zst.sig"
: > "$t/curl.log" && exec {lock_fd}<"$d_lock" && flock -n "$lock_fd" || fail "test acquires flock on $d_lock"
rc=0
(exec {lock_fd}<&-; cd "$R" && PATH="$t/bin:$PATH" OMAMOBILE_PKGS_URL=file://$t/srv timeout 30 tools/fetch-published "$d_lock") > "$t/log" 2>&1 || rc=$?
exec {lock_fd}<&-
((rc != 0)) || { cat "$t/log"; fail "refuses when another fetch-published holds the lock on DIR"; }
((rc != 124)) || { cat "$t/log"; fail "timed out waiting for flock on DIR (expected non-blocking refusal)"; }
grep -qF "another fetch-published is writing $d_lock" "$t/log" || { cat "$t/log"; fail "says another fetch-published is writing DIR"; }
[[ ! -s $t/curl.log ]] || { cat "$t/curl.log"; fail "downloads nothing when DIR is locked"; }
[[ $(ls -A "$d_lock" | LC_ALL=C sort) == $'foo-1-1-any.pkg.tar.zst\nfoo-1-1-any.pkg.tar.zst.sig' ]] \
  || { ls -la "$d_lock"; fail "leaves DIR listing unchanged when locked"; }
cmp -s "$d_lock/foo-1-1-any.pkg.tar.zst" "$t/keep-pkg" && cmp -s "$d_lock/foo-1-1-any.pkg.tar.zst.sig" "$t/keep-sig" \
  || fail "keeps DIR byte for byte when locked"
into=$d_lock fetch || { cat "$t/log"; fail "succeeds once the lock on DIR is released"; }
cmp -s "$d_lock/foo-1-1-any.pkg.tar.zst" "$srv/foo-1-1-any.pkg.tar.zst" || fail "updates DIR after the lock is released"

# Placement removes any old package before placing the new .sig and renames
# the package last: a stop right before the final package rename never leaves
# a package without a .sig or an old package beside a new .sig, and EXIT
# cleanup only rmdirs an empty stage (never rm of named files in DIR), so the
# unplaced package stays inside the hidden .fetch-published.* stage.
for target in "$t/stage-mid-fresh" "$d"; do
  if into=$target fetch PATH="$t/bin-mv:$PATH" MV_FAIL_PKG=1; then cat "$t/log"; fail "stops when the final package rename fails ($target)"; fi
  [[ $(ls "$target") == foo-1-1-any.pkg.tar.zst.sig ]] \
    || { ls -la "$target"; fail "leaves only the verified .sig visible in DIR when stopped mid-placement ($target)"; }
  cmp -s "$target/foo-1-1-any.pkg.tar.zst.sig" "$srv/foo-1-1-any.pkg.tar.zst.sig" \
    || fail "placed the new verified .sig before stopping ($target)"
  stages=("$target"/.fetch-published.*)
  [[ ${#stages[@]} -eq 1 && -f ${stages[0]}/pkg ]] \
    || { ls -la "$target"; fail "cleanup leaves unplaced staged files in the hidden stage rather than deleting named files in DIR ($target)"; }
done
pass "fetch-published locks DIR, stages downloads outside DIR, keeps existing verified pairs on failure, and places .sig before the package"

# --- build-packages and build-rootfs --local ---
mv "$R/keys/panther" "$t/panther-key"
if run tools/build-packages --local panther packages/omamobile-device-panther; then fail "build-packages --local refuses without the local key"; fi
grep -q 'no local key in keys/panther' "$t/log" || { cat "$t/log"; fail "says the local key is missing"; }
mkdir -p "$R/keys/gnupg" "$R/keys/gnupg.release" && echo "$signer" > "$R/keys/fingerprint" && echo "$signer" > "$R/keys/fingerprint.release"
if run tools/build-packages --local panther packages/omamobile-device-panther; then fail "build-packages --local never falls back to keys/"; fi
if run tools/build-packages --local nosuch packages/omamobile-device-panther; then fail "build-packages --local refuses an unknown codename"; fi
[[ ! -e $R/out/repo ]] || fail "build-packages --local made nothing in out/repo"
pass "build-packages --local refuses without keys/NAME, and never uses keys/ or out/repo"

if (cd "$R" && DEVICE=cheetah tools/build-rootfs --local panther) > "$t/log" 2>&1; then fail "build-rootfs --local refuses another DEVICE"; fi
grep -q 'builds device panther, not DEVICE=cheetah' "$t/log" || { cat "$t/log"; fail "says the device does not match"; }
if run tools/build-rootfs --local panther; then fail "build-rootfs --local refuses without keys/panther/public.asc"; fi
grep -q 'no keys/panther/public.asc' "$t/log" || { cat "$t/log"; fail "says the public key is missing"; }
mv "$t/panther-key" "$R/keys/panther"
if run tools/build-rootfs --local panther; then fail "build-rootfs --local refuses without out/panther/repo"; fi
grep -q 'no \[omamobile\] repository in out/panther/repo' "$t/log" || { cat "$t/log"; fail "says out/panther/repo is missing"; }
pass "build-rootfs --local checks the device, the key and out/NAME/repo"

# --- build-packages --import ---
# A folder filled by hand with two files of one package: add_to_repo keeps
# one file per name, so the glob's order chose which, and foo 0.2.9 sorts
# after 0.2.10; one has another file name, so only its .PKGINFO says it
# is foo. The run stops and names both before it copies anything from
# the folder; a folder of different packages still imports, foo-utils
# beside foo among them (a name that begins with another). repo-add is a
# stand-in, as in tests/build-packages-host-tools: without pacman's, the
# tool would fetch it from the Arch Linux ARM tarball
command -v bsdtar >/dev/null || command -v zstd >/dev/null || { pass "# skip: no bsdtar or zstd"; exit 0; }
mkpkg() {  # mkpkg DIR NAME VER-REL [FILE [ARCH]]: a package file (NAME-VER-REL-any.pkg.tar.zst) with its .PKGINFO
  local file=$1/${4:-$2-$3-any.pkg.tar.zst}
  mkdir -p "$t/pkginfo" "$1"
  printf 'pkgname = %s\npkgver = %s\narch = %s\n' "$2" "$3" "${5:-any}" > "$t/pkginfo/.PKGINFO"
  if command -v bsdtar >/dev/null; then bsdtar --zstd -cf "$file" -C "$t/pkginfo" .PKGINFO
  else tar --zstd -cf "$file" -C "$t/pkginfo" .PKGINFO; fi
}
mksigned() { mkpkg "$@"; sign signer "$1/${4:-$2-$3-any.pkg.tar.zst}"; }
mkdir -p "$t/bin-import"
printf '#!/bin/bash\nwhile [[ $1 == -* ]]; do [[ $1 == --key ]] && shift; shift; done\ntouch "$1"; ln -sf "$1" omamobile.db\n' > "$t/bin-import/repo-add"
chmod +x "$t/bin-import/repo-add"
r=$R/out/panther/repo/aarch64
# Two folders, the fault in the second: every folder is checked before the
# first is copied, so the first folder's packages stay out too, and the
# folder the checks copy into is gone
mksigned "$t/first" foo 0.2.10-1 && mksigned "$t/first" bar 1-1
mksigned "$t/pair" baz 1.9-1 && mksigned "$t/pair" baz 1.10-1
mksigned "$t/arch" baz 1-1 baz-1-1-x86_64.pkg.tar.zst x86_64
mksigned "$t/nameless" "" 1-1 nameless-1-1-any.pkg.tar.zst
# A package cut short, as an interrupted copy leaves it: a .PKGINFO longer
# than one tar block, cut after that block, so the reader prints pkgname and
# arch and then fails (a plain tar, which both readers take: the suite may
# have no zstd program to compress it)
{ printf 'pkgname = baz\npkgver = 1-1\narch = any\n'; printf '#%0600d\n' 0; } > "$t/pkginfo/.PKGINFO"
if command -v bsdtar >/dev/null; then bsdtar --format=ustar -cf "$t/cut.tar" -C "$t/pkginfo" .PKGINFO
else tar --format=ustar -cf "$t/cut.tar" -C "$t/pkginfo" .PKGINFO; fi
mkdir -p "$t/cut" && head -c 1024 "$t/cut.tar" > "$t/cut/baz-1-1-any.pkg.tar.zst"
sign signer "$t/cut/baz-1-1-any.pkg.tar.zst"
for bad in pair arch nameless cut; do
  case $bad in
    pair) what="two files of one package" want="$t/pair has two files of baz" ;;
    arch) what="an x86_64 package" want="$t/arch/baz-1-1-x86_64.pkg.tar.zst is not an aarch64 package" ;;
    nameless) what="a package with no pkgname" want="$t/nameless/nameless-1-1-any.pkg.tar.zst has no pkgname in its .PKGINFO" ;;
    cut) what="a package cut short" want="$t/cut/baz-1-1-any.pkg.tar.zst is not a package archive that can be read" ;;
  esac
  if run env PATH="$t/bin-import:$PATH" tools/build-packages --local panther --import "$t/first" --import "$t/$bad"; then cat "$t/log"; fail "--import refuses a second folder with $what"; fi
  grep -qF "$want" "$t/log" || { cat "$t/log"; fail "says why a second folder with $what is refused"; }
  [[ -z $(ls -A "$r" 2>/dev/null) ]] || { ls -A "$r"; cat "$t/log"; fail "copies nothing from either folder and writes no index ($what in the second)"; }
  [[ $(ls -A "$R/out/panther/repo") == aarch64 ]] || { ls -A "$R/out/panther/repo"; fail "leaves no folder of its own beside the repository ($what in the second)"; }
done
pass "build-packages --import checks every folder before the first copy: two files of one package, an x86_64 package, one with no pkgname, or one cut short, in the second adds nothing"
mksigned "$t/same" foo 0.2.9-1 renamed-0.2.9-1-any.pkg.tar.zst && mksigned "$t/same" foo 0.2.10-1 && mksigned "$t/same" bar 1-1
if run env PATH="$t/bin-import:$PATH" tools/build-packages --local panther --import "$t/same"; then cat "$t/log"; fail "--import refuses a folder with two files of one package"; fi
line=$(grep -F 'two files of foo' "$t/log") || { cat "$t/log"; fail "says the folder has two files of foo"; }
[[ $line == *renamed-0.2.9-1-any.pkg.tar.zst* && $line == *foo-0.2.10-1-any.pkg.tar.zst* ]] || { cat "$t/log"; fail "names both files of foo"; }
[[ -z $(ls -A "$r" 2>/dev/null) ]] || { ls -A "$r"; fail "copies nothing from the folder and writes no index"; }
pass "build-packages --import stops on two files of one package in a folder, names both, and adds nothing"
mksigned "$t/different" foo 0.2.10-1 && mksigned "$t/different" foo-utils 1-1 && mksigned "$t/different" bar 1-1
run env PATH="$t/bin-import:$PATH" tools/build-packages --local panther --import "$t/different" \
  || { cat "$t/log"; fail "--import takes a folder of different packages"; }
gpgconf --homedir "$R/keys/panther/gnupg" --kill gpg-agent 2>/dev/null || true
[[ -f $r/foo-0.2.10-1-any.pkg.tar.zst && -f $r/foo-utils-1-1-any.pkg.tar.zst && -f $r/bar-1-1-any.pkg.tar.zst && -e $r/omamobile.db ]] \
  || { ls -A "$r"; cat "$t/log"; fail "all three packages and the index are in the repository"; }
for f in foo-0.2.10-1-any.pkg.tar.zst foo-utils-1-1-any.pkg.tar.zst bar-1-1-any.pkg.tar.zst; do
  cmp -s "$t/different/$f.sig" "$r/$f.sig" || fail "keeps $f.sig byte for byte in the repository"
done
pass "build-packages --import still takes a folder of different packages, foo and foo-utils among them, keeping each .sig byte for byte"
# Two folders that both import, each with a package found in no other
# folder, so both must be copied. A cp on PATH, at the first copy into the
# repository (after the checks), moves an x86_64 package into the second
# folder and writes an x86_64 archive over the second folder's grault, in
# place: neither reaches the repository, because what goes in is the copy
# that was checked
mksigned "$t/first" corge 1-1 && mksigned "$t/different" grault 1-1
late=qux-1-1-x86_64.pkg.tar.zst && mkpkg "$t/late" qux 1-1 "$late" x86_64 && mkdir -p "$t/bin-late"
mkpkg "$t/late" zed 1-1 zed.pkg.tar.zst x86_64
printf '#!/bin/bash\ncommand -p cp "$@" || exit\n[[ ${!#} == */repo/aarch64/* && -e %q ]] || exit 0\nmv %q %q\ncommand -p cp %q %q\n' \
  "$t/late/$late" "$t/late/$late" "$t/different/" "$t/late/zed.pkg.tar.zst" "$t/different/grault-1-1-any.pkg.tar.zst" > "$t/bin-late/cp" && chmod +x "$t/bin-late/cp"
grault=$(sha256sum < "$t/different/grault-1-1-any.pkg.tar.zst")
run env PATH="$t/bin-late:$t/bin-import:$PATH" tools/build-packages --local panther --import "$t/first" --import "$t/different" \
  || { cat "$t/log"; fail "--import takes two folders of packages"; }
gpgconf --homedir "$R/keys/panther/gnupg" --kill gpg-agent 2>/dev/null || true
[[ -f $r/corge-1-1-any.pkg.tar.zst && -f $r/grault-1-1-any.pkg.tar.zst ]] || { ls -A "$r"; cat "$t/log"; fail "copies the packages of both folders"; }
[[ -f $t/different/$late && ! -e $r/$late ]] || { ls -A "$r" "$t/different"; cat "$t/log"; fail "copies only the files it checked (an x86_64 package that came after the checks)"; }
[[ $(sha256sum < "$t/different/grault-1-1-any.pkg.tar.zst") != "$grault" ]] || fail "the cp on PATH wrote an x86_64 archive over the second folder's grault"
[[ $(sha256sum < "$r/grault-1-1-any.pkg.tar.zst") == "$grault" ]] \
  || { cat "$t/log"; fail "copies the grault it checked, not the x86_64 archive written over it after the checks"; }
[[ $(ls -A "$R/out/panther/repo") == aarch64 ]] || { ls -A "$R/out/panther/repo"; fail "leaves no folder of its own beside the repository after an import"; }
pass "build-packages --import copies every folder, and only what it checked: not a file that came into a folder, or one put over a checked file, after the checks"

# Under --local, every imported package must carry a .sig that verifies
# against the staged package bytes with a trusted, unrevoked Omamobile key
# (the repository already holds the earlier good import above, and every
# refusal below must leave it byte for byte unchanged with no staging folder).
was=$(state "$r")
refuse_import() {  # refuse_import WHAT WANT PATH_VAL ARGS...
  local what=$1 want=$2 path=$3; shift 3
  if run env PATH="$path" tools/build-packages --local panther "$@"; then cat "$t/log"; fail "--local --import refuses $what"; fi
  grep -qF "$want" "$t/log" || { cat "$t/log"; fail "says why $what is refused"; }
  [[ $(state "$r") == "$was" ]] || { state "$r"; fail "leaves the repository unchanged after refusing $what"; }
  [[ $(ls -A "$R/out/panther/repo") == aarch64 ]] || { ls -A "$R/out/panther/repo"; fail "leaves no staging folder after refusing $what"; }
}
mkpkg "$t/sig-missing" nosig 1-1
mkpkg "$t/sig-foreign" foreign 1-1 && sign other "$t/sig-foreign/foreign-1-1-any.pkg.tar.zst"
mksigned "$t/sig-mismatch" mismatch 1-1 && printf 'changed' >> "$t/sig-mismatch/mismatch-1-1-any.pkg.tar.zst"
mkpkg "$t/sig-garbage" garbage 1-1 && printf 'not a pgp signature\n' > "$t/sig-garbage/garbage-1-1-any.pkg.tar.zst.sig"
mksigned "$t/sig-good" goodone 1-1
for bad in missing foreign mismatch garbage; do
  case $bad in
    missing) what="a package with no .sig" want="$t/sig-missing/nosig-1-1-any.pkg.tar.zst has no .sig" ;;
    foreign) what="a .sig from an untrusted key" want="$t/sig-foreign/foreign-1-1-any.pkg.tar.zst is not signed by a trusted, unrevoked Omamobile key" ;;
    mismatch) what="a .sig that does not match the package bytes" want="$t/sig-mismatch/mismatch-1-1-any.pkg.tar.zst is not signed by a trusted, unrevoked Omamobile key" ;;
    garbage) what="a garbage .sig" want="$t/sig-garbage/garbage-1-1-any.pkg.tar.zst is not signed by a trusted, unrevoked Omamobile key" ;;
  esac
  refuse_import "$what" "$want" "$t/bin-import:$PATH" --import "$t/sig-$bad"
done
# A key present in omamobile.gpg (so gpgv returns VALIDSIG) but not listed in
# omamobile-trusted must still be refused.
cp "$kr/omamobile.gpg" "$t/omamobile.gpg.orig"
GNUPGHOME=$t/other gpg --batch --armor --export >> "$kr/omamobile.gpg"
refuse_import "a key in omamobile.gpg not in omamobile-trusted" \
  "$t/sig-foreign/foreign-1-1-any.pkg.tar.zst is not signed by a trusted, unrevoked Omamobile key" \
  "$t/bin-import:$PATH" --import "$t/sig-foreign"
mv "$t/omamobile.gpg.orig" "$kr/omamobile.gpg"
# A key trusted in omamobile-trusted but listed in omamobile-revoked is refused,
# and a malformed omamobile-revoked stops the run before copying anything.
echo "$signer" > "$kr/omamobile-revoked"
refuse_import "a revoked key" \
  "$t/sig-good/goodone-1-1-any.pkg.tar.zst is not signed by a trusted, unrevoked Omamobile key" \
  "$t/bin-import:$PATH" --import "$t/sig-good"
echo "$signer:4:" > "$kr/omamobile-revoked"
refuse_import "a malformed omamobile-revoked" \
  "omamobile-revoked is malformed at line 1" \
  "$t/bin-import:$PATH" --import "$t/sig-good"
: > "$kr/omamobile-revoked"
# A bad .sig in the second of two folders keeps the first folder's good
# package out of the repository as well.
refuse_import "a bad .sig in the second folder" \
  "$t/sig-foreign/foreign-1-1-any.pkg.tar.zst is not signed by a trusted, unrevoked Omamobile key" \
  "$t/bin-import:$PATH" --import "$t/sig-good" --import "$t/sig-foreign"
# Missing gpgv is refused before anything is copied (using a clean PATH with
# no host fallback so host gpgv is never reached).
mkdir -p "$t/bin-nogpgv"
for cmd in bash dirname mkdir rm cat bsdtar tar zstd; do
  p=$(command -v "$cmd" 2>/dev/null) || continue
  ln -s "$p" "$t/bin-nogpgv/$cmd"
done
refuse_import "missing gpgv" \
  "verifying --local --import signatures needs gpgv" \
  "$t/bin-nogpgv" --import "$t/sig-good"
pass "build-packages --local --import verifies every staged .sig against trusted, unrevoked Omamobile keys, stops on malformed omamobile-revoked or missing gpgv, and leaves the repository unchanged on refusal"

# Verification must read the staged .sig copy, not DIR's .sig: a cp on PATH
# overwrites DIR's .sig with garbage right after it is copied into staging.
# The import still succeeds and the repository keeps the original good .sig.
mksigned "$t/sig-stage" staged 1-1 && cp "$t/sig-stage/staged-1-1-any.pkg.tar.zst.sig" "$t/staged-good.sig"
mkdir -p "$t/bin-stage-sig"
printf '#!/bin/bash\ncommand -p cp "$@" || exit\n[[ ${!#} == */import.*/*.sig ]] || exit 0\necho garbage > %q\n' \
  "$t/sig-stage/staged-1-1-any.pkg.tar.zst.sig" > "$t/bin-stage-sig/cp" && chmod +x "$t/bin-stage-sig/cp"
run env PATH="$t/bin-stage-sig:$t/bin-import:$PATH" tools/build-packages --local panther --import "$t/sig-stage" \
  || { cat "$t/log"; fail "--local --import verifies the staged .sig, not DIR's"; }
gpgconf --homedir "$R/keys/panther/gnupg" --kill gpg-agent 2>/dev/null || true
! cmp -s "$t/sig-stage/staged-1-1-any.pkg.tar.zst.sig" "$t/staged-good.sig" \
  || fail "the cp on PATH overwrote DIR's .sig with garbage after staging"
cmp -s "$r/staged-1-1-any.pkg.tar.zst.sig" "$t/staged-good.sig" \
  || fail "keeps the original good .sig byte for byte in the repository"
[[ $(ls -A "$R/out/panther/repo") == aarch64 ]] \
  || { ls -A "$R/out/panther/repo"; fail "leaves no staging folder after staged-.sig import"; }
pass "build-packages --local --import verifies the staged .sig copy rather than DIR's, keeping the staged .sig bytes in the repository"
