#!/bin/bash
# SPDX-License-Identifier: MIT
# Run the real builder with a small container stand-in: device namespaces,
# concurrent builds and failed-build cleanup, without an ARM image build.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
for tool in zstd flock; do command -v "$tool" >/dev/null || { echo "skip: no $tool"; exit 0; }; done
fail() { echo "not ok - $*" >&2; exit 1; }
t=$(mktemp -d)
pid=""
cleanup() { touch "$t/release"; [[ -z $pid ]] || wait "$pid" 2>/dev/null || true; rm -rf "$t"; }
trap cleanup EXIT
R=$t/repo
mkdir -p "$R/tools/lib" "$R/tests" "$R/out/repo/aarch64" "$t/bin" "$t/kernel/include/config"
cp tools/build-rootfs tools/make-bundle tools/install-phone tools/bundle-manifest "$R/tools/"
cp tools/lib/bundle-tar.sh "$R/tools/lib/"
touch "$R/out/repo/aarch64/omamobile.db" "$t/kernel/modules-fixture.tar.zst" "$t/alarm.tar"
echo fixture > "$t/kernel/include/config/kernel.release"
for device in first second; do
  mkdir -p "$R/device/$device"
  printf 'PACKAGE=omamobile-device-%s\nCODENAME=%s\nNAME="%s"\nBOOT_IMAGES="boot dtbo"\nUFS_RW="boot_b dtbo_b userdata"\nAVB_FOOTERS="boot:0x4000000"\nROOTFS_DIST_PACKAGES="fixture-dist"\n' "$device" "$device" "$device" > "$R/device/$device/device.conf"
done
cat > "$R/tools/lib/alarm.sh" <<'EOF'
alarm_die() { echo "$*" >&2; exit 1; }
alarm_say() { echo "$*"; }
alarm_fetch() { :; }
alarm_build_image() { echo fixture; }
EOF
cat > "$t/bin/git" <<'EOF'
#!/bin/sh
if [ "$1" = rev-parse ]; then echo fixture; fi
EOF
cat > "$t/bin/docker" <<'EOF'
#!/bin/bash
set -euo pipefail
[[ $1 == run ]] || exit 0
work="" device="" channel="" kernel_package="" distro=""
while (($#)); do
  case $1 in
    -v) [[ $2 != *:/out ]] || work=${2%:/out}; shift ;;
    -e) [[ $2 != DEVICE=* ]] || device=${2#DEVICE=}
        [[ $2 != CHANNEL=* ]] || channel=${2#CHANNEL=}
        [[ $2 != KERNEL_PACKAGE=* ]] || kernel_package=${2#KERNEL_PACKAGE=}
        [[ $2 != ROOTFS_DIST_PACKAGES=* ]] || distro=${2#ROOTFS_DIST_PACKAGES=}; shift ;;
  esac
  shift
done
[[ -n $work && -n $device ]]
if [[ ${BLOCK_BUILD:-0} == 1 ]]; then
  touch "$T/ready"
  for ((i=0; i<100; i++)); do
    [[ ! -e $T/release ]] || break
    sleep 0.1
  done
  [[ -e $T/release ]]
fi
[[ ${FAIL_BUILD:-0} != 1 ]] || exit 1
printf '%s\n' "$device" > "$work/rootfs.img"
printf '%s\n' "$kernel_package" > "$T/kernel-package.$device"
printf '%s\n' "$distro" > "$T/distro.$device"
printf 'device: %s\nomamobile channel: %s\ndistribution packages: %s\n' "$device" "$channel" "${distro:-none}" > "$work/MANIFEST"
EOF
cat > "$R/tests/rootfs-smoke" <<'EOF'
#!/bin/bash
set -euo pipefail
[[ ${FAIL_SMOKE:-0} != 1 ]] || exit 1
zstd -qt "$1"
[[ -s ${1%.img.zst}.MANIFEST ]]
EOF
chmod +x "$t/bin/"* "$R/tests/rootfs-smoke"
export T=$t PATH="$t/bin:$PATH" KERNEL_OUT=$t/kernel ALARM_CACHE=$t/cache ALARM_TARBALL=$t/alarm.tar OMARCHY_CHANNEL=stable
build() { DEVICE=$1 "$R/tools/build-rootfs" --version fixture "${@:2}"; }
BLOCK_BUILD=1 build first > "$t/first.log" 2>&1 & pid=$!
for ((i=0; i<100; i++)); do [[ ! -e $t/ready ]] || break; sleep 0.05; done
[[ -e $t/ready ]] || { cat "$t/first.log"; fail "first build reached the container"; }
if build first > "$t/duplicate.log" 2>&1; then fail "concurrent builds of one artifact are refused"; fi
grep -q 'already building' "$t/duplicate.log" || { cat "$t/duplicate.log"; fail "names the conflicting build"; }
build second > "$t/second.log" 2>&1 || { cat "$t/second.log"; fail "another device can build concurrently"; }
touch "$t/release"
wait "$pid" || { cat "$t/first.log"; fail "first build completes"; }; pid=""
for device in first second; do
  image=$R/out/omamobile-rootfs-$device-fixture-aarch64.img.zst
  [[ $(zstd -qdc "$image") == "$device" ]] || fail "distinct $device image"
  (cd "$R/out" && sha256sum -c "${image##*/}.sha256") >/dev/null
done
echo 'ok - different devices build concurrently; duplicate device/version is locked'

grep -Fx 'distribution packages: fixture-dist' "$R/out/omamobile-rootfs-first-fixture-aarch64.MANIFEST" >/dev/null || fail "distribution packages reach the image MANIFEST"
[[ $(cat "$t/distro.first") == fixture-dist ]] || fail "ROOTFS_DIST_PACKAGES reaches the container"
echo 'ok - ROOTFS_DIST_PACKAGES reaches the container and MANIFEST'

printf 'PACKAGE=omamobile-device-first\nCODENAME=first\nNAME="first"\nBOOT_IMAGES="boot dtbo"\nUFS_RW="boot_b dtbo_b userdata"\nROOTFS_DIST_PACKAGES="fixture;touch %s/injected"\n' "$t" > "$R/device/first/device.conf"
if build first > "$t/bad-packages.log" 2>&1; then fail "shell syntax in ROOTFS_DIST_PACKAGES is rejected"; fi
grep -q 'ROOTFS_DIST_PACKAGES may hold only package names' "$t/bad-packages.log" || { cat "$t/bad-packages.log"; fail "reports rejected distribution package syntax"; }
[[ ! -e $t/injected ]] || fail "distribution package text is never evaluated as shell"
printf 'PACKAGE=omamobile-device-first\nCODENAME=first\nNAME="first"\nBOOT_IMAGES="boot dtbo"\nUFS_RW="boot_b dtbo_b userdata"\nAVB_FOOTERS="boot:0x4000000"\nROOTFS_DIST_PACKAGES="fixture-dist"\n' > "$R/device/first/device.conf"
echo 'ok - invalid ROOTFS_DIST_PACKAGES shell characters are rejected without evaluation'

before=$(sha256sum "$R/out/omamobile-rootfs-first-fixture-aarch64.img.zst")
if FAIL_BUILD=1 build first > "$t/failed.log" 2>&1; then fail "container failure propagates"; fi
if FAIL_SMOKE=1 build first > "$t/failed.log" 2>&1; then fail "smoke failure propagates"; fi
[[ $(sha256sum "$R/out/omamobile-rootfs-first-fixture-aarch64.img.zst") == "$before" ]] || fail "failed rebuild preserves published image"
[[ -z $(find "$R/out" -maxdepth 1 -type d -name '.omamobile-rootfs-*') ]] || fail "temporary build directories are removed"
echo 'ok - failed rebuild preserves the previous image and removes only its own work'

mkdir -p "$R/keys/first" "$R/out/first/repo/aarch64"
touch "$R/keys/first/public.asc" "$R/out/first/repo/aarch64/omamobile.db"
build first --local first > "$t/local.log" 2>&1 || { cat "$t/local.log"; fail "local build"; }
[[ $(zstd -qdc "$R/out/first/omamobile-rootfs-first-fixture-aarch64.img.zst") == first ]] || fail "local image remains under out/first"
echo 'ok - --local keeps its device repository and output directory'

# The [omamobile] channel the image follows: stable by default, local for a
# contributor's --local image, development when asked, nothing else.
channel_of() { sed -n 's/^omamobile channel: //p' "$1"; }
[[ $(channel_of "$R/out/omamobile-rootfs-second-fixture-aarch64.MANIFEST") == stable ]] || fail "images follow stable by default"
[[ $(channel_of "$R/out/first/omamobile-rootfs-first-fixture-aarch64.MANIFEST") == local ]] || fail "--local images follow their own repository"
build second --channel development > "$t/channel.log" 2>&1 || { cat "$t/channel.log"; fail "a development image builds"; }
[[ $(channel_of "$R/out/omamobile-rootfs-second-fixture-aarch64.MANIFEST") == development ]] || fail "--channel development reaches the build"
if build second --channel edge > "$t/channel.log" 2>&1; then fail "refuses an unknown channel"; fi
grep -q 'stable, development or local' "$t/channel.log" || { cat "$t/channel.log"; fail "names the channels"; }
build second > "$t/channel.log" 2>&1 || { cat "$t/channel.log"; fail "rebuild on stable"; }
echo 'ok - the image follows stable by default, local with --local, development when asked'

# A device package that ships boot files gets the kernel as a package and
# the slot-B hook; one without them keeps the module tarball
mkdir -p "$R/packages/omamobile-device-second"
printf '#!/bin/bash\nboot=${OMAMOBILE_BOOT_FILES:-boot-files}\n' > "$R/packages/omamobile-device-second/install"
build second > "$t/kp.log" 2>&1 || { cat "$t/kp.log"; fail "a boot-files device builds"; }
[[ $(cat "$t/kernel-package.second") == 1 ]] || fail "a device package with boot files: KERNEL_PACKAGE=1 reaches the build"
build first > "$t/kp.log" 2>&1 || { cat "$t/kp.log"; fail "a device without boot files builds"; }
[[ $(cat "$t/kernel-package.first") == 0 ]] || fail "a device package without boot files: KERNEL_PACKAGE=0"
rm -rf "$R/packages/omamobile-device-second"
inside=rootfs/build-inside
grep -qF 'ours+=(omamobile-boot-update linux-omamobile)' "$inside" || fail "build-inside installs linux-omamobile and omamobile-boot-update with KERNEL_PACKAGE=1"
grep -qF '[[ $pkg_release == "$KERNEL_RELEASE" ]]' "$inside" || fail "build-inside checks the package's release is the boot images' (KERNEL_OUT's)"
awk '/linux-omamobile "\* \]\]; then/ {pkg = 1} pkg && /^else/ {exit} pkg && /zstd -dc \/modules/ {bad = 1} END {exit bad}' "$inside" \
  || fail "with the kernel package installed the tarball is not unpacked over its modules"
grep -qF '[[ $p == omamobile-boot-update ]] || kept+=("$p")' "$inside" || fail "without linux-omamobile (allowed missing) the hook is left out too"
grep -qF 'echo "kernel modules: $modules_line"' "$inside" || fail "the MANIFEST still names the release (make-bundle, install-phone, rootfs-smoke read it)"
grep -q 'OMAMOBILE_BOOT_FILES' packages/omamobile-device-cheetah/install || fail "cheetah's package ships boot files, so its image gets the kernel package"
echo 'ok - a device with boot files gets linux-omamobile and omamobile-boot-update (the package modules replace the tarball); others keep the tarball'

# Bundling must select this device even when another device sorts later.
mkdir -p "$t/kernel/images" "$R/packages/omamobile-keyring"
echo first > "$t/kernel/images/DEVICE"
echo boot > "$t/kernel/images/boot.img"
echo dtbo > "$t/kernel/images/dtbo.img"
echo public-key > "$R/packages/omamobile-keyring/omamobile.gpg"
# A bundle carries the install guide and phone-provision with its tools.
mkdir -p "$R/docs"; echo guide > "$R/docs/INSTALL.md"
for f in phone-provision nv-backup phone-ssh phone-ssh-proxy extract-vendor-firmware extract-vendor-chroot extract-fingerprint-vendor extract-camera-data; do
  printf '#!/bin/bash\n' > "$R/tools/$f"; chmod +x "$R/tools/$f"
done
bundle() { DEVICE=first "$R/tools/make-bundle" --unsigned --version fixture "$@"; }
bundle > "$t/bundle.log" 2>&1 || { cat "$t/bundle.log"; fail "bundling selects this device's image"; }
image=omamobile-rootfs-first-fixture-aarch64.img.zst
digest=$(sha256sum < "$R/out/$image" | cut -d' ' -f1)
grep -Fxq "root image: $image ($digest)" "$R/out/bundle/omamobile-first-fixture/MANIFEST" || fail "bundle records the selected image and its actual digest"
# manifest.json: the release as data, covered by SHA256SUMS
B=$R/out/bundle/omamobile-first-fixture
grep -Eq '^[0-9a-f]{64}  manifest\.json$' "$B/SHA256SUMS" || fail "SHA256SUMS covers manifest.json"
python3 -I - "$B" "$digest" "$image" <<'PY' || fail "manifest.json describes the bundle and its install plan"
import hashlib, json, os, sys
b, digest, image = sys.argv[1:]
m = json.load(open(os.path.join(b, "manifest.json")))
assert m["format"] == 1 and m["version"] == "fixture" and m["label"] == "developer preview", m
assert m["device"] == {"codename": "first", "name": "first"}
assert m["kernel"]["release"] == "fixture"
assert m["omamobile_channel"] == "stable"
assert m["base_url"] == "https://pkgs.omamobile.org/releases/first/fixture/"
listed = {f["path"]: f for f in m["files"]}
on_disk = sorted(os.path.relpath(os.path.join(d, n), b) for d, _, ns in os.walk(b) for n in ns)
assert sorted(listed) == [f for f in on_disk if f not in ("SHA256SUMS", "SHA256SUMS.sig", "manifest.json")], (sorted(listed), on_disk)
for path, f in listed.items():
    data = open(os.path.join(b, path), "rb").read()
    assert f["size"] == len(data) and f["sha256"] == hashlib.sha256(data).hexdigest(), path
assert m["root_image"]["name"] == image and m["root_image"]["sha256"] == digest
i = m["install"]
assert i["product"] == "first" and i["require_unlocked_bootloader"] is True and i["require_matching_bootloader_slots"] is True
assert [(w["partition"], w["source"]) for w in i["writes"]] == [("boot_b", "images/boot.img"), ("dtbo_b", "images/dtbo.img"), ("userdata", "root_image")]
assert i["writes"][0]["partition_size"] == 0x4000000 and i["writes"][1]["partition_size"] is None
assert i["writes"][2]["erases_userdata"] is True
assert i["after"] == ["set-active b", "reboot"] and i["storage_guard_allowlist"] == ["boot_b", "dtbo_b", "userdata"]
PY
grep -q 'DEVELOPER PREVIEW' "$B/README.txt" || fail "the README says developer preview"
grep -q 'stable channel' "$B/README.txt" || fail "the README names the channel"
if bundle --rootfs "$R/out/omamobile-rootfs-second-fixture-aarch64.img.zst" > "$t/bundle.log" 2>&1; then fail "bundling refuses another device's image"; fi
echo bad-checksum > "$R/out/$image.sha256"
if bundle > "$t/bundle.log" 2>&1; then fail "bundling refuses stale image checksum"; fi
grep -q "doesn't match its .sha256" "$t/bundle.log" || { cat "$t/bundle.log"; fail "bundling identifies the stale checksum"; }
echo 'ok - bundles select matching-device images and record verified bytes'

# Every image has Phone (with Contacts), Messages and their agent. The modem
# stack (omamobile-modem-sit, omamobile-mmd) is one phone's and never in the
# shared list; it comes with the modem through that device's ROOTFS_PACKAGES.
list=$(grep -v '^#' rootfs/packages.omamobile)
for p in omamobile-apps omaphone omamessages omatel-agent; do
  grep -qx "$p" <<<"$list" || fail "rootfs/packages.omamobile lists $p"
done
grep -qxE 'omamobile-(modem|modem-sit|mmd)' <<<"$list" && fail "no modem package in the shared rootfs/packages.omamobile"
echo 'ok - every image lists Phone, Messages and omatel-agent; no modem package in the shared list'
