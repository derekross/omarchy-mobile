#!/bin/bash
# SPDX-License-Identifier: MIT
# tools/phone-smoke's dmesg error classification, against saved error logs
# (--errors-from; no phone): known lines, counted lines with and without a
# ceiling, and a UFS link that doesn't come back failing kernel health; and
# from the laptop side, against a stand-in for the phone (PHONE_SSH): the
# device named from the repository's descriptors, or in a release bundle
# from its one device.conf.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
fail() { printf 'not ok - %s\n' "$1" >&2; printf '%s\n' "$out" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
run() { printf '%s\n' "$@" >"$t/log"; out=$(tools/phone-smoke --errors-from "$t/log"); }
has() { [[ $out == *"$1"* ]]; }

dais='[    9.123456] audio_playback0: ASoC: no backend DAIs enabled for audio_playback0, possibly missing ALSA mixer-based routing or UCM profile'
ufs='[  812.000001] exynos-ufshc 14700000.ufs: dme-set: attr-id 0x4021 val 0x1 failed 0 retries'

run 'Bluetooth: hci0: Failed to read codec capabilities (-56)'
has 'ok|1|kernel health|' && has '1 error lines in dmesg (1 known, 0 new)' && ! has 'new dmesg errors' \
  || fail "a known line is known"
pass "a known line is known"

run "$dais"
has 'ok|1|kernel health|' && has '(1 known, of them ASoC no backend DAIs (PipeWire probe) x1, 0 new)' \
  && ! has 'new dmesg errors' || fail "one no-backend-DAIs line (PipeWire's probe) is known and counted"
pass "one no-backend-DAIs line (PipeWire's probe) is known and counted"

run "$dais" "$dais" "$dais"
has 'ASoC no backend DAIs (PipeWire probe) x3' && has '(1 known' && has '2 new)' \
  && has 'not ok|0|new dmesg errors|N: ASoC: no backend DAIs enabled for N' && has ' x2' \
  || fail "no-backend-DAIs lines past the first are new (a broken UCM route)"
pass "no-backend-DAIs lines past the first are new (a broken UCM route)"

lines=(); for _ in $(seq 14); do lines+=("$ufs"); done
run "${lines[@]}"
has 'ok|1|kernel health|' && has '(14 known, of them UFS dme-set 0x4021 (s2idle) x14, 0 new)' \
  && ! has 'new dmesg errors' || fail "the s2idle UFS dme-set lines are known and stay counted"
pass "the s2idle UFS dme-set lines are known and stay counted"

cp1='[   15.088089] cpif: rx_demux: PCIE: ERR! umts_ipc1 is not opened'
cp2='[   15.088401] cpif: io_dev_recv_skb_single_from_link_dev: umts_ipc1<-PCIE: ERR! rx_demux fail (err -19)'
cp3='[   15.088670] cpif: pass_skb_to_demux: PCIE: umts_ipc1<-s5300: ERR! umts_ipc1->recv_skb fail (-19)'
run "$cp1" "$cp2" "$cp3" "${cp1/umts_ipc1/oem_ipc0}" "${cp1/umts_ipc1/umts_router}"
has 'ok|1|kernel health|' && has '(5 known, of them cpif message for a channel nobody opened x5, 0 new)' \
  && ! has 'new dmesg errors' || fail "CPIF's lines for channels nothing opens are known and stay counted"
pass "CPIF's lines for channels nothing opens are known and stay counted"
run "${cp1/umts_ipc1/umts_ipc0}" "${cp2//umts_ipc1/umts_ipc0}" "${cp3//umts_ipc1/umts_ipc0}"
has '0 known, 3 new' && has 'new dmesg errors' || fail "a message dropped on the phone service's own channel (umts_ipc0) is new"
pass "a message dropped on the phone service's own channel (umts_ipc0) is new"

run "${ufs/0x4021/0x1561}"
has '0 known, 1 new' && has 'new dmesg errors' || fail "a dme-set of another attribute is new"
pass "a dme-set of another attribute is new"

# The kernel's own formats: ufshcd.c's dev_err "link startup failed %d" and
# "%s: Host init failed %d", blk-mq.c's "%s error, dev %s, sector ...",
# buffer.c's "Buffer I/O error on dev %pg, ...".
for dead in 'exynos-ufshc 14700000.ufs: link startup failed 1' \
            'exynos-ufshc 14700000.ufs: ufshcd_host_reset_and_restore: Host init failed 1' \
            'I/O error, dev sda, sector 123456 op 0x0:(READ) flags 0x80700 phys_seg 1 prio class 2' \
            'Buffer I/O error on dev sda34, logical block 0, async page read'; do
  run "$ufs" "$dead"
  has 'not ok|1|kernel health|UFS didn'"'"'t come back (1 link startup' || fail "UFS that doesn't come back fails: $dead"
done
pass "a UFS link startup, host init or sd I/O error fails kernel health beside the known dme-set"

# Not UFS: the chroots' loop devices and the PCIe core stay ordinary new errors.
for other in 'I/O error, dev loop3, sector 2048 op 0x0:(READ) flags 0x0 phys_seg 1 prio class 2' \
             'Buffer I/O error on dev loop2, logical block 0, async page read' \
             'F2FS-fs (loop4): I/O error' \
             'gs201-pcie 11920000.pcie: Host init failed: -110'; do
  run "$other"
  has 'ok|1|kernel health|' && ! has "didn't come back" && has '0 known, 1 new' && has 'new dmesg errors' \
    || fail "a line that isn't UFS stays an ordinary new error: $other"
done
pass "loop-device and PCIe errors stay ordinary new errors, not a dead UFS"

run "$dais" "$ufs" "$ufs" 'some driver: something new broke'
has 'of them ASoC no backend DAIs (PipeWire probe) x1, UFS dme-set 0x4021 (s2idle) x2, 1 new)' \
  && has 'new dmesg errors|some driver: something new broke x1' || fail "counted and new lines together"
pass "counted and new lines together"

# From the laptop: PHONE_SSH stands in for the phone. It answers the
# compatible question and records what the smoke run was started with.
printf '%s\n' '#!/bin/bash' 'case $1 in' '  tr*) echo "$COMPAT" ;;' \
  '  *) cat >/dev/null; echo "$1" > "$LOG"; echo "{}" ;;' 'esac' > "$t/phone"
chmod +x "$t/phone"
conf=device/cheetah/device.conf
codename=$(sed -n 's/^CODENAME="\{0,1\}\([a-z0-9]*\)"\{0,1\}$/\1/p' "$conf")
compat=$(sed -n 's/^COMPATIBLE="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$conf" | awk '{print $1}')
out=$(COMPAT=$compat LOG=$t/started PHONE_SSH=$t/phone tools/phone-smoke --json 2>"$t/err") || fail "the laptop side runs through PHONE_SSH"
[[ ! -s $t/err ]] || { cat "$t/err" >&2; fail "the laptop side prints no error of its own (no descriptor that isn't there is read)"; }
grep -c "SMOKE_DEVICE=$codename .*bash -s -- --here --json" "$t/started" >/dev/null || fail "the device is named from the repository's descriptors"
pass "from the laptop, through PHONE_SSH, the device comes from the descriptors"

# A release bundle: tools/phone-smoke beside the bundle's one device.conf
mkdir -p "$t/bundle/tools"
cp tools/phone-smoke "$t/bundle/tools/"
printf 'CODENAME=bundledev\nCOMPATIBLE="vendor,bundle-board"\n' > "$t/bundle/device.conf"
out=$(COMPAT=vendor,bundle-board LOG=$t/started PHONE_SSH=$t/phone bash "$t/bundle/tools/phone-smoke" --json) || fail "phone-smoke runs from a bundle"
grep -c 'SMOKE_DEVICE=bundledev ' "$t/started" >/dev/null || fail "in a bundle the device is its device.conf's"
out=$(COMPAT=vendor,other-board LOG=$t/started PHONE_SSH=$t/phone bash "$t/bundle/tools/phone-smoke" --json) || fail "phone-smoke runs for an unknown board"
grep -c 'SMOKE_DEVICE=unknown ' "$t/started" >/dev/null || fail "a board that isn't the bundle's is unknown"
pass "in a release bundle the device is the bundle's device.conf"
