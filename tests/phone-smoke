#!/bin/bash
# SPDX-License-Identifier: MIT
# tools/phone-smoke's dmesg error classification, against saved error logs
# (--errors-from; no phone): known lines, counted lines with and without a
# ceiling, and a UFS link that doesn't come back failing kernel health; and
# from the laptop side, against a stand-in for the phone (PHONE_SSH): the
# device named from the repository's descriptors, or in a release bundle
# from its one device.conf. The boot and guard rows against a fake root
# (--slot-from): the slot boot-update.conf names, b when absent, and the
# running slot's boot images.
# And its two systemd unit rows (--unit-rows) against stand-ins for
# systemctl, journalctl and loginctl: this boot's failed units, and the units
# that failed on the install's first boot, found in the journal by the boot
# omamobile-firstboot ran in, also after later boots.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
fail() { printf 'not ok - %s\n' "$1" >&2; printf '%s\n' "$out" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
run() { printf '%s\n' "$@" >"$t/log"; out=$(tools/phone-smoke --errors-from "$t/log"); }
has() { [[ $out == *"$1"* ]]; }

dais='[    9.123456] audio_playback0: ASoC: no backend DAIs enabled for audio_playback0, possibly missing ALSA mixer-based routing or UCM profile'
ufs='[  812.000001] exynos-ufshc 14700000.ufs: dme-set: attr-id 0x4021 val 0x1 failed 0 retries'

run 'Bluetooth: hci0: Failed to read codec capabilities (-56)'
has 'ok|1|kernel health|' && has '1 error lines in dmesg (1 known, 0 new)' && ! has 'new dmesg errors' \
  || fail "a known line is known"
pass "a known line is known"

run "$dais"
has 'ok|1|kernel health|' && has '(1 known, of them ASoC no backend DAIs (PipeWire probe) x1, 0 new)' \
  && ! has 'new dmesg errors' || fail "one no-backend-DAIs line (PipeWire's probe) is known and counted"
pass "one no-backend-DAIs line (PipeWire's probe) is known and counted"

run "$dais" "$dais" "$dais"
has 'ASoC no backend DAIs (PipeWire probe) x3' && has '(1 known' && has '2 new)' \
  && has 'not ok|0|new dmesg errors|N: ASoC: no backend DAIs enabled for N' && has ' x2' \
  || fail "no-backend-DAIs lines past the first are new (a broken UCM route)"
pass "no-backend-DAIs lines past the first are new (a broken UCM route)"

run '[  301.000001] cpif: ap_wakeup_handler: cp2ap_wakeup work pending. gpio_val : 1' \
    '[  301.010002] cpif: s5100_pm_notifier: cp2ap_wakeup work resume. gpio_val : 1'
has 'ok|1|kernel health|' && has 'modem wakes from sleep (cp2ap_wakeup) x2' && has '0 new)' \
  && ! has 'new dmesg errors' || fail "a modem-woken sleep's CPIF lines are known and counted"
pass "a modem-woken sleep's CPIF lines are known and counted"

tools/phone-smoke --refused-only 3 3 -16 && tools/phone-smoke --refused-only 1 4 -16 \
  || { out="refused-only"; fail "every failed suspend a guard refusal: the unit is known"; }
pass "every failed suspend a guard refusal: the unit is known"
! tools/phone-smoke --refused-only 4 3 -16 && ! tools/phone-smoke --refused-only 2 0 -16 \
  && ! tools/phone-smoke --refused-only 1 1 -5 && ! tools/phone-smoke --refused-only "" 1 -16 \
  || { out="refused-only"; fail "a failure beyond the refusals, none, another errno or no count: the unit still counts"; }
pass "a failure beyond the refusals, none, another errno or no count: the unit still counts"

lines=(); for _ in $(seq 14); do lines+=("$ufs"); done
run "${lines[@]}"
has 'ok|1|kernel health|' && has '(14 known, of them UFS dme-set 0x4021 (s2idle) x14, 0 new)' \
  && ! has 'new dmesg errors' || fail "the s2idle UFS dme-set lines are known and stay counted"
pass "the s2idle UFS dme-set lines are known and stay counted"

cp1='[   15.088089] cpif: rx_demux: PCIE: ERR! umts_ipc1 is not opened'
cp2='[   15.088401] cpif: io_dev_recv_skb_single_from_link_dev: umts_ipc1<-PCIE: ERR! rx_demux fail (err -19)'
cp3='[   15.088670] cpif: pass_skb_to_demux: PCIE: umts_ipc1<-s5300: ERR! umts_ipc1->recv_skb fail (-19)'
run "$cp1" "$cp2" "$cp3" "${cp1/umts_ipc1/oem_ipc0}" "${cp1/umts_ipc1/umts_router}"
has 'ok|1|kernel health|' && has '(5 known, of them cpif message for a channel nobody opened x5, 0 new)' \
  && ! has 'new dmesg errors' || fail "CPIF's lines for channels nothing opens are known and stay counted"
pass "CPIF's lines for channels nothing opens are known and stay counted"
run "${cp1/umts_ipc1/umts_ipc0}" "${cp2//umts_ipc1/umts_ipc0}" "${cp3//umts_ipc1/umts_ipc0}"
has '0 known, 3 new' && has 'new dmesg errors' || fail "a message dropped on the phone service's own channel (umts_ipc0) is new"
pass "a message dropped on the phone service's own channel (umts_ipc0) is new"

rx='[  113.204101] cpif: rx_multi_pdp: PCIE: rmnet2<-s5300: ERR! netif_receive_skb'
run "$rx" "${rx/rmnet2/rmnet0}" "$rx"
has 'ok|1|kernel health|' && has '(3 known, of them cpif rmnet packet dropped as the link came up x3, 0 new)' \
  && ! has 'new dmesg errors' || fail "a few rmnet packets dropped as the modem link comes up are known and counted"
pass "a few rmnet packets dropped as the modem link comes up are known and counted"
lines=(); for _ in $(seq 7); do lines+=("$rx"); done
run "${lines[@]}"
has 'cpif rmnet packet dropped as the link came up x7' && has '(5 known' && has '2 new)' && has 'new dmesg errors' \
  || fail "rmnet drops past five in a boot are new"
pass "rmnet drops past five in a boot are new"
for other in "${rx/rmnet2/umts_ipc0}" "${rx/s5300/s5400}" "${rx/netif_receive_skb/netif_receive_skb fail -12}"; do
  run "$other"
  has '0 known, 1 new' && has 'new dmesg errors' || fail "a netif_receive_skb drop of another form is new: $other"
done
pass "netif_receive_skb drops on another channel, modem or form are new"

fq1='[    31.401220] F2FS-fs (loop2): Failed to enable quota tracking (type=0, err=-3). Please run fsck to fix.'
fq2='[    31.401298] F2FS-fs (loop2): Cannot turn on quotas: error -3'
run "$fq1" "$fq2" "${fq1/loop2/loop1}" "${fq2/loop2/loop1}" "${fq1/loop2/loop3}" "${fq2/loop2/loop3}"
has 'ok|1|kernel health|' && has '(6 known, of them f2fs quota off on the modem NV copies x6, 0 new)' \
  && ! has 'new dmesg errors' || fail "F2FS's quota lines on the modem NV copies' loop devices are known and counted"
pass "F2FS's quota lines on the modem NV copies' loop devices are known and counted"
for other in "${fq1/loop2/sda34}" "${fq2/error -3/error -5}" "${fq1/err=-3/err=-117}" 'F2FS-fs (loop2): Mismatch start address, segment0(512) cp_blkaddr(605)'; do
  run "$other"
  has '0 known, 1 new' && has 'new dmesg errors' || fail "another F2FS error, or one off a loop device, is new: $other"
done
pass "other F2FS errors, and quota errors off a loop device or with another error, are new"

run "${ufs/0x4021/0x1561}"
has '0 known, 1 new' && has 'new dmesg errors' || fail "a dme-set of another attribute is new"
pass "a dme-set of another attribute is new"

# The kernel's own formats: ufshcd.c's dev_err "link startup failed %d" and
# "%s: Host init failed %d", blk-mq.c's "%s error, dev %s, sector ...",
# buffer.c's "Buffer I/O error on dev %pg, ...".
for dead in 'exynos-ufshc 14700000.ufs: link startup failed 1' \
            'exynos-ufshc 14700000.ufs: ufshcd_host_reset_and_restore: Host init failed 1' \
            'I/O error, dev sda, sector 123456 op 0x0:(READ) flags 0x80700 phys_seg 1 prio class 2' \
            'Buffer I/O error on dev sda34, logical block 0, async page read'; do
  run "$ufs" "$dead"
  has 'not ok|1|kernel health|UFS didn'"'"'t come back (1 link startup' || fail "UFS that doesn't come back fails: $dead"
done
pass "a UFS link startup, host init or sd I/O error fails kernel health beside the known dme-set"

# Not UFS: the chroots' loop devices and the PCIe core stay ordinary new errors.
for other in 'I/O error, dev loop3, sector 2048 op 0x0:(READ) flags 0x0 phys_seg 1 prio class 2' \
             'Buffer I/O error on dev loop2, logical block 0, async page read' \
             'F2FS-fs (loop4): I/O error' \
             'gs201-pcie 11920000.pcie: Host init failed: -110'; do
  run "$other"
  has 'ok|1|kernel health|' && ! has "didn't come back" && has '0 known, 1 new' && has 'new dmesg errors' \
    || fail "a line that isn't UFS stays an ordinary new error: $other"
done
pass "loop-device and PCIe errors stay ordinary new errors, not a dead UFS"

run "$dais" "$ufs" "$ufs" 'some driver: something new broke'
has 'of them ASoC no backend DAIs (PipeWire probe) x1, UFS dme-set 0x4021 (s2idle) x2, 1 new)' \
  && has 'new dmesg errors|some driver: something new broke x1' || fail "counted and new lines together"
pass "counted and new lines together"

# The boot and storage guard rows (--slot-from: a fake root). The boot row
# wants the slot boot-update.conf names (b when absent); the guard row
# allows userdata and the running slot's five boot images.
fr=$t/fr
fakeroot() { # running suffix (or none), then the writable partitions
  rm -rf "$fr"; mkdir -p "$fr/proc" "$fr/etc/omamobile"
  echo '123.45 100.00' > "$fr/proc/uptime"
  [[ $1 == none ]] || printf 'androidboot.slot_suffix = "%s"\n' "$1" > "$fr/proc/bootconfig"
  echo 'console=ttynull' > "$fr/proc/cmdline"
  shift
  local i=0 p
  for p in boot_a init_boot_a vendor_boot_a vendor_kernel_boot_a dtbo_a boot_b init_boot_b vendor_boot_b vendor_kernel_boot_b dtbo_b userdata efs persist; do
    i=$((i + 1)); mkdir -p "$fr/sys/class/block/sda$i"; echo "$i" > "$fr/sys/class/block/sda$i/partition"
    printf 'PARTNAME=%s\n' "$p" > "$fr/sys/class/block/sda$i/uevent"
    if [[ " $* " == *" $p "* ]]; then echo 0; else echo 1; fi > "$fr/sys/class/block/sda$i/ro"
  done
}
rows() { out=$(tools/phone-smoke --slot-from "$fr"); }
B5="boot_b init_boot_b vendor_boot_b vendor_kernel_boot_b dtbo_b userdata"
A5="boot_a init_boot_a vendor_boot_a vendor_kernel_boot_a dtbo_a userdata"
fakeroot _b $B5; rows
has 'ok|1|boot|kernel ' && has ', slot b, up 123s' && has 'ok|1|storage guard|13 partitions; only userdata and slot b' \
  || fail "a development phone on slot B, no boot-update.conf: both rows pass as before"
pass "a development phone on slot B, no boot-update.conf: both rows pass as before"
echo 'AUTO_WRITE=yes' > "$fr/etc/omamobile/boot-update.conf"; rows
has 'ok|1|boot|' && has 'ok|1|storage guard|' || fail "a release on slot B whose boot-update.conf names no slot: b"
pass "a release on slot B whose boot-update.conf names no slot: b"
fakeroot _a $A5; printf 'AUTO_WRITE=yes\nSLOT=a\n' > "$fr/etc/omamobile/boot-update.conf"; rows
has 'ok|1|boot|' && has ', slot a, up' && has 'ok|1|storage guard|13 partitions; only userdata and slot a' \
  || fail "a release on slot A with SLOT=a: both rows pass"
pass "a release on slot A with SLOT=a: both rows pass"
fakeroot _a $A5; rows
has 'not ok|1|boot|' && has 'on slot a: our builds boot from slot b' || fail "slot A without SLOT=a fails the boot row"
pass "slot A without SLOT=a fails the boot row"
fakeroot _b $B5; printf 'SLOT="a"\n' > "$fr/etc/omamobile/boot-update.conf"; rows
has 'not ok|1|boot|' && has 'on slot b: boot-update.conf says SLOT=a' || fail "SLOT=a booted from slot B (a fallback) fails the boot row"
pass "SLOT=a booted from slot B (a fallback) fails the boot row"
fakeroot _a $A5; printf 'SLOT=a\nSLOT=a\n' > "$fr/etc/omamobile/boot-update.conf"; rows
has 'not ok|1|boot|' && has 'names SLOT 2 times' || fail "a second SLOT= line fails the boot row"
pass "a second SLOT= line fails the boot row"
fakeroot _a $A5 boot_b; printf 'SLOT=a\n' > "$fr/etc/omamobile/boot-update.conf"; rows
has 'not ok|1|storage guard|writable outside the allowlist: boot_b' || fail "on slot A, slot B's boot image writable fails the guard row"
fakeroot _b $B5 dtbo_a; rows
has 'not ok|1|storage guard|writable outside the allowlist: dtbo_a' || fail "on slot B, slot A's dtbo writable fails the guard row"
pass "the other slot's boot images writable fail the guard row, either way"
fakeroot none userdata; rows
has 'skip|1|boot|' && has 'ok|1|storage guard|13 partitions; only userdata writable' || fail "no slot named: the boot row skips, the guard allows userdata alone"
fakeroot none $B5; rows
has 'not ok|1|storage guard|writable outside the allowlist: ' && has ' boot_b ' || fail "no slot named: a writable boot image fails the guard row"
pass "no slot named: the boot row skips and only userdata may be writable"

# From the laptop: PHONE_SSH stands in for the phone. It answers the
# compatible question and records what the smoke run was started with.
printf '%s\n' '#!/bin/bash' 'case $1 in' '  tr*) echo "$COMPAT" ;;' \
  '  *) cat >/dev/null; echo "$1" > "$LOG"; echo "{}" ;;' 'esac' > "$t/phone"
chmod +x "$t/phone"
conf=device/cheetah/device.conf
codename=$(sed -n 's/^CODENAME="\{0,1\}\([a-z0-9]*\)"\{0,1\}$/\1/p' "$conf")
compat=$(sed -n 's/^COMPATIBLE="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$conf" | awk '{print $1}')
out=$(COMPAT=$compat LOG=$t/started PHONE_SSH=$t/phone tools/phone-smoke --json 2>"$t/err") || fail "the laptop side runs through PHONE_SSH"
[[ ! -s $t/err ]] || { cat "$t/err" >&2; fail "the laptop side prints no error of its own (no descriptor that isn't there is read)"; }
grep -c "SMOKE_DEVICE=$codename .*bash -s -- --here --json" "$t/started" >/dev/null || fail "the device is named from the repository's descriptors"
pass "from the laptop, through PHONE_SSH, the device comes from the descriptors"

# A release bundle: tools/phone-smoke beside the bundle's one device.conf
mkdir -p "$t/bundle/tools"
cp tools/phone-smoke "$t/bundle/tools/"
printf 'CODENAME=bundledev\nCOMPATIBLE="vendor,bundle-board"\n' > "$t/bundle/device.conf"
out=$(COMPAT=vendor,bundle-board LOG=$t/started PHONE_SSH=$t/phone bash "$t/bundle/tools/phone-smoke" --json) || fail "phone-smoke runs from a bundle"
grep -c 'SMOKE_DEVICE=bundledev ' "$t/started" >/dev/null || fail "in a bundle the device is its device.conf's"
out=$(COMPAT=vendor,other-board LOG=$t/started PHONE_SSH=$t/phone bash "$t/bundle/tools/phone-smoke" --json) || fail "phone-smoke runs for an unknown board"
grep -c 'SMOKE_DEVICE=unknown ' "$t/started" >/dev/null || fail "a board that isn't the bundle's is unknown"
pass "in a release bundle the device is the bundle's device.conf"

# --- the systemd unit rows ---------------------------------------------------
# Stand-ins on PATH: systemctl lists $t/failed-now as this boot's failed
# units; journalctl answers the two questions the first-boot row asks (which
# boots omamobile-firstboot ran in, oldest first, from $t/firstboot-boots;
# the "Unit failed with result" entries of one boot, from $t/failed.<boot
# id>) and fails on anything else; loginctl finds no desktop user
mkdir -p "$t/bin"
cat > "$t/bin/systemctl" <<EOF
#!/bin/bash
[[ " \$* " == *" --failed "* ]] || exit 1
cat "$t/failed-now" 2>/dev/null
EOF
cat > "$t/bin/journalctl" <<EOF
#!/bin/bash
echo "\$*" >> "$t/journalctl.calls"
case " \$* " in
  *" _SYSTEMD_UNIT=omamobile-firstboot.service + UNIT=omamobile-firstboot.service "*)
    [[ " \$* " == *" --output-fields=_BOOT_ID "* ]] || exit 1
    cat "$t/firstboot-boots" 2>/dev/null ;;
  *" MESSAGE_ID=d9b373ed55a64feb8242e02dbe79a49c "*)
    boot=\$(grep -oE '_BOOT_ID=[0-9a-f]{32}' <<<"\$*") || exit 1
    cat "$t/failed.\${boot#_BOOT_ID=}" 2>/dev/null ;;
  *) exit 1 ;;
esac
EOF
printf '#!/bin/sh\nexit 0\n' > "$t/bin/loginctl"
chmod +x "$t/bin/"*
units() { out=$(PATH="$t/bin:$PATH" tools/phone-smoke --unit-rows); }
first=$(printf first | md5sum | cut -c1-32) second=$(printf second | md5sum | cut -c1-32)
entry() { printf '{"__CURSOR":"s=x","%s":"%s","UNIT_RESULT":"exit-code","_BOOT_ID":"%s"}\n' "$1" "$2" "$first"; }

# A phone after its second boot: nothing failed now, and the first boot
# (the older of the two boots omamobile-firstboot's lines are in) had
# systemd-firstboot fail, as every install did before the image masked it
: > "$t/failed-now"
printf '%s\n' "$first" "$first" "$second" > "$t/firstboot-boots"
entry UNIT systemd-firstboot.service > "$t/failed.$first"
entry UNIT some-later.service | sed "s/$first/$second/" > "$t/failed.$second"
units
has 'ok|0|systemd units|none failed' || fail "nothing failed in this boot"
has 'not ok|0|first boot units|failed on the first boot: systemd-firstboot.service' ||
  fail "a unit that failed on the first boot is reported after a later boot"
has 'some-later' && fail "only the first boot's failures are the first boot's"
pass "a unit that failed on the first boot is reported after a later boot, from that boot's journal alone"

# The fixed image: nothing failed on the first boot
: > "$t/failed.$first"
units
has 'ok|0|first boot units|none failed on the first boot' || fail "a clean first boot is ok"
pass "a first boot with no failed unit is ok"

# Several, a user unit among them, each once; more than six are counted
{ entry UNIT b.service; entry UNIT a.service; entry UNIT b.service; entry USER_UNIT pipewire.service; } > "$t/failed.$first"
units
has 'not ok|0|first boot units|failed on the first boot: a.service, b.service, pipewire.service (user)' ||
  fail "failed units are listed once each, user units marked"
for i in 1 2 3 4 5 6 7 8; do entry UNIT "u$i.service"; done > "$t/failed.$first"
units
has 'failed on the first boot: u1.service, u2.service, u3.service, u4.service, u5.service, u6.service, and 2 more' ||
  fail "more than six failed units are counted, not all listed"
pass "failed units are listed once each, user units marked, a long list cut"

# No first boot in the journal (rotated away, or a hand-built system):
# skipped, never "ok"; and no journal query is made without a boot to ask for
: > "$t/firstboot-boots"; : > "$t/journalctl.calls"
units
has 'skip|0|first boot units|the first boot isn'"'"'t in the journal' || fail "without the first boot in the journal the row is skipped"
[[ $(grep -c MESSAGE_ID "$t/journalctl.calls") == 0 ]] || fail "no failed-unit query without a first boot"
pass "without the first boot in the journal the row is skipped"

# This boot's failed units, as before
printf '%s\n' "$first" > "$t/firstboot-boots"; : > "$t/failed.$first"
printf 'omamobile-modem.service loaded failed failed The modem\nfoo.mount loaded failed failed Foo\n' > "$t/failed-now"
units
has 'not ok|0|systemd units|failed: omamobile-modem.service foo.mount' || fail "this boot's failed units are listed"
has 'ok|0|first boot units|none failed on the first boot' || fail "this boot's failures aren't the first boot's"
pass "this boot's failed units and the first boot's are two rows"
