#!/bin/bash
# SPDX-License-Identifier: MIT
# The installer's tests (no phone, nothing flashed): tools/install-phone
# against a fake fastboot (and the ramdisk image it flashes against the one
# omamobile-boot-update builds), tools/phone-provision against a synthetic backup
# (and a container standing in for the phone, with Docker), tools/nv-backup
# against a stand-in phone tree,
# tools/phone-install-package against a stand-in phone, the initramfs's
# first-boot growth, the bring-up overlays, the simplefb trigger, the init's per-board steps, the storage guard's packed
# allowlist and the USB product string, no pipefail script piping into grep -q,
# bin/omamobile's boot-image layouts
# (and omamobile-boot-update building the same bytes on the phone)
# and flash against a fake fastboot, omamobile-firstboot's own tests, and the
# smoke test of the newest root image in out/ if there is one, the felix,
# lynx and panther device packages' own tests, tools/alarm-wake-test's
# check, and a contributor's local builds (tools/local-key-init,
# tools/fetch-published, --local), tools/publish-kernel against a scratch
# remote, tools/release's stages, the release key the maintainer signs with
# (tools/lib/signing.sh, build-packages --resign, repo-publish), the pinned
# upstream packages (rootfs/packages.pinned),
# tools/fetch-toolchain against local fixtures, tools/release-upload against
# a scratch server, tools/extract-camera-data's adrp decoding,
# tools/phone-smoke's dmesg error classification, the OWL conformance
# report's differences on the host, bin/lineage-ref sync's branch handling
# against stand-ins for docker and repo, tools/repo-publish --from-main's
# copy of the prebuilt binaries into a fixture's publish tree,
# tools/repo-publish's staging, tools/extract-vendor-firmware's output
# generations (made-up files, no factory image), the callers of
# tools/alpine-fetch.py stopping when it fails, and its dependency
# resolution against synthetic indexes, and the tools' --help from their
# header comments (tools/lib/usage.sh).
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
for f in tools/install-phone tools/phone-provision tools/nv-backup tools/build-rootfs tools/build-packages tools/make-bundle \
         tools/local-key-init tools/fetch-published tools/fetch-toolchain tools/repo-publish tools/repo-build tools/release tools/release-upload tools/server/releases-nginx.sh \
         tools/lib/alarm.sh tools/lib/alarm-setup tools/lib/signing.sh tools/lib/bundle-tar.sh tools/lib/usage.sh rootfs/build-inside rootfs/resolve.sh tests/*; do
  [[ -f $f ]] || continue   # tests/owl is the OWL conformance suite's folder
  [[ $f == *.py ]] && continue
  bash -n "$f" || { echo "not ok - $f parses" >&2; exit 1; }
done
python3 -I -c "import ast, sys; ast.parse(open(sys.argv[1]).read())" tools/bundle-manifest || { echo "not ok - tools/bundle-manifest parses" >&2; exit 1; }
sh -n initramfs/init
sh -n device/flame/initramfs/init
sh -n device/flame/initramfs/build
bash -n tools/build-flame-probe
echo "ok - scripts parse"
python3 tests/bt-uart-gpio.py
for t in tests/pr-check tests/kernel-pr-check tests/phone-smoke tests/alarm-wake-test tests/install-phone tests/build-rootfs tests/rootfs-resolve tests/phone-provision tests/nv-backup tests/initramfs-grow tests/images-layout tests/boot-update-parity tests/stage-boot-files tests/build-packages-host-tools tests/initramfs-reproducible tests/device-overlays tests/simplefb-trigger tests/initramfs-steps tests/storage-guard tests/usb-product tests/grep-q-pipes tests/boot-method tests/modules-push tests/make-bundle-keys tests/make-bundle tests/release-signing tests/pinned-packages tests/flame-probe packages/omamobile-firstboot/test/all packages/omamobile-device-felix/test/all packages/omamobile-device-lynx/test/all packages/omamobile-device-panther/test/all tests/local-builds tests/phone-install-package tests/publish-kernel tests/fetch-toolchain tests/release-upload tests/extract-camera-data tests/release tests/lineage-ref tests/repo-publish tests/repo-publish-stage tests/extract-vendor-firmware tests/alpine-fetch-callers tests/alpine-fetch tests/tools-help tests/install-phone-initramfs; do
  echo "# $t"
  "$t"
done
echo "# tests/owl/conformance-test.js"
if command -v node >/dev/null; then
  node tests/owl/conformance-test.js
else
  echo "ok - # skip: no node"
fi
shopt -s nullglob
latest=""
for f in out/omamobile-rootfs-*-aarch64.img.zst; do latest=$f; done
if [[ -n $latest ]]; then
  echo "# tests/rootfs-smoke $latest"
  tests/rootfs-smoke "$latest"
else
  echo "ok - # skip: no root image in out/ for tests/rootfs-smoke (tools/build-rootfs)"
fi

python3 tests/bluejay-root-ready.py
echo "# tests/phone-ssh"
tests/phone-ssh
echo "# tests/module-load-once"
tests/module-load-once
# One suite per line from here on, so two pull requests that each add one
# don't meet in the same line
echo "# tests/factory-index"   # the build index of Google's factory images, against a made-up zip
tests/factory-index
