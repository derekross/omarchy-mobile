#!/bin/bash
# SPDX-License-Identifier: MIT
# The installer's tests (no phone, nothing flashed): tools/install-phone
# against a fake fastboot, tools/phone-provision against a synthetic backup
# (and a container standing in for the phone, with Docker), the initramfs's
# first-boot growth, the simplefb trigger, the storage guard's packed
# allowlist and the USB product string, bin/omamobile's boot-image layouts
# and flash against a fake fastboot, omamobile-firstboot's own tests, and the
# smoke test of the newest root image in out/ if there is one.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
for f in tools/install-phone tools/phone-provision tools/build-rootfs tools/build-packages tools/make-bundle \
         tools/lib/alarm.sh tools/lib/alarm-setup rootfs/build-inside tests/*; do
  [[ -f $f ]] || continue   # tests/owl is the OWL conformance suite's folder
  if [[ $f == *.py ]]; then
    python3 -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' "$f"
  else
    bash -n "$f" || { echo "not ok - $f parses" >&2; exit 1; }
  fi
done
sh -n initramfs/init
sh -n device/flame/initramfs/init
sh -n device/flame/initramfs/build
bash -n tools/build-flame-probe tools/build-flame-system tools/build-flame-loader
sh -n device/flame/native/init device/flame/native/build
echo "ok - scripts parse"
for t in tests/install-phone tests/phone-provision tests/initramfs-grow tests/images-layout tests/simplefb-trigger tests/storage-guard tests/usb-product tests/boot-method tests/flame-probe tests/flame-images tests/flame-root-guard.py tests/flame-root-image.py tests/flame-boot-success.py tests/phone-ssh packages/omamobile-device-flame/test/all packages/omamobile-firstboot/test/all; do
  echo "# $t"
  if [[ $t == *.py ]]; then python3 "$t"; else "$t"; fi
done
shopt -s nullglob
latest=""
for f in out/omamobile-rootfs-*-aarch64.img.zst; do latest=$f; done
if [[ -n $latest ]]; then
  echo "# tests/rootfs-smoke $latest"
  tests/rootfs-smoke "$latest"
else
  echo "ok - # skip: no root image in out/ for tests/rootfs-smoke (tools/build-rootfs)"
fi
