#!/bin/bash
# SPDX-License-Identifier: MIT
# Tests for tools/release (docs/RELEASES.md §11) in a copy of the repository
# with a scratch kernel remote: no network, no Docker, no phone, no key; the
# real out/, keys/ and kernel trees are never touched. The version check, the
# stage order, the kernel stage's refusals (no tag, a lightweight tag, a
# worktree off the tag or dirty, no boot recorded) and its record, the
# identifier scan (real MACs, serial records, the builder's home and listed
# identifiers found; made-up MACs and example paths not), the packages stage refusing an index
# the release key didn't sign, the test-install record, and the tag stage
# refusing notes with placeholders.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; [[ ! -f ${t:-}/log ]] || cat "$t/log" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
for tool in git gpg gpgv python3 bsdtar repo-add; do
  command -v "$tool" >/dev/null || { pass "# skip: no $tool"; exit 0; }
done
t=$(mktemp -d)
export GNUPGHOME=$t/gnupg && mkdir -m 700 "$GNUPGHOME"
cleanup() { gpgconf --homedir "$GNUPGHOME" --kill gpg-agent 2>/dev/null || true; rm -rf "$t"; }
trap cleanup EXIT
export GIT_AUTHOR_NAME=Test GIT_AUTHOR_EMAIL=t@invalid GIT_COMMITTER_NAME=Test GIT_COMMITTER_EMAIL=t@invalid
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1

R=$t/repo
mkdir -p "$R/tools" "$R/device/testdev" "$R/packages/omamobile-keyring" "$R/rootfs" "$R/tests" "$R/out/repo/aarch64"
cp tools/release "$R/tools/"
cp tests/packages "$R/tests/"
cp packages/omamobile-keyring/omamobile.gpg "$R/packages/omamobile-keyring/"
printf 'CODENAME=testdev\nNAME="Test Phone"\nPACKAGE=omamobile-device-testdev\n' > "$R/device/testdev/device.conf"
echo "# Test phone notes" > "$R/device/testdev/NOTES.md"
printf 'omamobile-keyring\n' > "$R/rootfs/packages.omamobile"
export DEVICE=testdev KERNEL_BASE=$t/kbase RELEASE_KERNEL_DIR=$t/kbase/wt-release RELEASE_KERNEL_OUT=$t/kbase/out-release
run() { (cd "$R" && tools/release "$@") > "$t/log" 2>&1; }
V=2026.11.05

# --- the version and the stage order ---
if run --version 2026.13.01 status; then fail "a version that isn't a calendar date is refused"; fi
grep -q 'versioned by the calendar' "$t/log" || fail "says why the version is refused"
run --version "$V" status || fail "status on a new release"
grep -q "Next: tools/release --version $V kernel" "$t/log" || fail "status names the kernel stage first"
if run --version "$V" build; then fail "build before kernel is refused"; fi
grep -q 'stage kernel has not passed' "$t/log" || fail "says which stage comes first"
if run --version "$V" nonsense; then fail "an unknown stage is refused"; fi
pass "calendar versions only, and each stage needs the ones before it"

# --- the kernel stage, against a scratch remote ---
K=$t/kernel.git
git init -q --bare "$K"
git init -q "$t/ksrc"
git -C "$t/ksrc" commit -q --allow-empty -m "base"
git -C "$t/ksrc" commit -q --allow-empty -m "release"
commit=$(git -C "$t/ksrc" rev-parse HEAD)
git -C "$t/ksrc" push -q "$K" HEAD:refs/heads/omamobile
export PUBLISH_KERNEL_REMOTE=$K
if run --version "$V" --kernel-tag kernel-2026.11.05 kernel; then fail "no tag on the remote is refused"; fi
grep -q 'tools/publish-kernel --tag kernel-2026.11.05' "$t/log" || fail "says how to publish the tag"
git -C "$t/ksrc" tag kernel-2026.11.05 && git -C "$t/ksrc" push -q "$K" refs/tags/kernel-2026.11.05
if run --version "$V" kernel; then fail "a lightweight tag is refused"; fi
grep -q 'lightweight' "$t/log" || fail "says the tag is lightweight"
git -C "$t/ksrc" push -q "$K" :refs/tags/kernel-2026.11.05 && git -C "$t/ksrc" tag -d kernel-2026.11.05 >/dev/null
git -C "$t/ksrc" tag -a -m "Omarchy Mobile kernel 2026.11.05" kernel-2026.11.05 && git -C "$t/ksrc" push -q "$K" refs/tags/kernel-2026.11.05
if run --version "$V" kernel; then fail "a missing release worktree is refused"; fi
grep -q 'worktree add --detach' "$t/log" || fail "says how to make the release worktree"
git clone -q -b omamobile "$K" "$RELEASE_KERNEL_DIR"
git -C "$RELEASE_KERNEL_DIR" checkout -q --detach HEAD~1
if run --version "$V" kernel; then fail "a worktree off the tag is refused"; fi
grep -q "not kernel-2026.11.05" "$t/log" || fail "says the worktree is off the tag"
git -C "$RELEASE_KERNEL_DIR" checkout -q --detach "$commit"
echo dirty > "$RELEASE_KERNEL_DIR/tracked" && git -C "$RELEASE_KERNEL_DIR" add tracked
if run --version "$V" kernel; then fail "a dirty worktree is refused"; fi
grep -q 'local changes' "$t/log" || fail "says the worktree has changes"
git -C "$RELEASE_KERNEL_DIR" reset -q --hard
if run --version "$V" kernel; then fail "a kernel with no recorded boot is refused"; fi
grep -q "no note of a boot of g${commit:0:12}" "$t/log" || fail "asks for the boot record"
echo "Booted 7.3.0-rc6-omamobile-g${commit:0:12}: display, touch, Wi-Fi fine." >> "$R/device/testdev/NOTES.md"
run --version "$V" kernel || fail "the kernel stage passes with the tag, a clean worktree and a recorded boot"
grep -qx "kernel_commit=$commit" "$R/out/release/$V/state" || fail "records the tag's commit"
if run --version "$V" --kernel-tag kernel-2026.11.04 status; then fail "another kernel tag for a recorded release is refused"; fi
pass "the kernel stage refuses a missing or lightweight tag, a worktree off it or dirty, and an unrecorded boot"

# --- the identifier scan ---
mkdir -p "$t/scan"
printf 'serial-ABC123\nHome Net\n' > "$t/ids"
export RELEASE_IDENTIFIERS=$t/ids
printf 'made up: 02:11:22:33:44:55 00:00:00:00:00:00 ff:ff:ff:ff:ff:ff\nversion 1.2.3, example /home/user/x\n' > "$t/scan/clean.txt"
run scan "$t/scan" || fail "made-up MACs and plain text pass the scan"
# A universally administered address, put together here so this file holds none
mac=$(printf '%s:%s' 10:20:30 40:50:60)
for bad in "wlan0 $mac" 'androidboot.serialno=x' "built in /home/$(id -un)/src" 'device serial-ABC123 here' 'ssid=Home Net'; do
  printf '%s\n' "$bad" > "$t/scan/bad.bin"
  if run scan "$t/scan"; then fail "the scan finds: $bad"; fi
done
printf 'serial-ABC1234 is another word\n' > "$t/scan/bad.bin"
run scan "$t/scan" || fail "a listed identifier matches only as a whole word"
rm "$t/scan/bad.bin"
pass "the scan finds real MACs, serial records, the builder's home and listed identifiers, not made-up MACs or example paths"

# --- packages: only the release key's index ---
gpg --batch --quiet --passphrase '' --quick-gen-key "other <x@invalid>" ed25519 sign never >/dev/null 2>&1
other_fpr=$(gpg --batch --with-colons --list-keys 2>/dev/null | awk -F: '$1 == "fpr" { print $10; exit }')
mkdir -p "$t/pkg" "$R/packages/omamobile-keyring/test"
printf '#!/bin/sh\nexit 0\n' > "$R/packages/omamobile-keyring/test/all" && chmod +x "$R/packages/omamobile-keyring/test/all"
printf 'pkgname = omamobile-keyring\npkgbase = omamobile-keyring\npkgver = 1-1\narch = any\nsize = 1\n' > "$t/pkg/.PKGINFO"
(cd "$R/out/repo/aarch64" && bsdtar --zstd -cf omamobile-keyring-1-1-any.pkg.tar.zst -C "$t/pkg" .PKGINFO &&
  repo-add -q --sign --key "$other_fpr" omamobile.db.tar.gz omamobile-keyring-1-1-any.pkg.tar.zst) >/dev/null 2>&1 || true
if [[ -f $R/out/repo/aarch64/omamobile.db.tar.gz.sig ]]; then
  if run --version "$V" packages; then fail "an index another key signed is refused"; fi
  grep -q 'not signed by the release key' "$t/log" || fail "says the index isn't the release key's"
  pass "the packages stage refuses an index the release key didn't sign"
else
  pass "# skip: repo-add could not make a signed fixture"
fi

# --- test-install and tag, from recorded state ---
st=$R/out/release/$V/state
printf 'kernel_release=7.3.0-rc6-omamobile-g%s\nbuild_done=x\nbundle=out/bundle/x\nbundle_signed=0\n' "${commit:0:12}" >> "$st"
if run --version "$V" test-install --passed 7.3.0-rc6-omamobile-push1-gdeadbeef0000; then fail "another kernel than the release's is refused"; fi
if run --version "$V" test-install --passed "7.3.0-rc6-omamobile-g${commit:0:12}"; then fail "a test of an unsigned bundle is refused"; fi
grep -q 'tested bundle is unsigned' "$t/log" || fail "says the tested bundle was unsigned"
run --version "$V" --dry-run test-install || fail "the dry run prints the attended steps"
grep -q './install --dry-run' "$t/log" || fail "the steps start with the installer's dry run"
printf 'promote_done=x\nkernel_tag=kernel-2026.11.05\nidentifiers_done=clean\n' >> "$st"
mkdir -p "$R/docs/release-notes"
printf '# Omarchy Mobile 2026.MM.DD\nkernel-2026.11.05\n' > "$R/docs/release-notes/$V.md"
if run --version "$V" tag; then fail "notes with placeholders are refused"; fi
grep -q 'placeholders' "$t/log" || fail "says the notes have placeholders"
pass "test-install records only the release kernel on a signed bundle; tag refuses unfinished notes"
