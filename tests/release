#!/bin/bash
# SPDX-License-Identifier: MIT
# Tests for tools/release (docs/RELEASES.md §11) in a copy of the repository
# with a scratch kernel remote: no network, no Docker, no phone, no key; the
# real out/, keys/ and kernel trees are never touched. The version check, the
# stage order, the kernel stage's refusals (no tag, a lightweight tag, a
# worktree off the tag or dirty, no boot of the exact release in NOTES.md: a
# plan naming the commit, a -push1 or -dirty build don't count) and its
# record, the build stage refusing an output directory that holds a
# development kernel, the identifier scan (real MACs, serial records, the
# builder's home and listed identifiers found in files and symlink targets;
# missing, unreadable and unsupported inputs fail closed; made-up MACs and
# example paths pass), the packages stage refusing an index the release key
# didn't sign,
# test-install asking whether stable has an index before the attended steps
# (none: the one-time promotion; no answer: stop),
# the test-install record, the tag stage refusing notes with placeholders,
# the images stage keeping current boot files and asking for a device-package
# version bump before restaging stale ones (a stand-in stage-boot-files),
# the bundle check against a bundle laid out as make-bundle builds it
# (INSTALL.md and make-bundle's provision tools allowed, nothing else), and
# the upload stage running the real tools/release-upload --dry-run on a
# signed fixture bundle (throwaway key; ssh, rsync and curl are stubs that
# must not be called), and the identifiers stage failing closed on a missing,
# unreadable, corrupt, truncated or incomplete release initramfs while
# scanning a valid real-shaped one.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; [[ ! -f ${t:-}/log ]] || cat "$t/log" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
for tool in git gpg gpgv python3 bsdtar repo-add; do
  command -v "$tool" >/dev/null || { pass "# skip: no $tool"; exit 0; }
done
t=$(mktemp -d)
export GNUPGHOME=$t/gnupg && mkdir -m 700 "$GNUPGHOME"
cleanup() { gpgconf --homedir "$GNUPGHOME" --kill gpg-agent 2>/dev/null || true; chmod -R u+rwX "$t" 2>/dev/null || true; rm -rf "$t"; }
trap cleanup EXIT
export GIT_AUTHOR_NAME=Test GIT_AUTHOR_EMAIL=t@invalid GIT_COMMITTER_NAME=Test GIT_COMMITTER_EMAIL=t@invalid
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
# The maintainer's own build host and upload account must not leak in
unset BUILD_HOST BUILD_HOST_REPO OMAMOBILE_PKGS_HOST

R=$t/repo
mkdir -p "$R/tools/lib" "$R/device/testdev" "$R/packages/omamobile-keyring" "$R/rootfs" "$R/tests" "$R/out/repo/aarch64"
cp tools/release tools/release-upload tools/bundle-manifest tools/make-bundle "$R/tools/"
cp tools/lib/signing.sh "$R/tools/lib/"
cp tests/packages "$R/tests/"
cp packages/omamobile-keyring/omamobile.gpg "$R/packages/omamobile-keyring/"
printf 'CODENAME=testdev\nNAME="Test Phone"\nPACKAGE=omamobile-device-testdev\n' > "$R/device/testdev/device.conf"
echo "# Test phone notes" > "$R/device/testdev/NOTES.md"
printf 'omamobile-keyring\n' > "$R/rootfs/packages.omamobile"
export DEVICE=testdev KERNEL_BASE=$t/kbase RELEASE_KERNEL_DIR=$t/kbase/wt-release RELEASE_KERNEL_OUT=$t/kbase/out-kernel-release
run() { (cd "$R" && tools/release "$@") > "$t/log" 2>&1; }
V=2026.11.05

# --- the version and the stage order ---
if run --version 2026.13.01 status; then fail "a version that isn't a calendar date is refused"; fi
grep -q 'versioned by the calendar' "$t/log" || fail "says why the version is refused"
run --version "$V" status || fail "status on a new release"
grep -q "Next: tools/release --version $V kernel" "$t/log" || fail "status names the kernel stage first"
if run --version "$V" build; then fail "build before kernel is refused"; fi
grep -q 'stage kernel has not passed' "$t/log" || fail "says which stage comes first"
if run --version "$V" nonsense; then fail "an unknown stage is refused"; fi
pass "calendar versions only, and each stage needs the ones before it"

# --- the kernel stage, against a scratch remote ---
K=$t/kernel.git
git init -q --bare "$K"
git init -q "$t/ksrc"
printf 'kernelversion:\n\t@echo 7.3.0-rc6\n' > "$t/ksrc/Makefile"
git -C "$t/ksrc" add Makefile
git -C "$t/ksrc" commit -q -m "base"
git -C "$t/ksrc" commit -q --allow-empty -m "release"
commit=$(git -C "$t/ksrc" rev-parse HEAD)
git -C "$t/ksrc" push -q "$K" HEAD:refs/heads/omamobile
export PUBLISH_KERNEL_REMOTE=$K
if run --version "$V" --kernel-tag kernel-2026.11.05 kernel; then fail "no tag on the remote is refused"; fi
grep -q 'tools/publish-kernel --tag kernel-2026.11.05' "$t/log" || fail "says how to publish the tag"
git -C "$t/ksrc" tag kernel-2026.11.05 && git -C "$t/ksrc" push -q "$K" refs/tags/kernel-2026.11.05
if run --version "$V" kernel; then fail "a lightweight tag is refused"; fi
grep -q 'lightweight' "$t/log" || fail "says the tag is lightweight"
git -C "$t/ksrc" push -q "$K" :refs/tags/kernel-2026.11.05 && git -C "$t/ksrc" tag -d kernel-2026.11.05 >/dev/null
git -C "$t/ksrc" tag -a -m "Omamobile kernel 2026.11.05" kernel-2026.11.05 && git -C "$t/ksrc" push -q "$K" refs/tags/kernel-2026.11.05
if run --version "$V" kernel; then fail "a missing release worktree is refused"; fi
grep -q 'worktree add --detach' "$t/log" || fail "says how to make the release worktree"
git clone -q -b omamobile "$K" "$RELEASE_KERNEL_DIR"
git -C "$RELEASE_KERNEL_DIR" checkout -q --detach HEAD~1
if run --version "$V" kernel; then fail "a worktree off the tag is refused"; fi
grep -q "not kernel-2026.11.05" "$t/log" || fail "says the worktree is off the tag"
git -C "$RELEASE_KERNEL_DIR" checkout -q --detach "$commit"
echo dirty > "$RELEASE_KERNEL_DIR/tracked" && git -C "$RELEASE_KERNEL_DIR" add tracked
if run --version "$V" kernel; then fail "a dirty worktree is refused"; fi
grep -q 'local changes' "$t/log" || fail "says the worktree has changes"
git -C "$RELEASE_KERNEL_DIR" reset -q --hard
if run --version "$V" kernel; then fail "a kernel with no recorded boot is refused"; fi
krel=7.3.0-rc6-omamobile-g${commit:0:12}
grep -q "NOTES.md has no boot of $krel" "$t/log" || fail "asks for the boot record of the exact release"
# A plan's Expect line names the commit and even the release: not a result
printf '## Runbook\nExpect: uname -r is %s (g%s)\n' "$krel" "${commit:0:12}" > "$R/device/testdev/KERNEL-UPDATE-PLAN.md"
if run --version "$V" kernel; then fail "a plan naming the commit is not a recorded boot"; fi
grep -q "NOTES.md has no boot of $krel" "$t/log" || fail "a plan file is refused for want of a boot record"
# A development or dirty build of the same commit is not the release kernel
for other in "7.3.0-rc6-omamobile-push1-g${commit:0:12}" "7.3.0-rc6-omamobile-push1-00012-g${commit:0:12}" "$krel-dirty"; do
  cp "$R/device/testdev/NOTES.md" "$t/notes.saved"
  echo "Booted $other: display, touch, Wi-Fi fine." >> "$R/device/testdev/NOTES.md"
  if run --version "$V" kernel; then fail "a boot of $other does not count"; fi
  grep -q "NOTES.md has no boot of $krel" "$t/log" || fail "$other is refused for want of the release's boot"
  cp "$t/notes.saved" "$R/device/testdev/NOTES.md"
done
echo "Booted $krel: display, touch, Wi-Fi fine." >> "$R/device/testdev/NOTES.md"
run --version "$V" kernel || fail "the kernel stage passes with the tag, a clean worktree and a recorded boot"
grep -q 'booted and recorded in device/testdev/NOTES.md' "$t/log" || fail "names NOTES.md as the record"
grep -qx "kernel_commit=$commit" "$R/out/release/$V/state" || fail "records the tag's commit"
if run --version "$V" --kernel-tag kernel-2026.11.04 status; then fail "another kernel tag for a recorded release is refused"; fi
pass "the kernel stage refuses a missing or lightweight tag, a worktree off it or dirty, and a boot not recorded in NOTES.md as the exact release"

# --- build: the output directory is the release's own ---
O=$RELEASE_KERNEL_OUT
mkdir -p "$O/include/config"
echo "7.3.0-rc6-omamobile-push1-g${commit:0:12}" > "$O/include/config/kernel.release"
if run --version "$V" --dry-run build; then fail "an output directory holding a development kernel is refused"; fi
grep -q 'not a release build' "$t/log" || fail "says the directory holds a development kernel"
rm -rf "$O" && mkdir -p "$O" && echo x > "$O/something"
if run --version "$V" --dry-run build; then fail "a non-empty output directory without a kernel build is refused"; fi
rm -rf "$O" && mkdir -p "$O/include/config" && echo "$krel" > "$O/include/config/kernel.release"
run --version "$V" --dry-run build || fail "a previous release build in the output directory is fine"
grep -q 'would run: bin/omamobile kernel --release' "$t/log" || fail "the build runs bin/omamobile kernel --release"
grep -q 'linux-omamobile' "$t/log" || fail "the build says what happens to linux-omamobile"
rm -rf "$O"
pass "the build stage refuses an output directory that isn't a release build's"

# --- the identifier scan ---
mkdir -p "$t/scan"
printf 'serial-ABC123\nHome Net\n' > "$t/ids"
export RELEASE_IDENTIFIERS=$t/ids
printf 'made up: 02:11:22:33:44:55 00:00:00:00:00:00 ff:ff:ff:ff:ff:ff\nversion 1.2.3, example /home/user/x\n' > "$t/scan/clean.txt"
run scan "$t/scan" || fail "made-up MACs and plain text pass the scan"
# The documentation placeholder passes (2026.11.24: an example in Omarchy's
# omarchy-bluetooth-device); the next address up is still found. Built in
# pieces, as above, so this file holds neither.
printf '# examples: connect %s:%s\n' 00:11:22 33:44:55 > "$t/scan/example.sh"
run scan "$t/scan" || fail "the documentation placeholder address passes"
printf '# examples: connect %s:%s\n' 00:11:22 33:44:56 > "$t/scan/example.sh"
if run scan "$t/scan"; then fail "an address next to the placeholder is still found"; fi
rm "$t/scan/example.sh"
# A universally administered address, put together here so this file holds none
mac=$(printf '%s:%s' 10:20:30 40:50:60)
for bad in "wlan0 $mac" 'androidboot.serialno=x' "built in /home/$(id -un)/src" 'device serial-ABC123 here' 'ssid=Home Net'; do
  printf '%s\n' "$bad" > "$t/scan/bad.bin"
  if run scan "$t/scan"; then fail "the scan finds: $bad"; fi
done
printf 'serial-ABC1234 is another word\n' > "$t/scan/bad.bin"
run scan "$t/scan" || fail "a listed identifier matches only as a whole word"
rm "$t/scan/bad.bin"
# Other spellings of an address (review lesson L-634): after a label colon,
# with hyphens, in upper case, and as 12 bare hex digits in a MAC record,
# text or binary. RFC 7042's range is not exempt here. Built as above.
lam=02:00:00:00:00:01 doc=$(printf '%s:%s' 00:00:5e 00:53:01)
hy=${mac//:/-} bare=${mac//:/}
for bad in "mac:$mac" "tag:$mac" "id:$mac" "wlan0 at $hy" "HWaddr ${hy^^}" "mac=$bare" "bd_addr: $bare" \
  "\"mac_address\": \"${bare^^}\"" "Intf0MacAddress=$bare" "link/ether $bare" "mac-address $bare" "bd-addr=$bare" "hwaddr $bare" \
  "mac:$lam then mac:$hy" "mac:$doc"; do
  printf '%s\n' "$bad" > "$t/scan/bad.bin"
  if run scan "$t/scan"; then fail "the scan finds: $bad"; fi
done
printf 'x\0mac=%s\0y' "$bare" > "$t/scan/bad.bin"
if run scan "$t/scan"; then fail "the scan finds a bare MAC record between NUL bytes"; fi
grep -c "MAC address: $mac\$" "$t/log" >/dev/null || fail "the scan reports a bare MAC in the colon form"
dochy=${doc//:/-}
printf 'HWaddr %s\n' "${dochy^^}" > "$t/scan/bad.bin"
if run scan "$t/scan"; then fail "the scan finds: HWaddr ${dochy^^}"; fi
grep -c "MAC address: $doc\$" "$t/log" >/dev/null || fail "the scan reports an upper-case hyphenated MAC in the lower-case colon form"
for ok in "mac:$lam" "${lam//:/-}" "mac=${lam//:/}" "00-00-00-00-00-00" "macaddr=000000000000" "$mac:70" "a0:$mac" "$hy-70" "a0-$hy" "10:20-30:40-50:60" \
  "fe80::1020:3040:5060" "${bare:0:8}-5060-7080-90a0-$bare" "commit $bare${bare}1020304050607080" "build $bare" \
  "mac=${bare}7" "together $bare"; do
  printf '%s\n' "$ok" > "$t/scan/bad.bin"
  run scan "$t/scan" || fail "the scan passes: $ok"
done
# A hyphenated date and time, YY-MM-DD-HH-MM-SS, is a timestamp (#842), as
# in tools/pr-check; past a range's edge, with a hex letter, with colons or
# bare in a MAC record it is still an address, and it hides no address
# beside it, starting in its last field or after an exempt one that starts
# there. Built as above.
ts() { local IFS=-; echo "$*"; }
tc() { local IFS=:; echo "$*"; }
stamp=$(ts 25 11 15 10 20 30) uaa=$(ts 00 1a 2b 3c 4d 5e)
rest=${uaa#00-}
for ok in "screenshot-$stamp.png" "screenshot-$(ts 26 11 15 10 20 30).png" "$(ts 25 01 15 10 20 30)" "$(ts 25 12 15 10 20 30)" \
  "$(ts 25 11 01 10 20 30)" "$(ts 25 11 31 10 20 30)" "$(ts 25 11 15 00 00 00)" "$(ts 25 11 15 23 59 59)"; do
  printf '%s\n' "$ok" > "$t/scan/bad.bin"
  run scan "$t/scan" || fail "the scan passes: $ok"
done
for bad in "wlan0 at $uaa" "$(ts 25 00 15 10 20 30)" "$(ts 25 13 15 10 20 30)" "$(ts 25 11 00 10 20 30)" "$(ts 25 11 32 10 20 30)" \
  "$(ts 25 11 15 24 20 30)" "$(ts 25 11 15 10 60 30)" "$(ts 25 11 15 10 20 60)" "$(ts 2c 11 15 10 20 30)" "$(ts 25 1b 15 10 20 30)" \
  "$(ts 25 11 1d 10 20 30)" "$(ts 25 11 15 1f 20 30)" "$(ts 25 11 15 10 2e 30)" "$(ts 25 11 15 10 20 3a)" "${stamp//-/:}" "mac=${stamp//-/}" \
  "screenshot-$stamp.png wlan0 at $uaa" "$stamp:${rest//-/:}" "screenshot-$(ts 25 11 15 10 20 26):$(tc 1a 2b 3c 4d):$uaa" \
  "$(ts 25 11 15 10 20 32):$(tc 10 20 30 40):$(ts 50 1a 2b 3c 4d 5e)" "$(ts 25 11 15 10 20 26):$(tc 1a 2b 3c 4d):$(ts 50 1a 2b 3c 4d 5e)"; do
  printf '%s\n' "$bad" > "$t/scan/bad.bin"
  if run scan "$t/scan"; then fail "the scan finds: $bad"; fi
done
# Any other exempt address (all zeros, all ones, locally administered, or a
# chain of exempt addresses) hides no real address starting in its last field,
# in either separator direction or as a bare MAC record; overlapping real
# addresses report both, exempt overlaps and 7-octet runs still pass, and
# chains report each real address once.
restc=${rest//-/:}
for bad in "00-00-00-00-00-00:$restc" "00:00:00:00:00:00-$rest" \
  "02-00-00-00-00-00:$restc" "02:00:00:00:00:00-$rest" \
  "02-00-00-00-00-02:00:00:00:00:02-00-00-00-00-00:$restc" \
  "00-00-00-00-00-00:00:00:00:00:00-$rest" \
  "02-00-00-00-00-bd_addr $bare" "02:00:00:00:00:bd-addr $bare"; do
  printf '%s\n' "$bad" > "$t/scan/bad.bin"
  if run scan "$t/scan"; then fail "the scan finds: $bad"; fi
  grep -qx '    1 finding(s)' "$t/log" || fail "the scan reports once: $bad"
done
for bad in "$hy:$restc" "$mac-$rest"; do
  printf '%s\n' "$bad" > "$t/scan/bad.bin"
  if run scan "$t/scan"; then fail "the scan finds overlapping real addresses: $bad"; fi
  grep -qx '    2 finding(s)' "$t/log" || fail "the scan reports both overlapping real addresses: $bad"
done
for ok in "00-00-00-00-00-00:00:00:00:00:00" "ff-ff-ff-ff-ff-ff:ff:ff:ff:ff:ff" \
  "ff:ff:ff:ff:ff:ff-ff-ff-ff-ff-ff" "02-00-00-00-00-02:$restc" "02:00:00:00:00:02-$rest" \
  "$(ts 25 11 15 10 20 02):00:00:00:00:00" \
  "00-00-00-00-00-00:$restc:6f" "00:00:00:00:00:00-$rest-6f"; do
  printf '%s\n' "$ok" > "$t/scan/bad.bin"
  run scan "$t/scan" || fail "the scan passes: $ok"
done
rm "$t/scan/bad.bin"
# The holder of a copyright notice is named on purpose (2026.11.12: Omarchy's
# licence header in a patch). Only that form passes: the same name anywhere
# else on the line, or after other words, is still found.
printf '// Mobile touch changes: Copyright (c) 2026 Home Net\n' > "$t/scan/header.qml"
run scan "$t/scan" || fail "a listed name as the holder of a copyright notice passes"
for bad in 'Copyright (c) 2026 Home Net, built on Home Net' 'Copyright (c) 2026 by Home Net' 'copyright Home Net' 'ssid=Home Net # Copyright (c) 2026'; do
  printf '%s\n' "$bad" > "$t/scan/header.qml"
  if run scan "$t/scan"; then fail "the scan finds: $bad"; fi
done
rm "$t/scan/header.qml"
# A package archive is scanned by its files (2026.11.24: zstd stored a
# LICENSE's "Copyright (c) 2026 <name>" as "Copy (c) <name>"). A notice
# inside one passes, whatever the compressed bytes hold; a leak inside one
# is found and named by its member; a broken archive is an error.
mkdir -p "$t/pkg/usr/share/licenses/x" "$t/pkg/etc"
printf 'MIT License\n\nCopyright (c) 2026 Home Net\n\nPermission is hereby granted\n' > "$t/pkg/usr/share/licenses/x/LICENSE"
tar -C "$t/pkg" --zstd -cf "$t/scan/x-1-1-aarch64.pkg.tar.zst" usr
run scan "$t/scan" || fail "a copyright notice inside a package passes"
printf 'Copy (c) Home Net\n' | zstd -q --no-check -o "$t/scan/y-1-1-aarch64.pkg.tar.zst" 2>/dev/null || true
if run scan "$t/scan"; then fail "a package that isn't a tar archive is reported"; fi
grep -Fq "y-1-1-aarch64.pkg.tar.zst: unreadable package" "$t/log" || fail "the broken package is named as unreadable"
if grep -Fq "listed identifier" "$t/log"; then fail "a broken package is not scanned as raw bytes"; fi
rm "$t/scan/y-1-1-aarch64.pkg.tar.zst"
printf 'ssid=Home Net\n' > "$t/pkg/etc/net.conf"
tar -C "$t/pkg" --zstd -cf "$t/scan/x-1-1-aarch64.pkg.tar.zst" usr etc
if run scan "$t/scan"; then fail "a listed identifier inside a package is found"; fi
grep -Fq "x-1-1-aarch64.pkg.tar.zst!etc/net.conf: listed identifier: Home Net" "$t/log" || fail "the finding names the package's member"
rm "$t/scan/x-1-1-aarch64.pkg.tar.zst"
# dnsmasq's shipped example configuration (2026.11.08): its group address and
# a dhcp-option value pass in etc/dnsmasq.conf only; a unicast dhcp-host there,
# and a group-looking address elsewhere (a Bluetooth LE random address can
# look like one), are still found. Addresses put together, as above.
grp=$(printf '%s:%s' 11:22:33 44:55:66) opt=$(printf '%s:%s' e4:45:74 68:00:00) doc=$(printf '%s:%s' 00:00:5e 00:53:01)
mkdir -p "$t/scan/etc"
printf '#dhcp-host=%s,192.168.0.60\n#dhcp-option=128,%s\ndhcp-option=128,%s\n' "$grp" "$opt" "$opt" > "$t/scan/etc/dnsmasq.conf"
run scan "$t/scan" || fail "dnsmasq's example group address and option bytes pass in etc/dnsmasq.conf"
printf 'dhcp-host=%s,192.168.0.61\n' "$doc" >> "$t/scan/etc/dnsmasq.conf"
if run scan "$t/scan"; then fail "a unicast dhcp-host in etc/dnsmasq.conf is found"; fi
printf '#dhcp-option=128,%s # %s\n' "$opt" "$doc" > "$t/scan/etc/dnsmasq.conf"
if run scan "$t/scan"; then fail "a real address after an exempt value on one line is found"; fi
grp0=$(tc 11 22 33 44 55 60)
for bad in "#dhcp-host=${grp0//:/-}:$restc" "#dhcp-host=$grp0-$rest"; do
  printf '%s\n' "$bad" > "$t/scan/etc/dnsmasq.conf"
  if run scan "$t/scan"; then fail "a real address overlapping a dnsmasq group address is found: $bad"; fi
  grep -qx '    1 finding(s)' "$t/log" || fail "the scan reports once in dnsmasq.conf: $bad"
done
for ok in "#dhcp-host=$(ts 11 22 33 44 55 61):$restc" "#dhcp-option=128,${opt//:/-}:$restc"; do
  printf '%s\n' "$ok" > "$t/scan/etc/dnsmasq.conf"
  run scan "$t/scan" || fail "exempt overlap in etc/dnsmasq.conf passes: $ok"
done
rm "$t/scan/etc/dnsmasq.conf"
printf 'paired %s\n' "$grp" > "$t/scan/etc/other.conf"
if run scan "$t/scan"; then fail "a group-looking address outside etc/dnsmasq.conf is found"; fi
printf 'dhcp-option=128,%s\n' "$doc" > "$t/scan/etc/other.conf"
if run scan "$t/scan"; then fail "a dhcp-option value outside etc/dnsmasq.conf is found"; fi
mkdir -p "$t/scan/xetc"; printf '#dhcp-option=128,%s\n' "$doc" > "$t/scan/xetc/dnsmasq.conf"; rm "$t/scan/etc/other.conf"
if run scan "$t/scan"; then fail "a file named like etc/dnsmasq.conf but not it (xetc/) is found"; fi
rm -r "$t/scan/xetc"
rm -r "$t/scan/etc"
pass "the scan finds real MACs, serial records, the builder's home and listed identifiers, not made-up MACs or example paths"

# First-octet rule: locally administered unicast (x2, x6, xA, xE) and all-ones
# pass in every spelling (including NUL-delimited binary MAC records); x3, x7,
# xB and xF also set the group bit and are found outside etc/dnsmasq.conf
# (including ff:... other than all-ones, beside an exempt address, and in
# binary records), while etc/dnsmasq.conf still allows group addresses via
# first & 1. Built from octets so neither scanner finds a literal address in
# this file.
tail_c=$(tc 1a 2b 3c 4d 5e) tail_h=${tail_c//:/-} tail_b=${tail_c//:/}
mac_forms() {
  local o=$1 O=${1^^}
  printf '%s\n' \
    "$o:$tail_c" "$O:${tail_c^^}" \
    "mac:$o:$tail_c" "tag:$O:${tail_c^^}" "id:$o:$tail_c" \
    "$o-$tail_h" "$O-${tail_h^^}" "wlan0-$o-$tail_h" \
    "mac=$o$tail_b" "mac=$O${tail_b^^}" "bd_addr: $o$tail_b" \
    "ether $O${tail_b^^}" "\"mac_address\": \"$O${tail_b^^}\""
}
for o in 02 16 ca fe; do
  while IFS= read -r line; do
    printf '%s\n' "$line" > "$t/scan/bad.bin"
    run scan "$t/scan" || fail "the scan passes unicast locally administered: $line"
  done < <(mac_forms "$o")
  printf 'x\0mac=%s%s\0y' "$o" "$tail_b" > "$t/scan/bad.bin"
  run scan "$t/scan" || fail "the scan passes binary unicast locally administered: $o"
done
for ok in "ff:ff:ff:ff:ff:ff" "FF:FF:FF:FF:FF:FF" "mac:ff:ff:ff:ff:ff:ff" \
  "ff-ff-ff-ff-ff-ff" "FF-FF-FF-FF-FF-FF" "wlan0-ff-ff-ff-ff-ff-ff" \
  "mac=ffffffffffff" "bd_addr: FFFFFFFFFFFF" "ether FFFFFFFFFFFF" \
  "\"mac_address\": \"FFFFFFFFFFFF\""; do
  printf '%s\n' "$ok" > "$t/scan/bad.bin"
  run scan "$t/scan" || fail "the scan passes all-ones: $ok"
done
for o in 03 17 cb ef ff; do
  while IFS= read -r line; do
    printf '%s\n' "$line" > "$t/scan/bad.bin"
    if run scan "$t/scan"; then fail "the scan finds group-bit first octet: $line"; fi
  done < <(mac_forms "$o")
  printf '%s\n' "$lam $o:$tail_c" > "$t/scan/bad.bin"
  if run scan "$t/scan"; then fail "the scan finds group-bit beside exempt: $lam $o:$tail_c"; fi
  printf 'x\0mac=%s%s\0y' "$o" "$tail_b" > "$t/scan/bad.bin"
  if run scan "$t/scan"; then fail "the scan finds binary group-bit first octet: $o"; fi
done
near_all_ones=$(printf '%s:%s' ff:ff:ff ff:ff:fe)
for bad in "$near_all_ones" "${near_all_ones//:/-}" "mac=${near_all_ones//:/}"; do
  printf '%s\n' "$bad" > "$t/scan/bad.bin"
  if run scan "$t/scan"; then fail "the scan finds near-all-ones: $bad"; fi
done
rm "$t/scan/bad.bin"
mkdir -p "$t/scan/etc"
for o in 03 17 cb ef ff; do
  printf '#dhcp-host=%s:%s,192.168.0.60\n' "$o" "$tail_c" > "$t/scan/etc/dnsmasq.conf"
  run scan "$t/scan" || fail "group-bit first octet $o passes in etc/dnsmasq.conf"
done
rm -r "$t/scan/etc"
pass "only locally administered unicast MACs (x2, x6, xA, xE) and all-ones pass; x3, x7, xB and xF fail outside etc/dnsmasq.conf"

# Symlink targets (walked file, directory and dangling links, plus explicit
# link arguments) are scanned with the same rules without following walked
# links or double-reporting a regular file through a link.
mkdir -p "$t/scan/clean-dir"
printf 'clean\n' > "$t/scan/clean-dir/ok.txt"
ln -s clean-dir/ok.txt "$t/scan/clean-file-link"
ln -s clean-dir "$t/scan/clean-dir-link"
ln -s /nonexistent/clean "$t/scan/clean-dangling"
run scan "$t/scan" || fail "clean symlinks pass the scan"
run scan "$t/scan/clean-file-link" || fail "an explicit clean symlink passes the scan"
run scan "$t/scan/clean-dangling" || fail "an explicit clean dangling symlink passes the scan"
rm -r "$t/scan/clean-file-link" "$t/scan/clean-dir-link" "$t/scan/clean-dangling" "$t/scan/clean-dir"
printf 'clean\n' > "$t/scan/serial-ABC123-file"
ln -s serial-ABC123-file "$t/scan/file-link"
ln -s scan/serial-ABC123-file "$t/explicit-file-link"
if run scan "$t/scan"; then fail "the scan finds a walked file symlink target"; fi
grep -Fq "    $t/scan/file-link (symlink target): listed identifier: serial-ABC123" "$t/log" || fail "the scan names the walked file symlink"
if run scan "$t/explicit-file-link"; then fail "the scan finds an explicit file symlink target"; fi
grep -Fq "    $t/explicit-file-link (symlink target): listed identifier: serial-ABC123" "$t/log" || fail "the scan names the explicit file symlink"
rm "$t/scan/file-link" "$t/explicit-file-link" "$t/scan/serial-ABC123-file"
mkdir -p "$t/scan/serial-ABC123-dir"
printf 'clean\n' > "$t/scan/serial-ABC123-dir/ok.txt"
ln -s serial-ABC123-dir "$t/scan/dir-link"
if run scan "$t/scan"; then fail "the scan finds a walked directory symlink target"; fi
grep -Fq "    $t/scan/dir-link (symlink target): listed identifier: serial-ABC123" "$t/log" || fail "the scan names the walked directory symlink"
if run scan "$t/scan/dir-link/"; then fail "the scan finds an explicit directory symlink target with trailing slash"; fi
grep -Fq "    $t/scan/dir-link (symlink target): listed identifier: serial-ABC123" "$t/log" || fail "the scan names the explicit directory symlink"
rm -r "$t/scan/dir-link" "$t/scan/serial-ABC123-dir"
ln -s "/home/$(id -un)/x" "$t/scan/dangling-link"
if run scan "$t/scan"; then fail "the scan finds a walked dangling symlink target"; fi
grep -Fq "    $t/scan/dangling-link (symlink target): builder's home: /home/$(id -un)" "$t/log" || fail "the scan names the walked dangling symlink"
if run scan "$t/scan/dangling-link"; then fail "the scan finds an explicit dangling symlink target"; fi
grep -Fq "    $t/scan/dangling-link (symlink target): builder's home: /home/$(id -un)" "$t/log" || fail "the scan names the explicit dangling symlink"
rm "$t/scan/dangling-link"
ln -s "wlan0-$mac" "$t/scan/mac-link"
if run scan "$t/scan"; then fail "the scan finds a MAC address in a symlink target"; fi
grep -Fq "    $t/scan/mac-link (symlink target): MAC address: $mac" "$t/log" || fail "the scan names the symlink with a MAC target"
rm "$t/scan/mac-link"
mkdir -p "$t/scan/sub"
printf 'device serial-ABC123 here\n' > "$t/scan/sub/real.txt"
ln -s sub/real.txt "$t/scan/ref-file-link"
ln -s sub "$t/scan/ref-dir-link"
ln -s scan/sub/real.txt "$t/explicit-file-ref"
ln -s scan/sub "$t/explicit-dir-ref"
if run scan "$t/scan"; then fail "the scan finds a regular file beside symlinks to it"; fi
grep -Fq "    $t/scan/sub/real.txt: listed identifier: serial-ABC123" "$t/log" || fail "the scan reports the regular file"
grep -qx '    1 finding(s)' "$t/log" || fail "walked symlinks do not double-report their referent"
if run scan "$t/explicit-file-ref"; then fail "an explicit symlink still scans its referent"; fi
grep -Fq "    $t/explicit-file-ref: listed identifier: serial-ABC123" "$t/log" || fail "the scan reports the explicit symlink referent"
grep -qx '    1 finding(s)' "$t/log" || fail "an explicit clean symlink reports its referent once"
if run scan "$t/explicit-dir-ref"; then fail "an explicit directory symlink still scans its referent tree"; fi
grep -Fq "    $t/explicit-dir-ref/real.txt: listed identifier: serial-ABC123" "$t/log" || fail "the scan reports the file under an explicit directory symlink"
grep -qx '    1 finding(s)' "$t/log" || fail "an explicit clean directory symlink reports its referent once"
rm -r "$t/scan/ref-file-link" "$t/scan/ref-dir-link" "$t/explicit-file-ref" "$t/explicit-dir-ref" "$t/scan/sub"
ln -s clean "$t/scan/unreadable-link"
mkdir -p "$t/py-stub"
cat > "$t/py-stub/python3" <<EOF
#!/bin/sh
while [ "\$#" -gt 0 ] && [ "\$1" != - ]; do shift; done; [ "\$#" -gt 0 ] && shift
exec "$(command -v python3)" -I -c 'import os, sys
os.readlink = lambda p: (_ for _ in ()).throw(OSError("readlink denied"))
exec(compile(sys.stdin.read(), "<stdin>", "exec"), {"__name__": "__main__"})' "\$@"
EOF
chmod +x "$t/py-stub/python3"
if (cd "$R" && PATH="$t/py-stub:$PATH" tools/release scan "$t/scan") > "$t/log" 2>&1; then fail "an unreadable symlink fails the scan"; fi
grep -Fq "    $t/scan/unreadable-link (symlink target): unreadable link: readlink denied" "$t/log" || fail "the scan reports an unreadable symlink with its OS error"
grep -Fq "    1 unreadable input(s)" "$t/log" || fail "counts the unreadable symlink"
grep -Fq "scan could not read every input" "$t/log" || fail "caller reports an unreadable symlink as a read failure"
if grep -Fq "identifiers found" "$t/log"; then fail "an unreadable symlink is not reported as found identifiers"; fi
if grep -Fq "no MAC address, serial, IMEI" "$t/log"; then fail "an unreadable symlink does not print the clean note"; fi
rm -r "$t/scan/unreadable-link" "$t/py-stub"
pass "the scan checks walked file, directory, dangling and explicit symlink targets without double-reporting referents"

# Missing, unreadable and unsupported inputs fail closed instead of printing
# the clean note: explicit missing files/directories, trailing-slash non-dirs,
# FIFOs (explicit and walked, never opened), unreadable files/directories/lstat
# entries, and partial scans where a finding and an unreadable input occur
# together.
run scan "$t/scan/clean.txt" || fail "a clean readable file passes the scan"
grep -Fq "no MAC address, serial, IMEI" "$t/log" || fail "a clean scan prints the clean note"
if run scan "$t/scan/no-such-file.txt"; then fail "a missing explicit file fails the scan"; fi
grep -Fq "    $t/scan/no-such-file.txt: unreadable input:" "$t/log" || fail "reports the missing explicit file"
grep -Fq "    1 unreadable input(s)" "$t/log" || fail "counts the missing explicit file"
grep -Fq "scan could not read every input" "$t/log" || fail "caller reports an incomplete scan for a missing file"
if grep -Fq "identifiers found" "$t/log"; then fail "a missing file is not reported as found identifiers"; fi
if grep -Fq "no MAC address, serial, IMEI" "$t/log"; then fail "a missing file does not print the clean note"; fi
if run scan "$t/scan/no-such-dir/"; then fail "a missing explicit directory fails the scan"; fi
grep -Fq "    $t/scan/no-such-dir/: unreadable input:" "$t/log" || fail "reports the missing explicit directory"
if grep -Fq "no MAC address, serial, IMEI" "$t/log"; then fail "a missing directory does not print the clean note"; fi
if run scan "$t/scan/clean.txt/"; then fail "a regular file with a trailing slash fails the scan"; fi
grep -Fq "    $t/scan/clean.txt/: unreadable file:" "$t/log" || fail "reports the trailing-slash regular file"
grep -Fq "    1 unreadable input(s)" "$t/log" || fail "counts the trailing-slash regular file"
if grep -Fq "no MAC address, serial, IMEI" "$t/log"; then fail "a trailing-slash regular file does not print the clean note"; fi
ln -s /nonexistent/clean "$t/scan/clean-dangling"
run scan "$t/scan/clean-dangling" || fail "an explicit clean dangling symlink without trailing slash passes the scan"
if run scan "$t/scan/clean-dangling/"; then fail "an explicit dangling symlink with a trailing slash fails the scan"; fi
grep -Fq "    $t/scan/clean-dangling/: unreadable input:" "$t/log" || fail "reports the trailing-slash dangling symlink"
grep -Fq "    1 unreadable input(s)" "$t/log" || fail "counts the trailing-slash dangling symlink"
if grep -Fq "no MAC address, serial, IMEI" "$t/log"; then fail "a trailing-slash dangling symlink does not print the clean note"; fi
rm "$t/scan/clean-dangling"
ln -s loop-b "$t/scan/loop-a"
ln -s loop-a "$t/scan/loop-b"
if run scan "$t/scan/loop-a"; then fail "an explicit symlink loop fails the scan"; fi
grep -Fq "    $t/scan/loop-a: unreadable input: Too many levels of symbolic links" "$t/log" || fail "reports the explicit symlink loop"
grep -Fq "    1 unreadable input(s)" "$t/log" || fail "counts the explicit symlink loop"
grep -Fq "scan could not read every input" "$t/log" || fail "caller reports an incomplete scan for a symlink loop"
if grep -Fq "no MAC address, serial, IMEI" "$t/log"; then fail "an explicit symlink loop does not print the clean note"; fi
rm "$t/scan/loop-a" "$t/scan/loop-b"
mkfifo "$t/scan/pipe"
rc=0
timeout 5 "$R/tools/release" scan "$t/scan/pipe" > "$t/log" 2>&1 || rc=$?
((rc != 0 && rc != 124)) || fail "an explicit FIFO fails the scan without hanging (exit $rc)"
grep -Fq "    $t/scan/pipe: unsupported input: FIFO" "$t/log" || fail "reports the explicit FIFO as unsupported"
grep -Fq "    1 unreadable input(s)" "$t/log" || fail "counts the explicit FIFO"
if grep -Fq "no MAC address, serial, IMEI" "$t/log"; then fail "an explicit FIFO does not print the clean note"; fi
rc=0
timeout 5 "$R/tools/release" scan "$t/scan" > "$t/log" 2>&1 || rc=$?
((rc != 0 && rc != 124)) || fail "a walked FIFO fails the scan without hanging (exit $rc)"
grep -Fq "    $t/scan/pipe: unsupported input: FIFO" "$t/log" || fail "reports the walked FIFO as unsupported"
if grep -Fq "no MAC address, serial, IMEI" "$t/log"; then fail "a walked FIFO does not print the clean note"; fi
rm "$t/scan/pipe"
pass "missing, trailing-slash non-dir and unsupported (FIFO) inputs fail closed without hanging or printing the clean note"

# Injected PermissionErrors via a python3 stub run for every user (including
# root or permissive filesystems) so open, scandir, lstat and partial-scan
# fail-closed paths never skip.
mkdir -p "$t/scan/inj/f" "$t/scan/inj/d/nodir" "$t/scan/inj/l" "$t/py-stub"
printf 'device serial-ABC123 here\n' > "$t/scan/inj/f/noopen.txt"
printf 'device serial-ABC123 here\n' > "$t/scan/inj/d/nodir/inside.txt"
printf 'clean\n' > "$t/scan/inj/l/nolstat.txt"
printf 'serial-ABC123\n' > "$t/scan/inj/noids"
cat > "$t/py-stub/python3" <<EOF
#!/bin/sh
while [ "\$#" -gt 0 ] && [ "\$1" != - ]; do shift; done; [ "\$#" -gt 0 ] && shift
exec "$(command -v python3)" -I -c 'import builtins, errno, os, sys
def _deny(fn, *names):
    def w(p=".", *a, **k):
        if os.path.basename(os.fsdecode(p).rstrip("/")) in names:
            raise PermissionError(errno.EACCES, "Permission denied", p)
        return fn(p, *a, **k)
    return w
builtins.open, os.scandir, os.lstat = _deny(builtins.open, "noopen.txt", "noids"), _deny(os.scandir, "nodir"), _deny(os.lstat, "nolstat.txt")
exec(compile(sys.stdin.read(), "<stdin>", "exec"), {"__name__": "__main__"})' "\$@"
EOF
chmod +x "$t/py-stub/python3"
srun() { (cd "$R" && PATH="$t/py-stub:$PATH" tools/release "$@") > "$t/log" 2>&1; }
if srun scan "$t/scan/inj/f"; then fail "an unreadable file (injected open error) fails the scan"; fi
grep -Fq "    $t/scan/inj/f/noopen.txt: unreadable file: Permission denied" "$t/log" || fail "reports the injected open error"
grep -Fq "    1 unreadable input(s)" "$t/log" || fail "counts the injected open error"
grep -Fq "scan could not read every input" "$t/log" || fail "caller reports an incomplete scan for the injected open error"
if grep -Fq "identifiers found" "$t/log"; then fail "an unreadable file alone is not reported as found identifiers"; fi
if grep -Fq "no MAC address, serial, IMEI" "$t/log"; then fail "an unreadable file does not print the clean note"; fi
# Partial scan: a finding and an unreadable file together report both
printf 'device serial-ABC123 here\n' > "$t/scan/inj/f/finding.txt"
if srun scan "$t/scan/inj/f"; then fail "a directory with both a finding and an unreadable file fails"; fi
grep -Fq "    $t/scan/inj/f/finding.txt: listed identifier: serial-ABC123" "$t/log" || fail "partial scan still reports the finding"
grep -Fq "    $t/scan/inj/f/noopen.txt: unreadable file: Permission denied" "$t/log" || fail "partial scan still reports the unreadable file"
grep -qx '    1 finding(s)' "$t/log" || fail "partial scan counts findings"
grep -qx '    1 unreadable input(s)' "$t/log" || fail "partial scan counts unreadable inputs"
grep -Fq "identifiers found and some inputs could not be read" "$t/log" || fail "caller reports both findings and read errors"
if grep -Fq "no MAC address, serial, IMEI" "$t/log"; then fail "partial scan does not print the clean note"; fi
if srun scan "$t/scan/inj/d"; then fail "an unreadable subdirectory (injected scandir error) fails the scan"; fi
grep -Fq "    $t/scan/inj/d/nodir: unreadable directory: Permission denied" "$t/log" || fail "reports the injected scandir error on a subdirectory"
grep -Fq "    1 unreadable input(s)" "$t/log" || fail "counts the injected scandir error"
if grep -Fq "no MAC address, serial, IMEI" "$t/log"; then fail "an unreadable subdirectory does not print the clean note"; fi
if srun scan "$t/scan/inj/d/nodir"; then fail "an explicit unreadable directory (injected scandir error) fails the scan"; fi
grep -Fq "    $t/scan/inj/d/nodir: unreadable directory: Permission denied" "$t/log" || fail "reports the explicit injected scandir error"
if grep -Fq "no MAC address, serial, IMEI" "$t/log"; then fail "an explicit unreadable directory does not print the clean note"; fi
if srun scan "$t/scan/inj/l"; then fail "a walked entry that cannot be lstat'ed fails the scan"; fi
grep -Fq "    $t/scan/inj/l/nolstat.txt: unreadable input: Permission denied" "$t/log" || fail "reports the walked entry lstat failure"
grep -Fq "    1 unreadable input(s)" "$t/log" || fail "counts the walked entry lstat failure"
grep -Fq "scan could not read every input" "$t/log" || fail "caller reports an incomplete scan for a walked entry lstat failure"
if grep -Fq "no MAC address, serial, IMEI" "$t/log"; then fail "a walked entry lstat failure does not print the clean note"; fi
if (RELEASE_IDENTIFIERS=$t/scan/inj/noids srun scan "$t/scan/inj/f/finding.txt"); then fail "an unreadable identifiers file fails the scan"; fi
grep -Fq "    $t/scan/inj/noids: unreadable identifiers file: Permission denied" "$t/log" || fail "reports the unreadable identifiers file"
grep -Fq "    1 unreadable input(s)" "$t/log" || fail "counts the unreadable identifiers file"
grep -Fq "scan could not read every input" "$t/log" || fail "caller reports an incomplete scan for an unreadable identifiers file"
if grep -Fq "no MAC address, serial, IMEI" "$t/log"; then fail "an unreadable identifiers file does not print the clean note"; fi
rm -r "$t/scan/inj" "$t/py-stub"

# Real chmod coverage where the user and filesystem enforce modes (e.g. CI).
mkdir -p "$t/scan/perm/sub000" "$t/scan/perm/dir0400"
printf 'device serial-ABC123 here\n' > "$t/scan/perm/file000.txt"
printf 'device serial-ABC123 here\n' > "$t/scan/perm/sub000/inside.txt"
printf 'clean\n' > "$t/scan/perm/dir0400/entry.txt"
chmod 000 "$t/scan/perm/file000.txt" "$t/scan/perm/sub000"
chmod 0400 "$t/scan/perm/dir0400"
if ((EUID != 0)) && [[ ! -r $t/scan/perm/file000.txt ]]; then
  if run scan "$t/scan/perm/file000.txt"; then fail "a mode-000 file fails the scan"; fi
  grep -Fq "    $t/scan/perm/file000.txt: unreadable file:" "$t/log" || fail "reports the mode-000 file with its OS error"
  if run scan "$t/scan/perm/sub000"; then fail "a mode-000 directory fails the scan"; fi
  grep -Fq "    $t/scan/perm/sub000: unreadable directory:" "$t/log" || fail "reports the mode-000 directory with its OS error"
  if run scan "$t/scan/perm/dir0400"; then fail "a mode-0400 directory entry fails lstat"; fi
  grep -Fq "    $t/scan/perm/dir0400/entry.txt: unreadable input:" "$t/log" || fail "reports the mode-0400 directory entry lstat failure"
  if grep -Fq "no MAC address, serial, IMEI" "$t/log"; then fail "a mode-0400 directory does not print the clean note"; fi
fi
chmod u+rwX "$t/scan/perm/file000.txt" "$t/scan/perm/sub000" "$t/scan/perm/dir0400"
rm -r "$t/scan/perm"
pass "unreadable files, directories, walked lstat failures and partial scans fail closed with accurate diagnostics"

# --- packages: only the release key's index ---
gpg --batch --quiet --passphrase '' --quick-gen-key "other <x@invalid>" ed25519 sign never >/dev/null 2>&1
other_fpr=$(gpg --batch --with-colons --list-keys 2>/dev/null | awk -F: '$1 == "fpr" { print $10; exit }')
mkdir -p "$t/pkg" "$R/packages/omamobile-keyring/test"
printf '#!/bin/sh\nexit 0\n' > "$R/packages/omamobile-keyring/test/all" && chmod +x "$R/packages/omamobile-keyring/test/all"
printf 'pkgname = omamobile-keyring\npkgbase = omamobile-keyring\npkgver = 1-1\narch = any\nsize = 1\n' > "$t/pkg/.PKGINFO"
(cd "$R/out/repo/aarch64" && bsdtar --zstd -cf omamobile-keyring-1-1-any.pkg.tar.zst -C "$t/pkg" .PKGINFO &&
  repo-add -q --sign --key "$other_fpr" omamobile.db.tar.gz omamobile-keyring-1-1-any.pkg.tar.zst) >/dev/null 2>&1 || true
if [[ -f $R/out/repo/aarch64/omamobile.db.tar.gz.sig ]]; then
  if run --version "$V" packages; then fail "an index another key signed is refused"; fi
  grep -q 'not signed by the release key' "$t/log" || fail "says the index isn't the release key's"
  pass "the packages stage refuses an index the release key didn't sign"
else
  pass "# skip: repo-add could not make a signed fixture"
fi

# --- test-install and tag, from recorded state ---
st=$R/out/release/$V/state
printf 'kernel_release=7.3.0-rc6-omamobile-g%s\nbuild_done=x\nbundle=out/bundle/x\nbundle_signed=0\n' "${commit:0:12}" >> "$st"
if run --version "$V" test-install --passed 7.3.0-rc6-omamobile-push1-gdeadbeef0000; then fail "another kernel than the release's is refused"; fi
if run --version "$V" test-install --passed "7.3.0-rc6-omamobile-g${commit:0:12}"; then fail "a test of an unsigned bundle is refused"; fi
grep -q 'tested bundle is unsigned' "$t/log" || fail "says the tested bundle was unsigned"
run --version "$V" --dry-run test-install || fail "the dry run prints the attended steps"
grep -q 'bash install --dry-run' "$t/log" || fail "the steps start with the installer's dry run"
grep -c 'would ask https://pkgs.omamobile.org/stable/aarch64/omamobile.db whether stable has an index' "$t/log" >/dev/null ||
  fail "the dry run says it would ask the server for stable's index"
# The installed phone follows stable, and promote comes after this stage:
# test-install asks the server whether stable has an index. A stand-in curl
# answers with the status in $t/stable-code and logs its arguments; nothing
# reaches a server
mkdir -p "$t/curl-stub"
cat > "$t/curl-stub/curl" <<EOF
#!/bin/sh
echo "curl \$*" >> "$t/curl.log"
[ -s "$t/stable-code" ] || exit 6
cat "$t/stable-code"
EOF
chmod +x "$t/curl-stub/curl"
trun() { (cd "$R" && PATH="$t/curl-stub:$PATH" tools/release "$@") > "$t/log" 2>&1; }
trun --version "$V" --dry-run test-install || fail "the dry run still prints the attended steps"
[[ ! -e $t/curl.log ]] || fail "the test-install dry run asks no server: $(cat "$t/curl.log")"
index=$(sed -n 's/^repo_index=//p' "$st" | tail -n 1)
[[ -n $index ]] || { index=$(printf x | sha256sum | cut -d' ' -f1); echo "repo_index=$index" >> "$st"; }
printf 404 > "$t/stable-code"
if trun --version "$V" test-install; then fail "test-install stops when stable has no index"; fi
grep -c -- "-I .*https://pkgs.omamobile.org/stable/aarch64/omamobile.db" "$t/curl.log" >/dev/null || fail "asks for stable's index with a HEAD request: $(cat "$t/curl.log")"
grep -c 'stable has no index yet: the first release to this server' "$t/log" >/dev/null || fail "says stable has no index yet"
grep -cx "    tools/repo-publish stable --expect-index $index" "$t/log" >/dev/null || fail "prints the one-time promotion of the pinned index"
grep -cx "    tools/repo-publish --dry-run stable --expect-index $index" "$t/log" >/dev/null || fail "prints the promotion's dry run first"
if grep -c 'bash install' "$t/log" >/dev/null; then fail "the attended steps aren't printed before stable has an index"; fi
for code in 000 500 ""; do
  printf '%s' "$code" > "$t/stable-code"
  if trun --version "$V" test-install; then fail "test-install stops when the server doesn't answer the question (${code:-curl failed})"; fi
  grep -c "can't tell whether stable has an index" "$t/log" >/dev/null || fail "says it can't tell (${code:-curl failed})"
  if grep -c 'repo-publish\|bash install' "$t/log" >/dev/null; then fail "neither a promotion nor the steps are printed when it can't tell (${code:-curl failed})"; fi
done
printf 200 > "$t/stable-code"
if trun --version "$V" test-install; then fail "test-install waits for the attended install"; fi
grep -c 'stable has an index' "$t/log" >/dev/null || fail "says stable has an index"
grep -c 'bash install --dry-run' "$t/log" >/dev/null || fail "with an index on stable, the attended steps are printed"
grep -c 'waiting for the attended install' "$t/log" >/dev/null || fail "then waits for the attended install"
if grep -c 'repo-publish' "$t/log" >/dev/null; then fail "no promotion is printed when stable has an index"; fi
: > "$t/curl.log"
if trun --version "$V" test-install --passed 7.3.0-rc6-omamobile-push1-gdeadbeef0000; then fail "another kernel is still refused"; fi
[[ ! -s $t/curl.log ]] || fail "recording the result asks no server"
pass "test-install asks whether stable has an index: none prints the one-time promotion and stops, no answer stops, one lets the steps through"
printf 'promote_done=x\nkernel_tag=kernel-2026.11.05\nidentifiers_done=clean\n' >> "$st"
mkdir -p "$R/docs/release-notes"
printf '# Omamobile 2026.MM.DD\nkernel-2026.11.05\n' > "$R/docs/release-notes/$V.md"
if run --version "$V" tag; then fail "notes with placeholders are refused"; fi
grep -q 'placeholders' "$t/log" || fail "says the notes have placeholders"
pass "test-install records only the release kernel on a signed bundle; tag refuses unfinished notes"

# --- images: current boot files are kept; stale ones need a version bump ---
# A stand-in for #320's tools/stage-boot-files: --check passes when
# $t/bf-current exists; staging is only printed in a dry run
mkdir -p "$R/packages/omamobile-boot-update" "$R/packages/omamobile-device-testdev" "$RELEASE_KERNEL_OUT/include/config"
echo "$krel" > "$RELEASE_KERNEL_OUT/include/config/kernel.release"
: > "$R/packages/omamobile-boot-update/PKGBUILD"
printf 'pkgname=omamobile-device-testdev\npkgver=0.1.5\npkgrel=1\n' > "$R/packages/omamobile-device-testdev/PKGBUILD"
printf '#!/bin/bash\n[[ $1 == --check && -e %s/bf-current ]] && { echo current; exit 0; }\necho "stale" >&2; exit 1\n' "$t" > "$R/tools/stage-boot-files"
chmod +x "$R/tools/stage-boot-files"
touch "$t/bf-current"
# a device package that ships no boot files has no boot-files flow
run --version "$V" --dry-run images || fail "the images dry run for a device package without boot files"
grep -q 'ships no boot files' "$t/log" || fail "a device package without OMAMOBILE_BOOT_FILES skips the boot files"
printf '#!/bin/bash\nboot=${OMAMOBILE_BOOT_FILES:-boot-files}\n' > "$R/packages/omamobile-device-testdev/install"
run --version "$V" --dry-run images || fail "the images dry run with current boot files"
grep -q 'would build the images with packages/omamobile-device-testdev/boot-files/initramfs.cpio.lz4' "$t/log" ||
  fail "the images use the staged initramfs when the boot files are kept"
grep -q 'boot-files is current for this tree: kept, not restaged' "$t/log" || fail "current boot files are kept"
if grep -q 'would run: tools/stage-boot-files' "$t/log"; then fail "current boot files are not restaged"; fi
rm "$t/bf-current"
# out/repo already holds this device-package version: restaging would loop
mkdir -p "$t/dpkg" "$t/repo2"
printf 'pkgname = omamobile-device-testdev\npkgbase = omamobile-device-testdev\npkgver = 0.1.5-1\narch = any\nsize = 1\n' > "$t/dpkg/.PKGINFO"
(cd "$t/repo2" && bsdtar --zstd -cf omamobile-device-testdev-0.1.5-1-any.pkg.tar.zst -C "$t/dpkg" .PKGINFO &&
  repo-add -q omamobile.db.tar.gz omamobile-device-testdev-0.1.5-1-any.pkg.tar.zst) >/dev/null 2>&1 || fail "a repository fixture"
mv "$R/out/repo" "$t/repo.saved" && mkdir -p "$R/out/repo" && cp -a "$t/repo2" "$R/out/repo/aarch64"
if run --version "$V" --dry-run images; then fail "stale boot files at a version out/repo already has are refused"; fi
grep -q 'a device-package version bump is needed' "$t/log" || fail "says a version bump is needed"
grep -q 'bump packages/omamobile-device-testdev/version' "$t/log" || fail "prints the bump and the rebuild"
# a bumped version (out/repo doesn't have it yet): stage, then build it
sed -i 's/pkgver=0.1.5/pkgver=0.1.6/' "$R/packages/omamobile-device-testdev/PKGBUILD"
run --version "$V" --dry-run images || fail "stale boot files for a new device-package version are staged"
grep -q 'would run: tools/stage-boot-files' "$t/log" || fail "stages the boot files for the new version"
grep -q 'next: tools/build-packages packages/omamobile-device-testdev' "$t/log" || fail "names the device package to build next"
rm -rf "$R/out/repo" && mv "$t/repo.saved" "$R/out/repo"
rm -rf "$R/packages/omamobile-boot-update" "$R/packages/omamobile-device-testdev" "$R/tools/stage-boot-files" "$RELEASE_KERNEL_OUT"
pass "images keeps current boot files and builds from their initramfs, and asks for a device-package version bump before restaging stale ones"

# --- upload: the real tools/release-upload --dry-run on a signed bundle ---
for tool in rsync sha256sum; do
  command -v "$tool" >/dev/null || { pass "# skip upload: no $tool"; exit 0; }
done
uk=$t/release-key
mkdir -m 700 "$uk"
GNUPGHOME=$uk gpg --batch --quiet --passphrase '' --quick-generate-key "release <r@invalid>" ed25519 sign never 2>/dev/null
ufpr=$(GNUPGHOME=$uk gpg --batch --with-colons --list-keys 2>/dev/null | awk -F: '$1 == "fpr" { print $10; exit }')
mkdir -p "$R/keys"
echo "$ufpr" > "$R/keys/fingerprint.release"
kr=$R/packages/omamobile-keyring
GNUPGHOME=$uk gpg --batch --export "$ufpr" > "$kr/omamobile.gpg"
printf '%s:4:\n' "$ufpr" > "$kr/omamobile-trusted"
: > "$kr/omamobile-revoked"
B=out/bundle/omamobile-testdev-$V
rootname=omamobile-rootfs-testdev-$V-aarch64.img.zst
mkdir -p "$R/$B/images"
printf 'CODENAME=testdev\nNAME="Test Phone"\nBOOT_IMAGES="boot"\nUFS_RW="boot_b userdata"\n' > "$R/$B/device.conf"
head -c 4096 /dev/urandom > "$R/$B/images/boot.img"
printf '#!/bin/bash\necho install\n' > "$R/$B/install"
cp "$kr/omamobile.gpg" "$R/$B/omamobile.gpg"
# Laid out as tools/make-bundle lays it out: the guide, the README and
# phone-provision with its helpers under tools/ (make-bundle's own list)
echo guide > "$R/$B/INSTALL.md"
echo readme > "$R/$B/README.txt"
mkdir -p "$R/$B/tools"
ptools=$(sed -n 's/^provision_tools="\(.*\)"$/\1/p' tools/make-bundle)
[[ -n $ptools ]] || fail "read make-bundle's provision_tools"
for f in $ptools; do printf '#!/bin/bash\n' > "$R/$B/tools/$f"; done
head -c 50000 /dev/urandom > "$R/out/bundle/$rootname"
(cd "$R/out/bundle" && sha256sum "$rootname" > "$rootname.sha256")
printf 'device: testdev\n' > "$R/out/bundle/${rootname%.img.zst}.MANIFEST"
digest=$(sha256sum < "$R/out/bundle/$rootname" | cut -d' ' -f1)
printf 'version: %s\nroot image: %s (%s)\n' "$V" "$rootname" "$digest" > "$R/$B/MANIFEST"
python3 -I "$R/tools/bundle-manifest" --bundle "$R/$B" --rootfs "$R/out/bundle/$rootname" --rootfs-sha256 "$digest" \
  --version "$V" --kernel-release "$krel" --base-url "https://pkgs.omamobile.org/releases/testdev/$V/" >/dev/null ||
  fail "the fixture bundle's manifest.json"
(cd "$R/$B" && find . -type f ! -name 'SHA256SUMS*' -printf '%P\n' | sort | xargs sha256sum -- > SHA256SUMS)
GNUPGHOME=$uk gpg --batch --yes --quiet --local-user "$ufpr" --detach-sign -o "$R/$B/SHA256SUMS.sig" "$R/$B/SHA256SUMS"
# The one-file download beside the bundle, built and signed as make-bundle
# does, where this checkout has it (tools/lib/bundle-tar.sh, PR #326):
# release-upload then requires it
if [[ -f tools/lib/bundle-tar.sh ]]; then
  # shellcheck source=../tools/lib/bundle-tar.sh
  source tools/lib/bundle-tar.sh
  bundle_tar "$R/out/bundle" "omamobile-testdev-$V" "$rootname" "$V" || fail "the fixture's bundle tar"
  GNUPGHOME=$uk gpg --batch --yes --quiet --local-user "$ufpr" --detach-sign \
    -o "$R/out/bundle/omamobile-testdev-$V.tar.sha256.sig" "$R/out/bundle/omamobile-testdev-$V.tar.sha256"
fi
# Nothing may reach a server: ssh, rsync and curl only log
mkdir -p "$t/stub"
for c in ssh rsync curl; do printf '#!/bin/sh\necho "%s $*" >> %s/stub.log\nexit 1\n' "$c" "$t" > "$t/stub/$c"; done
chmod +x "$t/stub/"*
printf 'verify_done=verified\nbundle=%s\nrootfs=out/%s\n' "$B" "$rootname" >> "$st"
# The identifiers stage's bundle check on that layout
run check-bundle "$R/$B" || fail "a bundle laid out as make-bundle builds it passes the bundle check"
echo x > "$R/$B/tools/extra-tool"
if run check-bundle "$R/$B"; then fail "a file make-bundle doesn't put in the bundle is refused"; fi
grep -q './tools/extra-tool' "$t/log" || fail "names the extra file"
rm "$R/$B/tools/extra-tool"
echo x > "$R/$B/images/notes.txt"
if run check-bundle "$R/$B"; then fail "a non-image file under images/ is refused"; fi
rm "$R/$B/images/notes.txt"
# The device's build index, which make-bundle ships when the device has one
# (2026.11.12 was the first bundle with it, and this check stopped it)
echo '{}' > "$R/$B/factory-builds.json"
run check-bundle "$R/$B" || fail "a bundle with its device's build index passes the bundle check"
rm "$R/$B/factory-builds.json"
pass "the bundle check allows exactly make-bundle's files, INSTALL.md, the build index and its provision tools included"
urun() { (cd "$R" && PATH="$t/stub:$PATH" tools/release "$@") > "$t/log" 2>&1; }
if urun --version "$V" upload; then fail "the upload stage stops for the maintainer"; fi
grep -q "release-upload --dry-run $B" "$t/log" || fail "runs tools/release-upload --dry-run on the bundle directory"
grep -q 'SHA256SUMS signed by the release key' "$t/log" || fail "release-upload checked the bundle's signature"
grep -q 'dry run, nothing uploaded' "$t/log" || fail "release-upload finished its dry run"
grep -q "tools/release-upload --full --latest $B" "$t/log" || fail "prints the real upload for the maintainer"
grep -q 'upload --done' "$t/log" || fail "says how to record the upload"
[[ ! -s $t/stub.log ]] || fail "the dry run called a network tool: $(cat "$t/stub.log")"
grep -cx "    tools/release-upload --full --latest $B" "$t/log" >/dev/null || fail "without a build host, the upload is printed to run here"
if grep -c 'ssh -t\|build host' "$t/log" >/dev/null; then fail "without a build host, no build-host route is printed"; fi
pass "without a build host, the upload stage prints the upload to run here"

# --- upload and promote through the build host (BUILD_HOST), whose omapub
# alone may write the server: printed, never run ---
H=omapub@build.invalid
echo "BUILD_HOST=$H" > "$R/omamobile.local.conf"
if urun --version "$V" upload; then fail "the upload stage stops for the maintainer with a build host"; fi
rr=Projects/omarchy-mobile
r=out/bundle/$rootname
grep -cxF "    rsync -a --partial -- $B $B.tar $B.tar.sha256 $B.tar.sha256.sig $r $r.sha256 ${r%.img.zst}.MANIFEST $H:$rr/out/bundle/" "$t/log" >/dev/null ||
  fail "prints the rsync of the bundle, its .tar's three files and the root image's three to the build host's out/bundle/"
grep -cxF "    ssh $H 'git -C ~/$rr pull --ff-only origin main'" "$t/log" >/dev/null || fail "prints the build host's checkout update"
grep -cxF "    ssh -t $H 'cd ~/$rr && OMAMOBILE_PKGS_HOST=omapub@nostr01.derekross.me tools/release-upload --dry-run $B'" "$t/log" >/dev/null ||
  fail "prints release-upload's dry run on the build host, as omapub"
grep -cxF "    ssh -t $H 'cd ~/$rr && OMAMOBILE_PKGS_HOST=omapub@nostr01.derekross.me tools/release-upload --full --latest $B'" "$t/log" >/dev/null ||
  fail "prints the real upload on the build host, as omapub"
grep -cF "upload --done" "$t/log" >/dev/null || fail "then the --done check here"
if grep -cx "    tools/release-upload --full --latest $B" "$t/log" >/dev/null; then fail "with a build host, the upload is not printed to run here"; fi
[[ ! -s $t/stub.log ]] || fail "the build-host route called a network tool: $(cat "$t/stub.log")"
printf 'upload_done=x\n' >> "$st"
pidx=$(sed -n 's/^repo_index=//p' "$st" | tail -n 1)
if urun --version "$V" promote; then fail "the promote stage stops for the maintainer"; fi
grep -cxF "    ssh -t $H 'cd ~/$rr && OMAMOBILE_PKGS_HOST=omapub@nostr01.derekross.me tools/repo-publish --dry-run stable --expect-index $pidx'" "$t/log" >/dev/null ||
  fail "prints the promotion's dry run on the build host"
grep -cxF "    ssh -t $H 'cd ~/$rr && OMAMOBILE_PKGS_HOST=omapub@nostr01.derekross.me tools/repo-publish stable --expect-index $pidx'" "$t/log" >/dev/null ||
  fail "prints the promotion on the build host with a terminal for its question"
if grep -c -- '--yes' "$t/log" >/dev/null; then fail "a printed promotion never answers its question with --yes"; fi
grep -cF "promote --done" "$t/log" >/dev/null || fail "then the --done check here"
printf 'BUILD_HOST=%s\nBUILD_HOST_REPO=/srv/omamobile\n' "$H" > "$R/omamobile.local.conf"
if urun --version "$V" promote; then fail "the promote stage stops with a BUILD_HOST_REPO"; fi
grep -cF "ssh -t $H 'cd /srv/omamobile && " "$t/log" >/dev/null || fail "uses BUILD_HOST_REPO for the checkout"
for bad in "build.invalid" "omapub@ms01;id" "omapub@ms01 x" "-oProxyCommand=x@y" "-oX@y" "omapub@-y"; do
  printf 'BUILD_HOST=%q\n' "$bad" > "$R/omamobile.local.conf"
  if urun --version "$V" promote; then fail "a BUILD_HOST of '$bad' is refused"; fi
  grep -c 'is not USER@HOST' "$t/log" >/dev/null || fail "says why '$bad' is refused"
  if grep -c 'repo-publish' "$t/log" >/dev/null; then fail "nothing is printed for '$bad'"; fi
done
printf 'BUILD_HOST=%s\nBUILD_HOST_REPO=%q\n' "$H" '~/x;id' > "$R/omamobile.local.conf"
if urun --version "$V" upload; then fail "a BUILD_HOST_REPO that is not a plain path is refused"; fi
grep -c 'is not a plain path' "$t/log" >/dev/null || fail "says why the BUILD_HOST_REPO is refused"
rm "$R/omamobile.local.conf"
if urun --version "$V" promote; then fail "the promote stage stops without a build host"; fi
grep -cx "    tools/repo-publish stable --expect-index $pidx" "$t/log" >/dev/null || fail "without a build host, the promotion is printed to run here"
if grep -c 'ssh' "$t/log" >/dev/null; then fail "without a build host, no ssh is printed for the promotion"; fi
sed -i '/^upload_done=/d' "$st"
pass "with a BUILD_HOST, upload and promote print the build-host route (the seven files, ssh -t, never --yes); a bad host is refused"
echo tampered >> "$R/$B/install"
if urun --version "$V" upload; then fail "a bundle changed after signing is refused"; fi
grep -q "release-upload --dry-run refuses" "$t/log" || fail "says release-upload refused the bundle"
pass "the upload stage runs the real release-upload --dry-run on the bundle and prints the --full --latest upload"

# --- identifiers: fail closed when the release initramfs cannot be unpacked ---
for tool in mke2fs debugfs zstd lz4 cpio; do
  command -v "$tool" >/dev/null || { pass "# skip identifiers: no $tool"; exit 0; }
done
V2=2026.11.06
B2=out/bundle/omamobile-testdev-$V2
rname2=omamobile-rootfs-testdev-$V2-aarch64.img.zst
mkdir -p "$R/$B2" "$R/out/release/$V2" "$RELEASE_KERNEL_OUT" "$t/id-root/etc"
printf 'readme\n' > "$R/$B2/README.txt"
printf 'omamobile\n' > "$t/id-root/etc/hostname"
mke2fs -q -t ext4 -d "$t/id-root" "$t/id-root.img" 1M >/dev/null 2>&1
zstd -q -f "$t/id-root.img" -o "$R/out/$rname2"
printf 'device: testdev\n' > "$R/out/${rname2%.img.zst}.MANIFEST"
st2=$R/out/release/$V2/state
ir=$RELEASE_KERNEL_OUT/initramfs.cpio.lz4
reset_id_state() {
  printf 'bundle=%s\nrootfs=out/%s\n' "$B2" "$rname2" > "$st2"
}
assert_id_fail() {
  local what=$1 needle=$2
  reset_id_state
  if run --version "$V2" identifiers; then fail "$what"; fi
  grep -Fq "$needle" "$t/log" || fail "$what: expected '$needle'"
  if grep -Fq "no MAC address, serial, IMEI" "$t/log"; then fail "$what: must not print clean note"; fi
  if grep -q '^identifiers_done=' "$st2"; then fail "$what: must not record identifiers_done"; fi
}
# shellcheck source=../tools/lib/initramfs-pack.sh
source tools/lib/initramfs-pack.sh
# Real-shaped archive: /init, nested dirs, absolute and relative symlinks,
# read-only directories (empty and with a child), and a mode-0000 regular file
# (mode patched in the newc header after packing, since unprivileged cpio -o
# cannot open a mode-0000 file on disk).
mkdir -p "$t/id-valid/etc/sub" "$t/id-valid/etc/ro" "$t/id-valid/var/empty" "$t/id-valid/bin"
printf '#!/bin/sh\nexec /bin/sh\n' > "$t/id-valid/init"
chmod 755 "$t/id-valid/init"
printf 'clean\n' > "$t/id-valid/etc/sub/note.txt"
ln -s note.txt "$t/id-valid/etc/sub/link"
ln -s /bin/busybox "$t/id-valid/bin/sh"
printf 'ro-child\n' > "$t/id-valid/etc/ro/child.txt"
chmod 0555 "$t/id-valid/var/empty" "$t/id-valid/etc/ro"
printf 'zero-mode-clean\n' > "$t/id-valid/etc/zero.txt"
initramfs_pack "$t/id-valid" "$t/id-valid-raw.cpio.lz4"
lz4 -dc "$t/id-valid-raw.cpio.lz4" > "$t/id-valid.cpio"
python3 -I - "$t/id-valid.cpio" "$t/id-junk.cpio" <<'PY'
import sys
data = bytearray(open(sys.argv[1], "rb").read())
pos = 0
note_pos = None
while pos + 110 <= len(data):
    assert data[pos:pos+6] == b"070701"
    ns = int(data[pos+94:pos+102], 16)
    fs = int(data[pos+54:pos+62], 16)
    name = bytes(data[pos+110:pos+110+ns-1])
    if name in (b"./etc/zero.txt", b"etc/zero.txt"):
        data[pos+14:pos+22] = b"00008000"
    elif name in (b"./etc/sub/note.txt", b"etc/sub/note.txt"):
        note_pos = pos
    pos = (((pos + 110 + ns + 3) & ~3) + fs + 3) & ~3
    if name == b"TRAILER!!!":
        break
assert note_pos is not None
open(sys.argv[1], "wb").write(data)
data[note_pos:note_pos+6] = b"XXXXXX"
open(sys.argv[2], "wb").write(data)
PY
lz4 -l -9 -q -f "$t/id-valid.cpio" "$t/id-valid.cpio.lz4"

rm -f "$ir"
assert_id_fail "missing initramfs fails identifiers" "missing release initramfs: $ir"

mkdir "$ir"
assert_id_fail "directory at initramfs path fails identifiers" "unreadable release initramfs: $ir"
rmdir "$ir"

cp "$t/id-valid.cpio.lz4" "$ir"
chmod 000 "$ir"
if ((EUID != 0)) && [[ ! -r $ir ]]; then
  assert_id_fail "unreadable initramfs fails identifiers" "unreadable release initramfs: $ir"
fi
chmod 644 "$ir"

printf 'not an lz4 stream\n' > "$ir"
assert_id_fail "corrupt initramfs fails identifiers" "could not decompress release initramfs: $ir"

head -c 64 "$t/id-valid.cpio.lz4" > "$ir"
assert_id_fail "truncated initramfs fails identifiers" "could not decompress release initramfs: $ir"

{ cat "$t/id-valid.cpio.lz4"; printf 'trailing garbage'; } > "$ir"
assert_id_fail "trailing corruption after valid lz4 fails identifiers" "could not decompress release initramfs: $ir"

printf 'not a cpio archive\n' | lz4 -l -9 -q > "$ir"
assert_id_fail "corrupt cpio payload fails identifiers" "could not extract release initramfs: $ir"
grep -Fq "cpio:" "$t/log" || fail "corrupt cpio payload prints cpio diagnostic"

head -c 128 "$t/id-valid.cpio" | lz4 -l -9 -q > "$ir"
assert_id_fail "truncated cpio payload fails identifiers" "could not extract release initramfs: $ir"
grep -Fq "cpio:" "$t/log" || fail "truncated cpio payload prints cpio diagnostic"

: | lz4 -l -9 -q > "$ir"
assert_id_fail "empty lz4 stream fails identifiers" "could not extract release initramfs: $ir"

lz4 -l -9 -q -f "$t/id-junk.cpio" "$ir"
assert_id_fail "cpio junk-skip warning fails identifiers" "release initramfs $ir extracted with cpio warning or unexpected output"
grep -Fq "cpio: warning: skipped" "$t/log" || fail "junk-skip case prints cpio warning"

{ cat "$t/id-valid.cpio"; printf 'trailing'; } | lz4 -l -9 -q > "$ir"
assert_id_fail "trailing bytes after cpio TRAILER fail identifiers" "release initramfs $ir: cpio read "
grep -Fq "bytes (bytes after the archive's end, or an unpadded stream)" "$t/log" || fail "trailing bytes case explains the size mismatch"
grep -Eq '^[0-9]+ blocks?$' "$t/log" || fail "trailing bytes case prints cpio block count"

mkdir -p "$t/id-dot"
initramfs_pack "$t/id-dot" "$ir"
assert_id_fail "dot-only initramfs fails identifiers" "release initramfs $ir unpacked without /init"

mkdir -p "$t/id-noinit/etc"
printf 'only config\n' > "$t/id-noinit/etc/only.txt"
initramfs_pack "$t/id-noinit" "$ir"
assert_id_fail "no-init initramfs fails identifiers" "release initramfs $ir unpacked without /init"

mkdir -p "$t/id-linkinit"
ln -s /bin/sh "$t/id-linkinit/init"
initramfs_pack "$t/id-linkinit" "$ir"
assert_id_fail "symlink /init fails identifiers" "release initramfs $ir unpacked without /init"

# Valid single-block archive (exercises singular "1 block" cpio output)
mkdir -p "$t/id-oneblock"
printf '#!/bin/sh\n' > "$t/id-oneblock/init"
chmod 755 "$t/id-oneblock/init"
initramfs_pack "$t/id-oneblock" "$ir"
reset_id_state
run --version "$V2" identifiers || fail "valid 1-block initramfs passes identifiers"

cp "$t/id-valid.cpio.lz4" "$ir"
reset_id_state
run --version "$V2" identifiers || fail "valid real-shaped initramfs passes identifiers"
grep -Fq "no MAC address, serial, IMEI" "$t/log" || fail "valid initramfs prints clean note"
grep -q '^identifiers_done=clean ' "$st2" || fail "valid initramfs records identifiers_done"

# Failed reruns must clear an earlier identifiers_done (even before checking
# the identifiers file) so verify and tag both refuse, while --dry-run leaves
# the existing record intact and a fresh release creates no empty state file.
if run --version 2026.11.07 identifiers; then fail "identifiers before bundle/rootfs fails"; fi
[[ ! -e $R/out/release/2026.11.07/state ]] || fail "identifiers on a fresh release must not create an empty state file"
printf 'test_install_done=passed\n' >> "$st2"
run --dry-run --version "$V2" identifiers || fail "dry-run identifiers succeeds"
grep -Fq "would list " "$t/log" || fail "dry-run identifiers runs in dry-run mode"
grep -q '^identifiers_done=clean ' "$st2" || fail "dry-run identifiers must not clear identifiers_done"
if (RELEASE_IDENTIFIERS=$t/no-such-ids run --version "$V2" identifiers); then fail "rerun with missing identifiers file fails"; fi
grep -Fq "no $t/no-such-ids" "$t/log" || fail "rerun reports missing identifiers file"
if grep -q '^identifiers_done=' "$st2"; then fail "rerun with missing identifiers file must clear earlier identifiers_done"; fi
if run --dry-run --version "$V2" verify; then fail "verify --dry-run refuses after missing-ids rerun"; fi
grep -Fq "stage identifiers has not passed" "$t/log" || fail "verify --dry-run explains identifiers has not passed after missing-ids rerun"
# Re-establish clean pass before notes exist, then fail rerun after notes are
# written (listed identifier in notes): tag must refuse with "stage identifiers
# has not passed", not slip past its notes-not-yet-scanned check.
run --version "$V2" identifiers || fail "valid initramfs passes identifiers before notes"
grep -q '^identifiers_done=clean .*notes not yet scanned' "$st2" || fail "records notes not yet scanned"
printf 'promote_done=x\nkernel_release=%s\nkernel_tag=kernel-%s\n' "$krel" "$V2" >> "$st2"
printf '# Omamobile %s\nkernel-%s %s\nserial-ABC123\n' "$V2" "$V2" "$krel" > "$R/docs/release-notes/$V2.md"
if run --dry-run --version "$V2" tag; then fail "tag refuses notes not yet scanned before rerun"; fi
grep -Fq "ran before docs/release-notes/$V2.md existed" "$t/log" || fail "tag reports notes not yet scanned"
if run --version "$V2" identifiers; then fail "identifiers rerun fails on listed identifier in notes"; fi
grep -Fq "identifiers found (above)" "$t/log" || fail "identifiers rerun reports finding in notes"
if grep -q '^identifiers_done=' "$st2"; then fail "failed rerun on notes must clear earlier identifiers_done"; fi
if run --dry-run --version "$V2" tag; then fail "tag --dry-run refuses after failed identifiers rerun"; fi
grep -Fq "stage identifiers has not passed" "$t/log" || fail "tag --dry-run explains identifiers has not passed"
rm -f "$R/docs/release-notes/$V2.md"

mkdir -p "$t/id-bad/etc"
printf '#!/bin/sh\n' > "$t/id-bad/init"
chmod 755 "$t/id-bad/init"
printf 'device serial-ABC123 here\n' > "$t/id-bad/etc/id.txt"
initramfs_pack "$t/id-bad" "$t/id-bad.cpio.lz4"
cp "$t/id-bad.cpio.lz4" "$ir"
assert_id_fail "listed identifier in initramfs fails identifiers" "identifiers found (above)"
grep -Fq "listed identifier: serial-ABC123" "$t/log" || fail "reports listed identifier found in initramfs"

# Appended second cpio archive holding a listed identifier must fail closed
{ cat "$t/id-valid.cpio"; lz4 -dc "$t/id-bad.cpio.lz4"; } | lz4 -l -9 -q > "$ir"
assert_id_fail "appended cpio archive fails identifiers" "release initramfs $ir: cpio read "
grep -Fq "bytes (bytes after the archive's end, or an unpadded stream)" "$t/log" || fail "appended archive case explains the size mismatch"
grep -Eq '^[0-9]+ blocks?$' "$t/log" || fail "appended archive case prints cpio block count"
pass "the identifiers stage fails closed on a missing, unreadable, corrupt, truncated, partial or incomplete initramfs, clears stale state on rerun, and scans a valid one"
