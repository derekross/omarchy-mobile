manifest() {  # the bundle's manifest.json, as tools/make-bundle writes it
  rm -f "$BD/manifest.json"
  python3 -I "$SRC/tools/bundle-manifest" --bundle "$BD" --rootfs "$img" --rootfs-sha256 "$(cut -d' ' -f1 "$img.sha256")" \
    --version 2026.10.13 --kernel-release 7.3.0-test-1 --channel stable
}
manifest
(cd "$BD" && find . -type f ! -name SHA256SUMS -printf '%P\n' | sort | xargs sha256sum > SHA256SUMS)
binstall() {
  : > "$t/fastboot.log"
  answers | HOME=$t/home PATH="$t/bin:$PATH" "$BD/install" --work "$t/work" "$@" > "$t/out" 2>&1
}
if binstall --dry-run; then fail "refuses an unsigned bundle"; fi
grep -q 'not signed' "$t/out" || fail "says the bundle is unsigned"
binstall --dry-run --unsigned || { cat "$t/out"; fail "a development bundle installs with --unsigned"; }
grep -q 'would run: fastboot -s FAKE123 flash boot_b' "$t/out" || fail "a bundle uses its own images"
echo tampered >> "$BD/images/dtbo.img"
if binstall --dry-run --unsigned; then fail "refuses a bundle file that doesn't match SHA256SUMS"; fi
(cd "$BD" && find . -type f ! -name SHA256SUMS -printf '%P\n' | sort | xargs sha256sum > SHA256SUMS)
if command -v gpg >/dev/null; then
  G=$t/gnupg; mkdir -m700 "$G"
  gpg --homedir "$G" -q --batch --passphrase '' --quick-gen-key 'Not The Release Key <test@example.org>' ed25519 sign never 2>/dev/null
  gpg --homedir "$G" -q --batch --export > "$BD/omamobile.gpg"
  gpg --homedir "$G" -q --batch --detach-sign -o "$BD/SHA256SUMS.sig" "$BD/SHA256SUMS"
  if binstall --dry-run; then fail "refuses a bundle signed by another key"; fi
  grep -q 'not signed by the Omarchy Mobile key' "$t/out" || fail "says the signature is not the release key's"

  # Trust only this ephemeral key in the copied installer. Sign and verify
  # real bundle bytes with GPG; production's pinned keys stay unchanged.
  signer=$(gpg --homedir "$G" --with-colons --list-keys 2>/dev/null | awk -F: '$1 == "fpr" {print $10; exit}')
  sed -i "s/^SIGNING_KEYS=.*/SIGNING_KEYS='$signer'/" "$BD/install"
  seal() {
    [[ ${1:-} == --keep-manifest ]] || manifest
    (cd "$BD" && find . -type f ! -name SHA256SUMS ! -name SHA256SUMS.sig -printf '%P\n' | sort | xargs sha256sum > SHA256SUMS)
    gpg --homedir "$G" -q --batch --yes --detach-sign -o "$BD/SHA256SUMS.sig" "$BD/SHA256SUMS"
  }
  seal
  binstall --dry-run || { cat "$t/out"; fail "a bundle signed by the pinned fixture key installs"; }
  if binstall --dry-run --images "$t/images"; then fail "refuses images outside the signed bundle"; fi
  [[ ! -s $t/fastboot.log ]] || fail "rejects unsigned boot images before contacting the phone"
  grep -q 'a bundle uses its own images' "$t/out" || { cat "$t/out"; fail "names the external images refusal"; }
  # The signed name wins over a newer neighbour, and --rootfs cannot rename it.
  other=$t/bundle/omamobile-rootfs-zother-2099.01.01-aarch64.img.zst
  cp "$img" "$other"
  binstall --dry-run || { cat "$t/out"; fail "signed bundle selects exactly its named root image"; }
  if binstall --dry-run --rootfs "$other"; then fail "refuses the right bytes under an unsigned name"; fi
  [[ ! -s $t/fastboot.log ]] || fail "rejects an unsigned root name before contacting the phone"
  rm "$other"
  # Another matching-device image with its own valid checksum must not
  # replace the root image named in the signed manifest.
  cp "$t/root.img" "$t/changed.img"
  printf 'substituted image\n' > "$t/changed.txt"
  debugfs -w -R "write $t/changed.txt /etc/substituted" "$t/changed.img" >/dev/null 2>&1
  zstd -q "$t/changed.img" -o "$t/changed.img.zst"
  cp "$t/changed.img.zst" "$t/bundle/$(basename "$img")"
  (cd "$t/bundle" && sha256sum "$(basename "$img")" > "$(basename "$img").sha256")
  if binstall --dry-run; then fail "refuses a substituted root image with an updated checksum"; fi
  [[ ! -s $t/fastboot.log ]] || fail "rejects substituted root before contacting the phone"
  grep -q 'root image does not match the signed bundle' "$t/out" || { cat "$t/out"; fail "names the signed root mismatch"; }
  cp "$img" "$img.sha256" "$t/bundle/"
  # The manifest itself must be covered by the signed checksums.
  sed -i '/  MANIFEST$/d' "$BD/SHA256SUMS"
  gpg --homedir "$G" -q --batch --yes --detach-sign -o "$BD/SHA256SUMS.sig" "$BD/SHA256SUMS"
  if binstall --dry-run; then fail "refuses a manifest outside the signed checksums"; fi
  [[ ! -s $t/fastboot.log ]] || fail "rejects an unauthenticated manifest before contacting the phone"

  # manifest.json: the install plan as data must match the descriptor and the
  # installer's rules exactly. Each change below is signed again, so only the
  # manifest check can refuse it.
  seal
  binstall --dry-run || { cat "$t/out"; fail "a signed bundle with its manifest.json installs"; }
  grep -q 'manifest.json: Omarchy Mobile 2026.10.13 (developer preview), its plan matches the descriptor' "$t/out" \
    || { cat "$t/out"; fail "says the manifest's plan matches"; }
  mrefuse() {  # WHY PYTHON-EDIT EXPECTED-MESSAGE
    manifest
    python3 -I -c "import json, sys; p = sys.argv[1]; m = json.load(open(p)); $2; json.dump(m, open(p, 'w'))" "$BD/manifest.json"
    seal --keep-manifest
    if binstall --dry-run; then fail "refuses a manifest with $1"; fi
    [[ ! -s $t/fastboot.log ]] || fail "contacts no phone for a manifest with $1"
    grep -qF -- "$3" "$t/out" || { cat "$t/out"; fail "names the problem with $1"; }
  }
  mrefuse "another product" 'm["install"]["product"] = "cheetah"' "but the descriptor is testdev"
  mrefuse "a locked bootloader allowed" 'm["install"]["require_unlocked_bootloader"] = False' "must require an unlocked bootloader"
  mrefuse "unmatched bootloader slots allowed" 'm["install"]["require_matching_bootloader_slots"] = False' "both bootloader slots to match"
  mrefuse "a string for true" 'm["install"]["require_unlocked_bootloader"] = "true"' "not a valid release manifest"
  mrefuse "an extra write (vbmeta_b)" 'm["install"]["writes"].insert(1, {"partition": "vbmeta_b", "source": "images/boot.img", "size": 11})' "writes are not exactly slot B"
  mrefuse "a slot A write" 'm["install"]["writes"][0]["partition"] = "boot_a"' "writes are not exactly slot B"
  mrefuse "a missing userdata write" 'm["install"]["writes"].pop()' "writes are not exactly slot B"
  mrefuse "a wrong partition size" 'm["install"]["writes"][0]["partition_size"] = 4096' "writes are not exactly slot B"
  mrefuse "another step after the writes" 'm["install"]["after"].append("erase misc")' "set-active b and reboot, nothing else"
  mrefuse "a wider allowlist" 'm["install"]["storage_guard_allowlist"].append("persist")' "storage-guard allowlist"
  mrefuse "an unlisted bundle file" 'm["files"] = [f for f in m["files"] if f["path"] != "images/dtbo.img"]' "does not list exactly the bundle's files"
  mrefuse "a wrong file checksum" 'm["files"][0]["sha256"] = "0" * 64' "does not match manifest.json"
  mrefuse "a path out of the bundle" 'm["files"][0]["path"] = "../x"' "not a valid release manifest"
  mrefuse "another root image" 'm["root_image"]["sha256"] = "1" * 64' "name different root images"
  mrefuse "another kernel" 'm["kernel"]["release"] = "7.3.0-other"' "name different kernels"
  mrefuse "a version that isn't a date" 'm["version"] = "latest"' "versioned by the calendar"
  mrefuse "another format" 'm["format"] = 2' "reads format 1"
  manifest; rm "$BD/manifest.json"; seal --keep-manifest
  if binstall --dry-run; then fail "refuses a bundle without manifest.json"; fi
  grep -q 'has no manifest.json' "$t/out" || fail "says manifest.json is missing"
  seal
  sed -i '/  manifest\.json$/d' "$BD/SHA256SUMS"
  gpg --homedir "$G" -q --batch --yes --detach-sign -o "$BD/SHA256SUMS.sig" "$BD/SHA256SUMS"
  if binstall --dry-run; then fail "refuses a manifest.json outside the signed checksums"; fi
  grep -q 'must cover manifest.json exactly once' "$t/out" || fail "says manifest.json must be covered"
  seal
  binstall --dry-run || { cat "$t/out"; fail "the bundle installs again once sealed"; }
  pass "manifest.json: the plan must match the descriptor and the installer's rules exactly, or nothing is written"
fi
[[ -z $(flashing_calls) ]] || fail "a refused bundle flashes nothing"
pass "bundle mode: signature required (pinned key), checksums checked, its own images used"

# In a bundle that keeps its tools in tools/ this script is
# tools/install-phone: it finds the bundle from there. --verify-only checks
# the files and never contacts the phone.
mkdir -p "$BD/tools"
mv "$BD/install" "$BD/tools/install-phone"
printf '#!/bin/bash\n' > "$BD/install"
manifest
(cd "$BD" && find . -type f ! -name SHA256SUMS ! -name SHA256SUMS.sig -printf '%P\n' | sort | xargs sha256sum > SHA256SUMS)
rm -f "$BD/SHA256SUMS.sig"
tinstall() {
  : > "$t/fastboot.log"
  answers | HOME=$t/home PATH="$t/bin:$PATH" "$BD/tools/install-phone" --work "$t/work" "$@" > "$t/out" 2>&1
}
tinstall --dry-run --unsigned || { cat "$t/out"; fail "install-phone in a bundle's tools/ installs that bundle"; }
grep -q "would run: fastboot -s FAKE123 flash boot_b $BD/images/boot.img" "$t/out" || fail "from tools/ it uses the bundle's images"
tinstall --verify-only --unsigned || { cat "$t/out"; fail "--verify-only passes a good bundle"; }
[[ ! -s $t/fastboot.log ]] || fail "--verify-only never runs fastboot"
grep -q 'the phone was not contacted' "$t/out" || fail "--verify-only says the phone was not contacted"
echo tampered >> "$BD/images/dtbo.img"
if tinstall --verify-only --unsigned; then fail "--verify-only refuses a bundle file that doesn't match"; fi
[[ ! -s $t/fastboot.log ]] || fail "a refused --verify-only never runs fastboot"
pass "as a bundle's tools/install-phone: finds the bundle, and --verify-only checks it with no phone"

# The guided installer has asked the questions: they aren't printed again,
# the answers are still read and checked, and the closing hints stay out
OMAMOBILE_INSTALL_GUIDED=1 install --dry-run || { cat "$t/out"; fail "a dry run for the guided installer succeeds"; }
grep -q 'User name\|Password or PIN\|tools/phone-provision' "$t/out" && fail "the guided installer's run prints no question and no hint"
grep -q 'user:      alice (pin)' "$t/out" || fail "the piped answers are used"
CONFIRM=nope OMAMOBILE_INSTALL_GUIDED=1 install && fail "the codename is still required from the guided installer"
[[ -z $(flashing_calls) ]] || fail "a wrong codename from the guided installer writes nothing"
pass "run by the guided installer: no questions printed, the answers and the codename still checked"

# --serial pins the phone: another one in fastboot mode is refused before it
# is asked anything, and the named one installs as ever
install --dry-run --serial FAKE123 || { cat "$t/out"; fail "--serial with the connected phone's serial succeeds"; }
grep -c 'would run: fastboot -s FAKE123 flash userdata' "$t/out" >/dev/null || fail "--serial installs on the phone it names"
if install --serial OTHER999; then fail "--serial refuses another phone"; fi
grep -c 'not the one this install was started for' "$t/out" >/dev/null || fail "--serial says the phone is another one"
[[ $(cat "$t/fastboot.log") == devices ]] || { cat "$t/fastboot.log"; fail "a phone --serial doesn't name gets no command at all"; }
if install --serial 'two words'; then fail "--serial refuses a value with a space"; fi
pass "--serial: only the named phone is read or written"

# The script itself: one write path, and none of the forbidden fastboot forms
code=$(grep -v '^[[:space:]]*#' tools/install-phone)
grep -nE '(run|fb|FASTBOOT")[^#]*( -w( |$)|--slot|flashing|erase|format|oem )' <<<"$code" && fail "no -w, --slot, flashing, erase, format or oem"
[[ $(grep -cE '^\s*run flash ' <<<"$code") == 1 ]] || fail "one flash call, inside flash()"
[[ $(grep -cE '^\s*fb "\$@"' <<<"$code") == 1 ]] || fail "one fastboot write path, inside run()"
# The slot check (pfb and the slot_probe functions) is the one other place
# that changes anything, and only the slot flags: its calls are getvar all,
# --set-active=<a slot variable> and reboot bootloader, nothing else, and no
# code outside it makes them.
probe=$(awk '/^(pfb|slot_probe[a-z_]*)\(\) \{/ { f = 1 } f { print } f && /\}$/ && (/^\}$/ || /^pfb\(\)/) { f = 0 }' <<<"$code")
rest=$(awk '/^(pfb|slot_probe[a-z_]*)\(\) \{/ { f = 1 } !f { print } f && /\}$/ && (/^\}$/ || /^pfb\(\)/) { f = 0 }' <<<"$code")
[[ -n $probe && $(wc -l <<<"$probe") -gt 60 && $(($(wc -l <<<"$probe") + $(wc -l <<<"$rest"))) == $(wc -l <<<"$code") ]] || fail "the slot check's functions are found"
[[ $(sed 's/^/ /' <<<"$probe" | grep -oE '[^A-Za-z_"$]pfb [^|;)]*' | sed -E 's/^.*(pfb )/\1/; s/ +$//' | LC_ALL=C sort -u) == 'pfb --set-active="$other"
pfb --set-active="$slot"
pfb --set-active="$x"
pfb getvar all 2>&1
pfb reboot bootloader' ]] || fail "the slot check sends only getvar all, --set-active=<slot> and reboot bootloader (no flash, erase, boot or oem)"
sed 's/^/ /' <<<"$rest" | grep -nE '[^A-Za-z_]pfb( |$)' && fail "pfb is used only inside the slot check"
[[ $(sed 's/^/;/' <<<"$code" | grep -oE '([;&|({]|then|do|else)\s*run\s[^|;)]*' | sed -E 's/^.*(run\s)/\1/; s/ +$//' | LC_ALL=C sort) == 'run --set-active=b
run flash "$part" "$file"
run reboot' ]] || fail "run() is called three times: flash, --set-active=b and reboot"
[[ $(sed 's/^/ /' <<<"$code" | grep -oE '[^A-Za-z_p]fb [^(|;]*' | sed -E 's/^.*(fb )/\1/; s/ +$//' | LC_ALL=C sort) == 'fb "$@"
fb getvar all 2>&1' ]] || fail "fb is called twice: getvar all, and run()'s write path"
[[ $(grep -oE '"\$FASTBOOT" (-s "\$serial" "\$@"|[a-z-]+)' <<<"$code" | LC_ALL=C sort | uniq -c | sed -E 's/^ +//') == '2 "$FASTBOOT" -s "$serial" "$@"
1 "$FASTBOOT" debugfs
2 "$FASTBOOT" devices' ]] || fail "fastboot itself is run by fb(), pfb() and the two device listings only"
pass "one guarded write path; no -w, --slot, flashing, erase, format or oem; --set-active=<slot> and reboot bootloader in the slot check only"

# Reserved names agree with omamobile-firstboot's
a=$(sed -n "s/^RESERVED='\(.*\)'$/\1/p" tools/install-phone)
b=$(sed -n "s/^RESERVED='\(.*\)'$/\1/p" packages/omamobile-firstboot/bin/omamobile-firstboot)
[[ -n $a && $a == "$b" ]] || fail "install-phone and omamobile-firstboot reserve the same names"
pass "install-phone and omamobile-firstboot agree on reserved names"
