#!/bin/bash
# SPDX-License-Identifier: MIT
# Smoke test of a root image from tools/build-rootfs, read through debugfs
# (no root, no loop mount, nothing written):
#   tests/rootfs-smoke out/omamobile-rootfs-<device>-<version>-aarch64.img.zst   (or a raw .img)
# Checks the label, that there is no account but a locked root, the keyrings,
# the [omamobile] repository and its place in pacman.conf, the first-boot
# unit, that the first boot has nothing to ask (systemd-firstboot masked, a
# locale and a time zone in the image), the kernel modules, the MANIFEST, and
# that no per-machine state,
# per-phone data or Google file is in it.
set -euo pipefail
# debugfs and friends live in /sbin on Debian-like hosts
export PATH=$PATH:/usr/sbin:/sbin
img=${1:?usage: tests/rootfs-smoke IMAGE[.zst]}
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
# Scratch space beside the image: it holds a full decompressed copy
t=$(mktemp -d "$(dirname "$(readlink -f "$img")")/.rootfs-smoke.XXXXXX"); trap 'chmod -R u+rwX "$t" 2>/dev/null; rm -rf "$t"' EXIT

if [[ $img == *.zst ]]; then
  if [[ -f $img.sha256 ]]; then
    (cd "$(dirname "$img")" && sha256sum -c --quiet "$(basename "$img").sha256") || fail "checksum of $img"
    pass "checksum"
  fi
  zstd -q -d --sparse -o "$t/root.img" "$img"
  img=$t/root.img
fi
d() { debugfs -R "$1" "$img" 2>/dev/null; }
cat_() { d "cat $1"; }
exists() { d "stat $1" | grep -c '^Inode:' >/dev/null; }

[[ $(dumpe2fs -h "$img" 2>/dev/null | sed -n 's/^Filesystem volume name: *//p') == omamobile-root ]] || fail "label omamobile-root"
pass "ext4, label omamobile-root"

passwd=$(cat_ /etc/passwd)
grep -q '^root:' <<<"$passwd" || fail "/etc/passwd readable"
grep -q '^alarm:' <<<"$passwd" && fail "no alarm account"
awk -F: '$3 >= 1000 && $3 != 65534' <<<"$passwd" | grep -c . >/dev/null && fail "no user account"
[[ $(cat_ /etc/shadow | awk -F: '$1 == "root" {print substr($2, 1, 1)}') == '!' ]] || fail "root is locked"
pass "no account but root, and root is locked"

for f in /usr/share/pacman/keyrings/omamobile.gpg /usr/share/pacman/keyrings/omarchy.gpg \
         /usr/share/pacman/keyrings/archlinuxarm.gpg; do
  exists "$f" || fail "keyring $f"
done
pass "keyrings: Arch Linux ARM, Omarchy, Omarchy Mobile"

conf=$(cat_ /etc/pacman.conf)
order=$(grep -o '^\[[a-z]*\]' <<<"$conf" | tr -d '[]' | tr '\n' ' ')
[[ $order == "options omamobile omarchy core extra alarm aur " ]] || fail "pacman.conf repository order: $order"
servers=$(cat_ /etc/pacman.d/omamobile-mirrorlist | grep -E '^[[:space:]]*Server' || true)
case $servers in
  'Server = https://pkgs.omamobile.org/stable/$arch') channel=stable ;;
  'Server = https://pkgs.omamobile.org/development/$arch') channel=development ;;
  'Server = file:///var/lib/omamobile/repo/$arch') channel=local ;;
  *) fail "[omamobile] mirrorlist: one Server line, for stable, development or local (has: ${servers:-none})" ;;
esac
recorded=$(cat_ /usr/share/omamobile/rootfs/MANIFEST | sed -n 's/^omamobile channel: //p')
[[ -z $recorded || $recorded == "$channel" ]] || fail "the MANIFEST says channel $recorded, the mirrorlist $channel"
exists /var/lib/omamobile/repo/aarch64/omamobile.db || fail "the [omamobile] repository is in the image"
if [[ $channel != local ]] && exists /var/lib/pacman/sync/omamobile.db; then
  fail "no build-time [omamobile] index in an image that follows $channel"
fi
pass "[omamobile] first in pacman.conf, channel $channel, its repository in the image"

exists /usr/bin/omamobile-firstboot || fail "omamobile-firstboot installed"
exists /usr/lib/systemd/system/multi-user.target.wants/omamobile-firstboot.service || fail "the first-boot unit is enabled"
exists /etc/omamobile/firstboot.conf && fail "no firstboot.conf in the image (the installer writes it)"
for unit in sshd NetworkManager systemd-networkd sddm; do
  d "ls -l /etc/systemd/system/multi-user.target.wants" | grep -c "$unit.service" >/dev/null ||
    d "ls -l /etc/systemd/system" | grep -c "display-manager.service" >/dev/null || fail "$unit enabled"
done
pass "first boot unit, sshd, NetworkManager, networkd and SDDM enabled"

manifest=$(cat_ /usr/share/omamobile/rootfs/MANIFEST)
grep -q '^version: ' <<<"$manifest" || fail "MANIFEST in the image"
release=$(sed -n 's/^kernel modules: \([^ ]*\) .*/\1/p' <<<"$manifest")
[[ -n $release ]] && exists "/usr/lib/modules/$release/modules.dep" || fail "kernel modules for $release, with depmod run"
grep -q '^omamobile-device-[a-z0-9]* .* omamobile$' <<<"$manifest" || fail "a device package from [omamobile] in the MANIFEST"
pass "MANIFEST, device package, modules for $release"
# The first boot asks for nothing (rootfs/first-boot.sh): systemd-firstboot
# is masked, and what it would have asked for is in the image. Images from
# before that have no "first boot:" line in their MANIFEST
if grep -c '^first boot: ' <<<"$manifest" >/dev/null; then
  d "stat /etc/systemd/system/systemd-firstboot.service" | grep -c 'Fast link dest: "/dev/null"' >/dev/null ||
    fail "systemd-firstboot.service is masked (it fails on a phone, which has no console)"
  grep -c '^LANG=.' <<<"$(cat_ /etc/locale.conf)" >/dev/null || fail "/etc/locale.conf sets LANG"
  zone=$(d "stat /etc/localtime" | sed -n 's/^Fast link dest: "\(.*\)"$/\1/p')
  [[ $zone == /usr/share/zoneinfo/?* ]] && exists "$zone" || fail "/etc/localtime links to a zone in the image (it is '${zone:-missing}')"
  grep -cxF "$(cat_ /etc/locale.conf | grep -m1 '^LANG=')" <<<"$(sed -n 's/^first boot: .*; \(LANG=[^;]*\); .*/\1/p' <<<"$manifest")" >/dev/null ||
    fail "the MANIFEST's first boot line names the image's LANG"
  pass "the first boot asks for nothing: systemd-firstboot masked, a locale and a time zone (${zone#/usr/share/zoneinfo/}) in the image"
else
  pass "# skip: an image from before the first-boot defaults (no 'first boot:' line in its MANIFEST)"
fi
# A device whose package ships boot files: the kernel is linux-omamobile,
# the release the boot images were built from, with its slot-B hook, and
# no AUTO_WRITE in the image (install-phone writes it)
if exists /usr/share/omamobile/linux/kernel.release; then
  [[ $(cat_ /usr/share/omamobile/linux/kernel.release) == "$release" ]] || fail "linux-omamobile is the MANIFEST's release $release"
  exists /usr/bin/omamobile-boot-update || fail "omamobile-boot-update comes with linux-omamobile"
  exists /etc/omamobile/boot-update.conf && fail "no boot-update.conf in the image (the installer writes it)"
  pass "kernel package linux-omamobile ($release) and omamobile-boot-update, hook off in the image"
fi

# Images from before omamobile-omarchy patched Omarchy in build-inside
if exists /usr/bin/omamobile-omarchy-patches; then
  exists /usr/share/libalpm/hooks/95-omamobile-omarchy-patches.hook || fail "the Omarchy re-patch hook is installed"
  patches=$(cat_ /var/lib/omamobile/omarchy-patches/status.json)
  grep -q '"result": "ok"' <<<"$patches" || fail "the Omarchy patch series is applied (status.json: $(head -c 300 <<<"$patches"))"
  grep -q 'omamobile-update' <<<"$(cat_ /usr/bin/omarchy-update)" || fail "omarchy update hands over to omamobile-update"
  pass "Omarchy patch series applied, re-patch hook installed"
fi

# Images from before omamobile-omarchy wrote the lock's PAM file (TOUCH-PLAN 0.1)
if exists /usr/lib/omamobile-omarchy/lock-pam; then
  grep -q 'pam_unix.so' <<<"$(cat_ /etc/pam.d/omarchy-lock-password)" || fail "the lock's PAM file is in the image"
  pass "the lock's PAM file (omarchy-lock-password) is in the image"
fi

# Voice out of the box (images from before it have no omamobile-voice): the
# engine, its user daemon and the speech model omamobile-setup-user links
if grep -q '^omamobile-voice ' <<<"$manifest"; then
  exists /usr/bin/voxtype || fail "voxtype is installed with omamobile-voice"
  exists /usr/lib/systemd/user/voxtype.service || fail "Voxtype's user unit is installed"
  exists /usr/share/omamobile/voice/models/ggml-base.en.bin || fail "the base.en speech model is in the image"
  pass "voice out of the box: voxtype, its user unit and base.en"
fi

# Phone, Contacts and Messages (images from before omamobile-apps 0.2.1 have
# none): the apps, their launchers and the agent, which D-Bus activation
# starts when an app needs it; its user unit isn't enabled in the image.
if grep -q '^omaphone ' <<<"$manifest"; then
  for f in /usr/bin/omaphone /usr/bin/omamessages /usr/bin/omatel-agent \
           /usr/share/applications/org.omamobile.Phone.desktop /usr/share/applications/org.omamobile.Contacts.desktop \
           /usr/share/applications/org.omamobile.Messages.desktop /usr/share/dbus-1/services/org.omamobile.Phone1.service; do
    exists "$f" || fail "telephony apps: $f"
  done
  exists /etc/systemd/user/default.target.wants/omatel-agent.service && fail "omatel-agent is not enabled in the image"
  pass "Phone, Contacts, Messages and omatel-agent (D-Bus activated)"
fi
# Nothing in the image starts the modem or its RIL at boot: enabling them is
# MODEM-PLAN M4.6's step (each boot powers the modem, each reboot costs one
# recovered UFS error-handler pass), never the image's.
for unit in omamobile-modem omamobile-sitd omamobile-sit-data omamobile-mmd; do
  d "ls -l /etc/systemd/system/multi-user.target.wants" | grep -c "$unit\.service" >/dev/null && fail "$unit is not enabled in the image"
  d "ls -l /etc/systemd/system/omamobile-sitd.service.wants" | grep -c "$unit\.service" >/dev/null && fail "$unit is not enabled in the image"
done
pass "no modem unit enabled at boot"

exists /etc/pacman.d/gnupg && fail "no pacman keyring (it holds a private key)"
d "ls /etc/ssh" | grep -c ssh_host_ >/dev/null && fail "no SSH host keys"
[[ $(cat_ /etc/machine-id) == uninitialized ]] || fail "machine id uninitialized"
exists /root/.ssh && fail "no root SSH keys"
d "ls -p /etc/NetworkManager/system-connections" | grep -c 'nmconnection' >/dev/null && fail "no Wi-Fi connections"
pass "no per-machine state: keyring, host keys, machine id, SSH keys, Wi-Fi"

for p in /usr/lib/firmware/updates /usr/lib/omamobile-fp/root /usr/lib/omamobile-vendor/gnss/root \
         /usr/lib/omamobile-vendor/modem/root /usr/lib/omamobile-vendor/waves/root /usr/lib/firmware/omamobile/camera \
         /var/lib/omamobile-fp/persist-ss /var/lib/omamobile-vendor/modem/props.conf /etc/omamobile/modem-nv.sha256; do
  exists "$p" && fail "no Google files or per-phone data: $p"
done
pass "no Google firmware, vendor trees or per-phone data"

mkdir -p "$t/dump"
for dir in /etc /usr/lib/systemd /usr/share/omamobile; do
  debugfs -R "rdump $dir $t/dump" "$img" >/dev/null 2>&1 || true
done
# (the widget tool keeps the old prefix reserved on purpose: UserWidgets.js)
if grep -rIl omandroid "$t/dump" 2>/dev/null | grep -v '/omamobile\.home/UserWidgets\.js$' | head -5 | grep .; then fail "no 'omandroid' left in /etc, /usr/lib/systemd, /usr/share/omamobile"; fi
pass "no old project name in /etc, /usr/lib/systemd, /usr/share/omamobile"
