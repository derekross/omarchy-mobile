#!/bin/bash
# SPDX-License-Identifier: MIT
# No phone: verify the separate U-Boot layout and its pre-flash checks.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
t=$(mktemp -d)
trap 'rm -rf "$t"' EXIT
mkdir -p "$t/repo/bin" "$t/repo/device/flame/native" "$t/repo/tools" "$t/bin"
cp bin/omamobile "$t/repo/bin/"
cp device/flame/native/device.conf device/flame/native/root_image.py "$t/repo/device/flame/native/"
printf 'DEVICE=flame\nSRC_DIR=/nonexistent\n' >"$t/repo/omamobile.conf"
printf '#!/bin/sh\nexit 0\n' >"$t/repo/tools/phone-ssh"
chmod +x "$t/repo/tools/phone-ssh"
python3 - "$t/loader.img" <<'PY'
from pathlib import Path
import sys, struct
data=bytearray(8192);data[:8]=b'ANDROID!'
struct.pack_into('<3I',data,8,64,0x8000,0)
struct.pack_into('<I',data,36,4096)
data[4096:4099]=b'\x1f\x8b\x08'
Path(sys.argv[1]).write_bytes(data)
PY
cat >"$t/bin/fastboot" <<'EOF'
#!/bin/sh
echo "$*" >>"$TEST_TMP/calls"
case "$*" in
  devices) printf 'TEST\tfastboot\n' ;;
  'getvar all') cat "$TEST_TMP/facts" ;;
  'getvar partition-size:userdata') echo "(bootloader) partition-size:userdata:${TEST_ROOT_CAPACITY:-0x1000000000}" ;;
  'flash userdata '*) echo OKAY ;;
  'getvar slot-successful:b') echo "(bootloader) slot-successful:b:${TEST_POST_FLASH_SUCCESSFUL:-yes}" ;;
  'erase boot_b') test "${TEST_ERASE_FAIL:-0}" = 0 || exit 1; echo OKAY ;;
  'flash boot_b '*) echo OKAY ;;
esac
EOF
chmod +x "$t/bin/fastboot"
export TEST_TMP=$t
facts() { printf '(bootloader) product:%s\n(bootloader) unlocked:%s\n(bootloader) current-slot:%s\n(bootloader) slot-successful:b:%s\n' "$1" "$2" "$3" "$4" >"$t/facts"; }
om() { FLAME_NATIVE=1 PATH="$t/bin:$PATH" KERNEL_OUT="$t/out" UBOOT_IMAGE="$t/loader.img" UBOOT_SHA256="$sum" "$t/repo/bin/omamobile" "$@" >"$t/log" 2>&1; }
sum=$(sha256sum <"$t/loader.img" | cut -d' ' -f1)
om images || { cat "$t/log"; exit 1; }
cmp "$t/loader.img" "$t/out/images/boot.img"
[[ $(cat "$t/out/images/DEVICE") == flame && $(cat "$t/out/images/BOOT_METHOD") == uboot-ext4 ]]
facts flame yes b yes
om flash || { cat "$t/log"; exit 1; }
[[ $(grep -c '^flash ' "$t/calls") -eq 1 ]]
grep -q '^flash boot_b ' "$t/calls"
if grep -q -- '--set-active' "$t/calls"; then exit 1; fi
printf 'product: flame\nunlocked: yes\ncurrent-slot: b\nslot-successful:b: yes\n' >"$t/facts"
om flash || { cat "$t/log"; exit 1; }
for bad in 'other yes b yes' 'flame no b yes' 'flame yes a yes' 'flame yes b no'; do
  # Split only these fixed test tokens.
  # shellcheck disable=SC2086
  facts $bad
  : >"$t/calls"
  if om flash; then echo "not ok - accepted $bad"; exit 1; fi
  if grep -q '^flash ' "$t/calls"; then exit 1; fi
done
facts flame yes b no
printf '(bootloader) slot-unbootable:b:no\n(bootloader) slot-retry-count:b:2\n' >>"$t/facts"
export FLAME_REPAIR_BOOT_B=1 TEST_POST_FLASH_SUCCESSFUL=no
: >"$t/calls"
if om flash; then echo 'not ok - rebooted with unsuccessful B'; exit 1; fi
grep -q '^erase boot_b$' "$t/calls"
grep -q '^flash boot_b ' "$t/calls"
if grep -q '^reboot' "$t/calls"; then exit 1; fi
: >"$t/calls"
export TEST_ERASE_FAIL=1
if om flash; then echo 'not ok - ignored erase failure'; exit 1; fi
if grep -q '^flash ' "$t/calls"; then exit 1; fi
unset TEST_ERASE_FAIL
sed -i 's/slot-retry-count:b:2/slot-retry-count:b:0/' "$t/facts"
: >"$t/calls"
if om flash; then echo 'not ok - repaired exhausted B'; exit 1; fi
if grep -q '^erase ' "$t/calls"; then exit 1; fi
unset FLAME_REPAIR_BOOT_B TEST_POST_FLASH_SUCCESSFUL
facts flame yes b yes
printf changed >>"$t/out/images/boot.img"
: >"$t/calls"
if om flash; then echo 'not ok - accepted modified image'; exit 1; fi
if grep -q '^flash ' "$t/calls"; then exit 1; fi
sum=$(printf '%064d' 0)
if om images; then echo 'not ok - accepted incorrect source checksum'; exit 1; fi
if om push; then echo 'not ok - accepted unimplemented direct write'; exit 1; fi
python3 - "$t/loader.img" <<'PY'
from pathlib import Path
import struct, sys
p=Path(sys.argv[1])
with p.open('wb') as f:
    header=bytearray(48)
    header[:8]=b'ANDROID!'
    struct.pack_into('<I',header,40,2)
    f.write(header)
    f.truncate(67108864)
PY
sum=$(sha256sum <"$t/loader.img" | cut -d' ' -f1)
export FLAME_BOOT_ROLE=stock-recovery
facts flame yes b no
om images || { cat "$t/log"; exit 1; }
: >"$t/calls"
om flash || { cat "$t/log"; exit 1; }
grep -q '^flash boot_b ' "$t/calls"
if grep -q '^reboot' "$t/calls"; then echo 'not ok - stock recovery rebooted before data reset'; exit 1; fi
echo 'ok - flame stages only checked U-Boot; flash verifies product, unlock and existing successful B'

# A separate, acknowledged root-image phase writes userdata only and stays in
# Android fastboot. This is a real local ext4 fixture, never a block device.
unset FLAME_BOOT_ROLE
truncate -s 16M "$t/root.img"
mkfs.ext4 -q -F -b 4096 -L omamobile-root -O ^orphan_file,^metadata_csum_seed "$t/root.img"
export FLAME_BOOT_ROLE=userdata FLAME_ROOT_IMAGE="$t/root.img"
FLAME_ROOT_SHA256=$(sha256sum < "$t/root.img" | cut -d' ' -f1)
export FLAME_ROOT_SHA256
facts flame yes b yes
om images || { cat "$t/log"; exit 1; }
: > "$t/calls"
if om flash; then echo 'not ok - userdata erased without acknowledgement'; exit 1; fi
if grep -q '^flash ' "$t/calls"; then exit 1; fi
export FLAME_ERASE_USERDATA=flame
om flash || { cat "$t/log"; exit 1; }
grep -q '^flash userdata ' "$t/calls"
if grep -Eq '^flash boot|^reboot|--set-active' "$t/calls"; then exit 1; fi
export TEST_ROOT_CAPACITY=0x1000
: > "$t/calls"
if om flash; then echo 'not ok - oversized root written'; exit 1; fi
if grep -q '^flash ' "$t/calls"; then exit 1; fi
unset TEST_ROOT_CAPACITY
FLAME_ROOT_SHA256=$(printf '%064d' 0)
if om images; then echo 'not ok - unverified root staged'; exit 1; fi
echo 'ok - root phase checks raw ext4/label/hash/fsck/capacity; requires acknowledgement; writes userdata only; no reboot'
