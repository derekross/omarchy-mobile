# SPDX-License-Identifier: MIT
# Omarchy Mobile kernel config fragment, merged on top of arm64 defconfig.

# Google Tensor SoCs live under ARCH_EXYNOS

# Early display: the framebuffer the bootloader leaves running
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB_SIMPLE=y

# USB gadget, for networking (ssh) and a serial console over the USB-C port
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y

# GPU (Mali-G710)
CONFIG_DRM_PANTHOR=m

# Waydroid: C binder (not Rust binder), binderfs, PSI, memfd
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
# CONFIG_ANDROID_BINDER_IPC_RUST is not set
CONFIG_PSI=y
CONFIG_MEMFD_CREATE=y

# Initramfs and containers
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# M1 essentials built in, so the initramfs needs no modules
CONFIG_ARCH_EXYNOS=y
CONFIG_EXYNOS_PMU=y
CONFIG_PHY_EXYNOS5_USBDRD=y

CONFIG_USB_LIBCOMPOSITE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_BOOT_CONFIG=y

# Kernel log survives a warm reboot (read it from stock Android's /sys/fs/pstore)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# Built in rather than modules: their tristate dependencies are =m in defconfig
CONFIG_DRM=y
CONFIG_TYPEC=y
CONFIG_USB=y
CONFIG_USB_DWC3_EXYNOS=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_PHY_EXYNOS5_USBDRD=y
CONFIG_DRM_SIMPLEDRM=y

# The bootloader leaves both watchdogs running; the driver stops them at probe
CONFIG_WATCHDOG=y
CONFIG_S3C2410_WATCHDOG=y

# UFS storage (read-only bring-up). defconfig already has these =y; pinned so
# the initramfs needs no modules. Inline crypto stays on: the host driver then
# sets the FMP descriptor type through EL3 exactly as stock does.
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_EXYNOS=y
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_SCSI_UFS_CRYPTO=y
CONFIG_PHY_SAMSUNG_UFS=y
CONFIG_MFD_SYSCON=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_EFI_PARTITION=y

# Register access from userspace during bring-up
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set

# Readable console on a 1440x3120 panel
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# The OS name in uname -r: 7.3.0-rc6-omamobile
CONFIG_LOCALVERSION="-omamobile-push1"

# Landlock: pacman 7 sandboxes downloads with it, and Arch/Omarchy expect it
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,lockdown,yama,integrity,bpf"

# Touchscreen: Synaptics S3908 (TouchComm) on PERIC1 USI0 SPI. Built in, as
# the Arch root has no modules for this kernel.
CONFIG_PINCTRL_EXYNOS=y
CONFIG_EXYNOS_USI=y
CONFIG_SPI_S3C64XX=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_SPI=y
# Pixel Fold cover touch id reader (device/felix/COVER-TOUCH-PLAN.md).
# Module. The node stays disabled; cover-touch.dtso enables it, and
# omamobile-device-felix blacklists salixp so it does not autoload.
CONFIG_TOUCHSCREEN_SALIXP=m

# Wi-Fi (BCM4389 on PCIe), Bluetooth (BCM4389 on the APM UART) and the
# MAX77759 charger/TCPC/fuel gauge. All modules, none needed to boot; the
# MAX77759 ones are blacklisted from autoload during bring-up
# (omamobile-device-cheetah: modprobe.d/omamobile-max77759.conf).
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
# brcmfmac debug messages (module parameter debug=0x80004 for PCIe + info),
# for the W2 bring-up. Quiet unless the parameter is set.
CONFIG_BRCMDBG=y
# gs201 PCIe controller + PHY for the Wi-Fi link. pcie_1 is disabled in the
# DT until the bring-up gates; pcie_gs201 is blacklisted from autoload
# (omamobile-device-cheetah: modprobe.d/omamobile-wifi.conf). The DMA pool is
# for gate W4 (DMA bounce region the HSI2 S2MPU will confine the chip to).
CONFIG_PCIE_GS201=m
# W4: the HSI2 PCIe System MMU as the Wi-Fi DMA window (only binds to an
# enabled DT node; mode=0 by default only logs)
CONFIG_PCIE_GS201_SYSMMU=m
CONFIG_PHY_GS201_PCIE=m
CONFIG_PCI_PWRCTRL_GENERIC=y
CONFIG_DMA_RESTRICTED_POOL=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_BCM=y
CONFIG_MFD_MAX77759=m
CONFIG_CHARGER_MAX77759=m
CONFIG_BATTERY_MAX17042=m

# Display bring-up (device/cheetah/DISPLAY-PLAN.md): a DSI command path on
# the bootloader's DSIM0 and the S6E3HC4 panel, for brightness and display
# on/off. Modules, autoloaded from the DT (dsi0 enabled since gate D1b);
# gs-dsim-cmd only sends with allow_tx=1, which omamobile-device-cheetah sets
# (modprobe.d/omamobile-display.conf) since gate D2 passed.
CONFIG_DRM_GS_DSIM_CMD=m
CONFIG_DRM_PANEL_SAMSUNG_S6E3HC4=m
# Flip-only KMS on the bootloader's DECON0, 60 and 120 Hz (DISPLAY-PLAN.md,
# D5d/D6). Autoloaded from the DT (decon0 enabled); it replaces simpledrm once
# gs-dsim-cmd, the panel and clk_acpm have probed.
CONFIG_DRM_GS_DECON=m

# Fingerprint bring-up (device/cheetah/FINGERPRINT-RESEARCH.md): Google's
# Trusty driver (/dev/trusty-ipc-dev0), the Goodix sensor control device
# (/dev/goodix_fp) and SCSI generic, which reaches the UFS RPMB well-known
# LUN for Trusty's secure storage. Modules; the trusty, PERIC0 pinctrl and
# goodixfp DT nodes stay disabled until the bring-up gates.
CONFIG_TRUSTY=m
CONFIG_TRUSTY_IRQ=y
CONFIG_TRUSTY_LOG=m
CONFIG_TRUSTY_VIRTIO=m
CONFIG_TRUSTY_VIRTIO_IPC=m
CONFIG_GOODIX_FP=m
CONFIG_CHR_DEV_SG=m

# Netfilter with nftables: Arch's iptables (and so ufw, Omarchy's firewall),
# Docker and Waydroid's NAT all run on nf_tables. arm64 defconfig has only the
# legacy xtables core. Modules.
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_NAT=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NF_NAT=m
CONFIG_IP6_NF_IPTABLES=m
# ufw's rules through iptables-nft: REJECT, -m state and -m owner. The host
# never uses the legacy tables; they are on below for Android inside Waydroid.
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_NETFILTER_XT_MATCH_OWNER=m
# before6.rules drops type 0 routing headers.
CONFIG_IP6_NF_MATCH_RT=m
CONFIG_NETFILTER_XT_TARGET_LOG=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_RECENT=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_HL=m

# Haptics (CS40L26A) and rear torch (LM3644TT), device/cheetah/HAPTICS-TORCH-PLAN.md.
# Modules; their DT nodes (and I2C buses 8 and 15) stay disabled until the
# bring-up overlays enable them.
CONFIG_INPUT_CS40L26_VIBRA=m
CONFIG_LEDS_LM3644=m

# GSA mailbox (AoC bring-up, device/cheetah/AOC-PLAN.md stage C1). Debugfs
# status queries only; its DT node stays disabled until the aoc-gsa-test overlay.
CONFIG_GOOGLE_GSA=m
# AoC bring-up (AOC-PLAN.md stages C2-C4): GSA AoC commands over Trusty as a
# fallback, the AoC System MMU windows, the debugfs boot driver and the
# mic/sensor rails over ACPM. All DT nodes stay disabled until the overlays.
CONFIG_GOOGLE_GSA_TRUSTY=y
CONFIG_GS201_AOC_SYSMMU=m
CONFIG_GS201_AOC_BOOT=m
CONFIG_GS201_AOC_RAILS=m
CONFIG_GS201_AOC_MBOX=m
CONFIG_GS201_AOC=m
CONFIG_GS201_AOC_CHAR=m
# AoC sound card and the CS35L41 speaker amplifiers (AOC-PLAN.md stage C7).
# The DT nodes stay disabled until the audio-amps-test and aoc-sound-test
# overlays; the speaker volume limits are in the card driver.
CONFIG_GS201_AOC_ALSA=m
CONFIG_SND_SOC_CS35L41_SPI=m

# Suspend diagnostics (device/cheetah/SUSPEND-PLAN.md): /sys/power/pm_test,
# pm_print_times and pm_debug_messages. Nothing changes unless written.
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
# GNSS: Broadcom BCM4775x on SPI5 for the stock lhd/gpsd (device/cheetah/
# GNSS-PLAN.md). Its DT nodes and the S2MPG13 sub-PMIC stay disabled until
# the gnss overlays; the module is blacklisted from autoload.
CONFIG_BCM4775X_GNSS=m
# NFC: the ST54J's NCI controller on I2C 8 (RADIOS-CAMERA-PLAN.md section 3).
# DT node disabled until the nfc-test overlay.
CONFIG_NFC_ST_NCI_I2C=m
# Modem PCIe GEN4A_0 bring-up (device/cheetah/MODEM-PLAN.md, M2). Its DT node
# stays disabled until the modem-link-test overlay; the steps need allow_hw=1.
CONFIG_PCIE_GS201_CP=m
# The modem's NV partitions (efs, efs_backup, modem_userdata) are f2fs. The M3
# vendor-chroot profile mounts RAM copies of them, never the partitions.
CONFIG_F2FS_FS=m
# Google's modem interface driver, ported (MODEM-PLAN.md, M3.3): boot, IPC and
# RFS over the PCIe link, legacy buffers only. Its DT nodes exist only in the
# modem-cpif-test overlay; the modules are blacklisted (omamobile-cpif.conf).
CONFIG_EXYNOS_MODEM_IF=m
CONFIG_SEC_MODEM_S5100=y
CONFIG_SHM_IPC=m
# Packet data on the extended channels (181+) the overlay's rmnet devices use,
# advertised to the modem at boot (MODEM-PLAN.md 6.3). Needed for M4 data.
CONFIG_CH_EXTENSION=y
# The packet processor (4 downlink queues on MSI blocks 1-4, 2 uplink queues)
# and the uplink ACK queue, as stock. Built, but used only when the modem node
# asks for it (the modem-cpif-pktproc overlay); without it the modem keeps the
# legacy buffers, as before (MODEM-PLAN.md 6.3).
CONFIG_CP_PKTPROC=y
CONFIG_CP_PKTPROC_UL=y
CONFIG_MODEM_IF_QOS=y
# Camera (device/cheetah/CAMERA-PLAN.md). DMA-BUF heaps, /dev/dma_heap/system
# and the default CMA area, for libcamera's software ISP and PipeWire. Built
# in: a heap has no device to autoload a module from.
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
# The default CMA area (arm64 defconfig: 32 MiB) is exported as the dma-heaps
# "reserved" and "default_cma_region"; libcamera's software ISP takes its
# output buffers from "reserved" (12 MiB each at 2016x1508 RGB888, four or
# more per stream), and 32 MiB failed (CAM5.2). Reusable: movable pages use
# it while the camera doesn't. 384 MiB: libcamera's default for the main
# and telephoto is their 12 MP mode, four 37 MiB RGB888 buffers, which
# failed to allocate at 192 (CAMERA-PLAN.md CAM-M.5l).
CONFIG_CMA_SIZE_MBYTES=384
# V4L2 with the media controller and the subdev API (arm64 defconfig has
# them; listed so the camera stack keeps them) and the MIPI CCS sensor driver,
# to try on the ultrawide (CAMERA-PLAN.md 5.3). Modules.
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_VIDEO_DEV=m
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_VIDEO_CAMERA_SENSOR=y
CONFIG_VIDEO_CCS=m
# Camera power bring-up (CAMERA-PLAN.md CAM1-CAM3): the S2MPG13 GPIOs, the
# SLG51002 camera PMIC and the module power test driver (the read-only CSIS
# probe was dropped when the kernel was curated for publishing, 2026-10-30). Blacklisted from autoload (modprobe.d/omamobile-camera.conf); their
# DT nodes stay disabled until the camera-pwr-test overlay.
CONFIG_GS201_CAM_POWER=m
CONFIG_GPIO_S2MPG13=m
CONFIG_REGULATOR_SLG51002=m
# Camera capture (CAMERA-PLAN.md CAM3b-CAM4): the DC-PHY receiver, the CSIS
# link + WDMA driver (streams only with allow_stream=1) and the ultrawide
# sensor. Blacklisted; DT nodes disabled until a camera-stream-link0/1 overlay.
CONFIG_PHY_GS201_MIPI_DCPHY=m
CONFIG_VIDEO_GS201_CSIS=m
CONFIG_VIDEO_IMX386=m
# Main camera (CAMERA-PLAN.md CAM-M): the Samsung S5KGN1 sensor, and the
# AK7375-type focus actuators of the main and ultrawide modules (mainline
# ak7375). Blacklisted; DT nodes disabled until camera-main/camera-uw-lens.
CONFIG_VIDEO_S5KGN1=m
CONFIG_VIDEO_AK7375=m
# Front and telephoto cameras (CAMERA-PLAN.md CAM7, CAM-T): s5kgn1 drives
# their S5K3J1 and S5KGM5 too; the telephoto's SEM1215SA focus controller.
# Blacklisted; DT nodes disabled until camera-front/camera-tele.
CONFIG_VIDEO_SEM1215=m
# Waydroid (device/cheetah/WAYDROID-PLAN.md W1). Binder, binderfs, PSI,
# memfd, cgroups, namespaces, bridge, veth, tun, overlayfs and fuse are
# already on. The host side (waydroid-net.sh) uses nftables only. What is
# missing is Android's own networking inside the container: netd and its
# iptables binary use the legacy setsockopt interface (not nf_tables), and
# netd routes each network through its own table with fwmark rules. Without
# these netd fails, Android has an address but no route, and the boot loops.
# Built-in: the routing options (they change struct net) and the legacy
# xtables core. Everything else is a module that autoloads on use.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_ROUTE_INFO=y
CONFIG_IPV6_OPTIMISTIC_DAD=y
# netd closes a lost network's sockets (SOCK_DESTROY) and lists UDP sockets.
CONFIG_INET_UDP_DIAG=y
CONFIG_INET_DIAG_DESTROY=y
# Legacy iptables and ip6tables with the filter, mangle, raw and nat tables.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_RAW=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP_NF_TARGET_NETMAP=m
CONFIG_IP_NF_TARGET_REDIRECT=m
CONFIG_IP_NF_MATCH_AH=m
CONFIG_IP_NF_MATCH_ECN=m
CONFIG_IP_NF_MATCH_TTL=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_IP6_NF_RAW=m
CONFIG_IP6_NF_MATCH_IPV6HEADER=m
CONFIG_IP6_NF_MATCH_RPFILTER=m
# The matches and targets Android's netd and its firewall chains use
# (Android's kernel/configs "android-base" set, minus the out-of-tree quota2).
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NETFILTER_NETLINK_LOG=m
CONFIG_NETFILTER_NETLINK_QUEUE=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_MATCH_BPF=m
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=m
CONFIG_NETFILTER_XT_MATCH_ECN=m
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=m
CONFIG_NETFILTER_XT_MATCH_HELPER=m
CONFIG_NETFILTER_XT_MATCH_IPRANGE=m
CONFIG_NETFILTER_XT_MATCH_LENGTH=m
CONFIG_NETFILTER_XT_MATCH_MAC=m
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=m
CONFIG_NETFILTER_XT_MATCH_QUOTA=m
CONFIG_NETFILTER_XT_MATCH_SOCKET=m
CONFIG_NETFILTER_XT_MATCH_STATISTIC=m
CONFIG_NETFILTER_XT_MATCH_STRING=m
CONFIG_NETFILTER_XT_MATCH_TIME=m
CONFIG_NETFILTER_XT_MATCH_U32=m
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=m
CONFIG_NETFILTER_XT_TARGET_CLASSIFY=m
CONFIG_NETFILTER_XT_TARGET_CT=m
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_TARGET_NETMAP=m
CONFIG_NETFILTER_XT_TARGET_NFLOG=m
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=m
CONFIG_NETFILTER_XT_TARGET_REDIRECT=m
CONFIG_NETFILTER_XT_TARGET_TCPMSS=m
CONFIG_NETFILTER_XT_TARGET_TPROXY=m
# Traffic accounting through BPF classifiers (netd's bandwidth controller).
CONFIG_NET_CLS_BPF=m
CONFIG_NET_ACT_BPF=m
