#!/bin/sh
# SPDX-License-Identifier: MIT
# Install the dodge desktop unit (Hyprland on tty1) on the phone. Run as
# root, from this directory (copied to the phone), or with it as $1.
# Idempotent. Enables the unit; does not restart a running desktop.
set -eu
SRC=${1:-$(dirname "$0")}
log() { echo "dodge-desktop-install: $*"; }
[ "$(id -u)" = 0 ] || { log "run as root"; exit 1; }
install -D -m 644 "$SRC/omamobile-hyprland.service" /etc/systemd/system/omamobile-hyprland.service
systemctl daemon-reload
systemctl enable omamobile-hyprland.service
log "done; takes effect on the next start of the desktop"
