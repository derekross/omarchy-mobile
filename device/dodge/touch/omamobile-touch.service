# Synaptics TouchComm over GENI SPI. Oneshoot: modules stay loaded.
[Unit]
Description=S3910 touch (gpi, spi_geni_qcom, synaptics_tcm2)
DefaultDependencies=no
After=local-fs.target
Before=omamobile-hyprland.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/omamobile-touch-load

[Install]
WantedBy=multi-user.target
