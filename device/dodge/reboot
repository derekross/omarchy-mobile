#!/bin/sh
# SPDX-License-Identifier: MIT
# reboot bootloader on this phone is LINUX_REBOOT_CMD_RESTART2 with the
# string "bootloader". systemd's reboot bootloader is the EFI firmware
# path and does not pass that string, so ABL starts the normal boot.
# This file is ahead of /usr/bin/reboot on PATH.
if [ "${1-}" = bootloader ]; then
  exec /usr/local/bin/reboot-to bootloader
fi
exec /usr/bin/systemctl reboot "$@"
