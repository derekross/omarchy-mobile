#!/bin/sh
# SPDX-License-Identifier: MIT
# Load ath12k for peach (17cb:110e) once per boot, after
# omamobile-wifi-pcie has powered the radio and rescanned PCIe.
#
# Reloading ath12k on one boot oopses, so this never loads it twice:
# it exits if the module is present, and it leaves a stamp in /run
# before the first insmod. The stamp stays even if that insmod fails;
# the next try is the next boot.
set -u
D=/usr/local/lib/omamobile
STAMP=/run/omamobile-ath12k.tried

log() { echo "omamobile-wifi-ath12k: $*"; }

if [ -e /sys/module/ath12k ]; then
	log "ath12k already loaded, nothing to do"
	exit 0
fi
if [ -e "$STAMP" ]; then
	log "ath12k was already tried this boot ($STAMP), not again"
	exit 0
fi

# Wait for the endpoint the PCIe rescan brings up.
found=
i=0
while [ $i -lt 60 ]; do
	for dev in /sys/bus/pci/devices/*; do
		[ -r "$dev/vendor" ] || continue
		if [ "$(cat "$dev/vendor")" = 0x17cb ] &&
		   [ "$(cat "$dev/device")" = 0x110e ]; then
			found=$dev
		fi
	done
	[ -n "$found" ] && break
	sleep 0.5
	i=$((i + 1))
done
if [ -z "$found" ]; then
	log "no 17cb:110e on PCIe after 30 s, not loading ath12k"
	exit 1
fi
log "endpoint ${found##*/}"

# Load a module unless it is already in (by module name).
# Prefer modprobe so a tip Image + tmpfs modules overlay works; fall
# back to the held .ko under $D for the packaged gpu2 rootfs boot.
load() {
	name=$(echo "$1" | tr - _)
	shift
	[ -e "/sys/module/$name" ] && return 0
	if modprobe "$name" "$@" 2>/dev/null; then
		return 0
	fi
	insmod "$D/$(echo "$name" | tr _ -).ko" "$@" 2>/dev/null ||
		insmod "$D/$name.ko" "$@"
}

# Optional helpers: load if this kernel ships the .ko, or modprobe can
# find it in the running tree. When neither a held file nor modprobe
# works, the code is built in or folded into another module (7.3:
# sha256 and cmac are built in, michael_mic lives in mac80211), so skip
# quietly. 6.16 ships every file under $D, so nothing changes there.
opt() {
	n=$(echo "$1" | tr - _)
	if [ ! -e "$D/$(echo "$n" | tr _ -).ko" ] && [ ! -e "$D/$n.ko" ] &&
	   ! modprobe -n "$n" 2>/dev/null; then
		skipped="$skipped $1"
		return 0
	fi
	load "$@" || log "$1 failed"
}
skipped=

# sha256 lets cfg80211 verify the signed regulatory.db; without it
# the database is rejected and only the world domain is known.
opt libsha256-generic
opt sha256
# Nothing autoloads crypto modules here (no /lib/modules tree), so load
# what ath12k and mac80211 ask for by name: michael_mic for every
# peer's rx defrag context (without it station add fails with -ENOENT),
# and the CCMP/GCMP/BIP templates.
for m in ctr ccm ghash-generic gcm cmac michael_mic; do
	opt "$m"
done
[ -n "$skipped" ] && log "no .ko (built in on $(uname -r)):$skipped"
load rfkill || exit 1
load libarc4 || exit 1
load cfg80211 ieee80211_regdom=DK || exit 1
load mac80211 || exit 1
load mhi || exit 1
load qrtr || exit 1
load qrtr-mhi || exit 1

: > "$STAMP"
log "loading ath12k"
if ! load ath12k; then
	log "ath12k load failed"
	exit 1
fi
# 7.3 splits the PCI driver into ath12k_wifi7.ko; 6.16 has no such file.
if [ -f "$D/ath12k_wifi7.ko" ] || modprobe -n ath12k_wifi7 2>/dev/null; then
	load ath12k_wifi7 || { log "ath12k_wifi7 load failed"; exit 1; }
fi
log "ath12k loaded"
