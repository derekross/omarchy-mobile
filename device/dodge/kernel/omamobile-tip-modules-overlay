#!/bin/sh
# SPDX-License-Identifier: MIT
# Tip RAM boot: apply a matching modules tar as a tmpfs overlay under
# /lib/modules/$(uname -r), depmod, clear early-boot stamps, restart the
# tip-aware bring-up units, and bounce sddm once DSI is up. Intended as
# the ONLY hand step after `fastboot boot` of an unpackaged tip Image.
#
# Usage: omamobile-tip-modules-overlay /path/to/modules-overlay-….tar
#        omamobile-tip-modules-overlay   # if tar already extracted
set -eu
R=$(uname -r)
DEST=/lib/modules/$R
TAR=${1:-}

log() { echo "tip-modules-overlay: $*"; }

if [ -n "$TAR" ]; then
	[ -f "$TAR" ] || { log "no such file: $TAR"; exit 1; }
	mkdir -p "$DEST"
	if [ ! -r "$DEST/modules.dep" ]; then
		if ! mountpoint -q "$DEST" 2>/dev/null; then
			mount -t tmpfs -o size=512M tip-modules "$DEST"
			log "mounted tmpfs on $DEST"
		fi
	fi
	# Tar layout is lib/modules/$R/...; extract at / so paths land in DEST.
	if tar -tf "$TAR" | head -1 | grep -q "^lib/modules/$R/"; then
		tar -xf "$TAR" -C /
	else
		tar -xf "$TAR" -C "$DEST"
	fi
	depmod -a "$R" 2>/dev/null || depmod -a
	log "extracted $(basename "$TAR") into $DEST"
fi

[ -r "$DEST/modules.dep" ] || [ -r "/usr/lib/modules/$R/modules.dep" ] || {
	log "no modules.dep under $DEST; pass the modules-overlay tar as \$1"
	exit 1
}

# Mark kmod-overlay successful for After= dependents.
systemctl reset-failed omamobile-kmod-overlay.service 2>/dev/null || true
systemctl stop omamobile-kmod-overlay.service 2>/dev/null || true
systemctl start omamobile-kmod-overlay.service

# Stamps set by early units that ran before the overlay.
rm -f /run/omamobile-bt.tried \
	/run/omamobile-ath12k.tried \
	/run/omamobile-display-msm.tried \
	/run/omamobile-wifi-pcie.tried 2>/dev/null || true
rm -f /run/omamobile-skip/omamobile-display-msm.service \
	/run/omamobile-skip/omamobile-wifi-pcie.service \
	/run/omamobile-skip/omamobile-wifi-ath12k.service \
	/run/omamobile-skip/omamobile-touch.service \
	/run/omamobile-skip/omamobile-adsp-battery.service \
	/run/omamobile-skip/omamobile-bt.service \
	/run/omamobile-skip/omamobile-dodge-audio.service \
	/run/omamobile-skip/omamobile-sensors.service 2>/dev/null || true

systemctl daemon-reload 2>/dev/null || true
systemctl reset-failed \
	omamobile-display-msm.service \
	omamobile-wifi-pcie.service \
	omamobile-wifi-ath12k.service \
	omamobile-touch.service \
	omamobile-adsp-battery.service \
	omamobile-bt.service \
	omamobile-dodge-audio.service \
	omamobile-sensors.service 2>/dev/null || true

# Display first so DSI is up before the session bounce.
systemctl restart omamobile-display-msm.service 2>/dev/null || \
	systemctl start omamobile-display-msm.service 2>/dev/null || true
i=0
while [ $i -lt 40 ]; do
	for c in /sys/class/drm/card*-DSI-1; do
		[ -r "$c/status" ] || continue
		[ "$(cat "$c/status")" = connected ] && break 2
	done
	sleep 0.5
	i=$((i + 1))
done

systemctl restart omamobile-wifi-pcie.service 2>/dev/null || \
	systemctl start omamobile-wifi-pcie.service 2>/dev/null || true
systemctl restart omamobile-wifi-ath12k.service 2>/dev/null || \
	systemctl start omamobile-wifi-ath12k.service 2>/dev/null || true
systemctl restart omamobile-touch.service 2>/dev/null || \
	systemctl start omamobile-touch.service 2>/dev/null || true
systemctl restart omamobile-adsp-battery.service 2>/dev/null || \
	systemctl start omamobile-adsp-battery.service 2>/dev/null || true

# BT needs a WLAN iface; give ath12k a moment.
i=0
while [ $i -lt 30 ]; do
	[ -e /sys/class/net/wlan0/address ] || [ -e /sys/class/net/wlp1s0/address ] && break
	sleep 0.5
	i=$((i + 1))
done
systemctl restart omamobile-bt.service 2>/dev/null || \
	systemctl start omamobile-bt.service 2>/dev/null || true

systemctl restart omamobile-dodge-audio.service 2>/dev/null || \
	systemctl start omamobile-dodge-audio.service 2>/dev/null || true

if [ -e /etc/omamobile/sensors.enable ]; then
	systemctl restart omamobile-sensors.service 2>/dev/null || \
		systemctl start omamobile-sensors.service 2>/dev/null || true
fi

# Session: tip boots start sddm on simpledrm; msm handoff kills
# sddm-helper (exit 255). B avoids this because display-msm finishes
# before sddm (After=). After tip overlay, bounce sddm once DSI is up.
dsi=
for c in /sys/class/drm/card*-DSI-1; do
	[ -r "$c/status" ] || continue
	[ "$(cat "$c/status")" = connected ] && dsi=$(basename "$c")
done
if [ -n "$dsi" ] && systemctl is-enabled -q sddm.service 2>/dev/null; then
	log "bouncing sddm after $dsi bound"
	systemctl restart sddm.service 2>/dev/null || true
fi
log "done"
