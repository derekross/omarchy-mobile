# SPDX-License-Identifier: MIT
# sargo's kernel fragment, merged after kernel/configs/omamobile.config:
# what this phone needs that arm64 defconfig leaves out. Booted on
# 2026-11-24 (NOTES.md). A release kernel builds without device fragments,
# so these belong in the shared config before sargo can run one.
#
# arm64 defconfig already builds in what the shell needs from the SoC: the
# SDM670 pin controller, GCC, RPMh clocks and interconnect all default to
# ARCH_QCOM, and dwc3 is built in. The USB 2 PHY is a module there, and
# dipper's first light showed what that costs: dwc3 probes before anything
# loads the module, finds no PHY and gives up, so the initramfs never gets
# USB (device/dipper/kernel.config).
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_USB_DWC3_QCOM=y

# The SDM670 interconnect provider. Newer upstream defaults it to ARCH_QCOM,
# but the linux-omamobile release this was first built on (7.3-rc6) leaves
# it out, and the USB controller's interconnect paths (usb-ddr, apps-usb)
# would wait for a provider that never probes.
CONFIG_INTERCONNECT_QCOM_SDM670=y

# The power and Volume Down keys come from the PMIC's PON block.
CONFIG_POWER_RESET_QCOM_PON=y

# eMMC (sdhc_1) is built in: the Pixel 3a's storage. initramfs/init guards
# it as it guards UFS: the descriptor's UFS_RW_LUNS names mmcblk0, so its
# whole-disk node goes, only the running slot's boot and userdata stay
# writable, the boot areas mmcblk0boot0/1 are read-only and the RPMB node
# is removed (tests/storage-guard). The first-light kernel of 2026-11-24
# left this driver out until that guard existed.
CONFIG_MMC_SDHCI_MSM=y

# The display panel (samsung,s6e3fa7-ams559nk06 in the board DTS). Without
# it msm's display (DPU, DSI) and GPU probe but the DRM device never
# assembles, and Hyprland has only the simple framebuffer and no renderer.
CONFIG_DRM_PANEL_SAMSUNG_S6E3FA7=m

# The touchscreen: a Synaptics RMI4 controller on I2C (syna,rmi4-i2c at
# 0x20, its F12 function in the board DTS). arm64 defconfig leaves RMI4 out.
CONFIG_RMI4_CORE=m
CONFIG_RMI4_I2C=m
CONFIG_RMI4_F12=y

# Battery and charging (NOTES.md, 2026-11-25). The PM660's charger
# (qcom_smbx) and its round-robin ADC are upstream and enabled in the board
# DTS, but arm64 defconfig builds neither. The fuel gauge, which gives the
# battery its charge, voltage and current, is "power: supply: Add driver for
# Qualcomm PMI8998 fuel gauge" (Joel Selvaraj; RFC series "Qualcomm 3rd gen
# fuel gauge support", 2025-11-24), on the kernel branch omamobile-sargo-fg.
CONFIG_CHARGER_QCOM_SMB2=m
CONFIG_QCOM_SPMI_RRADC=m
CONFIG_BATTERY_PMI8998_FG=m

# The modem (NOTES.md, Wi-Fi entry): it expects the platform to describe
# the SoC in SMEM item 134 before it boots ("soc: qcom: Add modemsmem
# driver", from the sdm670-mainline tree, on the kernel branch
# omamobile-sargo-wifi).
CONFIG_QCOM_MODEMSMEM=m
