# SPDX-License-Identifier: MIT
# NOTES ONLY: documentary options, not consumed by tools/build-flame-probe.
# This is not device/flame/kernel.config and is not merged by omamobile kernel.
# The probe uses the prebuilt kernel inputs listed in BRINGUP-M1.md.
# UFW's IPv4/IPv6 rules need these in addition to the SM8150 package config.
# Exact-source external modules passed a live guarded restart on 7.0.0-sm8150.
# Rebuild against each kernel; never reuse these binaries with another build.
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_HL=m
CONFIG_IP6_NF_MATCH_RT=m
