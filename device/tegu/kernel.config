# SPDX-License-Identifier: MIT
# The fragment the second 9a's boots of 2026-10-28 ran (NOTES). Bring-up
# only: the release kernel is one build from kernel/configs/omamobile.config.
# The built-in ACPM, mailbox, S2MPG14 and eUSB2 PHY lines go once #227 puts
# them in the shared fragment; TG4C is already there; touch as a module is
# a test choice (the shared fragment builds it in).
# The USB gadget must come up in the initramfs before rootfs modules exist.
CONFIG_PHY_SNPS_EUSB2=y
# The public tegu board supplies that PHY through S2MPG14 over ACPM.
# Keep the whole supply chain available before mounting userdata.
CONFIG_EXYNOS_MBOX=y
CONFIG_EXYNOS_ACPM_PROTOCOL=y
CONFIG_MFD_SEC_ACPM=y
CONFIG_REGULATOR_S2MPS11=y
# Native DRM takes over the TG4C panel; no initramfs trigger write is needed.
CONFIG_DRM_PANEL_GOOGLE_TG4C=m
# Touch as a module, as tested on the second 9a (NOTES 2026-10-28).
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_SPI=m
