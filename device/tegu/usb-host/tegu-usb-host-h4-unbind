#!/bin/bash
# SPDX-License-Identifier: MIT
# tegu-usb-host-h4-unbind: USB-HOST-PLAN step H4, the published form of the
# script that runs while the laptop is out. Start it detached before the
# swap (systemd-run --unit=tegu-usb-host-h4 /usr/local/sbin/tegu-usb-host-h4-unbind).
# It waits for the laptop link to go and for a USB drive to enumerate in host
# mode, then 20 s later unbinds the MAX77779 charger (the chgin-otg provider)
# and logs what that leaves: kmsg, VBUS as the TCPC measures it (0x70/0x71)
# and CHG_CNFG_00 (0xbc) at 1, 5 and 20 s. Reads are i2cget only; the one
# write is the unbind. The swap timer the runbook arms (x-deadman) is the
# way back if the laptop link doesn't return.
set -u
L=/var/log/omamobile/usb-host-h4.log; mkdir -p /var/log/omamobile
log() { echo "$(date -Is) $*" >> "$L"; }
bus_of() { local d; for d in /sys/bus/i2c/devices/i2c-*; do readlink -f "$d" | grep -c "$1" >/dev/null && { echo "${d##*-}"; return; }; done; }
CB=$(bus_of 108d0000.i2c)   # hsi2c6: the TCPC at 0x25, the charger at 0x69
RB=$(bus_of 10ca0000.i2c)   # hsi2c10: the RT9470 at 0x5b
[[ -n $CB && -n $RB ]] || { log "no hsi2c6 or hsi2c10 bus: nothing done"; exit 1; }
dev=$CB-0069
vbus_mv() { # TCPCI VBUS_VOLTAGE: bits 9:0 in 25 mV steps, bits 11:10 the scale
  local lo hi
  lo=$(i2cget -f -y "$CB" 0x25 0x70 2>/dev/null) && hi=$(i2cget -f -y "$CB" 0x25 0x71 2>/dev/null) || { echo "?"; return; }
  echo "$(( (((hi & 0x03) << 8 | lo) * 25) << ((hi >> 2) & 0x03) )) (0x71/0x70 $hi/$lo)"
}
snap() {
  log "$1 vbus_mV=$(vbus_mv) chg_cnfg_00=$(i2cget -f -y "$CB" 0x69 0xbc 2>/dev/null || echo ?) rt function=$(i2cget -f -y "$RB" 0x5b 0x02 2>/dev/null || echo ?) icstat=$(i2cget -f -y "$RB" 0x5b 0x0f 2>/dev/null || echo ?)"
  log "$1 typec: pr=$(cat /sys/class/typec/port0/power_role 2>/dev/null) dr=$(cat /sys/class/typec/port0/data_role 2>/dev/null) role=$(cat /sys/class/usb_role/*/role 2>/dev/null) udc=$(cat /sys/class/udc/*/state 2>/dev/null) regulators: $(for r in /sys/class/regulator/regulator.*; do n=$(cat "$r/name"); case $n in otg-boost|chgin-otg) printf '%s=%s ' "$n" "$(cat "$r/state")";; esac; done)charger=$(basename "$(readlink -f "/sys/bus/i2c/devices/$dev/driver")" 2>/dev/null)"
  log "$1 usb: $(cat /sys/bus/usb/devices/*/product 2>/dev/null | tr '\n' '|') disks: $(lsblk -dno NAME,SIZE,TRAN 2>/dev/null | grep usb | tr '\n' '|')"
}
log "start"; snap pre
[[ -e /sys/bus/i2c/devices/$dev/driver ]] || { log "no driver bound at $dev: nothing to unbind"; exit 1; }
# the laptop goes out
for _ in $(seq 1 600); do [[ $(cat /sys/class/udc/*/state 2>/dev/null) != configured ]] && break; sleep 1; done
[[ $(cat /sys/class/udc/*/state 2>/dev/null) != configured ]] || { log "laptop never left in 10 min: nothing done"; exit 0; }
log "laptop link gone"
# the drive enumerates in host mode
drive=
for _ in $(seq 1 180); do
  drive=$(lsblk -dno NAME,TRAN 2>/dev/null | awk '$2 == "usb" { print $1; exit }')
  [[ -n $drive ]] && break
  sleep 1
done
[[ -n $drive ]] || { snap no-drive; log "no USB drive in 3 min: nothing unbound"; exit 1; }
log "drive $drive enumerated"; snap attached
sleep 20; snap t+20
if echo "$dev" > "/sys/bus/i2c/devices/$dev/driver/unbind"; then
  log "unbound the charger at $dev"
else
  log "unbind of $dev failed"; exit 1
fi
sleep 1; snap unbound+1s
sleep 4; snap unbound+5s
sleep 15; snap unbound+20s
dmesg | grep -iE "max77779|regulator|otg|tcpm|tcpci|vbus|usb [0-9]|sd[a-z]|oops|bug|call trace" | tail -40 >> "$L"
cat /sys/kernel/debug/usb/tcpm-*/log 2>/dev/null | tail -40 >> "$L"
# the laptop goes back in; the swap timer reboots if it doesn't
for _ in $(seq 1 600); do [[ $(cat /sys/class/udc/*/state 2>/dev/null) == configured ]] && break; sleep 1; done
snap laptop-back
dmesg | grep -iE "max77779|regulator|otg|tcpm|vbus|oops|bug|call trace" | tail -20 >> "$L"
log "done"
