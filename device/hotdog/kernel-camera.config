# SPDX-License-Identifier: MIT
# hotdog camera bring-up options (CAMERA-PLAN.md section 5), on top of
# kernel.config, for the omamobile-hotdog-camera branch only:
#   scripts/kconfig/merge_config.sh -m -O $KERNEL_OUT $KERNEL_OUT/.config \
#     device/hotdog/kernel-camera.config
# Nothing here binds before the plan's overlays enable the nodes, except the
# camera clock controller, which only registers clocks and the TITAN_TOP GDSC.
CONFIG_SM_CAMCC_8150=m
CONFIG_I2C_QCOM_CCI=m
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_VIDEO_IMX471=m
CONFIG_VIDEO_S5K3M5=m
CONFIG_VIDEO_SONY_FWTABLE=m
CONFIG_V4L2_FLASH_LED_CLASS=m
# Focus actuators (lens nodes stay disabled until an overlay enables them):
# AK7374 (ultrawide; main and tele of an O-film module), LC898217XC (main
# and tele of a SEMCO module)
CONFIG_VIDEO_AK7375=m
CONFIG_VIDEO_LC898217XC=m

# CAMERA-PLAN C9: with DMABUF_DEBUG (default y under DEBUG_KERNEL) the
# dma-buf core scrambles the page links of an imported buffer's sg table,
# and msm still maps an import's pages from it, so the GPU drew into
# nothing: libcamera's GPU debayer gave all-zero frames and every close
# warned in __arm_lpae_unmap. Off until msm maps imports through the
# exporter's DMA addresses (upstream "drm/msm: DMABUF_DEBUG fixes").
# CONFIG_DMABUF_DEBUG is not set
