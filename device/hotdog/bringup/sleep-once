#!/bin/bash
# SPDX-License-Identifier: MIT
# sleep-once: one suspend-to-idle cycle on the OnePlus 7T Pro, measured
# (device/hotdog/SUSPEND-PLAN.md). Runs ON the phone as root, detached,
# because the USB link drops while the phone sleeps:
#
#   tools/phone-ssh 'cat > /root/sleep-once && chmod +x /root/sleep-once' \
#       < device/hotdog/bringup/sleep-once
#   tools/phone-ssh 'systemd-run -q --collect --unit=x-sleep-once \
#       -E MODE=freeze -E SECS=30 /root/sleep-once'
#
# MODE:
#   devices  pm_test "devices": every driver suspends and resumes, the CPUs
#            never idle, back after about 5 s (no RTC needed)
#   freeze   rtcwake -m freeze: a real s2idle straight through
#            /sys/power/state, woken by the RTC after SECS (systemd's sleep
#            hooks and inhibitors don't run)
#   systemd  the RTC armed for SECS, then "systemctl suspend": the path the
#            shell's omamobile-sleepd takes (hooks, ModemManager and
#            NetworkManager's delay inhibitors)
#   manual   as systemd, but the RTC is not armed: a key (or a call, an SMS)
#            has to wake it; the script gives up waiting after SECS
#
# CRASH=<remoteproc name> (systemd/manual): report a crash of that remote
# processor (debugfs, a watchdog: its restart runs as after a real one) just
# before "systemctl suspend", to test that the sleep hook waits it out.
# IGNORE_BLOCK=1: "systemctl suspend --check-inhibitors=no", past a block
# inhibitor held to keep omamobile-sleepd off the phone during a test
# (delay inhibitors, ModemManager's and NetworkManager's, still apply).
#
# Output: /var/log/omamobile/sleep-test/<time>-<mode>.log, with the suspend
# statistics, the RPMh sleep counters (aosd = the SoC's always-on domain
# asleep, cxsd = CX collapsed: the deep, low-power state), the CPU cluster's
# idle state, the wake IRQ, the interrupts that fired, the battery, the
# kernel log of the cycle and health checks (UFS, root, modem, Wi-Fi, USB).
# A marker in /var/lib/omamobile/sleep-test/ stays behind if the cycle never
# came back (a hang that needed the buttons): the next run reports it.
set -uo pipefail

MODE=${MODE:-freeze}
SECS=${SECS:-30}
out_dir=/var/log/omamobile/sleep-test
state_dir=/var/lib/omamobile/sleep-test
marker=$state_dir/in-progress
stats=/sys/kernel/debug/qcom_stats
cluster=/sys/kernel/debug/pm_genpd/power-domain-cpu-cluster0/idle_states
bat=/sys/class/power_supply/bq27411-0

case $MODE in devices|freeze|systemd|manual) ;; *) echo "sleep-once: unknown MODE $MODE" >&2; exit 2 ;; esac
[[ $SECS =~ ^[0-9]+$ ]] && ((SECS >= 10)) || { echo "sleep-once: SECS must be 10 or more" >&2; exit 2; }
[[ $(id -u) == 0 ]] || { echo "sleep-once: run as root" >&2; exit 2; }

mkdir -p "$out_dir" "$state_dir"
ts=$(date +%Y%m%d-%H%M%S)
log=$out_dir/$ts-$MODE.log
exec > >(tee -a "$log") 2>&1

say() { printf '%s %s\n' "$(date +%T.%3N)" "$*"; }
sec() { printf '\n== %s\n' "$*"; }

if [[ -e $marker ]]; then
  say "WARNING: the previous cycle never finished: $(cat "$marker")"
  rm -f "$marker"
fi

[[ -w /sys/class/rtc/rtc0/wakealarm ]] || { say "no RTC wakealarm: stopping"; exit 1; }
mountpoint -q /sys/kernel/debug || mount -t debugfs none /sys/kernel/debug

snap() {
  local tag=$1 f
  sec "$tag: suspend_stats"
  for f in success fail failed_freeze failed_prepare failed_suspend failed_suspend_late \
           failed_suspend_noirq failed_resume failed_resume_early failed_resume_noirq \
           last_failed_dev last_failed_errno last_failed_step; do
    printf '%s=%s ' "$f" "$(cat /sys/power/suspend_stats/$f 2>/dev/null)"
  done
  echo
  sec "$tag: RPMh sleep stats (count, accumulated)"
  for f in aosd cxsd ddr modem adsp cdsp slpi; do
    [[ -r $stats/$f ]] || continue
    printf '%-6s %s\n' "$f" "$(awk -F': ' '/^Count/ {c=$2} /^Accumulated/ {a=$2} END {print c, a}' "$stats/$f")"
  done
  sec "$tag: CPU cluster idle states"
  cat "$cluster" 2>/dev/null
  sec "$tag: battery"
  for f in status capacity voltage_now current_now charge_now temp; do
    printf '%s=%s ' "$f" "$(cat "$bat/$f" 2>/dev/null)"
  done
  echo
}

health() {
  sec "health"
  echo "root: $(awk '$2 == "/" {print $4}' /proc/mounts | cut -d, -f1)"
  echo "UFS errors in the cycle: $(grep -E 'ufshcd|ufs-qcom|ufs_qcom|I/O error' "$1" | grep -ciE 'err|fail|timeout|abort|reset' || true)"
  for r in /sys/class/remoteproc/remoteproc*; do
    echo "$(cat "$r/name" 2>/dev/null): $(cat "$r/state" 2>/dev/null)"
  done
  echo "wlan0: $(cat /sys/class/net/wlan0/operstate 2>/dev/null)"
  echo "usb0: $(cat /sys/class/net/usb0/operstate 2>/dev/null)"
  echo "MM modems: $(mmcli -L 2>/dev/null | grep -c Modem || true)"
  echo "sleep hook:"; journalctl -t systemd-sleep --since "@${t0%.*}" --no-pager -o cat 2>/dev/null | grep omamobile-hotdog-sleep
}

say "sleep-once $MODE ${SECS}s on $(uname -r)"
snap before
cp /proc/interrupts "$state_dir/irq-before"
old_times=$(cat /sys/power/pm_print_times)
old_debug=$(cat /sys/power/pm_debug_messages)
echo 1 > /sys/power/pm_print_times
echo 1 > /sys/power/pm_debug_messages
ok_before=$(cat /sys/power/suspend_stats/success)
fail_before=$(cat /sys/power/suspend_stats/fail)
mark="sleep-once-$ts"
echo "$mark start $MODE" > /dev/kmsg
echo "$ts $MODE ${SECS}s $(uname -r)" > "$marker"
sync

t0=$(date +%s.%N)
case $MODE in
  devices)
    echo devices > /sys/power/pm_test
    echo freeze > /sys/power/state; rc=$?
    echo none > /sys/power/pm_test
    ;;
  freeze)
    rtcwake -m freeze -s "$SECS"; rc=$?
    ;;
  systemd|manual)
    echo 0 > /sys/class/rtc/rtc0/wakealarm
    [[ $MODE == systemd ]] && echo "+$SECS" > /sys/class/rtc/rtc0/wakealarm
    if [[ -n ${CRASH:-} ]]; then
      for r in /sys/class/remoteproc/remoteproc*; do
        [[ $(cat "$r/name") == "$CRASH" ]] || continue
        say "reporting a crash of $CRASH (${r##*/})"
        echo 1 > "/sys/kernel/debug/remoteproc/${r##*/}/crash"
      done
    fi
    if [[ ${IGNORE_BLOCK:-0} == 1 ]]; then systemctl suspend --check-inhibitors=no; else systemctl suspend; fi; rc=$?
    # systemctl returns once logind has queued the sleep: wait for the resume.
    for _ in $(seq $((SECS + 120))); do
      [[ $(cat /sys/power/suspend_stats/success) != "$ok_before" ]] && break
      [[ $(cat /sys/power/suspend_stats/fail) != "$fail_before" ]] && break
      sleep 1
    done
    echo 0 > /sys/class/rtc/rtc0/wakealarm
    ;;
esac
t1=$(date +%s.%N)
echo "$mark end rc=$rc" > /dev/kmsg
rm -f "$marker"
echo "$old_times" > /sys/power/pm_print_times
echo "$old_debug" > /sys/power/pm_debug_messages

say "back after $(awk -v a="$t0" -v b="$t1" 'BEGIN {printf "%.1f", b - a}') s, rc=$rc"
irq=$(cat /sys/power/pm_wakeup_irq 2>/dev/null) || irq=
if [[ -n $irq ]]; then
  say "woken by IRQ $irq: $(awk -v i="$irq:" '$1 == i {$1 = ""; print; exit}' /proc/interrupts | tr -s ' ')"
else
  say "no wake IRQ recorded"
fi
snap after

sec "interrupts that fired during the cycle"
cp /proc/interrupts "$state_dir/irq-after"
awk 'NR == FNR { if (FNR > 1) { n = 0; for (i = 2; i <= NF && $i ~ /^[0-9]+$/; i++) n += $i; b[$1] = n }; next }
     FNR > 1 { n = 0; for (i = 2; i <= NF && $i ~ /^[0-9]+$/; i++) n += $i
               if (n - b[$1] > 0) { d = n - b[$1]; $1 = $1; line = ""
                 for (j = i; j <= NF; j++) line = line " " $j
                 printf "%8d  %s%s\n", d, $1, line } }' \
  "$state_dir/irq-before" "$state_dir/irq-after" | sort -rn | head -30

sec "kernel log of the cycle"
dmesg | sed -n "/$mark start/,/$mark end/p" > "$state_dir/kmsg-$ts"
# The devices that failed or took 10 ms or more, the errors and the PM steps.
grep -vE 'PM: calling |returned 0 after [0-9]{1,4} usecs' "$state_dir/kmsg-$ts" |
  sed -E 's/([0-9a-f]{2}:){5}[0-9a-f]{2}/<MAC>/g' | head -150
health "$state_dir/kmsg-$ts"
cp "$state_dir/kmsg-$ts" "$out_dir/$ts-$MODE.kmsg"
say "log: $log"
