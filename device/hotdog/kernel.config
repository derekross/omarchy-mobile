# SPDX-License-Identifier: MIT
# hotdog's kernel options (OnePlus 7T Pro, SM8150), merged by bin/omamobile
# kernel on top of kernel/configs/omamobile.config. The SoC set follows the
# postmarketOS SM8150 tree's sm8150.config, which this phone ran on.
#
# The shared initramfs loads no modules, so everything between the
# bootloader and an SSH login is built in: clocks, pin control, RPMh and its
# regulators, interconnects, UFS and its PHY, the USB controller, its PHYs
# and the gadget functions.

# --- SoC core ---
CONFIG_ARCH_QCOM=y
CONFIG_PINCTRL_SM8150=y
CONFIG_SM_GCC_8150=y
CONFIG_SM_GPUCC_8150=y
CONFIG_SM_VIDEOCC_8150=y
CONFIG_SM_DISPCC_8250=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM8150=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_QCOM_REFGEN=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SOCINFO=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_QCOM_GENI_SE=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_ADC_TM5=y
CONFIG_QCOM_LMH=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_QCOM_TSENS=y
CONFIG_FORCE_NR_CPUS=y
CONFIG_NR_CPUS=8
CONFIG_SCHED_CLUSTER=y
# Sets the RF test cable state in SMEM before anything can start the modem
CONFIG_QCOM_ONEPLUS_PROJECT_INFO=y

# --- Storage: UFS (the storage guard runs before anything mounts) ---
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_SCSI_UFS_BSG=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_QCOM_INLINE_CRYPTO_ENGINE=y

# --- USB: the gadget is the only link at first light ---
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_QCOM_PMIC=y
CONFIG_REGULATOR_QCOM_USB_VBUS=y

# --- Display and GPU (Adreno 640, DSI command-mode DSC panel) ---
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_PANEL_SAMSUNG_ONEPLUS_DSC=y
CONFIG_FB_SIMPLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# --- Input ---
CONFIG_TOUCHSCREEN_S6SY761=m
CONFIG_KEYBOARD_GPIO=y

# --- Remote processors, QMI and their glue ---
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_Q6V5_ADSP=m
CONFIG_QCOM_SYSMON=m
CONFIG_QCOM_PD_MAPPER=m
CONFIG_QRTR=m
CONFIG_QRTR_SMD=m
CONFIG_QRTR_TUN=m
CONFIG_RPMSG_CHAR=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=m
CONFIG_REMOTEPROC_CDEV=y
CONFIG_QCOM_APR=m
CONFIG_QCOM_FASTRPC=m
CONFIG_SLIMBUS=m
CONFIG_SLIM_QCOM_NGD_CTRL=m
CONFIG_QCOM_IPA=m

# --- Wi-Fi and Bluetooth (WCN3998) ---
CONFIG_ATH10K=m
CONFIG_ATH10K_SNOC=m
CONFIG_ATH10K_PCI=n
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=m

# --- Battery and charging ---
CONFIG_BATTERY_BQ27XXX=m
CONFIG_BATTERY_BQ27XXX_I2C=m
CONFIG_CHARGER_QCOM_SMB2=m
CONFIG_BATTERY_QCOM_FG=m

# --- Sound (q6 ADSP, TFA9874 speaker amplifiers) ---
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_SOC_SM8150=m
CONFIG_SND_SOC_TFA9872=m

# --- LEDs: notification LED, flash ---
CONFIG_LEDS_CLASS_MULTICOLOR=m
CONFIG_LEDS_QCOM_LPG=m
CONFIG_LEDS_QCOM_FLASH=m
CONFIG_LEDS_CLASS_FLASH=y

# --- Persistent RAM log (ramoops in the DT) ---
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# --- Fingerprint (FINGERPRINT-PLAN.md): goodix-fp (omamobile.config) for
# the sensor's lines and bus clocks, and downstream's /dev/qseecom for the
# vendor HAL. The device package's modprobe options set its allow-lists. ---
CONFIG_QCOM_QSEECOM_COMPAT=m

# --- Haptics: the Awinic AW8697 on QUP0 SE7 I2C (HAPTICS-PLAN.md), on the
# omamobile-hotdog-haptics kernel branch; feedbackd finds it by its input
# name, aw8695-haptics. ---
CONFIG_INPUT_AW8695_HAPTICS=m

# --- Firmware: the stores are zstd-compressed in places ---
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y

# --- Hangs end in a panic, so panic=10 resets and pstore keeps the log ---
# The bring-up image adds hung_task_panic=1 and softlockup_panic=1 to the
# command line (CMDLINE_APPEND); a stall in a driver's probe then leaves
# its console in ramoops instead of a frozen screen.
CONFIG_DETECT_HUNG_TASK=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
