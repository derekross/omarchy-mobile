# SPDX-License-Identifier: MIT
# dipper's kernel fragment, merged after kernel/configs/omamobile.config.
#
# Everything the phone needs to reach a shell is built in, not a module. The
# first boot proved why: arm64 defconfig makes the Qualcomm PHY drivers and the
# UFS glue modules, while dwc3 and ufshcd are built in. So they probed, found no
# PHY, and gave up -- the kernel logged
#   platform a600000.usb: deferred probe pending: dwc3: failed to initialize core
#   gcc-sdm845 100000.clock-controller: sync_state() pending due to 88e8000.phy
# and the initramfs never got USB or storage. Modules in the initramfs do not
# help when nothing loads them before the devices probe.

# USB and UFS PHYs. Without these, both the USB gadget and storage are dead.
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_QUSB2=y

# Storage: the core is already built in, the Qualcomm glue was not.
CONFIG_SCSI_UFS_QCOM=y

# The Type-C port manager on the PMIC, for the role switch and VBUS detection.
CONFIG_TYPEC_QCOM_PMIC=y

# Populate the PMIC power/resin key children before the initramfs checks keys.
CONFIG_POWER_RESET_QCOM_PON=y

# The FTS5 driver is upstream after PR #219, but PR #220 has no Dipper touch
# node yet. Keep it built in for a later node/overlay test.
CONFIG_TOUCHSCREEN_STMFTS=y

# Console log into the stock ramoops region: the only way to read an early hang
# on a phone with no serial header.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y

# --- the same lesson, applied to everything first light touches ---------------
# Devices probe once, early. A driver that only turns up later as a module never
# gets a second chance: the device is left unbound and not even on the deferred
# list. The first boot proved it for the PHYs; the second proved it again for
# i2c (geni_i2c loaded by hand bound to nothing, and `bind` by hand failed).
# So everything needed to reach a usable system is built in.

# i2c: built in for the follow-up FTS5 node; PR #220 does not enable it yet.
CONFIG_I2C_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
# Nothing of ours is on SPI, so it stays a module: every built-in byte counts
# against the ABL kernel limit below.
CONFIG_SPI_QCOM_GENI=m

# Display comes from the bootloader's framebuffer through simpledrm, not from
# the MSM display driver, so DRM_MSM stays a module. Built in it pushed the
# kernel past about 16 MiB, which this ABL refuses outright:
#   Booting FAILED (remote: 'Failed to load/authenticate boot image: 00000050')
# Nothing loads it; the panel path is open work (see NOTES.md).
CONFIG_DRM_MSM=m
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y

# The remoteprocs Wi-Fi depends on (the modem hosts the WLAN firmware) stay
# modules. Built in they pushed the kernel past what this ABL will load: a
# kernel+dtb of 16,247,767 bytes boots and 16,376,528 does not, with only
#   Booting FAILED (remote: 'Failed to load/authenticate boot image: 00000050')
# to go on. In the root filesystem udev loads them; the bring-up initramfs does
# not need the modem.
CONFIG_QCOM_RPROC_COMMON=m
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_Q6V5_MSS=m
CONFIG_QCOM_SYSMON=m
CONFIG_RPMSG_QCOM_GLINK_SMEM=m

# Left as modules with DRM_MSM: pinning them only mattered to allow DRM_MSM=y,
# which the ABL size limit ruled out.
CONFIG_QCOM_OCMEM=m
CONFIG_QCOM_LLCC=m

# This phone's ABL refuses a boot image whose kernel is too large, saying only
#   Booting FAILED (remote: 'Failed to load/authenticate boot image: 00000050')
# Measured: kernel+dtb of 16,247,767 bytes boots, 16,343,459 does not. The
# boundary sits at 0xF80000 = 16,252,928, which tools/dipper/build-boot.py now
# refuses to cross so the failure is ours and explained, not the bootloader's
# and silent.

# The DSI core can be a module: the panel driver that needs it is one too, and
# the display comes from simpledrm over the bootloader's framebuffer.
CONFIG_DRM_MIPI_DSI=m
