# SPDX-License-Identifier: MIT
[Unit]
Description=Attended exact-build Bluejay revised root gate
ConditionPathExists=/etc/omamobile/bluejay-revised-enable
ConditionKernelCommandLine=bluejay.gpu_evening=1
Requires=sshd.service
After=sshd.service systemd-journald.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/omamobile/bluejay-revised/start.py root
RemainAfterExit=yes
Restart=no
TimeoutStartSec=180s
TimeoutStopSec=5s
UMask=0077

[Install]
WantedBy=multi-user.target
