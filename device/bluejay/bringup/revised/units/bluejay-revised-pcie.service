# SPDX-License-Identifier: MIT
[Unit]
Description=Attended exact-build Bluejay revised pcie gate
ConditionPathExists=/etc/omamobile/bluejay-revised-enable
ConditionKernelCommandLine=bluejay.gpu_evening=1
Requires=bluejay-revised-touch.service
After=bluejay-revised-touch.service systemd-journald.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/omamobile/bluejay-revised/start.py pcie
RemainAfterExit=yes
Restart=no
TimeoutStartSec=75s
TimeoutStopSec=5s
UMask=0077
