# Independent revised opt-in session environment. No historical ready markers.
if [ "$(uname -r)" = 7.3.0-rc6-omamobile-bluejay-review-20261111 ] &&
   [ -f /etc/omamobile/bluejay-revised-enable ]; then
export AQ_DRM_DEVICES=/dev/dri/card0
export LIBGL_ALWAYS_SOFTWARE=1
export GALLIUM_DRIVER=llvmpipe
export QT_QUICK_BACKEND=software
if [ -c /dev/dri/renderD128 ] &&
   systemctl is-active --quiet bluejay-revised-gpu.service; then
  export LIBGL_ALWAYS_SOFTWARE=0
  export GALLIUM_DRIVER=panfrost
  export QT_QUICK_BACKEND=rhi
fi
export AQ_SIMPLEDRM_NO_AUX_RENDERER=1
export LD_LIBRARY_PATH=/usr/local/lib/bluejay${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
fi
