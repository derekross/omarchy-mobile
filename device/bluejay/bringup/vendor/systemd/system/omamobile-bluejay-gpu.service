# SPDX-License-Identifier: MIT
[Unit]
Description=Start qualified Bluejay development GPU
ConditionPathExists=/etc/omamobile/bluejay-gpu-enable
Requires=omamobile-bluejay-boot-ready.service omamobile-bluejay-hardware.service
After=omamobile-bluejay-boot-ready.service omamobile-bluejay-hardware.service omamobile-bluejay-wifi.service systemd-journald.service
Before=sddm.service
FailureAction=reboot-force

[Service]
Type=oneshot
ExecStart=/usr/bin/omamobile-bluejay-gpu-start
RemainAfterExit=yes
TimeoutStartSec=30s
TimeoutStopSec=5s
