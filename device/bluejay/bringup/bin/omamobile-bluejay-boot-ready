#!/bin/bash
# SPDX-License-Identifier: MIT
set -euo pipefail
# Keep the failed-boot marker unless both local rescue prerequisites exist.
ip -4 -o address show dev usb0 | grep -F ' 172.16.42.1/24 ' >/dev/null
systemctl is-active --quiet sshd.service
rm -f /var/lib/omamobile/root-boot-pending
sync /var/lib/omamobile
echo 'bluejay: persistent root and USB SSH ready'
