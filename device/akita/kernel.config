# SPDX-License-Identifier: MIT
# akita's kernel options, merged by bin/omamobile kernel on top of
# kernel/configs/omamobile.config.

# The watchdog driver stops the bootloader's watchdogs, so a hang that never
# panics lasts until someone resets the phone with its buttons. For the phone
# to reset by itself, a hang has to end in a panic and panic=10's reset.
# zuma-akita.dts's bootargs ask for panics on lockups and RCU stalls; these
# build the detectors (the buddy hard-lockup detector on arm64 without pseudo
# NMIs), as husky's kernel.config does.
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
