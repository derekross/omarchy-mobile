/*
 * Bring-up probe, never default: the first boot with UFS on (BRINGUP-M2,
 * M2.3). The board file's bootargs, plus omamobile.ufs-probe (the init lists
 * every LUN and partition, with the storage guard's read-only flags, in
 * /run/ufs-probe.txt and the kernel log) and omamobile.initramfs (no
 * hand-over to Arch, so nothing runs on userdata). Set DTB_OVERLAYS="ufs-probe"
 * in device.conf for that build only.
 *
 * An overlay replaces bootargs whole, so these are a copy: zuma-akita.dts's
 * bootargs as of linux-omarchy-mobile#206 (omamobile 75b9c0b73), unchanged
 * since the first-light board file (#192). If the board file's change,
 * copy them again before reusing this, or the overlay silently reverts them.
 */
/dts-v1/;
/plugin/;

&{/chosen} {
	bootargs = "console=tty0 fbcon=font:TER16x32 reboot=warm panic=10 softlockup_panic=1 nmi_watchdog=panic sysctl.kernel.panic_on_rcu_stall=1 clk_ignore_unused pd_ignore_unused rdinit=/init omamobile.ufs-probe omamobile.initramfs";
};
