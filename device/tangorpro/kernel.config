# SPDX-License-Identifier: MIT
# tangorpro's kernel options, merged by bin/omamobile kernel on top of
# kernel/configs/omamobile.config.

# Touch: the panel's Novatek NT36523 on USI0 SPI (TOUCH-PLAN.md). A
# module, so a bad first boot is undone by blacklisting it; its node stays
# disabled until overlays/touch.dtso. Until linux-omamobile has the driver,
# olddefconfig drops the unknown symbol.
CONFIG_TOUCHSCREEN_NOVATEK_NT36523=m
