#!/bin/bash
# SPDX-License-Identifier: MIT
# extract-touch-fw: stage the Pixel Tablet's touch firmware from the owner's
# own factory image, under the names the mainline driver requests
# (novatek-nt36523, TOUCH-PLAN.md):
#
#   vendor/firmware/novatek_ts_fw.bin      -> novatek/nt36523n-tangorpro-boe.bin   (BOE panel)
#   vendor/firmware/novatek_ts_fw_csot.bin -> novatek/nt36523n-tangorpro-csot.bin  (CSOT panel)
#
# The NT36523N touch controller has no flash: the driver writes this image
# into its SRAM at every probe. Google's tablet DT picks the file by panel
# (novatek,panel_map in gs201-tangorpro-touch.dtsi); the board DTS names the
# BOE one. The MP (factory self-test) images are not copied. Proprietary
# firmware is never committed or redistributed: this stages it from the
# user's image on the user's machine. To fold into
# tools/extract-vendor-firmware as a "-d tangorpro" mapping later.
#
# Usage: device/tangorpro/extract-touch-fw [-o OUTDIR] [-w WORKDIR] SOURCE
#   SOURCE  tangorpro factory zip, the image-tangorpro-*.zip inside it, or a
#           raw/sparse vendor.img
#   -o DIR  staging root (default ./out/touch-firmware); files land under
#           DIR/usr/lib/firmware/updates/novatek/, with SHA256SUMS beside them
# Install on the tablet:
#   tar -C OUTDIR -cf - usr | tools/phone-ssh 'tar -C / -xf -'
#
# Needs: unzip, debugfs (e2fsprogs); simg2img if vendor.img is sparse;
# fsck.erofs (erofs-utils) if vendor is EROFS. Nothing touches the tablet.
set -euo pipefail
export PATH=$PATH:/usr/sbin:/sbin

MAP=(
  "firmware/novatek_ts_fw.bin|novatek/nt36523n-tangorpro-boe.bin"
  "firmware/novatek_ts_fw_csot.bin|novatek/nt36523n-tangorpro-csot.bin"
)
DEST_REL="usr/lib/firmware/updates"

say() { printf '==> %s\n' "$*"; }
die() { printf 'error: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "$1 not found ($2)"; }
magic_at() { od -An -tx4 -j "$2" -N4 "$1" | tr -d ' \n'; }
zip_member() { unzip -Z1 "$1" | grep -E "(^|/)$2\$" | sed -n 1p || true; }

OUT="./out/touch-firmware" WORK=""
while getopts "o:w:h" opt; do
  case $opt in
    o) OUT=$OPTARG ;;
    w) WORK=$OPTARG ;;
    h) sed -n '3,30p' "$0"; exit 0 ;;
    *) exit 2 ;;
  esac
done
shift $((OPTIND - 1))
(($# == 1)) || die "usage: extract-touch-fw [-o OUTDIR] [-w WORKDIR] SOURCE"
SRC=$1
[[ -f $SRC ]] || die "no such file: $SRC"
[[ $(realpath -m -- "$OUT") != / ]] || die "refusing OUTDIR /"

if [[ -z $WORK ]]; then
  WORK=$(mktemp -d)
  trap 'rm -rf "$WORK"' EXIT
else
  mkdir -p "$WORK"
fi

img="$WORK/vendor.img"
if [[ $(magic_at "$SRC" 0) == 04034b50 ]]; then
  need unzip "install unzip"
  src=$SRC
  inner=$(zip_member "$src" "image-[^/]*\.zip")
  if [[ -n $inner ]]; then
    say "Unpacking $inner from the factory zip"
    unzip -p "$src" "$inner" > "$WORK/image.zip"
    src="$WORK/image.zip"
  fi
  m=$(zip_member "$src" "android-info\.txt")
  [[ -z $m ]] || unzip -p "$src" "$m" | grep -qE '^require board=(.*\|)?tangorpro(\|.*)?$' ||
    die "this image is not for tangorpro (android-info.txt)"
  m=$(zip_member "$src" "vendor\.img")
  [[ -n $m ]] || die "no vendor.img in $(basename "$src")"
  say "Unpacking vendor.img"
  unzip -p "$src" "$m" > "$img"
else
  cp -- "$SRC" "$img"
fi

if [[ $(magic_at "$img" 0) == ed26ff3a ]]; then
  need simg2img "install android-tools"
  say "Converting sparse vendor.img"
  simg2img "$img" "$img.raw" && mv "$img.raw" "$img"
fi

if [[ $(od -An -tx2 -j 1080 -N2 "$img" | tr -d ' ') == ef53 ]]; then
  need debugfs "install e2fsprogs"
  say "vendor.img is ext4; reading it with debugfs (no mount)"
  # debugfs exits 0 even when a dump fails, so the result is checked by size
  get_file() { debugfs -R "dump /$1 \"$2\"" "$img" >/dev/null 2>&1; [[ -s $2 ]]; }
elif [[ $(magic_at "$img" 1024) == e0f5e1e2 ]]; then
  need fsck.erofs "install erofs-utils"
  say "vendor.img is EROFS; extracting it with fsck.erofs"
  fsck.erofs --extract="$WORK/vendor" --no-preserve "$img" >/dev/null
  get_file() { [[ -s "$WORK/vendor/$1" ]] && cp -- "$WORK/vendor/$1" "$2"; }
else
  die "vendor.img is neither ext4 nor EROFS"
fi

stage="$WORK/stage"
mkdir -p "$stage/novatek"
for entry in "${MAP[@]}"; do
  from=${entry%%|*} to=${entry#*|}
  get_file "$from" "$stage/$to" || die "vendor has no /$from"
  # A host-download image: 4 KiB sectors, the last one ending in "NVT"
  size=$(stat -c %s "$stage/$to")
  ((size % 4096 == 0)) || die "/$from is not a whole number of 4 KiB sectors"
  [[ $(tail -c 3 "$stage/$to") == NVT ]] || die "/$from has no NVT end flag"
  say "$from -> $to ($size bytes)"
done

dest="$OUT/$DEST_REL"
mkdir -p "$dest/novatek"
for entry in "${MAP[@]}"; do
  to=${entry#*|}
  install -m 0644 "$stage/$to" "$dest/$to"
done
(cd "$dest" && sha256sum "${MAP[@]#*|}" > novatek/SHA256SUMS)
cat "$dest/novatek/SHA256SUMS"
say "Staged under $dest"
