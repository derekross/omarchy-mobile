# SPDX-License-Identifier: MIT
# Stage 1 (First Light) kernel fragment for Lenovo TB-X606F (MT8768 / MT6765).
# Merged on top of rabbit_r1_defconfig. Everything needed to reach USB NCM + SSH
# in initramfs is built in (=y).

# Ensure MediaTek watchdog, reboot-mode, PMIC wrap, MT6357 regulators & keys are built in
CONFIG_WATCHDOG=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_SYSCON_REBOOT_MODE=y
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR_MT6357=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_KEYBOARD_MTK_PMIC=y
CONFIG_MEDIATEK_MT6577_AUXADC=y

# USB gadget (MUSB + TPHY + ConfigFS NCM + ACM) built in
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_DUAL_ROLE=y
CONFIG_USB_MUSB_MEDIATEK=y
CONFIG_PHY_MTK_TPHY=y

# Initramfs & rootfs essentials
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BOOT_CONFIG=y

# Early display / console / pstore ramoops
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# Userspace / Omarchy & Waydroid readiness
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_PSI=y
CONFIG_MEMFD_CREATE=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# Register debugging in Stage 1
CONFIG_DEVMEM=y
CONFIG_STRICT_DEVMEM=y

# Disable rabbit-r1 specific & non-essential SoC drivers during Stage 1 isolation
CONFIG_DRM_MEDIATEK=y
# CONFIG_DRM_PANFROST is not set
# CONFIG_ARM_PSCI_CPUIDLE is not set
# CONFIG_MTK_SVS is not set
CONFIG_MTK_IOMMU=y
CONFIG_MTK_CMDQ=y
# CONFIG_MTK_SCP is not set
# CONFIG_MTK_DEVAPC is not set
# CONFIG_MTK_CCCI_R1_MD_PROBE is not set
# CONFIG_MTK_CCCI is not set
# CONFIG_DRM_PANEL_RABBIT_R1 is not set

# Stage 2 native display pipeline (DRM_MEDIATEK + HX83102P + TPS65132 + SGM37604A)
CONFIG_DRM_PANEL_HIMAX_HX83102=y
CONFIG_REGULATOR_TPS65132=y
CONFIG_BACKLIGHT_SGM37604A=y

# Stage 3 Batch 1: Touch + Keypad
CONFIG_TOUCHSCREEN_HIMAX_HX83112B=y

# Stage 3 Batch 2: Charger + Fuel Gauge + Type-C
CONFIG_CHARGER_BQ256XX=y
CONFIG_TYPEC_WUSB3801=y

# Stage 3 Batch 3: Thermal + DVFSRC + SPM Sleep + PowerVR GPU + TRNG
CONFIG_MTK_THERMAL=y
CONFIG_MTK_SOC_THERMAL=y
CONFIG_MTK_DVFSRC=y
CONFIG_REGULATOR_MTK_DVFSRC=y
CONFIG_MTK_MT6765_MCDI=y
CONFIG_MTK_MT6765_SPM_SLEEP=y
CONFIG_DRM_PVR_MTK_DDK=y
CONFIG_HW_RANDOM_MTK=y

# Stage 3 Batch 4: Connectivity (CONSYS Wi-Fi/BT/GPS) + Audio
CONFIG_MTK_CONN_BTIF=y
CONFIG_MTK_CONN_WMT=y
CONFIG_MTK_CONN_WLAN_CHRDEV=y
CONFIG_MTK_CONN_WLAN_GEN4M=y
CONFIG_MTK_CONN_BT=y
CONFIG_MTK_CONN_GPS=y

# Stage 4c: NFSv3/v4 client for non-destructive rootfs bring-up over USB NCM
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_SUNRPC=y
CONFIG_LOCKD=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V4=y

# Netfilter / nftables (required by Arch iptables-nft and ufw)
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_ARP=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_CT=y
CONFIG_NFT_CONNLIMIT=y
CONFIG_NFT_HASH=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_REJECT_IPV4=y
CONFIG_NFT_REJECT_IPV6=y
CONFIG_IP6_NF_MATCH_RT=y

# Use PIO for MediaTek MUSB gadget (Inventra HSDMA stalls under heavy bidirectional NFS traffic)
CONFIG_MUSB_PIO_ONLY=y
# CONFIG_USB_INVENTRA_DMA is not set

# PSCI CPU idle (cpu-off-b / cpu-off-l)
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_ARM_PSCI_CPUIDLE_DOMAIN=y
