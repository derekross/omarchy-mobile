/*
 * Empty board overlay for the Pixel 6 Pro bootloader (ABL).
 *
 * ABL picks a dtbo entry by board_id/board_rev and applies it on top of
 * our base DTB. Retail raven (MP1.0, ro.boot.dtbo_idx 6) matches the stock
 * dtbo's "Raven DVT" entry; ours carries the same IDs and changes nothing.
 */
/dts-v1/;
/plugin/;

/ {
	board_id = <0x20204>;
	board_rev = <0x10000>;

	fragment@0 {
		target-path = "/";
		__overlay__ {
		};
	};
};
