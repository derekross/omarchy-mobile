// SPDX-License-Identifier: MIT
/*
 * Bring-up only (AUDIO-PLAN.md, stages R3-R4): the AoC sound card on raven.
 * Raven's stock sound-aoc (factory dtbo, CP3A.261005.002.A1) has the same
 * 53 DAI links, ids and formats as cheetah's, and stock's mixer_paths.xml
 * uses the same TDM 0 slots for its two CS35L41s, so this is cheetah's
 * aoc-sound-test: the amplifiers (amp_top and amp_bottom, on SPI 13 here)
 * as the TDM 0 codecs and haptics links without a codec. Apply with
 * aoc-boot-test and audio-amps-test.
 *
 * TDM 0 slots (stock raven mixer_paths.xml): the top amplifier plays slot
 * 0, the bottom one slot 1; their VMON/IMON feedback (ASP TX1-TX4) goes out
 * interleaved (top 0, 2, 4, 6; bottom 1, 3, 5, 7), so the two never drive
 * the shared SDOUT line in the same slot.
 *
 * The card driver sorts the DAI links into the stock order by their ids, so
 * the PCM numbers (which are the AoC entry points) do not depend on the order
 * in which the overlay apply leaves these nodes.
 */
/dts-v1/;
/plugin/;

&amp_top {
	google,tdm-rx-slots = <0 1>;
	google,tdm-tx-slots = <0 2 4 6>;
};

&amp_bottom {
	google,tdm-rx-slots = <1 0>;
	google,tdm-tx-slots = <1 3 5 7>;
};

&{/} {
		aoc_pcm_ep: aoc_pcm_drv {
			compatible = "google-aoc-snd-pcm";
		};

		aoc_voice_ep: aoc_voice_drv {
			compatible = "google-aoc-snd-voice";
		};

		aoc_compr_ep: aoc_compr_drv {
			compatible = "google-aoc-snd-compr";
		};

		aud_aoc_path: aoc_path {
			#sound-dai-cells = <0x01>;
			compatible = "google-aoc-path";
		};

		aoc_nohost_drv: aoc_nohost {
			compatible = "google-aoc-snd-nohost";
		};

		aoc_voip_ep: aoc_voip_drv {
			compatible = "google-aoc-snd-voip";
		};

		aoc_incall_ep: aoc_incall_drv {
			compatible = "google-aoc-snd-incall";
		};

		aoc_snd_card: sound-aoc {
			compatible = "google-aoc-snd-card";
			aoc-card-name = "google,raven-aoc-snd-card";

			dai_link {

				dai_fe_ep1_rx: fe_ep1_rx {
					dai-name = "audio_playback0";
					stream-name = "EP1 playback";
					id = <0x00>;
					dynamic;
					playback;

					cpu {
						sound-dai = <&aud_aoc_path 0x00>;
					};

					platform {

						rx1 {
							of_drv = <&aoc_pcm_ep>;
						};
					};
				};

				dai_fe_ep2_rx: fe_ep2_rx {
					dai-name = "audio_playback1";
					stream-name = "EP2 playback";
					id = <0x01>;
					dynamic;
					playback;

					cpu {
						sound-dai = <&aud_aoc_path 0x01>;
					};

					platform {

						rx1 {
							of_drv = <&aoc_pcm_ep>;
						};
					};
				};

				dai_fe_ep3_rx: fe_ep3_rx {
					dai-name = "audio_playback2";
					stream-name = "EP3 playback";
					id = <0x02>;
					dynamic;
					playback;

					cpu {
						sound-dai = <&aud_aoc_path 0x02>;
					};

					platform {

						rx1 {
							of_drv = <&aoc_pcm_ep>;
						};
					};
				};

				dai_fe_ep4_rx: fe_ep4_rx {
					dai-name = "audio_playback3";
					stream-name = "EP4 playback";
					id = <0x03>;
					dynamic;
					playback;

					cpu {
						sound-dai = <&aud_aoc_path 0x03>;
					};

					platform {

						rx1 {
							of_drv = <&aoc_pcm_ep>;
						};
					};
				};

				dai_fe_ep5_rx: fe_ep5_rx {
					dai-name = "audio_playback4";
					stream-name = "EP5 playback";
					id = <0x04>;
					dynamic;
					playback;

					cpu {
						sound-dai = <&aud_aoc_path 0x04>;
					};

					platform {

						vorx {
							of_drv = <&aoc_voice_ep>;
						};
					};
				};

				dai_fe_ep6_rx: fe_ep6_rx {
					dai-name = "audio_playback5";
					stream-name = "EP6 playback";
					id = <0x05>;
					dynamic;
					playback;

					cpu {
						sound-dai = <&aud_aoc_path 0x05>;
