				dai_fe_ep4_tx: fe_ep4_tx {
					dai-name = "audio_capture3";
					stream-name = "EP4 capture";
					id = <0x40000003>;
					dynamic;
					capture;

					cpu {
						sound-dai = <&aud_aoc_path 0x40000003>;
					};

					platform {

						votx {
							of_drv = <&aoc_voice_ep>;
