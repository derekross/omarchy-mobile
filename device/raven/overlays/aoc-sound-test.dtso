				dai_be_bt_tx: be_bt_tx {
					dai-name = "BT_TX Capture";
					stream-name = "BT_TX Capture";
					id = <0xc000000c>;
					capture;
					no-pcm;
					useops;
					usefixup;

					cpu {
						sound-dai = <&aud_aoc_path 0xc000000c>;
					};
				};

				dai_be_usb_rx: be_usb_rx {
					dai-name = "USB_RX Playback";
					stream-name = "USB_RX Playback";
					id = <0x8000000d>;
					playback;
					no-pcm;
					useops;
					usefixup;

					cpu {
						sound-dai = <&aud_aoc_path 0x8000000d>;
					};
				};

				dai_be_usb_tx: be_usb_tx {
					dai-name = "USB_TX Capture";
					stream-name = "USB_TX Capture";
					id = <0xc000000e>;
					capture;
					no-pcm;
					useops;
					usefixup;

					cpu {
						sound-dai = <&aud_aoc_path 0xc000000e>;
					};
				};

				dai_be_incall_rx: be_incall_rx {
					dai-name = "INCALL_RX Playback";
					stream-name = "INCALL_RX Playback";
					id = <0x8000000f>;
					playback;
					no-pcm;
					useops;
					usefixup;

					cpu {
						sound-dai = <&aud_aoc_path 0x8000000f>;
					};
				};

				dai_be_incall_tx: be_incall_tx {
					dai-name = "INCALL_TX Capture";
					stream-name = "INCALL_TX Capture";
					id = <0xc0000010>;
					capture;
					no-pcm;
					useops;
					usefixup;

					cpu {
						sound-dai = <&aud_aoc_path 0xc0000010>;
					};
				};

				dai_be_haptic_rx: be_haptic_rx {
					dai-name = "HAPTIC_RX Playback";
					stream-name = "HAPTIC_RX Playback";
					id = <0x80000011>;
					playback;
					no-pcm;
					useops;
					usefixup;

					cpu {
						sound-dai = <&aud_aoc_path 0x80000011>;
					};

					daifmt {
						dai-format = "dsp_a";
					};

				};

				dai_be_eraser_tx: be_eraser_tx {
					dai-name = "ERASER_TX Capture";
					stream-name = "ERASER_TX Capture";
					id = <0xc0000012>;
					capture;
					no-pcm;
					useops;
					usefixup;

					cpu {
						sound-dai = <&aud_aoc_path 0xc0000012>;
					};
				};
			};

			clks {

				sys {


					sys@cs35l41_l {
						comp = <&amp_top>;
						src = "BCLK";
						id = <0x00>;
						srcid = <0x00>;
						in_mul = <0x01>;
						out_mul = <0x01>;
					};

					sys@cs35l41_r {
						comp = <&amp_bottom>;
						src = "BCLK";
						id = <0x00>;
						srcid = <0x00>;
						in_mul = <0x01>;
						out_mul = <0x01>;
					};
				};
			};
		};
};
