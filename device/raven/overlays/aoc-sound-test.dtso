						sound-dai = <&aud_aoc_path 0x40000000>;
					};

					platform {

						tx1 {
							of_drv = <&aoc_pcm_ep>;
						};
					};
				};

				dai_fe_ep2_tx: fe_ep2_tx {
					dai-name = "audio_capture1";
					stream-name = "EP2 capture";
					id = <0x40000001>;
					dynamic;
					capture;

					cpu {
						sound-dai = <&aud_aoc_path 0x40000001>;
					};

					platform {

						tx1 {
							of_drv = <&aoc_pcm_ep>;
						};
					};
				};

				dai_fe_ep3_tx: fe_ep3_tx {
					dai-name = "audio_capture2";
					stream-name = "EP3 capture";
					id = <0x40000002>;
					dynamic;
					capture;

					cpu {
						sound-dai = <&aud_aoc_path 0x40000002>;
					};

					platform {

						tx1 {
							of_drv = <&aoc_pcm_ep>;
						};
