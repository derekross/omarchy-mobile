# SPDX-License-Identifier: MIT
# Raven-only kernel options, merged after kernel/configs/omamobile.config.
# Some drivers aren't in the published kernel yet; merge_config only warns
# about a symbol a kernel doesn't have, so the published kernel still builds:
# the AoC (omamobile-gs101-aoc), the modem's SPI boot device
# (omamobile-gs101-cpif), the panel (omamobile-gs101-display), the touch
# transport (kernel #8) and the thermal sensors (kernel #7).
# The AoC drivers against gs101's firmware interface (AUDIO-PLAN.md R0).
CONFIG_GOOGLE_AOC_GS101=y
# The modem (S5123) takes its first boot stage over SPI bus 9 before its PCIe
# link (device/raven/MODEM-PLAN.md section 2). Cheetah's CPIF options come
# from kernel/configs/omamobile.config; this adds the SPI boot device.
CONFIG_BOOT_DEVICE_SPI=m
# Raven's own hardware, as modules (BRINGUP-M1.md, DISPLAY-PLAN.md): the
# S6SY79x touchscreen through s6sy761, the S6E3HC3 panel and the gs101
# thermal sensors through ACPM.
CONFIG_TOUCHSCREEN_S6SY761=m
CONFIG_DRM_PANEL_SAMSUNG_S6E3HC3=m
CONFIG_GS101_ACPM_THERMAL=m
