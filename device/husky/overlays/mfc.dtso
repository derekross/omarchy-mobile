// SPDX-License-Identifier: MIT
/*
 * Opt-in: hardware video decode and encode (the MFC v16.6, s5p-mfc's
 * google,zuma-mfc) on the Pixel 8 Pro. The kernel (linux-omamobile#289)
 * describes the MFC in zuma.dtsi but leaves it disabled and gives it no
 * memory: its System MMU and the S2MPU in front of it are not described,
 * so they stay as the bootloader leaves them, and Google's closed
 * firmware, parsing whatever video an app hands it, can reach all memory
 * below 4 GiB, the kernel's included. Enable it only if you accept that.
 *
 * The MFC takes 32-bit addresses and the firmware rejects any buffer
 * below its own base, so the firmware and every buffer come from one
 * contiguous pool below 4 GiB, firmware first: 256 MiB, as panther's.
 * Reusable, so the pages serve movable allocations while no video runs.
 * No fixed address: a size and alloc-ranges, as Google's own pool.
 *
 * pd_mfc and CMU_MFC aren't described either: the block runs on the power
 * domain and clocks the bootloader leaves on, which holds only while
 * husky boots with clk_ignore_unused and pd_ignore_unused (device.conf).
 * It also needs the firmware, mfc_fw.bin from your own factory image,
 * which tools/extract-vendor-firmware stages as s5p-mfc-v16.fw.
 * Paths, not labels, so the base DTB needs no __symbols__.
 */
/dts-v1/;
/plugin/;

&{/reserved-memory} {
	mfc_pool: mfc-pool {
		compatible = "shared-dma-pool";
		reusable;
		size = <0x10000000>;
		/* read with the root's #address-cells (2), not #size-cells */
		alignment = <0x0 0x200000>;
		alloc-ranges = <0x0 0x80000000 0x80000000>;
	};
};

&{/soc@0/video-codec@1a4d0000} {
	memory-region = <&mfc_pool>;
	status = "okay";
};
