/*
 * Bring-up overlay, never default (BATTERY-NOTES.md M4c): load Google's ModelGauge m5 model for an
 * unknown pack into the husky fuel gauge (Google falls back to the default-a1-0k node when the
 * battery ID is unknown). Generated from the stock DT by tools/gen-gauge-overlay.py:
 * maxim,fg-model = the 24 stock u32 cells split into 48 u16 (high half first),
 * maxim,fg-params = the stock byte list as big-endian u16 words, in the order of
 * struct max77759_fg_params. The driver loads it only while the gauge reports power-on
 * reset (Status bit 1), then clears that bit.
 */
/dts-v1/;
/plugin/;

&hsi2c_11 {
	fuel-gauge@36 {
	maxim,fg-model = /bits/ 16 <
			0x9760 0xa510 0xb100 0xb600 0xb7a0 0xb900 0xba70 0xbc70
			0xbde0 0xbfc0 0xc250 0xc510 0xc990 0xcea0 0xd040 0xd750
			0x0060 0x0120 0x0200 0x0710 0x0e80 0x0df0 0x1430 0x1bd0
			0x1520 0x0d70 0x0950 0x08e0 0x0800 0x0780 0x06b0 0x01e0
			0x0100 0x0100 0x0100 0x0100 0x0100 0x0100 0x0100 0x0100
			0x0100 0x0100 0x0100 0x0100 0x0100 0x0100 0x0100 0x0100
	>;
	maxim,fg-params = /bits/ 16 <
			0xf060 0x2038 0x260e 0x4217 0x0090 0x5f00 0x0994 0x0994
			0x0c80 0x0099 0x0994 0xa561 0x1100 0x0800 0x0301 0x0302
			0x0700 0x223e 0x0310 0xed51 0x1eba 0x0014 0x3870 0x0000
			0x2241 0xc623 0x2d00
	>;
	};
};
