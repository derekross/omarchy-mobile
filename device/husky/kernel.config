# SPDX-License-Identifier: MIT
# husky's kernel options, merged by bin/omamobile kernel on top of
# kernel/configs/omamobile.config.

# zuma's eUSB2 PHY (Exynos 2200's Synopsys IP): defconfig builds it as a
# module, and the initramfs brings up USB before any module could load
CONFIG_PHY_SNPS_EUSB2=y

# The watchdog driver stops the bootloader's watchdogs (BRINGUP-M1 test 19),
# so a hang that never panics lasts until someone holds Power + Volume Up
# (test 23). For the phone to reset by itself, a hang has to end in a panic
# and panic=10's reset. zuma-husky.dts's bootargs
# ask for panics on lockups and RCU stalls; these build the detectors (the
# buddy hard-lockup detector on arm64 without pseudo NMIs).
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
