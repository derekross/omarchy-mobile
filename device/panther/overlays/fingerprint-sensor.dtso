/*
 * Bring-up only (device/panther/FINGERPRINT-PLAN.md, gate P4): enable the
 * sub-PMIC (only LDO15S, the sensor's supply, is described on panther) and
 * the Goodix sensor node. Apply after fingerprint-trusty.dtso. The PERIC0
 * pin controller (the sensor's reset line, gpp1-1) is already on in the
 * default DTB. Paths, not labels, so the base DTB needs no __symbols__.
 */
/dts-v1/;
/plugin/;

&{/firmware/power-management/pmic-2} {
	status = "okay";
};

&{/fingerprint} {
	status = "okay";
};
