            fi
            stock_usb2_test "$bb" dummy || end_inventory "USB2 dummy test failed"
            end_inventory "USB2 dummy test complete"
        fi
        end_inventory "NV guard complete"
    fi
    end_inventory "inventory complete"
fi
end_inventory "inventory incomplete"
