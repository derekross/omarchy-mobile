# SPDX-License-Identifier: MIT
# kebab's kernel fragment, merged after kernel/configs/omamobile.config.
# Bring-up set: what the phone needs to reach a shell over USB and read UFS,
# built in (modules are not loaded before these devices probe; see
# dipper/kernel.config). UNBUILT: not yet run against a kernel tree.

# Clocks, pinctrl, interconnect, RPMh: the SM8250 base.
CONFIG_ARCH_QCOM=y
CONFIG_SM_GCC_8250=y
CONFIG_SM_GPUCC_8250=y
CONFIG_SM_DISPCC_8250=y
CONFIG_PINCTRL_SM8250=y
CONFIG_INTERCONNECT_QCOM_SM8250=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMHPD=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SMSM=y

# USB and UFS PHYs, UFS glue, USB controller.
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_TYPEC_QCOM_PMIC=y
# TYPEC_QCOM_PMIC depends on TCPM; TCPM=m silently made it a module
CONFIG_TYPEC_TCPM=y
CONFIG_QCOM_WDT=y
CONFIG_PHY_QCOM_QMP_USB=y
# sm8250's USB2 PHY (qcom,usb-snps-hs-7nm-phy); as a module dwc3 defers forever
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
# cpufreq-hw needs the L3 icc path
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_REGULATOR_QCOM_USB_VBUS=y

# PMIC keys and power-on, for the buttons.
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_SPMI_MSM_PMIC_ARB=y

# Touch: Samsung S6SY761 (kebab.dts touchscreen@48).
CONFIG_TOUCHSCREEN_S6SY761=y

# AOSS QMP built in, else DRM_MSM is held to a module (it depends on
# QCOM_AOSS_QMP || QCOM_AOSS_QMP=n).
CONFIG_QCOM_AOSS_QMP=y

# Display and GPU: MSM DRM (DPU, DSI) and Adreno 650. The panel driver for
# kebab is not identified yet (NOTES.md); simple-framebuffer covers first light.
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DPU=y
CONFIG_DRM_MSM_DSI=y
CONFIG_DRM_MSM_DSI_7NM_PHY=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_SIMPLEDRM=y

# Wi-Fi and Bluetooth (QCA6390 per the DTS), NFC (NXP NCI), battery chips.
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_BT_QCA=m
CONFIG_BT_HCIUART_QCA=y
CONFIG_NFC_NXP_NCI=m
CONFIG_NFC_NXP_NCI_I2C=m
CONFIG_CHARGER_BQ25980=m
CONFIG_BATTERY_BQ27XXX=m
CONFIG_BATTERY_BQ27XXX_I2C=m
