pkgname=omamobile-gnss
pkgver=$(cat "${startdir:-.}/.pkgver" 2>/dev/null || "${startdir:-.}/../../tools/pkg-version" "${startdir:-.}")
pkgrel=1
pkgdesc="Omarchy Mobile GNSS for the Pixel 7 Pro: Broadcom's lhd/gpsd in a vendor chroot, NMEA to GeoClue on demand"
arch=(aarch64)
url="https://github.com/derekross/omarchy-mobile"
license=(MIT)
depends=(bash python curl iproute2 util-linux coreutils systemd geoclue libnotify)
optdepends=('gpsd: NMEA for gpsd clients through /run/omamobile-gnss/nmea-tty')
backup=(etc/geoclue/conf.d/90-omamobile-gnss.conf etc/omamobile/gnss.conf)
install=omamobile-gnss.install

check() {
  "$startdir/test/all"
}

package() {
  OMAMOBILE_PKGVER=$pkgver "$startdir/install" "$pkgdir"
}
