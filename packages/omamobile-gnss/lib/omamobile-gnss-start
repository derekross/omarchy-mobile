#!/bin/bash
# SPDX-License-Identifier: MIT
# omamobile-gnss-start: bring GNSS up the hang-safe way, then run the gnss
# vendor-chroot profile in the foreground (omamobile-gnss.service).
#
# Like omamobile-wifi-start: a marker file is written and synced before the
# kernel driver loads; it is removed once the daemons are up. If the phone
# hung or reset in between, the next boot finds the marker and skips GNSS
# until someone runs this with --retry.
set -euo pipefail

MARK=/var/lib/omamobile/gnss-bringup-started
# The 9a's session of this boot: written with the marker, in /run so that a
# reset empties it.
SESSION=/run/omamobile-gnss/session
say() { printf 'omamobile-gnss: %s\n' "$*" >&2; }

# the Pixel 9a (zumapro-tegu) runs the gnss-slsi profile, the Pixel 7 Pro gnss
# OMAMOBILE_DT lets the tests run both branches on any machine (as
# omamobile-setup-user does).
tegu() { tr -d '\0' < "${OMAMOBILE_DT:-/proc/device-tree}/compatible" 2>/dev/null | grep -c 'google,zumapro-tegu' >/dev/null; }
if [[ ${1:-} == --stop ]]; then
  # A clean stop is the only place the 9a's marker is cleared: its session
  # runs in the foreground until then, so a reset in between leaves the
  # marker and the next boot skips GNSS until --retry. Only a session of
  # this boot clears it: systemd runs ExecStop after a start that skipped
  # on a leftover marker too, and that stop must leave the marker alone.
  # The 7 Pro's start clears its own marker once the driver is up.
  if [[ -e $SESSION ]]; then
    rm -f "$MARK" "$SESSION"
    sync
  fi
  if tegu; then profile=gnss-slsi; else profile=gnss; fi
  exec /usr/lib/omamobile-vendor/omamobile-vendor-chroot "$profile" stop
fi

if [[ ${1:-} == --retry ]]; then
  rm -f "$MARK"
elif [[ -e $MARK ]]; then
  say "the last bring-up ($(cat "$MARK")) never finished; skipping GNSS (run omamobile-gnss-start --retry)"
  exit 0
fi

# The Pixel 9a's GNSS is the modem's Kepler core: Samsung's gnssd runs in
# the modem profile, and the gnss-slsi profile runs the HAL and our client,
# which writes NMEA to the FIFO the bridge reads. Nothing to load here.
if tegu; then
  if ! grep -c '@GNSSND' /proc/net/unix >/dev/null; then
    say "gnssd isn't running (the modem profile with OMAMOBILE_MODEM_GNSS=1); nothing to do"
    exit 0
  fi
  # The hang marker goes down before the session, as on the 7 Pro, because
  # a session on the 9a can still hang the SoC with the modem up
  # (MODEM-PLAN G3-L1), and socket activation lets any GeoClue client start
  # one: without the marker a hang could repeat at every boot. It is
  # cleared by --stop, not here, since this exec never returns.
  mkdir -p "$(dirname "$MARK")" "$(dirname "$SESSION")"
  date -Is > "$MARK"
  : > "$SESSION"
  sync
  say "starting the 9a's GNSS HAL and client"
  OMAMOBILE_GNSS_NMEA_OUT=fifo exec /usr/lib/omamobile-vendor/omamobile-vendor-chroot gnss-slsi start
fi
# The DT must have the GNSS node enabled (gnss overlay); otherwise nothing to do.
if ! grep -qs okay /sys/firmware/devicetree/base/soc@0/usi@109400c0/spi@10940000/status; then
  say "SPI5 is not enabled in this device tree; nothing to do"
  exit 0
fi

mkdir -p "$(dirname "$MARK")"
date -Is > "$MARK"
sync

# The GNSS rails come from the S2MPG13 (sec_acpm), then the chip driver.
modprobe sec_acpm
modprobe bcm4775x-gnss
for _ in $(seq 1 50); do [[ -c /dev/ttyBCM ]] && break; sleep 0.1; done
[[ -c /dev/ttyBCM ]] || { say "no /dev/ttyBCM after loading bcm4775x-gnss"; exit 1; }

rm -f "$MARK"
sync
say "driver up; starting lhd and gpsd"
exec /usr/lib/omamobile-vendor/omamobile-vendor-chroot gnss start
