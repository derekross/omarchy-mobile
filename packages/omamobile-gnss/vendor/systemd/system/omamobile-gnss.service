# GNSS: the bcm4775x-gnss driver and Broadcom's lhd/gpsd in the gnss vendor
# chroot (device/cheetah/GNSS-PLAN.md). Never enabled on its own: the NMEA
# bridge pulls it in while something wants positions, and it stops when the
# bridge does (StopWhenUnneeded), which closes /dev/ttyBCM and powers the
# chip off.
[Unit]
Description=Omarchy Mobile GNSS (Pixel 7 Pro: BCM4775x, stock lhd and gpsd; Pixel 9a: the modem's Kepler through the stock HAL)
After=network-online.target
StopWhenUnneeded=yes
ConditionPathExists=|/usr/lib/omamobile-vendor/gnss/root
ConditionPathExists=|/usr/lib/omamobile-vendor/gnss-slsi/root

[Service]
# A location session keeps the phone awake: while the stack runs it holds a
# logind sleep inhibitor (block mode), which logind and omamobile-sleepd
# honour (device/cheetah/SUSPEND-PLAN.md 6.1). It ends with the stack.
ExecStart=/usr/bin/systemd-inhibit --what=sleep --mode=block "--who=Omarchy Mobile GNSS" "--why=A location session is running" /usr/lib/omamobile-vendor/omamobile-gnss-start
# Before the stop signal: ask gpsd to end its request, so it saves its
# state (gldata.sto) for the next start. Bounded at ~4 s.
ExecStop=/usr/lib/omamobile-vendor/omamobile-gnss-start --stop
TimeoutStopSec=15
