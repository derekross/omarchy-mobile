#!/bin/bash
# SPDX-License-Identifier: MIT
# Static checks for omamobile-gnss: syntax, the staged layout, the units, and
# that the prebuilt bionic libraries are the aarch64 ELF files they claim to be.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { echo "FAIL: $*" >&2; exit 1; }
for f in bin/omamobile-gnss lib/omamobile-vendor-chroot lib/omamobile-gnss-start lib/omamobile-gnss-lto \
         lib/omamobile-gnss-conf install profiles/gnss.conf profiles/gnss-slsi.conf omamobile-gnss.install; do
  bash -n "$f" || fail "syntax: $f"
done
python3 -c 'import ast, sys; ast.parse(open(sys.argv[1]).read())' lib/omamobile-gnss-nmea || fail "python: omamobile-gnss-nmea"
bash test/install-hook.sh || fail "the upgrade hook and the Location switch"
# The Pixel 9a's path: gnss-slsi from the start script, its FIFO in the bridge and the units.
grep -c 'gnss-slsi start' lib/omamobile-gnss-start >/dev/null || fail "the 9a starts gnss-slsi"
# The 9a writes the hang marker before its session and clears it after a clean stop.
s=lib/omamobile-gnss-start
[[ $(grep -n 'date -Is > "\$MARK"' $s | head -1 | cut -d: -f1) -lt $(grep -n 'gnss-slsi start' $s | head -1 | cut -d: -f1) ]] || fail "the 9a's marker goes down before gnss-slsi start"
grep -c 'OMAMOBILE_DT:-/proc/device-tree' $s >/dev/null || fail "the compatible is read through an overridable path"
# both branches, with a fake device tree and a stub chroot: the 9a path writes
# the marker and runs gnss-slsi, the 7 Pro path neither (no SPI5 node here)
tmp=$(mktemp -d); mkdir -p "$tmp/dt" "$tmp/bin" "$tmp/lib/omamobile-vendor" "$tmp/var/lib/omamobile"
printf 'google,zumapro-tegu\0google,zumapro\0' > "$tmp/dt/compatible"
cat > "$tmp/stub" <<'EOF'
#!/bin/sh
echo "chroot $*" >> "${STUB_LOG}"
[ "${STUB_FAIL:-0}" != 1 ] || [ "$2" != stop ]
EOF
chmod +x "$tmp/stub"
# systemd-inhibit's stand-in: says it was asked, then runs the command
cat > "$tmp/inhibit" <<'EOF'
#!/bin/sh
echo "inhibit $*" >> "${STUB_LOG}"
while [ "${1#--}" != "$1" ]; do shift; done
exec "$@"
EOF
chmod +x "$tmp/inhibit"
export OMAMOBILE_GNSS_INHIBIT=$tmp/inhibit
run_start() { # $1 dt dir, $2 fake unix table
  STUB_LOG="$tmp/log" OMAMOBILE_DT="$1" OMAMOBILE_GNSS_CLIENT="${TEST_CLIENT-$tmp/stub}" INVOCATION_ID="${TEST_INVOCATION_ID-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa}" \
    SERVICE_RESULT="${TEST_SERVICE_RESULT:-success}" MAINPID="${TEST_MAINPID-123}" STUB_FAIL="${TEST_STUB_FAIL:-0}" bash -c '
    MARKDIR='"$tmp"'/var/lib/omamobile
    sed -e "s|/var/lib/omamobile/gnss-bringup-started|'"$tmp"'/var/lib/omamobile/gnss-bringup-started|" \
        -e "s|/proc/net/unix|'"$2"'|" \
        -e "s|/run/omamobile-gnss/session|'"$tmp"'/run/omamobile-gnss/session|" \
        -e "s|/run/omamobile-gnss/stop-request|'"$tmp"'/run/omamobile-gnss/stop-request|" \
        -e "s|/sys/firmware/devicetree/base/soc@0/usi@109400c0/spi@10940000/status|'"$tmp"'/no-spi5|" \
        -e "s|/usr/lib/omamobile-vendor/omamobile-vendor-chroot|'"$tmp"'/stub|" lib/omamobile-gnss-start > '"$tmp"'/start
    chmod +x '"$tmp"'/start
    if [ -n "$1" ]; then bash '"$tmp"'/start "$1"; else bash '"$tmp"'/start; fi' _ "${3:-}" 2>/dev/null
}
# The starts below that skip GNSS hold the client's connection first; not here, unless a case asks.
export OMAMOBILE_GNSS_NOTHING_HOLD=0
: > "$tmp/log"; printf '@GNSSND\n' > "$tmp/unix"
run_start "$tmp/dt" "$tmp/unix"
grep -c 'chroot gnss-slsi start' "$tmp/log" >/dev/null || fail "9a branch: gnss-slsi start ran"
[[ -e "$tmp/var/lib/omamobile/gnss-bringup-started" ]] || fail "9a branch: the marker was written before the session"
run_start "$tmp/dt" "$tmp/unix"
grep -c 'never finished; skipping' <(STUB_LOG="$tmp/log" OMAMOBILE_DT="$tmp/dt" bash "$tmp/start" 2>&1) >/dev/null || fail "9a branch: a leftover marker skips the next start"
# after a reset: the marker is left over and /run is empty. The start skips,
# systemd runs ExecStop anyway, and the marker must still be there afterwards
rm -rf "$tmp/run"
run_start "$tmp/dt" "$tmp/unix" --stop
[[ -e "$tmp/var/lib/omamobile/gnss-bringup-started" ]] || fail "a stop after a skipped start cleared the leftover marker"
grep -c 'chroot gnss-slsi stop' "$tmp/log" >/dev/null || fail "9a branch: --stop stops gnss-slsi"
# A clean stop keeps the marker until the processes have actually stopped.
run_start "$tmp/dt" "$tmp/unix" --retry
[[ -e "$tmp/run/omamobile-gnss/session" ]] || fail "9a branch: the session file is written with the marker"
run_start "$tmp/dt" "$tmp/unix" --stop
[[ -e "$tmp/var/lib/omamobile/gnss-bringup-started" ]] || fail "--stop cleared the marker before service exit"
run_start "$tmp/dt" "$tmp/unix" --stopped
[[ ! -e "$tmp/var/lib/omamobile/gnss-bringup-started" && ! -e "$tmp/run/omamobile-gnss/session" ]] || fail "clean stop did not clear the marker"
# A timeout or an unexpected exit leaves the marker, including on the next start.
run_start "$tmp/dt" "$tmp/unix"
run_start "$tmp/dt" "$tmp/unix" --stop
TEST_SERVICE_RESULT=timeout run_start "$tmp/dt" "$tmp/unix" --stopped
[[ -e "$tmp/var/lib/omamobile/gnss-bringup-started" ]] || fail "timed-out stop cleared the marker"
TEST_INVOCATION_ID=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb run_start "$tmp/dt" "$tmp/unix"
TEST_INVOCATION_ID=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb run_start "$tmp/dt" "$tmp/unix" --stop
TEST_INVOCATION_ID=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb run_start "$tmp/dt" "$tmp/unix" --stopped
[[ -e "$tmp/var/lib/omamobile/gnss-bringup-started" ]] || fail "a later skipped start cleared the marker"
run_start "$tmp/dt" "$tmp/unix" --retry
TEST_MAINPID= run_start "$tmp/dt" "$tmp/unix" --stop
run_start "$tmp/dt" "$tmp/unix" --stopped
[[ -e "$tmp/var/lib/omamobile/gnss-bringup-started" ]] || fail "an unexpected exit cleared the marker"
run_start "$tmp/dt" "$tmp/unix" --retry
if TEST_STUB_FAIL=1 run_start "$tmp/dt" "$tmp/unix" --stop; then fail "failed profile stop succeeded"; fi
TEST_SERVICE_RESULT=exit-code run_start "$tmp/dt" "$tmp/unix" --stopped
[[ -e "$tmp/var/lib/omamobile/gnss-bringup-started" ]] || fail "a failed profile stop cleared the marker"
# --retry by hand on the 9a (no invocation ID) only clears the marker; the
# next location request starts GNSS in its unit, so nothing starts here.
: > "$tmp/log"
TEST_INVOCATION_ID= run_start "$tmp/dt" "$tmp/unix" --retry || fail "9a branch: --retry by hand failed"
[[ ! -e "$tmp/var/lib/omamobile/gnss-bringup-started" ]] || fail "9a branch: --retry by hand left the marker"
grep -c 'gnss-slsi start' "$tmp/log" >/dev/null && fail "9a branch: --retry by hand started GNSS outside its unit"
rm -f "$tmp/var/lib/omamobile/gnss-bringup-started"
# A package built without the 9a's HAL client: the start fails before the
# marker, so nothing is left to clear and the next request says the same.
: > "$tmp/log"
TEST_CLIENT="$tmp/no-client" run_start "$tmp/dt" "$tmp/unix" && fail "9a branch: a start without the HAL client succeeded"
[[ ! -e "$tmp/var/lib/omamobile/gnss-bringup-started" ]] || fail "9a branch: a start without the HAL client left the marker"
grep -c 'gnss-slsi start' "$tmp/log" >/dev/null && fail "9a branch: a start without the HAL client ran gnss-slsi"
: > "$tmp/log"; printf 'google,gs201-cheetah\0google,gs201\0' > "$tmp/dt/compatible"
run_start "$tmp/dt" "$tmp/unix"
grep -c 'gnss-slsi' "$tmp/log" >/dev/null && fail "7 Pro branch: must not touch gnss-slsi"
[[ ! -e "$tmp/var/lib/omamobile/gnss-bringup-started" ]] || fail "7 Pro branch: no SPI5 node here, so no marker"
# The sleep inhibitor is the start's own (the unit's ExecStart is the plain script): the 7 Pro takes it at
# once, as its unit always did, and the 9a only around a session
grep -c '^inhibit --what=sleep --mode=block --who=Omarchy Mobile GNSS --why=A location session is running ' "$tmp/log" >/dev/null \
  || fail "7 Pro branch: the start runs under the sleep inhibitor"
[[ $(grep -c '^inhibit ' "$tmp/log") == 1 ]] || fail "7 Pro branch: the inhibitor is taken once"
printf 'google,zumapro-tegu\0google,zumapro\0' > "$tmp/dt/compatible"
: > "$tmp/log"; rm -f "$tmp/var/lib/omamobile/gnss-bringup-started"
run_start "$tmp/dt" "$tmp/unix"
[[ $(grep -n '^inhibit .* gnss-slsi start$' "$tmp/log" | cut -d: -f1) == 1 && $(grep -c '^chroot gnss-slsi start$' "$tmp/log") == 1 ]] \
  || fail "9a branch: the session runs under the sleep inhibitor"
rm -f "$tmp/var/lib/omamobile/gnss-bringup-started"
grep -c -x 'ExecStart=/usr/lib/omamobile-vendor/omamobile-gnss-start' vendor/systemd/system/omamobile-gnss.service >/dev/null \
  || fail "the unit starts the script itself, which takes the inhibitor"
echo "ok - the 7 Pro's start and the 9a's session hold the sleep inhibitor"
# gnssd not up yet when a client asks: the 9a's start waits for it while the modem unit brings it
# (OMAMOBILE_MODEM_GNSS=1), and otherwise holds the connection, looking for the modem, before giving up, so a
# client that reconnects at once can't run the unit into systemd's start limit. Neither holds the inhibitor,
# and a give-up leaves no marker.
cat > "$tmp/systemctl" <<'EOF'
#!/bin/bash
[[ -z ${FAKE_FILE:-} ]] || source "$FAKE_FILE"
case "$*" in
  *ActiveState*) echo "${FAKE_STATE:-inactive}" ;;
  *Environment*) echo "${FAKE_ENV:-}" ;;
esac
EOF
chmod +x "$tmp/systemctl"
export OMAMOBILE_GNSS_SYSTEMCTL=$tmp/systemctl
gave_up() { # $1 what: nothing started, nothing left, no inhibitor
  grep -c 'gnss-slsi start' "$tmp/log" >/dev/null && fail "$1: gnss-slsi started"
  grep -c '^inhibit ' "$tmp/log" >/dev/null && fail "$1: the sleep inhibitor was taken"
  [[ ! -e "$tmp/var/lib/omamobile/gnss-bringup-started" && ! -e "$tmp/run/omamobile-gnss/session" ]] || fail "$1: a give-up left a marker or a session"
}
: > "$tmp/log"; : > "$tmp/unix-late"; rm -f "$tmp/run/omamobile-gnss/session" "$tmp/run/omamobile-gnss/stop-request"
t0=$SECONDS
OMAMOBILE_GNSS_NOTHING_HOLD=2 OMAMOBILE_GNSS_GNSSD_WAIT=30 FAKE_STATE=inactive run_start "$tmp/dt" "$tmp/unix-late" || fail "no gnssd: the start fails"
(( SECONDS - t0 >= 2 )) || fail "no gnssd and none coming: the connection is held before giving up"
(( SECONDS - t0 < 8 )) || fail "no gnssd and none coming: the hold is NOTHING_HOLD, not the wait for a modem"
gave_up "no gnssd and no modem"
t0=$SECONDS
FAKE_STATE=inactive FAKE_ENV="OMAMOBILE_MODEM_GNSS=1" OMAMOBILE_GNSS_NOTHING_HOLD=0 OMAMOBILE_GNSS_GNSSD_WAIT=30 \
  run_start "$tmp/dt" "$tmp/unix-late" || fail "a stopped modem unit: the start fails"
(( SECONDS - t0 < 8 )) || fail "a modem unit that isn't running isn't waited for"
gave_up "a stopped modem unit"
t0=$SECONDS
FAKE_STATE=active FAKE_ENV="OMAMOBILE_MODEM_GNSS=0 X=1" OMAMOBILE_GNSS_NOTHING_HOLD=0 OMAMOBILE_GNSS_GNSSD_WAIT=30 \
  run_start "$tmp/dt" "$tmp/unix-late" || fail "a modem without GNSS: the start fails"
(( SECONDS - t0 < 8 )) || fail "a modem started without GNSS isn't waited for"
gave_up "a modem without GNSS"
t0=$SECONDS
FAKE_STATE=active FAKE_ENV="X=1 OMAMOBILE_MODEM_GNSS=1" OMAMOBILE_GNSS_NOTHING_HOLD=0 OMAMOBILE_GNSS_GNSSD_WAIT=2 \
  run_start "$tmp/dt" "$tmp/unix-late" || fail "gnssd never came: the start fails"
(( SECONDS - t0 >= 2 )) || fail "gnssd coming: the start waits for it"
gave_up "gnssd never came"
( sleep 1; printf '@GNSSND\n' > "$tmp/unix-late" ) &
t0=$SECONDS
FAKE_STATE=activating FAKE_ENV="OMAMOBILE_MODEM_GNSS=1" OMAMOBILE_GNSS_NOTHING_HOLD=0 OMAMOBILE_GNSS_GNSSD_WAIT=30 \
  run_start "$tmp/dt" "$tmp/unix-late" || fail "gnssd came late: the start fails"
wait
(( SECONDS - t0 < 10 )) || fail "gnssd came during the wait: the start goes on at once"
grep -c 'chroot gnss-slsi start' "$tmp/log" >/dev/null || fail "gnssd came during the wait: gnss-slsi starts"
[[ -e "$tmp/var/lib/omamobile/gnss-bringup-started" ]] || fail "gnssd came during the wait: the marker goes down with the session"
# the modem started during the hold: seen at the hold's next look (5 s), then waited for
rm -f "$tmp/var/lib/omamobile/gnss-bringup-started" "$tmp/run/omamobile-gnss/session"; : > "$tmp/log"; : > "$tmp/unix-late"
echo 'FAKE_STATE=inactive' > "$tmp/modem-state"
( sleep 2; printf 'FAKE_STATE=activating\nFAKE_ENV=OMAMOBILE_MODEM_GNSS=1\n' > "$tmp/modem-state"; sleep 5; printf '@GNSSND\n' > "$tmp/unix-late" ) &
t0=$SECONDS
FAKE_FILE=$tmp/modem-state OMAMOBILE_GNSS_NOTHING_HOLD=6 OMAMOBILE_GNSS_GNSSD_WAIT=30 \
  run_start "$tmp/dt" "$tmp/unix-late" || fail "the modem started during the hold: the start fails"
wait
grep -c 'chroot gnss-slsi start' "$tmp/log" >/dev/null || fail "the modem started during the hold: its gnssd is waited for past the hold"
(( SECONDS - t0 < 15 )) || fail "the modem started during the hold: the start goes on when gnssd listens"
unset OMAMOBILE_GNSS_SYSTEMCTL
rm -f "$tmp/var/lib/omamobile/gnss-bringup-started" "$tmp/run/omamobile-gnss/session"
echo "ok - a request before gnssd is up waits for it while the modem brings it, and without it holds, watching for the modem, before giving up"
# A marker left by a bring-up that never finished: the 9a skips GNSS, keeps the marker, and holds the
# connection first, so GeoClue's reconnects can't fail the socket and --retry's next request finds it listening
date -Is > "$tmp/var/lib/omamobile/gnss-bringup-started"
: > "$tmp/log"; t0=$SECONDS
OMAMOBILE_GNSS_NOTHING_HOLD=2 run_start "$tmp/dt" "$tmp/unix" || fail "a leftover marker: the start fails"
(( SECONDS - t0 >= 2 )) || fail "a leftover marker on the 9a: the connection is held before the skip"
grep -c 'gnss-slsi start' "$tmp/log" >/dev/null && fail "a leftover marker: gnss-slsi started"
grep -c '^inhibit ' "$tmp/log" >/dev/null && fail "a leftover marker: the sleep inhibitor was taken"
[[ -e "$tmp/var/lib/omamobile/gnss-bringup-started" ]] || fail "a leftover marker: the skip keeps it"
rm -f "$tmp/var/lib/omamobile/gnss-bringup-started"
echo "ok - a leftover marker skips GNSS on the 9a after holding the connection, and stays"
grep -c -x 'After=omamobile-tegu-modem.service' vendor/systemd/system/omamobile-gnss.service >/dev/null \
  || fail "the GNSS stack stops before the 9a's modem unit at shutdown"
grep -E '^(Requires|Wants|BindsTo)=.*omamobile-tegu-modem' vendor/systemd/system/omamobile-gnss.service \
  && fail "the GNSS stack must not pull the modem in"
echo "ok - at shutdown the GNSS stack stops before the 9a's modem, which it never starts"
# The client survives the bridge going first: SIGPIPE ignored around its spawn (inherited across exec), set
# after the HAL's spawn and back to default after the client's
order=$(awk '/^profile_start\(\)/ {p=1} p && /spawn hal / {print "hal"} p && /^  trap .. PIPE$/ {print "ignore"}
  p && /spawn client / && !c++ {print "client"} p && /^  trap - PIPE$/ {print "default"} p && /^}/ {exit}' profiles/gnss-slsi.conf | paste -sd' ')
[[ $order == "hal ignore client default" ]] \
  || fail "the 9a's profile ignores SIGPIPE for the client's spawn only: after the HAL's, default again after it (got: $order)"
echo "ok - the 9a's client outlives a bridge that stops first, so the stack's stop stays a clean one"
# The 9a's graceful stop: the client alone first, the stop-requested file written before its signal (the
# runner reads it when the client's exit wakes it), so the client can stop the receiver through the HAL
mkdir -p "$tmp/run-ps"
F=$tmp/run-ps/stop-requested bash -c 'sleep 30 & s=$!; trap "kill $s; [[ -e \$F ]] && exit 7; exit 9" TERM; wait $s' & fake=$!
sleep 0.3
out=$(STOP_REQUESTED="$tmp/run-ps/stop-requested" FAKE=$fake bash -c '
  say() { echo "say: $*"; }
  pgrep() { [[ $* == "-o -f ^/omamobile/bin/omamobile-gnss-client " ]] && echo "$FAKE"; }
  source <(awk "/^profile_stop\\(\\)/,/^}/" profiles/gnss-slsi.conf)
  profile_stop
  echo "returned"' 2>&1)
grep -c -x returned <<<"$out" >/dev/null || fail "profile_stop returns"
if kill -0 "$fake" 2>/dev/null; then
  kill -KILL "$fake" 2>/dev/null || true
  fail "profile_stop sends the client TERM"
fi
rc=0; wait "$fake" || rc=$?
(( rc != 9 )) || fail "profile_stop writes the stop-requested file before it signals the client"
(( rc == 7 )) || fail "profile_stop ends the client with TERM (its exit: $rc)"
out=$(STOP_REQUESTED="$tmp/run-ps/none" bash -c '
  say() { :; }; pgrep() { return 1; }
  source <(awk "/^profile_stop\\(\\)/,/^}/" profiles/gnss-slsi.conf)
  profile_stop; echo "returned"')
[[ $out == returned && ! -e $tmp/run-ps/none ]] || fail "no client: profile_stop writes nothing and returns"
# ...and the runner's own lines, run: a daemon that exits with the file there ends the profile quietly with
# 0, and without it as before ("a service exited", 1). setsid: its stop signals its whole process group.
awk '/^stop\(\) \{/,/^}/' lib/omamobile-vendor-chroot > "$tmp/runner-stop"
awk '/^  wait -n \|\| true$/ {p=1} p {print} p && /^  stop 1$/ {exit}' lib/omamobile-vendor-chroot > "$tmp/runner-tail"
[[ -s $tmp/runner-stop && $(grep -c . "$tmp/runner-tail") -ge 4 ]] || fail "the runner's stop and supervision lines are where the test reads them"
{ printf 'STOPPING=\nsay() { echo "say: $*"; }\n'; cat "$tmp/runner-stop"; printf 'sleep 30 &\nsleep 0.3 &\n'; cat "$tmp/runner-tail"; } > "$tmp/runner-harness"
rc=0; out=$(STOP_REQUESTED="$tmp/run-ps/stop-requested" setsid --wait bash "$tmp/runner-harness" 2>&1) || rc=$?
[[ $rc == 0 && $out == "say: stopping" ]] || fail "a requested stop: the runner stops the rest quietly with 0 (rc $rc: $out)"
rc=0; out=$(STOP_REQUESTED="$tmp/run-ps/none" setsid --wait bash "$tmp/runner-harness" 2>&1) || rc=$?
[[ $rc == 1 && $out == *"say: a service exited"* ]] || fail "no requested stop: a daemon's exit is still reported and ends with 1 (rc $rc: $out)"
grep -c 'rm -f "$NSPID" "$STOP_REQUESTED"' lib/omamobile-vendor-chroot >/dev/null || fail "a new start drops an old stop-requested file"
echo "ok - the 9a's stop ends the client first, through the HAL, and the runner calls that a clean stop"

rm -rf "$tmp"
echo "ok - the 9a's marker survives failed stops and clears only after a clean stop"
grep -c 'OMAMOBILE_GNSS_NMEA_OUT=fifo' lib/omamobile-gnss-start >/dev/null || fail "the 9a's NMEA goes to the FIFO"
grep -c 'gnss-slsi/data/vendor/gps/nmea_out' lib/omamobile-gnss-nmea >/dev/null || fail "the bridge reads the 9a's FIFO"
grep -c '^ConditionPathExists=|/usr/lib/omamobile-vendor/gnss-slsi/root$' vendor/systemd/system/omamobile-gnss.service >/dev/null || fail "the service runs with the 9a's image"
grep -c '^ExecStop=/usr/lib/omamobile-vendor/omamobile-gnss-start --stop$' vendor/systemd/system/omamobile-gnss.service >/dev/null || fail "stop picks the profile"
grep -qx '^ExecStopPost=/usr/lib/omamobile-vendor/omamobile-gnss-start --stopped$' vendor/systemd/system/omamobile-gnss.service || fail "post-stop checks the marker"
grep -c 'gnss-slsi/data/vendor/gps' vendor/systemd/system/omamobile-gnss-nmea.service >/dev/null || fail "the bridge may open the 9a's FIFO"
# --stop comes before the hang marker, so a leftover marker never skips a stop
[[ $(grep -n -- '--stop' lib/omamobile-gnss-start | head -1 | cut -d: -f1) -lt $(grep -n 'elif \[\[ -e \$MARK' lib/omamobile-gnss-start | cut -d: -f1) ]] || fail "--stop before the marker"
# A running stack keeps the phone awake (SUSPEND-PLAN 6.1).
grep -c '^INHIBIT=("${OMAMOBILE_GNSS_INHIBIT:-/usr/bin/systemd-inhibit}" --what=sleep --mode=block$' lib/omamobile-gnss-start >/dev/null \
  || fail "the stack holds a sleep inhibitor (block mode) while it runs"
# One GeoClue agent, ours (2026-11-02): geoclue's XDG autostart of its demo
# agent ran at login, our unit exited as a second instance and stayed
# inactive. The mask must carry the generator's escaped name, and our unit
# must stop an autostart agent a running session already has.
mask='app-geoclue\x2ddemo\x2dagent@autostart.service'
gen=/usr/lib/systemd/user-generators/systemd-xdg-autostart-generator
if [[ -x $gen ]]; then
  g=$(mktemp -d)
  mkdir -p "$g/xdg/autostart" "$g/out"
  printf '[Desktop Entry]\nName=Geoclue Demo agent\nExec=/bin/sh\nType=Application\n' > "$g/xdg/autostart/geoclue-demo-agent.desktop"
  XDG_CONFIG_HOME=$g/home XDG_CONFIG_DIRS=$g/xdg "$gen" "$g/out" "$g/out" "$g/out" 2>/dev/null
  [[ -f $g/out/$mask ]] || { ls "$g/out" >&2; rm -rf "$g"; fail "the autostart generator names the agent's unit differently"; }
  rm -rf "$g"
fi
grep -qF "ln -sfn /dev/null \"\$d/usr/lib/systemd/user/$mask\"" install || fail "the autostart agent's unit must be masked"
grep -qxF "ExecStartPre=-/usr/bin/systemctl --user stop ${mask//\\/\\\\}" vendor/systemd/user/omamobile-geoclue-agent.service ||
  fail "the agent unit must stop an autostart agent first (escaped once more for systemd's C escapes)"

# The bionic prebuilts are built on the computer with the Android toolchain
# and never committed; a checkout without them (CI) checks the rest only.
if [[ ! -f bionic/prebuilt/omamobile-fp-shim.so ]]; then
  echo "ok - the rest # SKIP no bionic prebuilts in this checkout (built on the computer)"
  exit 0
fi
# the 9a's HAL client is optional (built since 0.2.3): checked when present
c=bionic/prebuilt/omamobile-gnss-client; [[ -f $c ]] || c=
for f in bionic/prebuilt/omamobile-fp-shim.so $c \
         bionic/prebuilt/stubs/libomamobile-sitril-gps.so \
         bionic/prebuilt/stubs/libcom.android.tethering.connectivity_native.so; do
  [[ -f $f ]] || fail "$f missing: build it on the computer first (make -C bionic, see bionic/Makefile)"
  [[ $(head -c 20 "$f" | od -An -tx1 | tr -d ' \n') == 7f454c46020101* ]] || fail "$f is not a 64-bit ELF"
  [[ $(od -An -tx1 -j18 -N2 "$f" | tr -d ' \n') == b700 ]] || fail "$f is not aarch64"
done
stage=$(mktemp -d); trap 'rm -rf "$stage"' EXIT
./install "$stage"
for f in usr/bin/omamobile-gnss usr/lib/omamobile-vendor/omamobile-vendor-chroot \
         usr/lib/omamobile-vendor/omamobile-gnss-start usr/lib/omamobile-vendor/omamobile-gnss-nmea \
         usr/lib/omamobile-vendor/profiles/gnss.conf usr/lib/omamobile-vendor/gnss/props.conf \
         usr/lib/omamobile-vendor/omamobile-fp-shim.so \
         usr/lib/omamobile-vendor/stubs/libomamobile-sitril-gps.so \
         usr/lib/omamobile-vendor/stubs/libcom.android.tethering.connectivity_native.so \
         usr/lib/systemd/system/omamobile-gnss.service usr/lib/systemd/system/omamobile-gnss-nmea.socket \
         usr/lib/systemd/system/omamobile-gnss-nmea.service usr/lib/systemd/system/omamobile-gnss-force.service \
         usr/lib/systemd/system/omamobile-gnss-location@.service usr/lib/modprobe.d/omamobile-gnss.conf \
         usr/share/polkit-1/rules.d/50-omamobile-gnss.rules etc/geoclue/conf.d/90-omamobile-gnss.conf \
         usr/lib/systemd/user/omamobile-geoclue-agent.service \
         usr/lib/omamobile-vendor/omamobile-gnss-lto usr/lib/omamobile-vendor/omamobile-gnss-conf \
         usr/lib/systemd/system/omamobile-gnss-lto.service usr/lib/systemd/system/omamobile-gnss-lto.timer \
         etc/omamobile/gnss.conf; do
  [[ -e $stage/$f ]] || fail "not staged: $f"
done
[[ $(readlink "$stage/usr/lib/systemd/user/$mask") == /dev/null ]] || fail "the autostart agent's mask not staged"
# Default-off: nothing is enabled by a wants link, and the stack itself has no [Install].
[[ -z $(find "$stage" -path '*.wants/*') ]] || fail "something is enabled by default"
grep -q '^\[Install\]' vendor/systemd/system/omamobile-gnss.service && fail "omamobile-gnss.service must not be installable"
grep -q '^StopWhenUnneeded=yes' vendor/systemd/system/omamobile-gnss.service || fail "stack must stop when unneeded"
# GeoClue's demo where-am-i identifies itself as geoclue-where-am-i.
grep -q '^\[geoclue-where-am-i\]' etc/geoclue/conf.d/90-omamobile-gnss.conf || fail "where-am-i desktop id"
# status must not print "nono" (forced suffix only when forced)
grep -q 'forced/yes' bin/omamobile-gnss && fail "status forced suffix"
grep -q 'blacklist bcm4775x_gnss' vendor/modprobe.d/omamobile-gnss.conf || fail "driver must stay blacklisted from autoload"
# ExecStop runs before the stop signal, and the start script's --stop ends in
# the profile's own stop (gnss on the 7 Pro, gnss-slsi on the 9a), so gpsd's
# request is withdrawn before the chroot is killed.
grep -c '^ExecStop=/usr/lib/omamobile-vendor/omamobile-gnss-start --stop$' vendor/systemd/system/omamobile-gnss.service >/dev/null ||
  fail "the stack must stop the profile before the stop signal"
grep -c 'exec /usr/lib/omamobile-vendor/omamobile-vendor-chroot "\$profile" stop' lib/omamobile-gnss-start >/dev/null ||
  fail "--stop must end in the profile's stop"
grep -q 'omamobile-gnss-lto.timer\|LTO_TIMER' bin/omamobile-gnss || fail "the Location switch must handle the LTO timer"
grep -q 'etc/omamobile/gnss.conf' PKGBUILD || fail "gnss.conf must be a backup file"

# Settings: defaults, the file, the environment, and bad values refused.
conf() { # FILE-CONTENT [VAR=VALUE...] -> prints the GNSS_CONF_* values
  local c=$1; shift
  printf '%s\n' "$c" > "$stage/gnss.conf"
  env -i PATH="$PATH" OMAMOBILE_GNSS_CONF="$stage/gnss.conf" "$@" bash -c \
    'source lib/omamobile-gnss-conf; for v in ${!GNSS_CONF_@}; do echo "$v=${!v}"; done' 2>&1
}
out=$(conf "")
for want in GNSS_CONF_ASSISTANCE=1 GNSS_CONF_SUPL=0 GNSS_CONF_INJECT_TIME=1 GNSS_CONF_REF_POSITION= \
            GNSS_CONF_LTO_URL=http://gllto2.glpals.com/4day/v5/latest/lto2.dat; do
  grep -qx "$want" <<< "$out" || fail "default $want: $out"
done
# the shipped file must match the defaults: SUPL off, assistance on
out=$(env -i PATH="$PATH" OMAMOBILE_GNSS_CONF=etc/omamobile/gnss.conf bash -c \
  'source lib/omamobile-gnss-conf 2>&1; echo "S=$GNSS_CONF_SUPL A=$GNSS_CONF_ASSISTANCE P=$GNSS_CONF_REF_POSITION"')
[[ $out == "S=0 A=1 P=" ]] || fail "shipped gnss.conf: $out"
out=$(conf $'SUPL=1  # on\nREF_POSITION="52.52,13.40,30000"\nASSISTANCE=yes\nLTO_URL=http://x/\$(id)\nBOGUS=1')
grep -qx GNSS_CONF_SUPL=1 <<< "$out" || fail "SUPL=1 with a comment: $out"
grep -qx GNSS_CONF_REF_POSITION=52.52,13.40,30000 <<< "$out" || fail "quoted REF_POSITION: $out"
grep -qx GNSS_CONF_ASSISTANCE=1 <<< "$out" || fail "invalid ASSISTANCE must keep the default: $out"
grep -q 'ignoring LTO_URL' <<< "$out" || fail "LTO_URL with shell syntax must be refused: $out"
grep -q 'unknown setting BOGUS' <<< "$out" || fail "unknown keys must be reported: $out"
out=$(conf "SUPL=1" OMAMOBILE_GNSS_SUPL=0)
grep -qx GNSS_CONF_SUPL=0 <<< "$out" || fail "the environment must override the file: $out"

# The generated gps.xml, from the stock one when an extract is at hand
# (never committed: the user's own image).
image=
for i in "${OMAMOBILE_GNSS_IMAGE:-}" /usr/lib/omamobile-vendor/gnss/root "$HOME/android/vendor-chroot-work/gnss/root"; do
  [[ -n $i && -f $i/vendor/etc/gnss/gps.xml ]] && { image=$i; break; }
done
if [[ -n $image ]]; then
  gen() { # VAR=VALUE... -> generated config in $stage/gen
    rm -rf "$stage/gen"
    env -i PATH="$PATH" OMAMOBILE_GNSS_CONF=/dev/null "$@" bash -c '
      set -euo pipefail
      say() { echo "$*" >&2; }; die() { echo "die: $*" >&2; exit 1; }
      LIB=$PWD/lib; source profiles/gnss.conf; IMAGE=$1; gnss_config "$2"' _ "$image" "$stage/gen"
  }
  gen || fail "gnss_config failed with the defaults"
  x=$stage/gen/gps.xml
  grep -q 'SuplEnable="false"' "$x" || fail "default gps.xml must have SUPL off"
  grep -q 'RtoEnable="true"' "$x" || fail "default gps.xml must keep RTO"
  for k in EnableGlonass EnableGalileo EnableBeidou; do
    sed -n '/<gll_features/,/\/>/p' "$x" | grep -c "$k=\"true\"" >/dev/null || fail "$k not in <gll_features>"
  done
  grep -q 'MultiCarrRFMode="GL_MULTI_CARR_RF_MODE_L1_L5"' "$x" || fail "stock L1+L5 mode changed"
  if command -v xmllint >/dev/null; then xmllint --noout "$x" || fail "gps.xml not well-formed"; fi
  gen OMAMOBILE_GNSS_SUPL=1 OMAMOBILE_GNSS_SUPL_SERVER=supl.example.org:7276 OMAMOBILE_GNSS_ASSISTANCE=0 ||
    fail "gnss_config failed with SUPL on"
  grep -q 'SuplEnable="true"' "$x" && grep -q 'acSuplServer="supl.example.org"' "$x" &&
    grep -q 'SuplPort="7276"' "$x" || fail "SUPL=1 must keep SUPL on with the configured server"
  grep -q 'RtoEnable="false"' "$x" && grep -q 'RtiEnable="false"' "$x" || fail "ASSISTANCE=0 must turn RTO/RTI off"
else
  echo "omamobile-gnss: no vendor extract here; gps.xml generation not checked" >&2
fi
if command -v systemd-analyze >/dev/null; then
  SYSTEMD_LOG_LEVEL=err systemd-analyze verify --root="$stage" \
    "$stage"/usr/lib/systemd/system/omamobile-gnss*.service "$stage"/usr/lib/systemd/system/omamobile-gnss*.socket 2>&1 |
    grep -v -E 'Command .* is not executable|not found|ConditionPathExists' || true
fi
echo "omamobile-gnss: all checks passed"
