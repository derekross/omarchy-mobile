#!/bin/bash
# SPDX-License-Identifier: MIT
# omamobile-gnss: the phone's Location switch and GNSS status.
#
#   omamobile-gnss on       Location on: apps can ask GeoClue for positions,
#                           and the receiver runs only while one does
#                           (omamobile-gnss-nmea.socket, the GeoClue agent
#                           omamobile-geoclue-agent and the orbit download
#                           timer omamobile-gnss-lto.timer enabled)
#   omamobile-gnss off      Location off: stop the receiver now and let
#                           nothing start it
#   omamobile-gnss force    keep the receiver running with no client (tests,
#                           gpsd on /run/omamobile-gnss/nmea-tty)
#   omamobile-gnss unforce  back to on-demand
#   omamobile-gnss status [--json]
#
# Settings (assistance, time/position injection, SUPL): /etc/omamobile/gnss.conf.
#
# on/off/force/unforce need root. As another user they go through
# omamobile-gnss-location@.service, which polkit lets the active local user
# start (the shell's quick-settings tile uses exactly that), and on/off also
# start/stop the caller's own GeoClue agent right away.
set -euo pipefail

SOCKET=omamobile-gnss-nmea.socket
BRIDGE=omamobile-gnss-nmea.service
STACK=omamobile-gnss.service
FORCE=omamobile-gnss-force.service
AGENT=omamobile-geoclue-agent.service
LTO_TIMER=omamobile-gnss-lto.timer
LTO_FILE=/var/lib/omamobile-vendor/gnss/data/vendor/gps/lto2.dat
ROOT=/usr/lib/omamobile-vendor/gnss/root
# the Pixel 9a's image (gnss-slsi): no Broadcom orbit predictions there
[[ ! -d $ROOT && -d /usr/lib/omamobile-vendor/gnss-slsi/root ]] && ROOT=/usr/lib/omamobile-vendor/gnss-slsi/root

usage() {
  sed -n '3,17s/^# \{0,1\}//p' "$0" >&2
  exit 2
}

as_root() { # $1 action
  if [[ $EUID -ne 0 ]]; then
    systemctl start "omamobile-gnss-location@$1.service"
    case $1 in
      on) systemctl --user start "$AGENT" 2>/dev/null || true ;;
      off) systemctl --user stop "$AGENT" 2>/dev/null || true ;;
    esac
    exit 0
  fi
}

state() { systemctl "$1" "$2" 2>/dev/null || true; }

# The chip's power: the GNSS rails (world-readable, unlike debugfs). No
# vdd_gnss_core regulator means sec_acpm isn't loaded, so the rails are off.
powered() {
  local r
  for r in /sys/class/regulator/regulator.*; do
    [[ $(cat "$r/name" 2>/dev/null) == vdd_gnss_core ]] || continue
    [[ $(cat "$r/state" 2>/dev/null) == enabled ]] && echo yes || echo no
    return
  done
  echo no
}

# Age of the orbit predictions in hours; "unknown" when unreadable (the
# state directory is root's) and "none" when there is no file.
lto_age() {
  local t
  if [[ -e $LTO_FILE ]]; then
    t=$(stat -c %Y "$LTO_FILE" 2>/dev/null) || { echo unknown; return; }
    echo $(( ($(date +%s) - t) / 3600 ))
  elif [[ -r ${LTO_FILE%/*} ]]; then
    echo none
  else
    echo unknown
  fi
}

status() {
  local location running forced agent powered lto
  location=$([[ $(state is-enabled $SOCKET) == enabled ]] && echo on || echo off)
  running=$([[ $(state is-active $STACK) == active ]] && echo yes || echo no)
  forced=$([[ $(state is-active $FORCE) == active ]] && echo yes || echo no)
  agent=$([[ $(systemctl --global is-enabled $AGENT 2>/dev/null) == enabled ]] && echo on || echo off)
  powered=$(powered)
  lto=$(lto_age)
  if [[ ${1:-} == --json ]]; then
    printf '{"location":"%s","running":"%s","forced":"%s","powered":"%s","agent":"%s","lto_age_hours":"%s","installed":%s}\n' \
      "$location" "$running" "$forced" "$powered" "$agent" "$lto" "$([[ -d $ROOT ]] && echo true || echo false)"
  else
    echo "location: $location"
    echo "receiver running: $running$([[ $forced == yes ]] && echo " (forced)")"
    echo "chip powered: $powered"
    echo "GeoClue agent: $agent"
    case $lto in
      none|unknown) echo "orbit predictions (LTO): $lto" ;;
      *) echo "orbit predictions (LTO): ${lto} h old" ;;
    esac
    [[ -d $ROOT ]] || echo "vendor files: missing ($ROOT; tools/extract-vendor-chroot -p gnss, or -p gnss-slsi -d tegu)"
  fi
}

case ${1:-} in
  on)
    as_root on
    systemctl enable --now "$SOCKET"
    [[ $ROOT == */gnss/root ]] && systemctl enable --now "$LTO_TIMER"
    systemctl --global enable "$AGENT"
    ;;
  off)
    as_root off
    systemctl stop "$FORCE" "$BRIDGE" "$STACK" 2>/dev/null || true
    systemctl disable --now "$SOCKET" "$LTO_TIMER"
    systemctl --global disable "$AGENT"
    ;;
  force)
    as_root force
    systemctl start "$FORCE"
    ;;
  unforce)
    as_root unforce
    systemctl stop "$FORCE"
    ;;
  status) status "${2:-}" ;;
  *) usage ;;
esac
