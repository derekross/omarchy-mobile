pkgname=omamobile-remote
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Use an Omarchy Mobile phone over ssh like a person would: screenshots, keys, taps, scrolling, locking, unlocking, apps, keeping it awake during a test. Opt-in, enables nothing"
arch=(any)
url="https://github.com/derekross/omarchy-mobile"
license=(MIT)
depends=(bash coreutils gawk grim hyprland procps-ng sed util-linux wlrctl wtype)
optdepends=('openssh: reach the phone from a computer')

check() {
  "$startdir/test/all"
}

package() {
  "$startdir/install" "$pkgdir"
}
