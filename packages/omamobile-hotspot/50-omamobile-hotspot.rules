// The shell's Hotspot tile and page (through /etc/omamobile/hotspot-backend): let the active local user start and stop
// omamobile-hotspot.service, which runs "/usr/lib/omamobile-hotspot/hotspot-ap" as root. Nothing else.
// Starting opens DHCP, DNS and forwarding on ap0, so it asks for the user's PIN (kept for a few minutes);
// stopping only closes things, so it does not ask.
polkit.addRule(function(action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      subject.local && subject.active &&
      action.lookup("unit") == "omamobile-hotspot.service") {
    if (action.lookup("verb") == "start") return polkit.Result.AUTH_ADMIN_KEEP;
    if (action.lookup("verb") == "stop") return polkit.Result.YES;
  }
});
