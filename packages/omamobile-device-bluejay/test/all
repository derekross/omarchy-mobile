#!/bin/bash
# SPDX-License-Identifier: MIT
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

bash -n build || fail "build parses"
bash -n install || fail "install parses"
pass "scripts parse"

grep -q '\.\./\.\.' build install && fail "build or install reaches outside the package directory"
pass "build and install stay inside the package directory"

if [[ -f ../omamobile-device-cheetah/src/reboot-to.c ]]; then
  cmp -s src/reboot-to.c ../omamobile-device-cheetah/src/reboot-to.c \
    || fail "reboot-to.c drifted from the cheetah package"
  pass "reboot-to.c matches the cheetah source"
  cmp -s vendor/udev/rules.d/10-omamobile-storage.rules \
    ../omamobile-device-cheetah/vendor/udev/rules.d/10-omamobile-storage.rules \
    || fail "the storage rule drifted from the cheetah package"
  pass "the storage rule matches the cheetah package"
  cmp -s etc/omamobile-mirrorlist ../omamobile-device-cheetah/etc/omamobile-mirrorlist \
    || fail "the mirrorlist drifted from the cheetah package"
  pass "the mirrorlist matches the cheetah package"
  cmp -s <(sed -n '/^# --- the \[omamobile\] channel/,$p' omamobile-device-bluejay.install) \
    <(sed -n '/^# --- the \[omamobile\] channel/,$p' ../omamobile-device-cheetah/omamobile-device-cheetah.install) \
    || fail "the install script's channel handling drifted from the cheetah package"
  pass "the install script keeps the [omamobile] channel as the cheetah package does"
  cmp -s vendor/systemd/logind.conf.d/10-omamobile-power-key.conf \
    ../omamobile-device-cheetah/vendor/systemd/logind.conf.d/10-omamobile-power-key.conf \
    || fail "the power-key drop-in drifted from the cheetah package"
  pass "the power-key drop-in matches the cheetah package"
  cmp -s vendor/NetworkManager/conf.d/10-omamobile-usb.conf \
    ../omamobile-device-cheetah/vendor/NetworkManager/conf.d/10-omamobile-usb.conf \
    || fail "the NetworkManager drop-in drifted from the cheetah package"
  pass "the NetworkManager drop-in matches the cheetah package"
  cmp -s vendor/systemd/network/20-usb-gadget.network \
    ../omamobile-device-cheetah/vendor/systemd/network/20-usb-gadget.network \
    || fail "the usb0 network file drifted from the cheetah package"
  pass "the usb0 network file matches the cheetah package"
  cmp -s omamobile-device-bluejay.install \
    ../omamobile-device-cheetah/omamobile-device-cheetah.install \
    || fail "the pacman install script drifted from the cheetah package"
  pass "the pacman install script matches the cheetah package"
fi
if [[ -f ../omamobile-device-raven/vendor/systemd/sleep.conf.d/10-omamobile.conf ]]; then
  cmp -s vendor/systemd/sleep.conf.d/10-omamobile.conf \
    ../omamobile-device-raven/vendor/systemd/sleep.conf.d/10-omamobile.conf \
    || fail "the sleep drop-in drifted from the raven package"
  pass "the sleep drop-in matches the raven package (gs101)"
fi
grep -q 'omamobile-keyring' PKGBUILD || fail "pacman needs omamobile-keyring"
grep -q '^provides=(omamobile-device)$' PKGBUILD || fail "the package provides omamobile-device"
grep -q '^conflicts=(omamobile-device)$' PKGBUILD || fail "the package conflicts with every other device package"
grep -q '^install=omamobile-device-bluejay.install$' PKGBUILD \
  || fail "the pacman install script is not named"
[[ -f etc/omamobile-mirrorlist && -f omamobile-device-bluejay.install ]] \
  || fail "the pacman mirrorlist or install script is missing"
pass "pacman gets the keyring, the mirrorlist, the install script and the virtual device name"
if [[ -f ../../device/bluejay/device.conf ]]; then
  cmp -s device.conf ../../device/bluejay/device.conf \
    || fail "device.conf drifted from the descriptor"
  pass "device.conf matches the descriptor"
fi
grep -q '^PACKAGE=omamobile-device-bluejay$' device.conf || fail "the descriptor names this package"
grep -q '^COMPATIBLE="google,gs101-bluejay"$' device.conf || fail "the descriptor is bluejay's"
! grep -q '^SIMPLEFB_TRIG_CON=' device.conf || fail "the descriptor writes a display register before a booted 6a has read it"
! grep -q '^BRINGUP_PROBE=' device.conf || fail "the descriptor installs a register probe"
pass "the descriptor carries no register write and no probe"

./build "$tmp/build" || fail "reboot-to compiles"
[[ -x $tmp/build/reboot-to ]] || fail "reboot-to is not executable"
pass "reboot-to compiles"

./install "$tmp/root" "$tmp/build"
for f in usr/bin/reboot-to \
         usr/lib/udev/rules.d/10-omamobile-storage.rules \
         usr/lib/systemd/network/20-usb-gadget.network \
         usr/lib/systemd/logind.conf.d/10-omamobile-power-key.conf \
         usr/lib/systemd/sleep.conf.d/10-omamobile.conf \
         usr/lib/NetworkManager/conf.d/10-omamobile-usb.conf \
         usr/share/omamobile/device.conf \
         usr/share/omamobile/device-bluejay/version \
         usr/share/licenses/omamobile-device-bluejay/LICENSE \
         etc/pacman.d/omamobile-mirrorlist; do
  [[ -f $tmp/root/$f ]] || fail "install stages $f"
done
grep -q 'KERNEL=="sda", MODE="0000"' "$tmp/root/usr/lib/udev/rules.d/10-omamobile-storage.rules" \
  || fail "the whole-disk node is made inaccessible"
grep -q 'ID_PART_ENTRY_NAME}!="userdata"' "$tmp/root/usr/lib/udev/rules.d/10-omamobile-storage.rules" \
  || fail "userdata is the only partition desktop tools may see"
grep -q 'Address=172.16.42.1/24' "$tmp/root/usr/lib/systemd/network/20-usb-gadget.network" \
  || fail "usb0 keeps the initramfs address"
power="$tmp/root/usr/lib/systemd/logind.conf.d/10-omamobile-power-key.conf"
grep -qx '\[Login\]' "$power" \
  || fail "the power-key drop-in needs a [Login] header"
grep -q '^HandlePowerKey=ignore$' "$power" \
  || fail "a short press must not power the phone off"
grep -q '^HandlePowerKeyLongPress=ignore$' "$power" \
  || fail "the long press stays the PMIC reset"
sleep="$tmp/root/usr/lib/systemd/sleep.conf.d/10-omamobile.conf"
grep -qx '\[Sleep\]' "$sleep" || fail "the sleep drop-in needs a [Sleep] header"
grep -q '^MemorySleepMode=s2idle$' "$sleep" \
  || fail "suspend must be s2idle: gs101 never wakes from deep"
grep -q '^AllowHibernation=no$' "$sleep" || fail "there is no swap to hibernate to"
grep -q '^PACKAGE=omamobile-device-bluejay$' "$tmp/root/usr/share/omamobile/device.conf" \
  || fail "the installed descriptor is bluejay"
[[ ! -d $tmp/root/usr/lib/systemd/system ]] || fail "install ships a system unit"
[[ ! -d $tmp/root/usr/lib/modprobe.d ]] || fail "install ships a modprobe policy"
for absent in usr/bin/omamobile-boot-success usr/bin/omamobile-bootctl \
              usr/bin/omamobile-usb-rescue usr/bin/omamobile-wifi-start \
              usr/bin/omamobile-charge-guard usr/bin/omamobile-aoc-start \
              usr/bin/omamobile-camera-start \
              usr/lib/systemd/logind.conf.d/10-omamobile-lid.conf; do
  [[ ! -e $tmp/root/$absent ]] || fail "install includes $absent"
done
pass "install stages the udev rule, the USB link, the sleep and power-key policy and the mirrorlist, and nothing that marks a slot, loads a driver or starts hardware"

net=vendor/systemd/network/20-usb-gadget.network
! sed -n '/^\[Network\]/,/^\[/p' "$net" | grep -q '^Gateway=' || fail "usb0 sets no default route in [Network] (metric 0)"
metric=$(sed -n '/^\[Route\]/,/^\[/{s/^Metric=//p}' "$net")
[[ ${metric:-0} -gt 700 ]] || fail "usb0's gateway goes after Wi-Fi (600) and mobile data (700)"
pass "USB is the last gateway"
