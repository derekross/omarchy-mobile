# SPDX-License-Identifier: MIT
[Unit]
Description=Check Bluejay storage and development boot policy
Before=sddm.service

[Service]
Type=oneshot
ExecStart=/usr/bin/omamobile-bluejay-check
RemainAfterExit=yes
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
