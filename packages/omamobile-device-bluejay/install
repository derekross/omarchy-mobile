#!/bin/bash
# SPDX-License-Identifier: MIT
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
destination=${1:?Usage: ./install DESTDIR}
[[ $destination == /* && $destination != / ]] || { echo 'Use an absolute staging directory' >&2; exit 1; }
for file in bin/*; do install -Dm755 "$file" "$destination/usr/bin/${file##*/}"; done
while IFS= read -r -d '' file; do
  install -Dm644 "$file" "$destination/usr/lib/${file#vendor/}"
done < <(find vendor -type f -print0)
install -d "$destination/usr/lib/systemd/system" "$destination/usr/lib/systemd/system/multi-user.target.wants"
ln -s /dev/null "$destination/usr/lib/systemd/system/omamobile-boot-success.service"
ln -s ../omamobile-bluejay-check.service "$destination/usr/lib/systemd/system/multi-user.target.wants/omamobile-bluejay-check.service"
ln -s ../omamobile-bluejay-boot-ready.service "$destination/usr/lib/systemd/system/multi-user.target.wants/omamobile-bluejay-boot-ready.service"
install -Dm644 etc/boot-update.conf "$destination/etc/omamobile/boot-update.conf"
install -Dm644 etc/omamobile-mirrorlist "$destination/etc/pacman.d/omamobile-mirrorlist"
install -Dm644 uwsm/env.d/90-omamobile-bluejay-graphics "$destination/usr/share/uwsm/env.d/90-omamobile-bluejay-graphics"
install -Dm644 LICENSE "$destination/usr/share/licenses/omamobile-device-bluejay/LICENSE"
install -Dm644 version "$destination/usr/share/omamobile/device-bluejay/version"
