#!/bin/bash
# SPDX-License-Identifier: MIT
# Tests for omamobile-shell, from a copy of this directory alone.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }

for manifest in plugins/*/manifest.json; do
  python3 -c 'import json,sys; m=json.load(open(sys.argv[1])); assert m["id"].startswith("omamobile.")' "$manifest" \
    || fail "$manifest is valid JSON with an omamobile.* id"
done
pass "plugin manifests are valid"

python3 -c 'import json; json.load(open("profile/shell.json"))' || fail "profile/shell.json is valid JSON"
pass "phone profile is valid"

# Qt 6.12's QtQuick/Color shadows Omarchy's palette (omacom/omarchy#14553)
if grep -rnE '(^|[^.[:alnum:]_])Color\.' plugins --include=*.qml; then
  fail "palette references are qualified as Commons.Color"
fi
pass "palette references are qualified"

# Omarchy's palette has no Color.menu.selected (only selectedBackground,
# selectedText, selectedBorder); an `|| fallback` after it hid the miss.
if grep -rnE 'Color\.menu\.selected([^A-Za-z]|$)' plugins --include=*.qml; then
  fail "no references to the missing Color.menu.selected"
fi
pass "palette tokens exist"

# Readable text (TOUCH-PLAN 2.1): every plugin's Readable.js is the same
# file, and no plugin text uses Omarchy's 10 px caption without its floor.
first=
for js in plugins/*/Readable.js; do
  [[ -z $first ]] && first=$js
  cmp -s "$first" "$js" || fail "$js matches $first"
done
[[ -n $first ]] || fail "plugins carry Readable.js"
if command -v node >/dev/null; then
  node -e '
const R = require(require("path").resolve(process.argv[1]))
if (R.MIN_PX !== 12 || R.px(10) !== 12 || R.px(9) !== 12 || R.px(14) !== 14) throw new Error("Readable.px")
' "$first" || fail "Readable.px floors at 12 px"
fi
# AppTile.qml is left to PR #43, which sets its label to caption + 3.
if grep -rnE 'Style\.font\.caption' plugins --include=*.qml | grep -v 'Readable\.px(Style\.font\.caption' | grep -v 'omamobile.home/AppTile.qml:'; then
  fail "caption-sized text goes through Readable.px"
fi
for qml in $(grep -rl 'Readable\.px' plugins --include=*.qml); do
  grep -c '^import "Readable.js" as Readable$' "$qml" >/dev/null || fail "$qml imports Readable.js"
  [[ -f $(dirname "$qml")/Readable.js ]] || fail "$qml has Readable.js beside it"
done
pass "readable text sizes"

# Touch: a swipe that starts on a quick-settings tile mustn't toggle it
# (a passive TapHandler, not a MouseArea), and destructive actions take two
# taps (Clear all, quick-settings Reset, a widget's Remove).
grep -c 'gesturePolicy: TapHandler.DragThreshold' plugins/omamobile.quicksettings/Tile.qml >/dev/null || fail "tiles tap with a DragThreshold TapHandler"
[[ $(grep -c '^\s*MouseArea {' plugins/omamobile.quicksettings/Tile.qml) == 1 ]] || fail "the only MouseArea on a tile is the chevron's"
grep -c 'onTapped: bottomButton.modelData.action === "home" ? root.goHome() : root.clearAll()' plugins/omamobile.switcher/Switcher.qml >/dev/null || fail "Clear all asks first"
grep -c 'onTapped: root.requestReset()' plugins/omamobile.quicksettings/QuickSettings.qml >/dev/null || fail "quick-settings Reset asks first"
grep -c 'if (!settingsFlick.confirmRemove) { settingsFlick.confirmRemove = true; return }' plugins/omamobile.home/HomeSheets.qml >/dev/null || fail "a widget's Remove asks first"
pass "touch: tiles and two-tap destructive actions"

# QML has to parse; qmlformat is the Qt tool that fails on a syntax error
# without needing the shell's own imports to resolve.
qmlformat=$(command -v qmlformat || command -v /usr/lib/qt6/bin/qmlformat || true)
if [[ -n $qmlformat ]]; then
  for qml in plugins/*/*.qml plugins/omamobile.home/owl/*.qml; do
    "$qmlformat" "$qml" >/dev/null 2>&1 || fail "$qml parses"
  done
  pass "plugin QML parses"
else
  pass "plugin QML parses # SKIP no qmlformat"
fi

# Pure-JS models, under Node when it's there.
if command -v node >/dev/null; then
  for js in plugins/*/*.js; do
    node --check "$js" || fail "$js parses"
  done
  node test/wifi-model.js || fail "Wi-Fi model"
  node test/bluetooth-model.js || fail "Bluetooth model"
  node test/sensor-model.js || fail "fingerprint sensor model"
  node test/tiles-model.js || fail "quick-settings tile layout"
  node test/home-model.js || fail "home screen model"
  # Our OWL runtime's core: probes against the reference runtime's recorded
  # outputs, the resource caps, sh() quoting, and the phone's rules.
  node test/owl-core.js >/dev/null || { node test/owl-core.js | grep -v '^ok'; fail "OWL runtime core"; }
  pass "OWL runtime core"
else
  pass "Wi-Fi and Bluetooth models # SKIP no node"
fi

# The quick-settings tile scripts, against fake commands.
sh -n plugins/omamobile.quicksettings/tile-state.sh || fail "tile-state.sh parses"
sh -n plugins/omamobile.quicksettings/tile-action.sh || fail "tile-action.sh parses"
bash test/tile-scripts.sh || fail "quick-settings tile scripts"

# The Bluetooth pairing helper parses, and its pure parts work without D-Bus.
python3 -B -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' bin/omamobile-bt-agent || fail "omamobile-bt-agent parses"
python3 -B test/bt-agent.py || fail "omamobile-bt-agent helpers"

# The fingerprint enrollment helper likewise (fprintd over D-Bus).
python3 -B -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' bin/omamobile-fp-enroll || fail "omamobile-fp-enroll parses"
python3 -B test/fp-enroll.py || fail "omamobile-fp-enroll helpers"

# The Wi-Fi password and Bluetooth PINs go over D-Bus or a helper's stdin,
# never argv or the log.
if grep -nE 'console\.(log|info|warn|debug|error)\([^)]*(psk|password|secret|pin|passkey|codeField)' plugins/omamobile.quicksettings/*.qml; then
  fail "passwords and PINs are never logged"
fi
pass "passwords and PINs are never logged"

# The fingerprint target: the layer rule that lifts it above the lock must
# match the window's namespace, and stay render-only there (above_lock 1).
grep -c 'WlrLayershell.namespace: "omamobile-fingerprint"' plugins/omamobile.fingerprint/Fingerprint.qml >/dev/null \
  || fail "fingerprint target namespace"
grep -c 'namespace = "^omamobile-fingerprint\$" }, above_lock = 1' hypr/phone.lua >/dev/null \
  || fail "fingerprint target is drawn above the lock, without input"
python3 -c 'import json; assert {"id": "omamobile.fingerprint"} in json.load(open("profile/shell.json"))["plugins"]' \
  || fail "the phone profile enables the fingerprint target"
grep -c 'omamobile.fingerprint' plugins/omamobile.quicksettings/QuickSettings.qml >/dev/null \
  || fail "quick settings opens fingerprint setup"
pass "fingerprint target wiring"

# The on-screen keyboard watcher (squeekboard's sm.puri.OSK0 Visible).
python3 -B -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' bin/omamobile-osk-watch || fail "omamobile-osk-watch parses"
python3 -B -c '
import importlib.machinery, importlib.util
loader = importlib.machinery.SourceFileLoader("osk", "bin/omamobile-osk-watch")
spec = importlib.util.spec_from_loader("osk", loader); m = importlib.util.module_from_spec(spec); loader.exec_module(m)
assert m.line_for(True) == "visible true" and m.line_for(0) == "visible false"
assert m.NAME == "sm.puri.OSK0" and m.PATH == "/sm/puri/OSK0"
' || fail "omamobile-osk-watch lines"
grep -c "omamobile-osk-watch" plugins/omamobile.fingerprint/Fingerprint.qml >/dev/null || fail "the fingerprint plugin runs the keyboard watcher"
grep -c "omamobile-osk-watch" plugins/omamobile.keyboard/Keyboard.qml >/dev/null || fail "the keyboard button follows the watcher"
grep -c 'namespace = "^omamobile-osk-hide\$" }, above_lock = 2' hypr/phone.lua >/dev/null || fail "the hide button works over the lock"
python3 -c 'import json; assert {"id": "omamobile.keyboard"} in json.load(open("profile/shell.json"))["plugins"]' || fail "the profile enables the keyboard button"
pass "on-screen keyboard watcher"

# PIN or password: the choice is recorded per user, never the secret, and
# mirrored to Omarchy's credential-password toggle.
bash -n bin/omamobile-set-pin || fail "omamobile-set-pin parses"
fake=$(mktemp -d)
[[ $(HOME=$fake bash bin/omamobile-set-pin --type) == pin ]] || fail "a phone without a record counts as PIN"
mkdir -p "$fake/.config/omamobile"; echo password >"$fake/.config/omamobile/credential"
[[ $(HOME=$fake bash bin/omamobile-set-pin --type) == password ]] || fail "a password user reads as password"
rm -rf "$fake"
grep -c 'namespace = "^osk\$" }, above_lock = 2' hypr/phone.lua >/dev/null || fail "the on-screen keyboard works above the lock"
pass "PIN or password"

# Home screens: enabled for new and existing users, and the widget files the
# registry names exist (OWL built-ins run through OwlCell.qml).
python3 -c 'import json; assert {"id": "omamobile.home"} in json.load(open("profile/shell.json"))["plugins"]' \
  || fail "the phone profile enables the home screens"
grep -c 'add_plugin omamobile.home' bin/omamobile-setup-user >/dev/null || fail "existing users get the home screens"
if command -v node >/dev/null; then
  for type in $(node -e 'console.log(Object.keys(require("./plugins/omamobile.home/HomeModel.js").REGISTRY).filter((t) => !t.startsWith("owl:")).join(" "))'); do
    [[ -f plugins/omamobile.home/${type^}Widget.qml ]] || fail "widget $type has ${type^}Widget.qml"
  done
fi
pass "home screen wiring"

# The built-ins from omarchy-widgets are the OWL originals now (the
# omamobile-owl-widgets package): no QML ports are left, each built-in names
# its store widget, and the guide's MIT notice ships with the shell.
grep -c 'Copyright (c) 2026 Simon Schubert and contributors' widgets/LICENSE-owl-guide >/dev/null \
  || fail "the OWL guide's licence ships with the shell"
[[ ! -e plugins/omamobile.home/ported && ! -e plugins/omamobile.home/PortedWidget.qml ]] || fail "the QML ports are gone"
if command -v node >/dev/null; then
  node -e '
const H = require("./plugins/omamobile.home/HomeModel.js")
if (H.OWL_ORDER.length !== 47) throw new Error(H.OWL_ORDER.length + " OWL built-ins")
for (const t of H.OWL_ORDER) if (!/^owl:simonschubert\.[a-z0-9-]+$/.test(t) || H.owlStoreId(t) !== H.REGISTRY[t].credit) throw new Error(t)
' || fail "every old port has its OWL original as a built-in"
fi
pass "OWL built-ins"

# The weather widgets' position: locate.sh against a fake where-am-i.
bash -n plugins/omamobile.home/locate.sh || fail "locate.sh parses"
loc=$(mktemp -d)
printf '#!/bin/sh\nprintf "New location:\\nLatitude:    52.520008\\302\\260\\nLongitude:   -13.404954\\302\\260\\nAccuracy:    25000.000000 meters\\n"\n' >"$loc/wai"
printf '#!/bin/sh\necho "Failed to connect to GeoClue service"\n' >"$loc/none"
chmod +x "$loc/wai" "$loc/none"
[[ $(XDG_CACHE_HOME=$loc/c OMAMOBILE_WHERE_AM_I=$loc/wai bash plugins/omamobile.home/locate.sh) == '{"lat":52.52,"lon":-13.40,"accuracy":25000,"at":'* ]] \
  || fail "locate.sh rounds GeoClue's position to 0.01 degree"
[[ $(XDG_CACHE_HOME=$loc/c OMAMOBILE_WHERE_AM_I=$loc/none bash plugins/omamobile.home/locate.sh) == '{"lat":52.52,'* ]] \
  || fail "locate.sh answers from its cache"
rc=0; XDG_CACHE_HOME=$loc/d OMAMOBILE_WHERE_AM_I=$loc/none bash plugins/omamobile.home/locate.sh >/dev/null 2>&1 || rc=$?; [[ $rc == 3 ]] \
  || fail "locate.sh reports no position"
rc=0; XDG_CACHE_HOME=$loc/d OMAMOBILE_WHERE_AM_I=$loc/missing bash plugins/omamobile.home/locate.sh >/dev/null 2>&1 || rc=$?; [[ $rc == 2 ]] \
  || fail "locate.sh reports GeoClue missing"
rm -rf "$loc"
pass "weather location helper"

# The user's own widgets: the tool, its tests, and what ships with it.
python3 -B -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' bin/omamobile-widget || fail "omamobile-widget parses"
python3 -B test/widget-tool.py || fail "omamobile-widget"
for json in widgets/template/manifest.json widgets/examples/*/manifest.json; do
  python3 -c 'import json,sys; m=json.load(open(sys.argv[1])); assert "home-widget" in m["kinds"]' "$json" || fail "$json is a home-widget manifest"
done
if [[ -n $qmlformat ]]; then
  for qml in widgets/template/*.qml widgets/examples/*/*.qml; do
    "$qmlformat" "$qml" >/dev/null 2>&1 || fail "$qml parses"
  done
fi
if grep -rnE '(^|[^.[:alnum:]_])Color\.|"#[0-9a-fA-F]{3,8}"' widgets --include=*.qml; then
  fail "shipped widgets take colours from the theme"
fi
grep -c 'UserWidgetCell.qml' plugins/omamobile.home/Home.qml >/dev/null || fail "user widgets load through UserWidgetCell"
grep -c 'omarchy-agent-prompt' bin/omamobile-widget >/dev/null || fail "widgets are made with Omarchy's default agent"
pass "user widgets"

# One app per screen: every launch from the phone shell goes through
# omamobile-launch, which gives what it starts a new empty workspace by a
# per-launch Hyprland exec rule, or focuses the app's open window.
python3 -B -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' bin/omamobile-launch || fail "omamobile-launch parses"
python3 -B test/launch.py || fail "omamobile-launch"
# Nothing launches around it: not Omarchy's AppLibrary.launch, not Qt's
# openUrlExternally (a link opened wherever the browser was), not a bare
# gtk-launch or the agent prompt.
if grep -rnE 'appLibrary\.launch\(|openUrlExternally|"gtk-launch"|execArgv\(\["omarchy-agent-prompt"' plugins widgets --include=*.qml --include=*.js; then
  fail "every launch path goes through omamobile-launch"
fi
grep -c 'Quickshell.execDetached(LauncherModel.appArgv(entry.id))' plugins/omamobile.launcher/Launcher.qml >/dev/null || fail "the drawer launches through omamobile-launch"
grep -c 'Quickshell.execDetached(HomeModel.appLaunchArgv(entry.id))' plugins/omamobile.home/Home.qml >/dev/null || fail "home-screen apps launch through omamobile-launch"
grep -c 'tile.home.launch(tile.entry.app)' plugins/omamobile.home/AppTile.qml >/dev/null || fail "app tiles launch through the home screen"
grep -c 'Quickshell.execDetached(HomeModel.commandLaunchArgv(argv))' plugins/omamobile.home/WidgetHost.qml >/dev/null || fail "widgets' host.launch goes through omamobile-launch"
grep -c 'Quickshell.execDetached(HomeModel.urlLaunchArgv(text))' plugins/omamobile.home/WidgetHost.qml >/dev/null || fail "widgets' host.openUrl goes through omamobile-launch"
grep -c 'HomeModel.commandLaunchArgv(\["sh", "-c", tap\])' plugins/omamobile.home/CommandWidget.qml >/dev/null || fail "the text widget's tap goes through omamobile-launch"
grep -c '"omamobile-launch", "url", uri' bin/omamobile-nfc-open >/dev/null || fail "NFC links open through omamobile-launch"
grep -c '"omamobile-launch", "empty"' bin/omamobile-widget >/dev/null || fail "the widget agent's terminal gets an empty workspace"
grep -c '"omamobile-launch", "show-with"' plugins/omamobile.switcher/Switcher.qml >/dev/null || fail "the switcher shows apps together"
grep -c '"omamobile-launch", "own-screen"' plugins/omamobile.switcher/Switcher.qml >/dev/null || fail "the switcher moves apps to their own screen"
if command -v node >/dev/null; then
  node -e '
const L = require("./plugins/omamobile.launcher/LauncherModel.js")
const H = require("./plugins/omamobile.home/HomeModel.js")
const eq = (a, b) => { if (JSON.stringify(a) !== JSON.stringify(b)) throw new Error(JSON.stringify(a) + " != " + JSON.stringify(b)) }
eq(L.appArgv("org.telegram.desktop"), ["omamobile-launch", "app", "org.telegram.desktop"])
eq(L.promptArgv("  fix it  "), ["omamobile-launch", "cmd", "--", "omarchy-agent-prompt", "fix it"])
eq(H.appLaunchArgv("foot"), ["omamobile-launch", "app", "foot"])
eq(H.commandLaunchArgv(["a", 1]), ["omamobile-launch", "cmd", "--", "a", "1"])
eq(H.urlLaunchArgv("https://x"), ["omamobile-launch", "url", "https://x"])
' || fail "launch argv"
fi
pass "one app per screen"

# The update sheet (omamobile.update): enabled for new and existing users,
# Omarchy's Update > Omarchy opens it, its model works, its QML lints, and
# the PIN only ever goes to omamobile-update's stdin.
python3 -c 'import json; assert {"id": "omamobile.update"} in json.load(open("profile/shell.json"))["plugins"]' \
  || fail "the phone profile enables the update sheet"
grep -c 'add_plugin omamobile.update' bin/omamobile-setup-user >/dev/null || fail "existing users get the update sheet"
grep -c '"update.omarchy".*summon omamobile.update' bin/omamobile-setup-user >/dev/null || fail "Update > Omarchy opens the sheet"
grep -c '"update.firmware": {"when": "false"}' bin/omamobile-setup-user >/dev/null || fail "Update > Firmware is hidden"
if command -v node >/dev/null; then
  node test/update-model.js || fail "update sheet model"
fi
if grep -nE 'console\.(log|info|warn|debug|error)\([^)]*(pin|secret|password)' plugins/omamobile.update/*.qml; then
  fail "the PIN is never logged"
fi
grep -c 'startProc.write(startProc.secret + "\\n")' plugins/omamobile.update/Update.qml >/dev/null || fail "the PIN goes to stdin"
if grep -nE 'command: .*(secret|pinField)' plugins/omamobile.update/Update.qml; then fail "the PIN is never in argv"; fi
grep -c 'exclusionMode: ExclusionMode.Normal' plugins/omamobile.update/Update.qml >/dev/null || fail "the sheet stays above the on-screen keyboard"
python3 -B - <<'PY' || fail "the update sheet lints clean"
import importlib.machinery, importlib.util, os, sys
loader = importlib.machinery.SourceFileLoader("omamobile_widget", "bin/omamobile-widget")
spec = importlib.util.spec_from_loader("omamobile_widget", loader)
tool = importlib.util.module_from_spec(spec)
loader.exec_module(tool)
if not tool.qmllint_path() or not os.path.isdir(os.path.join(tool.OMARCHY_PATH, "shell")):
    print("ok - update sheet lint # SKIP no qmllint or Omarchy shell")
    sys.exit(0)
lint = tool.run_qmllint([os.path.abspath("plugins/omamobile.update/Update.qml")])
# Quickshell's own type metadata, the same for every plugin with a window or a Process
noise = ("is not creatable", "QProcess::ExitStatus")
bad = lint["errors"] + [w for w in lint["warnings"] if not any(n in w for n in noise)]
for line in bad:
    print("  " + line)
sys.exit(1 if bad else 0)
PY
pass "update sheet"

# The permission sheet: the portal Access backend (its pure parts, then the
# D-Bus service on a private bus against a fake omarchy-shell), the sheet's
# model, and the wiring that makes the portal pick it under Hyprland.
python3 -B -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' bin/omamobile-portal-access || fail "omamobile-portal-access parses"
if command -v dbus-run-session >/dev/null; then
  if ! out=$(dbus-run-session -- python3 -B test/portal-access.py 2>&1); then
    grep -v '^ok' <<<"$out" || true
    fail "omamobile-portal-access"
  fi
else
  python3 -B test/portal-access.py >/dev/null || fail "omamobile-portal-access helpers"
fi
if command -v node >/dev/null; then
  node test/access-model.js >/dev/null || fail "permission sheet model"
fi
# Calls: the model, the watcher against a fake agent on a private bus, the
# wiring, and (in the OWL container) offscreen shots.
if command -v node >/dev/null; then
  node test/call-model.js >/dev/null || { node test/call-model.js; fail "call card model"; }
fi
python3 -B -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' bin/omamobile-call-watch || fail "omamobile-call-watch parses"
if command -v dbus-run-session >/dev/null; then
  if ! out=$(dbus-run-session -- python3 -B test/call-watch.py 2>&1); then
    grep -v '^ok' <<<"$out" || true
    fail "omamobile-call-watch"
  fi
fi
python3 -c 'import json; assert {"id": "omamobile.call"} in json.load(open("profile/shell.json"))["plugins"]' \
  || fail "the profile turns calls on"
grep -c 'add_plugin omamobile.call' bin/omamobile-setup-user >/dev/null || fail "existing users get calls"
grep -c 'namespace = "\^omamobile-call(-top)?\$" }, above_lock = 2' hypr/phone.lua >/dev/null || fail "the call card works over the lock"
if grep -nE 'Dial|execDetached\(\["(sh|bash)' plugins/omamobile.call/*.qml plugins/omamobile.call/*.js | grep -v '^.*://' | grep -c . >/dev/null; then
  fail "the call card never dials or runs a shell"
fi
if [[ -n ${OMAMOBILE_CALL_RENDER:-} ]]; then
  bash test/call-render "$OMAMOBILE_CALL_RENDER" >/dev/null || fail "call card render"
fi
if command -v node >/dev/null; then
  node test/status-model.js >/dev/null || { node test/status-model.js; fail "status bar model"; }
fi
python3 -B -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' bin/omamobile-cell-watch || fail "omamobile-cell-watch parses"
if command -v dbus-run-session >/dev/null; then
  if ! out=$(dbus-run-session -- python3 -B test/cell-watch.py 2>&1); then
    grep -v '^ok' <<<"$out" || true
    fail "omamobile-cell-watch"
  fi
fi
grep -c 'function emergency()' plugins/omamobile.call/Call.qml >/dev/null || fail "the lock's Emergency call button has its warning"
grep -c "Emergency calls (911, 112) don't work on this phone yet. Keep another phone for emergencies." plugins/omamobile.call/EmergencyInfo.qml >/dev/null \
  || fail "the emergency warning keeps the plan's words (TELEPHONY-APPS-PLAN §3.2)"
pass "calls: model, watcher, wiring; the bar's network and call chip; the emergency warning"
python3 -c 'import json; assert {"id": "omamobile.access"} in json.load(open("profile/shell.json"))["plugins"]' \
  || fail "the phone profile enables the permission sheet"
grep -c 'add_plugin omamobile.access' bin/omamobile-setup-user >/dev/null || fail "existing users get the permission sheet"
grep -cx 'org.freedesktop.impl.portal.Access=omamobile;gtk' portal/hyprland-portals.conf >/dev/null || fail "Hyprland's portals.conf picks the sheet for Access only"
! grep -c '^default' portal/hyprland-portals.conf >/dev/null || fail "the override leaves the default portals alone"
grep -cx 'DBusName=org.freedesktop.impl.portal.desktop.omamobile' portal/omamobile.portal >/dev/null || fail "omamobile.portal names the service"
grep -cx 'BusName=org.freedesktop.impl.portal.desktop.omamobile' systemd/user/omamobile-portal-access.service >/dev/null || fail "the unit owns the bus name"
if grep -n 'above_lock' hypr/phone.lua | grep -c 'omamobile-access' >/dev/null; then fail "the permission sheet never shows over the lock"; fi
# Offscreen review shots in the OWL container only (test/access-render).
if [[ -n ${OMAMOBILE_ACCESS_RENDER:-} ]]; then
  bash test/access-render "$OMAMOBILE_ACCESS_RENDER" >/dev/null || fail "permission sheet render"
fi
pass "permission sheet"

bash -n bin/omamobile-setup-user || fail "omamobile-setup-user parses"
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
./install "$tmp/root"
[[ -x $tmp/root/usr/bin/omamobile-setup-user && -f $tmp/root/usr/share/omamobile/shell/profile/shell.json ]] \
  || fail "install stages the setup script and the profile"
[[ -f $tmp/root/usr/share/applications/omamobile-agent.desktop ]] || fail "install stages the AI Agent shortcut"
if command -v desktop-file-validate >/dev/null; then
  desktop-file-validate "$tmp/root/usr/share/applications/omamobile-agent.desktop" || fail "AI Agent desktop entry validates"
fi
[[ -x $tmp/root/usr/bin/omamobile-launch ]] || fail "install stages omamobile-launch"
# Updates reach users set up earlier: setup-user reruns at every login, and
# only for a user whose first run left the marker the unit waits for.
u=$tmp/root/usr/lib/systemd/user
[[ -f $u/omamobile-setup-user.service && $(readlink "$u/graphical-session-pre.target.wants/omamobile-setup-user.service") == ../omamobile-setup-user.service ]] \
  || fail "the setup-user unit is staged and enabled for every user"
marker=$(sed -n 's|^ConditionPathExists=%h/.local/state/omarchy/done/||p' systemd/user/omamobile-setup-user.service)
grep -c "omarchy-done ensure $marker\$\|omarchy-done ensure $marker;" bin/omamobile-setup-user >/dev/null || fail "the unit waits for a marker setup-user's first run leaves"
grep -cx 'ExecStart=/usr/bin/omamobile-setup-user' systemd/user/omamobile-setup-user.service >/dev/null || fail "the unit runs setup-user"
[[ -x $tmp/root/usr/bin/omamobile-setup-user ]] || fail "setup-user is installed where the unit runs it"
[[ -x $tmp/root/usr/bin/omamobile-portal-access && -f $tmp/root/usr/share/xdg-desktop-portal/portals/omamobile.portal \
   && -f $tmp/root/etc/xdg/xdg-desktop-portal/hyprland-portals.conf \
   && -f $tmp/root/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.omamobile.service \
   && -f $tmp/root/usr/lib/systemd/user/omamobile-portal-access.service \
   && -f $tmp/root/usr/share/omamobile/shell/plugins/omamobile.access/AccessSheet.qml ]] \
  || fail "install stages the permission sheet and its portal files"
[[ -x $tmp/root/usr/bin/omamobile-widget && -f $tmp/root/usr/share/omamobile/shell/WIDGETS.md \
   && -f $tmp/root/usr/share/omamobile/shell/widget-template/manifest.json \
   && -f $tmp/root/usr/share/omamobile/shell/widget-examples/countdown/Widget.qml ]] \
  || fail "install stages the widget tool, contract, template and examples"
[[ -f $tmp/root/usr/share/omamobile/shell/OWL.md ]] || fail "install stages the OWL guide"
grep -c 'Copyright (c) 2026 Simon Schubert and contributors' widgets/OWL.md >/dev/null || fail "the OWL guide keeps its copyright line"
grep -c 'd355bdb2789f7bd1023d88b17f8a2898dc0ffa2b' widgets/OWL.md >/dev/null || fail "the OWL guide names its source commit"
pass "install stages the package"

test/keys.sh || fail "omamobile-keys volume keys"
