# The app drawer's Updates entry opens the update sheet (omamobile.update)
u=$tmp/root/usr/share/applications/omamobile-update.desktop
[[ -f $u ]] && grep -c '^Exec=omarchy-shell shell summon omamobile.update "{}"$' "$u" >/dev/null &&
  grep -c '^Icon=software-updater$' "$u" >/dev/null && [[ -f plugins/omamobile.update/manifest.json ]] ||
  fail "install stages the Updates entry, which opens the update sheet"
if command -v desktop-file-validate >/dev/null; then
  desktop-file-validate "$u" || fail "Updates desktop entry validates"
fi
[[ -x $tmp/root/usr/bin/omamobile-launch ]] || fail "install stages omamobile-launch"
for layout in terminal/us.yaml terminal/us_wide.yaml us.yaml us_wide.yaml; do
  [[ -f $tmp/root/usr/share/omamobile/squeekboard/keyboards/$layout ]] || fail "install stages the $layout layout"
done
[[ -x $tmp/root/usr/bin/omamobile-keyboard-theme && -x $tmp/root/usr/share/omamobile/shell/hooks/theme-set-keyboard ]] \
  || fail "install stages the keyboard theme and its hook"
# Updates reach users set up earlier: setup-user reruns at every login, and
# only for a user whose first run left the marker the unit waits for.
u=$tmp/root/usr/lib/systemd/user
[[ -f $u/omamobile-setup-user.service && $(readlink "$u/graphical-session-pre.target.wants/omamobile-setup-user.service") == ../omamobile-setup-user.service ]] \
  || fail "the setup-user unit is staged and enabled for every user"
marker=$(sed -n 's|^ConditionPathExists=%h/.local/state/omarchy/done/||p' systemd/user/omamobile-setup-user.service)
grep -c "omarchy-done ensure $marker\$\|omarchy-done ensure $marker;" bin/omamobile-setup-user >/dev/null || fail "the unit waits for a marker setup-user's first run leaves"
grep -cx 'ExecStart=/usr/bin/omamobile-setup-user' systemd/user/omamobile-setup-user.service >/dev/null || fail "the unit runs setup-user"
[[ -x $tmp/root/usr/bin/omamobile-osk-guard && -f $u/omamobile-osk-guard.service &&
   $(readlink "$u/graphical-session.target.wants/omamobile-osk-guard.service") == ../omamobile-osk-guard.service ]] \
  || fail "the keyboard safety net is staged and enabled for every user's session"
# Sleep on screen-off: staged and running for every session, but off until
# the user's toggle (SUSPEND-PLAN 6.2): nothing in the package turns it on.
[[ -x $tmp/root/usr/bin/omamobile-sleepd && -f $u/omamobile-sleepd.service &&
   $(readlink "$u/graphical-session.target.wants/omamobile-sleepd.service") == ../omamobile-sleepd.service ]] \
  || fail "the sleep watcher is staged and runs for every user's session"
grep -cx 'ExecStart=/usr/bin/omamobile-sleepd' systemd/user/omamobile-sleepd.service >/dev/null || fail "the unit runs the watcher"
# The lock screen's weather: a timer for every session, a one-shot service.
[[ -x $tmp/root/usr/bin/omamobile-weather && -f $u/omamobile-weather.service && -f $u/omamobile-weather.timer &&
   $(readlink "$u/graphical-session.target.wants/omamobile-weather.timer") == ../omamobile-weather.timer ]] \
  || fail "the weather timer is staged and runs for every user's session"
grep -cx 'ExecStart=/usr/bin/omamobile-weather' systemd/user/omamobile-weather.service >/dev/null \
  && grep -cx 'Type=oneshot' systemd/user/omamobile-weather.service >/dev/null \
  && grep -cx 'OnCalendar=\*:00/30' systemd/user/omamobile-weather.timer >/dev/null \
  && grep -cx 'Unit=omamobile-weather.service' systemd/user/omamobile-weather.timer >/dev/null \
  || fail "the weather timer runs the one-shot service every 30 minutes"
pass "the lock screen's weather runs at login and every 30 minutes"
if grep -rnE '^[^#]*(omarchy-toggle omamobile-sleep( on| toggle|$)|toggles/omamobile-sleep)' bin install systemd plugins; then
  fail "nothing turns the omamobile-sleep toggle on by default"
fi
[[ -x $tmp/root/usr/bin/omamobile-setup-user ]] || fail "setup-user is installed where the unit runs it"
[[ -x $tmp/root/usr/bin/omamobile-portal-access && -f $tmp/root/usr/share/xdg-desktop-portal/portals/omamobile.portal \
   && -f $tmp/root/etc/xdg/xdg-desktop-portal/hyprland-portals.conf \
   && -f $tmp/root/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.omamobile.service \
   && -f $tmp/root/usr/lib/systemd/user/omamobile-portal-access.service \
   && -f $tmp/root/usr/share/omamobile/shell/plugins/omamobile.access/AccessSheet.qml ]] \
  || fail "install stages the permission sheet and its portal files"
[[ -x $tmp/root/usr/bin/omamobile-widget && -f $tmp/root/usr/share/omamobile/shell/WIDGETS.md \
   && -f $tmp/root/usr/share/omamobile/shell/widget-template/manifest.json \
   && -f $tmp/root/usr/share/omamobile/shell/widget-examples/countdown/Widget.qml ]] \
  || fail "install stages the widget tool, contract, template and examples"
[[ -f $tmp/root/usr/share/omamobile/shell/OWL.md ]] || fail "install stages the OWL guide"
grep -c 'Copyright (c) 2026 Simon Schubert and contributors' widgets/OWL.md >/dev/null || fail "the OWL guide keeps its copyright line"
grep -c 'd355bdb2789f7bd1023d88b17f8a2898dc0ffa2b' widgets/OWL.md >/dev/null || fail "the OWL guide names its source commit"
pass "install stages the package"

test/keys.sh || fail "omamobile-keys volume keys"
