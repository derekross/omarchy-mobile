python3 -B -c '
import importlib.machinery, importlib.util
loader = importlib.machinery.SourceFileLoader("osk", "bin/omamobile-osk-watch")
spec = importlib.util.spec_from_loader("osk", loader); m = importlib.util.module_from_spec(spec); loader.exec_module(m)
assert m.line_for(True) == "visible true" and m.line_for(0) == "visible false"
assert m.NAME == "sm.puri.OSK0" and m.PATH == "/sm/puri/OSK0"
' || fail "omamobile-osk-watch lines"
