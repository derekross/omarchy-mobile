#!/bin/bash
# SPDX-License-Identifier: MIT
# Tests for omamobile-shell, from a copy of this directory alone.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }

for manifest in plugins/*/manifest.json; do
  python3 -c 'import json,sys; m=json.load(open(sys.argv[1])); assert m["id"].startswith("omamobile.")' "$manifest" \
    || fail "$manifest is valid JSON with an omamobile.* id"
done
pass "plugin manifests are valid"

python3 -c 'import json; json.load(open("profile/shell.json"))' || fail "profile/shell.json is valid JSON"
pass "phone profile is valid"

# Qt 6.12's QtQuick/Color shadows Omarchy's palette (omacom/omarchy#14553)
if grep -rnE '(^|[^.[:alnum:]_])Color\.' plugins --include=*.qml; then
  fail "palette references are qualified as Commons.Color"
fi
pass "palette references are qualified"

# Omarchy's palette has no Color.menu.selected (only selectedBackground,
# selectedText, selectedBorder); an `|| fallback` after it hid the miss.
if grep -rnE 'Color\.menu\.selected([^A-Za-z]|$)' plugins --include=*.qml; then
  fail "no references to the missing Color.menu.selected"
fi
pass "palette tokens exist"

# Readable text (TOUCH-PLAN 2.1): every plugin's Readable.js is the same
# file, and no plugin text uses Omarchy's 10 px caption without its floor.
first=
for js in plugins/*/Readable.js; do
  [[ -z $first ]] && first=$js
  cmp -s "$first" "$js" || fail "$js matches $first"
done
[[ -n $first ]] || fail "plugins carry Readable.js"
if command -v node >/dev/null; then
  node -e '
const R = require(require("path").resolve(process.argv[1]))
if (R.MIN_PX !== 12 || R.px(10) !== 12 || R.px(9) !== 12 || R.px(14) !== 14) throw new Error("Readable.px")
' "$first" || fail "Readable.px floors at 12 px"
fi
# AppTile.qml is left to PR #43, which sets its label to caption + 3.
if grep -rnE 'Style\.font\.caption' plugins --include=*.qml | grep -v 'Readable\.px(Style\.font\.caption' | grep -v 'omamobile.home/AppTile.qml:'; then
  fail "caption-sized text goes through Readable.px"
fi
for qml in $(grep -rl 'Readable\.px' plugins --include=*.qml); do
  grep -c '^import "Readable.js" as Readable$' "$qml" >/dev/null || fail "$qml imports Readable.js"
  [[ -f $(dirname "$qml")/Readable.js ]] || fail "$qml has Readable.js beside it"
done
pass "readable text sizes"

# Touch: a swipe that starts on a quick-settings tile mustn't toggle it
# (a passive TapHandler, not a MouseArea), and destructive actions take two
# taps (Clear all, quick-settings Reset, a widget's Remove).
grep -c 'gesturePolicy: TapHandler.DragThreshold' plugins/omamobile.quicksettings/Tile.qml >/dev/null || fail "tiles tap with a DragThreshold TapHandler"
[[ $(grep -c '^\s*MouseArea {' plugins/omamobile.quicksettings/Tile.qml) == 1 ]] || fail "the only MouseArea on a tile is the chevron's"
grep -c 'onTapped: bottomButton.modelData.action === "home" ? root.goHome() : root.clearAll()' plugins/omamobile.switcher/Switcher.qml >/dev/null || fail "Clear all asks first"
grep -c 'onTapped: root.requestReset()' plugins/omamobile.quicksettings/QuickSettings.qml >/dev/null || fail "quick-settings Reset asks first"
grep -c 'if (!settingsFlick.confirmRemove) { settingsFlick.confirmRemove = true; return }' plugins/omamobile.home/HomeSheets.qml >/dev/null || fail "a widget's Remove asks first"
grep -c 'onTapped: root.requestClearNotifications()' plugins/omamobile.quicksettings/QuickSettings.qml >/dev/null || fail "the shade's Clear all asks first"
pass "touch: tiles and two-tap destructive actions"

# Touch navigation (TOUCH-PLAN 1.2, 1.7, 1.8, 1.10, 2.5).
# Back: edge strips that send Escape through Hyprland's own dispatcher, on
# for new and existing users, kept between the bar and the keyboard, and
# never over the lock.
b=plugins/omamobile.back/Back.qml
python3 -c 'import json; assert {"id": "omamobile.back"} in json.load(open("profile/shell.json"))["plugins"]' \
  || fail "the phone profile enables the back gesture"
grep -c 'add_plugin omamobile.back' bin/omamobile-setup-user >/dev/null || fail "existing users get the back gesture"
grep -c 'Quickshell.execDetached(BackModel.ESCAPE_ARGV)' "$b" >/dev/null || fail "back sends Escape through BackModel"
grep -c 'WlrLayershell.namespace: "omamobile-back"' "$b" >/dev/null || fail "back strips' namespace"
grep -c 'mask: Region { item: strip }' "$b" >/dev/null || fail "only the edge strip takes touches"
grep -c 'exclusionMode: ExclusionMode.Normal' "$b" >/dev/null || fail "back strips stay clear of the bar and the keyboard"
grep -c 'visible: !root.fullscreenOnScreen' "$b" >/dev/null || fail "back strips hide for fullscreen windows"
if grep -n 'omamobile-back' hypr/phone.lua | grep -c above_lock >/dev/null; then fail "back strips never work over the lock"; fi
if grep -nE 'wtype|ydotool' "$b" plugins/omamobile.back/BackModel.js; then fail "back uses Hyprland's dispatcher"; fi
# Home pill: a 44 px hit strip and a pill with an outline.
l=plugins/omamobile.launcher/Launcher.qml
grep -c 'implicitHeight: root.touch' "$l" >/dev/null || fail "the home pill's strip is a touch target tall"
grep -c 'border.color: Qt.rgba(0, 0, 0, 0.55)' "$l" >/dev/null || fail "the home pill has a dark outline"
# Under the keyboard, the pill has a strip of its own (Android's gesture
# bar): on the Bottom layer, reserving its height, so Hyprland lifts
# squeekboard (Top) above it and the strip covers no key. The masked strip
# over an app and the keyboard's strip never show together, and both go
# for a fullscreen window.
grep -c 'WlrLayershell.namespace: "omamobile-home-strip"' "$l" >/dev/null || fail "the keyboard's gesture strip has its namespace"
python3 - "$l" <<'PY' || fail "the keyboard's gesture strip sits under squeekboard"
import re, sys
src = open(sys.argv[1]).read()
def window(namespace):
    i = src.index('WlrLayershell.namespace: "%s"' % namespace)
    start = src.rindex("PanelWindow {", 0, i)
    depth, j = 0, src.index("{", start)
    while True:
        c = src[j]
        depth += c == "{"
        depth -= c == "}"
        j += 1
        if depth == 0:
            return src[start:j]
strip, pill = window("omamobile-home-strip"), window("omamobile-home-indicator")
assert "WlrLayershell.layer: WlrLayer.Bottom" in strip, "strip on the Bottom layer"
assert "exclusionMode: ExclusionMode.Auto" in strip, "strip reserves its height"
assert "implicitHeight: root.oskStripHeight" in strip
h = int(re.search(r"readonly property int oskStripHeight: (\d+)", src).group(1))
assert 24 <= h <= 36, h
vis = lambda w: re.search(r"^\s*visible: (.*)$", w, re.M).group(1)
assert "root.oskOpen" in vis(strip) and "!root.oskOpen" not in vis(strip), vis(strip)
assert "!root.oskOpen" in vis(pill), vis(pill)
for w in (strip, pill):
    assert "!root.fullscreenOnScreen" in vis(w) and "root.appOnScreen" in vis(w) and "!root.opened" in vis(w), vis(w)
assert "!root.sessionLocked" in vis(strip), "no strip under the lock's keyboard"
assert "mask: Region { item: hitArea }" in pill, "the pill over an app stays masked"
assert pill.count("HomeSwipe {") == 1 and strip.count("HomeSwipe {") == 1, "one swipe logic for both"
assert "HomePill" in strip and "HomePill" in pill
PY
grep -c 'if (!recents && swipeY < -24) root.goHome()' "$l" >/dev/null || fail "a short swipe goes home"
grep -c 'if (swipeY < -120) {' "$l" >/dev/null || fail "a long swipe opens recent apps"
# Drawer: pull down to close, and a pull is not also a tap on an app.
grep -c 'var close = root.pulling && root.pull > root.pullToClose' "$l" >/dev/null || fail "pulling the drawer down closes it"
grep -c 'onClicked: if (!root.pullMoved) cell.tapped()' "$l" >/dev/null || fail "a pull doesn't launch the app under it"
# Home: Undo after a remove; sheets keep the focused field in view, with
# their buttons pinned outside the Flickable.
h=plugins/omamobile.home
grep -c 'var next = HomeModel.restoreItem(layout, removed)' $h/Home.qml >/dev/null || fail "Undo restores the removed item"
grep -c 'onClicked: root.undoRemove()' $h/Home.qml >/dev/null || fail "the notice offers Undo"
[[ $(grep -c 'sheets.keepInView(settingsFlick)' $h/HomeSheets.qml) -ge 3 && $(grep -c 'sheets.keepInView(createFlick)' $h/HomeSheets.qml) -ge 3 ]] \
  || fail "the settings and create sheets scroll the focused field into view"
grep -c 'anchors.bottom: settingsFooter.top' $h/HomeSheets.qml >/dev/null || fail "Save and Remove are pinned under the settings"
grep -c 'anchors.bottom: createFooter.top' $h/HomeSheets.qml >/dev/null || fail "Create is pinned under its field"
pass "touch navigation: back, home pill, drawer pull, undo, fields in view"

# The notification shade, the Settings gear and the bar's unread count
# (TOUCH-PLAN 1.1, 1.3): Clear all goes through the notification service's
# IPC on this shell (dismissAll, then clear), the gear opens Omarchy's menu
# at its root, the shade reads the directories Omarchy's service writes, and
# the bar hears the shade's mark on the IPC target it serves.
qs=plugins/omamobile.quicksettings/QuickSettings.qml
grep -cF '"qs ipc -p \"$1\" call notifications dismissAll; qs ipc -p \"$1\" call notifications clear"' "$qs" >/dev/null || fail "Clear all dismisses the toasts, then clears the history"
grep -cF 'Quickshell.execDetached(["omarchy-menu", "summon", "root"])' "$qs" >/dev/null || fail "the gear opens Omarchy's root menu"
grep -cF '"/.local/state/omarchy/notifications"' "$qs" >/dev/null || fail "the shade reads Omarchy's notification files"
grep -cF '"/.local/state/omarchy/notifications/history"' plugins/omamobile.bar/Bar.qml >/dev/null || fail "the bar counts Omarchy's notification history"
grep -cF 'call omamobile.bar notificationsSeen' "$qs" >/dev/null || fail "the shade tells the bar what it has shown"
grep -cF 'function notificationsSeen(stamp: string): string' plugins/omamobile.bar/Bar.qml >/dev/null || fail "the bar serves notificationsSeen"
grep -cF '"/.local/state/omamobile/notifications-seen"' plugins/omamobile.bar/Bar.qml >/dev/null || fail "the bar reads the shade's mark at start"
grep -cF '"omarchy-shell", "shell", "summon", "omarchy.clipboard"' "$qs" >/dev/null || fail "the Clipboard tile opens Omarchy's clipboard history"
# A swipe on a row forgets that one notification through the service's
# forget call (omamobile-omarchy patch 0019), never by deleting its file
# behind the service; the row's swipe is sideways only and off while the
# list scrolls, and its tap is a DragThreshold TapHandler (no MouseArea,
# which would take the press from the swipe). test/shade-touch drives it.
row=plugins/omamobile.quicksettings/NotificationRow.qml
grep -cF 'call notifications forget \"$name\"' "$qs" >/dev/null || fail "a swiped row is forgotten through the service"
grep -cF 'delegate: NotificationRow {' "$qs" >/dev/null && grep -cF 'swipeEnabled: !shadeList.moving' "$qs" >/dev/null \
  || fail "the shade's rows are NotificationRow, not swiping while the list scrolls"
grep -cE 'rm +(-f +)?.*notifications' "$qs" "$row" >/dev/null && fail "the shade deletes no notification files itself"
grep -cF 'yAxis.enabled: false' "$row" >/dev/null || fail "a row swipes sideways only"
grep -cF 'gesturePolicy: TapHandler.DragThreshold' "$row" >/dev/null || fail "a row taps with a DragThreshold TapHandler"
grep -cE '^\s*MouseArea \{' "$row" >/dev/null && fail "no MouseArea on a row"
grep -cF 'NotificationsModel.swipeOutcome(' "$row" >/dev/null || fail "a row decides its swipe by swipeOutcome"
grep -cF "omamobile-omarchy>=" PKGBUILD >/dev/null || fail "omamobile-shell needs an omamobile-omarchy with forget"
# Qt 6.12 refuses to load a file that redeclares an Item's FINAL anchor
# lines (0.2.25's shade had "property real top", and quick settings didn't load).
if grep -nE 'property +[a-z]+ +(top|bottom|left|right|horizontalCenter|verticalCenter|baseline) *:' plugins/*/*.qml; then fail "no plugin redeclares an anchor line"; fi
pass "notification shade, Settings gear, unread count and Clipboard wiring"

# Quick settings on its side (TOUCH-PLAN 2.4): the sheet keeps to 58% of
# the width with the shade beside it, the tile columns follow the sheet's
# width, and a sheet taller than the screen scrolls above a pinned handle.
# test/quicksettings-render draws it in the OWL container.
grep -c 'readonly property bool wide: window.width > window.height' "$qs" >/dev/null || fail "quick settings knows a screen wider than tall"
grep -c 'readonly property int tileColumns: Math.max(2, Math.min(4, Math.floor(content.width / 180)))' "$qs" >/dev/null || fail "tile columns follow the sheet's width"
grep -c 'return Math.max(1, Math.ceil(most / tileColumns))' "$qs" >/dev/null || fail "the pager's rows follow the columns"
grep -c 'readonly property real shadeTop: root.wide ? sheet.y : sheet.y + sheet.height + Style.spacing.lg' "$qs" >/dev/null || fail "the shade sits beside the sheet on its side"
grep -c 'interactive: contentHeight > height + 1' "$qs" >/dev/null || fail "the sheet scrolls only when taller than the screen"
grep -c 'anchors.bottomMargin: sheet.contentBottomInset + sheet.handleRoom' "$qs" >/dev/null || fail "the handle stays under the scrolling part"
if [[ -n ${OMAMOBILE_QS_RENDER:-} ]]; then
  bash test/quicksettings-render "$OMAMOBILE_QS_RENDER" >/dev/null || fail "quick settings render"
fi
pass "quick settings on its side"

# QML has to parse; qmlformat is the Qt tool that fails on a syntax error
# without needing the shell's own imports to resolve. Qt 6's first: a Qt 5
# qmlformat on PATH (Arch's qt5-declarative) rejects Qt 6 syntax.
qmlformat=$(command -v /usr/lib/qt6/bin/qmlformat || command -v qmlformat6 || command -v qmlformat || true)
if [[ -n $qmlformat ]]; then
  for qml in plugins/*/*.qml plugins/omamobile.home/owl/*.qml; do
    "$qmlformat" "$qml" >/dev/null 2>&1 || fail "$qml parses"
  done
  pass "plugin QML parses"
else
  pass "plugin QML parses # SKIP no qmlformat"
fi

# Pure-JS models, under Node when it's there.
if command -v node >/dev/null; then
  for js in plugins/*/*.js; do
    node --check "$js" || fail "$js parses"
  done
  node test/wifi-model.js || fail "Wi-Fi model"
  node test/bluetooth-model.js || fail "Bluetooth model"
  node test/sensor-model.js || fail "fingerprint sensor model"
  node test/tiles-model.js || fail "quick-settings tile layout"
  node test/notifications-model.js >/dev/null || { node test/notifications-model.js; fail "notification shade model"; }
  node test/home-model.js || fail "home screen model"
  node test/back-model.js || fail "back gesture model"
  # Our OWL runtime's core: probes against the reference runtime's recorded
  # outputs, the resource caps, sh() quoting, and the phone's rules.
  node test/owl-core.js >/dev/null || { node test/owl-core.js | grep -v '^ok'; fail "OWL runtime core"; }
  pass "OWL runtime core"
else
  pass "Wi-Fi and Bluetooth models # SKIP no node"
fi

# The quick-settings tile scripts, against fake commands.
sh -n plugins/omamobile.quicksettings/tile-state.sh || fail "tile-state.sh parses"
sh -n plugins/omamobile.quicksettings/tile-action.sh || fail "tile-action.sh parses"
bash test/tile-scripts.sh || fail "quick-settings tile scripts"

# The Bluetooth pairing helper parses, and its pure parts work without D-Bus.
python3 -B -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' bin/omamobile-bt-agent || fail "omamobile-bt-agent parses"
python3 -B test/bt-agent.py || fail "omamobile-bt-agent helpers"

# The fingerprint enrollment helper likewise (fprintd over D-Bus).
python3 -B -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' bin/omamobile-fp-enroll || fail "omamobile-fp-enroll parses"
python3 -B test/fp-enroll.py || fail "omamobile-fp-enroll helpers"

# The Wi-Fi password and Bluetooth PINs go over D-Bus or a helper's stdin,
# never argv or the log.
if grep -nE 'console\.(log|info|warn|debug|error)\([^)]*(psk|password|secret|pin|passkey|codeField)' plugins/omamobile.quicksettings/*.qml; then
  fail "passwords and PINs are never logged"
fi
pass "passwords and PINs are never logged"

# The fingerprint target: the layer rule that lifts it above the lock must
# match the window's namespace, and stay render-only there (above_lock 1).
grep -c 'WlrLayershell.namespace: "omamobile-fingerprint"' plugins/omamobile.fingerprint/Fingerprint.qml >/dev/null \
  || fail "fingerprint target namespace"
grep -c 'namespace = "^omamobile-fingerprint\$" }, above_lock = 1' hypr/phone.lua >/dev/null \
  || fail "fingerprint target is drawn above the lock, without input"
python3 -c 'import json; assert {"id": "omamobile.fingerprint"} in json.load(open("profile/shell.json"))["plugins"]' \
  || fail "the phone profile enables the fingerprint target"
grep -c 'omamobile.fingerprint' plugins/omamobile.quicksettings/QuickSettings.qml >/dev/null \
  || fail "quick settings opens fingerprint setup"
pass "fingerprint target wiring"

# The on-screen keyboard watcher (squeekboard's sm.puri.OSK0 Visible).
python3 -B -c 'import ast,sys; ast.parse(open(sys.argv[1]).read())' bin/omamobile-osk-watch || fail "omamobile-osk-watch parses"
python3 -B -c '
import importlib.machinery, importlib.util
loader = importlib.machinery.SourceFileLoader("osk", "bin/omamobile-osk-watch")
spec = importlib.util.spec_from_loader("osk", loader); m = importlib.util.module_from_spec(spec); loader.exec_module(m)
assert m.line_for(True) == "visible true" and m.line_for(0) == "visible false"
assert m.NAME == "sm.puri.OSK0" and m.PATH == "/sm/puri/OSK0"
' || fail "omamobile-osk-watch lines"
grep -c "omamobile-osk-watch" plugins/omamobile.fingerprint/Fingerprint.qml >/dev/null || fail "the fingerprint plugin runs the keyboard watcher"
grep -c "omamobile-osk-watch" plugins/omamobile.keyboard/Keyboard.qml >/dev/null || fail "the keyboard button follows the watcher"
grep -c 'namespace = "^omamobile-osk-hide\$" }, above_lock = 2' hypr/phone.lua >/dev/null || fail "the hide button works over the lock"
python3 -c 'import json; assert {"id": "omamobile.keyboard"} in json.load(open("profile/shell.json"))["plugins"]' || fail "the profile enables the keyboard button"
pass "on-screen keyboard watcher"

# PIN or password: the choice is recorded per user, never the secret, and
# mirrored to Omarchy's credential-password toggle.
bash -n bin/omamobile-set-pin || fail "omamobile-set-pin parses"
fake=$(mktemp -d)
[[ $(HOME=$fake bash bin/omamobile-set-pin --type) == pin ]] || fail "a phone without a record counts as PIN"
mkdir -p "$fake/.config/omamobile"; echo password >"$fake/.config/omamobile/credential"
[[ $(HOME=$fake bash bin/omamobile-set-pin --type) == password ]] || fail "a password user reads as password"
rm -rf "$fake"
grep -c 'namespace = "^osk\$" }, above_lock = 2' hypr/phone.lua >/dev/null || fail "the on-screen keyboard works above the lock"
pass "PIN or password"

# Home screens: enabled for new and existing users, and the widget files the
# registry names exist (OWL built-ins run through OwlCell.qml).
python3 -c 'import json; assert {"id": "omamobile.home"} in json.load(open("profile/shell.json"))["plugins"]' \
  || fail "the phone profile enables the home screens"
grep -c 'add_plugin omamobile.home' bin/omamobile-setup-user >/dev/null || fail "existing users get the home screens"
if command -v node >/dev/null; then
  for type in $(node -e 'console.log(Object.keys(require("./plugins/omamobile.home/HomeModel.js").REGISTRY).filter((t) => !t.startsWith("owl:")).join(" "))'); do
    [[ -f plugins/omamobile.home/${type^}Widget.qml ]] || fail "widget $type has ${type^}Widget.qml"
  done
fi
pass "home screen wiring"

# Landscape (TOUCH-PLAN 2.4, #85): a page wider than tall shows the layout
# turned on its side (HomeModel.transposeLayout, tested in test/home-model.js),
# derived for the view and never saved; the OWL dp comes from the screen's
# shorter side, the catalog keeps the portrait cell height, and edit mode
# waits for portrait. test/home-render draws it in the OWL container.
home=plugins/omamobile.home/Home.qml
grep -c 'readonly property bool landscape: owlPageWidth > owlPagerHeight' "$home" >/dev/null || fail "the home knows a page wider than tall"
grep -c 'HomeModel.transposeLayout(layout, userCatalog, { portrait: \[owlShortSide, owlPortraitPagerHeight\], landscape: \[owlPageWidth, owlPagerHeight\] })' "$home" >/dev/null \
  || fail "the landscape view turns the layout with the pages' sizes"
grep -c 'OwlPhone.dpFor(landscape ? owlShortSide : owlPageWidth)' "$home" >/dev/null || fail "the OWL dp comes from the shorter side"
grep -c 'readonly property real owlCellHeight: owlPortraitPagerHeight / Math.max(1, layout.grid.rows)' "$home" >/dev/null || fail "the catalog keeps the portrait cell height"
grep -c 'editing = !!on && !landscape' "$home" >/dev/null || fail "edit mode waits for portrait"
if grep -nE 'commit\(.*viewLayout|setText\(.*viewLayout|serialize\(viewLayout' "$home"; then fail "the landscape view is never saved"; fi
for use in 'model: root.viewLayout.pages.length' 'readonly property int columns: root.viewLayout.grid.columns' 'readonly property var items: root.viewLayout.pages\[index\]'; do
  grep -c "$use" "$home" >/dev/null || fail "the pages draw the view layout ($use)"
done
if [[ -n ${OMAMOBILE_HOME_RENDER:-} ]]; then
  bash test/home-render "$OMAMOBILE_HOME_RENDER" >/dev/null || fail "home screen render"
fi
pass "home screens in landscape"

# The built-ins from omarchy-widgets are the OWL originals now (the
# omamobile-owl-widgets package): no QML ports are left, each built-in names
# its store widget, and the guide's MIT notice ships with the shell.
grep -c 'Copyright (c) 2026 Simon Schubert and contributors' widgets/LICENSE-owl-guide >/dev/null \
  || fail "the OWL guide's licence ships with the shell"
[[ ! -e plugins/omamobile.home/ported && ! -e plugins/omamobile.home/PortedWidget.qml ]] || fail "the QML ports are gone"
if command -v node >/dev/null; then
  node -e '
const H = require("./plugins/omamobile.home/HomeModel.js")
if (H.OWL_ORDER.length !== 47) throw new Error(H.OWL_ORDER.length + " OWL built-ins")
for (const t of H.OWL_ORDER) if (!/^owl:simonschubert\.[a-z0-9-]+$/.test(t) || H.owlStoreId(t) !== H.REGISTRY[t].credit) throw new Error(t)
' || fail "every old port has its OWL original as a built-in"
fi
pass "OWL built-ins"

# The weather widgets' position: locate.sh against a fake where-am-i.
bash -n plugins/omamobile.home/locate.sh || fail "locate.sh parses"
loc=$(mktemp -d)
printf '#!/bin/sh\nprintf "New location:\\nLatitude:    52.520008\\302\\260\\nLongitude:   -13.404954\\302\\260\\nAccuracy:    25000.000000 meters\\n"\n' >"$loc/wai"
printf '#!/bin/sh\necho "Failed to connect to GeoClue service"\n' >"$loc/none"
chmod +x "$loc/wai" "$loc/none"
[[ $(XDG_CACHE_HOME=$loc/c OMAMOBILE_WHERE_AM_I=$loc/wai bash plugins/omamobile.home/locate.sh) == '{"lat":52.52,"lon":-13.40,"accuracy":25000,"at":'* ]] \
  || fail "locate.sh rounds GeoClue's position to 0.01 degree"
[[ $(XDG_CACHE_HOME=$loc/c OMAMOBILE_WHERE_AM_I=$loc/none bash plugins/omamobile.home/locate.sh) == '{"lat":52.52,'* ]] \
  || fail "locate.sh answers from its cache"
rc=0; XDG_CACHE_HOME=$loc/d OMAMOBILE_WHERE_AM_I=$loc/none bash plugins/omamobile.home/locate.sh >/dev/null 2>&1 || rc=$?; [[ $rc == 3 ]] \
  || fail "locate.sh reports no position"
rc=0; XDG_CACHE_HOME=$loc/d OMAMOBILE_WHERE_AM_I=$loc/missing bash plugins/omamobile.home/locate.sh >/dev/null 2>&1 || rc=$?; [[ $rc == 2 ]] \
  || fail "locate.sh reports GeoClue missing"
rm -rf "$loc"
pass "weather location helper"

# The user's own widgets: the tool, its tests, and what ships with it.
