#!/bin/bash
# SPDX-License-Identifier: MIT
# Recent apps (omamobile.switcher) under touch, offscreen in qmltestrunner:
# Switcher.qml itself with Quickshell and Omarchy's modules stubbed
# (test/qml-stubs) and its layer-shell lines stripped, so its PanelWindow is
# a plain Window. No compositor, no Quickshell. Exits 77 without
# qmltestrunner. With OMAMOBILE_SWITCHER_SHOTS=DIR it also saves a picture of
# recent apps on its side (TOUCH-PLAN 2.4).
set -euo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
plugin=$here/../plugins/omamobile.switcher
runner=$(command -v qmltestrunner6 || command -v /usr/lib/qt6/bin/qmltestrunner || command -v qmltestrunner || true)
[[ -n $runner ]] || { echo "switcher-touch: no qmltestrunner" >&2; exit 77; }

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/switcher"
cp "$plugin/Readable.js" "$work/switcher/"
sed -E \
  -e '/^[[:space:]]*(WlrLayershell\.|exclusionMode:|anchors \{ top: true)/d' \
  -e 's/^([[:space:]]*)PanelWindow \{$/\1Window { width: 412; height: 892/' \
  "$plugin/Switcher.qml" > "$work/switcher/Switcher.qml"
grep -c 'Window { width: 412' "$work/switcher/Switcher.qml" >/dev/null || { echo "switcher-touch: no PanelWindow to stand in for" >&2; exit 1; }
# OMAMOBILE_SWITCHER_SHOTS: a directory to save the landscape picture in.
sed -e "s|property string shotDir: \"\"|property string shotDir: \"${OMAMOBILE_SWITCHER_SHOTS:-}\"|" "$here/switcher-touch.qml" > "$work/tst_switcher_touch.qml"

export QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software QML_DISABLE_DISK_CACHE=1
exec "$runner" -import "$here/qml-stubs" -input "$work/tst_switcher_touch.qml"
