#!/bin/bash
# SPDX-License-Identifier: MIT
# The shade's media card under touch, offscreen in qmltestrunner:
# MediaSource.qml and MediaCard.qml themselves, with Quickshell's Mpris and
# Omarchy's modules stubbed (test/qml-stubs) and made-up players. Which
# player shows, what each control calls, the seek bar, the card's tap and
# its accessible names. No compositor, no Quickshell, no session bus.
# Exits 77 without qmltestrunner.
set -euo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
plugin=$here/../plugins/omamobile.quicksettings
runner=$(command -v qmltestrunner6 || command -v /usr/lib/qt6/bin/qmltestrunner || command -v /usr/lib64/qt6/bin/qmltestrunner || command -v qmltestrunner || true)
[[ -n $runner ]] || { echo "media-touch: no qmltestrunner" >&2; exit 77; }

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/quicksettings"
cp "$plugin/MediaSource.qml" "$plugin/MediaCard.qml" "$plugin/MediaModel.js" "$plugin/Readable.js" "$work/quicksettings/"
cp "$here/media-touch.qml" "$work/tst_media_touch.qml"

export QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software QML_DISABLE_DISK_CACHE=1
exec "$runner" -import "$here/qml-stubs" -input "$work/tst_media_touch.qml"
