// SPDX-License-Identifier: MIT
import QtQuick
import QtTest

TestCase {
    id: root
    name: "OpenRefreshQueue"
    when: windowShown
    visible: true
    width: 100
    height: 100
    property bool opened: false
    property bool editing: false
    property var calls: []
    property var times: []
    function record(n) {
        calls = calls.concat([n]);
        times = times.concat([Date.now()]);
    }
    function refreshProbe() {
        record("probe");
    }
    function refreshDnd() {
        record("dnd");
    }
    function refreshNotifications() {
        record("notifications");
    }
    QtObject {
        id: brightness
        function refresh() {
            root.record("brightness");
        }
    }
    QtObject {
        id: torch
        function refresh() {
            root.record("torch");
        }
    }
    QtObject {
        id: rotationLock
        function refresh() {
            root.record("rotationLock");
        }
    }
    QtObject {
        id: location
        function refresh() {
            root.record("location");
        }
    }
    QtObject {
        id: nfc
        function refresh() {
            root.record("nfc");
        }
    }
    QtObject {
        id: fingerprint
        function refresh() {
            root.record("fingerprint");
        }
    }
    QtObject {
        id: keyboard
        function refresh() {
            root.record("keyboard");
        }
    }
    QtObject {
        id: clockFormatRead
        property bool running: false
        onRunningChanged: if (running) {
            root.record("clockFormat");
            running = false;
        }
    }
    QtObject {
        id: drag
        property bool pressed: false
    }
    QtObject {
        id: sheetFlick
        property bool moving: false
    }
    QtObject {
        id: pager
        property bool moving: false
    }
    QtObject {
        id: editFlick
        property bool moving: false
    }
    QtObject {
        id: shadeList
        property bool moving: false
    }
    property real reveal: 0
    NumberAnimation {
        id: revealAnimation
        target: root
        property: "reveal"
        from: 0
        to: 1
        duration: 100
    }
    SCHEDULER
    function init() {
        cancelOpenRefresh();
        revealAnimation.stop();
        opened = false;
        editing = false;
        drag.pressed = false;
        sheetFlick.moving = false;
        pager.moving = false;
        editFlick.moving = false;
        shadeList.moving = false;
        calls = [];
        times = [];
    }
    function test_settleAndSpacing() {
        revealAnimation.start();
        opened = true;
        scheduleOpenRefresh();
        wait(50);
        compare(calls.length, 0);
        tryCompare(revealAnimation, "running", false, 300);
        tryCompare(root, "openRefreshIndex", -1, 1500);
        compare(calls.join(","), "notifications,dnd,brightness,probe,torch,rotationLock,location,nfc,fingerprint,keyboard,clockFormat");
        for (var i = 1; i < times.length; i++)
            verify(times[i] - times[i - 1] >= 25);
    }
    function test_pauseAndResume() {
        opened = true;
        scheduleOpenRefresh();
        tryVerify(function () {
            return calls.length >= 1;
        }, 200);
        drag.pressed = true;
        var n = calls.length;
        wait(130);
        compare(calls.length, n);
        drag.pressed = false;
        tryCompare(root, "openRefreshIndex", -1, 1500);
        compare(calls.length, 11);
    }
    function test_cancelAndCoalesce() {
        opened = true;
        drag.pressed = true;
        scheduleOpenRefresh();
        scheduleOpenRefresh();
        compare(openRefreshIndex, 0);
        opened = false;
        drag.pressed = false;
        wait(150);
        compare(calls.length, 0);
        compare(openRefreshIndex, -1);
        opened = true;
        scheduleOpenRefresh();
        scheduleOpenRefresh();
        tryCompare(root, "openRefreshIndex", -1, 1500);
        compare(calls.length, 11);
    }
    function test_actionIsImmediate() {
        opened = true;
        drag.pressed = true;
        scheduleOpenRefresh();
        refreshDnd();
        compare(calls.join(","), "dnd");
        cancelOpenRefresh();
    }
    function test_firstScreenReadsAreFirst() {
        var started = Date.now();
        revealAnimation.start();
        opened = true;
        scheduleOpenRefresh();
        tryVerify(function () { return calls.length >= 3; }, 450);
        compare(calls.slice(0, 3).join(","), "notifications,dnd,brightness");
        verify(times[0] - started < 350);
        verify(times[0] - started >= 100);
        cancelOpenRefresh();
    }
    function test_editOpenDoesNotWaitForDone() {
        editing = true;
        revealAnimation.start();
        opened = true;
        scheduleOpenRefresh();
        tryVerify(function () { return calls.length >= 3; }, 450);
        compare(calls.slice(0, 3).join(","), "notifications,dnd,brightness");
        verify(editing);
        tryCompare(root, "openRefreshIndex", -1, 1500);
        compare(calls.length, 11);
    }
    function test_scrollGates() {
        opened = true;
        editFlick.moving = true;
        scheduleOpenRefresh();
        wait(70);
        compare(calls.length, 0);
        editFlick.moving = false;
        pager.moving = true;
        wait(70);
        compare(calls.length, 0);
        pager.moving = false;
        shadeList.moving = true;
        wait(70);
        compare(calls.length, 0);
        shadeList.moving = false;
        tryCompare(root, "openRefreshIndex", -1, 1500);
        compare(calls.length, 11);
    }
}
