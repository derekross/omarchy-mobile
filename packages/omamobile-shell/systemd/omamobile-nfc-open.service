# SPDX-License-Identifier: MIT
[Unit]
Description=Open web links from NFC tags in the user's browser
# Wants=, not Requires=: this service restarts neard, and with Requires= that
# restart would restart this service too, over and over.
Wants=neard.service
After=neard.service

[Service]
ExecStart=/usr/bin/omamobile-nfc-open
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
