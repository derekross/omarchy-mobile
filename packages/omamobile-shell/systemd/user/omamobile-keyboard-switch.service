# SPDX-License-Identifier: MIT
# Moves the on-screen keyboard to the layout a hardware keyboard switched to
# (the xkb grp: switch key runs no command). Enabled for every user by a
# vendor wants link; runs for the graphical session.
[Unit]
Description=Omarchy Mobile hardware keyboard layout follower
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/omamobile-keyboard-switch listen
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
