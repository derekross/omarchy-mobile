pkgname=omamobile-shell
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Omarchy Mobile's phone profile for the Omarchy shell: status bar, quick settings, launcher"
arch=(any)
url="https://github.com/derekross/omarchy-mobile"
license=(MIT GPL-3.0-or-later)  # GPL: the squeekboard layout
depends=(omarchy omamobile-apps 'omamobile-omarchy>=0.1.11' 'omamobile-owl-widgets>=0.1.2' bash squeekboard bluez wf-recorder python python-dbus python-gobject
         which  # voice input: voxtype finds wtype and wl-copy with which
         wtype  # the back gesture's Escape (a virtual keyboard: Hyprland's send_key_state
                # is answered "ok" and never reaches the app); voice input types with it too
         pipewire-audio pipewire-pulse pipewire-alsa wireplumber
         inotify-tools qt6-declarative
         iproute2 jq  # omamobile-sleepd: ss for SSH sessions; jq also for omamobile-keys
         # Both are in Omarchy's base package list, which root images install.
         dnsmasq  # the Hotspot tile: NetworkManager's shared mode hands out addresses with it
         foot xdg-terminal-exec  # guard for hand-built/partial installations
         xdg-desktop-portal-gnome)  # the file chooser (portal/hyprland-portals.conf)
checkdepends=(nodejs)  # test/weather.py runs HomeModel.js under node
optdepends=('fprintd: fingerprint setup and unlock (with omamobile-fingerprint)'
            'omamobile-voice: the speech model for voice input, so Voxtype works with no download (the root image has it)'
            'voxtype-bin: voice input (the root image has it; or Install > AI > Dictation)')
backup=(etc/xdg/xdg-desktop-portal/hyprland-portals.conf)
install=omamobile-shell.install

package() {
  "$startdir/install" "$pkgdir"
}

check() {
  "$startdir/test/all"
}
