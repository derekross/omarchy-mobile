#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omamobile-shell into DESTDIR. Never activates anything.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
destination=${1:?Usage: ./install DESTDIR}
[[ $destination == /* && $destination != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
for program in bin/*; do
  install -Dm755 "$program" "$destination/usr/bin/${program#bin/}"
done
while IFS= read -r -d '' file; do
  install -Dm644 "$file" "$destination/usr/share/omamobile/shell/$file"
done < <(find plugins profile hypr branding -type f -print0)
# Your own home-screen widgets: the contract, the template Create copies,
# and examples to copy (never loaded from here).
install -Dm644 widgets/WIDGETS.md "$destination/usr/share/omamobile/shell/WIDGETS.md"
# The OWL language guide (Simon Schubert, MIT, credited inside) for OWL widgets.
install -Dm644 widgets/OWL.md "$destination/usr/share/omamobile/shell/OWL.md"
while IFS= read -r -d '' file; do
  install -Dm644 "$file" "$destination/usr/share/omamobile/shell/widget-${file#widgets/}"
done < <(find widgets/template widgets/examples -type f -print0)
install -Dm644 environment.d/20-omamobile-osk.conf "$destination/usr/lib/environment.d/20-omamobile-osk.conf"
# squeekboard's terminal layout with an Esc key (GPL-3.0-or-later, from
# squeekboard); omamobile-setup-user links it into the user's data dir.
install -Dm644 squeekboard/keyboards/terminal/us.yaml "$destination/usr/share/omamobile/squeekboard/keyboards/terminal/us.yaml"
install -Dm644 systemd/omamobile-nfc-open.service "$destination/usr/lib/systemd/system/omamobile-nfc-open.service"
install -Dm644 systemd/user/omarchy-fcitx5-omamobile.conf "$destination/usr/lib/systemd/user/omarchy-fcitx5.service.d/omamobile.conf"
# The permission sheet: the portal's Access backend, its D-Bus activation and
# the portals.conf that picks it under Hyprland (omamobile.access shows it).
install -Dm644 portal/omamobile.portal "$destination/usr/share/xdg-desktop-portal/portals/omamobile.portal"
install -Dm644 portal/hyprland-portals.conf "$destination/etc/xdg/xdg-desktop-portal/hyprland-portals.conf"
install -Dm644 portal/org.freedesktop.impl.portal.desktop.omamobile.service \
  "$destination/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.omamobile.service"
install -Dm644 systemd/user/omamobile-portal-access.service "$destination/usr/lib/systemd/user/omamobile-portal-access.service"
# User setup at every login (new plugins and steps after an update), enabled
# for every user by a vendor wants link.
install -Dm644 systemd/user/omamobile-setup-user.service "$destination/usr/lib/systemd/user/omamobile-setup-user.service"
install -d "$destination/usr/lib/systemd/user/graphical-session-pre.target.wants"
ln -sfn ../omamobile-setup-user.service "$destination/usr/lib/systemd/user/graphical-session-pre.target.wants/omamobile-setup-user.service"
# The on-screen keyboard's safety net, for every user's graphical session.
install -Dm644 systemd/user/omamobile-osk-guard.service "$destination/usr/lib/systemd/user/omamobile-osk-guard.service"
install -d "$destination/usr/lib/systemd/user/graphical-session.target.wants"
ln -sfn ../omamobile-osk-guard.service "$destination/usr/lib/systemd/user/graphical-session.target.wants/omamobile-osk-guard.service"
# Sleep on screen-off, for every user's graphical session; it does nothing
# until the user turns the omamobile-sleep toggle on.
install -Dm644 systemd/user/omamobile-sleepd.service "$destination/usr/lib/systemd/user/omamobile-sleepd.service"
ln -sfn ../omamobile-sleepd.service "$destination/usr/lib/systemd/user/graphical-session.target.wants/omamobile-sleepd.service"
# The file chooser: xdg-desktop-portal-gnome on plain Wayland (its drop-in).
install -Dm644 systemd/user/xdg-desktop-portal-gnome-omamobile.conf \
  "$destination/usr/lib/systemd/user/xdg-desktop-portal-gnome.service.d/omamobile.conf"
install -Dm644 polkit/49-omamobile-admin-self.rules "$destination/usr/share/polkit-1/rules.d/49-omamobile-admin-self.rules"
install -Dm644 applications/omamobile-agent.desktop "$destination/usr/share/applications/omamobile-agent.desktop"
install -Dm644 applications/omamobile-open-intent.desktop "$destination/usr/share/applications/omamobile-open-intent.desktop"
install -Dm644 LICENSE "$destination/usr/share/licenses/omamobile-shell/LICENSE"
# OWL.md is Simon Schubert's OWL guide (MIT). The built-in widgets themselves
# come from omamobile-owl-widgets, which ships the store's licence.
install -Dm644 widgets/LICENSE-owl-guide "$destination/usr/share/licenses/omamobile-shell/LICENSE-owl-guide"
install -Dm644 version "$destination/usr/share/omamobile/shell/version"
