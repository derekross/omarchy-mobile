#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""The on-screen keyboard (squeekboard) in the applied Omarchy theme.

    omamobile-keyboard-theme              write the stylesheet from the theme
    omamobile-keyboard-theme --import     ...and add its @import to gtk.css
    omamobile-keyboard-theme --restart    ...and restart a running squeekboard
                                          when the stylesheet changed
    omamobile-keyboard-theme --print      print the stylesheet, write nothing

It reads the theme's colors.toml (~/.local/state/omarchy/current/theme/) and
Omarchy's monospace font (omarchy-font-current), and writes
~/.local/state/omamobile/keyboard.css. squeekboard loads its own stylesheet at
GTK's APPLICATION priority, and ~/.config/gtk-3.0/gtk.css (USER priority)
overrides it, so --import puts one line there:

    @import url("file:///home/<user>/.local/state/omamobile/keyboard.css"); /* omamobile-keyboard-theme */

at the top of the file, leaving the rest of a user's gtk.css alone. The
selectors (sq_view, sq_button) match only squeekboard's widgets, so other GTK
3 apps that read gtk.css are untouched.

GTK 3 reads gtk.css when a program starts, so a new theme reaches the
keyboard when squeekboard restarts: --restart does that, from Omarchy's
theme-set hook (hooks/theme-set-keyboard). The keyboard disappears for a
moment if it was up.

The look follows Omarchy's: square keys (Omarchy's default corners), the
theme's monospace font, letters on the theme's lighter background, modifier and
layout keys a step lighter, the accent on Enter and on a latched or locked
modifier (Ctrl held), and the action row (Talk, Ask, Paste, Emoji, Hide)
outlined: Talk in the theme's red (recording), Ask in its yellow (the
agent), the rest in its muted colour.
"""

import os
import shutil
import subprocess
import sys
import tomllib

MARK = "/* omamobile-keyboard-theme */"


def home():
    return os.path.expanduser("~")


def state_dir():
    return os.environ.get("XDG_STATE_HOME") or os.path.join(home(), ".local", "state")


def config_dir():
    return os.environ.get("XDG_CONFIG_HOME") or os.path.join(home(), ".config")


def colors_path():
    return os.environ.get("OMAMOBILE_KEYBOARD_COLORS") or os.path.join(
        state_dir(), "omarchy", "current", "theme", "colors.toml")


def css_path():
    return os.path.join(state_dir(), "omamobile", "keyboard.css")


def gtk_css_path():
    return os.path.join(config_dir(), "gtk-3.0", "gtk.css")


# ------------------------------------------------------------------ colours

def parse_hex(value):
    value = str(value).strip().lstrip("#")
    if len(value) == 3:
        value = "".join(c * 2 for c in value)
    if len(value) != 6:
        raise ValueError(value)
    return tuple(int(value[i:i + 2], 16) for i in (0, 2, 4))


def to_hex(rgb):
    return "#%02x%02x%02x" % tuple(max(0, min(255, round(c))) for c in rgb)


def mix(a, b, amount):
    """a moved toward b by amount (0..1), as GTK's mix()."""
    a, b = parse_hex(a), parse_hex(b)
    return to_hex(tuple(x + (y - x) * amount for x, y in zip(a, b)))


# Omarchy's colors.toml always has background, foreground and accent; the
# rest fall back to mixes of those.
def palette(colors):
    def pick(*names, default=None):
        for name in names:
            value = colors.get(name)
            if value:
                try:
                    return to_hex(parse_hex(value))
                except ValueError:
                    continue
        return default

    bg = pick("background", default="#1a1b26")
    fg = pick("foreground", default="#c0caf5")
    accent = pick("accent", "blue", default=fg)
    light = colors.get("mode") == "light"
    lighter = pick("lighter_background", default=mix(bg, fg, 0.08))
    darker = pick("dark_background", default=mix(bg, "#000000" if not light else "#ffffff", 0.2))
    p = {
        "base": darker,                       # behind the keys
        "key": lighter,                       # letters
        "special": mix(lighter, fg, 0.10),    # modifiers, layout keys
        "pressed": mix(lighter, fg, 0.28),
        "text": fg,
        "accent": accent,
        "on_accent": bg,
        "accent_pressed": mix(accent, bg, 0.25),
        "talk": pick("red", "bright_red", default=accent),
        "ask": pick("yellow", "orange", "bright_yellow", default=accent),
        "outline": pick("muted", "selection", default=mix(lighter, fg, 0.25)),
    }
    return p


# ------------------------------------------------------------------ font

def mono_font():
    font = os.environ.get("OMAMOBILE_KEYBOARD_FONT")
    if font is None:
        font = ""
        if shutil.which("omarchy-font-current"):
            try:
                font = subprocess.run(["omarchy-font-current"], capture_output=True, text=True,
                                      timeout=5).stdout.strip().splitlines()[0]
            except (subprocess.SubprocessError, OSError, IndexError):
                font = ""
    return font.replace('"', "").replace("\\", "").strip()


# ------------------------------------------------------------------ CSS

def stylesheet(colors, font, theme_name=""):
    p = palette(colors)
    family = ('"%s", monospace' % font) if font else "monospace"
    special = ", ".join("sq_button.%s" % c for c in (
        "special", "special-2", "special-3", "change-view", "change-view-2", "change-view-3",
        "altline", "wide", "action", "large", "small-row", "term-key", "term-narrow",
        "emoji-group", "character-group", "subtle-highlight", "subtle-highlight-2"))
    special_active = ", ".join(s + ":active" for s in special.split(", "))
    out = []
    w = out.append
    w("/* The on-screen keyboard in the Omarchy theme%s, written by" % (" " + theme_name if theme_name else ""))
    w("   omamobile-keyboard-theme (omamobile-shell). Rewritten at every theme")
    w("   change and login: edit the theme, not this file. */")
    w("")
    w("sq_view {")
    w("    background: %s;" % p["base"])
    w("    box-shadow: inset 0 2px 0 0 %s;" % p["accent"])
    w("    border: none;")
    w("}")
    w("")
    w("sq_button {")
    w("    color: %s;" % p["text"])
    w("    background: %s;" % p["key"])
    w("    border: none;")
    w("    border-radius: 0;")
    w("    box-shadow: none;")
    w("    font-family: %s;" % family)
    w("}")
    w("")
    w("sq_button:active {")
    w("    background: %s;" % p["pressed"])
    w("}")
    w("")
    w("%s {" % special)
    w("    background: %s;" % p["special"])
    w("    border: none;")
    w("}")
    w("")
    w("%s {" % special_active)
    w("    background: %s;" % p["pressed"])
    w("}")
    w("")
    w("sq_button.placeholder, sq_button.placeholder-2 {")
    w("    background: %s;" % p["base"])
    w("}")
    w("")
    w("/* A latched modifier (Ctrl held for the next key) and a locked one */")
    w("sq_button.latched, sq_button.locked {")
    w("    background: %s;" % p["accent"])
    w("    color: %s;" % p["on_accent"])
    w("    font-weight: bold;")
    w("}")
    w("")
    w("sq_button.locked {")
    w("    box-shadow: inset 0 -3px 0 0 %s;" % p["on_accent"])
    w("}")
    w("")
    w("#Return {")
    w("    background: %s;" % p["accent"])
    w("    color: %s;" % p["on_accent"])
    w("}")
    w("")
    w("#Return:active {")
    w("    background: %s;" % p["accent_pressed"])
    w("    color: %s;" % p["on_accent"])
    w("}")
    w("")
    w("/* The action row (terminal/us.yaml, us.yaml): outlined keys */")
    w("sq_button.talk, sq_button.ask, sq_button.paste, sq_button.emoji, sq_button.hide {")
    w("    background: %s;" % p["key"])
    w("    border: 2px solid %s;" % p["outline"])
    w("    color: %s;" % p["text"])
    w("}")
    w("")
    w("sq_button.talk {")
    w("    border-color: %s;" % p["talk"])
    w("    color: %s;" % p["talk"])
    w("}")
    w("")
    w("sq_button.ask {")
    w("    border-color: %s;" % p["ask"])
    w("    color: %s;" % p["ask"])
    w("}")
    w("")
    w("sq_button.talk:active {")
    w("    background: %s;" % p["talk"])
    w("    color: %s;" % p["on_accent"])
    w("}")
    w("")
    w("sq_button.ask:active {")
    w("    background: %s;" % p["ask"])
    w("    color: %s;" % p["on_accent"])
    w("}")
    w("")
    w("sq_button.paste:active, sq_button.emoji:active, sq_button.hide:active {")
    w("    background: %s;" % p["pressed"])
    w("}")
    w("")
    w("/* The short rows' labels (squeekboard's small-row is 0.575em) */")
    w("sq_button.term-key, sq_button.term-narrow, sq_button.talk, sq_button.ask, sq_button.paste {")
    w("    font-size: 0.6em;")
    w("}")
    w("")
    w("sq_button.emoji, sq_button.hide {")
    w("    font-size: 0.8em;")
    w("}")
    return "\n".join(out) + "\n"


def import_line(path):
    return '@import url("file://%s"); %s' % (path, MARK)


def ensure_import(css):
    """Put our @import at the top of gtk.css, once; keep everything else."""
    gtk = gtk_css_path()
    line = import_line(css)
    try:
        with open(gtk) as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        lines = []
    kept = [l for l in lines if MARK not in l]
    new = [line] + kept
    if new == lines:
        return False
    os.makedirs(os.path.dirname(gtk), exist_ok=True)
    with open(gtk + ".omamobile-new", "w") as f:
        f.write("\n".join(new) + "\n")
    os.replace(gtk + ".omamobile-new", gtk)
    return True


def write_if_changed(path, text):
    try:
        with open(path) as f:
            if f.read() == text:
                return False
    except FileNotFoundError:
        pass
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".new", "w") as f:
        f.write(text)
    os.replace(path + ".new", path)
    return True


def restart_squeekboard():
    """A running squeekboard reads gtk.css again only when it starts."""
    if subprocess.run(["pgrep", "-x", "squeekboard"], capture_output=True).returncode != 0:
        return False
    subprocess.run(["pkill", "-x", "squeekboard"], capture_output=True)
    for _ in range(30):
        if subprocess.run(["pgrep", "-x", "squeekboard"], capture_output=True).returncode != 0:
            break
        subprocess.run(["sleep", "0.1"])
    # As Omarchy's autostart starts it (o.launch_on_start: uwsm-app --)
    argv = ["uwsm-app", "--", "squeekboard"] if shutil.which("uwsm-app") else ["squeekboard"]
    subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    return True


def theme_name():
    try:
        with open(os.path.join(state_dir(), "omarchy", "current", "theme.name")) as f:
            return f.read().strip()
    except OSError:
        return ""


def main(argv):
    flags = set(argv[1:])
    unknown = flags - {"--import", "--restart", "--print"}
    if unknown:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 2
    try:
        with open(colors_path(), "rb") as f:
            colors = tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError) as e:
        print("omamobile-keyboard-theme: no theme colours (%s); squeekboard keeps its own look" % e,
              file=sys.stderr)
        colors = None
    if colors is None:
        return 0 if "--print" not in flags else 1
    text = stylesheet(colors, mono_font(), theme_name())
    if "--print" in flags:
        sys.stdout.write(text)
        return 0
    css = css_path()
    changed = write_if_changed(css, text)
    if "--import" in flags:
        changed = ensure_import(css) or changed
    if "--restart" in flags and changed:
        restart_squeekboard()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
