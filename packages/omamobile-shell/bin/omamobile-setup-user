#!/bin/bash
# SPDX-License-Identifier: MIT
# Omarchy Mobile's user setup: what a platform's "setup-user" step does in
# Omarchy's lifecycle contract (docs/lifecycle-dispatch.md upstream). Runs as
# the user. Each step runs once, tracked with Omarchy's own omarchy-done
# markers, so the user's later changes are never overwritten.
set -euo pipefail

# (test/setup-user.sh points both at the package's own tree and a scratch dir)
share=${OMAMOBILE_SHELL_SHARE:-/usr/share/omamobile/shell}
config=~/.config/omarchy

# A phone has no keyboard-first workflow: skip Omarchy's "Learn Keybindings"
# welcome (see patches/omarchy/0001-first-run-...patch).
omarchy-done mark welcome-keybindings-not-applicable

# Phone shell plugins: link them, so package updates reach the user
mkdir -p "$config/plugins"
for plugin in "$share"/plugins/omamobile.*; do
  ln -sfn "$plugin" "$config/plugins/$(basename "$plugin")"
done

# Phone shell profile (bar, quick settings, launcher), seeded once
if omarchy-done ensure omamobile-shell-profile; then
  cp "$share/profile/shell.json" "$config/shell.json"
fi

# Plugins added after a profile was seeded: switched on once each, in the
# user's shell.json (a user who removes one later keeps it off).
add_plugin() {
  python3 - "$config/shell.json" "$1" <<'PY'
import json, sys
path, plugin = sys.argv[1], sys.argv[2]
try:
    with open(path) as f:
        config = json.load(f)
except FileNotFoundError:
    sys.exit(0)
plugins = config.setdefault("plugins", [])
if not any(isinstance(p, dict) and p.get("id") == plugin for p in plugins):
    plugins.append({"id": plugin})
    with open(path + ".new", "w") as f:
        json.dump(config, f, indent=2)
        f.write("\n")
    import os
    os.replace(path + ".new", path)
PY
}
if omarchy-done ensure omamobile-fingerprint-plugin; then
  add_plugin omamobile.fingerprint
fi
if omarchy-done ensure omamobile-keyboard-plugin; then
  add_plugin omamobile.keyboard
fi
# Home screens (omamobile.home): pages of apps and widgets on the wallpaper.
if omarchy-done ensure omamobile-home-plugin; then
  add_plugin omamobile.home
fi

# Developer tools that packages pull in but a phone's app drawer shouldn't
# list (v4l-utils comes with ffmpeg): hidden for this user with the usual
# NoDisplay override in ~/.local/share/applications, which Omarchy's app
# library honours. Still runnable from a terminal.
sysapps=${OMAMOBILE_SYSTEM_APPLICATIONS:-/usr/share/applications}
apps="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
hide_app() {
  local id=$1 src=$sysapps/$1.desktop
  [[ -f $src && ! -e $apps/$id.desktop ]] || return 0
  mkdir -p "$apps"
  sed '/^\[Desktop Entry\]/a NoDisplay=true' "$src" | grep -v '^NoDisplay=false' > "$apps/$id.desktop"
}
if omarchy-done ensure omamobile-hide-dev-tools; then
  for id in qv4l2 qvidcap assistant designer linguist qdbusviewer; do
    hide_app "$id"
  done
fi

# Desktop and admin apps that don't fit a phone (TOUCH-PLAN 0.6, 3.4): Disks
# offers Format and Edit on the phone's UFS (the storage guard keeps it
# read-only, but it shouldn't be offered); Evince and Snapshot duplicate
# Papers and the Camera app; Fcitx 5's settings configure an input method
# the phone doesn't run; the rest are desktop tools. Omarchy's launcher.hides
# already covers some of these for its own launcher; the override hides them
# from any launcher. Each one once, when it is installed, so a user who
# removes the override keeps the app.
for id in org.gnome.DiskUtility org.gnome.Evince org.gnome.Snapshot fcitx5-configtool cmake-gui lstopo \
          cups system-config-printer foot-server footclient; do
  [[ -f $sysapps/$id.desktop ]] || continue
  if omarchy-done ensure "omamobile-hide-app-$id"; then
    hide_app "$id"
  fi
done

# PIN or password (omamobile-set-pin records it): phones set up before the
# choice existed used a PIN with the lock's number pad, so record that, once.
if omarchy-done ensure omamobile-credential-type; then
  if [[ ! -f ~/.config/omamobile/credential ]]; then
    mkdir -p ~/.config/omamobile
    echo pin >~/.config/omamobile/credential
  fi
fi

# Phone scale: 1440x3120 at 3 is 480x1040 logical, seeded once
if omarchy-done ensure omamobile-monitor-scale; then
  sed -i 's/^local omarchy_monitor_scale = .*/local omarchy_monitor_scale = 3/' ~/.config/hypr/monitors.lua
fi
# ...and GDK_SCALE to match (TOUCH-PLAN 2.8): at Omarchy's 2, X11 GTK apps
# (xwayland force_zero_scaling) drew at two thirds of the size of the rest.
# Once, for new and existing users, and only while the monitor scale is the
# phone's 3 and GDK_SCALE is still Omarchy's 2 (a user's own values stay).
if omarchy-done ensure omamobile-gdk-scale; then
  if grep -c '^local omarchy_monitor_scale = 3$' ~/.config/hypr/monitors.lua >/dev/null 2>&1; then
    sed -i 's/^local omarchy_gdk_scale = 2$/local omarchy_gdk_scale = 3/' ~/.config/hypr/monitors.lua
  fi
fi

# Touch phone: no pointer on screen (it still hides on touch if a USB mouse is
# attached and the user turns it back on). Added once to the user's override
# file, Omarchy's place for local Hyprland settings.
if omarchy-done ensure omamobile-hide-cursor; then
  cat >>~/.config/hypr/looknfeel.lua <<'LUA'

-- Omarchy Mobile: a touch phone shows no pointer
hl.config({ cursor = { invisible = true, hide_on_touch = true } })
LUA
fi

# On-screen keyboard: squeekboard shows itself when a text field takes focus
# (Hyprland relays text-input-v3 to its input-method-v2). Started from
# Omarchy's user autostart file, once.
if omarchy-done ensure omamobile-osk; then
  gsettings set org.gnome.desktop.a11y.applications screen-keyboard-enabled true
  cat >>~/.config/hypr/autostart.lua <<'LUA'

-- Omarchy Mobile: on-screen keyboard
o.launch_on_start("squeekboard")
LUA
fi

# Terminals get squeekboard's terminal layout (Tab, Ctrl, Alt, arrows); ours
# adds Esc to its top row, for vim and friends. squeekboard reads layouts only
# from the user's data dir, so link ours there unless the user has their own.
k=${XDG_DATA_HOME:-$HOME/.local/share}/squeekboard/keyboards/terminal
if [[ ! -e $k/us.yaml && ! -L $k/us.yaml ]]; then
  mkdir -p "$k"
  ln -s /usr/share/omamobile/squeekboard/keyboards/terminal/us.yaml "$k/us.yaml"
fi

# squeekboard needs Hyprland's input-method slot, which Omarchy's fcitx5 (run
# for desktop compose sequences) would otherwise take. The package's drop-in
# (omarchy-fcitx5.service.d/omamobile.conf) keeps fcitx5 from starting. Up to
# 0.1.48 this masked the unit instead, and Omarchy's first run, which enables
# it with `enable --now`, failed on the mask and re-ran (re-sending its "Update
# System" and welcome notifications) at every login: undo that mask, once.
if omarchy-done ensure omamobile-fcitx5-unmask; then
  if [[ $(readlink ~/.config/systemd/user/omarchy-fcitx5.service 2>/dev/null) == /dev/null ]]; then
    systemctl --user unmask omarchy-fcitx5.service
    systemctl --user daemon-reload
  fi
fi

# Suspend isn't supported on the phone's kernel yet: take it out of the system
# menu with Omarchy's own toggle (omarchy-toggle-suspend brings it back).
if omarchy-done ensure omamobile-suspend-off; then
  mkdir -p ~/.local/state/omarchy/toggles
  touch ~/.local/state/omarchy/toggles/suspend-off
fi

# Phone window rules (apps fill the screen instead of floating at desktop
# sizes), loaded after Omarchy's defaults from the user's override file, once.
if omarchy-done ensure omamobile-phone-rules; then
  cat >>~/.config/hypr/looknfeel.lua <<LUA

-- Omarchy Mobile: phone window rules
dofile("$share/hypr/phone.lua")
LUA
fi

# Chromium's first-run dialogs are desktop-sized: their buttons land off a
# phone screen (the "Additional Terms" page blocked a login). Skip them, once.
if omarchy-done ensure omamobile-chromium-no-first-run; then
  grep -qx -- --no-first-run ~/.config/chromium-flags.conf 2>/dev/null ||
    echo --no-first-run >>~/.config/chromium-flags.conf
fi

# Websites and web apps should get their phone versions. Sites choose by the
# user agent (desktop Chromium on Linux ignores --use-mobile-user-agent, and
# an explicit one also drops the desktop client hints). Once.
if omarchy-done ensure omamobile-chromium-mobile; then
  flags=~/.config/chromium-flags.conf
  major=$(chromium --version 2>/dev/null | grep -oE '[0-9]+' | head -1)
  [[ -f $flags ]] && sed -i -e '/^"\?--user-agent=/d' "$flags"
  # Quoted: the launcher splits each line on spaces otherwise.
  echo "\"--user-agent=Mozilla/5.0 (Linux; Android 14; Pixel 7 Pro) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/${major:-153}.0.0.0 Mobile Safari/537.36\"" >>"$flags"
fi

# Lock screen: Omarchy's lock with a number pad (lock-keypad toggle, see
# patches/omarchy/0003-*), since its session lock hides the on-screen keyboard.
if omarchy-done ensure omamobile-lock-keypad; then
  mkdir -p ~/.local/state/omarchy/toggles
  touch ~/.local/state/omarchy/toggles/lock-keypad
fi

# Chromium won't lay out narrower than about 500 px, wider than the phone's
# 480 px (at scale 3), so its window ran off the right edge. On Wayland its
# --force-device-scale-factor multiplies the output scale, so 0.83 gives about
# 550 px of layout width (2.5, the first try, made everything 2.5x bigger).
if omarchy-done ensure omamobile-chromium-scale-2; then
  if grep -q -- '^--force-device-scale-factor=' ~/.config/chromium-flags.conf 2>/dev/null; then
    sed -i 's/^--force-device-scale-factor=.*/--force-device-scale-factor=0.83/' ~/.config/chromium-flags.conf
  else
    echo --force-device-scale-factor=0.83 >>~/.config/chromium-flags.conf
  fi
fi

# The first version of the mobile step above also deleted the scale factor,
# so Chromium's window ran off the right edge again. Put it back, once.
if omarchy-done ensure omamobile-chromium-scale-3; then
  grep -q -- '^--force-device-scale-factor=' ~/.config/chromium-flags.conf 2>/dev/null ||
    echo --force-device-scale-factor=0.83 >>~/.config/chromium-flags.conf
fi

# Web text fields should raise the on-screen keyboard (TOUCH-PLAN 3.1): on
# Wayland, Chromium talks to an input method only with --enable-wayland-ime,
# and squeekboard gets text-input-v3 from Hyprland. Each flag once, unless the
# user's file already has it.
if omarchy-done ensure omamobile-chromium-wayland-ime; then
  for flag in --enable-wayland-ime --wayland-text-input-version=3; do
    grep -cx -- "$flag" ~/.config/chromium-flags.conf >/dev/null 2>&1 ||
      echo "$flag" >>~/.config/chromium-flags.conf
  done
fi

# Style > Unlock picks the look of the disk-encryption unlock screen. The phone
# has no encrypted disk, and the early boot logo follows the default theme, so
# hide it through Omarchy's menu extension file (reused id + failing "when").
if omarchy-done ensure omamobile-menu-hide-unlock; then
  extension=~/.config/omarchy/extensions/omarchy-menu.jsonc
  if [[ -f $extension ]] && ! grep -q '"style.unlock"' "$extension"; then
    sed -i '0,/^{/s//{\n  \/\/ Omarchy Mobile: no disk-unlock screen on the phone\n  "style.unlock": {"when": "false"},/' "$extension"
  fi
fi

# Omarchy's Setup > Security > Fingerprint looks for a USB reader and installs
# libfprint-git. On the phone it opens Omarchy Mobile's enrollment screen instead
# (omamobile.fingerprint, through fprintd), once, through the same menu
# extension file (a reused id replaces the entry).
if omarchy-done ensure omamobile-menu-fingerprint; then
  extension=~/.config/omarchy/extensions/omarchy-menu.jsonc
  mkdir -p "$(dirname "$extension")"
  [[ -s $extension ]] || printf '{\n}\n' >"$extension"
  if ! grep -q '"setup.security.fingerprint"' "$extension"; then
    sed -i '0,/^{/s//{\n  \/\/ Omarchy Mobile: fingerprint setup on the screen, through fprintd\n  "setup.security.fingerprint": {"icon": "\xf3\xb0\x88\xb7", "label": "Fingerprint", "when": "test -x \/usr\/lib\/omamobile-fp\/omamobile-fp-chroot", "action": "omarchy-shell shell summon omamobile.fingerprint '"'"'{\\"page\\":\\"enroll\\"}'"'"'"},/' "$extension"
  fi
fi

# Screensaver for a portrait phone: the wordmark stacked on two lines, in
# Omarchy's branding file, and a smaller terminal font so it fits (patch
# 0006 lets the screensaver use the user's foot config). Seeded once.
if omarchy-done ensure omamobile-screensaver; then
  install -Dm644 "$share/branding/screensaver.txt" ~/.config/omarchy/branding/screensaver.txt
  install -Dm644 "$share/branding/foot-screensaver.ini" ~/.config/foot/screensaver.ini
fi

# The terminal on a touch screen (TOUCH-PLAN 2.9): Omarchy's 14 px padding
# costs 28 of 480 px, its scrollback multiplier of 7 makes drag-scrolling
# jump, and a shorter long press starts a selection sooner. Once, in the
# user's own foot.ini (Omarchy seeds it), and only where a value is still
# Omarchy's: a value or [touch] section the user changed stays theirs.
foot=~/.config/foot/foot.ini
if [[ -f $foot ]] && omarchy-done ensure omamobile-foot-touch; then
  sed -i -e 's/^pad=14x14$/pad=6x6/' \
    -e '/^\[scrollback\]$/,/^\[/s/^multiplier=7\.0$/multiplier=3.0/' "$foot"
  if ! grep -c '^\[touch\]' "$foot" >/dev/null; then
    printf '\n[touch]\nlong-press-delay=300\n' >>"$foot"
  fi
fi

# Hermes is the one agent in Omarchy's Setup > Default Agent with no aarch64
# build (hermes-desktop isn't in the aarch64 repository): hide it there and
# under Install > AI, through the menu extension file. Once.
if omarchy-done ensure omamobile-menu-agents; then
  extension=~/.config/omarchy/extensions/omarchy-menu.jsonc
  mkdir -p "$(dirname "$extension")"
  [[ -s $extension ]] || printf '{\n}\n' >"$extension"
  if ! grep -q '"setup.default.agent.hermes"' "$extension"; then
    sed -i '0,/^{/s//{\n  \/\/ Omarchy Mobile: no aarch64 build of Hermes\n  "setup.default.agent.hermes": {"when": "false"},\n  "install.ai.hermes": {"when": "false"},/' "$extension"
  fi
fi

# System > PIN sets or changes the phone's PIN (omamobile-set-pin), through
# Omarchy's menu extension file. Added once.
if omarchy-done ensure omamobile-menu-pin; then
  extension=~/.config/omarchy/extensions/omarchy-menu.jsonc
  if [[ -f $extension ]] && ! grep -q '"system.pin"' "$extension"; then
    sed -i '0,/^{/s//{\n  "system.pin": {"icon":"󰌾","label":"PIN","description":"Set or change the PIN that unlocks this phone","action":"omamobile-set-pin"},/' "$extension"
  fi
fi

# The phone's update sheet (omamobile.update, running omamobile-update from
# omamobile-omarchy) in place of Omarchy's terminal update: the plugin, once,
# and Update > Omarchy in Omarchy's menu opening it, through the menu
# extension file. Update > Firmware (fwupd) and Update > Config > Plymouth
# (an initramfs rebuild) are hidden: the phone boots from boot_b, which
# bin/omamobile push writes, and its firmware is Google's.
if omarchy-done ensure omamobile-update-plugin; then
  add_plugin omamobile.update
fi
# The permission sheet (omamobile.access): the question xdg-desktop-portal
# asks before an app first uses the camera or the location, shown by
# omamobile-portal-access in place of GTK's desktop dialog.
if omarchy-done ensure omamobile-access-plugin; then
  add_plugin omamobile.access
fi
# Calls (omamobile.call): incoming calls over the lock, a heads-up card when
# unlocked and the in-call controls, from omatel's agent when it runs.
if omarchy-done ensure omamobile-call-plugin; then
  add_plugin omamobile.call
fi
# The back gesture (omamobile.back): swipe in from a side edge for Escape.
if omarchy-done ensure omamobile-back-plugin; then
  add_plugin omamobile.back
fi
# The setup sheet (omamobile.onboarding, TOUCH-PLAN 1.11): the first run's
# questions and System > PIN as sheets; omamobile-onboarding and
# omamobile-set-pin open it when the shell has it, the terminal otherwise.
if omarchy-done ensure omamobile-onboarding-plugin; then
  add_plugin omamobile.onboarding
fi
if omarchy-done ensure omamobile-menu-update; then
  extension=~/.config/omarchy/extensions/omarchy-menu.jsonc
  mkdir -p "$(dirname "$extension")"
  [[ -s $extension ]] || printf '{\n}\n' >"$extension"
  if ! grep -q '"update.omarchy"' "$extension"; then
    sed -i '0,/^{/s//{\n  \/\/ Omarchy Mobile: updates through the phone'"'"'s update sheet; no fwupd or Plymouth rebuilds\n  "update.omarchy": {"icon": "\xee\xa4\x80", "iconFont": "omarchy", "label": "Omarchy", "action": "omarchy-shell shell summon omamobile.update '"'"'{}'"'"'"},\n  "update.firmware": {"when": "false"},\n  "update.config.plymouth": {"when": "false"},/' "$extension"
  fi
fi

# Menu rows that break the phone or can't work on it (TOUCH-PLAN 0.2, 0.3,
# 3.3), hidden through the menu extension file with a failing "when". Checked
# by content at every login, not by a marker: a row the file doesn't name yet
# is added, and one the user has given their own entry (any value) is left
# as they set it. Children are listed too, since the menu's search finds a
# row under a hidden parent.
menu_hide() {
  local comment=$1 id rows=""
  shift
  local extension=~/.config/omarchy/extensions/omarchy-menu.jsonc
  mkdir -p "$(dirname "$extension")"
  [[ -s $extension ]] || printf '{\n}\n' >"$extension"
  for id; do
    grep -qF "\"$id\"" "$extension" || rows+="  \"$id\": {\"when\": \"false\"},"$'\n'
  done
  [[ -n $rows ]] || return 0
  OMAMOBILE_ROWS="  // Omarchy Mobile: $comment"$'\n'"${rows%$'\n'}" \
    awk '!done && /^[[:space:]]*\{/ {print; print ENVIRON["OMAMOBILE_ROWS"]; done = 1; next} {print}' \
    "$extension" >"$extension.new"
  mv -f "$extension.new" "$extension"
}
# Update > Channel and omarchy-refresh-pacman put Omarchy's x86_64 pacman.conf
# over the phone's (omamobile-omarchy refuses both too); Update > Config >
# Hyprland and Shell reset the files that hold the phone's setup.
menu_hide "these replace the phone's pacman.conf or its phone setup" \
  update.channel update.channel.stable update.channel.rc update.channel.edge update.channel.dev \
  update.config.hyprland update.config.shell
# Logout leaves a phone at SDDM's password prompt with no keyboard (SDDM's
# Relogin brings the session back, but the menu shouldn't offer it).
menu_hide "no logout on a phone" system.logout
menu_hide "no EFI, no encrypted drive, no trackpad on the phone" \
  setup.direct-boot update.password.drive update.hardware.trackpad
menu_hide "no keyboard to learn bindings for" learn.keybindings learn.tmux-keybindings learn.herdr-keybindings
menu_hide "the phone's status bar stays at the top" \
  style.bar.position.left style.bar.position.right style.bar.position.bottom \
  trigger.toggle.top-bar trigger.toggle.one-window-ratio trigger.toggle.workspace-layout
menu_hide "x86_64-only installers" \
  install.windows install.browser.chrome install.browser.edge \
  install.service.dropbox install.service.spotify install.service.nordvpn \
  install.ai.chatgpt install.ai.lm-studio \
  install.gaming.steam install.gaming.minecraft install.gaming.geforce-now install.gaming.xbox-controllers \
  install.gaming.battlenet install.gaming.lutris install.gaming.heroic

# Idle on a phone (TOUCH-PLAN 1.6): Omarchy's defaults show an animated
# full-brightness screensaver after 2.5 minutes and lock after 5, on an OLED
# panel. A phone locks (and blanks) after a minute and shows no screensaver.
# Once, and only for a user without an idle block of their own (the phone
# profile carries this one, so new users have it from the start); Omarchy's
# Trigger > Toggle > Screensaver and the idle settings still change it.
if omarchy-done ensure omamobile-idle; then
  if python3 - "$config/shell.json" <<'PY'
import json, os, sys
path = sys.argv[1]
try:
    with open(path) as f:
        config = json.load(f)
except FileNotFoundError:
    sys.exit(1)
phone = {"screensaver": 0, "lock": 60}
if "idle" not in config:
    config["idle"] = phone
    with open(path + ".new", "w") as f:
        json.dump(config, f, indent=2)
        f.write("\n")
    os.replace(path + ".new", path)
# The toggle follows when the idle block is the phone's (seeded now, or
# from the profile)
sys.exit(0 if config["idle"] == phone else 1)
PY
  then
    mkdir -p ~/.local/state/omarchy/toggles
    touch ~/.local/state/omarchy/toggles/screensaver-off
  fi
fi

# Like Android, waking the phone from its screensaver shows the PIN lock
# (patch 0006 honours the lock-after-screensaver toggle). Set once.
if omarchy-done ensure omamobile-lock-after-screensaver; then
  mkdir -p ~/.local/state/omarchy/toggles
  touch ~/.local/state/omarchy/toggles/lock-after-screensaver
fi
