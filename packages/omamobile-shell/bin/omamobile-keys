#!/bin/bash
# SPDX-License-Identifier: MIT
# Phone hardware-key gestures, called by Hyprland binds (hypr/phone.lua), as
# on Android:
#   power, short       unlocked: lock and turn the screen off
#                      unlocked, dark: screen on (nothing locked it, or the
#                      panel was powered off by hand)
#                      locked: screen off if it's on, on (PIN pad) if it's off
#                      screensaver up: lock (it wakes to the PIN pad)
#                      a press that turned the screen off behind a secure
#                      lock also asks omamobile-sleepd to sleep now (it does
#                      nothing while the omamobile-sleep toggle is off)
#   power, held 0.6 s  unlocked: Omarchy's system menu, while still held
#                      locked: screen on
#   power + volume down together: screenshot (Omarchy's, full screen)
#   wake                omamobile-sleepd, after Power woke the phone from
#                       sleep: the PIN pad, as the lost press would have
#   volume down alone   lowers the volume after a 0.15 s wait for power
#   volume up           raises the volume
#   either volume key while the Camera app (omacam) is in front and the phone
#                       is unlocked: take a photo (omacam --remote shutter),
#                       as Android's camera does; held keys take one photo
# Hyprland can't bind a chord of two plain keys or a long press that fires
# while held, so each key reports here and the gesture is worked out from
# when the keys went down. Hyprland cancels power's release bind once another
# key goes down, so the chord acts on its own, not on release.
set -u

state="${XDG_RUNTIME_DIR:-/tmp}/omamobile-keys"
mkdir -p "$state"

now() { date +%s%3N; }

# Keys count as pressed together within this many milliseconds.
window=500
# A press held this long is a long press.
hold=0.6
# Volume down waits this long for power before it lowers the volume.
volume_wait=0.15

recent() {
  [[ -f $state/$1 ]] && (($(now) - $(<"$state/$1") <= window))
}

locked() {
  [[ $(omarchy-shell lock isLocked 2>/dev/null) == "true" ]]
}

# The Camera app is the focused window of an unlocked phone. omacam decides
# itself whether its "volume keys take photos" setting is on.
camera_in_front() {
  command -v omacam >/dev/null || return 1
  [[ $(hyprctl activewindow -j 2>/dev/null | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("class", ""))
except Exception: print("")') == omacam ]] && ! locked
}

screensaver_up() {
  pgrep -f '[o]rg.omarchy.screensaver' >/dev/null
}

# Light the locked display: first the lock's own wake, as a touch on the lock
# screen would, so its blank timer runs again (patches/omarchy/0009), then the
# display itself, because on tegu that wake reports ok without powering the
# panel back on. The brightness is put back if it was saved as 0.
wake_locked() {
  # The lock's wake restarts its blank timer, but on tegu it reports "ok"
  # without powering the panel back on, so always turn the display on too.
  omarchy-shell lock wake >/dev/null 2>&1
  omarchy-brightness-display on
  local device
  device=$(omarchy-hw-display 2>/dev/null)
  sleep 0.3
  [[ -n $device ]] || return 0
  [[ $(brightnessctl -d "$device" get 2>/dev/null || echo 1) -gt 0 ]] || brightnessctl -q -d "$device" set 40%
}

# The panel is off when its backlight's bl_power says so (4), or when Hyprland
# has the display powered off: on tegu a DPMS-off panel keeps bl_power at 0,
# and judging by bl_power alone made every Power press lock a dark phone
# into the dark again instead of waking it. Only a positive "off" counts:
# if hyprctl or jq fails, the screen reads as on, and the press locks
# rather than waking a phone that may be lit.
screen_off() {
  local device
  device=$(omarchy-hw-display 2>/dev/null)
  if [[ -n $device && -r /sys/class/backlight/$device/bl_power ]] &&
     [[ $(</sys/class/backlight/"$device"/bl_power) != 0 ]]; then
    return 0
  fi
  hyprctl monitors -j 2>/dev/null | jq -e 'any(.[]; .dpmsStatus == false)' >/dev/null
}

# The chord marker is cleared on power's release, but Hyprland drops that
# release once another key went down, so a marker older than this is stale.
in_chord() {
  [[ -f $state/chord ]] && (($(now) - $(stat -c %Y "$state/chord") * 1000 < 3000))
}

chord() {
  touch "$state/chord"
  # Power's release bind won't fire after the second key, so forget it now:
  # a later volume press on its own must not count as a chord.
  rm -f "$state/power"
  # A moment for the fingers to leave the keys, then Omarchy's screenshot:
  # saved, copied, and a notification with a thumbnail to edit.
  (sleep 0.4; omarchy-capture-screenshot fullscreen) >/dev/null 2>&1 &
}

# The screen just went off: sleep now if the lock is secure (SUSPEND-PLAN
# 6.1). omamobile-sleepd checks the toggle, the screen and its inhibitors
# itself; in the background, so the key handler returns at once.
sleep_now() {
  command -v omamobile-sleepd >/dev/null || return 0
  omarchy-shell lock status 2>/dev/null | grep -c '"secure":true' >/dev/null || return 0
  omamobile-sleepd now >/dev/null 2>&1 &
}

long_press() {
  touch "$state/long"
  if locked; then
    wake_locked
  else
    omarchy-menu toggle system
  fi
}

short_press() {
  # Debounce: a second press within 0.8 s of the first, while it was still
  # locking and powering the panel off, read the screen as on and saved a
  # brightness of 0, which left the phone dark on the next wake. A press a
  # few seconds later must still count: it is the wake.
  local now last
  now=$(date +%s%3N); last=$(cat "$state/last-press" 2>/dev/null || echo 0)
  echo "$now" >"$state/last-press"
  (( now - last < 800 )) && return 0
  # The press that woke the phone from sleep, if it gets here at all:
  # omamobile-sleepd has lit the PIN pad for it already.
  [[ -f $state/power-wake ]] && (( now - $(<"$state/power-wake") < 1500 )) && return 0
  if screensaver_up; then
    omarchy-system-lock
  elif locked; then
    if screen_off; then
      wake_locked
    else
      omarchy-brightness-display off
      sleep_now
    fi
  elif screen_off; then
    # Unlocked but dark (the lock didn't engage, or the panel was powered
    # off by hand): a press wakes it instead of locking into the dark again.
    omarchy-brightness-display on
    local device
    device=$(omarchy-hw-display 2>/dev/null)
    # A saved brightness of 0 would wake to a black panel.
    sleep 0.3
    if [[ -n $device ]]; then
      [[ $(brightnessctl -d "$device" get 2>/dev/null || echo 1) -gt 0 ]] || brightnessctl -q -d "$device" set 40%
    fi
  else
    # Dark at once, as on Android, but only by the backlight: Omarchy's lock
    # waits for a working screen ("screen-stabilizing"), so powering the panel
    # off first made the lock light it again for a moment. Lock behind the dark
    # panel, then power it off and put the brightness back for the next wake.
    local device level=
    device=$(omarchy-hw-display 2>/dev/null)
    if [[ -n $device ]]; then
      level=$(brightnessctl -d "$device" get 2>/dev/null)
      [[ ${level:-0} -gt 0 ]] || level=
      brightnessctl -q -d "$device" set 0
    fi
    omarchy-system-lock
    for _ in $(seq 30); do
      omarchy-shell lock status 2>/dev/null | grep -q '"secure":true' && break
      sleep 0.1
    done
    omarchy-brightness-display off
    # The brightness the next wake lights up with: the saved level, or 40 % when
    # the press caught the panel at 0.
    if [[ -n $device ]]; then
      [[ -n $level ]] && brightnessctl -q -d "$device" set "$level" || brightnessctl -q -d "$device" set 40%
    fi
    sleep_now
  fi
}

case "${1:-}" in
  power-down)
    rm -f "$state/chord" "$state/long"
    press=$(now)
    echo "$press" >"$state/power"
    if recent volume-down; then
      chord
    else
      # Long press: still the same press, still held, no chord in between.
      (
        sleep "$hold"
        [[ $(cat "$state/power" 2>/dev/null) == "$press" && ! -f $state/chord ]] && long_press
      ) >/dev/null 2>&1 &
    fi
    ;;
  volume-up)
    press=$(now)
    previous=$(cat "$state/volume-up" 2>/dev/null || echo 0)
    echo "$press" >"$state/volume-up"
    if camera_in_front; then
      # One photo per press: key repeat while held takes no more.
      ((press - previous < 700)) || omacam --remote shutter
    else
      omarchy-audio-output-volume raise
    fi
    ;;
  volume-down)
    press=$(now)
    previous=$(cat "$state/volume-down" 2>/dev/null || echo 0)
    echo "$press" >"$state/volume-down"
    # Power still held, or pressed just before: the screenshot chord.
    if [[ -f $state/power ]]; then
      chord
    # The Camera app in front: a photo, once per press.
    elif camera_in_front; then
      ((press - previous < 700)) || omacam --remote shutter
    # Part of a chord that's still held: no volume change.
    elif in_chord; then
      :
    # Key repeat while held (or a quick second press): lower right away.
    elif ((press - previous < 700)); then
      omarchy-audio-output-volume lower
    # A fresh press: give power a moment to join, then lower the volume.
    else
      (
        sleep "$volume_wait"
        [[ -f $state/power ]] || in_chord || omarchy-audio-output-volume lower
      ) >/dev/null 2>&1 &
    fi
    ;;
  power-up)
    # Released: forget the press before acting on it. Locking takes about a
    # second, longer than the long-press timer, which then found power still
    # "held" and woke the lock it had just taken (a flash of the PIN pad).
    rm -f "$state/power"
    if [[ -f $state/chord ]]; then
      rm -f "$state/chord"
    elif [[ -f $state/long ]]; then
      rm -f "$state/long"
    else
      short_press
    fi
    ;;
  wake)
    # omamobile-sleepd after a power-key wake from sleep: Hyprland never sees
    # the press that woke the phone, so light the PIN pad as that press would.
    now >"$state/power-wake"
    if locked && screen_off; then wake_locked; fi
    ;;
  *)
    echo "Usage: omamobile-keys power-down|power-up|volume-down|volume-up|wake" >&2
    exit 1
    ;;
esac
