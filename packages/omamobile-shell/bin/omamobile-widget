#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""omamobile-widget: the user's own home-screen widgets.

A user widget is a folder under ~/.config/omamobile/widgets/<id>/ with a
manifest.json (Omarchy's plugin manifest, kind "home-widget") and the QML it
names. The home screen (omamobile.home) runs `omamobile-widget scan` to list
them; it shows a widget only when this tool calls it "ok". Coding agents run
`omamobile-widget check .` in a widget's folder to see the same verdict.

  omamobile-widget scan                 JSON: every user widget and example
  omamobile-widget check [DIR]          the verdict for one folder (exit 1 on errors)
  omamobile-widget new ID NAME          a widget folder from the template
  omamobile-widget copy-example ID      copy an installed example into your widgets
  omamobile-widget remove ID            move a widget folder out (recoverable)
  omamobile-widget agent ID PROMPT      Omarchy's default agent, in a terminal, in that folder
  omamobile-widget store-copy STORE_ID  copy an OWL widget from the store into your widgets
                                        (author/name -> author.name)
  omamobile-widget store-update ID      replace an unmodified store copy with the store's newer one
  omamobile-widget store-fetch          download the store's current index and widgets into
                                        ~/.cache (only when the user asks; each file checked
                                        against the index's sha256 when it has one)

/usr/share/omamobile/shell/WIDGETS.md is the contract. Everything here runs
as the user; nothing asks for root, and widget code is never fetched from
the network or read from anywhere but the user's widgets folder, the
installed examples and the OWL store (the omamobile-owl-widgets package, or
what store-fetch downloaded when asked).
"""

import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

HOME = os.path.expanduser("~")
WIDGETS_DIR = os.environ.get("OMAMOBILE_WIDGETS_DIR") or os.path.join(HOME, ".config/omamobile/widgets")
SHARE = os.environ.get("OMAMOBILE_SHELL_SHARE") or "/usr/share/omamobile/shell"
EXAMPLES_DIR = os.environ.get("OMAMOBILE_WIDGET_EXAMPLES") or os.path.join(SHARE, "widget-examples")
TEMPLATE_DIR = os.environ.get("OMAMOBILE_WIDGET_TEMPLATE") or os.path.join(SHARE, "widget-template")
CONTRACT = os.environ.get("OMAMOBILE_WIDGET_CONTRACT") or os.path.join(SHARE, "WIDGETS.md")
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "omamobile/widget-lint")
OWL_STORE = os.environ.get("OMAMOBILE_OWL_STORE") or "/usr/share/omamobile/owl-widgets"
OWL_STORE_CACHE = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "omamobile/owl-store")
OWL_STORE_URL = os.environ.get("OMAMOBILE_OWL_STORE_URL") or "https://simonschubert.github.io/omarchy-widgets/"
STORE_ID_RE = re.compile(r"^[a-z0-9][a-z0-9_-]*/[a-z0-9][a-z0-9_-]*$")
MAX_STORE_BYTES = 8 << 20
REMOVED_DIR = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share"), "omamobile/removed-widgets")
OMARCHY_PATH = os.environ.get("OMARCHY_PATH") or "/usr/share/omarchy"

KIND = "home-widget"
ENTRY_KEY = "homeWidget"
ID_RE = re.compile(r"^[a-z0-9][a-z0-9_-]*(\.[a-z0-9][a-z0-9_-]*)*$")
MAX_ID = 64
RESERVED = ("omarchy.", "omamobile.", "omandroid.")
CAPABILITIES = ("commands", "network")
FIELD_TYPES = ("string", "path", "integer", "number", "boolean", "enum")
# The largest grid the home screen allows (HomeModel.LIMITS).
MAX_COLUMNS, MAX_ROWS = 6, 8
MAX_FILES, MAX_BYTES, MAX_MANIFEST = 64, 1 << 20, 64 << 10
# OWL widgets (docs/WIDGET-INTEROP-PLAN.md): one widget.owl per folder.
OWL_FILE, MAX_OWL = "widget.owl", 256 << 10

# ---------------------------------------------------------------- manifest


def _cells(value, fallback, warnings, what):
    """[w, h] within the largest grid; anything else falls back."""
    if (isinstance(value, list) and len(value) == 2
            and all(isinstance(v, int) and not isinstance(v, bool) for v in value)):
        w = min(max(value[0], 1), MAX_COLUMNS)
        h = min(max(value[1], 1), MAX_ROWS)
        if [w, h] != value:
            warnings.append("%s %s clamped to %dx%d" % (what, value, w, h))
        return [w, h]
    if value is not None:
        warnings.append("%s must be [columns, rows]; using %dx%d" % (what, fallback[0], fallback[1]))
    return list(fallback)


def _field(raw, warnings):
    if not isinstance(raw, dict):
        warnings.append("a settings field that isn't an object was dropped")
        return None
    key, kind = raw.get("key"), raw.get("type")
    if not isinstance(key, str) or not re.match(r"^[A-Za-z_][A-Za-z0-9_]{0,39}$", key):
        warnings.append("settings field with key %r dropped: keys are identifiers" % (key,))
        return None
    if kind not in FIELD_TYPES:
        warnings.append("settings field %s dropped: type %r is not one of %s" % (key, kind, ", ".join(FIELD_TYPES)))
        return None
    field = {"key": key, "type": kind, "label": str(raw.get("label") or key)[:60]}
    if isinstance(raw.get("description"), str):
        field["description"] = raw["description"][:200]
    if kind in ("integer", "number"):
        for bound in ("min", "max", "step"):
            if isinstance(raw.get(bound), (int, float)) and not isinstance(raw.get(bound), bool):
                field[bound] = raw[bound]
    if kind == "enum":
        options = [str(o.get("value") if isinstance(o, dict) else o) for o in raw.get("options") or []]
        if not options:
            warnings.append("enum field %s dropped: it has no options" % key)
            return None
        field["options"] = options[:12]
    if "defaultValue" in raw:
        field["defaultValue"] = raw["defaultValue"]
    return field


def _fits(field, value):
    kind = field["type"]
    if kind in ("string", "path"):
        return isinstance(value, str)
    if kind == "boolean":
        return isinstance(value, bool)
    if kind == "integer":
        return isinstance(value, int) and not isinstance(value, bool)
    if kind == "number":
        return isinstance(value, (int, float)) and not isinstance(value, bool)
    if kind == "enum":
        return isinstance(value, str) and value in field["options"]
    return False


def _empty(field):
    return {"string": "", "path": "", "boolean": False, "integer": 0, "number": 0}.get(
        field["type"], field.get("options", [""])[0])


def validate_manifest(raw, dir_name):
    """(spec, errors, warnings). spec is None when the manifest is unusable."""
    errors, warnings = [], []
    if not isinstance(raw, dict):
        return None, ["manifest.json is not a JSON object"], warnings
    if raw.get("schemaVersion") != 1:
        errors.append("schemaVersion must be 1")
    for key in ("id", "name", "version", "kinds", "entryPoints"):
        if key not in raw:
            errors.append("missing required field %r" % key)
    wid = raw.get("id")
    if not isinstance(wid, str) or not ID_RE.match(wid) or len(wid) > MAX_ID:
        errors.append("id %r must be lower-case letters, digits, '-', '_' and dots, at most %d characters" % (wid, MAX_ID))
    elif wid.startswith(RESERVED):
        errors.append("id %r: the omarchy., omamobile. and omandroid. prefixes are reserved" % wid)
    elif wid != dir_name:
        errors.append("id %r must match the folder name %r" % (wid, dir_name))
    name = raw.get("name")
    if not isinstance(name, str) or not name.strip():
        errors.append("name must be a non-empty string")
        name = dir_name
    kinds = raw.get("kinds")
    if not isinstance(kinds, list) or KIND not in kinds:
        errors.append('kinds must include "%s"' % KIND)
    entry = (raw.get("entryPoints") or {}).get(ENTRY_KEY) if isinstance(raw.get("entryPoints"), dict) else None
    if not isinstance(entry, str) or not entry or entry.startswith("/") or ".." in entry or not entry.endswith(".qml"):
        errors.append("entryPoints.%s must be a .qml file inside the widget folder" % ENTRY_KEY)
        entry = None

    meta = raw.get(ENTRY_KEY)
    if meta is None:
        meta = {}
    elif not isinstance(meta, dict):
        errors.append("%s must be an object" % ENTRY_KEY)
        meta = {}
    size = _cells(meta.get("size"), [2, 1], warnings, "size")
    low = _cells(meta.get("min"), [1, 1], warnings, "min")
    high = _cells(meta.get("max"), [MAX_COLUMNS, MAX_ROWS], warnings, "max")
    high = [max(high[0], low[0]), max(high[1], low[1])]
    fixed = [min(max(size[0], low[0]), high[0]), min(max(size[1], low[1]), high[1])]
    if fixed != size:
        warnings.append("size %s moved inside min..max: %dx%d" % (size, fixed[0], fixed[1]))

    caps = meta.get("capabilities", [])
    if not isinstance(caps, list):
        errors.append("capabilities must be a list")
        caps = []
    declared = []
    for cap in caps:
        if cap in CAPABILITIES:
            if cap not in declared:
                declared.append(cap)
        else:
            warnings.append("unknown capability %r (known: %s)" % (cap, ", ".join(CAPABILITIES)))

    schema = []
    raw_schema = meta.get("schema", [])
    if not isinstance(raw_schema, list):
        warnings.append("schema must be a list; ignored")
        raw_schema = []
    for raw_field in raw_schema[:24]:
        field = _field(raw_field, warnings)
        if field and all(f["key"] != field["key"] for f in schema):
            schema.append(field)
    defaults = meta.get("defaults", {})
    if not isinstance(defaults, dict):
        warnings.append("defaults must be an object; ignored")
        defaults = {}
    defaults = dict(defaults)
    for field in schema:
        if field["key"] in defaults and _fits(field, defaults[field["key"]]):
            continue
        if "defaultValue" in field and _fits(field, field["defaultValue"]):
            defaults[field["key"]] = field["defaultValue"]
        else:
            defaults[field["key"]] = _empty(field)
    icon = meta.get("icon")
    if not isinstance(icon, str) or not icon or len(icon) > 4:
        icon = "󰕰"

    spec = {
        "id": wid if isinstance(wid, str) else dir_name,
        "name": name.strip()[:40],
        "version": str(raw.get("version") or ""),
        "author": str(raw.get("author") or "")[:60],
        "description": str(raw.get("description") or "")[:300],
        "icon": icon,
        "entry": entry,
        "size": fixed, "min": low, "max": high,
        "capabilities": declared,
        "defaults": defaults,
        "schema": schema,
    }
    return spec, errors, warnings

# ---------------------------------------------------------------- what the code does


def strip_comments(source):
    """QML/JS without comments, keeping string literals (so URLs in strings
    still count and `//` inside a string is not taken for a comment)."""
    out, i, n = [], 0, len(source)
    while i < n:
        c = source[i]
        if c in "\"'`":
            j = i + 1
            while j < n and source[j] != c:
                j += 2 if source[j] == "\\" else 1
            out.append(source[i:j + 1])
            i = j + 1
        elif source.startswith("//", i):
            j = source.find("\n", i)
            i = n if j < 0 else j
        elif source.startswith("/*", i):
            j = source.find("*/", i + 2)
            i = n if j < 0 else j + 2
        else:
            out.append(c)
            i += 1
    return "".join(out)


USES = {
    "commands": [r"\bProcess\s*\{", r"\bexecDetached\s*\(", r"\bexecArgv\s*\(", r"\bhost\.run\s*\(",
                 r"\bhost\.launch\s*\(", r"\bStdioCollector\b"],
    "network": [r"\bXMLHttpRequest\b", r"\bWebSocket\b", r"\bfetch\s*\(", r"\b(?:https?|wss?|ftp)://",
                r"[\"'](?:curl|wget|nc|ncat|ssh|scp|rsync|ping|dig)[\"']"],
}
FORBIDDEN = [
    # A command string or argv element that starts with a root helper.
    (r"[\"']\s*(?:sudo|pkexec|doas|run0|su)\b", "asks for root (sudo, pkexec, doas, run0, su): widgets run as you only"),
    (r"^\s*import\s+\"(?:/|\.\.|[a-z]+:)", "imports QML from outside its folder"),
    (r"\bQt\.createQmlObject\s*\(", "builds QML from a string (Qt.createQmlObject)"),
    (r"\bQt\.createComponent\s*\(\s*[\"'](?:/|\.\.|[a-z]+:)", "loads a component from outside its folder"),
    (r"\bsource\s*:\s*[\"'](?:https?|file)://[^\"']*\.qml", "loads QML from a URL"),
    (r"\bsource\s*:\s*[\"'](?:/|\.\./)[^\"']*\.qml", "loads QML from outside its folder"),
]


# Allowed, but costly on the phone's 120 Hz panel (WIDGETS.md, Performance).
SLOW = [
    (r"\blayer\.enabled\s*:\s*true", "uses layer.enabled (an offscreen copy every frame)"),
    (r"\b(?:MultiEffect|FastBlur|GaussianBlur|DropShadow|RectangularGlow|ShaderEffect)\s*\{", "uses a blur, shadow or shader effect"),
    (r"\binterval\s*:\s*(?:[0-9]{1,2}|[1-9][0-9]{2})\s*(?:$|[;}])", "has a timer faster than once a second"),
    (r"\bloops\s*:\s*Animation\.Infinite", "runs an animation forever"),
]


def code_checks(sources):
    """(detected capabilities, errors, warnings) from the widget's QML and JS."""
    detected, errors, warnings = [], [], []
    for name, text in sources:
        code = strip_comments(text)
        for cap, patterns in USES.items():
            if cap not in detected and any(re.search(p, code, re.M) for p in patterns):
                detected.append(cap)
        for pattern, why in FORBIDDEN:
            if re.search(pattern, code, re.M):
                errors.append("%s %s" % (name, why))
        for pattern, why in SLOW:
            if re.search(pattern, code, re.M):
                warnings.append("%s %s" % (name, why))
    return detected, errors, warnings

# ---------------------------------------------------------------- qmllint


def qmllint_path():
    # Qt 6's before a bare qmllint: on Arch that one can be Qt 5's, which
    # rejects Qt 6 syntax.
    for candidate in (os.environ.get("QMLLINT"), shutil.which("qmllint6"),
                      "/usr/lib/qt6/bin/qmllint", shutil.which("qmllint")):
        if candidate and os.access(candidate, os.X_OK):
            return candidate
    return None


def lint_verdict(report):
    """qmllint --json output -> (errors, warnings). Syntax errors, unknown
    types, unknown properties and failed imports stop a widget; the rest
    (unqualified access, members qmllint can't see through Omarchy's
    singletons) are shown as warnings."""
    errors, warnings = [], []
    files = report.get("files", []) if isinstance(report, dict) else []
    for f in files:
        name = os.path.basename(str(f.get("filename", "")))
        for w in f.get("warnings", []) or []:
            if w.get("type") == "info":
                continue
            wid, msg = str(w.get("id", "")), str(w.get("message", ""))
            # Omarchy's tokens are QtObjects (Style.font.body, Color.menu.text)
            # that qmllint can't see into: not a problem in the widget.
            if wid == "missing-property" and re.match(r'^Member "[^"]+" not found on type "QObject"$', msg):
                continue
            line = "%s:%s: %s" % (name, w.get("line", "?"), msg)
            fatal = (wid == "syntax" or w.get("type") in ("critical", "error")
                     or (wid == "import" and ("was not found" in msg or msg.startswith("Failed to import")))
                     or (wid == "missing-property" and msg.startswith("Could not find property")))
            (errors if fatal else warnings).append(line)
    return errors, warnings


def run_qmllint(files):
    """{"ran": bool, "tool": ..., "errors": [...], "warnings": [...]}"""
    tool = qmllint_path()
    if not tool:
        return {"ran": False, "tool": "", "errors": [], "warnings": ["qmllint is not installed (qt6-declarative); not linted"]}
    # Without Omarchy's shell every `qs.` import fails, which says nothing
    # about the widget (a build host, CI).
    if not os.path.isdir(os.path.join(OMARCHY_PATH, "shell")):
        return {"ran": False, "tool": tool, "errors": [], "warnings": ["Omarchy's shell is not installed; not linted"]}
    with tempfile.TemporaryDirectory(prefix="omamobile-widget-lint-") as imports:
        # Quickshell's `qs.` imports are the shell's own folder.
        os.symlink(os.path.join(OMARCHY_PATH, "shell"), os.path.join(imports, "qs"))
        try:
            proc = subprocess.run([tool, "--json", "-", "-I", imports] + files, capture_output=True,
                                  text=True, timeout=60)
        except subprocess.TimeoutExpired:
            return {"ran": True, "tool": tool, "errors": ["qmllint took longer than 60 s"], "warnings": []}
    try:
        report = json.loads(proc.stdout or "{}")
    except ValueError:
        return {"ran": True, "tool": tool, "errors": ["qmllint failed: " + (proc.stderr or "").strip()[:300]], "warnings": []}
    errors, warnings = lint_verdict(report)
    return {"ran": True, "tool": tool, "errors": errors, "warnings": warnings}


def cached_lint(widget_id, digest, files):
    path = os.path.join(CACHE_DIR, widget_id + ".json")
    try:
        with open(path) as f:
            cached = json.load(f)
        if cached.get("hash") == digest:
            return cached["lint"]
    except (OSError, ValueError, KeyError):
        pass
    lint = run_qmllint(files)
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        with open(path + ".tmp", "w") as f:
            json.dump({"hash": digest, "lint": lint}, f)
        os.replace(path + ".tmp", path)
    except OSError:
        pass
    return lint

# ---------------------------------------------------------------- one folder


def inside(path, base):
    path, base = os.path.realpath(path), os.path.realpath(base)
    return path == base or path.startswith(base.rstrip("/") + "/")


def inspect(folder, base, source, lint=True):
    """Everything the home screen needs to know about one widget folder."""
    dir_name = os.path.basename(folder.rstrip("/"))
    out = {"id": dir_name, "source": source, "dir": folder, "status": "error", "errors": [], "warnings": [],
           "hash": "", "manifest": None, "detected": [], "undeclared": [], "lint": None, "kind": "qml"}
    errors, warnings = out["errors"], out["warnings"]
    if not inside(folder, base):
        errors.append("the folder is a link to somewhere outside %s" % base)
        return out

    files, total = [], 0
    for root, dirs, names in os.walk(folder, followlinks=False):
        dirs[:] = sorted(d for d in dirs if not d.startswith("."))
        for name in sorted(names):
            if name.startswith("."):
                continue
            path = os.path.join(root, name)
            if not inside(path, folder):
                errors.append("%s links outside the widget folder" % os.path.relpath(path, folder))
                continue
            if not os.path.isfile(path):
                continue
            files.append(path)
            total += os.path.getsize(path)
    if len(files) > MAX_FILES or total > MAX_BYTES:
        errors.append("too big: at most %d files and %d KiB" % (MAX_FILES, MAX_BYTES >> 10))
        return out

    digest = hashlib.sha256()
    for path in files:
        digest.update(os.path.relpath(path, folder).encode() + b"\0")
        with open(path, "rb") as f:
            digest.update(f.read() + b"\0")
    out["hash"] = digest.hexdigest()[:16]

    manifest_path = os.path.join(folder, "manifest.json")
    owl_path = os.path.join(folder, OWL_FILE)
    if not os.path.isfile(manifest_path) and os.path.isfile(owl_path):
        return inspect_owl(out, owl_path)
    if not os.path.isfile(manifest_path):
        errors.append("no manifest.json")
        return out
    if os.path.getsize(manifest_path) > MAX_MANIFEST:
        errors.append("manifest.json is larger than 64 KiB")
        return out
    try:
        with open(manifest_path, encoding="utf-8") as f:
            raw = json.load(f)
    except ValueError as e:
        errors.append("manifest.json is not valid JSON: %s" % e)
        return out
    spec, m_errors, m_warnings = validate_manifest(raw, dir_name)
    errors.extend(m_errors)
    warnings.extend(m_warnings)
    out["manifest"] = spec
    if spec and spec["entry"]:
        entry = os.path.join(folder, spec["entry"])
        if not os.path.isfile(entry) or not inside(entry, folder):
            errors.append("%s is missing" % spec["entry"])

    sources = []
    for path in files:
        if path.endswith((".qml", ".js", ".mjs")):
            with open(path, encoding="utf-8", errors="replace") as f:
                sources.append((os.path.relpath(path, folder), f.read()))
    detected, c_errors, c_warnings = code_checks(sources)
    errors.extend(c_errors)
    warnings.extend(c_warnings)
    out["detected"] = detected
    declared = spec["capabilities"] if spec else []
    out["undeclared"] = [cap for cap in detected if cap not in declared]
    for cap in out["undeclared"]:
        errors.append({"commands": 'runs commands, but its manifest doesn\'t declare "commands"',
                       "network": 'uses the network, but its manifest doesn\'t declare "network"'}[cap])

    qml = [p for p in files if p.endswith(".qml")]
    if lint and qml and not errors:
        out["lint"] = cached_lint(dir_name, out["hash"], qml) if source == "user" else run_qmllint(qml)
        errors.extend(out["lint"]["errors"])
        warnings.extend(out["lint"]["warnings"])
    if not errors:
        out["status"] = "ok"
    return out


def inspect_owl(out, path):
    """An OWL widget (a folder with widget.owl and no manifest.json). The
    home screen compiles it with its own OWL runtime and derives what it may
    do from the compiler's list of commands, URLs and files; here only its
    size and encoding are checked, and its text handed over."""
    out["kind"] = "owl"
    if os.path.getsize(path) > MAX_OWL:
        out["errors"].append("%s is larger than %d KiB" % (OWL_FILE, MAX_OWL >> 10))
        return out
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
        out["owl"] = {"file": OWL_FILE, "text": text, "sha256": hashlib.sha256(text.encode()).hexdigest()}
    except UnicodeDecodeError:
        out["errors"].append("%s isn't UTF-8 text" % OWL_FILE)
        return out
    # A copy from the store remembers where it came from (dotfiles are left
    # out of the folder's hash, so this doesn't count as a change).
    try:
        with open(os.path.join(os.path.dirname(path), ".store.json"), encoding="utf-8") as f:
            store = json.load(f)
        if isinstance(store, dict) and isinstance(store.get("id"), str):
            out["store"] = {"id": store["id"], "version": str(store.get("version", "")), "sha256": str(store.get("sha256", ""))}
    except (OSError, ValueError):
        pass
    out["status"] = "ok"
    return out


def list_folders(base):
    if not os.path.isdir(base):
        return []
    return [os.path.join(base, n) for n in sorted(os.listdir(base))
            if not n.startswith(".") and os.path.isdir(os.path.join(base, n))]


def scan(lint=True):
    return {
        "version": 1,
        "dir": WIDGETS_DIR,
        "examplesDir": EXAMPLES_DIR,
        "contract": CONTRACT,
        "widgets": [inspect(f, WIDGETS_DIR, "user", lint) for f in list_folders(WIDGETS_DIR)],
        # Examples are only copied, never loaded from where they are installed.
        "examples": [inspect(f, EXAMPLES_DIR, "example", False) for f in list_folders(EXAMPLES_DIR)],
    }

# ---------------------------------------------------------------- folders


def ensure_dir():
    os.makedirs(WIDGETS_DIR, exist_ok=True)
    link = os.path.join(WIDGETS_DIR, "WIDGETS.md")
    if os.path.isfile(CONTRACT) and not os.path.lexists(link):
        try:
            os.symlink(CONTRACT, link)
        except OSError:
            pass


def check_id(widget_id):
    if not ID_RE.match(widget_id or "") or len(widget_id) > MAX_ID or widget_id.startswith(RESERVED):
        fail("not a widget id: %r" % widget_id)


def fail(message, code=2):
    print(message, file=sys.stderr)
    sys.exit(code)


def write_manifest(folder, update):
    path = os.path.join(folder, "manifest.json")
    with open(path, encoding="utf-8") as f:
        manifest = json.load(f)
    manifest.update(update)
    with open(path + ".tmp", "w", encoding="utf-8") as f:
        json.dump(manifest, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.replace(path + ".tmp", path)


def copy_tree(source, widget_id, update):
    ensure_dir()
    target = os.path.join(WIDGETS_DIR, widget_id)
    if os.path.lexists(target):
        fail("%s already exists" % target, 3)
    staging = tempfile.mkdtemp(prefix="." + widget_id + "-", dir=WIDGETS_DIR)
    try:
        shutil.copytree(source, os.path.join(staging, "w"), symlinks=False)
        write_manifest(os.path.join(staging, "w"), update)
        # Appears whole: the home screen's watcher never sees half a widget.
        os.rename(os.path.join(staging, "w"), target)
    finally:
        shutil.rmtree(staging, ignore_errors=True)
    print(target)


def cmd_new(widget_id, name):
    check_id(widget_id)
    if not os.path.isdir(TEMPLATE_DIR):
        fail("the widget template is missing: %s" % TEMPLATE_DIR)
    name = " ".join(str(name).split())[:40] or widget_id
    copy_tree(TEMPLATE_DIR, widget_id, {"id": widget_id, "name": name, "author": os.environ.get("USER", "")})


def cmd_copy_example(widget_id):
    check_id(widget_id)
    source = os.path.join(EXAMPLES_DIR, widget_id)
    if not os.path.isdir(source) or not inside(source, EXAMPLES_DIR):
        fail("no example called %s" % widget_id)
    copy_tree(source, widget_id, {})


def cmd_remove(widget_id):
    check_id(widget_id)
    folder = os.path.join(WIDGETS_DIR, widget_id)
    if not os.path.isdir(folder) or os.path.islink(folder):
        fail("no widget called %s" % widget_id, 3)
    os.makedirs(REMOVED_DIR, exist_ok=True)
    target = os.path.join(REMOVED_DIR, "%s-%s" % (widget_id, time.strftime("%Y%m%d-%H%M%S")))
    shutil.move(folder, target)
    print(target)

# ---------------------------------------------------------------- the OWL store


def store_index(base):
    try:
        with open(os.path.join(base, "index.json"), encoding="utf-8") as f:
            data = json.load(f)
        return {w["id"]: w for w in data.get("widgets", []) if isinstance(w, dict) and isinstance(w.get("id"), str)}
    except (OSError, ValueError, AttributeError):
        return {}


def version_key(v):
    return [int(p) if p.isdigit() else p for p in re.split(r"[.-]", str(v or "0"))]


def newer(a, b):
    """Whether version a is newer than b."""
    try:
        return version_key(a) > version_key(b)
    except TypeError:
        return str(a) > str(b)


def store_source(store_id):
    """(text, entry, where) of the newest shippable copy of a store widget:
    the package's, or a newer one store-fetch downloaded."""
    best = None
    for base, where in ((OWL_STORE, "package"), (OWL_STORE_CACHE, "fetched")):
        entry = store_index(base).get(store_id)
        path = os.path.join(base, "widgets", store_id, OWL_FILE)
        if not entry or entry.get("status") not in ("ok", "partial") or not os.path.isfile(path) or not inside(path, base):
            continue
        if best is None or newer(entry.get("version"), best[1].get("version")):
            with open(path, encoding="utf-8") as f:
                text = f.read()
            if entry.get("sha256") and hashlib.sha256(text.encode()).hexdigest() != entry["sha256"]:
                continue
            best = (text, entry, where)
    return best


def write_store_copy(folder, store_id, text, entry):
    with open(os.path.join(folder, OWL_FILE), "w", encoding="utf-8") as f:
        f.write(text)
    with open(os.path.join(folder, ".store.json"), "w", encoding="utf-8") as f:
        json.dump({"id": store_id, "version": str(entry.get("version", "")),
                   "sha256": hashlib.sha256(text.encode()).hexdigest()}, f)
        f.write("\n")


def cmd_store_copy(store_id):
    if not STORE_ID_RE.match(store_id or ""):
        fail("not a store widget id: %r" % store_id)
    found = store_source(store_id)
    if not found:
        fail("no store widget called %s that runs here" % store_id, 3)
    widget_id = store_id.replace("/", ".")
    check_id(widget_id)
    ensure_dir()
    target = os.path.join(WIDGETS_DIR, widget_id)
    if os.path.lexists(target):
        fail("%s already exists" % target, 3)
    staging = tempfile.mkdtemp(prefix="." + widget_id + "-", dir=WIDGETS_DIR)
    try:
        os.makedirs(os.path.join(staging, "w"))
        write_store_copy(os.path.join(staging, "w"), store_id, found[0], found[1])
        # Appears whole: the home screen's watcher never sees half a widget.
        os.rename(os.path.join(staging, "w"), target)
    finally:
        shutil.rmtree(staging, ignore_errors=True)
    print(target)


def cmd_store_update(widget_id):
    """Only an unmodified copy (its file still has the sha256 it was copied
    with) is replaced; a copy the user changed is never overwritten."""
    check_id(widget_id)
    folder = os.path.join(WIDGETS_DIR, widget_id)
    try:
        with open(os.path.join(folder, ".store.json"), encoding="utf-8") as f:
            store = json.load(f)
        with open(os.path.join(folder, OWL_FILE), encoding="utf-8") as f:
            current = f.read()
    except (OSError, ValueError):
        fail("%s isn't a copy from the store" % widget_id, 3)
    if hashlib.sha256(current.encode()).hexdigest() != store.get("sha256"):
        fail("%s was changed since it was copied, so it isn't replaced" % widget_id, 4)
    found = store_source(store.get("id", ""))
    if not found or not newer(found[1].get("version"), store.get("version")):
        fail("no newer version of %s in the store" % widget_id, 3)
    write_store_copy(folder, store["id"], found[0], found[1])
    print(folder)


def fetch(url, limit):
    import urllib.request
    with urllib.request.urlopen(url, timeout=20) as response:
        data = response.read(limit + 1)
    if len(data) > limit:
        raise ValueError("%s is larger than %d bytes" % (url, limit))
    return data


def cmd_store_fetch():
    """The store's current index and widget files, into the cache. Run only
    from the Store tab's "Check the store now", never on its own. Files go
    through the same compiler and approval as the package's."""
    base = OWL_STORE_URL.rstrip("/") + "/"
    try:
        index = json.loads(fetch(base + "index.json", 4 << 20).decode())
    except (OSError, ValueError) as e:
        fail("couldn't read the store's index: %s" % e, 5)
    entries = index.get("widgets", index) if isinstance(index, dict) else index
    if not isinstance(entries, list):
        fail("the store's index isn't a list of widgets", 5)
    staging = tempfile.mkdtemp(prefix="owl-store-")
    out, total, skipped = [], 0, []
    try:
        for e in entries:
            store_id = e.get("id") if isinstance(e, dict) else None
            if not isinstance(store_id, str) or not STORE_ID_RE.match(store_id):
                continue
            try:
                data = fetch(base + "widgets/" + store_id + "/" + OWL_FILE, MAX_OWL)
            except (OSError, ValueError) as err:
                skipped.append("%s: %s" % (store_id, err))
                continue
            total += len(data)
            if total > MAX_STORE_BYTES:
                skipped.append("%s: the store is larger than %d MiB" % (store_id, MAX_STORE_BYTES >> 20))
                break
            digest = hashlib.sha256(data).hexdigest()
            if e.get("sha256") and e["sha256"] != digest:
                skipped.append("%s: its file doesn't match the index's sha256" % store_id)
                continue
            path = os.path.join(staging, "widgets", store_id, OWL_FILE)
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "wb") as f:
                f.write(data)
            # Shippable here only once our compiler and the home screen say so:
            # the Store tab compiles each one before it offers it.
            out.append({"id": store_id, "version": str(e.get("version", "")), "sha256": digest,
                        "status": "ok", "fetched": True, "verified": bool(e.get("sha256"))})
        with open(os.path.join(staging, "index.json"), "w", encoding="utf-8") as f:
            json.dump({"version": 1, "source": base, "widgets": out}, f)
        shutil.rmtree(OWL_STORE_CACHE, ignore_errors=True)
        os.makedirs(os.path.dirname(OWL_STORE_CACHE), exist_ok=True)
        shutil.move(staging, OWL_STORE_CACHE)
    finally:
        shutil.rmtree(staging, ignore_errors=True)
    for line in skipped:
        print("skipped " + line, file=sys.stderr)
    print("%d widgets" % len(out))

# ---------------------------------------------------------------- the agent


def default_agent():
    try:
        out = subprocess.run(["omarchy-default-agent"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""
    return out.strip().splitlines()[0].strip() if out.strip() else ""


def cmd_agent(widget_id, prompt):
    """Omarchy's default agent with `prompt`, in a terminal, in the widget's
    folder. The prompt is one argv element all the way through:
    omarchy-agent-prompt passes it to omarchy-agent as --prompt. Exit codes:
    0 launched, 3 no default agent (Omarchy's chooser was opened), 4 the
    agent stopped at once (its message on stderr)."""
    check_id(widget_id)
    folder = os.path.join(WIDGETS_DIR, widget_id)
    if not os.path.isdir(folder) or not inside(folder, WIDGETS_DIR):
        fail("no widget called %s" % widget_id, 2)
    if not str(prompt).strip():
        fail("an empty prompt", 2)
    if not default_agent():
        subprocess.Popen(["omarchy-agent", "--pick"], cwd=folder, start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print("No coding agent is chosen in Omarchy yet. Pick one in the menu that opened, then try again.",
              file=sys.stderr)
        sys.exit(3)
    # One app per screen (omamobile-launch): the agent's terminal maps on an
    # empty workspace. From the home screen this one already is, so this only
    # matters when called from elsewhere. Not a launch through the helper:
    # that would hide the agent's early exit, reported below.
    try:
        subprocess.run(["omamobile-launch", "empty"], timeout=10, stdin=subprocess.DEVNULL,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        pass
    # omarchy-agent moves to ~/Work only when started in $HOME; here it starts
    # in the widget folder and the agent works there.
    with tempfile.TemporaryFile(mode="w+") as errors:
        proc = subprocess.Popen(["omarchy-agent-prompt", prompt], cwd=folder, start_new_session=True,
                                stdin=subprocess.DEVNULL, stdout=errors, stderr=errors)
        # A missing or unsupported agent makes omarchy-agent exit at once with
        # a message; a terminal that opened keeps running.
        deadline = time.monotonic() + float(os.environ.get("OMAMOBILE_WIDGET_AGENT_WAIT", "2"))
        while time.monotonic() < deadline and proc.poll() is None:
            time.sleep(0.05)
        if proc.poll() not in (None, 0):
            errors.seek(0)
            message = errors.read().strip() or "the agent exited with status %d" % proc.returncode
            print(message, file=sys.stderr)
            sys.exit(4)
    print(folder)


def cmd_check(folder):
    folder = os.path.abspath(folder or ".")
    base = WIDGETS_DIR if inside(folder, WIDGETS_DIR) else (EXAMPLES_DIR if inside(folder, EXAMPLES_DIR)
                                                              else os.path.dirname(folder))
    result = inspect(folder, base, "user" if base == WIDGETS_DIR else "check")
    for e in result["errors"]:
        print("error: " + e)
    for w in result["warnings"]:
        print("warning: " + w)
    spec = result["manifest"]
    if spec:
        print("%s (%s): %dx%d, %d..%d x %d..%d cells, capabilities: %s" % (
            spec["name"], spec["id"], spec["size"][0], spec["size"][1], spec["min"][0], spec["max"][0],
            spec["min"][1], spec["max"][1], ", ".join(spec["capabilities"]) or "none"))
    if result["lint"] and not result["lint"]["ran"]:
        print("note: " + result["lint"]["warnings"][0])
    print("ok: the home screen will load it" if result["status"] == "ok" else "not ok: the home screen shows the errors instead")
    sys.exit(0 if result["status"] == "ok" else 1)


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    cmd, args = argv[1], argv[2:]
    if cmd == "scan" and not args:
        ensure_dir()
        json.dump(scan(), sys.stdout)
        sys.stdout.write("\n")
    elif cmd == "check" and len(args) <= 1:
        cmd_check(args[0] if args else ".")
    elif cmd == "new" and len(args) == 2:
        cmd_new(*args)
    elif cmd == "copy-example" and len(args) == 1:
        cmd_copy_example(args[0])
    elif cmd == "remove" and len(args) == 1:
        cmd_remove(args[0])
    elif cmd == "agent" and len(args) == 2:
        cmd_agent(*args)
    elif cmd == "store-copy" and len(args) == 1:
        cmd_store_copy(args[0])
    elif cmd == "store-update" and len(args) == 1:
        cmd_store_update(args[0])
    elif cmd == "store-fetch" and not args:
        cmd_store_fetch()
    elif cmd == "init" and not args:
        ensure_dir()
        print(WIDGETS_DIR)
    else:
        fail("usage: see omamobile-widget --help")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
