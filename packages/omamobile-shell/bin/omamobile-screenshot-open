#!/bin/bash
# SPDX-License-Identifier: MIT
# What a screenshot toast's tap ("Tap to view") opens on a phone: the saved
# screenshot in Loupe, the image viewer (omamobile-apps), which fits it to the
# screen and takes touch (pinch and double-tap to zoom, drag to pan, swipe to
# the next image) and offers copy, share and delete.
#
# Omarchy runs $OMARCHY_SCREENSHOT_EDITOR with the screenshot's path as its
# one argument (omarchy-capture-screenshot), and
# environment.d/30-omamobile-screenshot.conf points it here. Its default,
# Tensaku, is a desktop annotation tool: even maximized, most of the image
# was out of view and it could be neither panned nor zoomed by touch. Without
# Loupe this falls back to Tensaku, through omamobile-screenshot-edit.
if command -v loupe >/dev/null 2>&1; then
  exec loupe "$@"
fi
exec omamobile-screenshot-edit "$@"
