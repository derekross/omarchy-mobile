#!/bin/bash
# SPDX-License-Identifier: MIT
# omamobile-ime: Japanese input (fcitx5 with Mozc) on or off, for the user.
#
#   omamobile-ime status   on or off, and whether fcitx5 and Mozc are there
#   omamobile-ime on       fcitx5 (Mozc) takes the input method, from now on
#   omamobile-ime off      squeekboard takes it back, as before
#   omamobile-ime session  omamobile-ime.service: restart squeekboard once
#                          fcitx5 is up, then follow the keyboard's language
#
# Hyprland gives the input method to one client. squeekboard holds it by
# default and shows itself when a text field takes focus. With this on,
# fcitx5 holds it and converts what squeekboard types (its keys reach fcitx5
# through the keyboard grab; hyprland 0.57.0-3.4 resends squeekboard's
# keymap there), but squeekboard no longer sees text fields: double-tap the
# home strip to show or hide it. Mozc converts only while the keyboard's
# language (the globe key) is Japanese (romaji), jp+romaji: a copy of the US
# terminal layout (Esc, Tab, Ctrl and the arrows in every app, since
# squeekboard no longer learns a field is a terminal), as jp.yaml's kana views
# need more keycodes than a keymap can carry. With any other language fcitx5 passes keys through as typed (a
# password in English is safe). "on" adds that language to the keyboard's
# list and "off" takes it out again. English gets the US terminal layout
# while it is on (us_layouts). Space converts, Enter commits; candidates
# appear in fcitx5's own window, which takes no taps. The switch is
# ~/.config/omamobile/fcitx5 (the drop-in on omarchy-fcitx5.service reads
# it too).
set -euo pipefail

CONF=${XDG_CONFIG_HOME:-$HOME/.config}
FLAG=$CONF/omamobile/fcitx5
FCITX=$CONF/fcitx5
SYSTEMCTL=${OMAMOBILE_SYSTEMCTL:-systemctl}
MOZC=${OMAMOBILE_MOZC_ADDON:-/usr/share/fcitx5/addon/mozc.conf}
GSETTINGS=${OMAMOBILE_GSETTINGS:-gsettings}
REMOTE=${OMAMOBILE_FCITX5_REMOTE:-fcitx5-remote}
# How long session waits for squeekboard, and for fcitx5 to answer, in seconds
OSK_WAIT=${OMAMOBILE_IME_OSK_WAIT:-20}
REMOTE_WAIT=${OMAMOBILE_IME_REMOTE_WAIT:-10}
# squeekboard is restarted once per login session ("on" restarts it itself)
RESTARTED=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omamobile-ime-osk-restarted
SCHEMA=org.gnome.desktop.input-sources
# squeekboard's layouts, as omamobile-setup-user links them
KEYBOARDS=${XDG_DATA_HOME:-$HOME/.local/share}/squeekboard/keyboards
SHARE=/usr/share/omamobile/squeekboard/keyboards

die() { echo "omamobile-ime: $*" >&2; exit 1; }

# Stop squeekboard (OMAMOBILE_IME_OSK_STOP runs instead, for tests).
stop_squeekboard() {
  if [[ -n ${OMAMOBILE_IME_OSK_STOP:-} ]]; then "$OMAMOBILE_IME_OSK_STOP"; return; fi
  pkill -x squeekboard 2>/dev/null || true
  for _ in $(seq 30); do pgrep -x squeekboard >/dev/null || break; sleep 0.1; done
}

# squeekboard as Omarchy's autostart starts it, through Hyprland's exec:
# started straight from a script it didn't come back (omamobile-keyboard-theme).
# OMAMOBILE_IME_OSK_RESTART runs instead, for tests.
restart_squeekboard() {
  if [[ -n ${OMAMOBILE_IME_OSK_RESTART:-} ]]; then "$OMAMOBILE_IME_OSK_RESTART"; return; fi
  stop_squeekboard
  local sig=${HYPRLAND_INSTANCE_SIGNATURE:-}
  [[ -n $sig ]] || sig=$(ls "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr" 2>/dev/null | head -1)
  [[ -n $sig ]] || die "no Hyprland session to start squeekboard in"
  HYPRLAND_INSTANCE_SIGNATURE=$sig hyprctl dispatch 'hl.dsp.exec_cmd("uwsm-app -- squeekboard")' >/dev/null
}

# fcitx5's profile: two groups, English (the US keyboard) and Japanese (Mozc
# alone, so it converts as soon as the group is chosen). A group is global,
# unlike activating Mozc, which reaches only the focused field (none while
# the language sheet is open). Only written when the user has no profile or
# config of their own.
write_config() {
  mkdir -p "$FCITX"
  if [[ ! -e $FCITX/profile ]]; then
    cat > "$FCITX/profile" <<'EOF'
[Groups/0]
Name=English
Default Layout=us
DefaultIM=keyboard-us

[Groups/0/Items/0]
Name=keyboard-us
Layout=

[Groups/1]
Name=Japanese
Default Layout=us
DefaultIM=mozc

[Groups/1/Items/0]
Name=mozc
Layout=

[GroupOrder]
0=English
1=Japanese
EOF
  fi
  if [[ ! -e $FCITX/config ]]; then
    printf '[Behavior]\nActiveByDefault=False\nShareInputState=All\n' > "$FCITX/config"
  fi
}

# squeekboard shows the first of the input sources; Mozc for Japanese only.
# A failure (fcitx5 not up yet, or restarting) is logged, not fatal: the
# follower keeps running and applies the next change.
language() { "$GSETTINGS" get $SCHEMA sources | grep -o "'xkb', '[^']*'" | head -1 | sed "s/.*, '//; s/'$//"; }
apply() {
  local group=English
  [[ $(language) == jp+romaji ]] && group=Japanese
  "$REMOTE" -g "$group" && return 0
  echo "omamobile-ime: fcitx5 didn't take the $group group" >&2
  return 1
}

# Add Japanese (romaji) to the keyboard's languages, last, if it isn't there.
add_language() {
  local now
  now=$("$GSETTINGS" get $SCHEMA sources)
  grep -q "'jp+romaji'" <<<"$now" && return 0
  if [[ $now == *"('"* ]]; then
    "$GSETTINGS" set $SCHEMA sources "${now%]}, ('xkb', 'jp+romaji')]"
  else
    "$GSETTINGS" set $SCHEMA sources "[('xkb', 'us'), ('xkb', 'jp+romaji')]"
  fi
}

# Take Japanese (romaji) out of the keyboard's languages again: without the
# IME it is the US keyboard under a Japanese name. If it was the current one
# (the first), the next language becomes current.
remove_language() {
  local now new
  now=$("$GSETTINGS" get $SCHEMA sources) || return 1
  grep -q "'jp+romaji'" <<<"$now" || return 0
  new=$(sed -E "s/\('xkb', 'jp\+romaji'\)(, )?//g; s/, \]/]/" <<<"$now")
  [[ $new == *"('"* ]] || new="@a(ss) []"
  "$GSETTINGS" set $SCHEMA sources "$new"
}

# With the IME on squeekboard never learns a field is a terminal, so English
# gets the US terminal layout too (Esc, Tab, Ctrl and the arrows): "on" points
# the user's us.yaml links at terminal/, "off" points them back. Only our own
# links are changed; a layout file of the user's own is left alone.
us_layouts() {
  local from=$1 to=$2 w
  for w in "" _wide; do
    [[ $(readlink "$KEYBOARDS/us$w.yaml" 2>/dev/null) == "$SHARE/${from}us$w.yaml" ]] &&
      ln -sfn "$SHARE/${to}us$w.yaml" "$KEYBOARDS/us$w.yaml"
  done
  return 0
}

status() {
  local state=off mozc=no
  [[ -e $FLAG ]] && state=on
  [[ -e $MOZC ]] && mozc=yes
  echo "japanese input: $state"
  echo "mozc installed: $mozc"
  echo "fcitx5: $("$SYSTEMCTL" --user is-active omarchy-fcitx5.service 2>/dev/null || true)"
}

case ${1:-} in
  status) status ;;
  on)
    [[ -e $MOZC ]] || die "fcitx5-mozc isn't installed (sudo pacman -S fcitx5-mozc)"
    write_config
    add_language
    mkdir -p "${FLAG%/*}"; : > "$FLAG"
    # Hyprland gives the input method to whoever asks first and fcitx5 asks
    # once, when it starts: started while squeekboard holds it, fcitx5 never
    # gets it, and squeekboard types straight into the field. So squeekboard
    # is stopped first and started again once fcitx5 answers.
    stop_squeekboard
    us_layouts "" terminal/
    "$SYSTEMCTL" --user restart omarchy-fcitx5.service
    for _ in $(seq $((REMOTE_WAIT * 5))); do "$REMOTE" >/dev/null 2>&1 && break; sleep 0.2; done
    sleep "${OMAMOBILE_IME_SETTLE:-1}"
    restart_squeekboard
    : > "$RESTARTED"
    "$SYSTEMCTL" --user restart omamobile-ime.service
    echo "Japanese input on: pick Japanese (romaji) with the globe key; double-tap the home strip for the keyboard"
    ;;
  off)
    rm -f "$FLAG" "$RESTARTED"
    # The language and the layouts are tidying: a failure there (gsettings
    # with no session bus, say) must not leave fcitx5 holding the input
    # method while status says off.
    remove_language || echo "omamobile-ime: couldn't take Japanese (romaji) out of the keyboard's languages" >&2
    us_layouts terminal/ "" || echo "omamobile-ime: couldn't give English its own layout back" >&2
    "$SYSTEMCTL" --user stop omamobile-ime.service omarchy-fcitx5.service 2>/dev/null || true
    restart_squeekboard
    echo "Japanese input off"
    ;;
  session)
    # Hyprland's autostart may start squeekboard before fcitx5 is up, and
    # then squeekboard keeps the input method: wait for it, then restart it,
    # once per login session, so a restart of this unit doesn't take the
    # keyboard away again.
    if [[ ! -e $RESTARTED ]]; then
      for _ in $(seq $((OSK_WAIT * 5))); do pgrep -x squeekboard >/dev/null && break; sleep 0.2; done
      restart_squeekboard
      : > "$RESTARTED"
    fi
    applied=
    for _ in $(seq "$REMOTE_WAIT"); do apply 2>/dev/null && { applied=1; break; }; sleep 1; done
    [[ -n $applied ]] || apply || true
    "$GSETTINGS" monitor $SCHEMA sources | while read -r _; do apply || true; done
    ;;
  *) die "usage: omamobile-ime status|on|off" ;;
esac
