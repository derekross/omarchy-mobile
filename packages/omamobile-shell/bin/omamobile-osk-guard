#!/usr/bin/python3 -I
# SPDX-License-Identifier: MIT
# The on-screen keyboard's owner: the one program that writes the global
# screen-keyboard-enabled setting (squeekboard's "no physical keyboard" flag).
#
# 1. Hardware keyboards (OSK-HWKBD-PLAN): while a real Bluetooth or USB
#    keyboard is connected, squeekboard does not pop up on a text field
#    (the setting is false), unless the user chose "Show on-screen keyboard"
#    on the shade's keyboard card (mode "show"). The keyboards and the mode
#    are in ~/.local/state/omamobile/osk-hwkbd.json, which the card reads. A
#    keyboard that goes away stays listed for a 5 s grace counted from when
#    it was first found missing (a Bluetooth keyboard waking up comes back as
#    the same uniq and keeps the mode); after it, with no keyboard left, the
#    mode goes back to "auto". While the session is locked (any credential:
#    the password field, or the ABC field next to a PIN pad) the setting
#    stays true. The lock is polled with one process (omarchy-shell lock
#    isLocked) every 2 s, 10 s with the screen off, and only while a
#    keyboard is listed and the mode is not "show"; output other than
#    "false" counts as locked. The setting itself is followed through
#    `gsettings monitor`, keyboards through `udevadm monitor` (no polling).
#    KNOWN LIMIT: a polkit password prompt is not detected (Omarchy's agent
#    is inside the shell, no window to see), so with a keyboard listed the
#    on-screen keyboard does not pop up there; the card's Show button or
#    disconnecting the keyboard brings it back.
# 2. The safety net (TOUCH-PLAN 0.5): Omarchy's screensaver launcher turns
#    the setting off while the screensaver runs (patches/omarchy/0006-*) and
#    back on after. When it is off and should not be, this waits until no
#    screensaver runs, gives the screensaver's own restore its time, and
#    turns it back on. When 0006's restore turns it on while a keyboard is
#    connected, this turns it straight back off. No keyboard: always true.
#    Stopping the watcher leaves it true.
#
#   omamobile-osk-guard                 watch (omamobile-osk-guard.service)
#   omamobile-osk-guard --once          check once and exit
#   omamobile-osk-guard --mode show|hide|auto
#                                       the card's buttons: set the mode, the
#                                       setting, and show or hide the keyboard
#   omamobile-osk-guard --disconnect MAC
#                                       bluetoothctl disconnect (the card)
import fcntl, glob, json, os, re, select, signal, struct, subprocess, sys, tempfile, time

KEY = ["org.gnome.desktop.a11y.applications", "screen-keyboard-enabled"]
HOME = os.environ.get("HOME", "/")
SYSFS = os.environ.get("OMAMOBILE_OSK_SYSFS", "/sys")
UDEV = os.environ.get("OMAMOBILE_OSK_UDEVDATA", "/run/udev/data")
STATE = os.environ.get("OMAMOBILE_OSK_STATE", HOME + "/.local/state/omamobile/osk-hwkbd.json")


def num(name, default):
    try: return float(os.environ.get(name, default))
    except ValueError: return float(default)


# The launcher turns the setting off a moment before the screensaver's
# window opens, and the screensaver's restore waits for the lock.
GRACE = num("OMAMOBILE_OSK_GUARD_GRACE", 10)
KEYBOARD_GRACE = num("OMAMOBILE_OSK_KEYBOARD_GRACE", 5)
SETTLE = num("OMAMOBILE_OSK_SETTLE", 1)
POLL = num("OMAMOBILE_OSK_POLL", 2)
POLL_OFF = num("OMAMOBILE_OSK_POLL_OFF", 10)  # the lock poll with the screen off
MAC = re.compile(r"^([0-9a-f]{2}:){5}[0-9a-f]{2}$", re.I)


def log(msg):
    print("omamobile-osk-guard: " + msg, flush=True)


def run(cmd, timeout=10):
    try:
        return subprocess.run(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None


# ------------------------------------------------------------------ keyboards
# The rule of omamobile-settings' lock.sh keyboard_connected() (a copy: that
# is another package): an event node udev calls a keyboard, on Bluetooth
# (bus 0005) or USB (0003, not a virtual device), not a security key or a
# scanner, with the letter rows and space. gpio-keys (0019) and squeekboard's
# virtual keyboard never pass.
NOT_KEYBOARDS = re.compile(r"yubikey|yubico|nitrokey|solokey|onlykey|token|barcode|scanner", re.I)
LONG_BITS = struct.calcsize("l") * 8
NEEDED = list(range(16, 26)) + list(range(30, 39)) + list(range(44, 51)) + [57]  # Q..P, A..L, Z..M, space


def read(p):
    try:
        with open(p) as f: return f.read().strip()
    except (OSError, UnicodeDecodeError):
        return None


def keyboards():
    """Connected keyboards, one per uniq (else phys, else node): name, uniq, bus."""
    base = os.path.join(SYSFS, "class/input")
    try: names = sorted(os.listdir(base), key=lambda n: (len(n), n))
    except OSError: return []
    found = {}
    for ev in names:
        if not ev.startswith("event"): continue
        d = os.path.join(base, ev)
        dev, bus = read(d + "/dev"), read(d + "/device/id/bustype")
        if not dev or not bus: continue
        data = read(os.path.join(UDEV, "c" + dev)) or ""
        if "E:ID_INPUT_KEYBOARD=1" not in data.splitlines(): continue
        path = os.path.realpath(d + "/device")
        if bus == "0005": pass
        elif bus == "0003" and "/devices/virtual/input/" not in path + "/": pass
        else: continue
        name = read(d + "/device/name")
        if not name or NOT_KEYBOARDS.search(name): continue
        caps = (read(d + "/device/capabilities/key") or "").split()
        try: bits = sum(int(w, 16) << (i * LONG_BITS) for i, w in enumerate(reversed(caps)))
        except ValueError: continue
        if not all(bits >> k & 1 for k in NEEDED): continue
        uniq = (read(d + "/device/uniq") or "").lower()
        key = uniq or read(d + "/device/phys") or ev
        if key not in found:
            found[key] = {"name": name, "uniq": uniq, "bus": "bluetooth" if bus == "0005" else "usb"}
    return [dict(k, id=key) for key, k in found.items()]


# ------------------------------------------------------------------ state file
def locked_state():
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    f = open(STATE + ".lock", "a")
    fcntl.flock(f, fcntl.LOCK_EX)
    return f


def load():
    try:
        with open(STATE) as f: s = json.load(f)
        if not isinstance(s, dict): raise ValueError
    except (OSError, ValueError):
        s = {}
    kbs = s.get("keyboards") if isinstance(s.get("keyboards"), list) else []
    mode = s.get("mode") if s.get("mode") in ("auto", "show", "hide") else "auto"
    # An entry without a string id and name is dropped (a hand-edited file
    # must not stop the guard).
    kbs = [k for k in kbs if isinstance(k, dict) and isinstance(k.get("id"), str) and isinstance(k.get("name"), str)]
    return {"keyboards": kbs, "mode": mode}


def save(s):
    target = os.path.realpath(STATE)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(target), prefix=".osk-hwkbd.")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(s, f, ensure_ascii=False); f.write("\n")
        os.chmod(tmp, 0o644)
        os.replace(tmp, target)
    except BaseException:
        try: os.unlink(tmp)
        except OSError: pass
        raise


# ------------------------------------------------------------------ the setting
def osk_get():
    r = run(["gsettings", "get"] + KEY)
    return parse_bool(r.stdout if r and r.returncode == 0 else "")


def parse_bool(text):
    v = text.strip().rsplit(" ", 1)[-1] if text.strip() else ""
    return True if v == "true" else False if v == "false" else None


def osk_set(value):
    run(["gsettings", "set"] + KEY + ["true" if value else "false"])


def screensaver_up():
    r = run(["pgrep", "-f", "[o]rg.omarchy.screensaver"])
    return bool(r and r.returncode == 0)


def is_locked():
    """One process. Anything but a plain "false" (a timeout, the shell
    restarting, odd output) counts as locked: the safe side is a keyboard
    that can come up."""
    r = run(["omarchy-shell", "lock", "isLocked"], timeout=5)
    return not (r and r.returncode == 0 and r.stdout.strip() == "false")


def screen_off():
    """No process: every backlight reads off (bl_power 4 or brightness 0).
    UNVERIFIED on the phone that DPMS off shows there; if not, the screen
    simply counts as on and the lock is polled at the faster rate."""
    seen = False
    for d in glob.glob(os.path.join(SYSFS, "class/backlight/*")):
        seen = True
        if read(d + "/bl_power") not in ("4",) and read(d + "/brightness") not in ("0",): return False
    return seen


def wanted(state, locked):
    """locked: a callable, asked only when it decides the answer."""
    if not state["keyboards"] or state["mode"] == "show": return True
    # Locked (any credential): the lock's field, password or the ABC field
    # next to a PIN pad, must be able to bring the keyboard up.
    return locked()


def set_visible(show):
    run(["busctl", "--user", "call", "sm.puri.OSK0", "/sm/puri/OSK0", "sm.puri.OSK0",
         "SetVisible", "b", "true" if show else "false"])


# ------------------------------------------------------------------ the watcher
class Guard:
    def __init__(self):
        self.seen = {}          # id -> [keyboard, time first found missing or None]
        self.last_wanted = None
        self.actual = None      # the setting, from gsettings monitor (None: read it)
        self.locked = None      # the last lock poll (None: not polled)
        self.restore_at = None  # the safety net's deadline (setting off, wanted on)
        self.restore_phase = 0  # 0: first grace, 1: screensaver gone, second grace
        self.scan_at = 0.0
        self.poll_at = None
        self.state = {"keyboards": [], "mode": "auto"}
        # A restart keeps what the file lists for one grace (and its mode):
        # counted as missing from now until a scan finds it.
        start = time.monotonic()
        for k in load()["keyboards"]:
            self.seen[k["id"]] = [k, start]

    def refresh(self, now):
        """Rescan; write the state file when the list or the mode changes.
        The grace runs from when a keyboard was first found missing, and a
        keyboard that comes back within it keeps the mode."""
        present = {k["id"]: k for k in keyboards()}
        for key, k in present.items():
            self.seen[key] = [k, None]
        listed = []
        for key, (k, gone) in list(self.seen.items()):
            if key not in present and gone is None:
                self.seen[key][1] = gone = now
            if gone is None or now - gone < KEYBOARD_GRACE: listed.append(k)
            else: del self.seen[key]
        listed.sort(key=lambda k: (k["name"], k["id"]))
        with locked_state():
            s = load()
            new = {"keyboards": listed, "mode": s["mode"] if listed else "auto"}
            if new != s: save(new)
        self.state = new
        return new

    def lock_matters(self, s):
        return bool(s["keyboards"]) and s["mode"] != "show"

    def poll_lock(self):
        self.locked = is_locked()
        return self.locked

    def get_actual(self):
        if self.actual is None: self.actual = osk_get()
        return self.actual

    def write(self, value):
        osk_set(value)
        self.actual = value

    def evaluate(self, now, rescan=True, s=None):
        s = s or (self.refresh(now) if rescan else load())
        self.state = s
        if not self.lock_matters(s): self.locked = None
        want = wanted(s, lambda: self.locked if self.locked is not None else self.poll_lock())
        actual = self.get_actual()
        if want != self.last_wanted and self.last_wanted is not None:
            # Our own change (a keyboard came or went, the lock, the mode).
            self.last_wanted = want
            self.restore_at = None
            if actual == want: return
            if want and not self.locked and screensaver_up():
                # A keyboard went away under the screensaver: no keyboard
                # over it; the safety net turns it on once it is gone.
                self.restore_at = now + POLL
                self.restore_phase = 0
                return
            self.write(want)
            return
        self.last_wanted = want
        if actual is None or actual == want:
            self.restore_at = None
            return
        if not want:
            # Someone turned it on over a connected keyboard (0006's restore).
            self.restore_at = None
            self.write(False)
            log("a keyboard is connected; turned the on-screen keyboard's auto-show back off")
            return
        if self.restore_at is None:
            self.restore_at = now + GRACE
            self.restore_phase = 0

    def due(self, now):
        """The safety net's next step when its deadline came."""
        if self.restore_at is None or now < self.restore_at: return
        if screensaver_up() and not (self.lock_matters(self.state) and self.locked):
            self.restore_at = now + POLL
            self.restore_phase = 0
            return
        if self.restore_phase == 0:
            self.restore_phase = 1
            self.restore_at = now + GRACE
            return
        self.restore_at = None
        self.actual = osk_get()
        if self.actual is False and wanted(self.state, self.poll_lock) and \
                (self.locked or not screensaver_up()):
            self.write(True)
            log("the on-screen keyboard was off with no screensaver running; turned it back on")

    def next_deadline(self, now):
        times = [t for t in (self.restore_at, self.scan_at or None) if t is not None]
        # A keyboard in its grace: drop it (and maybe the mode) when it ends.
        times += [gone + KEYBOARD_GRACE for _, gone in self.seen.values() if gone is not None]
        if self.lock_matters(self.state):
            if self.poll_at is None:
                self.poll_at = now + (POLL_OFF if screen_off() else POLL)
            times.append(self.poll_at)
        else:
            self.poll_at = None
        return min(times) if times else None

    def tick(self, now):
        """Deadlines: a rescan, a grace end, the lock poll, the safety net."""
        if self.scan_at and now >= self.scan_at:
            self.scan_at = 0.0
            self.evaluate(now)
        elif any(gone is not None and now - gone >= KEYBOARD_GRACE for _, gone in self.seen.values()):
            self.evaluate(now)
        if self.poll_at is not None and now >= self.poll_at:
            self.poll_at = None
            if self.lock_matters(self.state):
                self.poll_lock()
                self.evaluate(now, s=self.state)
        self.due(now)


def once():
    g = Guard()
    now = time.monotonic()
    g.evaluate(now)
    while g.restore_at is not None:
        time.sleep(max(0.0, g.restore_at - time.monotonic()))
        g.due(time.monotonic())
    return 0


def watch():
    children = []

    def stop(*_):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGHUP, stop)
    try:
        mon = subprocess.Popen(["gsettings", "monitor"] + KEY, stdin=subprocess.DEVNULL,
                               stdout=subprocess.PIPE, text=True)
        children.append(mon)
        udev = subprocess.Popen(["udevadm", "monitor", "--udev", "--subsystem-match=input"],
                                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.DEVNULL, text=True)
        children.append(udev)
        g = Guard()
        g.evaluate(time.monotonic())
        streams = [mon.stdout, udev.stdout]
        while True:
            now = time.monotonic()
            deadline = g.next_deadline(now)
            timeout = None if deadline is None else max(0.0, deadline - now)
            ready, _, _ = select.select(streams, [], [], timeout)
            now = time.monotonic()
            for r in ready:
                line = r.readline()
                if not line:
                    # A monitor ended (the session bus went away, udevadm
                    # died): let systemd restart the guard.
                    return 1
                if r is udev.stdout:
                    g.scan_at = now + SETTLE
                else:
                    g.actual = parse_bool(line)
                    g.evaluate(now, rescan=False, s=g.state)
            g.tick(now)
    finally:
        for c in children:
            try: c.terminate()
            except OSError: pass
        # Nobody watches the keyboards now: an empty list, so the card goes
        # and a "hide" cannot leave auto-show off.
        try:
            with locked_state(): save({"keyboards": [], "mode": "auto"})
        except OSError:
            pass
        # Never leave the phone without its keyboard.
        if osk_get() is False: osk_set(True)


def set_mode(mode):
    with locked_state():
        s = load()
        s["mode"] = mode
        save(s)
    want = wanted(s, is_locked)
    if osk_get() != want: osk_set(want)
    if mode == "show": set_visible(True)
    elif mode == "hide": set_visible(False)
    return 0


def disconnect(mac):
    if not MAC.match(mac):
        print("omamobile-osk-guard: not a Bluetooth address: " + mac, file=sys.stderr)
        return 2
    r = run(["bluetoothctl", "disconnect", mac.upper()], timeout=15)
    return 0 if r and r.returncode == 0 else 1


def main(argv):
    if not argv: return watch()
    if argv == ["--once"]: return once()
    if len(argv) == 2 and argv[0] == "--mode" and argv[1] in ("show", "hide", "auto"): return set_mode(argv[1])
    if len(argv) == 2 and argv[0] == "--disconnect": return disconnect(argv[1])
    print("Usage: omamobile-osk-guard [--once | --mode show|hide|auto | --disconnect MAC]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
