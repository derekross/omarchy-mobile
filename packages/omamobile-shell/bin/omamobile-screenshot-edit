#!/bin/bash
# SPDX-License-Identifier: MIT
# The phone's screenshot editor: Tensaku, as Omarchy opens it (tensaku-edit,
# from the screenshot toast's tap), without the on-screen keyboard.
#
# Omarchy runs $OMARCHY_SCREENSHOT_EDITOR with the screenshot's path, and
# environment.d/30-omamobile-screenshot.conf points it here. Tensaku's
# window takes keyboard focus for its shortcuts and its text tool through a
# GTK input-method context, and with the session's GTK_IM_MODULE=wayland
# that focus asks for text input at once, so squeekboard came up over the
# screenshot with nothing to type. GTK's built-in simple context never talks
# to the text-input protocol, so the keyboard stays down; keys still arrive
# as key events, so a text annotation is typed with the keyboard shown by
# hand (double-tap the home pill, or the Keyboard tile).
#
# The window itself is tiled and maximized by hypr/phone.lua.
export GTK_IM_MODULE=gtk-im-context-simple
exec tensaku-edit "$@"
