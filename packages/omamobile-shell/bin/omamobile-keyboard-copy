#!/bin/bash
# SPDX-License-Identifier: MIT
# omamobile-keyboard-copy: the on-screen keyboard's Copy key (XF86Copy,
# bound in hypr/phone.lua for squeekboard only). It copies the selection of
# the window in front: Ctrl+Shift+C in a terminal (foot's copy; a plain
# Ctrl+C there would interrupt the program), Ctrl+C anywhere else, as
# Omarchy's Super+C does (default/hypr/bindings/clipboard.lua). A terminal
# is a window with Omarchy's `terminal` tag (default/hypr/apps/terminals.lua).
#
# The keys go through wtype, a virtual keyboard: on Hyprland 0.57 the
# send_key_state dispatch Omarchy uses answers a key name with "key not
# found" (Pixel 8 Pro, 2026-11-21), and the back gesture found that the
# dispatch's keys did not reach every app (omamobile.back, BackModel.js).
#
#   omamobile-keyboard-copy          copy
#   omamobile-keyboard-copy --help
#
# OMAMOBILE_HYPRCTL and OMAMOBILE_WTYPE name other programs, for the tests.

case ${1:-} in
  -h|--help)
    sed -n '3,15s/^# \{0,1\}//p' "$0"
    exit 0
    ;;
  "") ;;
  *)
    echo "usage: omamobile-keyboard-copy [--help]" >&2
    exit 2
    ;;
esac

hyprctl=${OMAMOBILE_HYPRCTL:-hyprctl}
wtype=${OMAMOBILE_WTYPE:-wtype}

# Dynamic tags carry a trailing "*". Ctrl+C only when the window is known
# not to be a terminal: if hyprctl or jq fails, nothing is sent (exit 1).
window=$("$hyprctl" activewindow -j 2>/dev/null) || exit 1
printf '%s' "$window" |
  jq -e '(.tags // []) | map(sub("\\*$"; "")) | index("terminal") != null' >/dev/null 2>&1
case $? in
  0) exec "$wtype" -M ctrl -M shift -k c -m shift -m ctrl ;;
  1) exec "$wtype" -M ctrl -k c -m ctrl ;;
  *) exit 1 ;;
esac
