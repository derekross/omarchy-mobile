#!/bin/bash
# SPDX-License-Identifier: MIT
# The phone's on-screen keyboard: the one the owner chose.
#
#   omamobile-osk            run the chosen keyboard (the session's autostart)
#   omamobile-osk which      the chosen keyboard: squeekboard or tactus
#   omamobile-osk list       the keyboards installed, one a line
#   omamobile-osk use NAME   choose NAME and change to it now
#
# squeekboard is the phone's keyboard and a dependency of this package. Tactus
# (packages/tactus) is one an owner may install beside it: it corrects words
# as they are typed. The choice is one word in ~/.config/omamobile/keyboard.
# Anything else there, or a keyboard that is no longer installed, means
# squeekboard, so there is always a keyboard. So does a Tactus that fails at
# its start: one that ends with an error, or a crash, within its first
# seconds (OMAMOBILE_OSK_GRACE, 5) is followed by squeekboard, as on a lock
# that takes a password no keyboard would mean no way in. A Tactus stopped
# by a signal (a change of keyboard, the session's end) is not.
set -u

file=${XDG_CONFIG_HOME:-$HOME/.config}/omamobile/keyboard

installed() {
  case $1 in
    squeekboard | tactus) command -v "$1" >/dev/null ;;
    *) return 1 ;;
  esac
}

chosen() {
  local name
  name=$(head -n1 "$file" 2>/dev/null | tr -d '[:space:]')
  if [[ $name == tactus ]] && installed tactus; then
    echo tactus
  else
    echo squeekboard
  fi
}

running() { pgrep -u "$(id -u)" -x "$1" >/dev/null 2>&1; }

# Tactus as a child, so a failed start can be followed by squeekboard. A
# signal to this script is passed on to it.
run_tactus() {
  local start=$SECONDS rc=0 pid stopped=0
  tactus &
  pid=$!
  trap 'stopped=1; kill -TERM "$pid" 2>/dev/null' TERM INT HUP
  wait "$pid" || rc=$?
  if ((stopped)); then
    # Stopped through this script (a change of keyboard, the session's end):
    # the trap cut the wait short, so wait for Tactus's own end and stop too
    rc=0
    wait "$pid" 2>/dev/null || rc=$?
    exit "$rc"
  fi
  trap - TERM INT HUP
  # A failed start: an error of its own or no program to run (1-127), or a
  # crash (SIGILL, SIGTRAP from g_error, SIGABRT, SIGBUS, SIGFPE, SIGSEGV),
  # within its first seconds. Not a signal from elsewhere (pkill on a change).
  if ((rc != 0 && SECONDS - start < ${OMAMOBILE_OSK_GRACE:-5})) &&
    { ((rc < 128)) || [[ " 132 133 134 135 136 139 " == *" $rc "* ]]; }; then
    echo "omamobile-osk: tactus ended at its start (status $rc): squeekboard instead" >&2
    exec squeekboard
  fi
  exit "$rc"
}

case ${1:-} in
  "")
    if [[ $(chosen) == tactus ]]; then
      run_tactus
    fi
    exec squeekboard
    ;;
  which)
    chosen
    ;;
  list)
    for k in squeekboard tactus; do
      installed "$k" && echo "$k"
    done
    ;;
  use)
    name=${2:-}
    case $name in
      squeekboard | tactus) ;;
      *) echo "omamobile-osk: use squeekboard or tactus" >&2; exit 2 ;;
    esac
    installed "$name" || { echo "omamobile-osk: $name is not installed" >&2; exit 1; }
    mkdir -p "${file%/*}" && printf '%s\n' "$name" >"$file.new" && mv -f "$file.new" "$file" || exit 1

    # Change now. Where the session runs the keyboard as squeekboard's user
    # unit (this package's drop-in makes that unit run omamobile-osk), through
    # the unit.
    if systemctl --user is-active -q mobi.phosh.OSK.service 2>/dev/null; then
      systemctl --user restart mobi.phosh.OSK.service
      exit
    fi
    # Otherwise stop the one that runs and start the other as Omarchy's
    # autostart does (uwsm-app), through Hyprland when it is there: started
    # from a terminal or over SSH, a keyboard did not come up
    # (omamobile-keyboard-theme, 2026-10-31).
    for k in squeekboard tactus; do
      running "$k" && pkill -u "$(id -u)" -x "$k"
    done
    for _ in $(seq 30); do
      running squeekboard || running tactus || break
      sleep 0.1
    done
    cmd=omamobile-osk
    command -v uwsm-app >/dev/null && cmd="uwsm-app -- omamobile-osk"
    if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v hyprctl >/dev/null; then
      hyprctl dispatch "hl.dsp.exec_cmd(\"$cmd\")" >/dev/null
    else
      # shellcheck disable=SC2086
      setsid -f $cmd </dev/null >/dev/null 2>&1
    fi
    ;;
  *)
    sed -n '3,8p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
    ;;
esac
