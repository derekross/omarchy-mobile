#!/usr/bin/python3
# SPDX-License-Identifier: MIT
"""Open web links read from NFC tags in the logged-in user's browser.

neard publishes each NDEF record it reads as an org.neard.Record object on the
system bus. Only root may call neard, so this runs as a root service: it
watches for new records, keeps http and https URIs only, and opens each one
in the active graphical session through that user's systemd manager (which
has the session's WAYLAND_DISPLAY), with omamobile-launch: on the browser's
own screen, as every launch on the phone. A tag that stays on the phone is read
once; neard reads it again only after it is lifted and tapped again.

It also follows NFC's rfkill switch (the quick-settings tile). neard isn't
told when the kernel blocks the radio, so on a block the adapter is powered
off through neard (on a kernel that already did, neard's view stays stale),
and on an unblock neard is restarted: it finds the adapter again, powers it
(DefaultPowered), and a new poll loop starts.

And it polls only while the screen is lit, as stock Android does: with every
display connector off (DPMS) for SCREEN_OFF_SECONDS, the poll loop stops,
and it starts again when the screen comes on. A poll loop is the radio
searching for cards, which costs the Pixel 9a about 60 mA.

And NFC can be off totally (the tile and Settings, through
omamobile-privacy@nfc-off.service): /var/lib/omamobile/privacy/nfc then says
"off". While it does, this never polls and never restarts neard; it stops
neard once and blocks the rfkill switch again whenever something unblocks it
(the session may write /dev/rfkill), also at boot. The file is read on the
same 2 s tick as the switch. When the file goes (nfc-on removes it before it
unblocks the switch), the next unblock restarts neard as before.
"""
import glob
import subprocess
import sys
import time

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

NEARD = "org.neard"
RECORD = "org.neard.Record"
ADAPTER = "org.neard.Adapter"
REPEAT_SECONDS = 3.0
SCREEN_OFF_SECONDS = 4
PRIVACY_FILE = "/var/lib/omamobile/privacy/nfc"

last = {"uri": None, "time": 0.0}


def log(message):
    print(f"omamobile-nfc-open: {message}", flush=True)


def session_user():
    """The user of the active graphical session, or None."""
    out = subprocess.run(["loginctl", "list-sessions", "--no-legend"],
                         capture_output=True, text=True).stdout
    for line in out.splitlines():
        fields = line.split()
        if len(fields) < 3 or fields[2] == "root":
            continue
        props = subprocess.run(
            ["loginctl", "show-session", fields[0], "-p", "Type", "-p", "Active"],
            capture_output=True, text=True).stdout
        if "Type=wayland" in props and "Active=yes" in props:
            return fields[2]
    return None


def open_uri(uri):
    if not (uri.startswith("https://") or uri.startswith("http://")):
        log(f"ignoring a non-web URI ({uri.split(':', 1)[0]})")
        return
    now = time.monotonic()
    if uri == last["uri"] and now - last["time"] < REPEAT_SECONDS:
        return
    last.update(uri=uri, time=now)
    user = session_user()
    if not user:
        log("no active graphical session; not opening")
        return
    log(f"opening a tag's link for {user}")
    subprocess.run(["systemd-run", "--quiet", "--collect", f"--machine={user}@.host",
                    "--user", "omamobile-launch", "url", uri], check=False)


def on_interfaces_added(_conn, _sender, _path, _iface, _signal, params, _data):
    _obj, interfaces = params.unpack()
    record = interfaces.get(RECORD)
    if record and record.get("Type") == "URI" and record.get("URI"):
        open_uri(record["URI"])


def start_polling(bus):
    """Power the first adapter and start a poll loop (neard's ConstantPoll
    keeps it going after each tag). True means "try again": neard isn't
    answering, has no adapter yet, or refused the power-on."""
    if rfkill["blocked"] or privacy["off"]:
        return False  # switched off meanwhile; the next unblock restarts neard
    try:
        objects = bus.call_sync(NEARD, "/", "org.freedesktop.DBus.ObjectManager",
                                "GetManagedObjects", None, None,
                                Gio.DBusCallFlags.NONE, -1, None).unpack()[0]
    except GLib.Error as error:
        log(f"neard not answering yet: {error.message}")
        return True
    for path, interfaces in objects.items():
        adapter = interfaces.get(ADAPTER)
        if adapter is None:
            continue
        if not adapter.get("Powered"):
            # This runs from GLib timeouts too: an exception would remove the
            # timer for good, so a failed power-on is logged and retried.
            try:
                bus.call_sync(NEARD, path, "org.freedesktop.DBus.Properties", "Set",
                              GLib.Variant("(ssv)", (ADAPTER, "Powered", GLib.Variant("b", True))),
                              None, Gio.DBusCallFlags.NONE, -1, None)
            except GLib.Error as error:
                log(f"{path}: Powered=True: {error.message}")
                return True
        if not adapter.get("Polling") and not screen["lit"]:
            log(f"screen off: {path} powered, polling waits for the screen")
        elif not adapter.get("Polling"):
            try:
                bus.call_sync(NEARD, path, ADAPTER, "StartPollLoop",
                              GLib.Variant("(s)", ("Initiator",)), None,
                              Gio.DBusCallFlags.NONE, -1, None)
                log(f"polling on {path}")
            except GLib.Error as error:
                log(f"could not start polling on {path}: {error.message}")
        return False
    return True


def nfc_blocked():
    """True, False, or None when there is no NFC rfkill switch."""
    for path in glob.glob("/sys/class/rfkill/rfkill*"):
        try:
            with open(f"{path}/type") as f:
                if f.read().strip() != "nfc":
                    continue
            with open(f"{path}/soft") as f:
                return f.read().strip() == "1"
        except OSError:
            continue
    return None


def set_powered(bus, powered):
    try:
        objects = bus.call_sync(NEARD, "/", "org.freedesktop.DBus.ObjectManager",
                                "GetManagedObjects", None, None,
                                Gio.DBusCallFlags.NONE, -1, None).unpack()[0]
    except GLib.Error:
        return
    for path, interfaces in objects.items():
        if ADAPTER not in interfaces:
            continue
        try:
            bus.call_sync(NEARD, path, "org.freedesktop.DBus.Properties", "Set",
                          GLib.Variant("(ssv)", (ADAPTER, "Powered", GLib.Variant("b", powered))),
                          None, Gio.DBusCallFlags.NONE, -1, None)
        except GLib.Error as error:
            log(f"{path}: Powered={powered}: {error.message}")


rfkill = {"blocked": None}
privacy = {"off": False}


def nfc_off(path=PRIVACY_FILE):
    """True while NFC is off totally. A file that exists but can't be read
    counts as off."""
    try:
        with open(path) as f:
            return f.read(16).strip() == "off"
    except FileNotFoundError:
        return False
    except OSError:
        return True
screen = {"lit": True, "dark_for": 0, "start": False}


def screen_lit(drm="/sys/class/drm"):
    """True unless every connected display connector reports DPMS off."""
    states = []
    for path in glob.glob(f"{drm}/card*-*"):
        try:
            with open(f"{path}/status") as f:
                if f.read().strip() != "connected":
                    continue
            with open(f"{path}/dpms") as f:
                states.append(f.read().strip())
        except OSError:
            continue
    return not states or any(state == "On" for state in states)


def stop_polling(bus):
    try:
        objects = bus.call_sync(NEARD, "/", "org.freedesktop.DBus.ObjectManager",
                                "GetManagedObjects", None, None,
                                Gio.DBusCallFlags.NONE, -1, None).unpack()[0]
    except GLib.Error:
        return
    for path, interfaces in objects.items():
        adapter = interfaces.get(ADAPTER)
        if adapter is None or not adapter.get("Polling"):
            continue
        try:
            bus.call_sync(NEARD, path, ADAPTER, "StopPollLoop", None, None,
                          Gio.DBusCallFlags.NONE, -1, None)
            log(f"screen off: polling stopped on {path}")
        except GLib.Error as error:
            log(f"could not stop polling on {path}: {error.message}")


def follow_screen(bus):
    """Every 2 s: once the screen has been off for a while, stop any poll loop
    (each time, so one that neard, a restart or the sleep hook started while
    the screen was dark stops too); start it again when the screen lights
    (unless NFC is switched off)."""
    lit = screen_lit()
    if lit:
        screen["dark_for"] = 0
        if not screen["lit"]:
            screen["lit"] = True
            screen["start"] = not rfkill["blocked"]
            if screen["start"]:
                log("screen on: polling again")
        if screen["start"] and not privacy["off"]:
            screen["start"] = start_polling(bus)
        return True
    screen["dark_for"] += 2
    if screen["dark_for"] >= SCREEN_OFF_SECONDS:
        screen["lit"] = False
        if not rfkill["blocked"] and not privacy["off"]:
            stop_polling(bus)
    return True


def follow_privacy():
    """NFC off totally: block the switch whenever it is unblocked, and stop
    neard once on the way in. True while off (follow_rfkill then does
    nothing else). On the way out, the switch counts as blocked, so the
    unblock that nfc-on does next restarts neard."""
    if nfc_off():
        if nfc_blocked() is False:
            log("NFC is off: blocking the switch again")
            subprocess.run(["rfkill", "block", "nfc"], check=False)
        if not privacy["off"]:
            privacy["off"] = True
            log("NFC off: neard stopped, no polling")
            subprocess.run(["systemctl", "stop", "neard.service"], check=False)
        rfkill["blocked"] = True
        if nfc_off():
            return True
        # nfc-on ran while this tick blocked the switch: undo the block, and
        # the way out below restarts neard on the unblock
        subprocess.run(["rfkill", "unblock", "nfc"], check=False)
    if privacy["off"]:
        privacy["off"] = False
        rfkill["blocked"] = True
        screen["start"] = False
        log("NFC allowed again")
    return False


def follow_rfkill(bus):
    if follow_privacy():
        return True
    blocked = nfc_blocked()
    if blocked is None or blocked == rfkill["blocked"]:
        return True
    previous, rfkill["blocked"] = rfkill["blocked"], blocked
    if blocked:
        log("NFC switched off")
        set_powered(bus, False)
    elif previous is not None:
        log("NFC switched on: restarting neard")
        restart_neard(bus)
    return True


def restart_neard(bus):
    if privacy["off"]:
        return
    subprocess.run(["systemctl", "restart", "neard"], check=False)
    GLib.timeout_add_seconds(2, start_polling, bus)


def main():
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    bus.signal_subscribe(NEARD, "org.freedesktop.DBus.ObjectManager", "InterfacesAdded",
                         None, None, Gio.DBusSignalFlags.NONE, on_interfaces_added, None)
    rfkill["blocked"] = nfc_blocked()
    if follow_privacy():
        pass  # off totally: neard stopped, the switch blocked, nothing polls
    elif not rfkill["blocked"]:
        # neard's view may be stale (a block before this service ran, or an
        # earlier run of it): start from a fresh neard.
        restart_neard(bus)
    GLib.timeout_add_seconds(2, follow_rfkill, bus)
    GLib.timeout_add_seconds(2, follow_screen, bus)
    GLib.MainLoop().run()


if __name__ == "__main__":
    sys.exit(main())
