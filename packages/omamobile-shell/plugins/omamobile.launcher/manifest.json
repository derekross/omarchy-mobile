{
  "schemaVersion": 1,
  "id": "omamobile.launcher",
  "name": "Mobile launcher",
  "version": "0.1.0",
  "author": "Omarchy Mobile",
  "license": "MIT",
  "description": "The phone home bar: native app search on tap, App Library on swipe, and the Home indicator.",
  "kinds": [
    "panel"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "panel": "Launcher.qml"
  },
  "settings": {
    "defaults": {
      "columns": 4,
      "sentenceWords": 3,
      "nativeSearch": true
    },
    "schema": [
      {
        "key": "columns",
        "type": "integer",
        "label": "Grid columns",
        "min": 3,
        "max": 6
      },
      {
        "key": "sentenceWords",
        "type": "integer",
        "label": "Words that make a prompt",
        "min": 2,
        "max": 8
      },
      {
        "key": "nativeSearch",
        "type": "boolean",
        "label": "Use separate app search on dock tap"
      }
    ]
  }
}
