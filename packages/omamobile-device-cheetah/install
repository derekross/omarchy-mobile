#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omamobile-device-cheetah into DESTDIR. Never activates anything:
# the boot-success unit is enabled by a vendor wants link, as omarchy-mac does.
#   ./install DESTDIR [BUILDDIR]   (BUILDDIR holds the compiled C tools)
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
destination=${1:?Usage: ./install DESTDIR [BUILDDIR]}
build=${2:-build}
[[ $destination == /* && $destination != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
for file in bin/*; do install -Dm755 "$file" "$destination/usr/bin/${file##*/}"; done
for tool in omamobile-bootctl reboot-to; do install -Dm755 "$build/$tool" "$destination/usr/bin/$tool"; done
while IFS= read -r -d '' file; do
  install -Dm644 "$file" "$destination/usr/lib/${file#vendor/}"
done < <(find vendor -type f -print0)
# systemd runs generators only when they are executable.
chmod 755 "$destination"/usr/lib/systemd/system-generators/*
while IFS= read -r -d '' file; do
  install -d "$destination/usr/lib/$(dirname "${file#vendor/}")"
  ln -sfn "$(readlink "$file")" "$destination/usr/lib/${file#vendor/}"
done < <(find vendor -type l -print0)
install -Dm644 wireplumber/50-omamobile-cameras.conf "$destination/usr/share/wireplumber/wireplumber.conf.d/50-omamobile-cameras.conf"
install -Dm644 etc/omamobile-mirrorlist "$destination/etc/pacman.d/omamobile-mirrorlist"
install -Dm644 LICENSE "$destination/usr/share/licenses/omamobile-device-cheetah/LICENSE"
install -Dm644 LICENSE.Apache-2.0 "$destination/usr/share/licenses/omamobile-device-cheetah/LICENSE.Apache-2.0"
install -Dm644 version "$destination/usr/share/omamobile/device-cheetah/version"

# The boot files omamobile-boot-update builds slot B's images from
# (docs/RELEASES.md §5.1): the descriptor, the board dtbo, the compiled DTB
# overlays and the release initramfs, which tools/stage-boot-files puts in
# boot-files/ (gitignored: built, never committed). A build without them
# fails: one version must be one package, whoever builds it, and a package
# without them would leave the boot hook refusing on every phone that
# installed it. tools/build-packages checks that they match the tree first
# (tools/stage-boot-files --check). OMAMOBILE_BOOT_FILES=none builds without
# them on purpose, for this package's tests and for a development phone
# (tools/phone-install-package sets it when none are staged): never for a
# published package.
boot=${OMAMOBILE_BOOT_FILES:-boot-files}
if [[ $boot == none ]]; then
  echo "omamobile-device-cheetah: OMAMOBILE_BOOT_FILES=none: packaged without the boot files (development only; omamobile-boot-update refuses on this build)" >&2
  exit 0
fi
[[ -d $boot ]] || { echo "omamobile-device-cheetah: no $boot/: stage the boot files first (DEVICE=cheetah KERNEL_OUT=<build> tools/stage-boot-files), or OMAMOBILE_BOOT_FILES=none for a development build" >&2; exit 1; }
(cd "$boot" && sha256sum --quiet --strict -c SHA256SUMS) || { echo "$boot fails its checksums (run tools/stage-boot-files again)" >&2; exit 1; }
for f in device.conf dtbo.img initramfs.cpio.lz4 SOURCES; do
  grep -cE "  $f$" "$boot/SHA256SUMS" >/dev/null || { echo "$boot/SHA256SUMS does not cover $f (run tools/stage-boot-files again)" >&2; exit 1; }
done
grep -cx 'CODENAME=cheetah' "$boot/device.conf" >/dev/null || { echo "$boot holds another device's boot files" >&2; exit 1; }
install -Dm644 "$boot/device.conf" "$destination/usr/share/omamobile/device.conf"
install -Dm644 "$boot/dtbo.img" "$destination/usr/lib/omamobile/cheetah/dtbo.img"
install -Dm644 "$boot/initramfs.cpio.lz4" "$destination/usr/lib/omamobile/cheetah/initramfs.cpio.lz4"
install -Dm644 "$boot/SOURCES" "$destination/usr/share/omamobile/device-cheetah/boot-files.sources"
for f in "$boot"/overlays/*.dtbo; do
  [[ -f $f ]] && install -Dm644 "$f" "$destination/usr/lib/omamobile/cheetah/overlays/${f##*/}"
done
exit 0
