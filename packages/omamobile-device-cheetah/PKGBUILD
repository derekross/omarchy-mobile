pkgname=omamobile-device-cheetah
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Omarchy Mobile support for the Google Pixel 7 Pro (cheetah): boot-slot success, storage guard, USB networking"
arch=(aarch64)
url="https://github.com/derekross/omarchy-mobile"
license=(MIT Apache-2.0)
depends=(bash systemd util-linux omamobile-keyring i2c-tools)
backup=(etc/pacman.d/omamobile-mirrorlist)
install=omamobile-device-cheetah.install
optdepends=('omamobile-boot-update: writes kernel package updates to slot B from the boot files this package ships')
makedepends=(gcc python)

build() {
  "$startdir/build" "$srcdir/build"
}

check() {
  "$startdir/test/all"
}

package() {
  "$startdir/install" "$pkgdir" "$srcdir/build"
}
