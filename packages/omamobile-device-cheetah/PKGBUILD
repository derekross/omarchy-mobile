# SPDX-License-Identifier: MIT
# Maintainer: Derek Ross <derekross@gmail.com>
pkgname=omamobile-device-cheetah
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Omarchy Mobile support for the Google Pixel 7 Pro (cheetah): boot-slot success, storage guard, USB networking"
arch=(aarch64)
url="https://github.com/derekross/omarchy-mobile"
license=(MIT Apache-2.0)
depends=(bash systemd util-linux omamobile-keyring i2c-tools
         python)  # omamobile-charger-mode
# Keep CPIF and its link driver behind the modem's guarded startup.
provides=(omamobile-modem-policy omamobile-sitd-policy)
# The suspend-verified declaration holds only with sitd's internet bearer
# reconnect (omamobile-modem-sit 0.3.42, #817): without it a bearer the
# network drops during a sleep stays down (SUSPEND-PLAN M6-D, 2026-11-15).
conflicts=('omamobile-modem-sit<0.3.42')
backup=(etc/pacman.d/omamobile-mirrorlist etc/UPower/UPower.conf.d/50-omamobile-critical.conf)
install=omamobile-device-cheetah.install
optdepends=('omamobile-boot-update: writes kernel package updates to slot B from the boot files this package ships')
makedepends=(gcc python)

build() {
  "$startdir/build" "$srcdir/build"
}

check() {
  "$startdir/test/all"
}

package() {
  "$startdir/install" "$pkgdir" "$srcdir/build"
}
