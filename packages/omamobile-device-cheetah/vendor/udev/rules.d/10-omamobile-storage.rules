# SPDX-License-Identifier: MIT
# Omarchy Mobile storage guard, continued in Arch. The initramfs marks every UFS
# partition read-only except slot B's boot images and userdata, and removes
# every LUN's whole-disk node. devtmpfs creates a node only when the kernel
# adds the device (device_add), so udev never brings one back; mode 0000 on
# /dev/sda is a second line should it ever reappear. UDISKS_IGNORE keeps
# desktop tools from touching any Android partition.
SUBSYSTEM=="block", KERNEL=="sda", MODE="0000", ENV{UDISKS_IGNORE}="1"
SUBSYSTEM=="block", KERNEL=="sd[a-d][0-9]*", ENV{ID_PART_ENTRY_NAME}!="userdata", ENV{UDISKS_IGNORE}="1"
