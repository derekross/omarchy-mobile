# SPDX-License-Identifier: MIT
# Omarchy Mobile: USB networking to the host. The initramfs sets up the USB
# gadget (CDC NCM) before handing over to Arch; this gives it an address.
# The host shares its internet over this link (NetworkManager "shared"
# mode on 172.16.42.2), so it is also a gateway, but only as a fallback:
# metric 1024 lets Wi-Fi's DHCP route (NetworkManager, metric 600) win when it is
# up. With metric 0 here, internet traffic went to the host while Wi-Fi was
# connected (2026-10-30). DNS goes to public resolvers.
[Match]
Name=usb0

[Network]
Address=172.16.42.1/24
DNS=1.1.1.1
DNS=9.9.9.9
ConfigureWithoutCarrier=yes

[Route]
Gateway=172.16.42.2
Metric=1024
