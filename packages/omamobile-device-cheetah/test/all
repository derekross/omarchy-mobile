#!/bin/bash
# SPDX-License-Identifier: MIT
# Tests for omamobile-device-cheetah. reboot-to is compiled from
# src/reboot-to.c in this directory, so a copied package still builds.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

for script in bin/*; do bash -n "$script" || fail "$script parses"; done
pass "scripts parse"

grep -q '\.\./\.\.' build && fail "build reaches outside the package directory"
pass "build stays inside the package directory"

./build "$tmp/build" || fail "C tools compile"
pass "C tools compile"

# reboot-to.c is also linked into the initramfs, and for a phone without
# bootctl that link is against musl with no compiler builtins
# (bin/omamobile initramfs). musl's vfprintf needs those builtins
# (__addtf3, __extenddftf2 and others, for long double), so one printf-family
# call stops that build with "reboot-to failed to link", and CI doesn't build
# that path. The other device packages hold their copy to this one.
if grep -nE '\<v?(f|s|sn|d|as)?printf[[:space:]]*\(' src/reboot-to.c; then
  fail "reboot-to.c calls the printf family, which doesn't link in the initramfs of a phone without bootctl"
fi
pass "reboot-to.c calls nothing from the printf family"

# omamobile-bootctl against a synthetic devinfo: dump works, and a dry run
# of mark-successful plans exactly one flag byte and writes nothing
python3 - "$tmp/devinfo" <<'PY'
import struct, sys
buf = bytearray(8192)
buf[0:4] = b"DEVI"
struct.pack_into("<HH", buf, 4, 3, 15)
buf[0x30:0x34] = bytes([2, 0x0a, 0, 0])   # slot a: successful, active-bit off
buf[0x34:0x38] = bytes([1, 0x04, 0, 0])   # slot b: active, not successful
open(sys.argv[1], "wb").write(buf)
PY
cp "$tmp/devinfo" "$tmp/devinfo.orig"
"$tmp/build/omamobile-bootctl" dump "$tmp/devinfo" | grep -c 'version: 3.15' >/dev/null || fail "bootctl decodes devinfo"
plan=$("$tmp/build/omamobile-bootctl" mark-successful "$tmp/devinfo" b 2>&1 || true)
grep -q '0x35: 04 -> 06' <<<"$plan" || fail "mark-successful plans one byte (0x35: 04 -> 06)" 
cmp -s "$tmp/devinfo" "$tmp/devinfo.orig" || fail "a dry run writes nothing"
pass "bootctl dry run plans one byte and writes nothing"

# The [omamobile] channel: installed phones follow stable, the file is kept
# across upgrades (backup=), and a phone that read its own repository keeps
# reading it after the upgrade that changes the default.
ml=etc/omamobile-mirrorlist
[[ $(grep -c '^Server' "$ml") == 1 ]] || fail "the mirrorlist has one active Server line"
grep -qxF 'Server = https://pkgs.omamobile.org/stable/$arch' "$ml" || fail "the default channel is stable"
grep -qxF '#Server = https://pkgs.omamobile.org/development/$arch' "$ml" || fail "development is offered, commented"
grep -qxF '#Server = file:///var/lib/omamobile/repo/$arch' "$ml" || fail "the local repository is offered, commented"
grep -qx "backup=(etc/pacman.d/omamobile-mirrorlist)" PKGBUILD || fail "pacman keeps a changed mirrorlist (backup=)"
if [[ -f ../omamobile-omarchy/bin/omamobile-update ]]; then
  for line in $(sed -n 's/^#\{0,1\}\(Server = [^ ]*\)$/\1/p' "$ml" | tr ' ' '~'); do
    grep -qF "\"${line//\~/ }\"" ../omamobile-omarchy/bin/omamobile-update \
      || fail "omamobile-update channel knows ${line//\~/ }"
  done
fi
inst=$tmp/channel.install
mkdir -p "$tmp/ch/etc" "$tmp/ch/var"
sed -e "s|^OMAMOBILE_MIRRORLIST=.*|OMAMOBILE_MIRRORLIST=$tmp/ch/etc/omamobile-mirrorlist|" \
    -e "s|^OMAMOBILE_LOCAL_MARK=.*|OMAMOBILE_LOCAL_MARK=$tmp/ch/var/mark|" \
    -e 's|^\(add_repository() {\)$|\1 return 0|' omamobile-device-cheetah.install > "$inst"
upgrade() {  # pre_upgrade, pacman replacing an unchanged backup file, post_upgrade
  (source "$inst"; pre_upgrade; if [[ ${1:-} == replace ]]; then cp "$ml" "$tmp/ch/etc/omamobile-mirrorlist"; fi; post_upgrade) > "$tmp/ch/out"
}
printf '# old\nServer = file:///var/lib/omamobile/repo/$arch\n' > "$tmp/ch/etc/omamobile-mirrorlist"
upgrade replace
[[ $(grep '^Server' "$tmp/ch/etc/omamobile-mirrorlist") == 'Server = file:///var/lib/omamobile/repo/$arch' ]] \
  || fail "a phone on its own repository stays there when pacman replaces the unchanged old file"
grep -q 'omamobile-update channel' "$tmp/ch/out" || fail "it is told how to switch"
[[ ! -e $tmp/ch/var/mark ]] || fail "the marker is removed"
grep -qxF '#Server = https://pkgs.omamobile.org/stable/$arch' "$tmp/ch/etc/omamobile-mirrorlist" || fail "stable is left there, commented"
cp "$tmp/ch/etc/omamobile-mirrorlist" "$tmp/ch/kept"
upgrade
cmp -s "$tmp/ch/kept" "$tmp/ch/etc/omamobile-mirrorlist" && [[ ! -s $tmp/ch/out ]] || fail "a later upgrade leaves it alone, quietly"
cp "$ml" "$tmp/ch/etc/omamobile-mirrorlist"
upgrade replace
cmp -s "$ml" "$tmp/ch/etc/omamobile-mirrorlist" && [[ ! -s $tmp/ch/out ]] || fail "a phone on stable stays on stable"
sed -e 's|^Server|#Server|' -e 's|^#\(Server = https://pkgs.omamobile.org/development/\$arch\)$|\1|' "$ml" > "$tmp/ch/etc/omamobile-mirrorlist"
cp "$tmp/ch/etc/omamobile-mirrorlist" "$tmp/ch/kept"
upgrade
cmp -s "$tmp/ch/kept" "$tmp/ch/etc/omamobile-mirrorlist" || fail "a builder's development choice is kept"
pass "the mirrorlist follows stable by default; a phone on its own repository or on development keeps its channel"

OMAMOBILE_BOOT_FILES=none ./install "$tmp/root" "$tmp/build" 2>/dev/null
for f in usr/bin/omamobile-bootctl usr/bin/reboot-to usr/bin/omamobile-boot-success usr/bin/omamobile-setup-system \
         usr/lib/systemd/system/omamobile-boot-success.service usr/lib/systemd/network/20-usb-gadget.network \
         usr/lib/udev/rules.d/10-omamobile-storage.rules usr/lib/NetworkManager/conf.d/10-omamobile-usb.conf usr/lib/systemd/logind.conf.d/10-omamobile-power-key.conf usr/lib/udev/rules.d/20-omamobile-gpu-always-on.rules \
         usr/bin/omamobile-wlan-mac usr/lib/udev/rules.d/80-omamobile-wlan-mac.rules \
         usr/bin/omamobile-charge-guard usr/lib/modprobe.d/omamobile-charger.conf \
         usr/lib/systemd/system.conf.d/10-omamobile-reboot-watchdog.conf \
         usr/lib/udev/rules.d/72-omamobile-feedbackd.rules \
         usr/bin/omamobile-bt-addr usr/lib/systemd/system/omamobile-bt-addr@.service usr/lib/udev/rules.d/80-omamobile-bt-addr.rules \
         usr/lib/modprobe.d/omamobile-bluetooth.conf \
         usr/bin/omamobile-wifi-start usr/lib/systemd/system/omamobile-wifi.service usr/lib/modprobe.d/omamobile-wifi.conf; do
  [[ -e $tmp/root/$f ]] || fail "install stages $f"
done
[[ $(readlink "$tmp/root/usr/lib/systemd/system/multi-user.target.wants/omamobile-boot-success.service") == ../omamobile-boot-success.service ]] \
  || fail "the boot-success unit is enabled by a vendor wants link"
[[ $(readlink "$tmp/root/usr/lib/systemd/system/multi-user.target.wants/omamobile-wifi.service") == ../omamobile-wifi.service ]] \
  || fail "the Wi-Fi unit is enabled by a vendor wants link"
grep -q 'mode=' bin/omamobile-wifi-start && fail "omamobile-wifi-start never loads the SysMMU firewall"
grep -qx 'blacklist pcie_gs201' vendor/modprobe.d/omamobile-wifi.conf || fail "pcie_gs201 only loads through the guarded service"
# The charger loads at boot (USB-C-PLAN D1) only with both options: without
# default_ilim_ua it turns charging off at probe, without temp_guard it
# charges with no temperature bands.
if ! grep -qx 'blacklist max77759_charger' vendor/modprobe.d/omamobile-max77759.conf; then
  grep -qx 'options max77759_charger default_ilim_ua=500000 temp_guard=1' vendor/modprobe.d/omamobile-charger.conf \
    || fail "a charger that loads at boot has its input limit and the temperature guard"
  grep -qx 'softdep max77759_charger pre: max17042_battery' vendor/modprobe.d/omamobile-charger.conf \
    || fail "the gauge loads before the charger, so the guard's first reading works"
fi
if grep -qE '^options max77759_charger' vendor/modprobe.d/omamobile-charger.conf; then
  opts=$(grep -E '^options max77759_charger' vendor/modprobe.d/omamobile-charger.conf)
  [[ $opts == *default_ilim_ua=* && $opts == *temp_guard=1* ]] || fail "never one charger option without the other"
fi
grep -qx 'blacklist tcpci_maxim' vendor/modprobe.d/omamobile-max77759.conf || fail "tcpci_maxim stays blacklisted until gate B4"
# The power key, now described, must not power the phone off. felix's test
# compares its copy with this file, so these checks guard both (L-64).
power="$tmp/root/usr/lib/systemd/logind.conf.d/10-omamobile-power-key.conf"
grep -qx '\[Login\]' "$power" || fail "the power-key drop-in needs a [Login] header"
grep -qx 'HandlePowerKey=ignore' "$power" || fail "a short press must not power the phone off"
grep -qx 'HandlePowerKeyLongPress=ignore' "$power" || fail "the long press stays the PMIC reset"
pass "install stages the package"

# The boot files (tools/stage-boot-files): installed where
# omamobile-boot-update looks when staged and checked; without them the
# build fails, unless OMAMOBILE_BOOT_FILES=none asks for a development build
[[ ! -e $tmp/root/usr/lib/omamobile/cheetah ]] || fail "OMAMOBILE_BOOT_FILES=none: no boot files"
if OMAMOBILE_BOOT_FILES=$tmp/no-boot-files ./install "$tmp/root-none" "$tmp/build" 2>"$tmp/err"; then fail "install refuses without boot files"; fi
grep -c 'tools/stage-boot-files' "$tmp/err" >/dev/null || fail "and says how to stage them"
grep -c 'OMAMOBILE_BOOT_FILES' PKGBUILD >/dev/null && fail "the PKGBUILD never opts out of the boot files"
bf=$tmp/boot-files && mkdir -p "$bf/overlays"
cp ../../device/cheetah/device.conf "$bf/device.conf" 2>/dev/null || printf 'CODENAME=cheetah\n' > "$bf/device.conf"
echo dtbo > "$bf/dtbo.img"; echo initramfs > "$bf/initramfs.cpio.lz4"; echo ov > "$bf/overlays/aoc-core-test.dtbo"
echo "0000  device/cheetah/device.conf" > "$bf/SOURCES"
(cd "$bf" && find . -type f | sed 's|^\./||' | sort | xargs sha256sum) > "$tmp/sums" && mv "$tmp/sums" "$bf/SHA256SUMS"
OMAMOBILE_BOOT_FILES=$bf ./install "$tmp/root-bf" "$tmp/build" || fail "install takes staged boot files"
for f in usr/share/omamobile/device.conf usr/lib/omamobile/cheetah/dtbo.img usr/lib/omamobile/cheetah/initramfs.cpio.lz4 \
         usr/lib/omamobile/cheetah/overlays/aoc-core-test.dtbo usr/share/omamobile/device-cheetah/boot-files.sources; do
  [[ -f $tmp/root-bf/$f ]] || fail "boot files: $f"
done
echo tampered >> "$bf/dtbo.img"
if OMAMOBILE_BOOT_FILES=$bf ./install "$tmp/root-bf2" "$tmp/build" 2>/dev/null; then fail "install refuses boot files that fail their checksums"; fi
pass "install ships the staged boot files for omamobile-boot-update, checked, and fails without them (OMAMOBILE_BOOT_FILES=none: development only)"

# USB is the last gateway: its route outlives an unplug, so ahead of Wi-Fi
# it sent IPv4 into a dead cable (raven, 2026-10-28).
net=vendor/systemd/network/20-usb-gadget.network
! sed -n '/^\[Network\]/,/^\[/p' "$net" | grep -c '^Gateway=' >/dev/null || fail "usb0 sets no default route in [Network] (metric 0)"
metric=$(sed -n '/^\[Route\]/,/^\[/{s/^Metric=//p}' "$net")
[[ ${metric:-0} -gt 700 ]] || fail "usb0's gateway goes after Wi-Fi (600) and mobile data (700)"
pass "USB is the last gateway"

# The modem stack at boot (MODEM-PLAN M4.6): this device's sitd drop-in
# waits for the CP's ONLINE before sitd runs (the modem unit is ready at
# CPIF's ports, before cbd has booted the CP), with the profile's own cbd
# timeout. The stack is on by default from 0.1.43: the one switch,
# omamobile-modem-boot.target (omamobile-modem), is enabled by a vendor
# wants link, as the AoC and Wi-Fi units are; the four units it wants get
# no link of their own (the target is the switch, and systemctl mask on it
# is the way off). The sit-data drop-in keeps the data fallback from a
# restart loop on a phone whose modem isn't provisioned.
d=$tmp/root/usr/lib/systemd/system/omamobile-sitd.service.d/20-cp-online.conf
[[ -f $d ]] || fail "the sitd CP-online drop-in is staged"
grep -qx 'ExecStartPre=/usr/lib/omamobile-vendor/omamobile-modem-cp wait-online 120' "$d" || fail "sitd waits for CP ONLINE with the cbd timeout"
grep -q '^\[Service\]' "$d" && ! grep -q '^\[Unit\]' "$d" || fail "the drop-in only adds to [Service]"
d=$tmp/root/usr/lib/systemd/system/omamobile-sit-data.service.d/20-cp-online.conf
[[ -f $d ]] || fail "the sit-data drop-in is staged"
grep -qx 'ConditionPathExists=/dev/umts_ipc0' "$d" || fail "sit-data is skipped without the modem's port (no restart loop on an unprovisioned phone)"
grep -q '^\[Unit\]' "$d" && ! grep -q '^\[Service\]' "$d" || fail "the sit-data drop-in only adds to [Unit]"
[[ $(readlink "$tmp/root/usr/lib/systemd/system/multi-user.target.wants/omamobile-modem-boot.target") == ../omamobile-modem-boot.target ]] \
  || fail "the modem boot target is enabled by a vendor wants link"
for n in omamobile-modem.service omamobile-modem-inhibit.service omamobile-sitd.service omamobile-sit-data.service omamobile-mmd.service; do
  [[ -z $(find "$tmp/root/usr/lib/systemd" -name "$n" -path '*.wants/*' -o -name "$n" -path '*.requires/*') ]] || fail "no wants link for $n is shipped (the target is the switch)"
done
# Call audio (0.1.44): the 7 Pro's defaults for omamobile-modem-sit route
# calls through the AoC card in the earpiece mode; modem-sit's packaged
# /etc file leaves the card unset, so this is what a fresh install gets.
d=$tmp/root/usr/lib/omamobile/modem-sit.conf.d/50-cheetah.conf
[[ -f $d ]] || fail "the modem-sit defaults are staged"
python3 -I -c 'import configparser,sys; p=configparser.ConfigParser(interpolation=None); p.read(sys.argv[1]); sys.exit(p.get("audio","card")!="auto")' "$d" \
  || fail "the 7 Pro's call audio default is card = auto"
if [[ -f ../omamobile-modem/systemd/omamobile-modem-boot.target ]]; then
  grep -qx 'WantedBy=multi-user.target' ../omamobile-modem/systemd/omamobile-modem-boot.target || fail "the link matches the target's own [Install]"
  grep -qx 'ConditionPathExists=/usr/lib/omamobile-vendor/modem/root' ../omamobile-modem/systemd/omamobile-modem.service \
    || fail "the modem unit the link turns on is skipped on a phone that isn't provisioned"
fi
pass "sitd waits for the CP; the modem stack is on by default through the target's vendor link; sit-data needs the modem's port"

# The canonical sitd unit gets its modem dependency from this device policy.
[[ -f $tmp/root/usr/lib/systemd/system/omamobile-sitd.service.d/10-device-modem.conf ]] \
  || fail "the device sitd policy is staged"
grep -q 'omamobile-sitd-policy' PKGBUILD || fail "the package provides its sitd policy capability"
pass "the device sitd policy is staged and provided"
# The USB gadget's MAC addresses stay the same across boots (omamobile-usb-mac),
# against a fake gadget: plain directories and files stand in for configfs.
for f in usr/bin/omamobile-usb-mac usr/lib/systemd/system/omamobile-usb-mac.service; do
  [[ -e $tmp/root/$f ]] || fail "install stages $f"
done
[[ $(readlink "$tmp/root/usr/lib/systemd/system/multi-user.target.wants/omamobile-usb-mac.service") == ../omamobile-usb-mac.service ]] \
  || fail "the USB address unit is enabled by a vendor wants link"
grep -qx 'WantedBy=multi-user.target' vendor/systemd/system/omamobile-usb-mac.service || fail "the link matches the unit's own [Install]"
grep -qx 'Before=network-pre.target' vendor/systemd/system/omamobile-usb-mac.service || fail "the addresses change before the network is configured"
grep -v '^[[:space:]]*#' bin/omamobile-usb-mac | grep -Ec 'serial|/proc/cpuinfo|ro\.serialno|androidboot|/proc/cmdline|device-tree' >/dev/null && fail "the USB addresses never come from an identifier of the phone"

mkgadget() {	# mkgadget DIR: a gadget like the initramfs makes it, bound to a UDC
  local g=$1
  mkdir -p "$g/configs/c.1" "$g/functions/ncm.usb0" "$g/functions/acm.GS0"
  printf '02:00:00:00:00:a1 \n' > "$g/functions/ncm.usb0/host_addr"
  printf '02:00:00:00:00:b1 \n' > "$g/functions/ncm.usb0/dev_addr"
  ln -s "$g/functions/ncm.usb0" "$g/configs/c.1/ncm.usb0"
  ln -s "$g/functions/acm.GS0" "$g/configs/c.1/acm.GS0"
  echo 11210000.usb > "$g/UDC"
}
# ln and rm are logged, so the order the functions come back in is checked
mkdir -p "$tmp/fakebin"
for c in ln; do
  printf '#!/bin/bash\necho "$(cat "$USB_GADGET/UDC" 2>/dev/null)|$(ls "$(dirname "$USB_MAC_FILE")/usb-mac-cycle-started" 2>/dev/null)|$*" >> "$USB_OPS"\nexec /usr/bin/%s "$@"\n' "$c" > "$tmp/fakebin/$c"
  chmod +x "$tmp/fakebin/$c"
done
usbmac() { PATH=$tmp/fakebin:$PATH USB_OPS=$tmp/ops USB_GADGET=$tmp/g1 USB_MAC_FILE=$tmp/state/mac USB_IFACE=nosuch0 bin/omamobile-usb-mac; }

mkgadget "$tmp/g1"; : > "$tmp/ops"
usbmac > "$tmp/usbmac.log" || { cat "$tmp/usbmac.log"; fail "omamobile-usb-mac runs"; }
host=$(sed -n 's/^host=//p' "$tmp/state/mac"); dev=$(sed -n 's/^dev=//p' "$tmp/state/mac")
for m in "$host" "$dev"; do
  [[ $m =~ ^[0-9a-f]{2}(:[0-9a-f]{2}){5}$ ]] || fail "the saved address $m is six hex pairs"
  (( (16#${m:0:2} & 3) == 2 )) || fail "the saved address $m is unicast and locally administered"
done
[[ $host != "$dev" ]] || fail "the host and phone addresses differ"
[[ $(stat -c %a "$tmp/state/mac") == 600 ]] || fail "the saved addresses are private to root"
read -r a _ < "$tmp/g1/functions/ncm.usb0/host_addr"; read -r b _ < "$tmp/g1/functions/ncm.usb0/dev_addr"
[[ $a == "$host" && $b == "$dev" ]] || fail "the gadget got the saved addresses"
[[ $(cat "$tmp/g1/UDC") == 11210000.usb ]] || fail "the UDC is bound again"
[[ -L $tmp/g1/configs/c.1/ncm.usb0 && -L $tmp/g1/configs/c.1/acm.GS0 ]] || fail "both functions are linked again"
# NCM is linked before ACM, and both while the UDC was unbound (empty before the bar)
[[ $(cut -d'|' -f1 "$tmp/ops" | sort -u) == "" ]] || fail "the functions were linked while the UDC was unbound"
# The hang marker was there while the gadget was apart, and is gone now
[[ $(cut -d'|' -f2 "$tmp/ops" | sort -u) == "$tmp/state/usb-mac-cycle-started" ]] || fail "the hang marker exists while the gadget is taken apart"
[[ ! -e $tmp/state/usb-mac-cycle-started ]] || fail "the hang marker is removed once the gadget is back together"
# The addresses are never printed in the log
grep -qiE '([0-9a-f]{2}:){5}[0-9a-f]{2}' "$tmp/usbmac.log" && fail "the log carries no MAC address"
[[ $(grep -n 'ncm.usb0' "$tmp/ops" | head -1) == 1:* ]] || fail "NCM is linked first"
[[ $(grep -n 'acm.GS0' "$tmp/ops" | head -1) == 2:* ]] || fail "ACM is linked second"

# A second boot: the kernel made new random addresses, the saved ones go back on
printf '02:00:00:00:00:c1 \n' > "$tmp/g1/functions/ncm.usb0/host_addr"
cp "$tmp/state/mac" "$tmp/mac.before"
usbmac > /dev/null || fail "omamobile-usb-mac runs on a second boot"
cmp -s "$tmp/mac.before" "$tmp/state/mac" || fail "the saved addresses are kept across boots"
read -r a _ < "$tmp/g1/functions/ncm.usb0/host_addr"
[[ $a == "$host" ]] || fail "the second boot gets the same host address"

# Already right: nothing is taken apart
: > "$tmp/ops"
usbmac > "$tmp/usbmac.log" || fail "omamobile-usb-mac runs when nothing changed"
[[ ! -s $tmp/ops ]] || fail "a gadget with the right addresses is left alone"
grep -q 'already has' "$tmp/usbmac.log" || fail "it says nothing changed"
grep -qiE '([0-9a-f]{2}:){5}[0-9a-f]{2}' "$tmp/usbmac.log" && fail "the log carries no MAC address when nothing changed"

# The previous boot hung inside the unbind or the bind: the marker is still
# there, so this boot leaves the gadget as the initramfs made it and removes it
printf '02:00:00:00:00:c1 \n' > "$tmp/g1/functions/ncm.usb0/host_addr"
date -Is > "$tmp/state/usb-mac-cycle-started"; : > "$tmp/ops"
cp "$tmp/state/mac" "$tmp/mac.before"
usbmac > "$tmp/usbmac.log" 2>&1 || { cat "$tmp/usbmac.log"; fail "omamobile-usb-mac stands aside when the last boot did not finish"; }
[[ ! -s $tmp/ops ]] || fail "a found marker means the gadget is not touched"
[[ $(cat "$tmp/g1/UDC") == 11210000.usb ]] || fail "a found marker leaves the UDC bound"
read -r a _ < "$tmp/g1/functions/ncm.usb0/host_addr"
[[ $a == "02:00:00:00:00:c1" ]] || fail "a found marker leaves the gadget as the initramfs made it"
grep -q 'did not finish' "$tmp/usbmac.log" || fail "a found marker is reported"
[[ ! -e $tmp/state/usb-mac-cycle-started ]] || fail "a found marker is removed"
cmp -s "$tmp/mac.before" "$tmp/state/mac" || fail "a found marker keeps the saved addresses"
# ... and the boot after that tries again
usbmac > /dev/null || fail "omamobile-usb-mac runs again after the marker was removed"
read -r a _ < "$tmp/g1/functions/ncm.usb0/host_addr"
[[ $a == "$host" ]] || fail "the boot after a found marker puts the saved addresses back"

# A saved file that is damaged is replaced, never half-used
printf 'host=nonsense\ndev=%s\n' "$dev" > "$tmp/state/mac"
usbmac > /dev/null || fail "omamobile-usb-mac runs with a damaged file"
host2=$(sed -n 's/^host=//p' "$tmp/state/mac")
[[ $host2 =~ ^[0-9a-f]{2}(:[0-9a-f]{2}){5}$ ]] || fail "a damaged file is replaced"
printf 'host=%s\ndev=%s\n' "$host2" "$host2" > "$tmp/state/mac"
usbmac > /dev/null || fail "omamobile-usb-mac runs with equal addresses"
[[ $(sed -n 's/^host=//p' "$tmp/state/mac") != $(sed -n 's/^dev=//p' "$tmp/state/mac") ]] || fail "equal addresses are replaced"

# The kernel refuses an address: the gadget is put back together anyway
rm -rf "$tmp/g2" "$tmp/state2"; mkgadget "$tmp/g2"
rm "$tmp/g2/functions/ncm.usb0/host_addr"; mkdir "$tmp/g2/functions/ncm.usb0/host_addr"	# a write to a directory fails, even as root
if PATH=$tmp/fakebin:$PATH USB_OPS=$tmp/ops USB_GADGET=$tmp/g2 USB_MAC_FILE=$tmp/state2/mac USB_IFACE=nosuch0 bin/omamobile-usb-mac > "$tmp/usbmac.log" 2>&1; then
  fail "a refused address is an error"
fi
[[ $(cat "$tmp/g2/UDC") == 11210000.usb ]] || fail "the UDC is bound again after a refused address"
[[ -L $tmp/g2/configs/c.1/ncm.usb0 && -L $tmp/g2/configs/c.1/acm.GS0 ]] || fail "both functions are linked again after a refused address"
grep -q 'refused host_addr' "$tmp/usbmac.log" || fail "the refusal is logged"
[[ ! -e $tmp/state2/usb-mac-cycle-started ]] || fail "a refused address is a failure, not a hang: no marker is left"

# The trap path (a start timeout's SIGTERM while the cycle is in progress):
# the gadget is put back together, but the marker stays, so a hang that systemd
# interrupts does not repeat at every boot. A fake rm sends the SIGTERM when
# the functions are unlinked.
rm -rf "$tmp/g7" "$tmp/state7"; mkgadget "$tmp/g7"
printf '#!/bin/bash\ncase "$*" in *configs*) kill -TERM $PPID; sleep 1;; esac\nexec /usr/bin/rm "$@"\n' > "$tmp/fakebin/rm"
chmod +x "$tmp/fakebin/rm"
{ PATH=$tmp/fakebin:$PATH USB_OPS=$tmp/ops USB_GADGET=$tmp/g7 USB_MAC_FILE=$tmp/state7/mac USB_IFACE=nosuch0 bin/omamobile-usb-mac > "$tmp/usbmac.log" 2>&1; } 2>/dev/null || true
rm -f "$tmp/fakebin/rm"
[[ -e $tmp/state7/usb-mac-cycle-started ]] || fail "a start interrupted by SIGTERM keeps the hang marker"
[[ $(cat "$tmp/g7/UDC") == 11210000.usb ]] || fail "the UDC is bound again after SIGTERM"
[[ -L $tmp/g7/configs/c.1/ncm.usb0 && -L $tmp/g7/configs/c.1/acm.GS0 ]] || fail "both functions are linked again after SIGTERM"
PATH=$tmp/fakebin:$PATH USB_OPS=$tmp/ops USB_GADGET=$tmp/g7 USB_MAC_FILE=$tmp/state7/mac USB_IFACE=nosuch0 bin/omamobile-usb-mac > "$tmp/usbmac.log" 2>&1 || true
grep -q 'did not finish' "$tmp/usbmac.log" || fail "the boot after SIGTERM reports the marker"
[[ ! -e $tmp/state7/usb-mac-cycle-started ]] || fail "the boot after SIGTERM removes the marker"

# usb0 gets the phone address too, and the kernel refuses that on a link that
# is up: a fake ip refuses until the link is down, then takes it and brings it up
rm -rf "$tmp/g5" "$tmp/net" "$tmp/ipstate"; mkgadget "$tmp/g5"; mkdir -p "$tmp/net/usb0" "$tmp/ipstate"
echo 02:00:00:00:00:b1 > "$tmp/net/usb0/address"; : > "$tmp/ipstate/up"
cat > "$tmp/fakebin/ip" <<'IP'
#!/bin/bash
echo "$*" >> "$IP_LOG"
case $* in
  "link set dev usb0 down") rm -f "$IP_STATE/up" ;;
  "link set dev usb0 up") : > "$IP_STATE/up" ;;
  "link set dev usb0 address "*)
    [[ -e $IP_STATE/up ]] && { echo "RTNETLINK answers: Device or resource busy" >&2; exit 2; }
    echo "${@: -1}" > "$USB_NETDIR/usb0/address" ;;
esac
IP
chmod +x "$tmp/fakebin/ip"
IP_LOG=$tmp/iplog IP_STATE=$tmp/ipstate USB_NETDIR=$tmp/net PATH=$tmp/fakebin:$PATH USB_OPS=$tmp/ops USB_GADGET=$tmp/g5 \
  USB_MAC_FILE=$tmp/state5/mac USB_IFACE=usb0 bin/omamobile-usb-mac > "$tmp/usbmac.log" 2>&1 || { cat "$tmp/usbmac.log"; fail "omamobile-usb-mac sets usb0"; }
dev5=$(sed -n 's/^dev=//p' "$tmp/state5/mac")
[[ $(cat "$tmp/net/usb0/address") == "$dev5" ]] || fail "usb0 got the phone address"
[[ -e $tmp/ipstate/up ]] || fail "usb0 is brought up again"
grep -q 'could not set' "$tmp/usbmac.log" && fail "setting usb0 does not report a failure"

# No NCM function, an unsaveable file, no gadget: it stands aside
rm -rf "$tmp/g3"; mkdir -p "$tmp/g3/configs/c.1"; echo 11210000.usb > "$tmp/g3/UDC"
PATH=$tmp/fakebin:$PATH USB_OPS=$tmp/ops USB_GADGET=$tmp/g3 USB_MAC_FILE=$tmp/state3/mac USB_IFACE=nosuch0 bin/omamobile-usb-mac > /dev/null || fail "a gadget without NCM is left alone"
[[ $(cat "$tmp/g3/UDC") == 11210000.usb ]] || fail "a gadget without NCM keeps its UDC"
rm -rf "$tmp/g4"; mkgadget "$tmp/g4"; : > "$tmp/blocker"
if PATH=$tmp/fakebin:$PATH USB_OPS=$tmp/ops USB_GADGET=$tmp/g4 USB_MAC_FILE=$tmp/blocker/mac USB_IFACE=nosuch0 bin/omamobile-usb-mac > /dev/null 2>&1; then
  fail "an address that cannot be saved is not applied"
fi
read -r a _ < "$tmp/g4/functions/ncm.usb0/host_addr"
[[ $a == "02:00:00:00:00:a1" ]] || fail "an address that cannot be saved leaves the gadget alone"
# A marker that cannot be written: the gadget is not taken apart
rm -rf "$tmp/g6" "$tmp/state6"; mkgadget "$tmp/g6"; mkdir -p "$tmp/state6"
printf 'host=02:00:00:00:00:d1\ndev=02:00:00:00:00:e1\n' > "$tmp/state6/mac"
cat > "$tmp/fakebin/date" <<'DATE'
#!/bin/bash
exit 1
DATE
chmod +x "$tmp/fakebin/date"
if PATH=$tmp/fakebin:$PATH USB_OPS=$tmp/ops USB_GADGET=$tmp/g6 USB_MAC_FILE=$tmp/state6/mac USB_IFACE=nosuch0 bin/omamobile-usb-mac > "$tmp/usbmac.log" 2>&1; then
  fail "a hang marker that cannot be written is an error"
fi
rm -f "$tmp/fakebin/date"
[[ $(cat "$tmp/g6/UDC") == 11210000.usb ]] || fail "without a marker the UDC is not unbound"
read -r a _ < "$tmp/g6/functions/ncm.usb0/host_addr"
[[ $a == "02:00:00:00:00:a1" ]] || fail "without a marker the gadget is left alone"
grep -q 'cannot write' "$tmp/usbmac.log" || fail "a marker that cannot be written is reported"
pass "the USB gadget keeps one pair of addresses across boots, is put back together when anything fails, and a hang leaves a marker that keeps the next boot from repeating it"


# Location's agent goes with its socket (2026.11.08 enabled only the socket)
grep -A1 -F 'systemctl is-enabled -q omamobile-gnss-nmea.socket' bin/omamobile-setup-system |
  grep -cF -- '--global enable omamobile-geoclue-agent.service' >/dev/null ||
  fail "omamobile-setup-system enables GeoClue's agent with the Location socket"
pass "the setup step turns GeoClue's agent on with the Location socket"
