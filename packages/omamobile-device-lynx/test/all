#!/bin/bash
# SPDX-License-Identifier: MIT
# Tests for omamobile-device-lynx. The C tools are compiled from src/ in
# this directory, so a copied package still builds. Do not execute reboot-to,
# and run omamobile-bootctl only against a synthetic devinfo.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

bash -n build || fail "build parses"
bash -n install || fail "install parses"
bash -n bin/omamobile-boot-success || fail "omamobile-boot-success parses"
bash -n bin/omamobile-bt-addr || fail "omamobile-bt-addr parses"
pass "scripts parse"

! bin/omamobile-bt-addr foo 2> /dev/null || fail "omamobile-bt-addr takes only hciN"
pass "omamobile-bt-addr refuses a name that is not a controller before touching anything"

grep -q '\.\./\.\.' build install && fail "build or install reaches outside the package directory"
pass "build and install stay inside the package directory"

if [[ -f ../omamobile-device-cheetah/src/reboot-to.c ]]; then
  cmp -s src/reboot-to.c ../omamobile-device-cheetah/src/reboot-to.c \
    || fail "reboot-to.c drifted from the cheetah package"
  pass "reboot-to.c matches the cheetah source"
  for f in src/omamobile-bootctl.c bin/omamobile-boot-success LICENSE.Apache-2.0 \
           vendor/systemd/system/omamobile-boot-success.service; do
    cmp -s "$f" "../omamobile-device-cheetah/$f" || fail "$f drifted from the cheetah package"
  done
  pass "the boot-success marker and bootctl match the cheetah package"
  cmp -s vendor/udev/rules.d/10-omamobile-storage.rules \
    ../omamobile-device-cheetah/vendor/udev/rules.d/10-omamobile-storage.rules \
    || fail "the storage rule drifted from the cheetah package"
  pass "the storage rule matches the cheetah package"
  cmp -s etc/omamobile-mirrorlist ../omamobile-device-cheetah/etc/omamobile-mirrorlist \
    || fail "the mirrorlist drifted from the cheetah package"
  pass "the mirrorlist matches the cheetah package"
  cmp -s <(sed -n '/^# --- the \[omamobile\] channel/,$p' omamobile-device-lynx.install) \
    <(sed -n '/^# --- the \[omamobile\] channel/,$p' ../omamobile-device-cheetah/omamobile-device-cheetah.install) \
    || fail "the install script's channel handling drifted from the cheetah package"
  pass "the install script keeps the [omamobile] channel as the cheetah package does"
  cmp -s vendor/systemd/logind.conf.d/10-omamobile-power-key.conf \
    ../omamobile-device-cheetah/vendor/systemd/logind.conf.d/10-omamobile-power-key.conf \
    || fail "the power-key drop-in drifted from the cheetah package"
  pass "the power-key drop-in matches the cheetah package"
  cmp -s vendor/systemd/sleep.conf.d/10-omamobile.conf \
    ../omamobile-device-cheetah/vendor/systemd/sleep.conf.d/10-omamobile.conf \
    || fail "the sleep drop-in drifted from the cheetah package"
  pass "the sleep drop-in matches the cheetah package"
  cmp -s omamobile-device-lynx.install \
    ../omamobile-device-cheetah/omamobile-device-cheetah.install \
    || fail "the pacman install script drifted from the cheetah package"
  pass "the pacman install script matches the cheetah package"
fi
grep -q 'omamobile-keyring' PKGBUILD || fail "pacman needs omamobile-keyring"
grep -q '^install=omamobile-device-lynx.install$' PKGBUILD \
  || fail "the pacman install script is not named"
[[ -f etc/omamobile-mirrorlist && -f omamobile-device-lynx.install ]] \
  || fail "the pacman mirrorlist or install script is missing"
pass "pacman gets the keyring, the mirrorlist, and the install script"
if [[ -f ../../device/lynx/device.conf ]]; then
  cmp -s device.conf ../../device/lynx/device.conf \
    || fail "device.conf drifted from the descriptor"
  pass "device.conf matches the descriptor"
fi

./build "$tmp/build" || fail "C tools compile"
[[ -x $tmp/build/reboot-to && -x $tmp/build/omamobile-bootctl ]] || fail "the C tools are not executable"
pass "C tools compile"

# omamobile-bootctl against a synthetic devinfo laid out like lynx's
# (version 3.15): a dry run of mark-successful plans one byte, writes nothing
python3 - "$tmp/devinfo" <<'PY2'
import struct, sys
buf = bytearray(8192)
buf[0:4] = b"DEVI"
struct.pack_into("<HH", buf, 4, 3, 15)
buf[0x30:0x34] = bytes([2, 0x0a, 0, 0])   # slot a: successful, active-bit off
buf[0x34:0x38] = bytes([1, 0x04, 0, 0])   # slot b: active, not successful
open(sys.argv[1], "wb").write(buf)
PY2
cp "$tmp/devinfo" "$tmp/devinfo.orig"
"$tmp/build/omamobile-bootctl" dump "$tmp/devinfo" | grep -c 'version: 3.15' >/dev/null || fail "bootctl decodes devinfo"
plan=$("$tmp/build/omamobile-bootctl" mark-successful "$tmp/devinfo" b 2>&1 || true)
grep -q '0x35: 04 -> 06' <<<"$plan" || fail "mark-successful plans one byte (0x35: 04 -> 06)"
cmp -s "$tmp/devinfo" "$tmp/devinfo.orig" || fail "a dry run writes nothing"
pass "bootctl dry run plans one byte and writes nothing"

# 3.11: lynx units still on the Android 15 bootloader.
python3 - "$tmp/devinfo311" <<'PY3'
import struct, sys
buf = bytearray(8192)
buf[0:4] = b"DEVI"
struct.pack_into("<HH", buf, 4, 3, 11)
buf[0x30:0x34] = bytes([3, 0x00, 0, 0])
buf[0x34:0x38] = bytes([0, 0x0c, 0, 0])
open(sys.argv[1], "wb").write(buf)
PY3
cc -O2 -DOMAMOBILE_DEVINFO_EXTRA_MINOR=11 -o "$tmp/bootctl311" \
  src/omamobile-bootctl.c
cp "$tmp/devinfo311" "$tmp/devinfo311.orig"
"$tmp/bootctl311" dump "$tmp/devinfo311" | grep -c 'version: 3.11' >/dev/null \
  || fail "bootctl decodes devinfo 3.11"
plan=$("$tmp/bootctl311" mark-successful "$tmp/devinfo311" b 2>&1 || true)
grep -q '0x35: 0c -> 0e' <<<"$plan" || fail "3.11 mark-successful plans one byte"
cmp -s "$tmp/devinfo311" "$tmp/devinfo311.orig" || fail "a 3.11 dry run writes nothing"
pass "bootctl accepts devinfo 3.11"

# An unknown layout must still be refused.
python3 - "$tmp/devinfo314" <<'PY4'
import struct, sys
buf = bytearray(8192)
buf[0:4] = b"DEVI"
struct.pack_into("<HH", buf, 4, 3, 14)
open(sys.argv[1], "wb").write(buf)
PY4
out=$("$tmp/build/omamobile-bootctl" mark-successful "$tmp/devinfo314" b 2>&1 || true)
grep -c 'refusing to write' <<<"$out" >/dev/null \
  || fail "an unverified 3.14 layout was not refused"
if grep -q 'bytes to change' <<<"$out"; then
  fail "an unverified 3.14 layout was planned"
fi
out=$("$tmp/build/omamobile-bootctl" mark-successful "$tmp/devinfo311" b --i-understand 2>&1 || true)
grep -c 'refusing to write' <<<"$out" >/dev/null \
  || fail "the shipped build accepted 3.11"
if grep -q 'OMAMOBILE_DEVINFO_EXTRA_MINOR' build; then
  fail "build still passes the 3.11 define"
fi
pass "bootctl refuses 3.14 and the shipped build refuses 3.11"

# Use an otherwise eligible, active B to check that 3.19 stays read-only on lynx.
python3 - "$tmp/devinfo" "$tmp/devinfo319" <<'PY'
from pathlib import Path
import sys

image = bytearray(Path(sys.argv[1]).read_bytes())
image[6:8] = (19).to_bytes(2, 'little')
Path(sys.argv[2]).write_bytes(image)
PY
cp "$tmp/devinfo319" "$tmp/devinfo319.orig"
if "$tmp/build/omamobile-bootctl" mark-successful "$tmp/devinfo319" b --i-understand >"$tmp/refusal" 2>&1; then
  fail "the lynx build accepted devinfo 3.19"
fi
grep -q 'refusing to write' "$tmp/refusal" && cmp -s "$tmp/devinfo319.orig" "$tmp/devinfo319" \
  || fail "the lynx build must refuse 3.19 without changing the image"
pass "cheetah's devinfo 3.19 support stays out of the lynx build"

./install "$tmp/root" "$tmp/build"
for f in usr/bin/reboot-to usr/bin/omamobile-bootctl usr/bin/omamobile-boot-success \
         usr/lib/systemd/system/omamobile-boot-success.service \
         usr/share/licenses/omamobile-device-lynx/LICENSE.Apache-2.0 \
         usr/lib/udev/rules.d/10-omamobile-storage.rules \
         usr/bin/omamobile-bt-addr \
         usr/lib/systemd/system/omamobile-bt-addr@.service \
         usr/lib/udev/rules.d/80-omamobile-bt-addr.rules \
         usr/lib/systemd/network/20-usb-gadget.network \
         usr/lib/systemd/logind.conf.d/10-omamobile-power-key.conf \
         usr/lib/systemd/sleep.conf.d/10-omamobile.conf \
         usr/lib/NetworkManager/conf.d/10-omamobile-usb.conf \
         usr/share/omamobile/device.conf \
         usr/share/omamobile/device-lynx/version \
         usr/share/licenses/omamobile-device-lynx/LICENSE \
         etc/pacman.d/omamobile-mirrorlist; do
  [[ -f $tmp/root/$f ]] || fail "install stages $f"
done
grep -q 'KERNEL=="sda", MODE="0000"' "$tmp/root/usr/lib/udev/rules.d/10-omamobile-storage.rules" \
  || fail "the whole-disk node is made inaccessible"
grep -q 'ID_PART_ENTRY_NAME}!="userdata"' "$tmp/root/usr/lib/udev/rules.d/10-omamobile-storage.rules" \
  || fail "userdata is the only partition desktop tools may see"
grep -q 'Address=172.16.42.1/24' "$tmp/root/usr/lib/systemd/network/20-usb-gadget.network" \
  || fail "usb0 keeps the initramfs address"
power="$tmp/root/usr/lib/systemd/logind.conf.d/10-omamobile-power-key.conf"
grep -qx '\[Login\]' "$power" \
  || fail "the power-key drop-in needs a [Login] header"
grep -q '^HandlePowerKey=ignore$' "$power" \
  || fail "a short press must not power the phone off"
grep -q '^HandlePowerKeyLongPress=ignore$' "$power" \
  || fail "the long press stays the PMIC reset"
grep -qx 'MemorySleepMode=s2idle' "$tmp/root/usr/lib/systemd/sleep.conf.d/10-omamobile.conf" \
  || fail "sleep is s2idle: gs201's deep sleep never wakes"
grep -q '^PACKAGE=omamobile-device-lynx$' "$tmp/root/usr/share/omamobile/device.conf" \
  || fail "the installed descriptor is lynx"
grep -q 'DRIVERS=="hci_uart_qca"' "$tmp/root/usr/lib/udev/rules.d/80-omamobile-bt-addr.rules" \
  || fail "the address rule matches the WCN6855 controller only"
grep -qx 'Before=bluetooth.service' "$tmp/root/usr/lib/systemd/system/omamobile-bt-addr@.service" \
  || fail "the address is set before bluetoothd starts"
[[ $(readlink "$tmp/root/usr/lib/systemd/system/multi-user.target.wants/omamobile-boot-success.service") == ../omamobile-boot-success.service ]] \
  || fail "the boot-success unit is enabled by a vendor wants link"
for absent in usr/bin/omamobile-wifi-start usr/bin/omamobile-charge-guard \
              usr/bin/omamobile-camera-start; do
  [[ ! -e $tmp/root/$absent ]] || fail "install includes $absent"
done
[[ -f $tmp/root/usr/lib/modprobe.d/omamobile-display.conf ]] \
  || fail "install stages the display modprobe file"
[[ -x $tmp/root/usr/bin/omamobile-lynx-display-start ]] \
  || fail "install stages the display start script"
[[ -f $tmp/root/usr/lib/systemd/system/omamobile-lynx-display.service ]] \
  || fail "install stages the display service"
grep -qx 'ConditionPathExists=/sys/bus/platform/devices/1c240000.display-controller' \
  "$tmp/root/usr/lib/systemd/system/omamobile-lynx-display.service" \
  || fail "the display unit names the DECON node"
[[ $(readlink "$tmp/root/usr/lib/systemd/system/multi-user.target.wants/omamobile-lynx-display.service") == ../omamobile-lynx-display.service ]] \
  || fail "the display service is enabled"
# The panel gate: allow only the S6E3FC5 names, create the parameter
# through modprobe first, and load gs_decon after the write.
gate=$tmp/panel-gate
mkdir -p "$gate/proc" "$gate/bin"
cat > "$gate/bin/modprobe" <<'FAKE'
#!/bin/bash
echo "$1 allow=$(cat "$OMAMOBILE_LYNX_ROOT/sys/module/gs_dsim_cmd/parameters/allow_tx" 2>/dev/null || echo none)" >> "$TEST_LOG"
p=$OMAMOBILE_LYNX_ROOT/sys/module/gs_dsim_cmd/parameters
mkdir -p "$p"
[[ -e $p/allow_tx ]] || echo 0 > "$p/allow_tx"
if [[ $1 == gs_decon ]]; then
  d=$OMAMOBILE_LYNX_ROOT/sys/bus/platform/devices/1c240000.display-controller
  mkdir -p "$d" "$OMAMOBILE_LYNX_ROOT/sys/bus/platform/drivers/gs-decon"
  ln -sfn "$OMAMOBILE_LYNX_ROOT/sys/bus/platform/drivers/gs-decon" "$d/driver"
fi
FAKE
chmod +x "$gate/bin/modprobe"
for pair in "sdc-s6e3fc5.20800a:1" "sdc-s6e3fc3-l10:0" ":0"; do
  panel=${pair%:*}; want=${pair##*:}
  echo "console=null ${panel:+exynos_drm.panel_name=$panel} bootconfig" > "$gate/proc/cmdline"
  rm -rf "$gate/sys" "$gate/var"
  mkdir -p "$gate/sys/class/backlight/panel"
  echo 900 > "$gate/sys/class/backlight/panel/brightness"
  : > "$gate/calls"
  out=$(TEST_LOG=$gate/calls PATH="$gate/bin:$PATH" OMAMOBILE_LYNX_ROOT=$gate \
    bin/omamobile-lynx-display-start 2>&1)
  got=$(cat "$gate/sys/module/gs_dsim_cmd/parameters/allow_tx" 2>/dev/null || echo missing)
  [[ $got == "$want" ]] || fail "panel '${panel:-none}' wrote allow_tx=$got, want $want"
  grep -qx "gs_decon allow=$want" "$gate/calls" \
    || fail "gs_decon was not loaded after allow_tx=$want for '${panel:-none}': $(cat "$gate/calls")"
  if [[ $want == 1 ]]; then
    [[ $out == *"brightness of panel: level 900 sent"* ]] \
      || fail "the saved brightness is not sent for '${panel:-none}': $out"
  else
    [[ $out != *brightness* ]] || fail "brightness sent with DSI commands off for '${panel:-none}': $out"
  fi
done
grep -qx 'blacklist gs_decon' vendor/modprobe.d/omamobile-display.conf \
  || fail "gs_decon is not blacklisted for autoload"
# Already loaded this boot: no second load.
mkdir -p "$gate/sys/module/gs_decon"
out=$(TEST_LOG=$gate/calls PATH="$gate/bin:$PATH" OMAMOBILE_LYNX_ROOT=$gate \
  bin/omamobile-lynx-display-start 2>&1)
[[ $out == *"already started this boot"* ]] || fail "a loaded gs_decon is loaded again: $out"
rm -rf "$gate/sys/module/gs_decon"

# A marker from a load that never returned: nothing is loaded until --retry.
mkdir -p "$gate/var/lib/omamobile"
echo "2026-11-15T00:00:00+00:00 display" > "$gate/var/lib/omamobile/lynx-display-started"
: > "$gate/calls"
out=$(TEST_LOG=$gate/calls PATH="$gate/bin:$PATH" OMAMOBILE_LYNX_ROOT=$gate \
  bin/omamobile-lynx-display-start 2>&1)
[[ $out == *"never finished"* && ! -s "$gate/calls" ]] \
  || fail "a stale marker did not stop the load: $out / $(cat "$gate/calls")"
out=$(TEST_LOG=$gate/calls PATH="$gate/bin:$PATH" OMAMOBILE_LYNX_ROOT=$gate \
  bin/omamobile-lynx-display-start --retry 2>&1)
[[ $out == *"up: display"* && ! -e "$gate/var/lib/omamobile/lynx-display-started" ]] \
  || fail "--retry did not clear the marker and load: $out"

pass "the panel gate allows only S6E3FC5"

pass "install stages the udev rules, the USB link, the mirrorlist, the boot-success marker, the Bluetooth address unit and the display gate, and no radio"

# USB is the last gateway: its route outlives an unplug, so ahead of Wi-Fi
# it sent IPv4 into a dead cable (seen on raven, 2026-10-28).
net=vendor/systemd/network/20-usb-gadget.network
! sed -n '/^\[Network\]/,/^\[/p' "$net" | grep -c '^Gateway=' >/dev/null || fail "usb0 sets no default route in [Network] (metric 0)"
metric=$(sed -n '/^\[Route\]/,/^\[/{s/^Metric=//p}' "$net")
[[ ${metric:-0} -gt 700 ]] || fail "usb0's gateway goes after Wi-Fi (600) and mobile data (700)"
pass "USB is the last gateway"
