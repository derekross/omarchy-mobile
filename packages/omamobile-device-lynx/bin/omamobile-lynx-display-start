#!/bin/bash
# SPDX-License-Identifier: MIT
# Allow the panel's DSI commands only when the bootloader names the
# S6E3FC5 panel on the kernel command line. Lynx also ships S6E3FC3
# panels, and S6E3FC5 brightness/refresh commands must never reach one.
# OMAMOBILE_LYNX_ROOT: a scratch root for the package tests.
set -uo pipefail

root=${OMAMOBILE_LYNX_ROOT:-}
[[ -z $root || ( $root == /* && $root != / && -d $root ) ]] || exit 2

cmdline=$root/proc/cmdline
allow=$root/sys/module/gs_dsim_cmd/parameters/allow_tx
panel=""

for word in $(cat "$cmdline" 2>/dev/null); do
  case $word in
    exynos_drm.panel_name=*) panel=${word#*=} ;;
  esac
done

case $panel in
  sdc-s6e3fc5|sdc-s6e3fc5.*|s6e3fc5|s6e3fc5.*)
    if echo 1 > "$allow" 2>/dev/null; then
      echo "omamobile-lynx-display: panel $panel, DSI commands allowed"
    else
      echo "omamobile-lynx-display: panel $panel, cannot write $allow; leaving it read-only"
      exit 1
    fi
    ;;
  *)
    echo "omamobile-lynx-display: panel ${panel:-unnamed}, DSI commands stay off"
    ;;
esac
