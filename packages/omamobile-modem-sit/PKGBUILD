pkgname=omamobile-modem-sit
pkgver=$(cat "${startdir:-.}/.pkgver" 2>/dev/null || "${startdir:-.}/../../tools/pkg-version" "${startdir:-.}")
pkgrel=1
pkgdesc="Omarchy Mobile SIT RIL for the Pixel 7 Pro's S5300: LTE registration, IMS calls and SMS, cellular data on rmnet0"
arch=(aarch64)
url="https://github.com/derekross/omarchy-mobile"
license=(MIT)
# mobile-broadband-provider-info: the carrier database the automatic APN
# reads (GNOME, CC-PDDC; arch "any", NetworkManager already pulls it in).
# polkit: the Mobile network page's helper runs through pkexec.
depends=(python iproute2 iputils systemd alsa-lib alsa-utils 'omamobile-modem>=0.1.11' omamobile-sitd-policy
         mobile-broadband-provider-info polkit)
backup=(etc/omamobile/modem-sit.conf)
install=omamobile-modem-sit.install

check() {
  "$startdir/test/all"
}

package() {
  "$startdir/install" "$pkgdir"
}
