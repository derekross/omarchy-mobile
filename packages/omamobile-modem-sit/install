#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omamobile-modem-sit into DESTDIR. Enables nothing.
#   ./install DESTDIR
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
d=${1:?Usage: ./install DESTDIR}
[[ $d == /* && $d != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
for f in bin/*; do install -Dm755 "$f" "$d/usr/bin/${f#bin/}"; done
for f in lib/*.py; do install -Dm644 "$f" "$d/usr/lib/omamobile-sit/${f#lib/}"; done
# The Mobile network page's helper (pkexec, polkit action below) and the
# carrier overrides the automatic APN reads before the carrier database.
install -Dm755 lib/omamobile-sit-config "$d/usr/lib/omamobile-sit/omamobile-sit-config"
install -Dm644 polkit/org.omamobile.modem-sit.policy "$d/usr/share/polkit-1/actions/org.omamobile.modem-sit.policy"
install -Dm644 share/apn-overrides.conf "$d/usr/share/omamobile/modem-sit/apn-overrides.conf"
for f in systemd/*.service; do install -Dm644 "$f" "$d/usr/lib/systemd/system/${f#systemd/}"; done
install -Dm755 systemd/system-sleep/omamobile-modem-sit "$d/usr/lib/systemd/system-sleep/omamobile-modem-sit"
install -Dm644 networkmanager/90-omamobile-rmnet.conf "$d/usr/lib/NetworkManager/conf.d/90-omamobile-rmnet.conf"
install -Dm644 etc/omamobile/modem-sit.conf "$d/etc/omamobile/modem-sit.conf"
install -Dm644 LICENSE "$d/usr/share/licenses/omamobile-modem-sit/LICENSE"
install -Dm644 version "$d/usr/share/omamobile/modem-sit/version"
