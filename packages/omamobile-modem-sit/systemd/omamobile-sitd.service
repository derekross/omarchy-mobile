# SPDX-License-Identifier: MIT
# The SIT RIL: registers a freshly booted CP (SIM, attach APN, LTE, internet
# bearer, IMS) and then serves calls and SMS on /run/omamobile-sit/socket.
# Not enabled by the package: MODEM-PLAN.md M4 enables it after the gated
# first runs. It needs the modem unit's CP ONLINE and never restarts on its
# own: a second start-up on the same CP is not supported (reboot instead).
[Unit]
Description=Omarchy Mobile SIT RIL (S5300 calls, SMS, registration)
# The device modem-policy package supplies its modem dependency as a drop-in.
# Tegu checks an already running modem; cheetah/raven retain their starter.
After=omamobile-audio.service
ConditionPathExists=/dev/umts_ipc0

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/omamobile-sitd --bringup
Restart=no
# SIM, registration and IMS can take minutes on a fresh CP.
TimeoutStartSec=15min
# Time to hang up a call and restore the audio routes.
TimeoutStopSec=60
RuntimeDirectory=omamobile-sit
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=omamobile-sit
StateDirectoryMode=0700
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
