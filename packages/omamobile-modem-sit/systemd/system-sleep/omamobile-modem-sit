"""systemd-sleep hook: tell the modem the screen is off before the AP sleeps.

omamobile-sitd follows the backlight every 2 s, so a sleep that starts
sooner (systemctl suspend with the panel lit, or within 2 s of it going
dark) left the modem on its screen-on reports, each one a wake
(MODEM-PLAN 7.4). The request holds sitd's own check off for 10 s; after
the wake that check tells the modem "on" again if the panel is lit. The
hold counts on CLOCK_MONOTONIC, which stops during the freeze, so after a
short sleep the modem can stay on "screen off" for the rest of the 10 s
with the panel lit. A
refusal (a call in progress) or a missing sitd is fine: the sleep goes
ahead either way, and so does a phone without [control] follow_screen = yes
in modem-sit.conf, where sitd sends nothing.
"""
import json
import os
import socket
import sys

RUN = os.environ.get('OMAMOBILE_SIT_RUN', '/run/omamobile-sit')


def main(argv):
    if len(argv) < 2 or argv[1] != 'pre':
        return 0
    path = os.path.join(RUN, 'socket')
    if not os.path.exists(path):
        return 0
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(6)
            client.connect(path)
            client.sendall(json.dumps(dict(action='screen-state', on=False, hold=10)).encode() + b'\n')
            data = b''
            while b'\n' not in data:
                chunk = client.recv(4096)
                if not chunk:
                    break
                data += chunk
        reply = json.loads(data or b'{}')
        if not reply.get('ok'):
            result = 'not told: ' + str(reply.get('error') or 'no reply')
        elif (reply.get('result') or {}).get('following') is False:
            result = 'not told: follow_screen is off in modem-sit.conf'
        else:
            result = 'told'
    except (OSError, ValueError) as e:
        result = 'not told: ' + type(e).__name__
    print('omamobile-modem-sit: screen off before sleep', result, flush=True)
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
