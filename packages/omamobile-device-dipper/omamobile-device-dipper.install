# SPDX-License-Identifier: MIT
# Add the [omamobile] repository to pacman.conf, before [omarchy] so its
# builds (e.g. Mesa with Mali-G710 support) win. Added once; never removed
# automatically, so a user's edits stay.
add_repository() {
  local conf=/etc/pacman.conf
  grep -q '^\[omamobile\]' "$conf" && return
  local entry='[omamobile]\nInclude = /etc/pacman.d/omamobile-mirrorlist\n'
  if grep -q '^\[omarchy\]' "$conf"; then
    sed -i "0,/^\[omarchy\]/s//${entry//\//\\/}\n[omarchy]/" "$conf"
  elif grep -q '^\[core\]' "$conf"; then
    sed -i "0,/^\[core\]/s//${entry//\//\\/}\n[core]/" "$conf"
  else
    printf '\n[omamobile]\nInclude = /etc/pacman.d/omamobile-mirrorlist\n' >>"$conf"
  fi
}

# The identity service makes the image device-agnostic (it reads this phone's
# own addresses from `persist`); the tailnet join is a no-op without a key.
enable_units() {
  systemctl enable omamobile-dipper-identity.service >/dev/null 2>&1 || true
  systemctl enable omamobile-tailscale-join.service >/dev/null 2>&1 || true
}

post_install() {
  add_repository
  enable_units
}

post_upgrade() {
  add_repository
  enable_units
}
