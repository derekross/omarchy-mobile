#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omamobile-device-dipper into DESTDIR. Nothing is enabled that would
# mark a slot successful or start the radio, the charger, or a camera.
#   ./install DESTDIR [BUILDDIR]
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
destination=${1:?Usage: ./install DESTDIR [BUILDDIR]}
build=${2:-build-output}
[[ $destination == /* && $destination != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
install -Dm755 "$build/reboot-to" "$destination/usr/bin/reboot-to"
install -Dm644 vendor/udev/rules.d/10-omamobile-storage.rules \
  "$destination/usr/lib/udev/rules.d/10-omamobile-storage.rules"
install -Dm644 vendor/systemd/network/20-usb-gadget.network \
  "$destination/usr/lib/systemd/network/20-usb-gadget.network"
install -Dm644 vendor/systemd/system.conf.d/10-omamobile-watchdog.conf \
  "$destination/usr/lib/systemd/system.conf.d/10-omamobile-watchdog.conf"
install -Dm644 vendor/systemd/logind.conf.d/10-omamobile-power-key.conf \
  "$destination/usr/lib/systemd/logind.conf.d/10-omamobile-power-key.conf"
install -Dm644 vendor/NetworkManager/conf.d/10-omamobile-usb.conf \
  "$destination/usr/lib/NetworkManager/conf.d/10-omamobile-usb.conf"
# This phone's own WLAN and Bluetooth addresses are read from `persist` at boot,
# so the image stays identical for every Mi 8.
install -Dm755 bin/omamobile-dipper-identity "$destination/usr/local/bin/omamobile-dipper-identity"
install -Dm644 vendor/systemd/system/omamobile-dipper-identity.service \
  "$destination/usr/lib/systemd/system/omamobile-dipper-identity.service"
# Unattended tailnet join, driven entirely by /etc/omamobile/tailscale.conf.
install -Dm755 bin/omamobile-tailscale-join "$destination/usr/local/bin/omamobile-tailscale-join"
install -Dm644 vendor/systemd/system/omamobile-tailscale-join.service \
  "$destination/usr/lib/systemd/system/omamobile-tailscale-join.service"
install -Dm644 etc/omamobile/tailscale.conf.example \
  "$destination/usr/share/omamobile/tailscale.conf.example"
install -Dm644 device.conf \
  "$destination/usr/share/omamobile/device.conf"
install -Dm644 etc/omamobile-mirrorlist \
  "$destination/etc/pacman.d/omamobile-mirrorlist"
install -Dm644 LICENSE "$destination/usr/share/licenses/omamobile-device-dipper/LICENSE"
install -Dm644 version "$destination/usr/share/omamobile/device-dipper/version"
