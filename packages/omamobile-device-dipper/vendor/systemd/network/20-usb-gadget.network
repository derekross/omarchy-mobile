# SPDX-License-Identifier: MIT
# Omarchy Mobile: USB networking to the host. The initramfs sets up the USB
# gadget (CDC NCM) before handing over to Arch; this gives it an address.
# The host shares its internet over this link (NetworkManager "shared"
# mode on 172.16.42.2), so it is also the gateway. DNS goes to public resolvers.
[Match]
Name=usb0

[Network]
Address=172.16.42.1/24
DNS=1.1.1.1
DNS=9.9.9.9
ConfigureWithoutCarrier=yes

# Default route via the host, but a high metric so Wi-Fi/ethernet (metric ~600)
# win when present; USB stays the fallback internet path.
[Route]
Gateway=172.16.42.2
Metric=1000
