#!/bin/bash
# SPDX-License-Identifier: MIT
# Static checks for omamobile-waydroid: syntax, the staged layout, the kernel
# check against good and bad configs, and the hardening against a synthetic
# copy of the Waydroid lines it edits (Waydroid itself is GPL and not in this
# repository). With KCONFIG=path, also checks a real kernel .config.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { echo "FAIL: $*" >&2; exit 1; }
for f in bin/omamobile-waydroid lib/omamobile-waydroid-check install omamobile-waydroid.install etc/omamobile/waydroid.conf; do
  bash -n "$f" || fail "syntax: $f"
done
for f in lib/omamobile-waydroid-harden lib/omamobile-waydroid-mesa; do
  python3 -I -c 'import ast, sys; ast.parse(open(sys.argv[1]).read())' "$f" || fail "python: $f"
done

t=$(mktemp -d); trap 'rm -rf "$t"' EXIT

# Staged layout
./install "$t/stage"
for f in usr/bin/omamobile-waydroid usr/lib/omamobile-waydroid/omamobile-waydroid-check \
         usr/lib/omamobile-waydroid/omamobile-waydroid-harden usr/lib/omamobile-waydroid/omamobile-waydroid-mesa \
         usr/share/omamobile-waydroid/lxc-omamobile.conf \
         usr/lib/systemd/system/waydroid-container.service.d/omamobile.conf \
         usr/share/libalpm/hooks/90-omamobile-waydroid.hook etc/omamobile/waydroid.conf \
         usr/share/licenses/omamobile-waydroid/LICENSE usr/share/omamobile/waydroid/version; do
  [[ -e $t/stage/$f ]] || fail "not staged: $f"
done
grep -q 'lxc-omamobile.conf' lib/omamobile-waydroid-harden || fail "harden does not include lxc-omamobile.conf"
grep -qx 'lxc.cgroup2.devices.deny = b \*:\* rwm' lib/lxc-omamobile.conf || fail "block devices not denied"
# LXC 7 allows nothing when there is only a deny rule, so the file carries an
# allow list. Block devices stay out because no rule allows a "b" device; the
# deny line covers an "allow = a" placed before the include. What must never
# appear is a global allow: after the include it would clear every rule above.
grep -q '^lxc.cgroup2.devices.allow = c ' lib/lxc-omamobile.conf || fail "lxc-omamobile.conf: no allow lines (LXC 7 would allow nothing)"
grep -qx 'lxc.cgroup2.devices.allow = c 1:3 rwm' lib/lxc-omamobile.conf || fail "/dev/null not allowed"
if grep -Eq '^[[:space:]]*lxc.cgroup2.devices.allow[[:space:]]*=[[:space:]]*(a|c \*:\*)' lib/lxc-omamobile.conf; then fail "lxc-omamobile.conf opens every device"; fi
if grep -Eq '^[[:space:]]*lxc.cgroup2.devices.allow[[:space:]]*=[[:space:]]*b' lib/lxc-omamobile.conf; then fail "lxc-omamobile.conf allows block devices"; fi

# Kernel check: every option it wants, then one missing
sed -n 's/^ *want \([A-Z0-9_]*\) \([ym]*\) .*/CONFIG_\1=\2/p' lib/omamobile-waydroid-check | sed 's/=ym$/=m/' > "$t/config"
for loop in 'PID_NS NET_NS IPC_NS UTS_NS' \
            'IP_NF_FILTER IP_NF_MANGLE IP_NF_RAW IP_NF_NAT IP6_NF_FILTER IP6_NF_MANGLE IP6_NF_RAW'; do
  for o in $loop; do echo "CONFIG_$o=y" >> "$t/config"; done
done
for o in NETFILTER_XT_MARK NETFILTER_XT_CONNMARK NETFILTER_XT_MATCH_OWNER NETFILTER_XT_MATCH_QUOTA \
         NETFILTER_XT_MATCH_BPF NETFILTER_XT_MATCH_PKTTYPE NETFILTER_XT_MATCH_U32 \
         NETFILTER_XT_TARGET_IDLETIMER NETFILTER_XT_TARGET_TCPMSS NETFILTER_XT_MATCH_SOCKET; do
  echo "CONFIG_$o=m" >> "$t/config"
done
CONFIG_FILE=$t/config lib/omamobile-waydroid-check > "$t/ok.log" || { cat "$t/ok.log"; fail "check rejects a complete config"; }
# binderfs's major is assigned at boot, so the conf names binder, vndbinder and
# hwbinder by path (LXC reads their numbers when the container starts) and the
# check wants those three lines. A hard-coded binder major must not come back,
# and a "c N:*" line (5, 136, or a stale binder major) must not satisfy it.
for n in binder vndbinder hwbinder; do
  grep -qx "lxc.cgroup2.devices.allow = /dev/binderfs/$n rwm" lib/lxc-omamobile.conf || fail "lxc-omamobile.conf: $n is not allowed by path"
done
[[ $(grep -Ec '^lxc.cgroup2.devices.allow = c [0-9]+:\* rwm$' lib/lxc-omamobile.conf) == 2 ]] \
  || fail "lxc-omamobile.conf has a 'c N:*' line besides tty (5) and pts (136): a hard-coded binder major?"
CONFIG_FILE=$t/config LXC_CONF=lib/lxc-omamobile.conf RENDER_RDEV=226:128 lib/omamobile-waydroid-check > "$t/binder.log" \
  || { cat "$t/binder.log"; fail "check rejects the shipped binder and render allow lines"; }
for n in binder vndbinder hwbinder; do
  grep -q "^ok    /dev/binderfs/$n is allowed" "$t/binder.log" || fail "check does not report $n"
  grep -v "^lxc.cgroup2.devices.allow = /dev/binderfs/$n rwm\$" lib/lxc-omamobile.conf > "$t/no-binder.conf"
  if CONFIG_FILE=$t/config LXC_CONF=$t/no-binder.conf RENDER_RDEV=226:128 lib/omamobile-waydroid-check > "$t/binder.log"; then
    fail "check passes with the $n line deleted"
  fi
  grep -q "^MISS  /dev/binderfs/$n is not allowed" "$t/binder.log" || fail "check does not name the missing $n line"
done
# the old form, a binder major, is not enough
sed 's|^lxc.cgroup2.devices.allow = /dev/binderfs/binder rwm$|lxc.cgroup2.devices.allow = c 507:* rwm|' lib/lxc-omamobile.conf > "$t/old-binder.conf"
if CONFIG_FILE=$t/config LXC_CONF=$t/old-binder.conf RENDER_RDEV=226:128 lib/omamobile-waydroid-check > /dev/null; then
  fail "check passes with a binder major instead of the binder path"
fi
# The render node: its major and minor must be the ones the conf allows
CONFIG_FILE=$t/config LXC_CONF=lib/lxc-omamobile.conf RENDER_RDEV=226:128 lib/omamobile-waydroid-check | grep -c '^ok    render node 226:128 is allowed' >/dev/null \
  || fail "check does not report the render node"
if CONFIG_FILE=$t/config LXC_CONF=lib/lxc-omamobile.conf RENDER_RDEV=226:129 lib/omamobile-waydroid-check > "$t/binder.log"; then
  fail "check passes when the render node is not the allowed one"
fi
grep -q '^MISS  render node 226:129 is not allowed' "$t/binder.log" || fail "check does not name the render node that is not allowed"
grep -v '^CONFIG_NETFILTER_XTABLES_LEGACY=' "$t/config" > "$t/bad"
if CONFIG_FILE=$t/bad lib/omamobile-waydroid-check > "$t/bad.log"; then fail "check accepts a config without legacy xtables"; fi
grep -q '^MISS  NETFILTER_XTABLES_LEGACY=unset' "$t/bad.log" || fail "check does not name the missing option"
if [[ -n ${KCONFIG:-} ]]; then CONFIG_FILE=$KCONFIG lib/omamobile-waydroid-check || fail "$KCONFIG lacks Waydroid options"; fi

# Hardening against synthetic copies of the edited lines
r=$t/root
mkdir -p "$r/usr/lib/waydroid/tools/helpers" "$r/usr/lib/waydroid/tools/actions" "$r/var/lib/waydroid/lxc/waydroid"
cat > "$r/usr/lib/waydroid/tools/helpers/lxc.py" <<'PY'
def generate_nodes_lxc_config(args):
    for n in glob.glob("/dev/fb*"):
        make_entry(n)
    for n in glob.glob("/dev/video*"):
        make_entry(n)
    make_entry("/sys/kernel/debug", options="rbind,create=dir,optional 0 0")
    return nodes
PY
cat > "$r/usr/lib/waydroid/tools/actions/container_manager.py" <<'PY'
def set_permissions(args, perm_list=None, mode="777"):
    if not perm_list:
        perm_list = [
            "/dev/sw_sync",
            "/sys/kernel/debug/sync/sw_sync",
        ]
        perm_list.extend(glob.glob("/dev/fb*"))
        perm_list.extend(glob.glob("/dev/video*"))
        perm_list.extend(glob.glob("/dev/dma_heap/*"))
PY
cat > "$r/var/lib/waydroid/lxc/waydroid/config_nodes" <<'NODES'
lxc.mount.entry = /dev/null dev/null none bind,create=file,optional 0 0
lxc.mount.entry = /dev/fb0 dev/fb0 none bind,create=file,optional 0 0
lxc.mount.entry = /dev/video0 dev/video0 none bind,create=file,optional 0 0
lxc.mount.entry = /dev/video12 dev/video12 none bind,create=file,optional 0 0
lxc.mount.entry = /sys/kernel/debug sys/kernel/debug none rbind,create=dir,optional 0 0
lxc.mount.entry = /dev/dri/renderD128 dev/dri/renderD128 none bind,create=file,optional 0 0
NODES
printf 'lxc.rootfs.path = /var/lib/waydroid/rootfs\n' > "$r/var/lib/waydroid/lxc/waydroid/config"
h=lib/omamobile-waydroid-harden
if python3 -I $h verify "$r" > /dev/null; then fail "verify passes before hardening"; fi
python3 -I $h patch "$r" > /dev/null || fail "patch"
python3 -I $h patch "$r" > "$t/again" || fail "patch, second run"
[[ ! -s $t/again ]] || fail "patch is not idempotent: $(cat "$t/again")"
python3 -I $h config "$r" > /dev/null || fail "config"
python3 -I $h config "$r" > /dev/null || fail "config, second run"
python3 -I $h verify "$r" > /dev/null || fail "verify after hardening"
[[ $(grep -c 'lxc-omamobile.conf' "$r/var/lib/waydroid/lxc/waydroid/config") == 1 ]] || fail "include added twice"
# A hand-opened config fails closed: Waydroid writes no device allow rule in
# its generated files, so any uncommented one refuses the start, whatever its
# value (the "allow = a" of #465, a block device, "c *:*", an absolute path,
# a value in quotes as LXC's parser accepts it, or a harmless-looking one),
# wherever the line sits.
lx=$r/var/lib/waydroid/lxc/waydroid
for f in config config_nodes config_session; do
  [[ -e $lx/$f ]] || : > "$lx/$f"
  for rule in 'a' 'a *:* rwm' 'b *:* rwm' 'b 7:0 rwm' 'b' 'c *:* rwm' 'c  *:*  rwm' '  c *:* rwm' '/dev/sda rwm' '/dev/sda' '/dev/null rwm' '/dev/binderfs/binder rwm' '"a"' "'a'" "'/dev/sda rwm'" "'b 8:0 rwm'" '"c *:* rwm"' 'c 1:1 rwm' 'c 10:200 rwm' 'c 5:* rwm'; do
    cp "$lx/$f" "$t/saved"
    printf 'lxc.cgroup2.devices.allow = %s\n' "$rule" >> "$lx/$f"
    if python3 -I $h verify "$r" > "$t/open.log"; then fail "verify accepts '$rule' in $f"; fi
    grep -q "FAIL .*$f:[0-9]*: a device allow rule" "$t/open.log" || fail "verify does not name '$rule' in $f: $(cat "$t/open.log")"
    cp "$t/saved" "$lx/$f"
  done
done
cp "$lx/config" "$t/config.good"
printf 'lxc.cgroup.devices.allow=a\n' >> "$lx/config"
if python3 -I $h verify "$r" > "$t/open.log"; then fail "verify accepts the older allow spelling"; fi
grep -q 'a device allow rule' "$t/open.log" || fail "verify does not name the older allow spelling"
cp "$t/config.good" "$lx/config"
# ... and one placed before our include, not only after it
sed -i '/^lxc.include = \/usr\/share\/omamobile-waydroid\//i lxc.cgroup2.devices.allow = a' "$lx/config"
grep -qx 'lxc.cgroup2.devices.allow = a' "$lx/config" || fail "test setup: the allow went in"
if python3 -I $h verify "$r" > "$t/open.log"; then fail "verify accepts an allow = a placed before the include"; fi
grep -q 'a device allow rule' "$t/open.log" || fail "verify does not name an allow = a before the include: $(cat "$t/open.log")"
cp "$t/config.good" "$lx/config"
python3 -I $h verify "$r" > /dev/null || fail "verify fails after the test rules are removed"
# what stays accepted: commented-out rules and a deny rule
printf '# lxc.cgroup2.devices.allow = a\n' >> "$lx/config_nodes"
printf '  # lxc.cgroup2.devices.allow = /dev/sda rwm\n' >> "$lx/config_session"
printf 'lxc.cgroup2.devices.deny = b *:* rwm\n' >> "$lx/config_session"
python3 -I $h verify "$r" > /dev/null || fail "verify refuses a commented-out allow or a deny rule"
: > "$lx/config_session"
python3 -I $h verify "$r" > /dev/null || fail "verify fails after removing the test rules"
grep -q 'dev/null' "$r/var/lib/waydroid/lxc/waydroid/config_nodes" || fail "dropped a harmless node"
grep -q 'renderD128' "$r/var/lib/waydroid/lxc/waydroid/config_nodes" || fail "dropped the render node"
if grep -Eq 'video|fb0|kernel/debug' "$r/var/lib/waydroid/lxc/waydroid/config_nodes"; then fail "hardware binds left"; fi
grep -q 'dma_heap' "$r/usr/lib/waydroid/tools/actions/container_manager.py" || fail "patched too much"
python3 -I -c 'import ast, sys; [ast.parse(open(f).read()) for f in sys.argv[1:]]' \
  "$r/usr/lib/waydroid/tools/helpers/lxc.py" "$r/usr/lib/waydroid/tools/actions/container_manager.py" \
  || fail "patched Python does not parse"
# A Waydroid whose lines changed must be refused, not silently accepted
echo 'def other(): pass' > "$r/usr/lib/waydroid/tools/helpers/lxc.py"
if python3 -I $h patch "$r" 2> /dev/null > /dev/null; then fail "patch accepts an unknown lxc.py"; fi

# Mesa: the row swap on a fake library (debugfs is not needed for this part)
python3 -I - lib/omamobile-waydroid-mesa <<'PY' || fail "mesa row constants"
import importlib.machinery, importlib.util, sys
loader = importlib.machinery.SourceFileLoader("m", sys.argv[1])
spec = importlib.util.spec_from_loader("m", loader)
m = importlib.util.module_from_spec(spec); loader.exec_module(m)
assert m.G610 == bytes.fromhex("000007a800000fff"), m.G610.hex()
assert m.G710 == bytes.fromhex("000002a800000fff"), m.G710.hex()
PY
echo "omamobile-waydroid: all tests passed"
