#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omamobile-waydroid into DESTDIR. Activates nothing: the container
# service stays disabled and no Android image is downloaded until
# "omamobile-waydroid init".
#   ./install DESTDIR
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
d=${1:?Usage: ./install DESTDIR}
[[ $d == /* && $d != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
l=$d/usr/lib/omamobile-waydroid
install -Dm755 bin/omamobile-waydroid "$d/usr/bin/omamobile-waydroid"
for f in omamobile-waydroid-check omamobile-waydroid-harden omamobile-waydroid-mesa; do
  install -Dm755 "lib/$f" "$l/$f"
done
install -Dm644 lib/lxc-omamobile.conf "$d/usr/share/omamobile-waydroid/lxc-omamobile.conf"
install -Dm644 systemd/waydroid-container-omamobile.conf \
  "$d/usr/lib/systemd/system/waydroid-container.service.d/omamobile.conf"
install -Dm644 libalpm/90-omamobile-waydroid.hook "$d/usr/share/libalpm/hooks/90-omamobile-waydroid.hook"
install -Dm644 etc/omamobile/waydroid.conf "$d/etc/omamobile/waydroid.conf"
install -Dm644 LICENSE "$d/usr/share/licenses/omamobile-waydroid/LICENSE"
install -Dm644 version "$d/usr/share/omamobile/waydroid/version"
# The package's own version (tools/pkg-version), which the file's
# series doesn't give
[[ -z ${OMAMOBILE_PKGVER:-} ]] || echo "$OMAMOBILE_PKGVER" > "$d/usr/share/omamobile/waydroid/version"
