pkgname=omamobile-waydroid
pkgver=$(cat "${startdir:-.}/.pkgver" 2>/dev/null || "${startdir:-.}/../../tools/pkg-version" "${startdir:-.}")
pkgrel=1
pkgdesc="Omarchy Mobile Waydroid integration: kernel checks, container hardening, Mali-G710 Mesa overlay, ufw rules"
arch=(any)
url="https://github.com/derekross/omarchy-mobile"
license=(MIT)
depends=(bash python waydroid lxc nftables dnsmasq e2fsprogs systemd)
optdepends=('ufw: omamobile-waydroid firewall on')
backup=(etc/omamobile/waydroid.conf)
install=omamobile-waydroid.install

check() {
  "$startdir/test/all"
}

package() {
  "$startdir/install" "$pkgdir"
}
