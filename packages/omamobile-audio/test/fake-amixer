#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
# A stand-in for amixer, for test/all: the AoC card's amplifier controls as the
# kernel exposes them (cs35l41 with the AoC card's limits), with the DSP's
# firmware controls appearing once "DSP1 Preload Switch" is turned on.
#   FAKE_AMIXER_STATE   JSON state file (created on first use)
#   FAKE_AMIXER_LOG     every cset is appended here
#   FAKE_DIGITAL_MAX    Digital PCM Volume max (817 with the kernel limit)
#   FAKE_ANALOG_MAX     Analog PCM Volume max (10 with the kernel limit)
#   FAKE_NO_DSP=1       the firmware does not load (no DSP controls)
import json
import os
import sys

state_path = os.environ['FAKE_AMIXER_STATE']
AMPS = ('Top', 'Bottom')
DSP_RX = ['Zero', 'ASPRX1', 'ASPRX2', 'VMON', 'IMON', 'VPMON', 'VBSTMON', 'DSPTX1', 'DSPTX2']
FW = ['Default', 'Protection', 'Calibration']


def initial():
    c = {}
    for p in AMPS:
        c[f'{p} Digital PCM Volume'] = {'type': 'INTEGER', 'max': int(os.environ.get('FAKE_DIGITAL_MAX', 817)), 'v': 657}
        c[f'{p} Analog PCM Volume'] = {'type': 'INTEGER', 'max': int(os.environ.get('FAKE_ANALOG_MAX', 10)), 'v': 0}
        c[f'{p} PCM Source'] = {'type': 'ENUMERATED', 'items': ['ASP', 'DSP'], 'v': 0}
        c[f'{p} DSP RX1 Source'] = {'type': 'ENUMERATED', 'items': DSP_RX, 'v': 1}
        c[f'{p} DSP RX2 Source'] = {'type': 'ENUMERATED', 'items': DSP_RX, 'v': 2}
        c[f'{p} DSP1 Firmware'] = {'type': 'ENUMERATED', 'items': FW, 'v': 1}
        c[f'{p} DSP1 Preload Switch'] = {'type': 'BOOLEAN', 'v': 0}
        c[f'{p} DRE Switch'] = {'type': 'BOOLEAN', 'v': 0}
        c[f'{p} HW Noise Gate Enable'] = {'type': 'INTEGER', 'max': 63, 'v': 0}
    c['TDM_0_RX Mixer EP6'] = {'type': 'BOOLEAN', 'v': 0}
    c['NoHost1 TX Mixer TDM_0_TX'] = {'type': 'BOOLEAN', 'v': 0}     # an AoC control
    return c


def wm_adsp_name(prefix, alg, key):
    """The control name mainline wm_adsp makes for a v3 firmware: the key's
    start is cut so that the name with its prefix fits 43 characters."""
    base = f'DSP1 Protection {alg}'
    avail = 44 - len(base) - 2 - (len(prefix) + 1)
    if len(key) > avail:
        key = key[len(key) - avail:]
    return f'{prefix} {base} {key}'


DSP_VALUES = {   # what a healthy DSP reads during playback (C8c)
    'HALO_STATE': 2, 'HALO_HEARTBEAT': 100, 'CSPL_STATE': 0, 'CSPL_ERRORNO': 0, 'CAL_SET_STATUS': 2,
    'CSPL_TEMPERATURE': 409700, 'SPK_OUTPUT_POWER': 0, 'BDLOG_MAX_TEMP': 409700, 'BDLOG_VMON_LOW_FLAG': 0,
    'BDLOG_MAX_EXC': 0, 'BDLOG_OVER_TEMP_COUNT': 0, 'BDLOG_OVER_EXC_COUNT': 0, 'BDLOG_ABNORMAL_MUTE': 0,
}


def dsp_controls(c, p):
    for n in ('CAL_R', 'CAL_R_SELECTED', 'CAL_STATUS', 'CAL_CHECKSUM', 'CAL_AMBIENT', 'ATTENUATION'):
        c.setdefault(wm_adsp_name(p, 'cd', n), {'type': 'BYTES', 'v': [0, 0, 0, 0]})
    for n, v in DSP_VALUES.items():
        alg = '400a4' if n.startswith('HALO_') else 'cd'
        c.setdefault(wm_adsp_name(p, alg, n), {'type': 'BYTES', 'v': list(v.to_bytes(4, 'big'))})
    c.setdefault(wm_adsp_name(p, 'cd', 'CSPL_UPDATE_PARAMS_CONFIG'), {'type': 'BYTES', 'v': [0] * 64})
    c.setdefault(wm_adsp_name(p, 'cd', 'CSPL_COMMAND'), {'type': 'BYTES', 'v': [0] * 4})
    for n, size in (('RTLOG_ENABLE', 4), ('RTLOG_VARIABLE', 16), ('RTLOG_COUNT', 4), ('RTLOG_STATE', 4),
                    ('RTLOG_DATA', 128)):
        c.setdefault(wm_adsp_name(p, 'cd', n), {'type': 'BYTES', 'v': [0] * size})
    # a decoy from the other algorithm
    c.setdefault(f'{p} DSP1 Protection f20b CAL_R', {'type': 'BYTES', 'v': [0, 0, 0, 0]})


def load():
    try:
        with open(state_path) as f:
            return json.load(f)
    except FileNotFoundError:
        return initial()


def save(c):
    # write and rename, so a reader running at the same moment (the
    # watchdog while a test changes a control) never sees half a file
    tmp = f'{state_path}.{os.getpid()}'
    with open(tmp, 'w') as f:
        json.dump(c, f)
    os.replace(tmp, state_path)


def show(name, ctl):
    t = ctl['type']
    print(f"numid=1,iface=MIXER,name='{name}'")
    if t == 'INTEGER':
        print(f"  ; type=INTEGER,access=rw---R--,values=1,min=0,max={ctl['max']},step=0")
        print(f"  : values={ctl['v']}")
        # The real volume controls carry a dB description with its own
        # "max=" (C8b: the parser read "max=12.00dB" as a second maximum).
        print("  | dBrange-")
        print("    rangemin=1,,rangemax=913")
        print("      | dBminmax-min=-102.00dB,max=12.00dB")
    elif t == 'ENUMERATED':
        print(f"  ; type=ENUMERATED,access=rw------,values=1,items={len(ctl['items'])}")
        for i, item in enumerate(ctl['items']):
            print(f"  ; Item #{i} '{item}'")
        print(f"  : values={ctl['v']}")
    elif t == 'BOOLEAN':
        print("  ; type=BOOLEAN,access=rw------,values=1")
        print(f"  : values={'on' if ctl['v'] else 'off'}")
    else:
        print("  ; type=BYTES,access=rw------,values=4")
        print('  : values=' + ','.join(f'0x{b:02x}' for b in ctl['v']))


def main(argv):
    args = [a for a in argv if a != '-q']
    if args[:1] == ['-c']:
        # like the real amixer, an empty card fails (the earpiece path once
        # read every control before looking up the card)
        if not args[1]:
            print("amixer: Invalid card number ''.", file=sys.stderr)
            return 1
        args = args[2:]
    c = load()
    cmd = args[0]
    if cmd == 'controls':
        for name in c:
            print(f"numid=1,iface=MIXER,name='{name}'")
        return 0
    name = args[1].split('=', 1)[1]
    if name not in c:
        print(f'amixer: Cannot find the given element from control hw:0', file=sys.stderr)
        return 1
    ctl = c[name]
    if cmd == 'cget':
        show(name, ctl)
        return 0
    value = args[2]
    with open(os.environ['FAKE_AMIXER_LOG'], 'a') as log:
        log.write(f'{name}={value}\n')
    t = ctl['type']
    if t == 'INTEGER':
        ctl['v'] = max(0, min(int(value), ctl['max']))     # the kernel clamps to max
    elif t == 'ENUMERATED':
        if value not in ctl['items']:
            return 1
        ctl['v'] = ctl['items'].index(value)
    elif t == 'BOOLEAN':
        ctl['v'] = 1 if value in ('on', '1') else 0
        if ctl['v'] and name.endswith('DSP1 Preload Switch') and os.environ.get('FAKE_NO_DSP') != '1':
            dsp_controls(c, name.split(' ')[0])
    else:
        ctl['v'] = [int(b, 0) for b in value.split(',')]
    save(c)
    return 0


sys.exit(main(sys.argv[1:]))
