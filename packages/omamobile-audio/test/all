rc=0; prep=(OMAMOBILE_ASOUND=$r/none); sp mics > "$r/out" 2>&1 || rc=$?; prep=()
((rc == 1)) && [[ ! -e $r/modprobe.log && -e $r/state/speaker-protection-started ]] || fail "mics: a hang marker keeps the driver unloaded"
rc=0; sp mics --retry > "$r/out" 2>&1 || rc=$?
((rc == 0)) && muted || fail "mics --retry clears the marker and comes up muted"
