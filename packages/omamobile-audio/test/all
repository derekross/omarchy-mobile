((rc == 0)) && [[ $(val "Bottom Analog PCM Volume") == 14 && $(val "Top Analog PCM Volume") == 11 && $(val "Top Digital PCM Volume") == 817 ]] &&
  grep -c 'capped at the levels verified with music.*clamped Bottom analog 17 -> 14' "$r/out" >/dev/null ||
