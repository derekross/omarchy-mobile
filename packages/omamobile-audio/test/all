# the response measurement, on a simulated speaker (a 700 Hz roll-off, a 3.5 kHz peak)
python3 -I - "$here/lib" "$tmp" <<'PY' || fail "response: recovers a known speaker response within 1 dB"
import json, math, random, struct, sys, wave
sys.path.insert(0, sys.argv[1]); tmp = sys.argv[2]
import speaker_response as r
def bq(kind, f, q, g, rate=48000):
    A = 10 ** (g / 40); w = 2 * math.pi * f / rate; al = math.sin(w) / (2 * q); c = math.cos(w)
    b, a = ([(1 + c) / 2, -(1 + c), (1 + c) / 2], [1 + al, -2 * c, 1 - al]) if kind == 'hp' else \
           ([1 + al * A, -2 * c, 1 - al * A], [1 + al / A, -2 * c, 1 - al / A])
    return [x / a[0] for x in b], [x / a[0] for x in a]
def run(x, ba):
    (b, a), y, x1, x2, y1, y2 = ba, [], 0.0, 0.0, 0.0, 0.0
    for v in x:
        o = b[0] * v + b[1] * x1 + b[2] * x2 - a[1] * y1 - a[2] * y2
        x2, x1, y2, y1 = x1, v, y1, o; y.append(o)
    return y
def mag(ba, f):
    (b, a), z = ba, complex(math.cos(2 * math.pi * f / 48000), -math.sin(2 * math.pi * f / 48000))
    return 20 * math.log10(abs((b[0] + b[1] * z + b[2] * z * z) / (a[0] + a[1] * z + a[2] * z * z)))
freqs = r.steps()
r.write_wav(f'{tmp}/stim.wav', r.stimulus(freqs, -30), 'right')
rate, ch = r.read_wav(f'{tmp}/stim.wav')
assert ch[0] == [0.0] * len(ch[0]) and max(ch[1]) > 0.04          # one channel only
hp, pk = bq('hp', 700, 0.9, 0), bq('pk', 3500, 1.5, 6)
random.seed(1)
y = [random.gauss(0, 10 ** (-75 / 20)) for _ in range(int(0.4 * 48000))] + \
    [v * 10 ** (-10 / 20) + random.gauss(0, 10 ** (-75 / 20)) for v in run(run(ch[1], hp), pk)]
# a speaker with a little 2nd-harmonic distortion: 0.1 x^2 (about -36 dB at -10 dBFS)
y = [v + 3 * v * v for v in y]
with wave.open(f'{tmp}/rec.wav', 'wb') as w:                       # a mono "microphone"
    w.setnchannels(1); w.setsampwidth(2); w.setframerate(48000)
    w.writeframes(b''.join(struct.pack('<h', max(-32768, min(32767, int(v * 32767)))) for v in y))
res = r.analyze(f'{tmp}/rec.wav', freqs, -30)
assert len(res['steps']) == len(freqs) and not res['clipped']
for s in res['steps']:
    exp = mag(hp, s['freq']) + mag(pk, s['freq']) - 10
    assert s['snr'] is None or s['snr'] < 10 or abs(s['db'] - exp) < 1.0, (s, exp)
k = min(res['steps'], key=lambda s: abs(s['freq'] - 2000))
lvl = 10 ** ((k['db'] - 30) / 20) * math.sqrt(2)                    # peak amplitude at the "microphone"
assert k['h2'] is not None and abs(k['h2'] - 20 * math.log10(3 * lvl / 2)) < 1.5, k  # 3 a^2/2 at 2f
# a microphone calibration: a +3 dB rise above 5 kHz in the mic reads as 3 dB less
open(f'{tmp}/cal.txt', 'w').write('# test\n100 0\n4000 0\n5000 3\n20000 3\n')
rc = r.analyze(f'{tmp}/rec.wav', freqs, -30, mic_cal=r.read_mic_cal(f'{tmp}/cal.txt'))
for a, b in zip(res['steps'], rc['steps']):
    want = 3 if a['freq'] >= 5000 else (0 if a['freq'] <= 4000 else None)
    assert want is None or abs((a['db'] - b['db']) - want) < 1e-6, (a, b)
res.update(source='default', sink_gain_db=0.0)
json.dump(res, open(f'{tmp}/R.json', 'w')); json.dump(res, open(f'{tmp}/L.json', 'w'))
out, notes = r.suggest(res, res)
assert 0 < out['bass_top'] <= 6 and out['dip'] < 0 and 60 <= out['hp_bottom'] <= 200, out
assert all(v <= 0 for k, v in out.items() if k.startswith(('trim', 'treble', 'dip'))), out
assert not any(k.startswith('trim') for k in out) and any('listening position' in n for n in notes), (out, notes)
other = dict(res, mic=1)
_, notes = r.suggest(res, other)
assert any('different microphone channel' in n for n in notes), notes
_, notes = r.suggest(dict(res, clipped=True, peak_dbfs=-0.2), res)
assert any('top: the recording clipped' in n for n in notes), notes
quiet = dict(res, steps=[dict(s, db=s['db'] - 6) if s['freq'] < 1000 else s for s in res['steps']])
d = r.compare(res, quiet)
assert d and all(x[1] == -6 for x in d if x[0] < 1000) and all(x[1] == 0 for x in d if x[0] >= 1000), d
PY
python3 -I lib/speaker_response.py suggest "$tmp/L.json" "$tmp/R.json" | grep -c '^suggested: omamobile-speaker-eq set hp_top=' >/dev/null || fail "response: suggest prints a command"
python3 -I lib/speaker_response.py compare "$tmp/L.json" "$tmp/R.json" | grep -c ' +0.0 ' >/dev/null || fail "response: compare prints the differences"
pass "response measurement: stepped tones on one channel, recovered within 1 dB, harmonics, a mic calibration, a bounded per-speaker suggestion, compare"

