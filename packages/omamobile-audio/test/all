#!/bin/bash
# SPDX-License-Identifier: MIT
# Tests for omamobile-audio, from a copy of this directory alone. The speaker
# protection script runs against stand-ins for amixer, modprobe and debugfs
# and a synthetic calibration file (made-up values, not a phone's).
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
tmp=$(mktemp -d); [[ -n ${KEEP:-} ]] || trap 'rm -rf "$tmp"' EXIT; [[ -z ${KEEP:-} ]] || echo "$tmp"
here=$PWD

bash -n bin/omamobile-speaker-protection || fail "the script parses"
for f in bin/omamobile-speaker-eq lib/speaker_response.py test/fake-pw; do
  python3 -c 'import sys; compile(open(sys.argv[1]).read(), sys.argv[1], "exec")' "$f" || fail "$f compiles"
done
python3 -c 'import sys; compile(open(sys.argv[1]).read(), sys.argv[1], "exec")' test/fake-amixer || fail "fake-amixer compiles"
pass "scripts parse"

# --- UCM: the profile parses (alsa-lib's own parser, a virtual card) --------
if command -v alsaucm >/dev/null && [[ -r /usr/share/alsa/ucm2/ucm.conf ]]; then
  u=$tmp/ucm2
  mkdir -p "$u/conf.virt.d" "$u/Google"
  cp -r /usr/share/alsa/ucm2/ucm.conf /usr/share/alsa/ucm2/lib "$u/"
  cp -r ucm2/Google/cheetah "$u/Google/"
  cp ucm2/conf.d/aoc-snd-card/aoc-snd-card.conf "$u/conf.virt.d/aoctest.conf"
  # No card here: stand in for the card substitutions, keep the rest as is
  sed -i -e 's/\${CardId}/0/g' -e 's/\${find-device:[^}]*playback[^}]*}/5/' \
      -e 's/\${find-device:[^}]*capture[^}]*}/8/' "$u/Google/cheetah/HiFi.conf"
  ucm() { ALSA_CONFIG_UCM2=$u alsaucm -c aoctest "$@" 2>&1; }
  [[ $(ucm list _verbs) == *"0: HiFi"* ]] || fail "UCM: the HiFi verb"
  out=$(ucm list _devices/HiFi)
  [[ $out == *"0: Speaker"* && $out == *"1: Mic"* ]] || fail "UCM: Speaker and Mic devices"
  [[ $(ucm get PlaybackPCM/Speaker/HiFi) == *"hw:0,5" ]] || fail "UCM: Speaker PCM"
  [[ $(ucm get CapturePCM/Mic/HiFi) == *"hw:0,8" ]] || fail "UCM: Mic PCM"
  pass "UCM profile parses: HiFi with Speaker and Mic"
  # tegu: its own long-name file in the same conf.d directory
  # The long-name file must be named exactly as alsa-ucm-conf looks it up, or
  # alsa falls back to the shared profile and cheetah's microphone list.
  cp -r ucm2/Google/tegu "$u/Google/"
  cp "ucm2/conf.d/aoc-snd-card/google,tegu-aoc-snd-card.conf" "$u/conf.virt.d/tegutest.conf"
  sed -i -e 's/\${CardId}/0/g' -e 's/\${find-device:[^}]*playback[^}]*}/5/' \
      -e 's/\${find-device:[^}]*capture[^}]*}/8/' "$u/Google/tegu/HiFi.conf"
  ucmt() { ALSA_CONFIG_UCM2=$u alsaucm -c tegutest "$@" 2>&1; }
  [[ $(ucmt list _verbs) == *"0: HiFi"* ]] || fail "UCM tegu: the HiFi verb"
  out=$(ucmt list _devices/HiFi)
  [[ $out == *"0: Speaker"* && $out == *"1: Mic"* ]] || fail "UCM tegu: Speaker and Mic devices"
  [[ $(ucmt get PlaybackPCM/Speaker/HiFi) == *"hw:0,5" ]] || fail "UCM tegu: Speaker PCM"
  [[ $(ucmt get CapturePCM/Mic/HiFi) == *"hw:0,8" ]] || fail "UCM tegu: Mic PCM"
  pass "UCM profile parses: tegu HiFi with Speaker and Mic"
  # raven: its own long-name file too
  cp -r ucm2/Google/raven "$u/Google/"
  cp "ucm2/conf.d/aoc-snd-card/google,raven-aoc-snd-card.conf" "$u/conf.virt.d/raventest.conf"
  sed -i -e 's/\${CardId}/0/g' -e 's/\${find-device:[^}]*playback[^}]*}/5/' \
      -e 's/\${find-device:[^}]*capture[^}]*}/8/' "$u/Google/raven/HiFi.conf"
  ucmr() { ALSA_CONFIG_UCM2=$u alsaucm -c raventest "$@" 2>&1; }
  [[ $(ucmr list _verbs) == *"0: HiFi"* ]] || fail "UCM raven: the HiFi verb"
  out=$(ucmr list _devices/HiFi)
  [[ $out == *"0: Speaker"* && $out == *"1: Mic"* ]] || fail "UCM raven: Speaker and Mic devices"
  [[ $(ucmr get PlaybackPCM/Speaker/HiFi) == *"hw:0,5" ]] || fail "UCM raven: Speaker PCM"
  [[ $(ucmr get CapturePCM/Mic/HiFi) == *"hw:0,8" ]] || fail "UCM raven: Mic PCM"
  pass "UCM profile parses: raven HiFi with Speaker and Mic"
fi
grep -c "find-device:type=pcm,stream=playback,field=id,regex='^EP6 playback'" ucm2/Google/cheetah/HiFi.conf >/dev/null ||
  fail "UCM: the Speaker PCM is found by its id"
grep -c "find-device:type=pcm,stream=capture,field=id,regex='^EP1 capture'" ucm2/Google/cheetah/HiFi.conf >/dev/null ||
  fail "UCM: the Mic PCM is found by its id"
# The 9a's profile is found through the card's long name: the UCM file must be
# named exactly after the card name the WirePlumber rule matches.
tegu_card=$(sed -n 's/.*api.alsa.card.name = "\([^"]*\)".*/\1/p' wireplumber/52-omamobile-tegu-aoc.conf | head -1)
[[ $tegu_card == google,tegu-aoc-snd-card ]] || fail "52-omamobile-tegu-aoc.conf matches the 9a's card name"
[[ -f "ucm2/conf.d/aoc-snd-card/$tegu_card.conf" ]] || fail "tegu long-name UCM file is named exactly $tegu_card.conf"
grep -c "channelmix.max-volume = 0.562" wireplumber/52-omamobile-tegu-aoc.conf >/dev/null || fail "the 9a's speaker sink is capped (channelmix.max-volume)"
grep -c "CAPTURE LIST' 0,1,-1,-1" ucm2/Google/tegu/HiFi.conf >/dev/null || fail "tegu HiFi must set its own mic list (cheetah's 0,3,2 kills the AoC)"
raven_card=$(sed -n 's/.*api.alsa.card.name = "\([^"]*\)".*/\1/p' wireplumber/53-omamobile-raven-aoc.conf | head -1)
[[ $raven_card == google,raven-aoc-snd-card ]] || fail "53-omamobile-raven-aoc.conf matches raven's card name"
[[ -f "ucm2/conf.d/aoc-snd-card/$raven_card.conf" ]] || fail "raven long-name UCM file is named exactly $raven_card.conf"
! grep -c "raven" ucm2/conf.d/aoc-snd-card/aoc-snd-card.conf >/dev/null || fail "cheetah's shared profile has no raven branch"
if grep -E "cset .*(PCM Volume|PCM Source|DSP|Analog|Digital)" ucm2/Google/cheetah/HiFi.conf ucm2/Google/tegu/HiFi.conf ucm2/Google/raven/HiFi.conf; then
  fail "UCM touches no amplifier control"
fi
pass "UCM finds the PCMs by id and leaves the amplifiers alone"

# --- the speaker protection service, with stand-ins ---------------------------
fake=$tmp/bin
mkdir -p "$fake"
ln -s "$here/test/fake-amixer" "$fake/amixer"
cat > "$fake/modprobe" <<'SH'
#!/bin/bash
echo "$*" >> "$FAKE_MODPROBE_LOG"
SH
cat > "$fake/debugfs" <<'SH'
#!/bin/bash
# debugfs -R 'cat /audio/speaker.cal' DEVICE: never -w
[[ " $* " != *" -w "* ]] || { echo "debugfs opened for writing" >&2; exit 9; }
[[ $2 == "cat /audio/speaker.cal" ]] || exit 1
cat "$FAKE_CAL"
SH
chmod +x "$fake/modprobe" "$fake/debugfs"

# Synthetic calibration: two records of six u32 (R, status, checksum, ambient, gain, volume)
mkcal() {
  python3 - "$1" "${2:-}" <<'PY'
import struct, sys
recs = [(0x2000, 1, 0x2001, 25, 17, 817), (0x2100, 1, 0x2101, 25, 17, 817)]
if sys.argv[2] == 'badsum':
    recs[1] = (0x2100, 1, 0x2105, 25, 17, 817)
if sys.argv[2] == 'uncal':
    recs[0] = (0x2000, 0, 0x2000, 25, 17, 817)
open(sys.argv[1], 'wb').write(b''.join(struct.pack('<6I', *r) for r in recs))
PY
}

# One scenario in a fresh directory tree: the card (with the EP6 PCM), the
# two amplifiers' SPI devices (runtime PM files, DT nodes), persist, the
# firmware, a kernel log. Extra VAR=value words in prep=() go into the
# environment. Leaves $r (the tree) and $rc (the exit status).
mktree() {
  r=$tmp/run.$1
  rm -rf "$r"; mkdir -p "$r/asound/card0/pcm5p/sub0" "$r/block/sda9" "$r/fw/cirrus" "$r/state" "$r/run" \
    "$r/spidrv" "$r/module/aoc_alsa_dev/parameters" "$r/module/snd_soc_cs35l41/parameters" "$r/dt/spi@10960000/amplifier@0" "$r/dt/spi@10960000/amplifier@1"
  echo Y > "$r/module/snd_soc_cs35l41/parameters/boost_en"
  printf ' 0 [googleaocsndcar]: aoc-snd-card - google,aoc-snd-card\n                      google,aoc-snd-card\n' > "$r/asound/cards"
  printf 'card: 0\ndevice: 5\nsubdevice: 0\nstream: PLAYBACK\nid: EP6 playback (*)\n' > "$r/asound/card0/pcm5p/info"
  echo closed > "$r/asound/card0/pcm5p/sub0/status"
  mkdir -p "$r/asound/card0/pcm15c/sub0"
  printf 'card: 0\ndevice: 15\nsubdevice: 0\nstream: CAPTURE\nid: nohost1 capture (*)\n' > "$r/asound/card0/pcm15c/info"
  echo closed > "$r/asound/card0/pcm15c/sub0/status"
  # stock's interleaved TX slots (the aoc-sound-test overlay), big-endian u32
  python3 -c 'import struct, sys; open(sys.argv[1], "wb").write(struct.pack(">4I", 0, 2, 4, 6)); open(sys.argv[2], "wb").write(struct.pack(">4I", 1, 3, 5, 7))' \
    "$r/dt/spi@10960000/amplifier@0/google,tdm-tx-slots" "$r/dt/spi@10960000/amplifier@1/google,tdm-tx-slots"
  printf 'MAJOR=8\nMINOR=9\nDEVNAME=sda9\nPARTNAME=persist\n' > "$r/block/sda9/uevent"
  for f in cs35l41-dsp1-spk-prot-cheetah.wmfw cs35l41-dsp1-spk-prot-cheetah-top.bin cs35l41-dsp1-spk-prot-cheetah-bottom.bin; do
    echo "$f" > "$r/fw/cirrus/$f"
  done
  local i
  for i in 0 1; do
    mkdir -p "$r/spi/spi6.$i/power"
    ln -s "$r/dt/spi@10960000/amplifier@$i" "$r/spi/spi6.$i/of_node"
    echo auto > "$r/spi/spi6.$i/power/control"
    echo active > "$r/spi/spi6.$i/power/runtime_status"
  done
  echo N > "$r/module/aoc_alsa_dev/parameters/speaker_protection"
  : > "$r/kmsg"
  mkcal "$r/speaker.cal"
}
sp() {  # run the script against $r
  env PATH="$fake:$PATH" FAKE_AMIXER_STATE="$r/amixer.json" FAKE_AMIXER_LOG="$r/cset.log" \
      FAKE_MODPROBE_LOG="$r/modprobe.log" FAKE_CAL="$r/speaker.cal" \
      OMAMOBILE_ASOUND="$r/asound" OMAMOBILE_SYSBLOCK="$r/block" OMAMOBILE_DEVDIR="$r/dev" \
      OMAMOBILE_FW_DIRS="$r/fw" OMAMOBILE_STATE="$r/state" OMAMOBILE_RUN="$r/run" \
      OMAMOBILE_SPIDEVS="$r/spi" OMAMOBILE_SPIDRV="$r/spidrv" OMAMOBILE_SYSMODULE="$r/module" \
      OMAMOBILE_KMSG="$r/kmsg" OMAMOBILE_AUDIO_LIB="$here/lib" OMAMOBILE_CTL_BACKEND="json:$r/amixer.json" \
      OMAMOBILE_CARD_WAIT=1 OMAMOBILE_CTL_WAIT=1 OMAMOBILE_SPK_STAGE=c8 OMAMOBILE_PCM_BACKEND=fake \
      "${prep[@]}" bin/omamobile-speaker-protection "$@"
}
run() {
  mktree "$1"
  rc=0
  sp start > "$r/out" 2>&1 || rc=$?
  prep=()
}
prep=()
# amixer against a finished scenario's state
amx() { FAKE_AMIXER_STATE="$r/amixer.json" FAKE_AMIXER_LOG="$r/cset.log" test/fake-amixer -c 0 "$@"; }
val() { amx cget "name=$1" | sed -n 's/^ *: values=//p'; }
muted() { [[ $(val "Top Digital PCM Volume") == 0 && $(val "Bottom Digital PCM Volume") == 0 ]]; }
# set a DSP word (by key, through the wm_adsp naming)
dspset() {  # AMP KEY VALUE
  local n
  n=$(amx controls | sed -n "s/^numid=1,iface=MIXER,name='\($1 DSP1 .*\)'\$/\1/p" | grep -E "[ _]${2#BDLOG_}\$|$2\$" | head -n1)
  amx cset "name=$n" "$(printf '0x%02x,0x%02x,0x%02x,0x%02x' $(($3 >> 24 & 255)) $(($3 >> 16 & 255)) $(($3 >> 8 & 255)) $(($3 & 255)))" >/dev/null
}
# a kernel log record at kernel time T seconds
kmsg() { printf '3,%d,%d,-;%s\n' "$RANDOM" "$(python3 -c "print(int(($1) * 1e6))")" "$2" >> "$r/kmsg"; }
uptime_now() { python3 -c 'import time; print(time.monotonic())'; }

run ok
((rc == 0)) || { cat "$r/out" >&2; fail "start succeeds"; }
[[ $(val "Top PCM Source") == 1 && $(val "Bottom PCM Source") == 1 ]] || fail "both amplifiers through the DSP"
[[ $(val "Top DSP RX1 Source") == 1 && $(val "Bottom DSP RX2 Source") == 1 ]] || fail "DSP inputs from ASPRX1"
[[ $(val "Top Digital PCM Volume") == 657 && $(val "Bottom Analog PCM Volume") == 6 ]] || fail "default levels 657 / 6"
[[ $(val "Top DSP1 Protection cd CAL_R") == 0x00,0x00,0x20,0x00 ]] || fail "record 0 goes to Top"
[[ $(val "Bottom DSP1 Protection cd CAL_R") == 0x00,0x00,0x21,0x00 ]] || fail "record 1 goes to Bottom"
[[ $(val "Bottom DSP1 Protection cd CAL_CHECKSUM") == 0x00,0x00,0x21,0x01 ]] || fail "checksum written"
[[ $(val "Top DSP1 Protection cd CAL_AMBIENT") == 0x00,0x00,0x00,0x19 ]] || fail "ambient written"
[[ $(val "Top DSP1 Protection f20b CAL_R") == 0x00,0x00,0x00,0x00 ]] || fail "the other algorithm's CAL_R is left alone"
[[ $(val "Top DSP1 Protection cd CAL_R_SELECTED") == 0x00,0x00,0x00,0x00 ]] || fail "CAL_R_SELECTED is left alone"
[[ $(head -n2 "$r/cset.log") == $'Top Digital PCM Volume=0\nBottom Digital PCM Volume=0' ]] || fail "the first thing it does is mute"
[[ $(tail -n2 "$r/cset.log") == $'Top Digital PCM Volume=657\nBottom Digital PCM Volume=657' ]] || fail "the last thing it does is unmute"
grep -c '^snd_soc_cs35l41_spi$' "$r/modprobe.log" >/dev/null || fail "loads the amplifier driver"
[[ $(cat "$r/spi/spi6.0/power/control") == on && $(cat "$r/spi/spi6.1/power/control") == on ]] || fail "holds both amplifiers awake"
grep -c '^healthy' "$r/out" >/dev/null || fail "health check before unmute"
[[ ! -e $r/state/speaker-protection-started ]] || fail "removes the hang marker"
[[ $(cat "$r/run/speaker-protection") == "ok: stage c8"* ]] || fail "status ok"
if grep -E '0x20|8192|8448|2000|2100' "$r/out"; then fail "logs no calibration values"; fi
pass "start: amplifiers held awake, calibration per amplifier, DSP routing, health, unmute last, nothing logged"

[[ $(grep -o '^Top DSP1 Protection cd CAL_[A-Z]*' "$r/cset.log" | tr '\n' ' ') == "Top DSP1 Protection cd CAL_AMBIENT Top DSP1 Protection cd CAL_R Top DSP1 Protection cd CAL_STATUS Top DSP1 Protection cd CAL_CHECKSUM " ]] || fail "calibration in mainline's order by default"
prep=(OMAMOBILE_SPK_CAL_ORDER=stock); run cal-order
((rc == 0)) && [[ $(grep -o '^Bottom DSP1 Protection cd CAL_[A-Z]*' "$r/cset.log" | tr '\n' ' ') == "Bottom DSP1 Protection cd CAL_R Bottom DSP1 Protection cd CAL_STATUS Bottom DSP1 Protection cd CAL_CHECKSUM Bottom DSP1 Protection cd CAL_AMBIENT " ]] &&
  [[ $(val "Bottom DSP1 Protection cd CAL_AMBIENT") == 0x00,0x00,0x00,0x19 ]] || fail "OMAMOBILE_SPK_CAL_ORDER=stock: ambient last, as stock"
prep=(OMAMOBILE_SPK_DIGITAL=600 OMAMOBILE_SPK_BOTTOM_ANALOG=10); run levels
((rc == 0)) && [[ $(val "Bottom Digital PCM Volume") == 600 && $(val "Bottom Analog PCM Volume") == 10 && $(val "Top Analog PCM Volume") == 6 ]] || fail "configured levels"
prep=(OMAMOBILE_SPK_TOP_DIGITAL=500 OMAMOBILE_SPK_BOTTOM_ANALOG=9); run per-amp
((rc == 0)) && [[ $(val "Top Digital PCM Volume") == 500 && $(val "Bottom Digital PCM Volume") == 657 &&
  $(val "Bottom Analog PCM Volume") == 9 && $(val "Top Analog PCM Volume") == 6 ]] || fail "per-amplifier levels"
pass "configured levels within the ceilings, per amplifier too"

# stage media, the default: 737 / 10 on both, no stamp or kernel option needed
prep=(OMAMOBILE_SPK_STAGE=); run media
((rc == 0)) && [[ $(val "Top Digital PCM Volume") == 737 && $(val "Top Analog PCM Volume") == 10 &&
  $(val "Bottom Digital PCM Volume") == 737 && $(val "Bottom Analog PCM Volume") == 10 ]] || { cat "$r/out" >&2; fail "stage media: 737 / 10 by default"; }
[[ $(cat "$r/run/speaker-protection") == "ok: stage media"* ]] || fail "stage media: status"
pass "stage media (the default): 737 / 10 on both, without a stamp or speaker_protection=1"
prep=(OMAMOBILE_SPK_DRE=0 OMAMOBILE_SPK_NOISE_GATE=0); run dre
((rc == 0)) && [[ $(val "Top DRE Switch") == off && $(val "Bottom DRE Switch") == off && $(val "Bottom HW Noise Gate Enable") == 0 ]] || fail "DRE and the gate off when asked"
r0=$r; r=$tmp/run.ok; [[ $(val "Top DRE Switch") == on && $(val "Bottom DRE Switch") == on &&
  $(val "Top HW Noise Gate Enable") == 63 && $(val "Bottom HW Noise Gate Enable") == 63 ]] || fail "DRE and the gate on by default"; r=$r0
pass "DRE and the hardware noise gate (stock's) on by default, off when asked"

# C9j: the boost converter off at analog 10 and below (through the kernel's boost_en), on at 17; forced either way; a kernel without it
r0=$r; r=$tmp/run.media; [[ $(cat "$r/module/snd_soc_cs35l41/parameters/boost_en") == N ]] || fail "stage media: boost_en N"
[[ $(cat "$r/run/speaker-protection") == *"boost converter off"* ]] || fail "stage media: status says the boost is off"
r=$tmp/run.ok; [[ $(cat "$r/module/snd_soc_cs35l41/parameters/boost_en") == N ]] || fail "stage c8 (analog 6/10): boost_en N"; r=$r0
prep=(OMAMOBILE_SPK_BOOST=1); run boost-forced
((rc == 0)) && [[ $(cat "$r/module/snd_soc_cs35l41/parameters/boost_en") == Y ]] || fail "OMAMOBILE_SPK_BOOST=1 keeps the boost on"
prep=(OMAMOBILE_SPK_BOOST=yes); run boost-bad; ((rc != 0)) && grep -c 'OMAMOBILE_SPK_BOOST=yes' "$r/out" >/dev/null || fail "OMAMOBILE_SPK_BOOST=yes is refused"
prep=(OMAMOBILE_SYSMODULE=$tmp/nomodule); run boost-noparam
((rc == 0)) && grep -c '^snd_soc_cs35l41 boost_en=N$' "$r/modprobe.log" >/dev/null && [[ $(cat "$r/run/speaker-protection") == *"kernel without boost_en"* ]] || { cat "$r/out" >&2; fail "a kernel without boost_en: loaded with the parameter, status says so, start passes"; }
pass "boost converter: off at analog 10 and below, on when forced, a kernel without the parameter passes (C9j)"

check_refused() {  # name, then the scenario ran
  ((rc == 1)) || { cat "$r/out" >&2; fail "$1: start fails"; }
  muted || fail "$1: both amplifiers muted"
  [[ $(cat "$r/run/speaker-protection") == muted:* ]] || fail "$1: status muted"
  [[ ! -e $r/state/speaker-protection-started ]] || fail "$1: marker removed after a clean failure"
}
check_refused_early() { check_refused "$1"; [[ $(val "Top PCM Source") == 0 ]] || fail "$1: PCM Source left alone"; }
prep=(OMAMOBILE_SPK_DIGITAL=700); run digital-ceiling; check_refused_early "digital above 657"
prep=(OMAMOBILE_SPK_DIGITAL=0); run digital-zero; check_refused_early "digital 0"
prep=(OMAMOBILE_SPK_ANALOG=11); run analog-ceiling; check_refused_early "analog above 10"
prep=(OMAMOBILE_SPK_TOP_ANALOG=7); run top-analog-ceiling; check_refused_early "top analog above 6 (earpiece)"
prep=(OMAMOBILE_SPK_BOTTOM_ANALOG=12); run bottom-analog-ceiling; check_refused_early "bottom analog above 10"
prep=(FAKE_DIGITAL_MAX=913); run no-kernel-limit; check_refused_early "kernel digital limit missing"
prep=(FAKE_ANALOG_MAX=17); run analog-limit; check_refused_early "kernel analog limit above 10 without speaker_protection"
prep=(OMAMOBILE_SPK_STAGE=c7); run bad-stage; check_refused_early "unknown stage"
prep=(OMAMOBILE_SPK_STAGE=media OMAMOBILE_SPK_DIGITAL=738); run media-digital; check_refused_early "stage media: digital above 737"
prep=(OMAMOBILE_SPK_STAGE=media OMAMOBILE_SPK_TOP_ANALOG=11); run media-analog; check_refused_early "stage media: analog above 10"
pass "refuses levels above the ceilings and kernels without the limits, muted"

# a firmware directory with the bottom tuning missing
prep=(OMAMOBILE_FW_DIRS=$tmp/emptyfw); mkdir -p "$tmp/emptyfw/cirrus"
: > "$tmp/emptyfw/cirrus/cs35l41-dsp1-spk-prot-cheetah.wmfw"
: > "$tmp/emptyfw/cirrus/cs35l41-dsp1-spk-prot-cheetah-top.bin"
run no-bin; check_refused_early "bottom tuning missing"
grep -c 'cheetah-bottom.bin' "$r/out" >/dev/null || fail "names the missing tuning"
prep=(FAKE_NO_DSP=1); run no-dsp; check_refused_early "firmware did not load"
pass "refuses without the firmware or its tunings, muted"

mkcal "$tmp/bad.cal" badsum; prep=(FAKE_CAL=$tmp/bad.cal); run badsum; check_refused_early "bad checksum"
mkcal "$tmp/uncal.cal" uncal; prep=(FAKE_CAL=$tmp/uncal.cal); run uncal; check_refused_early "status not 1"
: > "$tmp/short.cal"; prep=(FAKE_CAL=$tmp/short.cal); run short; check_refused_early "short file"
pass "refuses a missing, short or invalid calibration, muted"

# Runtime PM: an amplifier that cannot be held awake, then kernel log errors
mktree pm-stuck; echo suspended > "$r/spi/spi6.1/power/runtime_status"; chmod a-w "$r/spi/spi6.1/power/control"
rc=0; sp start > "$r/out" 2>&1 || rc=$?
check_refused_early "an amplifier not held awake"
grep -c 'not held awake' "$r/out" >/dev/null || fail "names the amplifier not held awake"
mktree kmsg-old; kmsg 1.0 'cs35l41 spi6.0: Wake failed, re-enter hibernate: -42'
rc=0; sp start > "$r/out" 2>&1 || rc=$?
((rc == 0)) || { cat "$r/out" >&2; fail "an amplifier error from before this start is not held against it"; }
# an error logged while the service starts (stand-in: a kernel log time in the future)
mktree kmsg-new; kmsg "$(uptime_now) + 100" 'cs35l41 spi6.1: CSPL Error Detected'
rc=0; sp start > "$r/out" 2>&1 || rc=$?
check_refused "an amplifier error since the start"
grep -c 'CSPL Error Detected' "$r/out" >/dev/null || fail "names the kernel log line"
mktree kmsg-warn; kmsg "$(uptime_now) + 100" 'cs35l41 spi6.0: Failed to set mailbox cmd 1 (status 0)'
rc=0; sp start > "$r/out" 2>&1 || rc=$?
((rc == 0)) || fail "an unacknowledged pause is a note, not a failure"
pass "holds the amplifiers awake or refuses; refuses on amplifier errors in the kernel log since the start"

# Restart with the driver already bound: rebind both (a chip reset), then set up again
