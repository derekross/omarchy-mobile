# --- the watchdog ----------------------------------------------------------------
watchrun() {  # run the watchdog briefly on a healthy started tree, with the events of at()
  prep=(OMAMOBILE_WATCH_INTERVAL=0.05 OMAMOBILE_WATCH_GRACE=0.1 OMAMOBILE_WATCH_HB_TIMEOUT=0.3
        OMAMOBILE_WATCH_ITERATIONS=${WATCH_N:-20} "${wprep[@]}")
  [[ ! -e $r/events ]] || prep+=(OMAMOBILE_WATCH_HOOK="$tmp/watch-hook" WATCH_EVENTS="$r/events" WATCH_R="$r")
  rc=0; sp watch > "$r/watch.out" 2>&1 || rc=$?
  prep=(); wprep=()
}
wprep=()
# An event during a watch: `at ROUND COMMAND` runs COMMAND (amx, kmsg, any
# shell) just before the watchdog's round ROUND, inside the watchdog's own
# loop (OMAMOBILE_WATCH_HOOK, honoured with the JSON backend sp() sets), and the watchdog's clock is then ROUND times
# the interval. So "after the stream's baseline" or "before the settle time"
# is a round number, not a sleep that a slow CI runner outran: the stream
# starts in round 1 (time 0), round k is (k-1) x 0.05 s into it.
at() { printf '%s %s\n' "$1" "$2" >> "$r/events"; }
cat > "$tmp/watch-hook" <<'EOF'
#!/bin/bash
set -euo pipefail
r=$WATCH_R
while read -r k cmd; do
  [[ $k != "$1" ]] || eval "$cmd"
done < "$WATCH_EVENTS"
EOF
chmod +x "$tmp/watch-hook"
export -f amx kmsg
startok() { run "$1"; ((rc == 0)) || { cat "$r/out" >&2; fail "$1: start"; }; }
startok w-idle; watchrun
((rc == 0)) && ! muted || { cat "$r/watch.out" >&2; fail "watchdog: idle and healthy, nothing happens"; }
startok w-run; echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"; watchrun
((rc == 0)) && ! muted || { cat "$r/watch.out" >&2; fail "watchdog: playing and healthy, nothing happens"; }
startok w-cspl; echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"; dspset Bottom CSPL_STATE 1; watchrun
((rc == 1)) && muted || { cat "$r/watch.out" >&2; fail "watchdog: CSPL error state mutes"; }
[[ $(cat "$r/run/speaker-protection") == "muted: watchdog: Bottom: CSPL_STATE 1 (error)"* ]] || fail "watchdog: says why"
startok w-cal; echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"; dspset Top CAL_SET_STATUS 1; watchrun
((rc == 1)) && muted || fail "watchdog: calibration not applied mutes"
# A start on the firmware's defaults: 1 passes, nothing else does. What
# counts is what start recorded, not the setting: with speaker.cal the
# setting doesn't make 1 pass
prep=(FAKE_CAL=$none OMAMOBILE_SPK_DEFAULT_CAL=1); startok w-defcal; echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"
dspset Top CAL_SET_STATUS 1; dspset Bottom CAL_SET_STATUS 1; wprep=(OMAMOBILE_SPK_DEFAULT_CAL=1); watchrun
((rc == 0)) && ! muted || { cat "$r/watch.out" >&2; fail "watchdog: after a start on the default calibration CAL_SET_STATUS 1 passes"; }
prep=(FAKE_CAL=$none OMAMOBILE_SPK_DEFAULT_CAL=1); startok w-defcal0; echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"
dspset Top CAL_SET_STATUS 0; wprep=(OMAMOBILE_SPK_DEFAULT_CAL=1); watchrun
((rc == 1)) && muted || fail "watchdog: on the default calibration CAL_SET_STATUS 0 still mutes"
prep=(OMAMOBILE_SPK_DEFAULT_CAL=1); startok w-defcal-stray; echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"
dspset Top CAL_SET_STATUS 1; wprep=(OMAMOBILE_SPK_DEFAULT_CAL=1); watchrun
((rc == 1)) && muted || { cat "$r/watch.out" >&2; fail "watchdog: with speaker.cal, OMAMOBILE_SPK_DEFAULT_CAL=1 doesn't make CAL_SET_STATUS 1 pass"; }
startok w-src; echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"; amx cset "name=Top PCM Source" ASP >/dev/null; watchrun
((rc == 1)) && muted || fail "watchdog: DSP bypass mutes"
startok w-level; amx cset "name=Bottom Digital PCM Volume" 700 >/dev/null; watchrun
((rc == 1)) && muted || fail "watchdog: a level above the ceiling mutes, even idle"
startok w-pm; echo auto > "$r/spi/spi6.0/power/control"; watchrun
((rc == 1)) && muted || fail "watchdog: an amplifier no longer held awake mutes"
startok w-hb8; echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"; wprep=(FAKE_HB_STUCK=1); watchrun
((rc == 1)) && muted && grep -c 'HALO_HEARTBEAT stuck' "$r/run/speaker-protection" >/dev/null || { cat "$r/watch.out" >&2; fail "watchdog: a stuck heartbeat during a stream mutes (stage c8 too)"; }
startok w-hb8-log; echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"; wprep=(FAKE_HB_STUCK=1 OMAMOBILE_SPK_HEARTBEAT=0); watchrun
((rc == 0)) && ! muted && grep -c 'stuck' "$r/watch.out" >/dev/null || { cat "$r/watch.out" >&2; fail "watchdog: OMAMOBILE_SPK_HEARTBEAT=0 logs a stuck heartbeat in c8"; }
# the C9a case: the heartbeat moves, then stops while the stream still runs
startok w-hb-freeze; echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"
at 10 'touch "$r/freeze"'    # the heartbeat stops 0.45 s into the stream, after the grace
wprep=(FAKE_HB_FREEZE_FILE=$r/freeze); WATCH_N=40 watchrun
((rc == 1)) && muted && grep -c "HALO_HEARTBEAT stuck" "$r/run/speaker-protection" >/dev/null || { cat "$r/watch.out" >&2; fail "watchdog: a heartbeat that stops mid-stream mutes"; }
startok w-hb9-off; echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"; wprep=(FAKE_HB_STUCK=1 OMAMOBILE_SPK_STAGE=c9 OMAMOBILE_SPK_HEARTBEAT=0); watchrun
((rc == 1)) && muted || fail "watchdog: the heartbeat cannot be switched off in stage c9"
startok w-hb9; echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"; wprep=(FAKE_HB_STUCK=1 OMAMOBILE_SPK_STAGE=c9); watchrun
((rc == 1)) && muted || fail "watchdog: a stuck heartbeat mutes in stage c9"
# a kernel log error after the watchdog started
startok w-kmsg
at 8 "kmsg 1.0 'cs35l41 spi6.1: Wake failed, re-enter hibernate: -42'"
WATCH_N=40 watchrun
((rc == 1)) && muted && grep -c "Wake failed" "$r/run/speaker-protection" >/dev/null || { cat "$r/watch.out" >&2; fail "watchdog: a failed wake in the kernel log mutes"; }
startok w-kmsg-warn
at 8 "kmsg 1.0 'cs35l41 spi6.0: Failed to set mailbox cmd 1 (status 0)'"
WATCH_N=20 watchrun
((rc == 0)) && ! muted && grep -c 'watchdog: note: .*mailbox cmd 1' "$r/watch.out" >/dev/null || { cat "$r/watch.out" >&2; fail "watchdog: an unacknowledged pause is logged only"; }
pass "watchdog: mutes on DSP errors, bypass, levels, runtime PM, a stuck heartbeat (c9) and kernel log failures"

# the test hook is honoured only with the JSON control backend: on the phone
# (alsa-lib, no OMAMOBILE_CTL_BACKEND) a stray OMAMOBILE_WATCH_HOOK in
# speaker.conf neither runs nor changes the clock. Unit level: the real
# backend needs a card, so watch_loop's own selection is called directly.
printf '#!/bin/sh\ntouch "%s"\n' "$tmp/hook-ran" > "$tmp/hook-probe"; chmod +x "$tmp/hook-probe"
out=$(env -u OMAMOBILE_CTL_BACKEND OMAMOBILE_WATCH_HOOK="$tmp/hook-probe" python3 -I -c '
import sys; sys.path.insert(0, sys.argv[1]); import speaker_dsp as d
print("real:", d.watch_hook())
import os; os.environ["OMAMOBILE_CTL_BACKEND"] = "alsa"; print("alsa:", d.watch_hook())
os.environ["OMAMOBILE_CTL_BACKEND"] = "json:/x"; print("json:", d.watch_hook() == os.environ["OMAMOBILE_WATCH_HOOK"])
' "$here/lib")
[[ $out == *"real: None"*"alsa: None"*"json: True"* && $(grep -c 'OMAMOBILE_WATCH_HOOK ignored' <<<"$out") == 2 && ! -e $tmp/hook-ran ]] ||
  { echo "$out" >&2; fail "watchdog: the test hook is ignored, and said so, without the JSON backend"; }
pass "watchdog: the test hook only with the tests' JSON control backend"

# C9j: the coil-estimate jump rule is for analog above 10. At the everyday level the
# firmware's estimate is open-loop and the bottom amplifier's jumps 10-15 C on any
# level drop, so a jump there must not mute; OMAMOBILE_SPK_TEMP_JUMP brings it back.
jump() {  # name [wprep...]: watchdog on a running stream; the bottom's estimate goes 25 -> 40 C a moment in
  local n=$1; shift; echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"; wprep=("$@")
  # in round 8 (0.35 s in): after the baseline of a 0.01 s settle (round 2)
  at 8 'amx cset "name=Bottom DSP1 Protection cd CSPL_TEMPERATURE" 0x00,0x0a,0x00,0x00 >/dev/null'
  WATCH_N=30 watchrun
}
startok w-jump8; jump w-jump8
((rc == 0)) && ! muted && grep -c 'jump rule off' "$r/watch.out" >/dev/null || { cat "$r/watch.out" >&2; fail "watchdog: at analog 10 or below a 15 C jump of the estimate does not mute (C9j)"; }
startok w-jump8f; jump w-jump8f OMAMOBILE_SPK_TEMP_JUMP=5 OMAMOBILE_SPK_TEMP_SETTLE=0.01
((rc == 1)) && muted && grep -c 'jumped 15.0 C' "$r/run/speaker-protection" >/dev/null || { cat "$r/watch.out" >&2; fail "watchdog: OMAMOBILE_SPK_TEMP_JUMP=5 brings the jump rule back at any level"; }
pass "watchdog: the jump rule is off at analog 10 or below unless asked (C9j)"

# stock's media delta at stream start (made-up words in the stock format)
startok w-delta; echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"
echo '4,100,200,300' > "$r/fw/cirrus/cs35l41-cheetah-top-media-delta.txt"
echo '4, 100,200,301' > "$r/fw/cirrus/cs35l41-cheetah-bottom-media-delta.txt"
wprep=(OMAMOBILE_SPK_MEDIA_DELTA=1 FAKE_DELTA_LOG=$r/delta.log); watchrun
((rc == 0)) && ! muted || { cat "$r/watch.out" >&2; fail "watchdog: media delta, then healthy"; }
[[ $(wc -l < "$r/delta.log") == 2 ]] || fail "watchdog: the media delta goes to both amplifiers once per stream"
n=$(amx controls | sed -n "s/^numid=1,iface=MIXER,name='\(Bottom DSP1 .*PARAMS_CONFIG\)'\$/\1/p")
[[ $(val "$n") == 0x00,0x00,0x00,0x04,0x00,0x00,0x00,0x64,0x00,0x00,0x00,0xc8,0x00,0x00,0x01,0x2d,0x00,* ]] || { val "$n" >&2; fail "watchdog: the delta words, big-endian, rest kept"; }
startok w-delta-auto; echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"
echo '4,100,200,300' > "$r/fw/cirrus/cs35l41-cheetah-top-media-delta.txt"
echo '4,100,200,301' > "$r/fw/cirrus/cs35l41-cheetah-bottom-media-delta.txt"
wprep=(FAKE_DELTA_LOG=$r/delta.log); watchrun
((rc == 0)) && [[ $(wc -l < "$r/delta.log") == 2 ]] || { cat "$r/watch.out" >&2; fail "watchdog: the media delta is on by default when installed"; }
startok w-delta-none; echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"; watchrun
((rc == 0)) && ! muted || fail "watchdog: no delta files and no setting: off, no mute"
startok w-delta-missing; echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"
wprep=(OMAMOBILE_SPK_MEDIA_DELTA=1); watchrun
((rc == 1)) && muted || fail "watchdog: media delta enabled but missing mutes"
pass "watchdog: stock media delta at stream start, both amplifiers, or mute"

# the amplifiers' V/I feedback stream (C9d-7): with each speaker stream when asked
fbstate() { cat "$r/asound/card0/pcm15c/sub0/status"; }
export -f fbstate
startok w-fb-off; echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"; watchrun
((rc == 0)) && [[ $(fbstate) == closed ]] && ! grep -c NoHost1 "$r/cset.log" >/dev/null || { cat "$r/watch.out" >&2; fail "feedback: off by default"; }
startok w-fb; echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"
at 12 'if [[ $(fbstate) == "state: RUNNING" ]]; then touch "$r/fb-seen"; fi; echo closed > "$r/asound/card0/pcm5p/sub0/status"'
wprep=(OMAMOBILE_SPK_FEEDBACK=1); WATCH_N=30 watchrun
((rc == 0)) && ! muted && [[ -e $r/fb-seen && $(fbstate) == closed ]] || { cat "$r/watch.out" >&2; fail "feedback: runs during the stream, stops after it"; }
[[ $(grep NoHost1 "$r/cset.log") == $'NoHost1 TX Mixer TDM_0_TX=1\nNoHost1 TX Mixer TDM_0_TX=0' ]] || { cat "$r/cset.log" >&2; fail "feedback: the mixer path on, then off, as stock"; }
[[ ! -e $r/run/speaker-feedback.pid ]] || fail "feedback: no pid file left"
startok w-fb-noslots; rm "$r/dt/spi@10960000/amplifier@1/google,tdm-tx-slots"; wprep=(OMAMOBILE_SPK_FEEDBACK=1); watchrun
((rc == 1)) && muted && grep -c 'tdm-tx-slots' "$r/run/speaker-protection" >/dev/null || { cat "$r/watch.out" >&2; fail "feedback: refused without the TX slot overlay, muted"; }
startok w-fb-overlap
python3 -c 'import struct, sys; open(sys.argv[1], "wb").write(struct.pack(">4I", 0, 1, 2, 3))' "$r/dt/spi@10960000/amplifier@1/google,tdm-tx-slots"
rc=0; sp feedback start > "$r/fb.out" 2>&1 || rc=$?
((rc == 1)) && grep -c overlap "$r/fb.out" >/dev/null && [[ $(fbstate) == closed ]] || { cat "$r/fb.out" >&2; fail "feedback: refuses overlapping TX slots"; }
startok fb-cli
rc=0; sp feedback start --seconds 30 > "$r/fb.out" 2>&1 || rc=$?
((rc == 0)) && [[ $(fbstate) == 'state: RUNNING' && $(val "NoHost1 TX Mixer TDM_0_TX") == on ]] || { cat "$r/fb.out" "$r/run/speaker-feedback.log" >&2; fail "feedback start: by hand, in the background"; }
sp feedback status | grep -c 'holder pid' >/dev/null || fail "feedback status"
echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"; wprep=(OMAMOBILE_SPK_FEEDBACK=1); watchrun
((rc == 0)) && ! muted && [[ $(fbstate) == 'state: RUNNING' ]] || { cat "$r/watch.out" >&2; fail "feedback: the watchdog uses a holder started by hand and leaves it running"; }
sp feedback stop > "$r/fb.out" 2>&1
[[ $(fbstate) == closed && $(val "NoHost1 TX Mixer TDM_0_TX") == off && ! -e $r/run/speaker-feedback.pid ]] || { cat "$r/fb.out" "$r/run/speaker-feedback.log" >&2; fail "feedback stop"; }
pass "feedback (C9d-7): off by default; with each stream when asked, path then PCM, both undone; refused without disjoint TX slots; by hand too"

# the firmware's own impedance measurement, as a ratio to CAL_R (C9d-8)
startok z; echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"
out=$(sp impedance --rounds 3 --interval 0.01) || { echo "$out" >&2; fail "impedance: runs"; }
[[ $out == *"Top    Z/CAL_R 1.000"* && $out == *"Bottom Z/CAL_R 1.000"* && $out == *"coil rise +0.0 C"* ]] || { echo "$out" >&2; fail "impedance: ratio 1.000 at calibration"; }
n=$(amx controls | sed -n "s/^numid=1,iface=MIXER,name='\(Top DSP1 .*RTLOG_VARIABLE\)'\$/\1/p")
[[ $(val "$n") == 0x00,0x00,0x03,0x9d,0x00,0x00,0x03,0xb3,0x00,0x00,0x03,0xb4,0x00,0x00,0x00,0x00 ]] || { val "$n" >&2; fail "impedance: arms stock's three variables"; }
out=$(prep=(FAKE_Z_RATIO=1.1); sp impedance --rounds 2 --interval 0.01)
[[ $out == *"Z/CAL_R 1.100"* && $out == *"+25.6 C"* ]] || { echo "$out" >&2; fail "impedance: 10 % high reads as about 26 C"; }
rc=0; out=$(prep=(FAKE_Z_RATIO=low); sp impedance --rounds 2 --interval 0.01) || rc=$?
((rc == 1)) && [[ $out == *"not measurable"* ]] || { echo "$out" >&2; fail "impedance: no valid sample is said so"; }
if grep -E '8192|8448|0x20|0x21' <<<"$(prep=(FAKE_Z_RATIO=1.1); sp impedance --rounds 2 --interval 0.01)"; then fail "impedance: prints no calibration value"; fi
pass "impedance (C9d-8): arms the firmware's logger as stock, prints Z/CAL_R only, says when nothing is measurable"

# --- verify and stage c9 -----------------------------------------------------------
startok verify; echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"
rc=0; prep=(OMAMOBILE_VERIFY_SECONDS=0.5 OMAMOBILE_VERIFY_INTERVAL=0.1); sp verify > "$r/v.out" 2>&1 || rc=$?; prep=()
((rc == 0)) && [[ -s $r/state/speaker-protection-verified ]] || { cat "$r/v.out" >&2; fail "verify passes and writes the stamp"; }
cp "$r/state/speaker-protection-verified" "$tmp/stamp"
startok verify-idle
rc=0; prep=(OMAMOBILE_VERIFY_SECONDS=0.3); sp verify > "$r/v.out" 2>&1 || rc=$?; prep=()
((rc == 1)) && [[ ! -e $r/state/speaker-protection-verified ]] || fail "verify needs playback"
startok verify-swap; echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"; dspset Bottom CSPL_TEMPERATURE $((40 * 16384))
rc=0; prep=(OMAMOBILE_VERIFY_SECONDS=0.3 OMAMOBILE_VERIFY_INTERVAL=0.1); sp verify > "$r/v.out" 2>&1 || rc=$?; prep=()
((rc == 1)) && grep -c 'differ' "$r/v.out" >/dev/null || { cat "$r/v.out" >&2; fail "verify refuses coil temperatures far apart"; }
pass "verify: passes on a healthy playing pair, needs playback, catches swapped calibration"

c9() {  # name, then prep for the tree: param, stamp
  mktree "$1"
  [[ ${2:-} == noparam ]] || echo Y > "$r/module/aoc_alsa_dev/parameters/speaker_protection"
  [[ ${3:-} == nostamp ]] || cp "$tmp/stamp" "$r/state/speaker-protection-verified"
  rc=0
  prep=(OMAMOBILE_SPK_STAGE=c9 OMAMOBILE_SPK_DIGITAL=817 OMAMOBILE_SPK_ANALOG=17 FAKE_ANALOG_MAX=17 "${c9prep[@]}")
  sp start > "$r/out" 2>&1 || rc=$?
  prep=(); c9prep=()
}
c9prep=()
c9 c9-ok
((rc == 0)) && [[ $(val "Top Digital PCM Volume") == 817 && $(val "Bottom Analog PCM Volume") == 17 &&
  $(val "Top DRE Switch") == on && $(val "Bottom DRE Switch") == on &&
  $(cat "$r/module/snd_soc_cs35l41/parameters/boost_en") == Y ]] || { cat "$r/out" >&2; fail "stage c9 at stock levels, boost on"; }
echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"
# as jump(): in round 8, after the baseline of a 0.01 s settle (round 2)
at 8 'amx cset "name=Bottom DSP1 Protection cd CSPL_TEMPERATURE" 0x00,0x0a,0x00,0x00 >/dev/null'
wprep=(OMAMOBILE_SPK_STAGE=c9 OMAMOBILE_SPK_DIGITAL=817 OMAMOBILE_SPK_ANALOG=17 FAKE_ANALOG_MAX=17 OMAMOBILE_SPK_TEMP_SETTLE=0.01); WATCH_N=30 watchrun
((rc == 0)) && ! muted && grep -c 'jump rule off' "$r/watch.out" >/dev/null || { cat "$r/watch.out" >&2; fail "watchdog: in stage c9 the jump rule is off by default, so a 15 C rise plays on (the backstop stays)"; }
# C9d-8: a stream's first estimates are the firmware's 25 C reference until
# it has measured the coil, often warmer, a step of about a second: the
# estimate at the settle time is the baseline, rises above it are held to
# the jump.
c9settle() {  # name settle steps...: steps are round:temp_bytes (at()); round k is (k-1) x 0.05 s into the stream
  local n=$1 st=$2; shift 2; local steps=("$@")
  c9 "$n"; ((rc == 0)) || { cat "$r/out" >&2; fail "$n: start"; }
  echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"
  amx cset "name=Bottom DSP1 Protection cd CSPL_TEMPERATURE" "${C9_START:-0x00,0x06,0x40,0x00}" >/dev/null
  local s
  for s in "${steps[@]}"; do at "${s%%:*}" "amx cset 'name=Bottom DSP1 Protection cd CSPL_TEMPERATURE' ${s#*:} >/dev/null"; done
  wprep=(OMAMOBILE_SPK_STAGE=c9 OMAMOBILE_SPK_DIGITAL=817 OMAMOBILE_SPK_ANALOG=17 FAKE_ANALOG_MAX=17 OMAMOBILE_SPK_TEMP_SETTLE=$st OMAMOBILE_SPK_TEMP_JUMP=${JUMP:-5})
  WATCH_N=60 watchrun
}
c9settle c9-step 1.5 5:0x00,0x0a,0x00,0x00    # 25 -> 40 C at 0.2 s: the measured value, a step before the baseline (1.5 s, round 31)
((rc == 0)) && ! muted && grep -c 's into a stream' "$r/watch.out" >/dev/null || { cat "$r/watch.out" >&2; fail "watchdog: in stage c9 the step from the reference to the measured coil does not mute"; }
C9_START=0x00,0x08,0x40,0x00 c9settle c9-rise 1.0 41:0x00,0x0a,0x40,0x00    # the baseline the measured 33 C (1.0 s, round 21), then 33 -> 41 C at 2.0 s
((rc == 1)) && muted && grep -c 'jumped 8.0 C (33.0 -> 41.0)' "$r/run/speaker-protection" >/dev/null || { cat "$r/watch.out" >&2; fail "watchdog: in stage c9 a rise of 8 C above the measured value mutes"; }
c9settle c9-cold 0.4 31:0x00,0x07,0xc0,0x00    # no step: the baseline 25 C at 0.4 s (round 9), then 25 -> 31 C at 1.5 s
((rc == 1)) && muted && grep -c 'jumped 6.0 C' "$r/run/speaker-protection" >/dev/null || { cat "$r/watch.out" >&2; fail "watchdog: in stage c9 a 6 C rise after the settle window mutes"; }
pass "watchdog: in stage c9 the jump rule starts from the measured coil (C9d-8)"
# auto (the default stage): c9 at the everyday loud levels when the phone has
# speaker_protection=1 and a stamp for this firmware, media otherwise
mktree auto-c9; echo Y > "$r/module/aoc_alsa_dev/parameters/speaker_protection"; cp "$tmp/stamp" "$r/state/speaker-protection-verified"
rc=0; prep=(OMAMOBILE_SPK_STAGE=auto FAKE_ANALOG_MAX=17 "${c9prep[@]}"); sp start > "$r/out" 2>&1 || rc=$?; prep=()
((rc == 0)) && [[ $(val "Top Digital PCM Volume") == 817 && $(val "Bottom Digital PCM Volume") == 817 &&
  $(val "Top Analog PCM Volume") == 11 && $(val "Bottom Analog PCM Volume") == 14 ]] && grep -c "stage c9" "$r/out" >/dev/null ||
  { cat "$r/out" >&2; fail "auto: with speaker_protection=1 and a stamp, c9 at 817/11 top and 817/14 bottom"; }
mktree auto-noparam; cp "$tmp/stamp" "$r/state/speaker-protection-verified"
rc=0; prep=(OMAMOBILE_SPK_STAGE=auto "${c9prep[@]}"); sp start > "$r/out" 2>&1 || rc=$?; prep=()
((rc == 0)) && [[ $(val "Top Digital PCM Volume") == 737 && $(val "Bottom Analog PCM Volume") == 10 ]] && grep -c "stage media" "$r/out" >/dev/null ||
  { cat "$r/out" >&2; fail "auto: without speaker_protection=1, media at 737/10"; }
mktree auto-nostamp; echo Y > "$r/module/aoc_alsa_dev/parameters/speaker_protection"
rc=0; prep=(OMAMOBILE_SPK_STAGE=auto FAKE_ANALOG_MAX=17 "${c9prep[@]}"); sp start > "$r/out" 2>&1 || rc=$?; prep=()
((rc == 0)) && [[ $(val "Top Digital PCM Volume") == 737 ]] && grep -c "stage media" "$r/out" >/dev/null ||
  { cat "$r/out" >&2; fail "auto: without a verification stamp, media at 737/10"; }
pass "auto: c9 at the everyday loud levels only with speaker_protection=1 and a stamp, media otherwise"
# on the firmware's default calibration c9 is out: auto picks media (boost
# off), an explicit c9 is refused, and verify writes no stamp
mktree auto-defcal; echo Y > "$r/module/aoc_alsa_dev/parameters/speaker_protection"; cp "$tmp/stamp" "$r/state/speaker-protection-verified"
rc=0; prep=(OMAMOBILE_SPK_STAGE=auto FAKE_ANALOG_MAX=17 FAKE_CAL=$none OMAMOBILE_SPK_DEFAULT_CAL=1); sp start > "$r/out" 2>&1 || rc=$?; prep=()
((rc == 0)) && [[ $(val "Top Digital PCM Volume") == 737 && $(val "Top Analog PCM Volume") == 10 && $(val "Bottom Analog PCM Volume") == 10 &&
  $(cat "$r/module/snd_soc_cs35l41/parameters/boost_en") == N ]] && grep -c "stage media, not c9: c9 needs the factory calibration" "$r/out" >/dev/null &&
  [[ $(cat "$r/run/speaker-protection") == "ok: stage media, protection firmware with the firmware's default calibration,"* ]] ||
  { cat "$r/out" >&2; fail "auto on the default calibration: media at 737/10, boost off, and says why"; }
echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"; dspset Top CAL_SET_STATUS 1; dspset Bottom CAL_SET_STATUS 1
rm -f "$r/state/speaker-protection-verified"
rc=0; prep=(OMAMOBILE_SPK_STAGE=auto FAKE_ANALOG_MAX=17 OMAMOBILE_VERIFY_SECONDS=0.3 OMAMOBILE_VERIFY_INTERVAL=0.1); sp verify > "$r/v.out" 2>&1 || rc=$?; prep=()
((rc == 1)) && [[ ! -e $r/state/speaker-protection-verified ]] && grep -c "default calibration" "$r/v.out" >/dev/null ||
  { cat "$r/v.out" >&2; fail "verify on the default calibration: refused, no stamp"; }
c9prep=(FAKE_CAL=$none OMAMOBILE_SPK_DEFAULT_CAL=1); c9 c9-defcal; check_refused_early "c9 on the default calibration"
grep -c "stage c9 needs the factory calibration" "$r/out" >/dev/null || { cat "$r/out" >&2; fail "c9 on the default calibration: says why"; }
pass "on the firmware's default calibration: auto picks media, c9 and verify are refused"
c9 c9-noparam noparam; check_refused_early "c9 without speaker_protection=1"
# c9 only on a system with c9 levels of its own: raven, with speaker_protection=1
# and a stamp for its own firmware, stays at media, and an explicit c9 is refused
mktree raven-c9; echo Y > "$r/module/aoc_alsa_dev/parameters/speaker_protection"
for f in "$r"/fw/cirrus/*cheetah*; do mv "$f" "${f/cheetah/raven}"; done
prep=(OMAMOBILE_SPK_SYSTEM=raven); d=$(sp digest | awk '{print $2}'); prep=()
[[ -n $d ]] || fail "raven: a digest of its own firmware"
printf 'firmware %s\n' "$d" > "$r/state/speaker-protection-verified"
rc=0; prep=(OMAMOBILE_SPK_SYSTEM=raven OMAMOBILE_SPK_STAGE=auto FAKE_ANALOG_MAX=17); sp start > "$r/out" 2>&1 || rc=$?; prep=()
((rc == 0)) && [[ $(val "Top Digital PCM Volume") == 737 && $(val "Bottom Analog PCM Volume") == 10 ]] && grep -c "stage media" "$r/out" >/dev/null ||
  { cat "$r/out" >&2; fail "auto on raven with speaker_protection=1 and a matching stamp: media at 737/10, never c9"; }
mktree raven-c9x; echo Y > "$r/module/aoc_alsa_dev/parameters/speaker_protection"
for f in "$r"/fw/cirrus/*cheetah*; do mv "$f" "${f/cheetah/raven}"; done
printf 'firmware %s\n' "$d" > "$r/state/speaker-protection-verified"
rc=0; prep=(OMAMOBILE_SPK_SYSTEM=raven OMAMOBILE_SPK_STAGE=c9 FAKE_ANALOG_MAX=17); sp start > "$r/out" 2>&1 || rc=$?; prep=()
check_refused_early "c9 on raven"
grep -c 'no levels measured for raven' "$r/out" >/dev/null || { cat "$r/out" >&2; fail "c9 on raven: says why"; }
pass "stage c9 only on a system with c9 levels of its own (raven stays at media)"
c9 c9-nostamp '' nostamp; check_refused_early "c9 without a stamp"
mktree tmpfw; c9prep=(OMAMOBILE_FW_DIRS=$tmp/otherfw); mkdir -p "$tmp/otherfw/cirrus"
for f in "$r"/fw/cirrus/*; do echo changed > "$tmp/otherfw/cirrus/${f##*/}"; done
c9 c9-otherfw; check_refused_early "c9 with a stamp for other firmware"
prep=(OMAMOBILE_SPK_ANALOG=11); mktree c8-param; echo Y > "$r/module/aoc_alsa_dev/parameters/speaker_protection"
rc=0; prep=(OMAMOBILE_SPK_ANALOG=11 FAKE_ANALOG_MAX=17); sp start > "$r/out" 2>&1 || rc=$?; prep=()
check_refused_early "c8 keeps analog at 10 even with speaker_protection=1"
pass "stage c9: stock levels only with speaker_protection=1 and a stamp for this firmware"

# --- the verified firmware list (c9 on a fresh install without a stamp) ---------------
# The shipped list: comments, or "SYSTEM DIGEST NOTE" lines with a real digest
bad=$(grep -vE '^[[:space:]]*(#|$)' verified-firmware | grep -vE '^[a-z0-9]+ [0-9a-f]{64}( .*)?$' || true)
[[ -z $bad ]] || { echo "$bad" >&2; fail "verified-firmware: every entry is SYSTEM DIGEST NOTE"; }
grep -c '^install -Dm644 verified-firmware "$d/usr/share/omamobile-audio/verified-firmware"$' install >/dev/null || fail "the list is installed"
mktree digest; fwd=$(sp digest)
[[ $fwd =~ ^cheetah\ [0-9a-f]{64}$ ]] || fail "digest prints the system and the firmware digest ($fwd)"
[[ ${fwd#cheetah } == "$(sed -n 's/^firmware //p' "$tmp/stamp")" ]] || fail "digest is the value a stamp records"
pass "the shipped list is well-formed; digest prints a list line, the stamp's value"
otherd=$(printf x | sha256sum | cut -c1-64)
# list SCENARIO-NAME [lines...]: a tree with speaker_protection=1, no stamp, the list's lines
autolist() {
  local n=$1; shift
  mktree "$n"; echo Y > "$r/module/aoc_alsa_dev/parameters/speaker_protection"
  printf '# a comment\n' > "$r/verified-firmware"; local l; for l in "$@"; do echo "$l" >> "$r/verified-firmware"; done
}
spa() { local rc0; prep=(OMAMOBILE_SPK_STAGE=auto FAKE_ANALOG_MAX=17); sp "$@"; rc0=$?; prep=(); return $rc0; }
autostart() { rc=0; prep=(OMAMOBILE_SPK_STAGE=auto FAKE_ANALOG_MAX=17 "$@"); sp start > "$r/out" 2>&1 || rc=$?; prep=(); }
isc9() { ((rc == 0)) && [[ $(val "Top Digital PCM Volume") == 817 && $(val "Top Analog PCM Volume") == 11 && $(val "Bottom Analog PCM Volume") == 14 ]]; }
ismedia() { ((rc == 0)) && [[ $(val "Top Digital PCM Volume") == 737 && $(val "Bottom Analog PCM Volume") == 10 ]] && grep -c "stage media" "$r/out" >/dev/null; }
autolist list-hit "$otherd other build" "$fwd verified on the reference phone"; autostart
isc9 && grep -c 'stage c9 chosen by the verified firmware list' "$r/out" >/dev/null &&
  [[ $(cat "$r/run/speaker-protection") == "ok: stage c9,"*", from the verified firmware list" ]] &&
  spa status 2>/dev/null | grep -c 'stage c9 from the verified firmware list; first-stream check: not yet' >/dev/null ||
  { cat "$r/out" >&2; fail "list hit: c9 at 817/11 top, 817/14 bottom, without a stamp, and says the list chose it"; }
[[ ! -e $r/state/speaker-protection-verified ]] || fail "list hit: no stamp is written by a start"
autolist list-miss "cheetah $otherd another firmware"; autostart
ismedia || { cat "$r/out" >&2; fail "list miss: media at 737/10"; }
autolist list-empty; autostart; ismedia || fail "an empty list: media"
autolist list-other-system "raven ${fwd#cheetah } another system's line"; autostart
ismedia || fail "a digest listed for another system: media"
autolist list-short "cheetah ${fwd:8:40} a cut digest"; autostart; ismedia || fail "a cut digest matches nothing: media"
autolist list-noparam "$fwd"; echo N > "$r/module/aoc_alsa_dev/parameters/speaker_protection"; autostart FAKE_ANALOG_MAX=10
ismedia || fail "list hit without speaker_protection=1: media"
autolist list-stamp "$fwd"; cp "$tmp/stamp" "$r/state/speaker-protection-verified"; autostart
isc9 && grep -c "stage c9 chosen by this phone's stamp" "$r/out" >/dev/null &&
  [[ $(cat "$r/run/speaker-protection") == *", from this phone's stamp" ]] || { cat "$r/out" >&2; fail "stamp and list: the phone's own stamp is the reason"; }
autolist stamp-only; cp "$tmp/stamp" "$r/state/speaker-protection-verified"; autostart
isc9 && grep -c "chosen by this phone's stamp" "$r/out" >/dev/null || fail "stamp, empty list: c9 from the stamp, as before"
autolist list-refused "$fwd"; printf 'date x\nfirmware %s\nreason test\n' "${fwd#cheetah }" > "$r/state/speaker-protection-c9-refused"; autostart
ismedia || { cat "$r/out" >&2; fail "list hit refused on this phone for this firmware: media"; }
