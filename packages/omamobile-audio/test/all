# the amplifiers' V/I feedback stream (C9d-7): with each speaker stream when asked
fbstate() { cat "$r/asound/card0/pcm15c/sub0/status"; }
startok w-fb-off; echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"; watchrun
((rc == 0)) && [[ $(fbstate) == closed ]] && ! grep -c NoHost1 "$r/cset.log" >/dev/null || { cat "$r/watch.out" >&2; fail "feedback: off by default"; }
