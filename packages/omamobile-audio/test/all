# The first-stream check (c9 from the list only), at a fixed clock: round k
# is (k-1) x 0.05 s into the stream; grace 0.1 s, the check 0.2 s after it
calr() {  # the firmware selects the resistance we wrote, as on the phone
  local p; for p in Top Bottom; do
    amx cset "name=$p DSP1 Protection cd CAL_R_SELECTED" "$(val "$p DSP1 Protection cd CAL_R")" >/dev/null
  done
}
firstwatch() {  # extra prep for the watchdog
  echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"
  at 1 true
  wprep=(OMAMOBILE_SPK_STAGE=auto FAKE_ANALOG_MAX=17 OMAMOBILE_SPK_FIRST_CHECK=0.2 "$@"); WATCH_N=20 watchrun
}
autolist first-ok "$fwd"; autostart; isc9 || fail "first-ok: start"; calr; firstwatch
((rc == 0)) && ! muted && grep -c 'this phone is checked at its first speaker stream' "$r/watch.out" >/dev/null &&
  grep -c '^passed .*CSPL_ENABLE 1.*coils Top 25.0 C, Bottom 25.0 C$' "$r/run/speaker-protection-c9-check" >/dev/null &&
  [[ ! -e $r/state/speaker-protection-c9-refused && ! -s $r/systemctl.log ]] ||
  { cat "$r/watch.out" >&2; fail "first-stream check: a healthy phone passes and keeps c9"; }
spa status 2>/dev/null | grep -c 'first-stream check: passed' >/dev/null || fail "status: the check passed"
if grep -E '0x20|8192|8448' "$r/watch.out" "$r/run/speaker-protection-c9-check"; then fail "the check logs no calibration values"; fi
firstfail() {  # name, what to break (a command on the started tree), the reason expected, state|boot (where it is recorded)
  local f
  autolist "$1" "$fwd"; autostart; isc9 || fail "$1: start"; calr; eval "$2"; firstwatch
  [[ ${4:-state} == state ]] && f=$r/state/speaker-protection-c9-refused || f=$r/run/speaker-protection-c9-refused
  ((rc == 1)) && muted && grep -c "^reason first-stream check failed: .*$3" "$f" >/dev/null &&
    grep -c "^firmware ${fwd#cheetah }$" "$f" >/dev/null &&
    grep -c '^--no-block restart omamobile-speaker-protection.service$' "$r/systemctl.log" >/dev/null &&
    [[ $(cat "$r/run/speaker-protection") == "muted: c9 refused on this phone"* ]] ||
    { cat "$r/watch.out" "$f" >&2; fail "first-stream check: $1 mutes, refuses c9 for this firmware, restarts"; }
  if [[ ${4:-state} == boot ]]; then
    [[ ! -e $r/state/speaker-protection-c9-refused ]] || fail "first-stream check: $1 (a coil estimate) is refused for this boot only"
  fi
  # the restart then picks media
  autostart; ismedia || { cat "$r/out" >&2; fail "first-stream check: after $1 the next start is media"; }
  spa status 2>/dev/null | grep -c '^c9 refused on this phone' >/dev/null || fail "status: names the refusal ($1)"
}
firstfail first-rsel 'amx cset "name=Bottom DSP1 Protection cd CAL_R_SELECTED" 0x00,0x00,0x00,0x01 >/dev/null' 'Bottom: the model does not use the calibration'
