autolist list-lower "$fwd"; autostart OMAMOBILE_SPK_BOTTOM_ANALOG=12
((rc == 0)) && [[ $(val "Bottom Analog PCM Volume") == 12 && $(val "Top Analog PCM Volume") == 11 ]] && ! grep -c 'clamped' "$r/out" >/dev/null ||
  fail "auto c9 from the list: a lower override stays as set"
