# the refusal can't be written to /var/lib: recorded for this boot, the restart picks media
autolist first-nostate2 "$fwd"; autostart; calr; mkdir "$r/state/speaker-protection-c9-refused"
amx cset "name=Top DSP1 Protection cd CSPL_ENABLE" 0x00,0x00,0x00,0x00 >/dev/null; firstwatch
((rc == 1)) && muted && grep -c 'CSPL_ENABLE 0' "$r/run/speaker-protection-c9-refused" >/dev/null &&
  grep -c 'recorded for this boot only' "$r/watch.out" >/dev/null && [[ -s $r/systemctl.log ]] ||
  { cat "$r/watch.out" >&2; fail "first-stream check: /var/lib not writable, the refusal goes to /run and the restart follows"; }
