((rc == 0)) && ! muted && [[ -e $r/fb-seen && $(fbstate) == closed ]] || { cat "$r/watch.out" >&2; fail "feedback: runs during the stream, stops after it"; }
[[ $(grep NoHost1 "$r/cset.log") == $'NoHost1 TX Mixer TDM_0_TX=1\nNoHost1 TX Mixer TDM_0_TX=0' ]] || { cat "$r/cset.log" >&2; fail "feedback: the mixer path on, then off, as stock"; }
