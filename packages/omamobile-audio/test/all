firstfail first-hot 'amx cset "name=Bottom DSP1 Protection cd CSPL_TEMPERATURE" 0x00,0x11,0x80,0x00 >/dev/null' 'Bottom: coil temperature 70.0 C outside 10-65 C' boot
# a refusal for this boot ends with the boot: the next boot (a fresh /run) tries c9 again
rm -f "$r/run/speaker-protection-c9-refused"; autostart; isc9 || { cat "$r/out" >&2; fail "after a reboot a coil-estimate refusal no longer holds"; }
# a temperature and a firmware-state failure together: persisted
