# --- earpiece mode (AOC-PLAN C9k) -------------------------------------------------
# The controls each mode sets, as "name=value" lines (enumerated by item index:
# PCM Source ASP 0, DSP 1; DSP RX ASPRX1 1)
ampstate() {
  local p n
  for p in Top Bottom; do
    for n in "PCM Source" "DSP RX1 Source" "DSP RX2 Source" "DRE Switch" "HW Noise Gate Enable" "Analog PCM Volume" "Digital PCM Volume"; do
      echo "$p $n=$(val "$p $n")"
    done
  done
}
earset() {  # the earpiece state by hand: TOP_DIGITAL TOP_ANALOG BOTTOM_DIGITAL
  amx cset "name=Top PCM Source" ASP >/dev/null; amx cset "name=Top Analog PCM Volume" "${2:-6}" >/dev/null
  amx cset "name=Top Digital PCM Volume" "${1:-657}" >/dev/null; amx cset "name=Bottom Digital PCM Volume" "${3:-0}" >/dev/null
  echo earpiece > "$r/run/speaker-mode"
}
media() { prep=(OMAMOBILE_SPK_STAGE=media "$@"); }
# the watchdog in the foreground, in stage media
ewatch() { wprep=(OMAMOBILE_SPK_STAGE=media "${wprep[@]}"); watchrun; }

# the watchdog's limits in earpiece mode
media; run e-w-idle; earset; ewatch
((rc == 0)) && [[ $(val "Top Digital PCM Volume") == 657 && $(cat "$r/run/speaker-watch-mode") == earpiece ]] || { cat "$r/watch.out" >&2; fail "earpiece watchdog: the earpiece state passes, idle; the mode answered"; }
grep -c 'earpiece mode: Top through ASP or DSP at digital <= 737, analog <= 6' "$r/watch.out" >/dev/null || { cat "$r/watch.out" >&2; fail "earpiece watchdog: says its ceilings"; }
media; run e-w-run; earset; echo 'state: RUNNING' > "$r/asound/card0/pcm5p/sub0/status"
dspset Bottom CSPL_STATE 1; dspset Top CAL_SET_STATUS 1
echo '4,100,200,300' > "$r/fw/cirrus/cs35l41-cheetah-top-media-delta.txt"; echo '4,100,200,301' > "$r/fw/cirrus/cs35l41-cheetah-bottom-media-delta.txt"
at 8 'amx cset "name=Bottom DSP1 Protection cd CSPL_TEMPERATURE" 0x00,0x0a,0x00,0x00 >/dev/null'
wprep=(FAKE_HB_STUCK=1 OMAMOBILE_SPK_TEMP_JUMP=5 OMAMOBILE_SPK_MEDIA_DELTA=1 FAKE_DELTA_LOG=$r/delta.log); ewatch
((rc == 0)) && ! muted && [[ ! -e $r/delta.log ]] || { cat "$r/watch.out" >&2; fail "earpiece watchdog: no DSP rule while neither DSP is audible (heartbeat, CSPL, calibration, jump, no media delta)"; }
ewfail() {  # name, setup...: the watchdog mutes, and says $want
  local n=$1; shift
  media; run "$n"; earset; "$@"; ewatch
  ((rc == 1)) && muted && grep -c -- "$want" "$r/run/speaker-protection" >/dev/null || { cat "$r/watch.out" "$r/run/speaker-protection" >&2; fail "earpiece watchdog: $n mutes"; }
}
want='Bottom: Digital PCM Volume 1 in earpiece mode, not muted'; ewfail e-w-bottom amx cset "name=Bottom Digital PCM Volume" 1
want='Top: Analog PCM Volume 7 above 6'; ewfail e-w-top-analog amx cset "name=Top Analog PCM Volume" 7
want='Top: Digital PCM Volume 738 above 737'; ewfail e-w-top-digital amx cset "name=Top Digital PCM Volume" 738
want='Bottom: PCM Source is ASP, not DSP'; ewfail e-w-bottom-asp amx cset "name=Bottom PCM Source" ASP
want="unknown speaker mode 'loud'"; ewfail e-w-mode eval 'echo loud > "$r/run/speaker-mode"'
mktree e-w-c8; rc=0; sp start > "$r/out" 2>&1 || rc=$?; earset 658 6 0; watchrun
((rc == 1)) && muted && grep -c 'Top: Digital PCM Volume 658 above 657' "$r/run/speaker-protection" >/dev/null || { cat "$r/watch.out" >&2; fail "earpiece watchdog: never above the stage's own digital ceiling (c8: 657)"; }
media; run e-w-spk; amx cset "name=Top PCM Source" ASP >/dev/null; amx cset "name=Top Analog PCM Volume" 6 >/dev/null; ewatch
((rc == 1)) && muted || fail "earpiece watchdog: the bypass without earpiece mode still mutes"
pass "earpiece watchdog: the top within 737/6 through ASP, the bottom muted, no DSP rule; mutes on anything else, an unknown mode included"
media; run e-raven; : > "$r/cset.log"
rc=0; prep=(OMAMOBILE_SPK_STAGE=media OMAMOBILE_SPK_SYSTEM=raven); sp earpiece on > "$r/ear.out" 2>&1 || rc=$?; prep=()
((rc == 1)) && [[ ! -s $r/cset.log ]] && grep -c 'no earpiece check for raven' "$r/ear.out" >/dev/null || { cat "$r/ear.out" >&2; fail "earpiece on is refused on raven (no C9k there yet), nothing written"; }
pass "earpiece on only where C9k passed (cheetah)"

# omamobile-speaker-protection earpiece on|off with a live watchdog
bgwatch() {
  prep=(OMAMOBILE_SPK_STAGE=media OMAMOBILE_WATCH_INTERVAL=0.05 OMAMOBILE_WATCH_GRACE=0.1 OMAMOBILE_WATCH_HB_TIMEOUT=0.3
        OMAMOBILE_WATCH_ITERATIONS=600 "${wprep[@]}")
  sp watch >> "$r/bgwatch.out" 2>&1 &
  wpid=$!; prep=(); wprep=()
  for _ in $(seq 50); do [[ -e $r/run/speaker-watch-mode ]] && break; sleep 0.1; done
}
stopwatch() {  # the job, the script under it and its python
  local k=$wpid c
  for c in $(pgrep -P "$wpid"); do k+=" $c $(pgrep -P "$c" | tr '\n' ' ')"; done
  kill $k 2>/dev/null; wait "$wpid" 2>/dev/null || true
}
ear() { prep=(OMAMOBILE_SPK_STAGE=media OMAMOBILE_SPK_ACK_WAIT=2 "${eprep[@]}"); rc=0; sp earpiece "$@" > "$r/ear.out" 2>&1 || rc=$?; prep=(); eprep=(); }
eprep=()
media; run e-on; ((rc == 0)) || { cat "$r/out" >&2; fail "earpiece: start"; }
ampstate > "$r/speaker-state"; bgwatch; : > "$r/cset.log"
ear on
((rc == 0)) || { cat "$r/ear.out" "$r/bgwatch.out" >&2; fail "earpiece on succeeds"; }
[[ $(val "Top PCM Source") == 0 && $(val "Top Analog PCM Volume") == 6 && $(val "Top Digital PCM Volume") == 657 && $(val "Top DRE Switch") == on ]] || { ampstate >&2; fail "earpiece on: the top at 657/6 through ASP, DRE on"; }
[[ $(val "Bottom Digital PCM Volume") == 0 && $(val "Bottom PCM Source") == 1 && $(val "Bottom Analog PCM Volume") == 10 ]] || { ampstate >&2; fail "earpiece on: the bottom muted, the rest of it untouched"; }
[[ $(val "Top DSP RX1 Source") == 1 && $(val "Top HW Noise Gate Enable") == 63 && $(val "Top DSP1 Protection cd CAL_R") == 0x00,0x00,0x20,0x00 ]] || fail "earpiece on: the DSP's routing, the gate and the calibration untouched"
[[ $(cat "$r/cset.log") == $'Top Digital PCM Volume=0\nBottom Digital PCM Volume=0\nTop Analog PCM Volume=6\nTop PCM Source=ASP\nTop DRE Switch=on\nTop Digital PCM Volume=657' ]] || { cat "$r/cset.log" >&2; fail "earpiece on: mute, analog down, (mode taken), bypass, DRE, unmute the top last"; }
[[ $(cat "$r/run/speaker-mode") == earpiece && $(cat "$r/run/speaker-watch-mode") == earpiece ]] || fail "earpiece on: the mode named and taken by the watchdog"
[[ $(cat "$r/run/speaker-protection") == "ok: stage media, mode earpiece: Top 657/6 through PCM Source ASP"*"Bottom muted"*"boost converter off"* ]] || { cat "$r/run/speaker-protection" >&2; fail "earpiece on: status"; }
sleep 0.3; [[ $(val "Top Digital PCM Volume") == 657 ]] || { cat "$r/bgwatch.out" >&2; fail "earpiece on: the watchdog accepts it"; }
sp status | grep -c '^mode: earpiece (the watchdog enforces: earpiece)' >/dev/null || fail "earpiece: status shows the mode"
: > "$r/cset.log"; ear on
((rc == 0)) && [[ ! -s $r/cset.log ]] && grep -c 'already on' "$r/ear.out" >/dev/null || { cat "$r/ear.out" >&2; fail "earpiece on twice: nothing written the second time"; }
rc=0; prep=(OMAMOBILE_SPK_STAGE=media OMAMOBILE_VERIFY_SECONDS=0.2); sp verify > "$r/v.out" 2>&1 || rc=$?; prep=()
((rc == 1)) && grep -c 'earpiece mode' "$r/v.out" >/dev/null || fail "verify refuses in earpiece mode"
: > "$r/cset.log"; ear off
((rc == 0)) || { cat "$r/ear.out" "$r/bgwatch.out" >&2; fail "earpiece off succeeds"; }
[[ $(ampstate) == "$(cat "$r/speaker-state")" ]] || { diff <(ampstate) "$r/speaker-state" >&2; fail "earpiece off: every control back at its speaker-mode value"; }
[[ $(cat "$r/cset.log") == $'Top Digital PCM Volume=0\nBottom Digital PCM Volume=0\nTop PCM Source=DSP\nTop Analog PCM Volume=10\nTop DRE Switch=on\nTop Digital PCM Volume=737\nBottom Digital PCM Volume=737' ]] || { cat "$r/cset.log" >&2; fail "earpiece off: mute, DSP back, (mode taken), gains, unmute both last"; }
[[ ! -e $r/run/speaker-mode && $(cat "$r/run/speaker-watch-mode") == speaker ]] || fail "earpiece off: speaker mode taken by the watchdog"
[[ $(cat "$r/run/speaker-protection") == "ok: stage media, protection firmware with factory calibration, PCM Source DSP, held awake, digital/analog Top 737/10, Bottom 737/10, boost converter off"* ]] || { cat "$r/run/speaker-protection" >&2; fail "earpiece off: the speaker status line again"; }
: > "$r/cset.log"; ear off
((rc == 0)) && [[ ! -s $r/cset.log ]] && grep -c 'already off' "$r/ear.out" >/dev/null || fail "earpiece off twice: nothing written"
eprep=(OMAMOBILE_SPK_EARPIECE_DIGITAL=577 OMAMOBILE_SPK_EARPIECE_DRE=0); ear on
((rc == 0)) && [[ $(val "Top Digital PCM Volume") == 577 && $(val "Top DRE Switch") == off ]] || { cat "$r/ear.out" >&2; fail "earpiece on: configured level and DRE"; }
ear off; ((rc == 0)) && [[ $(ampstate) == "$(cat "$r/speaker-state")" ]] || fail "earpiece off: DRE back on"
sleep 0.2; grep -c 'amplifiers muted' "$r/bgwatch.out" >/dev/null && { cat "$r/bgwatch.out" >&2; fail "earpiece: the watchdog never muted through on, off and on again"; }
# a restart in earpiece mode ends in speaker mode
ear on; stopwatch; rc=0; prep=(OMAMOBILE_SPK_STAGE=media); sp start > "$r/out" 2>&1 || rc=$?; prep=()
((rc == 0)) && [[ ! -e $r/run/speaker-mode && ! -e $r/run/speaker-watch-mode && $(ampstate) == "$(cat "$r/speaker-state")" ]] || { cat "$r/out" >&2; fail "a restart in earpiece mode ends in speaker mode"; }
pass "earpiece on/off: every control written and read back, the order safe at each step, the watchdog's answer awaited, idempotent, back to every speaker value; a restart ends in speaker mode"

# refusals: nothing changes
refused() {  # name
  ((rc == 1)) && grep -c 'refused' "$r/ear.out" >/dev/null && [[ ! -s $r/cset.log && ! -e $r/run/speaker-mode ]] || { cat "$r/ear.out" "$r/cset.log" >&2; fail "earpiece: $1 refused, nothing changed"; }
}
