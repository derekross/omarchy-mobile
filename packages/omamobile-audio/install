#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omamobile-audio into DESTDIR. Enables nothing: the speaker protection
# service is enabled by hand once AOC-PLAN.md stage C8 has passed.
#   ./install DESTDIR
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
d=${1:?Usage: ./install DESTDIR}
[[ $d == /* && $d != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
install -Dm755 bin/omamobile-speaker-protection "$d/usr/bin/omamobile-speaker-protection"
install -Dm644 systemd/omamobile-speaker-protection.service "$d/usr/lib/systemd/system/omamobile-speaker-protection.service"
install -Dm644 systemd/omamobile-speaker-watch.service "$d/usr/lib/systemd/system/omamobile-speaker-watch.service"
install -Dm644 lib/speaker_dsp.py "$d/usr/lib/omamobile-audio/speaker_dsp.py"
install -Dm644 lib/speaker_response.py "$d/usr/lib/omamobile-audio/speaker_response.py"
install -Dm755 bin/omamobile-speaker-eq "$d/usr/bin/omamobile-speaker-eq"
install -Dm644 systemd/omamobile-speaker-orient.service "$d/usr/lib/systemd/user/omamobile-speaker-orient.service"
install -Dm644 udev.rules "$d/usr/lib/udev/rules.d/70-omamobile-cs35l41.rules"
install -Dm644 modprobe.d/omamobile-audio.conf "$d/usr/lib/modprobe.d/omamobile-audio.conf"
install -Dm644 speaker.conf "$d/etc/omamobile/speaker.conf"
install -Dm644 ucm2/conf.d/aoc-snd-card/aoc-snd-card.conf "$d/usr/share/alsa/ucm2/conf.d/aoc-snd-card/aoc-snd-card.conf"
install -Dm644 ucm2/Google/cheetah/HiFi.conf "$d/usr/share/alsa/ucm2/Google/cheetah/HiFi.conf"
install -Dm644 "ucm2/conf.d/aoc-snd-card/google,tegu-aoc-snd-card.conf" "$d/usr/share/alsa/ucm2/conf.d/aoc-snd-card/google,tegu-aoc-snd-card.conf"
install -Dm644 ucm2/Google/tegu/HiFi.conf "$d/usr/share/alsa/ucm2/Google/tegu/HiFi.conf"
install -Dm644 "ucm2/conf.d/aoc-snd-card/google,raven-aoc-snd-card.conf" "$d/usr/share/alsa/ucm2/conf.d/aoc-snd-card/google,raven-aoc-snd-card.conf"
install -Dm644 ucm2/Google/raven/HiFi.conf "$d/usr/share/alsa/ucm2/Google/raven/HiFi.conf"
install -Dm644 wireplumber/51-omamobile-aoc.conf "$d/usr/share/wireplumber/wireplumber.conf.d/51-omamobile-aoc.conf"
install -Dm644 wireplumber/52-omamobile-tegu-aoc.conf "$d/usr/share/wireplumber/wireplumber.conf.d/52-omamobile-tegu-aoc.conf"
install -Dm644 wireplumber/53-omamobile-raven-aoc.conf "$d/usr/share/wireplumber/wireplumber.conf.d/53-omamobile-raven-aoc.conf"
install -Dm644 pipewire/60-omamobile-speaker-loudness.conf "$d/usr/share/pipewire/pipewire.conf.d/60-omamobile-speaker-loudness.conf"
install -Dm644 LICENSE "$d/usr/share/licenses/omamobile-audio/LICENSE"
