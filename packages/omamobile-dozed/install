#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage the package into DESTDIR (./install DESTDIR, an absolute path). One
# user unit for every graphical session, as omamobile-sleepd: it does nothing
# until the user turns the omamobile-doze toggle on. No root unit, no polkit
# rule, no udev rule, nothing in /etc. The superwhisper thaw wrapper is not
# on PATH; README says how to use it.
set -euo pipefail
d=${1:?usage: install DESTDIR}
[[ $d == /* ]] || { echo "install: DESTDIR must be an absolute path" >&2; exit 1; }
cd "$(dirname "$(readlink -f "$0")")"

install -Dm755 bin/omamobile-dozed "$d/usr/bin/omamobile-dozed"
install -Dm755 lib/superwhisper-thaw "$d/usr/lib/omamobile-dozed/superwhisper-thaw"
install -Dm644 systemd/omamobile-dozed.service "$d/usr/lib/systemd/user/omamobile-dozed.service"
install -d "$d/usr/lib/systemd/user/graphical-session.target.wants"
ln -sfn ../omamobile-dozed.service "$d/usr/lib/systemd/user/graphical-session.target.wants/omamobile-dozed.service"
install -Dm644 README.md "$d/usr/share/doc/omamobile-dozed/README.md"
install -Dm644 LICENSE "$d/usr/share/licenses/omamobile-dozed/LICENSE"
