+    cairo_fill (cr);
+
+    cairo_push_group (cr);
+    tactus_icon_clear (cr, self->width - S_CLEAR_X * self->s, field_y + field_h / 2, self->vs, &button, &cross);
+    cairo_pop_group_to_source (cr);
