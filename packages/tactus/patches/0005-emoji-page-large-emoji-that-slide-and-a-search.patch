+static gboolean
+pos_emoji_search_draw (GtkWidget *widget, cairo_t *cr)
+{
+  PosEmojiSearch *self = POS_EMOJI_SEARCH (widget);
+  double field_y = E_FIELD_TOP * self->vs, field_h = E_FIELD_H * self->vs;
+  double pitch = E_PITCH * self->vs, inset = (E_COL0 - E_PITCH / 2) * self->vs;
+  double text_x = E_FIELD_TEXT_X * self->s, size = E_FIELD_FONT * self->vs;
