+static void
+search_update (PosEmojiSearch *self)
+{
+  g_auto (GStrv) words = g_strsplit (self->query->str, " ", -1);
+  gboolean any = FALSE;
+
+  g_ptr_array_set_size (self->found, 0);
+  self->scroll = 0.0;
+  for (int w = 0; words[w]; w++)
+    any = any || words[w][0] != '\0';
+
+  if (!any) {
+    /* nothing typed yet: the emoji used lately */
+    g_autoptr (GVariant) variant = g_settings_get_value (self->settings, "recent-emoji");
+    GVariantIter iter;
+    GVariant *entry;
+
+    g_variant_iter_init (&iter, variant);
+    while ((entry = g_variant_iter_next_value (&iter))) {
+      EmojiItem *emoji = g_new0 (EmojiItem, 1);
+
+      emoji->data = g_variant_get_child_value (entry, 0);
+      g_variant_get_child (entry, 1, "u", &emoji->modifier);
+      emoji->text = emoji_text (emoji->data, emoji->modifier, &emoji->tones);
+      if (emoji_drawable (GTK_WIDGET (self), &self->usual_width, emoji->text))
+        g_ptr_array_add (self->found, emoji);
+      else
+        emoji_item_free (emoji);
+      g_variant_unref (entry);
+    }
+  } else {
+    GVariant *data = pos_emoji_db_get_data (pos_emoji_db_get_default ());
+    GVariantIter iter;
+    GVariant *item;
+
+    g_variant_iter_init (&iter, data);
+    while ((item = g_variant_iter_next_value (&iter))) {
+      guint group;
+
+      g_variant_get_child (item, 3, "u", &group);
+      if (kind_of_group (group) != TACTUS_N_KINDS && self->found->len < S_MAX_FOUND &&
+          search_matches (item, words)) {
+        EmojiItem *emoji = g_new0 (EmojiItem, 1);
+
+        emoji->data = g_variant_ref (item);
+        emoji->text = emoji_text (item, 0, &emoji->tones);
+        /* as on the page: only what the font has a picture for */
+        if (emoji_drawable (GTK_WIDGET (self), &self->usual_width, emoji->text))
+          g_ptr_array_add (self->found, emoji);
+        else
+          emoji_item_free (emoji);
+      }
+      g_variant_unref (item);
+    }
+  }
+  gtk_widget_queue_draw (GTK_WIDGET (self));
 }
 
+/**
+ * pos_emoji_search_reset:
+ * @self: The search
+ *
+ * Start over: nothing typed.
+ */
+void
+pos_emoji_search_reset (PosEmojiSearch *self)
+{
+  g_return_if_fail (POS_IS_EMOJI_SEARCH (self));
+
+  g_string_truncate (self->query, 0);
+  search_update (self);
+}
+
+
+void
+pos_emoji_search_type (PosEmojiSearch *self, const char *text)
+{
+  g_return_if_fail (POS_IS_EMOJI_SEARCH (self));
+
+  if (text == NULL || self->query->len > 60)
+    return;
+  g_string_append (self->query, text);
+  search_update (self);
+}
+
+
+void
+pos_emoji_search_backspace (PosEmojiSearch *self)
+{
+  const char *prev;
+
+  g_return_if_fail (POS_IS_EMOJI_SEARCH (self));
+
+  if (self->query->len == 0)
+    return;
+  prev = g_utf8_find_prev_char (self->query->str, self->query->str + self->query->len);
+  g_string_truncate (self->query, prev - self->query->str);
+  search_update (self);
+}
+
+
+const char *
+pos_emoji_search_get_query (PosEmojiSearch *self)
+{
+  g_return_val_if_fail (POS_IS_EMOJI_SEARCH (self), NULL);
+
+  return self->query->str;
+}
