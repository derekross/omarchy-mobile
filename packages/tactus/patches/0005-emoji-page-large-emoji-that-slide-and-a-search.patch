+
+static double
+search_scroll_max (PosEmojiSearch *self)
+{
+  double pitch = E_PITCH * self->vs, inset = (E_COL0 - E_PITCH / 2) * self->vs;
+
+  return MAX (self->found->len * pitch + 2 * inset - self->width, 0.0);
+}
+
+
+static EmojiItem *
+search_at (PosEmojiSearch *self, double x, double y)
+{
+  double pitch = E_PITCH * self->vs, inset = (E_COL0 - E_PITCH / 2) * self->vs;
+  double at = x + self->scroll - inset;
+  int index;
+
+  if (fabs (y - S_ROW_Y * self->vs) > pitch / 2 || at < 0)
+    return NULL;
+  index = (int) (at / pitch);
+  return index < (int) self->found->len ? g_ptr_array_index (self->found, index) : NULL;
+}
+
+
+static gboolean
+search_on_clear (PosEmojiSearch *self, double x, double y)
+{
+  return self->query->len > 0 && y < (E_FIELD_TOP + E_FIELD_H + 4.0) * self->vs &&
+         x > self->width - 2 * S_CLEAR_X * self->s;
+}
+
+
+static void
+search_begin (PosEmojiSearch *self, GdkEventSequence *sequence, double x, double y)
+{
+  if (self->touching)
+    return;
+  self->touching = TRUE;
+  self->sequence = sequence;
+  self->x0 = self->x = x;
+  self->y = y;
+  self->scroll0 = self->scroll;
+  self->sliding = FALSE;
+  self->on_clear = search_on_clear (self, x, y);
+  self->pressed = self->on_clear ? NULL : search_at (self, x, y);
+  gtk_widget_queue_draw (GTK_WIDGET (self));
+}
+
+
+static void
+search_move (PosEmojiSearch *self, GdkEventSequence *sequence, double x, double y)
+{
+  if (!self->touching || self->sequence != sequence)
+    return;
+  self->x = x;
+  self->y = y;
+  if (!self->sliding && !self->on_clear && fabs (x - self->x0) > DRAG_START) {
+    self->sliding = TRUE;
+    self->pressed = NULL;
+    self->x0 = x;
+    self->scroll0 = self->scroll;
+  }
+  if (self->sliding) {
+    self->scroll = CLAMP (self->scroll0 - (x - self->x0), 0.0, search_scroll_max (self));
+    gtk_widget_queue_draw (GTK_WIDGET (self));
+  }
+}
+
+
+static void
+search_end (PosEmojiSearch *self, GdkEventSequence *sequence, double x, double y, gboolean cancelled)
+{
+  if (!self->touching || self->sequence != sequence)
+    return;
+  self->touching = FALSE;
+
+  if (!cancelled && !self->sliding) {
+    if (self->on_clear && search_on_clear (self, x, y)) {
+      pos_emoji_search_reset (self);
+    } else if (self->pressed && search_at (self, x, y) == self->pressed) {
+      EmojiItem *emoji = self->pressed;
+      g_autofree char *text = g_strdup (emoji->text);
+      g_autoptr (GVariant) mine = recent_data (emoji);
+      g_autoptr (GVariant) variant = g_settings_get_value (self->settings, "recent-emoji");
+      GVariantBuilder builder;
+      GVariantIter iter;
+      GVariant *entry;
+      guint n = 1;
+
+      /* it leads the emoji used lately from now on */
+      g_variant_builder_init (&builder, G_VARIANT_TYPE ("a((auss)u)"));
+      g_variant_builder_add (&builder, "(@(auss)u)", mine, emoji->modifier);
+      g_variant_iter_init (&iter, variant);
+      while ((entry = g_variant_iter_next_value (&iter))) {
+        g_autoptr (GVariant) other = g_variant_get_child_value (entry, 0);
+        g_autoptr (GVariant) codes = g_variant_get_child_value (other, 0);
+        g_autoptr (GVariant) my_codes = g_variant_get_child_value (mine, 0);
+        gunichar modifier;
+
+        g_variant_get_child (entry, 1, "u", &modifier);
+        if (n < MAX_RECENT && !(g_variant_equal (codes, my_codes) && modifier == emoji->modifier)) {
+          g_variant_builder_add (&builder, "(@(auss)u)", other, modifier);
+          n++;
+        }
+        g_variant_unref (entry);
+      }
+      self->pressed = NULL;
+      g_settings_set_value (self->settings, "recent-emoji", g_variant_builder_end (&builder));
+      g_signal_emit (self, search_signals[S_EMOJI_PICKED], 0, text);
+    }
+  }
+  self->pressed = NULL;
+  self->on_clear = FALSE;
+  self->sliding = FALSE;
+  gtk_widget_queue_draw (GTK_WIDGET (self));
+}
+
+
+static gboolean
+pos_emoji_search_touch_event (GtkWidget *widget, GdkEventTouch *event)
+{
+  PosEmojiSearch *self = POS_EMOJI_SEARCH (widget);
+
+  if (event->type == GDK_TOUCH_BEGIN)
+    search_begin (self, event->sequence, event->x, event->y);
+  else if (event->type == GDK_TOUCH_UPDATE)
+    search_move (self, event->sequence, event->x, event->y);
+  else if (event->type == GDK_TOUCH_END)
+    search_end (self, event->sequence, event->x, event->y, FALSE);
+  else if (event->type == GDK_TOUCH_CANCEL)
+    search_end (self, event->sequence, event->x, event->y, TRUE);
+  else
+    return GDK_EVENT_PROPAGATE;
+  return GDK_EVENT_STOP;
+}
+
+
+static gboolean
+pos_emoji_search_button_press_event (GtkWidget *widget, GdkEventButton *event)
+{
+  if (event->button != 1 || gdk_event_get_pointer_emulated ((GdkEvent *) event))
+    return GDK_EVENT_PROPAGATE;
+  search_begin (POS_EMOJI_SEARCH (widget), POINTER_SEQUENCE, event->x, event->y);
+  return GDK_EVENT_STOP;
+}
+
+
+static gboolean
+pos_emoji_search_button_release_event (GtkWidget *widget, GdkEventButton *event)
+{
+  if (event->button != 1 || gdk_event_get_pointer_emulated ((GdkEvent *) event))
+    return GDK_EVENT_PROPAGATE;
+  search_end (POS_EMOJI_SEARCH (widget), POINTER_SEQUENCE, event->x, event->y, FALSE);
+  return GDK_EVENT_STOP;
+}
+
+
+static gboolean
+pos_emoji_search_motion_notify_event (GtkWidget *widget, GdkEventMotion *event)
+{
+  if (!(event->state & GDK_BUTTON1_MASK) || gdk_event_get_pointer_emulated ((GdkEvent *) event))
