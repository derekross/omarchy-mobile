+  for (guint i = 0; i < self->found->len; i++) {
+    EmojiItem *emoji = g_ptr_array_index (self->found, i);
+    double cx = inset + (i + 0.5) * pitch - self->scroll;
+
+    if (cx < -pitch || cx > self->width + pitch)
+      continue;
+    if (emoji == self->pressed) {
+      double half = pitch / 2 - 2.0 * self->vs;
+
+      tactus_rounded_rect (cr, cx - half, S_ROW_Y * self->vs - half, 2 * half, 2 * half, 9.0 * self->vs);
+      tactus_set_source (cr, &disc, 1.0);
+      cairo_fill (cr);
+    }
+    tactus_draw_emoji (cr, emoji->text, cx, S_ROW_Y * self->vs, self->font_size, 1.0);
+  }
+  cairo_restore (cr);
+
+  return FALSE;
+}
+
+
+static void
+pos_emoji_search_size_allocate (GtkWidget *widget, GdkRectangle *allocation)
+{
+  PosEmojiSearch *self = POS_EMOJI_SEARCH (widget);
+  gboolean changed = self->width != allocation->width;
+
+  self->width = allocation->width;
+  self->height = allocation->height;
+  self->s = self->width / PT_WIDTH;
+  self->vs = MIN (self->width, PT_WIDTH_MAX) / PT_WIDTH;
+
+  GTK_WIDGET_CLASS (pos_emoji_search_parent_class)->size_allocate (widget, allocation);
+  if (changed)
+    gtk_widget_queue_resize (widget);
+}
+
+
+static void
+pos_emoji_search_get_preferred_height (GtkWidget *widget, int *minimum, int *natural)
+{
+  PosEmojiSearch *self = POS_EMOJI_SEARCH (widget);
+  int width = self->width > 0 ? self->width : MINIMUM_WIDTH;
+
+  *minimum = *natural = ceil (S_HEIGHT * MIN (width, PT_WIDTH_MAX) / PT_WIDTH);
+}
+
+
+static void
+pos_emoji_search_get_preferred_width (GtkWidget *widget, int *minimum, int *natural)
+{
+  *minimum = *natural = MINIMUM_WIDTH;
+}
+
+
+static void
+search_color_scheme_changed (PosEmojiSearch *self)
+{
+  g_autofree char *scheme = g_settings_get_string (self->interface_settings, "color-scheme");
+
+  tactus_theme_init (&self->theme, g_strcmp0 (scheme, "prefer-dark") == 0);
+  gtk_widget_queue_draw (GTK_WIDGET (self));
+}
+
+
+static void
+pos_emoji_search_finalize (GObject *object)
+{
+  PosEmojiSearch *self = POS_EMOJI_SEARCH (object);
+
+  g_clear_pointer (&self->found, g_ptr_array_unref);
+  g_string_free (self->query, TRUE);
+  g_clear_object (&self->settings);
+  g_clear_object (&self->interface_settings);
+
+  G_OBJECT_CLASS (pos_emoji_search_parent_class)->finalize (object);
+}
+
+
+static void
+pos_emoji_search_class_init (PosEmojiSearchClass *klass)
+{
+  GObjectClass *object_class = G_OBJECT_CLASS (klass);
+  GtkWidgetClass *widget_class = GTK_WIDGET_CLASS (klass);
+
+  object_class->finalize = pos_emoji_search_finalize;
+
+  widget_class->draw = pos_emoji_search_draw;
+  widget_class->size_allocate = pos_emoji_search_size_allocate;
+  widget_class->get_preferred_height = pos_emoji_search_get_preferred_height;
+  widget_class->get_preferred_width = pos_emoji_search_get_preferred_width;
+  widget_class->touch_event = pos_emoji_search_touch_event;
+  widget_class->button_press_event = pos_emoji_search_button_press_event;
+  widget_class->button_release_event = pos_emoji_search_button_release_event;
+  widget_class->motion_notify_event = pos_emoji_search_motion_notify_event;
+
+  /**
+   * PosEmojiSearch::emoji-picked:
+   * @self: The search
+   * @emoji: The emoji that was picked among the ones found
+   */
+  search_signals[S_EMOJI_PICKED] = g_signal_new ("emoji-picked",
+                                                 G_OBJECT_CLASS_TYPE (object_class),
+                                                 G_SIGNAL_RUN_LAST,
+                                                 0, NULL, NULL, NULL,
+                                                 G_TYPE_NONE, 1, G_TYPE_STRING | G_SIGNAL_TYPE_STATIC_SCOPE);
+
+  gtk_widget_class_set_css_name (widget_class, "pos-emoji-search");
+}
+
+
+static void
+pos_emoji_search_init (PosEmojiSearch *self)
+{
+  self->query = g_string_new (NULL);
+  self->found = g_ptr_array_new_with_free_func (emoji_item_free);
+  self->s = self->vs = MINIMUM_WIDTH / PT_WIDTH;
+
+  self->settings = g_settings_new ("mobi.phosh.osk.EmojiPicker");
+  self->interface_settings = g_settings_new ("org.gnome.desktop.interface");
+  g_signal_connect_swapped (self->interface_settings, "changed::color-scheme",
+                            G_CALLBACK (search_color_scheme_changed), self);
+  tactus_theme_watch (self, G_CALLBACK (search_color_scheme_changed));
+  search_color_scheme_changed (self);
+
+  gtk_widget_add_events (GTK_WIDGET (self),
+                         GDK_TOUCH_MASK |
+                         GDK_BUTTON_PRESS_MASK |
+                         GDK_BUTTON_RELEASE_MASK |
+                         GDK_BUTTON_MOTION_MASK);
+}
