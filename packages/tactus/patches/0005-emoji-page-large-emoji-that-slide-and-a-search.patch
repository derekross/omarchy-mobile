+  cairo_fill (cr);
+  tactus_icon_magnifier (cr, E_FIELD_ICON_X * self->s, field_y + field_h / 2, self->vs, &hint);
+
+  if (self->query->len == 0) {
+    draw_words (cr, "Search Emoji", text_x, field_y + field_h / 2, size, &hint);
+    /* the caret, where the words will go */
+    cairo_rectangle (cr, text_x - 1.5 * self->vs, field_y + field_h / 2 - 11.0 * self->vs, 2.0 * self->vs,
+                     22.0 * self->vs);
+    tactus_set_source (cr, &self->theme.accent, 1.0);
+    cairo_fill (cr);
+  } else {
+    g_autoptr (PangoLayout) layout = pango_cairo_create_layout (cr);
+    PangoFontDescription *font = pango_font_description_from_string ("Adwaita Sans, Inter, Noto Sans, sans-serif");
+    PangoRectangle logical;
+    TactusRgb cross = field;
+    TactusRgb button = hint;
+
+    draw_words (cr, self->query->str, text_x, field_y + field_h / 2, size, &word);
+    pango_font_description_set_absolute_size (font, size * PANGO_SCALE);
+    pango_layout_set_font_description (layout, font);
+    pango_font_description_free (font);
+    pango_layout_set_text (layout, self->query->str, -1);
+    pango_layout_get_extents (layout, NULL, &logical);
+    cairo_rectangle (cr, text_x + (double) logical.width / PANGO_SCALE + 1.5 * self->vs,
+                     field_y + field_h / 2 - 11.0 * self->vs, 2.0 * self->vs, 22.0 * self->vs);
