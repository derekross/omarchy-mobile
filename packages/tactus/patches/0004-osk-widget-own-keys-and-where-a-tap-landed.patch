+                             GValue     *value,
+                             GParamSpec *pspec)
+{
+  PosOskWidget *self = POS_OSK_WIDGET (object);
+
+  switch (property_id) {
+  case PROP_LAYER:
+    g_value_set_enum (value, self->layer);
+    break;
+  case PROP_NAME:
+    g_value_set_string (value, self->name);
+    break;
+  case PROP_MODE:
+    g_value_set_enum (value, self->mode);
+    break;
+  case PROP_FEATURES:
+    g_value_set_flags (value, self->features);
+    break;
+  case PROP_KEY_HEIGHT:
