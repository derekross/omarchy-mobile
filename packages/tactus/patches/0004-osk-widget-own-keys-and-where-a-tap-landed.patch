+
+/**
+ * pos_osk_widget_get_overhang:
+ * @self: The osk widget
+ *
+ * The height, in pixels, of the clear band above the keyboard's panel where
+ * a row of accented letters is drawn. Touches there are not the keyboard's.
+ */
+guint
+pos_osk_widget_get_overhang (PosOskWidget *self)
+{
+  g_return_val_if_fail (POS_IS_OSK_WIDGET (self), 0);
+
+  return self->overhang;
+}
+
+
+/**
+ * pos_osk_widget_get_panel_height:
+ * @self: The osk widget
+ *
+ * The height, in pixels, of the keyboard's panel: its keys and the strip under them.
+ */
+guint
+pos_osk_widget_get_panel_height (PosOskWidget *self)
+{
+  int natural;
+
+  g_return_val_if_fail (POS_IS_OSK_WIDGET (self), 0);
+
+  natural = tactus_height_for_width (self, self->width > 0 ? self->width : MINIMUM_WIDTH);
+  return MAX (natural - (int) (self->overhang - self->extra), 0);
+}
+
+/**
+ * pos_osk_widget_get_panel_under:
+ * @self: The osk widget
+ *
+ * How far, in pixels, the applications' windows are to reach under the top of
+ * the panel, so that what shows past its round corners is theirs.
+ */
+guint
+pos_osk_widget_get_panel_under (PosOskWidget *self)
+{
+  g_return_val_if_fail (POS_IS_OSK_WIDGET (self), 0);
+
+  return tactus_panel_under (self->vs > 0.0 ? self->vs : MINIMUM_WIDTH / PT_WIDTH);
+}
+
+/**
+ * pos_osk_widget_set_flat_top:
+ * @self: The osk widget
+ * @flat: Whether something sits right on top of the panel, so that its corners there are square
+ */
+void
+pos_osk_widget_set_flat_top (PosOskWidget *self, gboolean flat)
+{
+  g_return_if_fail (POS_IS_OSK_WIDGET (self));
+
+  if (self->flat_top == !!flat)
+    return;
+  self->flat_top = !!flat;
+  gtk_widget_queue_draw (GTK_WIDGET (self));
+}
+
+
+/**
+ * pos_osk_widget_set_attached:
+ * @self: The osk widget
+ * @attached: Whether something sits right on top of the keys (the search for emoji)
+ *
+ * Attached, the keyboard keeps no clear room above its keys and its panel's
+ * top is square.
+ */
+void
+pos_osk_widget_set_attached (PosOskWidget *self, gboolean attached)
+{
+  g_return_if_fail (POS_IS_OSK_WIDGET (self));
+
+  if (self->attached == !!attached)
+    return;
+  self->attached = !!attached;
+  pos_osk_widget_cancel_touches (self);
+  tactus_update_metrics (self, self->width > 0 ? self->width : MINIMUM_WIDTH);
+  gtk_widget_queue_resize (GTK_WIDGET (self));
+  gtk_widget_queue_draw (GTK_WIDGET (self));
+}
+
+
+gboolean
+pos_osk_widget_get_caps_lock (PosOskWidget *self)
+{
+  g_return_val_if_fail (POS_IS_OSK_WIDGET (self), FALSE);
+
+  return self->caps_lock;
+}
+
+/**
+ * pos_osk_widget_set_autoshift:
+ * @self: The osk widget
+ * @wanted: Whether the next letter starts a sentence
+ * @context_changed: Whether the text or the cursor changed since the last call
+ *
+ * Tell the keyboard whether the next letter should be a capital. A Shift the
+ * owner set by hand stays until the text changes.
+ */
+void
+pos_osk_widget_set_autoshift (PosOskWidget *self, gboolean wanted, gboolean context_changed)
+{
+  g_return_if_fail (POS_IS_OSK_WIDGET (self));
+
+  self->autoshift = wanted;
+  if (context_changed)
+    self->shift_override = FALSE;
+
+  if (!tactus_is_letters (self->layer) || self->shift_override || self->caps_lock)
+    return;
+  if (tactus_held (self, TACTUS_TOUCH_SHIFT, NULL))
+    return;
+
+  tactus_set_layer (self, tactus_letters_layer (self));
+}
+
+/**
+ * pos_osk_widget_take_tap:
+ * @self: The osk widget
+ * @dx:(out): How far right of its key's centre the finger was, in key widths
+ * @dy:(out): How far below, in row heights
+ *
+ * Where the finger landed for the letter being typed right now. Valid only
+ * while `key-symbol` is emitted for a letter key.
+ *
+ * Returns: %TRUE if there is such a place
+ */
+gboolean
+pos_osk_widget_take_tap (PosOskWidget *self, double *dx, double *dy)
+{
+  g_return_val_if_fail (POS_IS_OSK_WIDGET (self), FALSE);
+
+  if (!self->tap_valid)
+    return FALSE;
+
+  *dx = self->tap_dx;
+  *dy = self->tap_dy;
+  return TRUE;
+}
+
+/**
+ * pos_osk_widget_set_paste_shown:
+ * @self: The osk widget
+ * @shown: Whether there is something to paste
+ *
+ * The paste key is there only while there is something to paste. Nothing
+ * else under the keys moves when it comes or goes, and a finger on it when
+ * it goes types nothing.
+ */
+void
+pos_osk_widget_set_paste_shown (PosOskWidget *self, gboolean shown)
+{
+  g_return_if_fail (POS_IS_OSK_WIDGET (self));
+
+  if (self->paste_shown == !!shown)
+    return;
+  self->paste_shown = !!shown;
+
+  for (int i = 0; i < MAX_TOUCHES && !shown; i++) {
+    TactusTouch *t = &self->touches[i];
+
+    if (t->active && t->kind == TACTUS_TOUCH_STRIP && t->down_role == TACTUS_ROLE_PASTE) {
+      t->strayed = TRUE;
+      t->geom = NULL;
+      g_clear_handle_id (&t->long_id, g_source_remove);
+    }
+  }
+  gtk_widget_queue_draw (GTK_WIDGET (self));
+}
+
+/**
+ * pos_osk_widget_set_touch_bias:
+ * @self: The osk widget
+ * @dx: How far right of where they aim this owner's fingers land, in key widths
+ * @dy: How far below, in row heights
+ *
+ * Touches are read as that much further left and up.
+ */
+void
+pos_osk_widget_set_touch_bias (PosOskWidget *self, double dx, double dy)
+{
+  g_return_if_fail (POS_IS_OSK_WIDGET (self));
+
+  self->bias_x = CLAMP (dx, -0.25, 0.25);
+  self->bias_y = CLAMP (dy, -0.35, 0.35);
+}
