+static void
+tactus_draw_popup (PosOskWidget *self, cairo_t *cr)
+{
+  const TactusTheme *theme = &self->theme;
+  double radius = PT_POPUP_RADIUS * self->vs;
+  double pad = 2.0 * self->vs;
+  double x = self->popup.x - pad, w = self->popup.w + 2 * pad;
+  double y = self->popup.y, h = self->popup.h;
+
+  /* a soft shadow, then the row itself */
+  for (int i = 3; i >= 1; i--) {
+    tactus_rounded_rect (cr, x - i, y - i + 1.5, w + 2 * i, h + 2 * i, radius + i);
+    cairo_set_source_rgba (cr, 0, 0, 0, theme->dark ? 0.10 : 0.035);
+    cairo_fill (cr);
+  }
+  tactus_rounded_rect (cr, x, y, w, h, radius);
+  tactus_set_source (cr, &theme->popup, 1.0);
+  cairo_fill (cr);
+
+  for (int i = 0; i < self->popup.options->len; i++) {
+    const char *option = g_ptr_array_index (self->popup.options, i);
+    double cx = self->popup.x + (i + 0.5) * self->popup.cell;
+    double cy = y + h / 2;
+    gboolean lower = g_unichar_islower (g_utf8_get_char (option));
+
+    if (i == self->popup.selected) {
+      double sw = MIN (PT_POPUP_SEL_W * self->vs, self->popup.cell - 1.0);
+      double sh = PT_POPUP_SEL_H * self->vs;
+
+      tactus_rounded_rect (cr, cx - sw / 2, cy - sh / 2, sw, sh, 10.0 * self->vs);
+      tactus_set_source (cr, &theme->popup_selected, 1.0);
+      cairo_fill (cr);
+    }
+    tactus_draw_label (cr, option, cx, lower ? cy : cy - 1.5 * self->vs,
+                       (lower ? PT_FONT_LOWER : PT_FONT_UPPER) * self->vs,
+                       lower ? WEIGHT_LOWER : WEIGHT_UPPER,
+                       lower ? TACTUS_BAND_X_HEIGHT : TACTUS_BAND_CAP_HEIGHT, &theme->text);
+  }
 }
 
 
