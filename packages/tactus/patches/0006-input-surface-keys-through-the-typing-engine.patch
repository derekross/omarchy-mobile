+/*
+ * Tactus's look: the keyboard is a panel at the bottom of the surface.
+ * What is above it is clear: there the accents of a held key are drawn, the
+ * application shows through, and touches are the application's.
+ */
+
+static int
+tactus_measure_clear (PosInputSurface *self)
+{
+  GtkWidget *child = hdy_deck_get_visible_child (self->deck);
+  int y = 0, clear;
+
+  if (child == NULL || !gtk_widget_get_realized (GTK_WIDGET (self)))
+    return 0;
+  /* A bar above the keys reaches to the top */
+  if (gtk_widget_get_visible (GTK_WIDGET (self->shortcuts_bar)) ||
+      gtk_widget_get_visible (self->completion_bar) ||
+      (self->emoji_search && gtk_widget_get_visible (self->emoji_search)))
+    return 0;
+
+  if (!gtk_widget_translate_coordinates (child, GTK_WIDGET (self), 0, 0, NULL, &y))
+    y = 0;
+  clear = y;
+  if (POS_IS_OSK_WIDGET (child))
+    clear += pos_osk_widget_get_overhang (POS_OSK_WIDGET (child));
+
+  return MAX (clear, 0);
+}
+
+
+/* How far the windows reach under the top of the panel (tactus_panel_under) */
+static int
+tactus_under (PosInputSurface *self)
+{
+  if (self->last_layout && POS_IS_OSK_WIDGET (self->last_layout))
+    return pos_osk_widget_get_panel_under (POS_OSK_WIDGET (self->last_layout));
+
+  return tactus_panel_under (360.0 / 390.0);
+}
+
+
+/* Whether the surface has the height it last asked for. Between asking and
+ * getting it, what is drawn and what is measured belong to two pages. */
+static gboolean
+tactus_settled (PosInputSurface *self)
+{
+  int asked = 0;
+
+  g_object_get (self, "height", &asked, NULL);
+
+  return asked == gtk_widget_get_allocated_height (GTK_WIDGET (self));
+}
+
+
+static void
+tactus_keep_room (PosInputSurface *self, int room)
+{
+  self->zone = room;
+  g_debug ("Room kept for the keyboard: %d", self->zone);
+  phosh_layer_surface_set_exclusive_zone (PHOSH_LAYER_SURFACE (self), self->zone);
+  phosh_layer_surface_wl_surface_commit (PHOSH_LAYER_SURFACE (self));
+}
+
+
+/* The room the page that shows needs, as the surface is laid out now */
+static int
+tactus_room (PosInputSurface *self)
+{
+  int height = gtk_widget_get_allocated_height (GTK_WIDGET (self));
+  int clear = tactus_measure_clear (self);
+
+  if (clear >= height)
+    clear = 0;
+
+  return MAX (height - clear - tactus_under (self), 0);
+}
+
+
+/* A frame of the keyboard has gone to the compositor (GDK commits it in its
+ * own handler of this signal, connected before ours) */
+static void
+on_frame_painted (PosInputSurface *self, GdkFrameClock *clock)
+{
+  int room;
+
+  if (self->surface_visible == TRUE && self->animation.progress >= 1.0 && !tactus_settled (self))
+    return; /* the frame at the new height is yet to come */
+
+  g_signal_handlers_disconnect_by_func (clock, on_frame_painted, self);
+  self->room_wait = FALSE;
+  if (self->surface_visible != TRUE || self->animation.progress < 1.0)
+    return; /* put away meanwhile, or sliding: pos_input_surface_move sets it */
+
+  room = tactus_room (self);
+  if (room != self->zone)
+    tactus_keep_room (self, room);
+}
+
+
+/* More room for the keyboard is asked for only once the frame that shows the
+ * taller page is with the compositor. Asked for before it, the window in
+ * front is made shorter at once while the old, lower page is still on the
+ * screen, and for as long as the new page takes to draw the wallpaper shows
+ * between the two. */
+static void
+tactus_room_after_paint (PosInputSurface *self)
+{
+  GdkFrameClock *clock = gtk_widget_get_frame_clock (GTK_WIDGET (self));
+
+  if (clock == NULL)
+    return;
+  if (!self->room_wait) {
+    self->room_wait = TRUE;
+    g_signal_connect_object (clock, "after-paint", G_CALLBACK (on_frame_painted), self,
+                             G_CONNECT_SWAPPED | G_CONNECT_AFTER);
+  }
+  gtk_widget_queue_draw (GTK_WIDGET (self));
+}
+
+
+static void
+tactus_update_shape (PosInputSurface *self)
+{
+  int width, height, clear, room;
+  cairo_rectangle_int_t rect;
+  cairo_region_t *region;
+
+  /* The number pad takes the place of the keys, no more and no less */
+  if (self->last_layout && POS_IS_OSK_WIDGET (self->last_layout) && !self->searching) {
+    GtkWidget *others[] = { self->keypad };
+    int natural = 0, panel, over;
+
+    gtk_widget_get_preferred_height (self->last_layout, &natural, NULL);
+    panel = pos_osk_widget_get_panel_height (POS_OSK_WIDGET (self->last_layout));
+    over = MAX (natural - panel, 0);
+    for (guint i = 0; i < G_N_ELEMENTS (others); i++) {
+      int req = 0;
+
+      gtk_widget_get_size_request (others[i], NULL, &req);
+      if (gtk_widget_get_margin_top (others[i]) != over)
+        gtk_widget_set_margin_top (others[i], over);
+      if (req != panel)
+        gtk_widget_set_size_request (others[i], -1, panel);
+    }
+  }
+
+  if (!gtk_widget_get_realized (GTK_WIDGET (self)))
+    return;
+
+  width = gtk_widget_get_allocated_width (GTK_WIDGET (self));
+  height = gtk_widget_get_allocated_height (GTK_WIDGET (self));
+  clear = tactus_measure_clear (self);
+  if (clear >= height)
+    clear = 0;
+
+  rect = (cairo_rectangle_int_t) { 0, clear, width, height - clear };
+  region = cairo_region_create_rectangle (&rect);
+  gtk_widget_input_shape_combine_region (GTK_WIDGET (self), region);
+  cairo_region_destroy (region);
+
+  self->clear = clear;
+
+  /* Room is kept for the panel only, less the little the windows reach
+   * under its top: past the panel's round corners it is then the application
+   * that shows, not the wallpaper. Whichever page shows. Not while the
+   * keyboard slides: there pos_input_surface_move sets it. */
+  if (self->surface_visible != TRUE || self->animation.progress < 1.0)
+    return;
+
+  if (!tactus_settled (self)) {
+    /* A page of another height has just come up and the surface has asked
+     * for that height. A lower page gives its room back now, while the
+     * taller one is still on the screen; a taller one waits (below). */
+    GtkWidget *child = hdy_deck_get_visible_child (self->deck);
+    int asked = 0, above = 0;
+
+    g_object_get (self, "height", &asked, NULL);
+    if (clear > 0 && child) {
+      above = gtk_widget_get_margin_top (child);
+      if (POS_IS_OSK_WIDGET (child))
+        above += pos_osk_widget_get_overhang (POS_OSK_WIDGET (child));
+    }
+    room = MAX (asked - above - tactus_under (self), 0);
+    if (room < self->zone)
+      tactus_keep_room (self, room);
+    return;
+  }
+
+  room = MAX (height - clear - tactus_under (self), 0);
+  if (room < self->zone)
+    tactus_keep_room (self, room);
+  else if (room > self->zone)
+    tactus_room_after_paint (self);
+}
+
+
+static void
+on_shape_idle (gpointer data)
+{
+  PosInputSurface *self = POS_INPUT_SURFACE (data);
+
+  self->shape_id = 0;
+  tactus_update_shape (self);
+}
+
+
+static void
+tactus_queue_shape (PosInputSurface *self)
+{
+  if (self->shape_id == 0)
+    self->shape_id = g_idle_add_once (on_shape_idle, self);
+}
+
+/* The surface got a new size (a page of another height came up) */
+static void
+on_surface_size_allocate (PosInputSurface *self)
+{
+  tactus_queue_shape (self);
+}
+
+/* The number pad draws no ground of its own: its style's, before its keys */
+static gboolean
+on_page_draw (GtkWidget *widget, cairo_t *cr)
+{
+  gtk_render_background (gtk_widget_get_style_context (widget), cr, 0, 0,
+                         gtk_widget_get_allocated_width (widget),
+                         gtk_widget_get_allocated_height (widget));
+  return GDK_EVENT_PROPAGATE;
+}
+
+/* What isn't drawn by the keyboard itself (the emoji, the number pad, the
+ * bars) in the keyboard's colours */
+static void
+tactus_update_css (PosInputSurface *self)
+{
+  g_autofree char *scheme = g_settings_get_string (self->interface_settings, "color-scheme");
+  g_autofree char *css = NULL;
+  g_autoptr (GError) err = NULL;
+  TactusTheme theme;
+
+  tactus_theme_init (&theme, g_strcmp0 (scheme, "prefer-dark") == 0);
+  css = tactus_theme_css (&theme);
+  if (!gtk_css_provider_load_from_data (self->tactus_css, css, -1, &err))
+    g_warning ("The keyboard's colours: %s", err->message);
+}
