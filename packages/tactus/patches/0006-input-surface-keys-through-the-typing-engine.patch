+/*
+ * Tactus's typing: the keys of a language layout go through the typing
+ * engine, which corrects words and knows where sentences start
+ */
+
+static void
+tactus_op_commit (const char *text, gpointer data)
+{
+  PosInputSurface *self = POS_INPUT_SURFACE (data);
+
+  pos_input_method_send_string (self->input_method, text, TRUE);
+}
+
+
+/* A key by its name, as a key press to the application. Return held
+ * ("KEY_NEWLINE") is Return with Shift: a new line in every text field that
+ * sends on Return, and a plain new line everywhere else. */
+static void
+tactus_press_key (PosInputSurface *self, const char *symbol, PosKeycodeModifier modifiers)
+{
+  if (g_strcmp0 (symbol, POS_OSK_SYMBOL_NEWLINE) == 0) {
+    symbol = "KEY_ENTER";
+    modifiers |= POS_KEYCODE_MODIFIER_SHIFT;
+  }
+  pos_vk_driver_key_down (self->keyboard_driver, symbol, modifiers);
+  pos_vk_driver_key_up (self->keyboard_driver, symbol);
+}
+
+
+static void
+tactus_op_key (const char *symbol, gpointer data)
+{
+  tactus_press_key (POS_INPUT_SURFACE (data), symbol, POS_KEYCODE_MODIFIER_NONE);
+}
+
+
+static void
+tactus_op_erase (guint n_chars, guint n_bytes, gboolean by_keys, gpointer data)
+{
+  PosInputSurface *self = POS_INPUT_SURFACE (data);
+
+  if (!by_keys) {
+    pos_input_method_delete_surrounding_text (self->input_method, n_bytes, 0, TRUE);
+    return;
+  }
+  for (guint i = 0; i < n_chars; i++)
+    tactus_op_key ("KEY_BACKSPACE", self);
+}
+
+
+static void
+tactus_op_shift (gboolean wanted, gboolean context_changed, gpointer data)
+{
+  PosInputSurface *self = POS_INPUT_SURFACE (data);
+  GtkWidget *child = hdy_deck_get_visible_child (self->deck);
+
+  self->autoshift = wanted;
+  /* what is typed into the search for emoji is no sentence */
+  if (POS_INPUT_SURFACE_IS_LANG_LAYOUT (child))
+    pos_osk_widget_set_autoshift (POS_OSK_WIDGET (child), wanted && !self->searching, context_changed);
+}
+
+
+/* An answer with nothing in it: see the typing engine's answer() */
+static void
+tactus_op_ack (gpointer data)
+{
+  PosInputSurface *self = POS_INPUT_SURFACE (data);
+
+  if (pos_input_method_get_active (self->input_method))
+    pos_input_method_commit (self->input_method);
+}
+
+
+static void
+on_typer_wake (gpointer data)
+{
+  PosInputSurface *self = POS_INPUT_SURFACE (data);
+
+  self->typer_wake_id = 0;
+  tactus_typer_poll (self->typer);
+}
+
+
+static void
+tactus_op_wake (guint ms, gpointer data)
+{
+  PosInputSurface *self = POS_INPUT_SURFACE (data);
+
+  g_clear_handle_id (&self->typer_wake_id, g_source_remove);
+  self->typer_wake_id = g_timeout_add_once (ms, on_typer_wake, self);
+  g_source_set_name_by_id (self->typer_wake_id, "[tactus-typer-wake]");
+}
+
+/* Whether the keys go through the typing engine right now: there is a text
+ * field for ordinary text, and what shows is a language layout (or the
+ * emoji, which type into the same text) */
+static gboolean
+tactus_typer_usable (PosInputSurface *self)
+{
+  GtkWidget *child;
+
+  if (!self->typer_on || self->latched_modifiers)
+    return FALSE;
+
+  child = hdy_deck_get_visible_child (self->deck);
+  return POS_INPUT_SURFACE_IS_LANG_LAYOUT (child) || child == self->emoji_picker;
+}
+
+static void tactus_queue_shape (PosInputSurface *self);
+
+/* Searching for emoji by name, or not: the search sits on top of the letters,
+ * which type into it for as long as it is there */
+static void
+tactus_search_set (PosInputSurface *self, gboolean on)
+{
+  if (self->searching == !!on || self->emoji_search == NULL)
+    return;
+
+  self->searching = !!on;
+  if (on)
+    pos_emoji_search_reset (POS_EMOJI_SEARCH (self->emoji_search));
+  for (guint i = 0; self->osks && i < self->osks->len; i++) {
+    PosOskWidget *osk = g_ptr_array_index (self->osks, i);
+
+    pos_osk_widget_set_attached (osk, on);
+    pos_osk_widget_set_autoshift (osk, !on && self->typer_on && self->autoshift, TRUE);
+  }
+  gtk_widget_set_visible (self->emoji_search, on);
+  /* the keyboard changes its height */
+  tactus_typer_settle (self->typer, 700);
+  tactus_queue_shape (self);
+}
+
+/* The text field gave a sign of life */
+static void
+on_im_done (PosInputSurface *self, PosInputMethod *im)
+{
+  PosInputMethodHint hint = pos_input_method_get_hint (im);
+  gboolean wanted;
+  const char *text;
+  guint anchor = 0, cursor = 0;
+
+  /* Swiped away, the keyboard comes back when its text field is touched
+   * again (the field then says where its cursor is). Not at once: the field
+   * also speaks as it gets the room the keyboard left. */
+  if (!pos_input_method_get_active (im)) {
+    self->swiped_at = 0;
+    tactus_search_set (self, FALSE);
+  } else if (self->swiped_at && self->surface_visible == FALSE &&
+             g_get_monotonic_time () - self->swiped_at > TACTUS_SWIPED_QUIET_US) {
+    self->swiped_at = 0;
+    pos_input_surface_set_visible (self, TRUE);
+  }
+
+  /* Not where what is typed is hidden (a password) */
+  wanted = pos_input_method_get_active (im) &&
+    pos_input_method_get_purpose (im) == POS_INPUT_METHOD_PURPOSE_NORMAL &&
+    !(hint & TACTUS_HINT_HIDDEN);
+
+  if (wanted != self->typer_on) {
+    if (g_getenv ("TACTUS_TRACE"))
+      g_message ("text field: %s, purpose %d, hints 0x%x: the typing engine is %s",
+                 pos_input_method_get_active (im) ? "there" : "gone", pos_input_method_get_purpose (im), hint,
+                 wanted ? "on" : "off");
+    self->typer_on = wanted;
+    tactus_typer_focus (self->typer, wanted);
+    if (wanted) {
+      double dx, dy;
+
+      /* What was learned about where the owner's fingers land */
+      tactus_ac_get_bias (&dx, &dy);
+      for (guint i = 0; self->osks && i < self->osks->len; i++)
+        pos_osk_widget_set_touch_bias (g_ptr_array_index (self->osks, i), dx, dy);
+    }
+  }
+  if (!wanted)
+    return;
+
+  tactus_typer_set_hints (self->typer, hint);
+  text = pos_input_method_get_surrounding_text (im, &anchor, &cursor);
+  tactus_typer_state (self->typer, text, cursor, anchor);
+}
+
+/* A key under the keyboard that hands over to the phone's shell: where the
+ * command isn't there, the shell says so in the log and nothing else happens */
+static void
+tactus_run (const char *what, const char *command)
+{
+  const char *argv[] = { "sh", "-c", command, NULL };
+  g_autoptr (GError) err = NULL;
+
+  if (!g_spawn_async (NULL, (char **) argv, NULL, G_SPAWN_SEARCH_PATH, NULL, NULL, NULL, &err))
+    g_warning ("%s: %s", what, err->message);
+}
+
+static void set_keymap (PosInputSurface *self);
+
+/* The Paste key is there while there is something to paste */
+static gboolean
+tactus_paste_changed (gpointer data)
+{
+  PosInputSurface *self = POS_INPUT_SURFACE (data);
+  gboolean shown = tactus_clipboard_can_paste (self->clipboard);
+
+  for (guint i = 0; self->osks && i < self->osks->len; i++)
+    pos_osk_widget_set_paste_shown (g_ptr_array_index (self->osks, i), shown);
+  if (self->osk_terminal)
+    pos_osk_widget_set_paste_shown (POS_OSK_WIDGET (self->osk_terminal), shown);
+  return G_SOURCE_REMOVE;
+}
+
+/*
+ * A tap on Paste: the last copy, pasted the way an application pastes, with
+ * Shift and Insert from the keyboard's own virtual keyboard (what a pick in
+ * Omarchy's clipboard list ends in, and what the terminal, GTK and the
+ * phone's own programs take as Paste). The text is never typed out: a copy
+ * with a line break in it would press Return half way through, and where
+ * Return sends, half a message would be gone. A picture is pasted the same way.
+ *
+ * With nothing on the clipboard itself (the program it was copied in has
+ * gone) the newest entry of the clipboard's history is pasted, by the shell's
+ * own commands, as a tap on it in the list would.
+ */
+static void
+tactus_paste (PosInputSurface *self)
+{
+  const TactusClipEntry *newest;
+  g_autofree char *index = NULL;
+  g_autoptr (GError) err = NULL;
+  const char *argv[5] = { NULL };
+
+  if (tactus_clipboard_has_copy (self->clipboard)) {
+    if (self->keyboard_driver == NULL)
+      return;
+    /* An accent or an emoji was just sent with a keymap of its own */
+    if (self->keymap_delayed_id) {
+      g_clear_handle_id (&self->keymap_delayed_id, g_source_remove);
+      set_keymap (self);
+    }
+    tactus_press_key (self, "KEY_INSERT", POS_KEYCODE_MODIFIER_SHIFT);
+    return;
+  }
+
+  newest = tactus_clipboard_newest (self->clipboard);
+  if (newest == NULL)
+    return;
+  if (newest->image) {
+    argv[0] = "omarchy-clipboard-paste-file";
+    argv[1] = newest->mime;
+    argv[2] = newest->path;
+  } else {
+    index = g_strdup_printf ("%d", newest->index);
+    argv[0] = "omarchy-clipboard-paste-text";
+    argv[1] = "--shift-insert";
+    argv[2] = "--history-index";
+    argv[3] = index;
+  }
+  if (!g_spawn_async (NULL, (char **) argv, NULL, G_SPAWN_SEARCH_PATH, NULL, NULL, NULL, &err))
+    g_warning ("Paste: %s", err->message);
+}
+
+/* One of the keys under the keyboard */
+static void
+on_osk_strip_key (PosInputSurface *self, const char *which, GtkWidget *osk_widget)
+{
+  g_return_if_fail (POS_IS_INPUT_SURFACE (self));
+
+  if (g_strcmp0 (which, "emoji") == 0) {
+    tactus_search_set (self, FALSE);
+    if (self->action_map)
+      g_action_group_change_action_state (G_ACTION_GROUP (self->action_map), "select-layout",
+                                          g_variant_new_string ("emoji"));
+  } else if (g_strcmp0 (which, "mic") == 0) {
+    tactus_run ("Dictation", TACTUS_DICTATION);
+  } else if (g_strcmp0 (which, "paste") == 0) {
+    tactus_paste (self);
+  } else if (g_strcmp0 (which, "clipboard") == 0) {
+    /* Held. The list takes the keyboard focus, so the text field lets go of the
+     * keyboard, and its pick is pasted into the app when the list has closed */
+    tactus_run ("Paste", TACTUS_CLIPBOARD);
+  }
+}
+
+
+/* The emoji page's microphone */
+static void
+on_emoji_picker_mic (PosInputSurface *self)
+{
+  on_osk_strip_key (self, "mic", NULL);
+}
+
+/* The emoji page's search field was tapped: the letters come up, with the search on top */
+static void
+on_emoji_picker_search (PosInputSurface *self)
+{
+  if (self->last_layout == NULL)
+    return;
+  tactus_search_set (self, TRUE);
+  hdy_deck_set_visible_child (self->deck, self->last_layout);
+}
+
+/* An emoji among the ones the search found */
+static void
+on_search_emoji_picked (PosInputSurface *self, const char *emoji)
+{
+  if (tactus_typer_usable (self))
+    tactus_typer_text (self->typer, emoji, TRUE);
+  else if (pos_input_method_get_active (self->input_method))
+    pos_input_method_send_string (self->input_method, emoji, TRUE);
+  pos_input_surface_trigger_feedback (self, KEY_PRESS_EVENT);
+}
