# Omarchy Mobile first boot: creates the user and finishes the setup that
# tools/install-phone asked for on the laptop (/etc/omamobile/firstboot.conf).
# Runs only while that file exists, before the login screen. SSH over USB
# works meanwhile (root, with the installer's key); the log is
# /var/log/omamobile/firstboot.log.
[Unit]
Description=Omarchy Mobile first-boot setup
ConditionPathExists=/etc/omamobile/firstboot.conf
After=local-fs.target systemd-user-sessions.service systemd-networkd.service network.target time-set.target
Before=display-manager.service
Wants=network.target systemd-timesyncd.service time-set.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/omamobile-firstboot
# Omarchy's user setup runs here; on the phone it takes minutes, not seconds
TimeoutStartSec=45min
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
