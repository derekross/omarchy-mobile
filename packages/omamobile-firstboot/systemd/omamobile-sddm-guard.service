# Restarts sddm once if its autologin fails in a tight loop (see
# /usr/bin/omamobile-sddm-guard). At most one restart per 10 minutes.
[Unit]
Description=Omarchy Mobile SDDM autologin loop guard

[Service]
ExecStart=/usr/bin/omamobile-sddm-guard
Restart=always
RestartSec=10
Nice=10
ProtectHome=read-only
NoNewPrivileges=yes
PrivateTmp=yes
RuntimeDirectory=omamobile-sddm-guard
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
