# Restarts sddm once if its autologin fails in a tight loop (see
# /usr/bin/omamobile-sddm-guard). At most one restart per 10 minutes and
# three per boot. Not enabled by the package yet; to use it:
#   systemctl enable --now omamobile-sddm-guard
[Unit]
Description=Omamobile SDDM autologin loop guard

[Service]
ExecStart=/usr/bin/omamobile-sddm-guard
Restart=always
RestartSec=10
Nice=10
ProtectHome=read-only
NoNewPrivileges=yes
PrivateTmp=yes
RuntimeDirectory=omamobile-sddm-guard
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
