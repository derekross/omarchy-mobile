#!/bin/bash
# SPDX-License-Identifier: MIT
# Stops an SDDM autologin loop. With Relogin=true (set by firstboot, since a
# phone can't type into the greeter) SDDM logs in again at once when the
# session ends, with no backoff. If the old logind session still holds tty1,
# every try fails ("Auth: sddm-helper exited with 5") and SDDM spins: one
# phone did ~530 tries a minute for six hours until sddm was restarted.
# This follows SDDM's journal, and when failed autologins pass THRESHOLD in
# WINDOW seconds it logs why and restarts sddm once. After a restart it waits
# COOLDOWN seconds before it would restart again, so it can't loop itself;
# the restart time is kept in STATE_DIR (/run), so a restarted guard keeps it.
# If the owner has an active wayland session it leaves sddm alone, unless the
# loop goes on for PERSIST seconds anyway (on 11-11 the old session was alive).
# The owner is the autologin user firstboot wrote in AUTOLOGIN_CONF.
# At most MAX_RESTARTS restarts per boot (the count is kept in /run too): we
# don't know a restart cures the loop, so after that it logs one line and does
# nothing more until a reboot. The phone is then left with sddm looping as it
# would be without the guard; the owner's session, if any, keeps running.
#   omamobile-sddm-guard   (run by omamobile-sddm-guard.service)
set -uo pipefail
THRESHOLD=${OMAMOBILE_SDDM_GUARD_THRESHOLD:-20}
WINDOW=${OMAMOBILE_SDDM_GUARD_WINDOW:-60}
COOLDOWN=${OMAMOBILE_SDDM_GUARD_COOLDOWN:-600}
AUTOLOGIN_CONF=${OMAMOBILE_SDDM_GUARD_AUTOLOGIN:-/etc/sddm.conf.d/autologin.conf}
MAX_RESTARTS=${OMAMOBILE_SDDM_GUARD_MAX_RESTARTS:-3}
PERSIST=${OMAMOBILE_SDDM_GUARD_PERSIST:-300}
CHECK_EVERY=60   # seconds between session checks (and skip log lines)
STATE_DIR=${OMAMOBILE_SDDM_GUARD_STATE:-/run/omamobile-sddm-guard}

# The guard's own clock, not the journal's: the wall clock can jump (an
# offline phone seeds it at first boot), and the cooldown must not.
now() { local up; read -r up _ < /proc/uptime && echo "${up%%.*}"; }
[[ -n ${OMAMOBILE_SDDM_GUARD_CLOCK:-} ]] && now() { "$OMAMOBILE_SDDM_GUARD_CLOCK"; }

# True when the owner has a healthy graphical session: then sddm's failures
# don't matter enough to pull the session down with a restart.
OWNER=$(sed -n 's/^[[:space:]]*User[[:space:]]*=[[:space:]]*\([^[:space:]]*\).*/\1/p' "$AUTOLOGIN_CONF" 2>/dev/null | tail -n 1)
[[ -n $OWNER ]] ||
  echo "omamobile-sddm-guard: no autologin user in $AUTOLOGIN_CONF, so no session counts as the owner's" >&2
owner_session_ok() {
  local id props
  [[ -n $OWNER ]] || return 1
  for id in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
    props=$(loginctl show-session "$id" -p Name -p Type -p Active -p State 2>/dev/null) || continue
    grep -qxF "Name=$OWNER" <<<"$props" && grep -qx 'Type=wayland' <<<"$props" &&
      grep -qx 'Active=yes' <<<"$props" && grep -qx 'State=active' <<<"$props" && return 0
  done
  return 1
}

fails=()      # guard-clock times of recent failed autologins
last=-1       # guard-clock time of the last restart, -1 = none yet
loop_since=-1 # guard-clock time the loop began, -1 = no loop now
checked=-1    # guard-clock time of the last session check
session_ok=1  # its result
# /proc/uptime and /run both start over at boot, so a stored time is valid
# as long as it is not in the future
read -r stored 2>/dev/null < "$STATE_DIR/last-restart"
read -r count 2>/dev/null < "$STATE_DIR/restarts"
[[ ${count:-} =~ ^[0-9]+$ ]] || count=0
t=$(now)
[[ ${stored:-} =~ ^[0-9]+$ && $t =~ ^[0-9]+$ ]] && (( stored <= t )) && last=$stored
save() { # save NAME VALUE
  mkdir -p "$STATE_DIR" && echo "$2" > "$STATE_DIR/$1.tmp" &&
    mv -f "$STATE_DIR/$1.tmp" "$STATE_DIR/$1" ||
    echo "omamobile-sddm-guard: could not save $1 in $STATE_DIR" >&2
}
while IFS= read -r line; do
  [[ $line == *'sddm-helper exited with 5'* ]] || continue
  t=$(now)
  [[ $t =~ ^[0-9]+$ ]] || continue
  keep=()
  for f in "${fails[@]}"; do (( t - f < WINDOW )) && keep+=("$f"); done
  fails=("${keep[@]}" "$t")
  if (( ${#fails[@]} <= THRESHOLD )); then loop_since=-1; continue; fi
  (( loop_since < 0 )) && loop_since=$t
  if (( count >= MAX_RESTARTS )); then
    if [[ ! -e $STATE_DIR/capped ]]; then
      echo "omamobile-sddm-guard: sddm is looping again after $count restarts this boot, giving up until a reboot"
      save capped 1
    fi
    continue
  fi
  if (( last >= 0 && t - last < COOLDOWN )); then
    continue
  fi
  why="restarting sddm once"
  if (( checked < 0 || t - checked >= CHECK_EVERY )); then
    checked=$t
    owner_session_ok; session_ok=$?
    (( session_ok == 0 && t - loop_since < PERSIST )) &&
      echo "omamobile-sddm-guard: ${#fails[@]} failed autologins in ${WINDOW}s, but $OWNER has an active wayland session, so sddm is left alone (looping for $((t - loop_since))s, restart anyway at ${PERSIST}s)"
  fi
  if (( session_ok == 0 )); then
    (( t - loop_since < PERSIST )) && continue
    why="looping for $((t - loop_since))s despite $OWNER's active wayland session, restarting sddm anyway"
  fi
  echo "omamobile-sddm-guard: ${#fails[@]} failed autologins in ${WINDOW}s, $why (next restart no sooner than ${COOLDOWN}s)"
  # sddm's StartLimitBurst counts our restart too: clear it, or a restart
  # right after sddm restarted itself would leave it stopped
  systemctl reset-failed sddm.service 2>/dev/null
  systemctl restart sddm.service || echo "omamobile-sddm-guard: restarting sddm failed" >&2
  last=$t
  save last-restart "$t"
  count=$((count + 1))
  save restarts "$count"
  fails=()
  loop_since=-1
  checked=-1
done < <(journalctl -f -n 0 -o cat -u sddm.service)
# journalctl -f only ends when something is wrong: fail, so systemd restarts us
echo "omamobile-sddm-guard: the journal follow ended, exiting so systemd restarts the guard" >&2
exit 1
