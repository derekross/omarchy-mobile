#!/bin/bash
# SPDX-License-Identifier: MIT
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
bash -n PKGBUILD
grep -q '^depends=(qrtr zstd)$' PKGBUILD
[[ $(grep -c '^makedepends=' PKGBUILD) == 1 ]]
grep -q 'linux-msm/tqftpserv/tree/v1.2' PKGBUILD
! grep -Eq '^(conflicts|groups)=' PKGBUILD
echo 'ok - tqftpserv dependencies and provenance'
