# SPDX-License-Identifier: MIT
[Unit]
Description=Bring up the Komodo Mali GPU with a hardware watchdog guard
After=local-fs.target systemd-modules-load.service
Before=display-manager.service
ConditionPathExists=/sys/bus/platform/devices/1f000000.gpu

[Service]
Type=oneshot
ExecStart=/usr/bin/omamobile-komodo-gpu-start
RemainAfterExit=yes
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
