+fn line(agent: &Agent, m: &omatel_store::Message, group: bool) -> String {
+    let text = if m.body.trim().is_empty() && m.transport == "mms" {
+        let parts = agent
+            .messages
+            .lock()
+            .unwrap()
+            .parts(m.id)
+            .unwrap_or_default();
+        mms::describe_parts(&parts).to_string()
+    } else {
+        m.body.clone()
+    };
+    if group && !m.sender.is_empty() {
