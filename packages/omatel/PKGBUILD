# SPDX-License-Identifier: MIT
# Maintainer: Derek Ross <derekross@gmail.com>
#
# omatel-agent: the background service behind Omarchy Mobile's Phone
# (packages/omaphone) and Messages (packages/omamessages) apps
# (docs/TELEPHONY-APPS-PLAN.md T6/T7). It rings for calls, writes the call
# log, stores incoming SMS and raises notifications, and serves
# org.omamobile.Phone1 and org.omamobile.Messages1. From the omatel
# repository (github.com/derekross/omatel, GPL-3.0-or-later), which also
# holds the crates the apps share; the apps have repositories of their own
# since 0.2.0. Not in omamobile-apps' defaults yet.
#
# Source: the release tag's tarball from GitHub, pinned by its sha256
# (README.md). Build: cargo fetches the crates (Cargo.lock pinned) in
# prepare() and builds offline. A developer iterating on omatel
# cross-compiles instead (omatel's bin/cross).
pkgname=omatel-agent
pkgver=0.2.4
pkgrel=1
pkgdesc="Phone and Messages background service: rings, call log, SMS storage, notifications"
arch=(aarch64)
url="https://github.com/derekross/omatel"
license=('GPL-3.0-or-later' 'MIT')
# feedbackd rings and vibrates (the sound theme's phone-incoming-call, the
# vibration motor through the device package's udev rule): calls ring by
# default since 0.2.1-2. From 0.2.2 the agent leaves ringing calls to the
# shell's call card when it runs (omamobile-shell 0.2.12); from 0.2.3 Omarchy's
# Do Not Disturb silences every caller but starred contacts.
depends=(gcc-libs glibc sqlite dbus systemd feedbackd sound-theme-freedesktop)
optdepends=('omaphone: the Phone app'
            'omamessages: the Messages app'
            'omamobile-mmd: the modem (ModemManager API) on Omarchy Mobile phones'
            'callaudiod: call audio routing (speaker, mute), with call audio (T4)')
makedepends=(cargo pkgconf sqlite)
checkdepends=(dbus)
install=omatel-agent.install
options=('!debug' '!lto')
source=("omatel-$pkgver.tar.gz::https://github.com/derekross/omatel/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('e02986f33b70e89accb67bf62c4d4e1b695b2d12acc801008db80c1bf6242670')

prepare() {
  cd "omatel-$pkgver"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "omatel-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p omatel-agent
}

check() {
  cd "omatel-$pkgver"
  export CARGO_TARGET_DIR=target
  # The logic without D-Bus or a display: contacts, numbers, the stores,
  # the API types (the D-Bus and chain tests run on the laptop:
  # scripts/check.sh, scripts/chain-test.sh).
  cargo test --frozen -p omatel-contacts -p omatel-store -p omatel-api --lib
}

package() {
  cd "omatel-$pkgver"
  install -Dm755 target/release/omatel-agent "$pkgdir/usr/bin/omatel-agent"
  install -Dm644 data/omatel-agent.service "$pkgdir/usr/lib/systemd/user/omatel-agent.service"
  install -Dm644 data/org.omamobile.Phone1.service "$pkgdir/usr/share/dbus-1/services/org.omamobile.Phone1.service"
  install -Dm644 data/org.omamobile.Messages1.service "$pkgdir/usr/share/dbus-1/services/org.omamobile.Messages1.service"
  install -Dm644 README.md "$pkgdir/usr/share/doc/omatel/README.md"
  install -Dm644 docs/export-format.md "$pkgdir/usr/share/doc/omatel/export-format.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
