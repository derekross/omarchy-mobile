# Waits for msm DRM to take the panel before Plymouth and the display manager
# start (plymouth-start.service.d/ and display-manager.service.d/
# 10-omamobile-kebab.conf). Plymouth starts before sysinit.target, so this
# runs that early too: no default dependencies, after udev has loaded the
# drivers from the root.
[Unit]
Description=Wait for the OnePlus 8T panel on msm DRM
DefaultDependencies=no
After=systemd-udev-trigger.service systemd-udevd.service systemd-modules-load.service
Before=plymouth-start.service display-manager.service sysinit.target

[Service]
Type=oneshot
ExecStart=/usr/bin/omamobile-kebab-display-wait
RemainAfterExit=yes
TimeoutStartSec=30
