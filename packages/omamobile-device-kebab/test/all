#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu
cd "$(dirname "$0")/.."
cmp reboot-to.c ../../device/kebab/initramfs/reboot-to.c
cmp reboot ../../device/kebab/reboot
sh -n reboot
echo ok wrapper
echo ok sources
for f in ucm2/OnePlus/kebab/kebab.conf ucm2/OnePlus/kebab/HiFi.conf; do
  [ -s "$f" ] || { echo "missing $f"; exit 1; }
done
grep -q "TERT_MI2S_RX Audio Mixer MultiMedia1" ucm2/OnePlus/kebab/HiFi.conf
grep -q "VA DMIC MUX0' DMIC3" ucm2/OnePlus/kebab/HiFi.conf
echo ok ucm
sh -n bin/omamobile-kebab-display-wait
grep -q "^Before=.*plymouth-start.service.*display-manager.service" systemd/omamobile-kebab-display.service
grep -q "^After=omamobile-kebab-display.service" systemd/10-omamobile-kebab.conf
grep -q "^After=omamobile-kebab-display.service" systemd/plymouth-start/10-omamobile-kebab.conf
grep -q "^DefaultDependencies=no" systemd/omamobile-kebab-display.service
echo ok display-wait
