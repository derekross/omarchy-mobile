#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omamobile-device-tangorpro into DESTDIR. Nothing is enabled that would
# mark a slot successful or start the radio, the charger, or a camera. Wi-Fi
# is installed but not started at boot: omamobile-wifi.service has no wants
# link until its gated runbook passes (device/tangorpro/WIFI-PLAN.md), and
# its modules never autoload.
#   ./install DESTDIR [BUILDDIR]
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
destination=${1:?Usage: ./install DESTDIR [BUILDDIR]}
build=${2:-build}
[[ $destination == /* && $destination != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
install -Dm755 "$build/reboot-to" "$destination/usr/bin/reboot-to"
install -Dm644 vendor/udev/rules.d/10-omamobile-storage.rules \
  "$destination/usr/lib/udev/rules.d/10-omamobile-storage.rules"
install -Dm644 vendor/systemd/network/20-usb-gadget.network \
  "$destination/usr/lib/systemd/network/20-usb-gadget.network"
install -Dm644 vendor/systemd/logind.conf.d/10-omamobile-power-key.conf \
  "$destination/usr/lib/systemd/logind.conf.d/10-omamobile-power-key.conf"
install -Dm644 vendor/NetworkManager/conf.d/10-omamobile-usb.conf \
  "$destination/usr/lib/NetworkManager/conf.d/10-omamobile-usb.conf"
# Wi-Fi (the Pixel 7's files, unchanged): the hang-safe start script, its
# unit (not enabled), the autoload blacklist and the MAC from the bootloader
for tool in omamobile-wifi-start omamobile-wlan-mac; do
  install -Dm755 "bin/$tool" "$destination/usr/bin/$tool"
done
install -Dm644 vendor/systemd/system/omamobile-wifi.service \
  "$destination/usr/lib/systemd/system/omamobile-wifi.service"
install -Dm644 vendor/modprobe.d/omamobile-wifi.conf \
  "$destination/usr/lib/modprobe.d/omamobile-wifi.conf"
install -Dm644 vendor/udev/rules.d/80-omamobile-wlan-mac.rules \
  "$destination/usr/lib/udev/rules.d/80-omamobile-wlan-mac.rules"
install -Dm644 device.conf \
  "$destination/usr/share/omamobile/device.conf"
install -Dm644 etc/omamobile-mirrorlist \
  "$destination/etc/pacman.d/omamobile-mirrorlist"
install -Dm644 LICENSE "$destination/usr/share/licenses/omamobile-device-tangorpro/LICENSE"
install -Dm644 version "$destination/usr/share/omamobile/device-tangorpro/version"
