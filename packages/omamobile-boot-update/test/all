#!/bin/bash
# SPDX-License-Identifier: MIT
# Tests for omamobile-boot-update, from a copy of this directory alone, with
# no root, no phone and no real block device: every "partition" is a regular
# file in a fake root (OMAMOBILE_BOOT_ROOT) with a fake /sys/block, /proc and
# power supply. Covers the descriptor rules, the image builder (with the real
# mkbootimg, avbtool, lz4 and dtc when installed, else stand-ins), the hook's
# opt-in, every refusal before a write, the write and its read-back, the
# saved previous set, an interrupted write and the rollback.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
PKG=$PWD
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }

for f in bin/omamobile-boot-update lib/omamobile-boot-images lib/descriptor.sh install test/all; do
  bash -n "$f" || fail "$f parses"
done
pass "scripts parse"

t=$(mktemp -d)
trap 'rm -rf "$t"' EXIT

./install "$t/stage"
for f in usr/bin/omamobile-boot-update usr/lib/omamobile-boot-update/omamobile-boot-images \
         usr/lib/omamobile-boot-update/descriptor.sh usr/share/libalpm/hooks/90-omamobile-boot.hook \
         usr/share/omamobile/boot-update/boot-update.conf.example usr/share/licenses/omamobile-boot-update/LICENSE \
         usr/share/omamobile/boot-update/version usr/share/omamobile-boot-update/avb/testkey_rsa4096.pem \
         usr/share/omamobile-boot-update/avb/SOURCE usr/share/licenses/omamobile-boot-update/LICENSE.avb; do
  [[ -e $t/stage/$f ]] || fail "not staged: $f"
done
[[ ! -e $t/stage/etc/omamobile/boot-update.conf ]] || fail "the package never ships /etc/omamobile/boot-update.conf (absent means AUTO_WRITE=no)"
grep -qx 'AUTO_WRITE=no' etc/boot-update.conf || fail "the example says AUTO_WRITE=no"
[[ $(sha256sum < avb/testkey_rsa4096.pem | cut -d' ' -f1) == 6a224754880a57ab9cbd308267cd157d94cf05a1c8cb851aec4090e045d24121 ]] \
  || fail "the AVB key is AOSP's test key, as avb/SOURCE names it"
grep -c 6a224754880a57ab9cbd308267cd157d94cf05a1c8cb851aec4090e045d24121 avb/SOURCE bin/omamobile-boot-update | grep -c ':0$' >/dev/null \
  && fail "avb/SOURCE and the tool name the key's checksum"
pass "install stages the tool, its library, the hook and AOSP's test key, and no config that would turn it on"

hook=libalpm/90-omamobile-boot.hook
for want in 'Operation = Install' 'Operation = Upgrade' 'Type = Path' 'Target = usr/lib/modules/*/vmlinuz' \
            'Target = usr/lib/modules/*/dtbs/*' 'Target = usr/share/omamobile/device.conf' \
            'Target = usr/lib/omamobile/*/dtbo.img' 'Target = usr/lib/omamobile/*/initramfs.cpio.lz4' \
            'When = PostTransaction' 'Exec = /usr/bin/omamobile-boot-update hook'; do
  grep -qxF "$want" "$hook" || fail "hook: $want"
done
grep -q 'Operation = Remove' "$hook" && fail "hook: nothing to write when the kernel goes away"
grep -q AbortOnFail "$hook" && fail "hook: a post-transaction hook cannot abort"
[[ ${hook##*/} > 60-depmod.hook && ${hook##*/} > 10-linux-modules-post.hook ]] || fail "hook runs after depmod and kernel-modules-hook"
pass "the hook runs after depmod on kernel and boot-file changes, never on removal"

# Nothing in the tool may name a partition outside slot B's boot images:
# the only writes are dd of=, to a partition the checks found
grep -nE 'of=' bin/omamobile-boot-update | grep -v 'of="\$dev"' && fail "every dd writes to the checked partition"
grep -nE 'setrw|blockdev --setro|mkfs|sgdisk|parted|fastboot|vbmeta_[ab]? |devinfo |--slot' bin/omamobile-boot-update lib/omamobile-boot-images \
  | grep -v '^[^:]*:[0-9]*: *#' && fail "no partition-table, guard or fastboot command"
pass "the only write is dd to a checked partition"

# ---------------------------------------------------------------- descriptors
descriptor() { # codename soc soc_ids board_id boot_images ufs_rw
  cat <<EOF
CODENAME=$1
NAME="Test $1"
SOC=$2
COMPATIBLE="google,$2-$1"
PACKAGE=omamobile-device-$1
DTB=exynos/google/$2-$1.dtb
SOC_IDS="$3"
DTBO_SOURCE=$1-overlay.dts
DTBO_BOARD_ID=$4
DTBO_BOARD_REV=0x10000
VENDOR_CMDLINE="console=tty0 earlycon=exynos4210,0x10A00000"
VENDOR_PAGESIZE=0x800
OS_VERSION=17.0.0
OS_PATCH_LEVEL=2026-10
BOOT_IMAGES="$5"
UFS_RW="$6"
INITRAMFS_INIT=/initramfs/init
PANEL_SIZE=1080x2400
EOF
}
FIVE="boot init_boot vendor_boot vendor_kernel_boot dtbo"
RW5="boot_b init_boot_b vendor_boot_b vendor_kernel_boot_b dtbo_b userdata"
descriptor twelve gs201 "b0:0x9855001 a0:0x9855000" 0x30306 "$FIVE" "$RW5" > "$t/twelve.conf"
descriptor six gs101 "b0:0x9845001 a0:0x9845000" 0x20304 "boot vendor_boot dtbo" "boot_b vendor_boot_b dtbo_b userdata" > "$t/six.conf"
load() { bash -c 'die() { echo "$*" >&2; exit 1; }; source "$1/lib/descriptor.sh"; bu_load_descriptor "$2"; echo "$DEV_CODENAME $DEV_MAIN_LUN"' _ "$PKG" "$1"; }
[[ $(load "$t/twelve.conf") == "twelve sda" ]] || fail "a gs201 descriptor loads (main LUN sda)"
[[ $(load "$t/six.conf") == "six sda" ]] || fail "a gs101 descriptor loads"
bad() { # name sed-expression expected-message
  sed "$2" "$t/twelve.conf" > "$t/bad.conf"
  local out
  if out=$(load "$t/bad.conf" 2>&1); then fail "descriptor refused: $1"; fi
  grep -qF -- "$3" <<<"$out" || fail "descriptor $1: says '$3' (got: $out)"
}
bad "persist in UFS_RW" 's/^UFS_RW=.*/UFS_RW="boot_b persist userdata"/' "only *_b partitions and userdata"
bad "slot A in UFS_RW" 's/^UFS_RW=.*/UFS_RW="boot_a init_boot_b vendor_boot_b vendor_kernel_boot_b dtbo_b userdata"/' "not boot_a"
bad "vbmeta_b in UFS_RW" 's/^UFS_RW=.*/UFS_RW="vbmeta_b boot_b init_boot_b vendor_boot_b vendor_kernel_boot_b dtbo_b userdata"/' "not vbmeta_b"
bad "no userdata" 's/ userdata"/"/' "must include userdata"
bad "a name twice" 's/^UFS_RW="boot_b /UFS_RW="boot_b boot_b /' "names boot_b twice"
bad "an image off the allowlist" 's/^UFS_RW=.*/UFS_RW="boot_b init_boot_b vendor_boot_b dtbo_b userdata"/' "vendor_kernel_boot_b is not in UFS_RW"
bad "userdata as an image" 's/^BOOT_IMAGES=.*/BOOT_IMAGES="boot vendor_boot dtbo userdata"/' "is not in UFS_RW"
bad "BOOT_IMAGES without dtbo" 's/^BOOT_IMAGES=.*/BOOT_IMAGES="boot init_boot vendor_boot vendor_kernel_boot"/' "must include dtbo"
bad "the Qualcomm chain" '$a BOOT_METHOD=qcom-abl' "no slot-B update path"
bad "RAM-only" '$a BOOT_METHOD=ram-only' "no slot-B update path"
bad "shell in a value" 's/^NAME=.*/NAME="$(reboot)"/' "not a KEY=value line"
bad "backticks" 's/^SOC=.*/SOC=`id`/' "not a KEY=value line"
bad "no COMPATIBLE" '/^COMPATIBLE=/d' "COMPATIBLE is missing"
bad "a DTB outside dtbs" 's|^DTB=.*|DTB=../../../etc/x.dtb|' "relative .dtb path"
bad "AVB size off a block" '$a AVB_FOOTERS="boot:4097"\nAVB_ROLLBACK_INDEX=1\nAVB_SECURITY_PATCH=2026-10-05' "multiple of 4096"
bad "AVB without its index" '$a AVB_FOOTERS="boot:0x4000000"' "needs AVB_ROLLBACK_INDEX"
bad "AVB for a missing image" '$a AVB_FOOTERS="userdata:0x4000"\nAVB_ROLLBACK_INDEX=1\nAVB_SECURITY_PATCH=2026-10-05' "not in BOOT_IMAGES"
bad "a bad main LUN" '$a MAIN_LUN=sda1' "MAIN_LUN must be"
bad "both SoC keys" '$a SOC_COMPATIBLE="b0-foplp:0x9865:1:0:0"' "exclusive"
bad "a bad overlay name" '$a DTB_OVERLAYS="ok ../evil"' "bad overlay name"
pass "descriptors are read as data, with bin/omamobile's rules, and slot A, vbmeta, persist and the rest refused"

# ---------------------------------------------------------------- tools
# The real ones where installed (FAKE_TOOLS=1: never); otherwise stand-ins
# with the same calls.
fake=$t/fake && mkdir -p "$fake"
find_dtc() {
  local d
  for d in ${DTC:-} "$(command -v dtc || true)" "$HOME"/omamobile-kernel/out*/scripts/dtc/dtc "$HOME"/android/mainline/out*/scripts/dtc/dtc; do
    [[ -n $d && -x $d ]] && { readlink -f "$d"; return 0; }
  done
  return 0
}
DTC_BIN=$(find_dtc)
FDTOVERLAY_BIN=
if [[ -n $DTC_BIN ]]; then
  for f in "${FDTOVERLAY:-}" "$(command -v fdtoverlay || true)" "$(dirname "$DTC_BIN")/fdtoverlay"; do
    [[ -n $f && -x $f ]] && { FDTOVERLAY_BIN=$(readlink -f "$f"); break; }
  done
fi
if [[ -z ${FAKE_TOOLS:-} ]] && command -v lz4 >/dev/null; then LZ4_BIN=$(command -v lz4); else
  # lz4's calls in these tools: -l -9 [-f] -q IN OUT, -l -9 -q (stdin), -dc FILE
  cat > "$fake/lz4" <<'EOF'
#!/usr/bin/env python3
import sys
a = [x for x in sys.argv[1:] if not x.startswith("-")]
if "-dc" in sys.argv:
    data = open(a[0], "rb").read()
    assert data.startswith(b"FAKELZ4\n"), "not lz4"
    sys.stdout.buffer.write(data[8:])
else:
    data = open(a[0], "rb").read() if a else sys.stdin.buffer.read()
    out = open(a[1], "wb") if len(a) > 1 else sys.stdout.buffer
    out.write(b"FAKELZ4\n" + data)
EOF
  chmod +x "$fake/lz4"; LZ4_BIN=$fake/lz4
fi
if [[ -z ${FAKE_TOOLS:-} ]] && command -v mkbootimg >/dev/null; then MKBOOTIMG_BIN=$(command -v mkbootimg); else
  # A stand-in: the arguments and every input file's bytes, deterministic
  cat > "$fake/mkbootimg" <<'EOF'
#!/usr/bin/env python3
import sys
args, out, body = sys.argv[1:], None, b""
for i, x in enumerate(args):
    if x in ("--output", "--vendor_boot"):
        out = args[i + 1]
for i, x in enumerate(args):
    if x in ("--kernel", "--ramdisk", "--dtb", "--vendor_ramdisk_fragment"):
        body += open(args[i + 1], "rb").read()
hdr = " ".join(a for a in args if a not in (out,) and not a.startswith("/")).encode()
open(out, "wb").write(b"FAKEBOOT\n" + hdr + b"\n" + body)
EOF
  chmod +x "$fake/mkbootimg"; MKBOOTIMG_BIN=$fake/mkbootimg
fi
if [[ -z ${FAKE_TOOLS:-} ]] && command -v avbtool >/dev/null; then AVBTOOL_BIN=$(command -v avbtool); else
  cat > "$fake/avbtool" <<'EOF'
#!/usr/bin/env python3
import sys
a = sys.argv[1:]
if a[0] == "version":
    print("fakeavbtool 0"); sys.exit(0)
img = a[a.index("--image") + 1]; size = int(a[a.index("--partition_size") + 1])
data = open(img, "rb").read()
foot = b"AVBf" + " ".join(x for x in a if not x.startswith("/")).encode()
pad = size - len(data) - len(foot)
assert pad >= 0
open(img, "wb").write(data + b"\0" * pad + foot)
EOF
  chmod +x "$fake/avbtool"; AVBTOOL_BIN=$fake/avbtool
fi
if [[ -z ${FAKE_TOOLS:-} ]] && command -v openssl >/dev/null; then OPENSSL_BIN=$(command -v openssl); else
  printf '#!/bin/sh\n[ "$1" = genrsa ] && [ "$2" = -out ] && echo FAKEKEY > "$3"\n' > "$fake/openssl"
  chmod +x "$fake/openssl"; OPENSSL_BIN=$fake/openssl
fi
export LZ4=$LZ4_BIN MKBOOTIMG=$MKBOOTIMG_BIN AVBTOOL=$AVBTOOL_BIN OPENSSL=$OPENSSL_BIN
echo "# tools: dtc=${DTC_BIN:-none} fdtoverlay=${FDTOVERLAY_BIN:-none} lz4=$LZ4 mkbootimg=$MKBOOTIMG avbtool=$AVBTOOL"

# A release initramfs: an allowlist, an init, no SSH keys
mkinitramfs() { # out ufs_rw [extra-path]
  local s=$t/initramfs-stage
  rm -rf "$s" && mkdir -p "$s/etc"
  echo '#!/bin/sh' > "$s/init"
  echo "$2" > "$s/etc/omamobile-ufs-rw"
  if [[ -n ${3:-} ]]; then mkdir -p "$s/${3%/*}"; echo key > "$s/$3"; fi
  (cd "$s" && find . | LC_ALL=C sort | cpio -o -H newc --owner=0:0 --quiet) | "$LZ4" -l -9 -q > "$1"
}

# ---------------------------------------------------------------- the builder
if [[ -n $DTC_BIN ]]; then
  export DTC=$DTC_BIN
  [[ -z $FDTOVERLAY_BIN ]] || export FDTOVERLAY=$FDTOVERLAY_BIN
  K=$t/k && mkdir -p "$K/dtbs/exynos/google" "$K/dev/overlays" "$K/modules/kernel/drivers"
  head -c 300000 /dev/urandom > "$K/Image"
  for d in "gs201-twelve 0x9855001" "gs101-six 0x9845001"; do
    set -- $d
    printf '/dts-v1/;\n/ {\n\tsoc_id = <%s 0x00>;\n\tcompatible = "google,%s";\n\t#address-cells = <2>;\n\t#size-cells = <1>;\n\tect { };\n\tchosen { bootargs = ""; };\n};\n' "$2" "$1" \
      | "$DTC" -q -@ -I dts -O dtb -o "$K/dtbs/exynos/google/$1.dtb" -
  done
  printf '/dts-v1/;\n/plugin/;\n&{/chosen} {\n\tomamobile-test = "overlaid";\n};\n' | "$DTC" -q -@ -I dts -O dtb -o "$K/dev/overlays/test-node.dtbo" -
  head -c 5000 /dev/urandom > "$K/dev/dtbo.img"
  mkinitramfs "$K/dev/initramfs.cpio.lz4" "$RW5"
  head -c 2000 /dev/urandom > "$K/modules/kernel/drivers/pmic-one.ko"
  head -c 2000 /dev/urandom > "$K/modules/kernel/drivers/pmic-two.ko"
  cp avb/testkey_rsa4096.pem "$K/key.pem"
  bi() { "$PKG/lib/omamobile-boot-images" --kernel "$K/Image" --dtbs "$K/dtbs" --dtbo "$K/dev/dtbo.img" \
           --initramfs "$K/dev/initramfs.cpio.lz4" --avb-key "$K/key.pem" "$@" > "$t/bi.log" 2>&1; }
  ls_imgs() { (cd "$1" && ls *.img | tr '\n' ' '); }

  printf 'AVB_FOOTERS="boot:0x2000000 init_boot:0x100000"\nAVB_ROLLBACK_INDEX=1783209600\nAVB_SECURITY_PATCH=2026-07-05\n' > "$t/avb.txt"
  cat "$t/twelve.conf" "$t/avb.txt" > "$t/twelve-avb.conf"
  bi --descriptor "$t/twelve-avb.conf" --out "$t/o1" || { cat "$t/bi.log"; fail "the builder packs a gs201-style set"; }
  [[ $(ls_imgs "$t/o1") == "boot.img dtb.img dtbo.img init_boot.img vendor_boot.img vendor_kernel_boot.img " ]] \
    || fail "gs201 set: five images and dtb.img (got $(ls_imgs "$t/o1"))"
  [[ $(stat -c %s "$t/o1/boot.img") == $((0x2000000)) && $(stat -c %s "$t/o1/init_boot.img") == $((0x100000)) ]] \
    || fail "AVB_FOOTERS images are padded to their partition sizes"
  cmp -s "$t/o1/dtbo.img" "$K/dev/dtbo.img" || fail "dtbo.img is the device package's"
  [[ $(cat "$t/o1/DEVICE") == twelve ]] || fail "the builder records the device"
  cat "$t/o1/twelve-b0.dtb" "$t/o1/twelve-a0.dtb" | cmp -s - "$t/o1/dtb.img" || fail "dtb.img holds one copy per soc_id, in order"
  "$DTC" -q -I dtb -O dts "$t/o1/twelve-a0.dtb" | grep -c 'soc_id = <0x9855000 ' >/dev/null || fail "the second copy carries the rewritten soc_id"
  cmp -s "$t/o1/initramfs.cpio.lz4" "$K/dev/initramfs.cpio.lz4" 2>/dev/null && fail "no stray ramdisk"
  [[ ! -e $t/o1/initramfs.cpio.lz4 ]] || fail "without keys or modules the device package's initramfs goes in as it is"
  bi --descriptor "$t/twelve-avb.conf" --out "$t/o2" || fail "a second build"
  (cd "$t/o1" && sha256sum *.img) > "$t/s1"; (cd "$t/o2" && sha256sum *.img) > "$t/s2"
  cmp -s "$t/s1" "$t/s2" || fail "two builds from the same inputs give the same bytes"
  pass "builder: gs201 set with AVB footers, soc_id copies, the shipped dtbo, deterministic"

  bi --descriptor "$t/six.conf" --out "$t/o3" || { cat "$t/bi.log"; fail "the builder packs a gs101-style set"; }
  [[ $(ls_imgs "$t/o3") == "boot.img dtb.img dtbo.img vendor_boot.img " ]] || fail "gs101 set: boot, vendor_boot, dtbo (got $(ls_imgs "$t/o3"))"
  pass "builder: gs101 set (no init_boot or vendor_kernel_boot)"

  if [[ -n $FDTOVERLAY_BIN ]]; then
    { cat "$t/twelve.conf"; echo 'DTB_OVERLAYS="test-node"'; } > "$t/twelve-ov.conf"
    if bi --descriptor "$t/twelve-ov.conf" --out "$t/o4"; then fail "DTB_OVERLAYS without --overlays is refused"; fi
    bi --descriptor "$t/twelve-ov.conf" --out "$t/o4" --overlays "$K/dev/overlays" || { cat "$t/bi.log"; fail "overlays apply"; }
    "$DTC" -q -I dtb -O dts "$t/o4/twelve-b0.dtb" | grep -c 'omamobile-test = "overlaid"' >/dev/null || fail "the overlay is in the shipped DTB"
    "$DTC" -q -I dtb -O dts "$t/o4/twelve-a0.dtb" | grep -c 'omamobile-test = "overlaid"' >/dev/null || fail "and in its soc_id copy"
    pass "builder: DTB_OVERLAYS applied onto the release's DTB, in every copy"
  else
    pass "builder: DTB_OVERLAYS # SKIP no fdtoverlay"
  fi

  # The owner's keys and INITRAMFS_MODULES go in a second cpio in the same
  # lz4 stream; the shipped archive comes first, unchanged
  printf 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAITestKeyOnly owner\n' > "$t/keys"
  { cat "$t/six.conf"; echo 'INITRAMFS_MODULES="pmic-two pmic-one"'; } > "$t/six-mod.conf"
  if bi --descriptor "$t/six-mod.conf" --out "$t/o5"; then fail "INITRAMFS_MODULES without --modules is refused"; fi
  bi --descriptor "$t/six-mod.conf" --out "$t/o5" --modules "$K/modules" --authorized-keys "$t/keys" || { cat "$t/bi.log"; fail "keys and modules append"; }
  "$LZ4" -dc "$t/o5/initramfs.cpio.lz4" > "$t/rd.cpio"
  "$LZ4" -dc "$K/dev/initramfs.cpio.lz4" > "$t/shipped.cpio"
  cmp -n "$(stat -c %s "$t/shipped.cpio")" "$t/rd.cpio" "$t/shipped.cpio" || fail "the shipped archive comes first, byte for byte"
  tail -c +$(($(stat -c %s "$t/shipped.cpio") + 1)) "$t/rd.cpio" > "$t/extra.cpio"
  list=$(cpio -it --quiet < "$t/extra.cpio" | LC_ALL=C sort | tr '\n' ' ')
  [[ $list == "lib lib/modules lib/modules/omamobile lib/modules/omamobile/order lib/modules/omamobile/pmic-one.ko lib/modules/omamobile/pmic-two.ko root root/.ssh root/.ssh/authorized_keys " ]] \
    || fail "the appended archive holds the keys and the modules only (got $list)"
  [[ $(cd "$t" && cpio -i --quiet --to-stdout lib/modules/omamobile/order < extra.cpio | tr '\n' ' ') == "pmic-two pmic-one " ]] \
    || fail "the modules load in the descriptor's order"
  cpio -i --quiet --to-stdout root/.ssh/authorized_keys < "$t/extra.cpio" | cmp -s - "$t/keys" || fail "the owner's keys, verbatim"
  cpio -itv --quiet < "$t/extra.cpio" | grep -E 'root/\.ssh/authorized_keys$' | grep -c '^-rw-------' >/dev/null || fail "authorized_keys is mode 600"
  bi --descriptor "$t/six-mod.conf" --out "$t/o6" --modules "$K/modules" --authorized-keys "$t/keys"
  cmp -s "$t/o5/vendor_boot.img" "$t/o6/vendor_boot.img" || fail "the appended archive is reproducible"
  pass "builder: the owner's authorized_keys and the release's INITRAMFS_MODULES appended, reproducibly"
else
  pass "builder # SKIP no dtc (install dtc, or set DTC to a kernel build's scripts/dtc/dtc)"
fi

# ---------------------------------------------------------------- the writer
# A stand-in builder, so the write path is tested on any machine: each image
# is its name and the kernel's checksum, an AVB image padded to its size.
stub=$t/stublib && mkdir -p "$stub"
cp lib/descriptor.sh "$stub/"
cat > "$stub/omamobile-boot-images" <<'EOF'
#!/bin/bash
set -euo pipefail
die() { echo "stub: $*" >&2; exit 1; }
source "$(dirname "$0")/descriptor.sh"
args=("$@")
while (($#)); do
  case $1 in
    --descriptor) d=$2 ;; --kernel) k=$2 ;; --out) o=$2 ;; --authorized-keys) keys=$2 ;;
  esac
  shift
done
printf '%s\n' "${args[*]}" >> "$(dirname "$0")/calls"
bu_load_descriptor "$d"
rm -rf "$o"; mkdir -p "$o"
for img in $DEV_BOOT_IMAGES; do
  printf 'IMG %s %s %s\n' "$img" "$(sha256sum < "$k" | cut -c1-16)" "${STUB_EXTRA:-}" > "$o/$img.img"
  head -c "${STUB_PAD:-3000}" /dev/zero >> "$o/$img.img"
  size=$(bu_avb_size "$img")
  [[ -z $size ]] || truncate -s "$size" "$o/$img.img"
done
echo "$DEV_CODENAME" > "$o/DEVICE"
EOF
chmod +x "$stub/omamobile-boot-images"
export OMAMOBILE_BOOT_UPDATE_LIB=$stub OMAMOBILE_BOOT_AVB_TESTKEY=$PKG/avb/testkey_rsa4096.pem
U=$PKG/bin/omamobile-boot-update

PARTS="boot_a init_boot_a vendor_boot_a vendor_kernel_boot_a dtbo_a boot_b init_boot_b vendor_boot_b vendor_kernel_boot_b dtbo_b vbmeta_b devinfo persist efs userdata"
mkroot() { # R
  local R=$1 i=0 p
  rm -rf "$R"
  mkdir -p "$R/usr/share/omamobile" "$R/proc/device-tree" "$R/dev" "$R/etc/omamobile" "$R/usr/lib/omamobile/twelve" \
    "$R/sys/block/sda" "$R/sys/block/sdb/sdb1" "$R/root/.ssh"
  cat "$t/twelve.conf" > "$R/usr/share/omamobile/device.conf"
  printf 'AVB_FOOTERS="boot:0x40000 init_boot:0x20000"\nAVB_ROLLBACK_INDEX=1783209600\nAVB_SECURITY_PATCH=2026-07-05\n' >> "$R/usr/share/omamobile/device.conf"
  printf 'google,gs201-twelve\0google,gs201\0' > "$R/proc/device-tree/compatible"
  echo 'console=null androidboot.slot_suffix=_b panic=10' > "$R/proc/cmdline"
  for p in $PARTS; do
    i=$((i + 1))
    mkdir -p "$R/sys/block/sda/sda$i"
    printf 'MAJOR=8\nMINOR=%d\nDEVNAME=sda%d\nDEVTYPE=partition\nPARTN=%d\nPARTNAME=%s\n' "$i" "$i" "$i" "$p" > "$R/sys/block/sda/sda$i/uevent"
