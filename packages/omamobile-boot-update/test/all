run hook || { cat "$t/out"; fail "a write for the next check"; }
if "$U" preflight --json > "$t/pf"; then fail "preflight fails while slot B holds a set that never booted"; fi
python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); assert not d["ok"] and "not booted yet" in d["problem"], d' "$t/pf" || fail "preflight says to restart first"
OMAMOBILE_BOOT_UNAME_R=7.3.0-rc6-omamobile-00453-gaaaaaaaaaaaa "$U" preflight --json > "$t/pf" || { cat "$t/pf"; fail "preflight passes once that set has booted"; }
pass "preflight answers in JSON and changes nothing; refuses without space, and while slot B holds a set that never booted"

# The documented recovery: the new set doesn't boot, the owner flashes a
# copy of previous/ by fastboot (here: written onto the _b files, as
# bin/omamobile flash would) and is back on the running release. current/
# no longer describes slot B, so it must not block the next kernel update.
mkroot "$R"
run hook || { cat "$t/out"; fail "recovery scenario: write K2 while running K1"; }
for p in boot init_boot vendor_boot vendor_kernel_boot dtbo; do
  dd if="$S/previous/$p.img" of="$(part "$R" ${p}_b)" conv=notrunc status=none
done
reboot_counters "$R"   # fastboot writes before the boot: nothing counted
"$U" preflight --json > "$t/pf" || { cat "$t/pf"; fail "after a flash of the saved set, preflight passes (the record is stale)"; }
"$U" status > "$t/st" 2>&1
grep -c '^slot B: *changed outside omamobile-boot-update' "$t/st" >/dev/null || { cat "$t/st"; fail "status says slot B changed outside the tool"; }
run rollback --yes || { cat "$t/out"; fail "rollback after the flash"; }
grep -c 'already holds these images' "$t/out" >/dev/null || fail "the rollback finds the saved set in place"
[[ $(cat "$S/current/RELEASE") == 7.3.0-rc6-omamobile-00400-gbbbbbbbbbbbb ]] || fail "and records it as slot B's set"
"$U" preflight --json > "$t/pf" || { cat "$t/pf"; fail "preflight passes after the no-op rollback"; }
"$U" status > "$t/st" 2>&1
grep -c '^slot B: *7.3.0-rc6-omamobile-00400-gbbbbbbbbbbbb$' "$t/st" >/dev/null || { cat "$t/st"; fail "status names the saved release on slot B"; }
# The next write saves slot B as the set that booted
addrel "$R" 7.3.0-rc6-omamobile-00460-gcccccccccccc
run hook || { cat "$t/out"; fail "the fixed kernel is written after the recovery"; }
[[ $(cat "$S/previous/RELEASE") == 7.3.0-rc6-omamobile-00400-gbbbbbbbbbbbb && $(cat "$S/previous/BOOTED") == yes ]] || fail "previous is the running set"
pass "after the fastboot recovery (or push) a stale record blocks nothing; a no-op rollback records slot B; status says which"

# "Booted" comes from the kernel's write counters, not from a release name
# S1: running K1, a device-package update rewrites K1's initramfs; with no
# restart a second update runs the hook: previous keeps the set that booted
mkroot "$R"
k1=7.3.0-rc6-omamobile-00453-gaaaaaaaaaaaa
OMAMOBILE_BOOT_UNAME_R=$k1 run hook || { cat "$t/out"; fail "S1: the first same-release write"; }
[[ $(head -c 10 "$S/previous/boot.img") == "OLD boot_b" ]] || fail "S1: previous holds the set that booted"
OMAMOBILE_BOOT_UNAME_R=$k1 STUB_EXTRA=second run hook || { cat "$t/out"; fail "S1: the second write"; }
grep -c 'written since this boot' "$t/out" >/dev/null || { cat "$t/out"; fail "S1: it says slot B was written since this boot"; }
[[ $(head -c 10 "$S/previous/boot.img") == "OLD boot_b" && $(cat "$S/previous/BOOTED") == yes ]] || fail "S1: previous still holds the set that booted"
# S2: the hook wrote K2; a push dies after boot_b; an update to K3: the
# booted K1 set stays saved, not the half-pushed slot B
mkroot "$R"
run hook || { cat "$t/out"; fail "S2: K2 written"; }
outside_write "$R" boot_b HALF-PUSHED
addrel "$R" 7.3.0-rc6-omamobile-00460-gcccccccccccc
run hook || { cat "$t/out"; fail "S2: K3 written"; }
[[ $(head -c 10 "$S/previous/boot.img") == "OLD boot_b" && $(cat "$S/previous/RELEASE") == 7.3.0-rc6-omamobile-00400-gbbbbbbbbbbbb ]] \
  || fail "S2: previous keeps the K1 set that booted, not the half-pushed slot B"
# S3: no record; a push writes slot B and the restart doesn't happen; an
# update: what is saved is marked not booted, and a rollback says so
mkroot "$R"
for p in boot_b init_boot_b vendor_boot_b vendor_kernel_boot_b dtbo_b; do outside_write "$R" $p PUSHED; done
run hook || { cat "$t/out"; fail "S3: the write"; }
[[ $(cat "$S/previous/BOOTED") == no && $(head -c 6 "$S/previous/boot.img") == PUSHED ]] || fail "S3: the pushed, unbooted set is saved as BOOTED=no"
run rollback --dry-run || { cat "$t/out"; fail "S3: rollback dry run"; }
grep -c 'BOOTED=no' "$t/out" >/dev/null || { cat "$t/out"; fail "S3: a rollback says the saved set never booted"; }
pass "booted means slot B unwritten since this boot (write counters): a same-release rewrite, a half push and an unbooted push never replace the set that booted"

# End to end with the real builder (the tools above), when dtc is there:
# slot B ends up holding exactly what omamobile-boot-images makes
if [[ -n $DTC_BIN ]]; then
  mkroot "$R"
  rel=7.3.0-rc6-omamobile-00453-gaaaaaaaaaaaa
  head -c 100000 /dev/urandom > "$R/usr/lib/modules/$rel/vmlinuz"
  cp "$K/dtbs/exynos/google/gs201-twelve.dtb" "$R/usr/lib/modules/$rel/dtbs/exynos/google/gs201-twelve.dtb"
  OMAMOBILE_BOOT_UPDATE_LIB=$PKG/lib "$U" hook > "$t/out" 2>&1 || { cat "$t/out"; fail "end to end: the hook builds and writes with the real builder"; }
  OMAMOBILE_BOOT_UPDATE_LIB=$PKG/lib "$PKG/lib/omamobile-boot-images" --descriptor "$R/usr/share/omamobile/device.conf" \
    --kernel "$R/usr/lib/modules/$rel/vmlinuz" --dtbs "$R/usr/lib/modules/$rel/dtbs" --dtbo "$R/usr/lib/omamobile/twelve/dtbo.img" \
    --initramfs "$R/usr/lib/omamobile/twelve/initramfs.cpio.lz4" --modules "$R/usr/lib/modules/$rel" \
    --authorized-keys "$R/root/.ssh/authorized_keys" --avb-key "$PKG/avb/testkey_rsa4096.pem" --out "$t/e2e" >/dev/null 2>&1 \
    || fail "end to end: the same build by hand"
  for img in boot init_boot vendor_boot vendor_kernel_boot dtbo; do
    cmp -s -n "$(stat -c %s "$t/e2e/$img.img")" "$t/e2e/$img.img" "$(part "$R" ${img}_b)" || fail "end to end: ${img}_b holds $img.img"
  done
  pass "end to end: the hook builds with the real tools and slot B holds exactly those images"
else
  pass "end to end with the real builder # SKIP no dtc"
fi
