pkgname=omamobile-boot-update
pkgver=$(cat "${startdir:-.}/.pkgver" 2>/dev/null || "${startdir:-.}/../../tools/pkg-version" "${startdir:-.}")
pkgrel=1
pkgdesc="Omarchy Mobile: rebuild a phone's slot-B boot images from linux-omamobile and write them, guarded and verified (pacman hook, opt-in)"
arch=(any)
url="https://github.com/derekross/omarchy-mobile"
license=(MIT Apache-2.0)
# mkbootimg and avbtool from android-tools; dtc and fdtoverlay from dtc
depends=(bash coreutils util-linux grep sed gawk findutils python lz4 cpio dtc android-tools)
checkdepends=(cpio lz4 python)

check() {
  "$startdir/test/all"
}

package() {
  "$startdir/install" "$pkgdir"
}
