#!/bin/bash
# SPDX-License-Identifier: MIT
# systemd-sleep hook (device/cheetah/SUSPEND-PLAN.md, section 6.2), linked
# from /usr/lib/systemd/system-sleep/omamobile. systemd-sleep runs it as
#   omamobile-sleep pre|post suspend|hibernate|hybrid-sleep|suspend-then-hibernate
# Only "systemctl suspend" (through logind) gets here; tests that write
# /sys/power/state directly bypass it.
#
# pre:  unload Wi-Fi unless it is allowed to stay up across sleep (the
#       brcmfmac D3 handshake for BCM4389 is new; stage S5), and note the
#       suspend failure count.
# post: reload Wi-Fi if pre unloaded it (through the hang-safe service), log
#       the wake reason, and if the suspend failed in the Wi-Fi device, fall
#       back to unloading Wi-Fi for the rest of this boot and reload it now
#       (a chip stuck in D3 only comes back with a reload of the stack),
#       and restart fprintd if it runs: a fingerprint exchange cut by the
#       freeze left it waiting for a reply that never came, and every unlock
#       by fingerprint failed until a restart (SUSPEND-PLAN P2).
#
# Wi-Fi stays loaded across sleep only with /etc/omamobile/wifi-keep-across-sleep
# present (create it once stage S5 passes on the running kernel).
set -uo pipefail

keep=/etc/omamobile/wifi-keep-across-sleep
run=/run/omamobile
unloaded=$run/wifi-unloaded-for-sleep
fallback=$run/wifi-sleep-fallback
failcount=$run/sleep-fail-count
wifi_pci=0000:01:00.0

log() { echo "omamobile-sleep: $*"; }

wifi_loaded() { [[ -d /sys/module/brcmfmac || -d /sys/module/pcie_gs201 ]]; }

wifi_unload() {
  wifi_loaded || return 0
  # brcmfmac_wcc holds brcmfmac; removing it first unbinds the device cleanly.
  if modprobe -r brcmfmac_wcc brcmfmac pcie_gs201; then
    touch "$unloaded"
    log "Wi-Fi unloaded for sleep"
  else
    log "Wi-Fi unload failed; sleeping with it loaded"
  fi
}

wifi_reload() {
  [[ -e $unloaded ]] || return 0
  rm -f "$unloaded"
  # --no-block: we run inside systemd-suspend.service.
  systemctl --no-block restart omamobile-wifi.service
  log "Wi-Fi reload queued"
}

wake_reason() {
  local irq name
  irq=$(cat /sys/power/pm_wakeup_irq 2>/dev/null) || irq=
  if [[ -n $irq ]]; then
    name=$(awk -v i="$irq:" '$1 == i { $1 = ""; print; exit }' /proc/interrupts | tr -s ' ')
    log "woken by IRQ $irq:${name:- (unknown)}"
  else
    log "no wake IRQ recorded"
  fi
}

case "${1:-}/${2:-}" in
  pre/suspend)
    mkdir -p "$run"
    cat /sys/power/suspend_stats/fail > "$failcount" 2>/dev/null || true
    if [[ -e $keep && ! -e $fallback ]]; then
      log "Wi-Fi stays up across sleep ($keep)"
    else
      wifi_unload
    fi
    ;;
  post/suspend)
    wifi_reload
    wake_reason
    # --no-block, as above; try-restart leaves a stopped fprintd alone.
    systemctl --no-block try-restart fprintd.service
    before=$(cat "$failcount" 2>/dev/null || echo 0)
    after=$(cat /sys/power/suspend_stats/fail 2>/dev/null || echo 0)
    if ((after > before)); then
      dev=$(cat /sys/power/suspend_stats/last_failed_dev 2>/dev/null)
      log "suspend failed (last failed device: ${dev:-unknown})"
      if [[ $dev == "$wifi_pci" ]]; then
        touch "$fallback"
        log "Wi-Fi refused D3; unloading it for sleep until the next boot"
        # The chip may be stuck in D3: only a reload of the whole stack
        # (which power-cycles it) brings it back.
        wifi_unload
        wifi_reload
      fi
    fi
    ;;
  pre/*|post/*)
    ;;
  *)
    echo "Usage: omamobile-sleep pre|post suspend" >&2
    exit 1
    ;;
esac
exit 0
