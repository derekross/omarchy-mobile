#!/bin/bash
# SPDX-License-Identifier: MIT
# Offline tests for omamobile-modem: syntax, the CP helper's file parsers on
# made-up inputs (a TOC, NV files), the staged layout and the unit. Nothing
# here touches a modem, a partition or /dev.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
export PYTHONDONTWRITEBYTECODE=1
cp=lib/omamobile-modem-cp

bash -n install && bash -n lib/omamobile-modem-start && bash -n profiles/modem.conf || fail "shell syntax"
python3 -c 'import ast, sys; ast.parse(open(sys.argv[1]).read())' "$cp" || fail "$cp parses"
if command -v shellcheck >/dev/null; then
  shellcheck -S warning lib/omamobile-modem-start install || fail "shellcheck"
fi
pass "scripts parse"

# spawn_optional keeps its job alive whatever the daemon's exit: run the
# function from modem.conf under the library's errexit and pipefail with a
# stand-in daemon that exits 3, and check the job is still there.
sp=$(sed -n '/^spawn_optional() {$/,/^}$/p' profiles/modem.conf)
[[ -n $sp ]] || fail "spawn_optional found in modem.conf"
out=$(bash -c '
  set -euo pipefail
  declare -A PIDS; ENV=(env); CHROOT_BIN=bash; ROOT=-c
  say() { :; }; android_env() { :; }
  '"$sp"'
  spawn_optional fake vendor "exit 3"
  sleep 0.5
  if kill -0 "${PIDS[fake]}" 2>/dev/null; then echo alive; kill "${PIDS[fake]}"; else echo dead; fi
' 2>&1)
[[ $out == alive ]] || fail "a daemon exiting 3 leaves spawn_optional's job alive (got: $out)"
pass "spawn_optional survives a failing daemon"

t=$(mktemp -d); trap 'rm -rf "$t"' EXIT
# A made-up modem.bin: TOC, BOOT, INFO entries (32 bytes each; the TOC
# entry's last word is the last entry's index), the version 20 bytes into
# INFO. A 31-character version is cut at 31 bytes, as rfsd reads it.
python3 - "$t" <<'PY'
import struct, sys
def image(path, version, entries=((b'BOOT', 0x200, 0x100), (b'INFO', 0x300, 0x80))):
    toc = b'TOC'.ljust(12, b'\0') + struct.pack('<5I', 0, 0, 0x200, 0, len(entries) - 1)
    for name, off, size in entries:
        toc += name.ljust(12, b'\0') + struct.pack('<5I', off, 0, size, 0, 0)
    data = bytearray(0x400); data[:len(toc)] = toc
    data[0x300 + 20:0x300 + 20 + len(version)] = version
    open(path, 'wb').write(data)
image(sys.argv[1] + '/modem.bin', b'test-version-001')
image(sys.argv[1] + '/long.bin', b'v' * 31 + b'XYZ')
image(sys.argv[1] + '/noinfo.bin', b'', ((b'BOOT', 0x200, 0x100), (b'MAIN', 0x300, 0x80)))
PY
[[ $(python3 "$cp" baseband-version "$t/modem.bin") == test-version-001 ]] || fail "baseband version from a TOC"
[[ $(python3 "$cp" baseband-version "$t/long.bin") == "$(printf 'v%.0s' {1..31})" ]] || fail "version cut at 31 bytes"
python3 "$cp" baseband-version "$t/noinfo.bin" 2>/dev/null && fail "a TOC without INFO is refused"
# a raw modem partition starts with a tar header, not a TOC
{ printf 'test-version-001'; head -c 496 /dev/zero; } > "$t/notoc.bin"
python3 "$cp" baseband-version "$t/notoc.bin" 2>/dev/null && fail "a file without a TOC is refused"
pass "baseband version"

# watch's poll interval is read inside watch(): a value outside the range,
# or not a number, falls back to the default, and never stops another
# subcommand (power-off at the profile's stop runs with the same environment).
ws() {
  OMAMOBILE_MODEM_WATCH_SECONDS=$1 python3 -c '
import sys; g = {"__name__": "cp"}; exec(open(sys.argv[1]).read(), g); print(g["watch_seconds"]())' "$cp" 2>/dev/null
}
[[ $(ws 5) == 5.0 && $(ws 60) == 60.0 && $(ws five) == 0.5 && $(ws 0) == 0.5 && $(ws 600) == 0.5 && $(ws nan) == 0.5 ]] ||
  fail "watch interval: $(ws 0.5) $(ws 60) $(ws five) $(ws 0) $(ws 600) $(ws nan)"
[[ $(OMAMOBILE_MODEM_WATCH_SECONDS=five python3 "$cp" baseband-version "$t/modem.bin" 2>/dev/null) == test-version-001 ]] ||
  fail "a bad watch interval leaves other subcommands alone"
pass "watch interval"

mkdir -p "$t/efs" "$t/efs_backup"
for f in efs/nv_normal.bin efs/nv_protected.bin efs_backup/nv_protected.bak; do
  printf 'made-up %s' "$f" > "$t/$f"
  python3 -c 'import hashlib,sys; d=open(sys.argv[1],"rb").read(); open(sys.argv[1]+".md5","wb").write(hashlib.md5(d+b"Samsung_SIT_RIL").hexdigest().encode())' "$t/$f"
done
python3 "$cp" nv-check "$t/efs" "$t/efs_backup" 2>/dev/null || fail "matching NV checksums pass"
printf 'x' >> "$t/efs/nv_normal.bin"
python3 "$cp" nv-check "$t/efs" "$t/efs_backup" 2>/dev/null && fail "a changed NV file is refused"
pass "NV checksums"

stage=$t/stage
./install "$stage"
for f in usr/lib/omamobile-vendor/omamobile-modem-start usr/lib/omamobile-vendor/omamobile-modem-cp \
         usr/lib/omamobile-vendor/profiles/modem.conf usr/lib/omamobile-vendor/modem/props.conf \
         usr/lib/systemd/system/omamobile-modem.service usr/lib/udev/rules.d/60-omamobile-modem-nv-ro.rules; do
  [[ -e $stage/$f ]] || fail "staged $f"
done
grep -qx 'persist.vendor.modem.efs.clear.action=none' modem/props.conf ||
  fail "efs.clear.action is pinned to none (empty clears NV)"
grep -qx 'vendor.modem.bin.path=/mnt/vendor/modem_img/images/default/modem.bin' modem/props.conf ||
  fail "rfsd reads its TOC from the firmware file (vendor.modem.bin.path)"
if command -v systemd-analyze >/dev/null; then
  systemd-analyze verify --man=no "$stage"/usr/lib/systemd/system/omamobile-modem{.service,-inhibit.service,-boot.target} 2>&1 |
    grep -v -e 'not executable' -e 'No such file' -e 'omamobile-aoc.service' -e 'omamobile-audio.service' \
      -e 'omamobile-sitd.service' -e 'omamobile-sit-data.service' -e 'omamobile-mmd.service' -e '^$' &&
    fail "unit verify" || true
fi
pass "staged layout, props and unit"

# cbd_watch stops a retrying cbd after its first failed boot (M3.4.5: cbd
# powered the modem on 15 times in 80 s). A fake cbd fails every attempt.
out=$(RUN=$t CBD_ATTEMPTS=1 bash -c '
  say() { printf "omamobile-modem: %s\n" "$*"; }
  eval "$(sed -n "/^cbd_watch() {/,/^}/p" profiles/modem.conf)"
  fake="while :; do echo \"I -[1]: Power on CP\"; sleep 0.1
    echo \"E -[1]: ERR! IOCTL_START_CP_BOOTLOADER fail\"; echo \"I -[1]: start boot fail\"; done"
  sh -c "echo \$\$ > \"\$0\"; exec \"\$@\"" "$RUN/cbd.pid" timeout 10 sh -c "$fake" 2>&1 | cbd_watch
  echo "rc=${PIPESTATUS[0]}"' 2>&1)
[[ $(grep -c 'Power on CP' <<<"$out") -le 2 && $out == *"1 failed boot attempt(s)"* && $out == *rc=143* ]] ||
  fail "cbd stopped after one failed boot: $out"
[[ ! -e $t/cbd.pid ]] || fail "cbd pid file removed"
pass "cbd stopped after its first failed boot"

# One start per boot (the marker outlives the profile). The refusal comes from
# the check, before the start script writes its persistent marker; the marker
# is written only when cbd is about to power the CP on, so an rfsd-only staged
# start followed by the full profile in the same boot is allowed.
once=$t/once; mkdir -p "$once"
out=$(OMAMOBILE_MODEM_BOOT_MARK=$once/profile-started bash -c '
  die() { echo "die: $*"; exit 7; }
  eval "$(sed -n "/^modem_once_check() {$/,/^}$/p; /^modem_once_mark() {$/,/^}$/p" profiles/modem.conf)"
  modem_once_check && echo check-1-ok          # the rfsd-only stage: check passes, nothing written
  [[ -e $OMAMOBILE_MODEM_BOOT_MARK ]] && echo "marker-after-rfsd-stage"
  modem_once_check && modem_once_mark && echo full-start-ok   # the full profile in the same boot
  modem_once_check; echo "rc=$?"' 2>&1) || true
[[ $out == *check-1-ok* && $out != *marker-after-rfsd-stage* && $out == *full-start-ok* ]] ||
  fail "an rfsd-only stage then the full profile is one start: $out"
[[ $out == *"die: the modem profile already started this boot"* && $out != *"rc=0"* ]] ||
  fail "a second start in the same boot is refused: $out"
[[ -s $once/profile-started ]] || fail "the once-per-boot marker is written at the CP power-on"
pass "one CP power-on per boot: staged start allowed, a second start refused"

# The order that makes a refused start harmless: profile_check refuses before
# the start script writes /var/lib/omamobile/modem-bringup-started (so the
# next boot doesn't skip the modem), and the marker is written after the
# rfsd-stage return and before cbd.
conf=profiles/modem.conf
chk=$(grep -n '^profile_check() {' $conf | cut -d: -f1)
[[ $(sed -n "$chk,$((chk+3))p" $conf) == *modem_once_check* ]] || fail "profile_check runs the once-per-boot check first"
st=$(grep -n '^profile_start() {' $conf | cut -d: -f1)
body=$(sed -n "$st,/^}/p" $conf)
r=$(grep -n 'MODEM_STAGE == rfsd' <<<"$body" | cut -d: -f1); m=$(grep -n '^  modem_once_mark$' <<<"$body" | cut -d: -f1); c=$(grep -n '/vendor/bin/cbd ' <<<"$body" | cut -d: -f1)
[[ -n $r && -n $m && -n $c && $r -lt $m && $m -lt $c ]] || fail "the marker is written after the rfsd-stage return and before cbd (rfsd=$r mark=$m cbd=$c)"
[[ $(grep -n '^  modem_once_mark$' <<<"$body" | wc -l) -eq 1 ]] || fail "one marker write in profile_start"
grep -q '^  modem_once_check$' <<<"$body" || fail "profile_start checks the marker itself too"
out=$(OMAMOBILE_MODEM_BOOT_MARK=$once/profile-started bash -c '
  die() { echo "die: $*"; exit 7; }
  eval "$(sed -n "/^modem_once_check() {$/,/^}$/p" profiles/modem.conf)"
  modem_once_check; echo "rc=$?"; echo "would write the persistent marker"' 2>&1) || true
[[ $out == *"die: "* && $out != *"would write the persistent marker"* ]] || fail "a refused check stops before the persistent marker: $out"
pass "a refused start leaves the persistent marker as it was"

# The start script's order (M4.6, CONTRIBUTING 3.4): the provisioning
# check, both marker refusals and the sleep-inhibitor check before anything
# else, the bring-up latch written and synced before the first modprobe, the profile's check after the drivers
# (it needs CPIF's ports) with the latch removed on a refusal, READY after
# the check, and the profile last.
s=lib/omamobile-modem-start
lineof() { grep -n "$1" $s | head -1 | cut -d: -f1; }
l_prov_refuse=$(lineof "isn't provisioned"); l_mark_refuse=$(lineof 'never reached ONLINE; skipping'); l_up_refuse=$(lineof 'refuse_unclean$')
l_inhibit=$(lineof 'no sleep inhibitor held'); l_latch=$(lineof '> "\$MARK"'); l_latch_sync=$(awk -v n="$l_latch" 'NR == n + 1' $s)
l_modprobe=$(lineof '^modprobe '); l_check=$(lineof 'omamobile-vendor-chroot" modem check'); l_rm=$(lineof '^  rm -f "\$MARK"')
l_ready=$(lineof 'systemd-notify --ready'); l_exec=$(lineof 'exec "\$LIB/omamobile-vendor-chroot" modem start')
l_reason_rm=$(lineof '^rm -f "\$REFUSED"')
for v in l_prov_refuse l_mark_refuse l_up_refuse l_inhibit l_reason_rm l_latch l_modprobe l_check l_rm l_ready l_exec; do
  [[ -n ${!v} ]] || fail "start script: no line for $v"
done
[[ $l_latch_sync == sync ]] || fail "the latch is synced right after it is written"
[[ $l_prov_refuse -lt $l_mark_refuse && $l_mark_refuse -lt $l_up_refuse && $l_up_refuse -lt $l_inhibit && $l_inhibit -lt $l_reason_rm && $l_reason_rm -lt $l_latch && $l_latch -lt $l_modprobe &&
   $l_modprobe -lt $l_check && $l_check -lt $l_rm && $l_rm -lt $l_ready && $l_ready -lt $l_exec ]] ||
  fail "start script order: refuse($l_prov_refuse,$l_mark_refuse,$l_up_refuse) inhibit($l_inhibit) reason-rm($l_reason_rm) latch($l_latch) modprobe($l_modprobe) check($l_check) rm($l_rm) ready($l_ready) exec($l_exec)"
[[ $(grep -c '^modprobe ' $s) -eq 3 && $(grep -c 'modprobe' <(sed -n "1,${l_latch}p" $s) ) -eq 0 ]] ||
  fail "no modprobe before the latch"
grep -q 'OMAMOBILE_MODEM_MARK=\$MARK OMAMOBILE_MODEM_UP_MARK=\${INVOCATION_ID:+\$UP} exec' $s || fail "both markers go to the profile's watcher (the modem-up one only under the unit)"
grep -q "OMAMOBILE_MODEM_UP_MARK" $cp || fail "the watcher writes the modem-up marker"
pass "start script: markers before the drivers, the check after them, READY before the profile"

# Every refusal runs for real (nothing is touched before them) against
# made-up markers and provisioning files, and the script exits 1 before the
# inhibitor check, so no driver or marker write is reached. Each leaves its
# one-line reason for the shell's tile (OMAMOBILE_MODEM_REFUSED), and a
# start that gets past the refusals removes it.
m=$t/markers; mkdir -p "$m/root"; : > "$m/nv.sha256"; printf 'ro.boot.cdt_hwid=TESTID\n' > "$m/props.conf"
export OMAMOBILE_MODEM_LATCH=$m/latch OMAMOBILE_MODEM_UP_MARK=$m/up OMAMOBILE_MODEM_HOLD=$m/hold OMAMOBILE_MODEM_REFUSED=$m/run/refused
export OMAMOBILE_MODEM_CHROOT=$m/root OMAMOBILE_MODEM_NV_SUMS=$m/nv.sha256 OMAMOBILE_MODEM_PROPS=$m/props.conf
start() { timeout 20 bash $s "$@" 2>&1; }
# Not provisioned (a fresh install before tools/phone-provision): one line
# per missing file, no latch, the reason says so. The unit itself is skipped
# earlier by its conditions on the same three paths.
for missing in root nv.sha256 props.conf; do
  mv "$m/$missing" "$m/$missing.away"
  out=$(start) && fail "an unprovisioned phone ($missing missing) is refused"
  [[ $out == *"isn't provisioned"* && $out == *"tools/phone-provision"* ]] || fail "the refusal names provisioning ($missing): $out"
  [[ $(grep -c . <<<"$out") -eq 1 ]] || fail "one line for an unprovisioned phone: $out"
  [[ ! -e $m/latch && $(cat "$m/run/refused") == "Off: not provisioned" ]] || fail "unprovisioned: no latch, the reason for the tile ($missing)"
  mv "$m/$missing.away" "$m/$missing"
done
for u in omamobile-modem.service omamobile-modem-inhibit.service; do
  for c in /usr/lib/omamobile-vendor/modem/root /etc/omamobile/modem-nv.sha256 /var/lib/omamobile-vendor/modem/props.conf; do
    grep -qx "ConditionPathExists=$c" "systemd/$u" || fail "$u is skipped without $c"
  done
done
grep -q 'CHROOT=\${OMAMOBILE_MODEM_CHROOT:-\$LIB/modem/root}' $s && grep -q 'NV_SUMS=\${OMAMOBILE_MODEM_NV_SUMS:-/etc/omamobile/modem-nv.sha256}' $s &&
  grep -q 'PROPS=\${OMAMOBILE_MODEM_PROPS:-/var/lib/omamobile-vendor/modem/props.conf}' $s || fail "the script checks the same three paths as the units"
pass "a phone that isn't provisioned is refused quietly, by the units' conditions and by the script"
# The bring-up latch: refused until --retry (a hang in the bring-up never repeats on its own).
printf '%s boot %s\n' 2026-01-01T00:00:00+00:00 00000000-0000-0000-0000-000000000000 > "$m/latch"
out=$(start) && fail "a bring-up latch is refused"
[[ $out == *"never reached ONLINE"* ]] || fail "the latch refusal names the latch: $out"
[[ -e $m/latch && $(cat "$m/run/refused") == "Off: last bring-up hung" ]] || fail "the latch stays, with its reason for the tile"
out=$(start) && fail "the latch refuses the boot after too"
rm -f "$m/latch"
# A stale modem-up marker (a boot that ended with the modem up and no clean
# stop) refuses once: the marker moves aside, named by the time, and the
# next boot starts (here: up to the inhibitor check, which refuses on this
# machine before any modprobe).
stale() { printf '%s boot %s\n' 2026-01-01T00:00:00+00:00 00000000-0000-0000-0000-000000000000 > "$m/up"; }
stale
out=$(start) && fail "a modem-up marker is refused"
[[ $out == *"ended without a clean stop"* && $out == *"journalctl -b -1"* ]] || fail "the modem-up refusal says where to look: $out"
[[ $out == *"the next boot starts the modem again"* ]] || fail "the refusal says the next boot starts: $out"
[[ ! -e $m/up && ! -e $m/latch ]] || fail "the stale marker is moved aside, nothing else written"
[[ $(ls "$m"/up.refused-* | wc -l) -eq 1 ]] || fail "the refused marker is kept beside the marker's place: $(ls "$m")"
grep -q "0000-000000000000" "$m"/up.refused-* || fail "the kept copy is the stale marker's content"
[[ $(cat "$m/run/refused") == "Off after a hang or reset" ]] || fail "the reason for the tile: $(cat "$m/run/refused")"
out=$(start) && fail "the next boot gets past the refusals (and stops at the inhibitor here)"
[[ $out == *"no sleep inhibitor"* && $out != *"ended without a clean stop"* ]] || fail "the boot after a refused one starts the modem again: $out"
[[ $(cat "$m/run/refused") == "Off: no sleep inhibitor" ]] || fail "a later refusal replaces the reason: $(cat "$m/run/refused")"
[[ ! -e $m/latch ]] || fail "the inhibitor refusal comes before the latch"
# Two unclean boots in a row refuse every other boot, never for good; the
# last three refused markers are kept.
for i in 1 2 3 4; do
  stale; sleep 1
  out=$(start) && fail "unclean boot $i is refused"
  [[ $out == *"ended without a clean stop"* ]] || fail "unclean boot $i: $out"
  out=$(start) && fail "the boot after unclean boot $i stops at the inhibitor"
  [[ $out == *"no sleep inhibitor"* ]] || fail "the boot after unclean boot $i starts again: $out"
done
[[ $(ls "$m"/up.refused-* | wc -l) -eq 3 ]] || fail "the last three refused markers are kept: $(ls "$m")"
rm -f "$m"/up.refused-*
# The owner's hard stop: with the hold flag the marker stays, and every
# boot refuses until --retry.
stale; : > "$m/hold"
out=$(start) && fail "with the hold flag a modem-up marker is refused"
[[ $out == *"ended without a clean stop"* && $out == *"stays off until omamobile-modem-start --retry"* ]] || fail "the hold refusal says how to clear it: $out"
[[ -e $m/up && -z $(ls "$m"/up.refused-* 2>/dev/null) ]] || fail "the hold flag keeps the marker in place"
out=$(start) && fail "with the hold flag the next boot refuses too"
[[ $(cat "$m/run/refused") == "Off after a hang or reset (held)" ]] || fail "the held reason for the tile: $(cat "$m/run/refused")"
rm -f "$m/hold"
# --stopped (ExecStopPost) removes only this boot's modem-up marker: another
# boot's (the one a refusal was about) stays, so a refused start can't clear
# the guard it refused on.
out=$(SERVICE_RESULT=exit-code bash $s --stopped 2>&1) || fail "--stopped exits 0 on another boot's marker"
[[ -e $m/up && $out == *"another boot"* ]] || fail "another boot's modem-up marker is kept by --stopped: $out"
printf '%s boot %s\n' "$(date -Is)" "$(cat /proc/sys/kernel/random/boot_id)" > "$m/up"
out=$(SERVICE_RESULT=success bash $s --stopped 2>&1) || fail "--stopped exits 0"
[[ ! -e $m/up && $out == *"modem stopped (success)"* ]] || fail "this boot's modem-up marker is removed by a clean stop: $out"
bash $s --stopped >/dev/null 2>&1 || fail "--stopped with no marker exits 0"
# --retry clears both (it then goes on to start; the inhibitor check refuses
# that here, with no modem-inhibit unit on this machine, before any modprobe)
printf 'x\n' > "$m/latch"; printf 'x\n' > "$m/up"; : > "$m/hold"
out=$(start --retry) && fail "--retry on this machine is refused at the inhibitor"
[[ ! -e $m/latch && ! -e $m/up && $out == *"no sleep inhibitor"* ]] || fail "--retry clears both markers and stops at the inhibitor check: $out ($(ls "$m"))"
rm -f "$m/hold"
rc=0; bash $s --bogus >/dev/null 2>&1 || rc=$?; [[ $rc -eq 2 ]] || fail "an unknown option exits 2"
unset OMAMOBILE_MODEM_LATCH OMAMOBILE_MODEM_UP_MARK OMAMOBILE_MODEM_HOLD OMAMOBILE_MODEM_REFUSED OMAMOBILE_MODEM_CHROOT OMAMOBILE_MODEM_NV_SUMS OMAMOBILE_MODEM_PROPS
pass "refusals: unprovisioned, the latch, a stale modem-up marker once (held with the flag), --stopped and --retry"

# The units: the inhibitor is required and ordered before the modem, held
# until the reboot (a manual stop is refused); the modem unit is Type=notify
# with its stop hook; the target wants the four units and is enabled by the
# device package, never by this one: no wants link of any kind is shipped.
u=$stage/usr/lib/systemd/system
for f in omamobile-modem-inhibit.service omamobile-modem-boot.target; do [[ -e $u/$f ]] || fail "staged $f"; done
grep -qx 'Requires=omamobile-modem-inhibit.service' systemd/omamobile-modem.service || fail "the modem unit requires the inhibitor"
grep -E '^After=' systemd/omamobile-modem.service | grep -q 'omamobile-modem-inhibit.service' || fail "the modem unit starts after the inhibitor"
grep -qx 'Type=notify' systemd/omamobile-modem.service && grep -qx 'NotifyAccess=all' systemd/omamobile-modem.service ||
  fail "the modem unit is Type=notify (READY from the start script)"
grep -qx 'ExecStopPost=/usr/lib/omamobile-vendor/omamobile-modem-start --stopped' systemd/omamobile-modem.service || fail "the stop hook"
grep -qx 'Restart=no' systemd/omamobile-modem.service || fail "the modem unit never restarts"
grep -qx 'RefuseManualStop=yes' systemd/omamobile-modem-inhibit.service || fail "the inhibitor refuses a manual stop"
grep -q -- '--what=sleep:idle' systemd/omamobile-modem-inhibit.service && grep -q -- '--mode=block' systemd/omamobile-modem-inhibit.service ||
  fail "the inhibitor blocks sleep and idle"
grep -q -- '--who=omamobile-modem ' systemd/omamobile-modem-inhibit.service || fail "the inhibitor's --who is what the start script looks for"
grep -q '^INHIBITOR=omamobile-modem$' $s || fail "the start script looks for the unit's --who"
! grep -q '^\[Install\]' systemd/omamobile-modem-inhibit.service || fail "the inhibitor is pulled in by the modem unit, not enabled"
w=$(sed -n 's/^Wants=//p' systemd/omamobile-modem-boot.target)
for n in omamobile-modem.service omamobile-sitd.service omamobile-sit-data.service omamobile-mmd.service; do
  [[ " $w " == *" $n "* ]] || fail "the boot target wants $n"
done
grep -qx 'DefaultDependencies=no' systemd/omamobile-modem-boot.target || fail "the boot target doesn't delay multi-user.target"
grep -qx 'WantedBy=multi-user.target' systemd/omamobile-modem-boot.target || fail "the boot target is enabled under multi-user.target"
grep -q 'systemctl mask omamobile-modem-boot.target' systemd/omamobile-modem-boot.target || fail "the target says how to keep the stack off (a vendor link survives disable)"
! grep -q '^Requires=' systemd/omamobile-modem-boot.target || fail "the boot target only wants (a missing unit is fine)"
[[ -z $(find "$stage" -name '*.wants' -o -name '*.requires' | head -1) ]] || fail "no wants or requires link is shipped: $(find "$stage" -name '*.wants' -o -name '*.requires')"
! grep -rq 'systemctl enable' install || fail "the install script enables nothing"
pass "the inhibitor, the modem unit and the target (enabled by the device package, not here)"

# The board id is required (M4.1g/h): the check refuses a missing or empty
# ro.boot.cdt_hwid and a persist copy that differs. Made-up values only.
cdt() { bash -c 'say() { :; }; eval "$(sed -n "/^modem_cdt_check() {/,/^}/p" profiles/modem.conf)"; modem_cdt_check "$1"' _ "$1"; }
: > "$t/p0"; cdt "$t/p0" && fail "no props file content is refused"
printf 'ro.boot.cdt_hwid=\n' > "$t/p1"; cdt "$t/p1" && fail "an empty board id is refused"
printf 'ro.boot.cdt_hwid=TESTID\npersist.vendor.modem.cdt_hwid=OTHER\n' > "$t/p2"; cdt "$t/p2" && fail "a differing persist copy is refused"
printf 'ro.boot.cdt_hwid=TESTID\npersist.vendor.modem.cdt_hwid=TESTID\n' > "$t/p3"; cdt "$t/p3" || fail "a board id is accepted"
printf 'ro.boot.cdt_hwid=TESTID\n' > "$t/p4"; cdt "$t/p4" || fail "the persist copy is optional"
cdt "$t/missing" && fail "a missing props file is refused"
pass "board id required"
