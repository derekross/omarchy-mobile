# SPDX-License-Identifier: MIT
post_install() {
  echo "omamobile-modem: installed. Nothing here enables it: the device package that"
  echo "  ships the modem policy does, through omamobile-modem-boot.target (the Pixel 7"
  echo "  Pro's omamobile-device-cheetah, a vendor wants link). The unit is skipped until"
  echo "  tools/phone-provision has put Google's modem files, the NV checksums"
  echo "  (/etc/omamobile/modem-nv.sha256) and this phone's board id"
  echo "  (/var/lib/omamobile-vendor/modem/props.conf) on the phone. To keep the stack"
  echo "  off: systemctl mask omamobile-modem-boot.target. device/cheetah/MODEM-PLAN.md M4.6."
  udevadm control --reload 2>/dev/null || true
}
post_upgrade() {
  systemctl daemon-reload 2>/dev/null || true
  grep -qs '^ro\.boot\.cdt_hwid=.' /var/lib/omamobile-vendor/modem/props.conf ||
    echo "omamobile-modem: no ro.boot.cdt_hwid in /var/lib/omamobile-vendor/modem/props.conf: the modem won't start until tools/phone-provision has run (MODEM-PLAN M4.1h)"
  udevadm control --reload 2>/dev/null || true
}
pre_remove() {
  systemctl disable omamobile-modem-boot.target omamobile-modem.service 2>/dev/null || true
}
