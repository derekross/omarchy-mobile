# SPDX-License-Identifier: MIT
# The modem: CPIF's modules, then Samsung's rfsd and a one-shot cbd in the
# modem vendor chroot on RAM copies of the NV and firmware partitions
# (device/cheetah/MODEM-PLAN.md M3.4). Not enabled by this package: at
# boot the whole stack comes from omamobile-modem-boot.target (M4.6), which
# the Pixel 7 Pro's device package enables. It starts the modem after the
# audio stack (the AoC carries call audio) and behind the sleep inhibitor
# (omamobile-modem-inhibit.service), which stays until the reboot once a
# modem driver has loaded; since 2026-11-10 a start refused before that
# releases it.
#
# The three conditions are what tools/phone-provision puts on the phone:
# Google's modem files, the NV checksums from the owner's backup and the
# board id. A fresh install has none of them, and the unit is then skipped,
# not failed (the inhibitor carries the same three, so a phone without a
# modem keeps sleeping); the start script refuses on the same three for a
# start by hand.
#
# Type=notify: ready once CPIF's ports exist and the profile's read-only
# check has passed, before the CP is powered on, so a unit ordered after
# this one sees the ports; the CP's ONLINE is waited for by omamobile-sitd's
# ExecStartPre (omamobile-modem-cp wait-online). The start script keeps two
# markers so a hang in the bring-up or with the modem up never repeats at
# the next boot; a clean stop removes the second (ExecStopPost).
#
# The CP stays on while this runs. Stopping it (and so every reboot)
# powers the CP off before rfsd goes: one recovered UFS error-handler pass.
# Never restart it: that is a CP power cycle on a CP that was already up.
#
# The NV overlay (MODEM-PLAN "NV overlay"): the stop captures the modem's
# allowed NV writes after the CP is off, and the timer pulled in here
# captures them every 30 minutes; both do nothing without
# /etc/omamobile/modem-nv-overlay-enable.
[Unit]
Description=Omarchy Mobile modem (S5300: rfsd and cbd on RAM copies of NV)
Requires=omamobile-modem-inhibit.service
After=omamobile-modem-inhibit.service systemd-modules-load.service omamobile-aoc.service omamobile-audio.service
Wants=omamobile-modem-nv-overlay.timer
ConditionPathExists=/usr/lib/omamobile-vendor/modem/root
ConditionPathExists=/etc/omamobile/modem-nv.sha256
ConditionPathExists=/var/lib/omamobile-vendor/modem/props.conf

[Service]
Type=notify
NotifyAccess=all
ExecStart=/usr/lib/omamobile-vendor/omamobile-modem-start
ExecStop=/usr/lib/omamobile-vendor/omamobile-vendor-chroot modem stop
ExecStopPost=/usr/lib/omamobile-vendor/omamobile-modem-start --stopped
Restart=no
TimeoutStartSec=5min
TimeoutStopSec=40
KillMode=mixed

[Install]
WantedBy=multi-user.target
