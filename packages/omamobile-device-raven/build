#!/bin/bash
# SPDX-License-Identifier: MIT
# Compile the C tools into BUILDDIR (default: build).
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
out=${1:-build}
mkdir -p "$out"
for tool in omamobile-bootctl reboot-to; do
  ${CC:-cc} ${CFLAGS:--O2} -Wall -Wextra -o "$out/$tool" "src/$tool.c" ${LDFLAGS:-}
done
