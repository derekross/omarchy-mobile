#!/bin/bash
# SPDX-License-Identifier: MIT
# Give the Wi-Fi interface the phone's real MAC address, as Android does.
# The bootloader writes it into the device tree at every boot
# (/chosen/config/wlan_mac1). brcmfmac doesn't read it there, so without
# this the chip comes up with a random address.
#   omamobile-wlan-mac IFACE   (run by udev when brcmfmac adds the link)
set -euo pipefail

iface=${1:?Usage: omamobile-wlan-mac IFACE}
source=/proc/device-tree/chosen/config/wlan_mac1
[[ -s $source ]] || exit 0
mac=$(tr -d '\0' < "$source" | tr 'A-F' 'a-f')

# A unicast, globally administered address only, as Google's driver checks.
[[ $mac =~ ^[0-9a-f]{2}(:[0-9a-f]{2}){5}$ ]] || exit 0
(( (16#${mac:0:2} & 3) == 0 )) || exit 0

ip link set dev "$iface" down
ip link set dev "$iface" address "$mac"
