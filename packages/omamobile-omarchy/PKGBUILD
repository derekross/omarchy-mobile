pkgname=omamobile-omarchy
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Omarchy Mobile's Omarchy patches, re-applied after every Omarchy upgrade, omamobile-update, Omarchy's update for a phone, and a kernel module cleanup that keeps the next boot's modules"
arch=(any)
url="https://github.com/derekross/omarchy-mobile"
license=(MIT)
depends=('omarchy>=4.0.6' bash python patch libarchive gzip util-linux sudo pacman-contrib fakeroot systemd)
optdepends=('omamobile-shell: the update sheet')
checkdepends=(diffutils patch util-linux libarchive)
install=omamobile-omarchy.install

check() {
  "$startdir/test/all"
}

package() {
  "$startdir/install" "$pkgdir"
}
