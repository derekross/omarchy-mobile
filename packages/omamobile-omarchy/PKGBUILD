pkgname=omamobile-omarchy
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Omamobile's Omarchy patches, re-applied after every Omarchy upgrade, omamobile-update, Omarchy's update for a phone, a kernel module cleanup that keeps the next boot's modules, and power profiles that set the CPU ceilings"
arch=(any)
url="https://github.com/derekross/omamobile"
license=(MIT)
depends=('omarchy>=4.0.6' bash python patch libarchive gzip util-linux sudo pacman-contrib fakeroot systemd zram-generator)
optdepends=('omamobile-shell: the update sheet')
# omamobile-shell 0.2.162 saves Balanced as the phone's starting profile (lib/power-profile)
conflicts=('omamobile-shell<0.2.162')
checkdepends=(diffutils patch util-linux libarchive)
install=omamobile-omarchy.install

check() {
  "$startdir/test/all"
}

package() {
  "$startdir/install" "$pkgdir"
}
