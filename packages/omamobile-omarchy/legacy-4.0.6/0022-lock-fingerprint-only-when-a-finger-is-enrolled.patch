# Lock: fingerprint only when a finger is enrolled. A backport of the probe
# half of upstream Omarchy's 879d6583d ("Fix fingerprint enrollment and
# lock-screen recovery", omacom/omarchy#7158, on quattro for 4.5; no stable
# release has it). The lock and omarchy-apply-lock took
# fprintd-list "$USER" | grep -qi finger as "fingerprint is set up", which
# also matches "User ... has no fingers enrolled ...". On a phone with
# omamobile-fingerprint installed (it ships the PAM file) and nothing
# enrolled, the lock then started a pam_fprintd attempt that failed at once
# (PAM_AUTHINFO_UNAVAIL) and retried every 250 ms for as long as it was up:
# 130,164 attempts in one night, about 55-62 mA (#170).
#
# As upstream: the probe is LC_ALL=C fprintd-list "$USER" 2>&1, and
# FingerprintModel.classifyProbe() reads it: "yes" only for an enrolled-print
# row (" - #0: ..."), "no" for "has no fingers enrolled" (or no PAM file or
# fprintd-list), "unknown" otherwise. Unknown never turns fingerprint off; it
# is asked again after 1 s, doubling to 40 s, while the lock is up.
# omarchy-apply-lock matches the same row, removes the PAM file only on a
# definite "no", and keeps it when the probe fails.
#
# Not taken: the rest of 879d6583d (the attempt backoff and the "reader
# unavailable" notice, the fprintd resume hook and its stop-timeout drop-in,
# the enrollment script changes), so a phone with a finger enrolled behaves
# as before: retries after a mismatch stay at 250 ms. FingerprintModel.js
# holds only upstream's probe functions, copied unchanged.
#
# Against Omarchy 4.0.6 (edge 4.0.6-1), after 0003 and 0009. Drop it once the
# phone's Omarchy has 879d6583d (the 4.5 line); its Service.qml and
# omarchy-apply-lock differ from 4.0.6's, so this will not apply there.
diff --git i/bin/omarchy-apply-lock w/bin/omarchy-apply-lock
--- i/bin/omarchy-apply-lock
+++ w/bin/omarchy-apply-lock
@@ -40,16 +40,24 @@
 account    include                     system-local-login
 EOF
 
-if [[ -x /usr/bin/fprintd-list ]] &&
-  /usr/bin/fprintd-list "$target_user" 2>/dev/null | grep -qi finger; then
+# Keep the privileged probe pinned to /usr/bin; failure is not empty enrollment.
+if [[ -x /usr/bin/fprintd-list ]]; then
+  fingerprint_status=$(/usr/bin/fprintd-list "$target_user" 2>&1 || true)
+else
+  fingerprint_status="no"
+fi
+
+if grep -qE '^[[:space:]]*-[[:space:]]*#[0-9]+:' <<< "$fingerprint_status"; then
   echo "Configuring lock screen fingerprint authentication..."
   as_root tee /etc/pam.d/omarchy-lock-fingerprint >/dev/null <<'EOF'
 #%PAM-1.0
 auth       required                    pam_fprintd.so
 account    include                     system-local-login
 EOF
-else
+elif [[ $fingerprint_status == "no" ]] || grep -qi 'has no fingers enrolled' <<< "$fingerprint_status"; then
   as_root rm -f /etc/pam.d/omarchy-lock-fingerprint
+else
+  echo "Could not check fingerprint enrollment; keeping the existing configuration." >&2
 fi
 
 # omarchy-shell can't reach a running shell during chroot install. The echo
diff --git i/shell/plugins/lock/FingerprintModel.js w/shell/plugins/lock/FingerprintModel.js
new file mode 100644
--- /dev/null
+++ w/shell/plugins/lock/FingerprintModel.js
@@ -0,0 +1,33 @@
+// The probe half of upstream's FingerprintModel.js (879d6583d): what
+// fprintd-list's answer means, and how often to ask again when it had none.
+var MATCH_RETRY_MS = 250
+var ERROR_RETRY_BASE_MS = 1000
+// Leave enough idle time for fprintd to exit and clear a wedged claim.
+var FPRINTD_IDLE_EXIT_MS = 30000
+var ERROR_RETRY_CAP_MS = 40000
+
+function retryDelayMs(streak) {
+  if (streak <= 0) return MATCH_RETRY_MS
+  var delay = ERROR_RETRY_BASE_MS * Math.pow(2, streak - 1)
+  return Math.min(delay, ERROR_RETRY_CAP_MS)
+}
+
+// A failed probe is unknown, so it cannot disable authentication for the lock.
+function classifyProbe(text) {
+  var s = String(text || "").trim()
+  if (/^[ \t]*-[ \t]*#[0-9]+:/m.test(s)) return "yes"
+  if (s === "no") return "no"
+  if (/has no fingers enrolled/i.test(s)) return "no"
+  return "unknown"
+}
+
+if (typeof module !== "undefined") {
+  module.exports = {
+    MATCH_RETRY_MS: MATCH_RETRY_MS,
+    ERROR_RETRY_BASE_MS: ERROR_RETRY_BASE_MS,
+    ERROR_RETRY_CAP_MS: ERROR_RETRY_CAP_MS,
+    FPRINTD_IDLE_EXIT_MS: FPRINTD_IDLE_EXIT_MS,
+    classifyProbe: classifyProbe,
+    retryDelayMs: retryDelayMs
+  }
+}
