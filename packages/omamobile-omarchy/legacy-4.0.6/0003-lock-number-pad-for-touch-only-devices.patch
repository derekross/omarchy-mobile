   property string passwordText: ""
   property bool syncingPasswordText: false
+  // Touch-only devices: a number pad under the field (the lock-keypad toggle).
+  property bool keypad: false
+  // A phone with a fingerprint sensor under the display has it in the lower
+  // third of the screen, where the pad would otherwise sit: a finger on the
+  // sensor pressed a key. With fingerprints set up, the pad keeps the lower
+  // third clear, and a hint above the field says either works, as on Android.
+  readonly property bool keypadClearsSensor: keypad && fingerprintConfigured
+  readonly property int keypadBottomMargin: Math.round(height * (keypadClearsSensor ? 0.34 : 0.08))
 
-  readonly property string placeholderText: "Enter Password"
+  readonly property string placeholderText: keypad ? "Enter PIN" : "Enter Password"
   readonly property int fieldWidth: 381
   readonly property int fieldHeight: 67
   readonly property int outlineThickness: 3
@@ -54,7 +62,8 @@ Item {
   }
 
   function forcePasswordFocus() {
-    passwordInput.forceActiveFocus()
+    if (keypad) keypadKeys.forceActiveFocus()
+    else passwordInput.forceActiveFocus()
   }
 
   function clearPassword() {
@@ -115,16 +124,58 @@ Item {
 
     MouseArea {
       anchors.fill: parent
-      hoverEnabled: true
+      hoverEnabled: !root.keypad
       onClicked: { root.wakeRequested(); root.forcePasswordFocus() }
       onPositionChanged: root.wakeRequested()
     }
 
+    Item {
+      id: keypadKeys
+      Keys.onPressed: function(event) {
+        if (!numberPad.enabled) return
+        if (event.text.length === 1 && event.text >= "0" && event.text <= "9") numberPad.digit(event.text)
+        else if (event.key === Qt.Key_Backspace) numberPad.backspace()
+        else if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) numberPad.enter()
+        else if (event.key === Qt.Key_Escape) root.passwordTextEdited("")
+        else return
+        event.accepted = true
+      }
+    }
+
+    Keypad {
+      id: numberPad
+      visible: root.keypad
+      enabled: root.inputEnabled && !root.authenticatingPassword
+      anchors.horizontalCenter: parent.horizontalCenter
+      anchors.bottom: parent.bottom
+      anchors.bottomMargin: root.keypadBottomMargin
+      // what is left above it for the field, the hint and a margin
+      maxHeight: parent.height - root.keypadBottomMargin - root.fieldHeight - Style.space(40)
+        - (root.keypadClearsSensor ? keypadHint.height + Style.space(18) : 0) - Style.space(48)
+      onDigit: function(value) {
+        root.wakeRequested()
+        if (root.failureMessage.length > 0) root.clearFailureRequested()
+        root.passwordTextEdited(root.passwordText + value)
+      }
+      onBackspace: {
+        root.wakeRequested()
+        root.passwordTextEdited(root.passwordText.slice(0, -1))
+      }
+      onEnter: {
+        var submitted = root.passwordText
+        root.passwordTextEdited("")
+        if (submitted.length > 0) root.submitPassword(submitted)
+      }
+    }
+
     BorderSurface {
       id: inputField
       width: root.fieldWidth
       height: root.fieldHeight
-      anchors.centerIn: parent
+      anchors.horizontalCenter: parent.horizontalCenter
+      anchors.verticalCenter: root.keypad ? undefined : parent.verticalCenter
+      anchors.bottom: root.keypad ? numberPad.top : undefined
+      anchors.bottomMargin: root.keypad ? Style.space(40) : 0
       color: Commons.Color.lock.background
       borderSpec: root.inputBorderSpec
       radius: Style.cornerRadius
@@ -141,7 +192,7 @@ Item {
         anchors.leftMargin: inputField.borderLeft + 18 + root.fingerprintReserve
         verticalAlignment: TextInput.AlignVCenter
         horizontalAlignment: TextInput.AlignHCenter
-        activeFocusOnPress: true
+        activeFocusOnPress: !root.keypad
         clip: true
         enabled: root.inputEnabled && !root.authenticatingPassword
         readOnly: root.authenticatingPassword
@@ -216,5 +267,23 @@ Item {
         verticalAlignment: Text.AlignVCenter
       }
     }
+
+    // Touch-only devices with fingerprints: say that either unlocks.
+    Text {
+      id: keypadHint
+      objectName: "keypadFingerprintHint"
+      textFormat: Text.PlainText
+      anchors.bottom: inputField.top
+      anchors.bottomMargin: Style.space(18)
+      anchors.horizontalCenter: inputField.horizontalCenter
+      width: parent.width - Style.space(32)
+      visible: root.keypadClearsSensor
+      text: "Touch the fingerprint sensor or enter your PIN"
+      color: Commons.Color.lock.text
+      font.family: Style.font.family
+      font.pixelSize: Style.font.subtitle
+      wrapMode: Text.WordWrap
+      horizontalAlignment: Text.AlignHCenter
+    }
   }
 }
