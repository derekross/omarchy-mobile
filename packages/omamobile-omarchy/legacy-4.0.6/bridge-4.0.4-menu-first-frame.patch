# Phone bridge: upstream fixed this in shell/Ui/OverlayWindow.qml (overlays stay
# transparent until sized and scaled), but no release has it yet: 4.0.6's menu is
# still a plain PanelWindow. Drop it once a release's menu uses OverlayWindow.
--- a/shell/plugins/menu/Menu.qml
+++ b/shell/plugins/menu/Menu.qml
@@ -1041,7 +1041,16 @@
         maxRowsHeight = root.visibleRowsHeight
       }
     }
-    onVisibleChanged: if (!visible) { cardTop = -1; maxRowsHeight = -1 }
+    // The card stays hidden for a moment after the window maps, so a frame
+    // laid out before the window is sized (or left from the last opening)
+    // never shows: on a phone that flashed a small card at the top edge.
+    property bool cardSettled: false
+    Timer { id: cardSettleTimer; interval: 32; onTriggered: panel.cardSettled = true }
+    onVisibleChanged: {
+      cardSettled = false
+      if (visible) cardSettleTimer.restart()
+      else { cardTop = -1; maxRowsHeight = -1 }
+    }
 
     Rectangle {
       anchors.fill: parent
@@ -1055,6 +1064,10 @@
 
     BorderSurface {
       id: card
+      // Hidden until the compositor has sized the window to the screen: for a
+      // frame after opening it still has a placeholder size, which draws a
+      // short card at the top edge before it centers.
+      visible: panel.cardSettled && (panel.screen ? panel.height === panel.screen.height && panel.width === panel.screen.width : panel.height > 0)
       width: root.cardWidth
       height: Math.min(root.cardHeight, panel.height - Style.gapsOut - panel.effectiveCardTop)
       radius: root.cornerRadius
