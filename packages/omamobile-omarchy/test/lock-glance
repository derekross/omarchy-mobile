#!/bin/bash
# SPDX-License-Identifier: MIT
# Patch 0023's glance view on the lock (with 0026's battery and 0027's
# media controls), offscreen in qmltestrunner: the
# patched LockView, LockGlance and NotificationCard with Omarchy's real
# Commons and Ui from the package (test/patches.py passes the patched
# shell directory), and Quickshell stubbed (test/qml-stubs). No compositor,
# no Quickshell, no session. Exits 77 without qmltestrunner.
#   test/lock-glance SHELL_DIR
set -euo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
shell=${1:?usage: lock-glance SHELL_DIR}
runner=$(command -v qmltestrunner6 || command -v /usr/lib/qt6/bin/qmltestrunner || command -v qmltestrunner || true)
[[ -n $runner ]] || { echo "lock-glance: no qmltestrunner" >&2; exit 77; }

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/qs" "$work/plugins" "$work/home/.local/state/omarchy/toggles" \
  "$work/home/.local/state/omamobile" "$work/home/.config/omarchy"
cp -r "$shell/Commons" "$shell/Ui" "$work/qs/"
mkdir -p "$work/home/omarchy/default"
[[ ! -d $shell/../default/i18n ]] || cp -r "$shell/../default/i18n" "$work/home/omarchy/default/"
cp -r "$shell/plugins/lock" "$shell/plugins/notifications" "$work/plugins/"
if [[ -n ${PRIVATE_LOCK_DIR:-} ]]; then
  for f in Service.qml LockView.qml LockGlance.qml LockGlance.js Keypad.qml FingerprintModel.js LockBattery.qml LockBattery.js LockMedia.qml LockMedia.js LockMediaSource.qml NenajMatrix.qml; do
    [[ ! -f $PRIVATE_LOCK_DIR/$f ]] || cp "$PRIVATE_LOCK_DIR/$f" "$work/plugins/lock/$f"
  done
  # Resolve production absolute imports to the SAME candidate components in
  # this fixture only; never fall through to this machine's installed shell.
  sed -i 's|file:///usr/share/omarchy/shell/plugins/notifications/components|../notifications/components|g' "$work/plugins/lock/LockGlance.qml"
  sed -i 's|file:///usr/share/omarchy/shell/plugins/notifications/NotificationLogic.js|../notifications/NotificationLogic.js|g' "$work/plugins/lock/LockGlance.js"
fi
# Omarchy's media service's model, which the lock's media controls (0027) use.
mkdir -p "$work/plugins/services"
cp -r "$shell/plugins/services/media" "$work/plugins/services/"
cp "$here/lock-glance.qml" "$work/tst_lock_glance.qml"
if ! grep -q "notifications/quiet.json" "$shell/plugins/lock/LockGlance.qml"; then
  sed -i "s|notifications/quiet.json|notifications.json|g" "$work/tst_lock_glance.qml"
fi
printf '.pragma library\nvar HOME = "%s"\n' "$work/home" > "$work/TestEnv.js"

export QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software QML_DISABLE_DISK_CACHE=1
export QML_XHR_ALLOW_FILE_READ=1
# The shell runs under the C/POSIX locale on the phone; so does the test.
export LC_ALL=C LANG=C
exec "$runner" -import "$here/qml-stubs" -import "$work" -input "$work/tst_lock_glance.qml"
