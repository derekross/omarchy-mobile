#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omamobile-omarchy into DESTDIR. The pacman hook applies the patch
# series after the package transaction; the module-tree cleanup's timer is
# enabled by the wants link staged here, and Arch's linux-modules-cleanup is
# held off by a drop-in (lib/modules-cleanup says why).
#   ./install DESTDIR
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
d=${1:?Usage: ./install DESTDIR}
[[ $d == /* && $d != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
install -Dm755 bin/omamobile-omarchy-patches "$d/usr/bin/omamobile-omarchy-patches"
install -Dm755 bin/omamobile-update "$d/usr/bin/omamobile-update"
for f in lib/update-bin/*; do
  install -Dm755 "$f" "$d/usr/lib/omamobile-omarchy/update-bin/${f##*/}"
done
install -Dm755 lib/lock-pam "$d/usr/lib/omamobile-omarchy/lock-pam"
install -Dm755 lib/modules-cleanup "$d/usr/lib/omamobile-omarchy/modules-cleanup"
u=$d/usr/lib/systemd/system
install -Dm644 systemd/omamobile-modules-cleanup.service "$u/omamobile-modules-cleanup.service"
install -Dm644 systemd/omamobile-modules-cleanup.timer "$u/omamobile-modules-cleanup.timer"
install -Dm644 systemd/linux-modules-cleanup.service.d/10-omamobile.conf \
  "$u/linux-modules-cleanup.service.d/10-omamobile.conf"
install -d "$u/timers.target.wants"
ln -sfn ../omamobile-modules-cleanup.timer "$u/timers.target.wants/omamobile-modules-cleanup.timer"
for f in patches/*.patch; do
  install -Dm644 "$f" "$d/usr/share/omamobile/omarchy/patches/${f##*/}"
done
install -Dm644 libalpm/95-omamobile-omarchy-patches.hook "$d/usr/share/libalpm/hooks/95-omamobile-omarchy-patches.hook"
install -Dm644 LICENSE "$d/usr/share/licenses/omamobile-omarchy/LICENSE"
install -Dm644 version "$d/usr/share/omamobile/omarchy/version"
