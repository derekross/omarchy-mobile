   }
 
+  // Only a live sender may receive an inline reply; restored rows have none.
+  property string replyKey: ""
+  function replyPlaceholder(key, revision) {
+    if (leaving[key]) return ""
+    var ref = refs[key]
+    try {
+      return ref && ref.tracked && ref.hasInlineReply
+          ? Security.bounded(String(ref.inlineReplyPlaceholder || "Reply"), 160) : ""
+    } catch (e) { return "" }
+  }
+  function beginReply(key) {
+    if (!replyPlaceholder(key, refsRevision)) return false
+    stopKeyboard()
+    replyKey = key
+    return true
+  }
+  function sendReply(key, text) {
+    if (leaving[key] || !liveKeys[key]) return false
+    if (typeof text !== "string" || !text.trim() || text.length > 4096) return false
+    var ref = refs[key]
+    try {
+      if (!ref || !ref.tracked || !ref.hasInlineReply) return false
+      ref.sendInlineReply(text)
+    } catch (e) { return false }
+    replyKey = ""
+    closeToast(key, "dismissed")
+    return true
+  }
+
