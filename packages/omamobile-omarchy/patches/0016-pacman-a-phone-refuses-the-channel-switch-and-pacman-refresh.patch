# Keep phone repository ownership before any4.5 platform/channel reset action.

diff --git i/bin/omarchy-channel-set w/bin/omarchy-channel-set
--- i/bin/omarchy-channel-set
+++ w/bin/omarchy-channel-set
@@ -1,5 +1,12 @@
 #!/bin/bash
 
+# A phone's pinned package repository and Arch Linux ARM mirrors are owned
+# by omamobile-update, never the desktop channel/reset commands.
+if [[ -x /usr/bin/omamobile-update ]]; then
+  echo "omarchy-channel-set: use 'omarchy update' on Omarchy Mobile; see docs/RELEASES.md 5.4." >&2
+  exit 1
+fi
+
 # omarchy:summary=Set the Omarchy package channel.
 # omarchy:args=<stable|rc|edge|dev>
 # omarchy:requires-sudo=true
diff --git i/bin/omarchy-refresh-pacman w/bin/omarchy-refresh-pacman
--- i/bin/omarchy-refresh-pacman
+++ w/bin/omarchy-refresh-pacman
@@ -1,5 +1,12 @@
 #!/bin/bash
 
+# A phone's pinned package repository and Arch Linux ARM mirrors are owned
+# by omamobile-update, never the desktop channel/reset commands.
+if [[ -x /usr/bin/omamobile-update ]]; then
+  echo "omarchy-refresh-pacman: use 'omarchy update' on Omarchy Mobile; see docs/RELEASES.md 5.4." >&2
+  exit 1
+fi
+
 # omarchy:summary=Overwrite the package configuration for /etc/pacman with the Omarchy default of using its dedicated mirrors and repositories, then update all packages.
 # omarchy:requires-sudo=true
 
