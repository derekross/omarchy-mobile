+// JSON lines; these are its pure parts. A computer without it never gets here.
+
+// The helper's command line. It owns the pairing window (Pairable, with
+// BlueZ's own timeout) only when Pairable was off as the card opened; one
+// that was on already belongs to the owner's own agent or main.conf.
+function helperCommand(pairableAtOpen, seconds) {
+  if (pairableAtOpen) return ["omamobile-bt-agent"]
+  return ["omamobile-bt-agent", "--pairable-window", String(seconds)]
+}
+
+// One JSON line from the helper, or null.
+function parseHelperLine(line) {
+  var text = String(line || "").trim()
+  if (!text || text[0] !== "{") return null
+  try {
+    var value = JSON.parse(text)
+    return value && typeof value.event === "string" ? value : null
+  } catch (error) {
+    return null
+  }
+}
+
+// The helper's "ready": whether the pairing window is this card's. It is
+// when the card asked for it and no other panel's helper holds it (an older
+// helper doesn't say, and owned it whenever asked).
+function ownsWindow(command, ready) {
+  return !!command && command.length > 1 && !!ready && ready.window !== false
+}
+
+function padPasskey(value) {
+  var text = String(Math.max(0, Math.floor(Number(value) || 0)))
+  while (text.length < 6) text = "0" + text
+  return text
+}
+
+// A code the phone shows, which the other device types or compares; there
+// is nothing to answer, only to cancel.
+function isDisplayRequest(request) {
+  return !!request && /^display-/.test(String(request.type || ""))
+}
+
+// A request from the helper -> what the card asks: title, body, the code to
+// show, the input wanted ("" | "pin" | "passkey") and whether Pair answers it.
+function pairingPrompt(request) {
+  var r = request || {}
+  var name = r.label || r.address || "device"
+  switch (r.type) {
+  case "confirm":
+    return { title: "Pair with " + name + "?", body: "Check that this code shows on both devices.",
+             code: padPasskey(r.passkey), entered: 0, input: "", answer: true }
+  case "authorize":
+    return { title: "Pair with " + name + "?", body: "It is asking to pair.",
+             code: "", entered: 0, input: "", answer: true }
+  case "pin":
+    return { title: "Pair with " + name, body: "Enter its PIN (often 0000 or 1234).",
+             code: "", entered: 0, input: "pin", answer: true }
+  case "passkey":
+    return { title: "Pair with " + name, body: "Enter the 6-digit passkey it shows.",
+             code: "", entered: 0, input: "passkey", answer: true }
+  case "display-passkey":
+    return { title: "Pairing with " + name, body: "Type this code on it, then press Enter.",
+             code: padPasskey(r.passkey), entered: Number(r.entered) || 0, input: "", answer: false }
+  case "display-pin":
+    return { title: "Pairing with " + name, body: "Enter this PIN on it.",
+             code: String(r.pin || ""), entered: 0, input: "", answer: false }
+  }
+  return null
+}
+
+// Whether a typed value can answer: a PIN is 1-16 characters, a passkey up
+// to six digits.
+function validCode(input, value) {
+  var text = String(value || "")
+  if (input === "pin") return text.length >= 1 && text.length <= 16
+  if (input === "passkey") return /^[0-9]{1,6}$/.test(text)
+  return true
+}
+
+// The helper command that answers a request. The code goes only here, over
+// the helper's stdin.
+function replyCommand(request, accept, value) {
+  var reply = { cmd: "reply", id: request ? request.id : -1, accept: !!accept }
+  if (accept && request && (request.type === "pin" || request.type === "passkey")) reply.value = String(value || "")
+  return reply
