+function pairingStep(state, event) {
+  var s = state || pairingIdle()
+  var e = event || {}
+  if (e.event === "start") return { address: e.address || "", request: null }
+  if (e.event === "request") return { address: s.address || e.address || "", request: e }
+  // A shown code stays up until the pairing ends; an answered question goes.
+  if (e.event === "answered") {
+    if (!e.accept) return pairingIdle()
+    return { address: s.address, request: isDisplayRequest(s.request) ? s.request : null }
+  }
+  if (e.event === "cancel") return pairingIdle()
+  if (e.event === "result" && e.op === "pair" && e.address === s.address) return pairingIdle()
+  if (e.event === "reset") return pairingIdle()
