# Phone only, not for upstream: "omarchy update" hands over to omamobile-update
# (packages/omamobile-omarchy), which runs this same script back with
# OMAMOBILE_UPDATE=1 and Omarchy's own steps, minus the ones that don't belong
# on a phone (Snapper, the AUR, the kernel-reboot prompt and orphan removal,
# which ask through gum) and with boot-related migrations held for review. So
# the command AGENTS.md tells people to use, the menu's Update > Omarchy and
# the bar's update button all take the phone's path. The patch is re-applied
# after every Omarchy upgrade like the rest of the series; when it can't be,
# Omarchy's update runs unwrapped, as before. Escape hatch:
# OMAMOBILE_UPDATE=1 omarchy-update.
#
#
# Omarchy 4.5 port: the handoff is unchanged and still the first thing the
# script does, before 4.5's transcript (script), its update lock and its
# sudo keep-alive. 4.5 split the restart step into --services-only (found
# on PATH, so the phone's stand-in runs it) and a final --reboot-only run
# by its absolute path in $OMARCHY_PATH/bin, which would skip the stand-in
# and decide "kernel updated" from vmlinuz/modules ownership, wrong for a
# phone booting slot B. Under OMAMOBILE_UPDATE only, that last call goes
# through PATH too; a desktop runs it exactly as before. 4.5's new boot
# verification (omarchy-update-boot) is a stand-in on the phone as well
# (packages/omamobile-omarchy lib/update-bin).

diff --git i/bin/omarchy-update w/bin/omarchy-update
--- i/bin/omarchy-update
+++ w/bin/omarchy-update
@@ -8,6 +8,14 @@
 
 set -e
 
+# Omarchy Mobile: a phone updates through omamobile-update, which runs this
+# same flow with the phone's exclusions (no snapshot, AUR or reboot prompt;
+# boot-related migrations held) and reports to the shell's update sheet. It
+# calls back in with OMAMOBILE_UPDATE=1.
+if [[ -z ${OMAMOBILE_UPDATE:-} && -x /usr/bin/omamobile-update ]]; then
+  exec /usr/bin/omamobile-update "$@"
+fi
+
 update_stay_awake_stopped=0
 sudo_keepalive_pid=""
 
@@ -147,7 +155,13 @@
   fi
 
   if (( boot_verified )); then
-    "$OMARCHY_PATH/bin/omarchy-update-restart" --reboot-only
+    # Omarchy Mobile: under omamobile-update the phone's stand-in on PATH
+    # decides about a restart (slot B, not a vmlinuz), and asks nothing.
+    if [[ -n ${OMAMOBILE_UPDATE:-} ]]; then
+      omarchy-update-restart --reboot-only
+    else
+      "$OMARCHY_PATH/bin/omarchy-update-restart" --reboot-only
+    fi
   else
     echo -e "\e[31m\nThe update is not finished: its boot files did not pass verification (see above). Do not reboot until omarchy update completes.\e[0m" >&2
     exit 1
