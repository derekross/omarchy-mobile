+        bordered: true
+        foreground: Commons.Color.notifications.text
+        onClicked: root.replying ? root.sendReply() : root.replyRequested()
+      }
+    }
+  }
+
+  // Close button: a small glyph with a 44 px touch target in the top-right
+  // corner, inside the border.
+  MouseArea {
+    id: closeButton
+    objectName: "notificationCloseButton"
+    visible: root.closeButtonShown
+    anchors.top: parent.top
+    anchors.right: parent.right
+    anchors.topMargin: root.borderTop
+    anchors.rightMargin: root.borderRight
+    width: Style.space(44)
+    height: Style.space(44)
+    cursorShape: Qt.PointingHandCursor
+    Accessible.role: Accessible.Button
+    Accessible.name: "Dismiss notification"
+    onClicked: root.closeRequested()
+
+    Rectangle {
+      anchors.centerIn: parent
+      width: Style.space(28)
+      height: width
+      radius: width / 2
+      color: Commons.Color.notifications.text
+      opacity: closeButton.pressed ? 0.18 : 0
+    }
+
+    Text {
+      textFormat: Text.PlainText
+      anchors.centerIn: parent
+      text: "󰅖"
+      color: root.dimColor
+      font.family: root.fontFamily
+      font.pixelSize: Style.font.icon
+    }
+  }
+}
