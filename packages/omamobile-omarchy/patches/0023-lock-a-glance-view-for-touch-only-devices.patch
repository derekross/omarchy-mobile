# Lock: a glance view on touch-only devices (the lock-keypad toggle), as a
# phone's lock screen opens: the time, the date, the home screen's last
# weather reading and the newest notifications, over the lock's blurred
# wallpaper. Only a swipe up (a clear drag, 8 % of the height, or a quick
# flick, from anywhere, a card included) or a typed key (kept in the field)
# moves to the PIN view, which is the lock as before plus a small clock. A
# tap never does: a tap on a card opens it to more of its text (summary up
# to 2 lines, body up to 4) and runs nothing, a second tap closes it, and a
# tap elsewhere does nothing. The first 12 px of a drag decide its way:
# mostly sideways on a card swipes it as a toast swipes (0017's
# finishSwipe: past 35 % or a flick it flies off), and that one notification
# is forgotten through the notifications service's forget call (0019), the
# call the phone's shade makes, so it leaves the history and the shade too,
# and the next one moves up; mostly vertical is the swipe up. It comes back
# whenever the lock is shown, the
# screen is woken (the wake call from 0009) or the screen goes dark: the
# lock's own blank, or a new "dark" call for what blanks it from outside
# (the phone's power button, and sleep). With an empty field and no input it
# also comes back after 15 s, counted on the wall clock so that a sleep in
# between can't freeze it. A touch on a dark screen, and one within 400 ms
# of a wake, only wakes it, and open cards close again. Only one view shows
# outside the short change; the other is hidden, so nothing of the PIN view
# renders or takes touches under the glance. Fingerprint unlock is untouched
# and works from both.
#
# The cards are Omarchy's NotificationCard, static as the history uses it,
# one per notification, newest first, as many as fit above the hint (up to
# three), then a line for the rest ("N more from A and B", "N more from A,
# B and 2 others"), with three new card properties: summaryLines, bodyLines
# and a detail label (the age, "2m").
# Read (the forget is the one change) from the notifications plugin's
# persisted toasts and history
# (~/.local/state/omarchy/notifications/*.json, history/*.json): the same
# notifications the phone's shade lists, the newest ten with no age limit,
# Omarchy's own messages (omarchy-action, shown as Omarchy) and notify-send
# included. While do-not-disturb is on (notifications.json "dnd"), only what
# still toasts shows: Omarchy's own messages and a critical notify-send.
# The toggle lock-hide-notification-text shows the app name and "Unlock to
# read" instead of the text. Weather comes from
# ~/.local/state/omamobile/weather.json, written by the phone shell's
# omamobile-weather service, and is hidden when absent or over 3 h old; the
# lock makes no network calls. The clock follows the bar's clockFormat (shell.json), else
# the locale. On a computer the lock is unchanged.
#
# Against Omarchy 4.0.6 (edge 4.0.6-1), after 0003, 0009, 0011, 0014, 0017
# and 0019.
diff --git i/shell/plugins/lock/LockGlance.js w/shell/plugins/lock/LockGlance.js
new file mode 100644
--- /dev/null
+++ w/shell/plugins/lock/LockGlance.js
@@ -0,0 +1,139 @@
+.pragma library
+.import "../notifications/NotificationLogic.js" as NotificationLogic
+
+// What the phone's lock shows at a glance (LockGlance.qml): the clock's
+// 12- or 24-hour choice, the notifications grouped by app, and the weather
+// line. Plain functions of their inputs, so the test can drive them.
+
+// Up to this many notifications get a card; the rest fold into one line.
+var MAX_CARDS = 3
+// The notifications the lock sums up are the ones the phone's notification
+// shade lists: the newest ten of the toasts on screen and the history,
+// which the notifications service trims to ten (historyLimit), with no age
+// limit and no app left out.
+var SHADE_LIMIT = 10
+// NotificationUrgency.Critical, for the do-not-disturb rule.
+var CRITICAL = 2
+// A weather reading older than this is not shown.
+var WEATHER_MAX_AGE_MS = 3 * 60 * 60 * 1000
+
+// The phone bar's clockFormat (shell.json bar.clockFormat), as the home
+// screen's clock reads it: quoted literals ignored, an AM/PM marker or "h"
+// without "H" means 12-hour. Without one, the locale's short time format.
+function twelveHour(barFormat, localeFormat) {
+  var f = String(barFormat || "").replace(/'[^']*'/g, "")
+  if (!f) f = String(localeFormat || "").replace(/'[^']*'/g, "")
+  return /a/i.test(f) || (/h/.test(f) && !/H/.test(f))
+}
+
+// The large glance time leaves AM/PM out; the small clock over the PIN
+// view keeps it.
+function timeFormat(twelve, withMarker) {
+  return twelve ? (withMarker ? "h:mm AP" : "h:mm") : "HH:mm"
+}
+
+function age(timestamp, now) {
+  var minutes = Math.floor(Math.max(0, Number(now) - Number(timestamp || 0)) / 60000)
+  if (minutes < 1) return "now"
+  if (minutes < 60) return minutes + "m"
+  return Math.floor(minutes / 60) + "h"
+}
+
+
+// The name a card goes by: Omarchy's own messages (omarchy-action)
+// as Omarchy, a bare notify-send or a nameless sender as Notifications.
+function appName(app) {
+  var name = String(app || "").trim()
+  if (name === "omarchy-action") return "Omarchy"
+  if (!name || name === "notify-send") return "Notifications"
+  return name
+}
+
+// The shade's rows (see SHADE_LIMIT; a row with neither summary nor body is
+// skipped, as there) from the persisted popup and history files (the
+// notifications plugin's state, one JSON line each, read together).
+function shadeRows(raw) {
+  var rows = NotificationLogic.historyRows(raw, [], 1, 1000)
+  var out = []
+  for (var i = 0; i < rows.length && out.length < SHADE_LIMIT; i++) {
+    var e = rows[i]
+    if (!String(e.summary || "").trim() && !String(e.body || "").trim()) continue
+    out.push(e)
+  }
+  return out
+}
+
+// The file names (NotificationLogic.popupFileName) of every notification
+// the files hold, as a set.
+function fileNames(raw) {
+  var rows = NotificationLogic.historyRows(raw, [], 1, 1000)
+  var out = {}
+  for (var i = 0; i < rows.length; i++) out[NotificationLogic.popupFileName(rows[i])] = true
+  return out
+}
+
+// Those rows as cards, one per notification, newest first. While
+// do-not-disturb is on, only what would still toast: Omarchy's own
+// messages, and a critical notify-send (NotificationLogic.shouldBypassDnd).
+// hideText shows the app name and "Unlock to read" instead of the text, and
+// no sender picture. The detail beside the summary is the age ("2m").
+function cards(raw, now, hideText, dnd) {
+  var rows = shadeRows(raw)
+  var out = []
+  for (var i = 0; i < rows.length; i++) {
+    var e = rows[i]
+    if (dnd && !NotificationLogic.shouldBypassDnd({ appName: e.app, urgency: e.urgency }, CRITICAL)) continue
+    var name = appName(e.app)
+    out.push({
+      app: name,
+      appIcon: e.appIcon,
+      image: hideText ? "" : e.image,
+      glyph: e.glyph,
+      urgency: e.urgency,
+      timestamp: e.timestamp,
+      summary: hideText ? name : (String(e.summary || "").trim() || name),
+      body: hideText ? "Unlock to read" : NotificationLogic.sanitizeBody(e.body, e.app, e.appIcon),
+      detail: age(e.timestamp, now),
+      file: NotificationLogic.popupFileName(e)
+    })
+  }
+  return out
+}
+
+// The line under the cards for the notifications without one: "5 more from
+// Mail and GitHub", "5 more from Mail, GitHub and 2 others", each app named
+// once, newest first.
+function moreText(rest) {
+  if (!rest || rest.length === 0) return ""
+  var names = []
+  for (var i = 0; i < rest.length; i++) {
+    var app = String(rest[i].app || "")
+    if (app && names.indexOf(app) < 0) names.push(app)
+  }
+  if (names.length === 0) return rest.length + " more"
+  var from = names.length <= 2 ? names.join(" and ")
+    : names.slice(0, 2).join(", ") + " and " + (names.length - 2) + (names.length === 3 ? " other" : " others")
+  return rest.length + " more from " + from
+}
+
+// notifications.json's do-not-disturb flag: silenced notifications make no
+// toast, so the lock shows only what still toasts (cards).
+function doNotDisturb(raw) {
+  var parsed = NotificationLogic.parseSettings(raw)
+  return parsed.dnd === true
+}
+
+// The home screen weather widget's last reading, which omamobile-shell
+// keeps in ~/.local/state/omamobile/weather.json:
+//   {"at": <ms since epoch>, "temperature": 12, "unit": "°C", "text": "Partly cloudy"}
+// Shown as "12°, partly cloudy"; nothing when absent, unreadable or older
+// than WEATHER_MAX_AGE_MS. The lock itself never asks the network.
+function weatherLine(raw, now) {
+  var w
+  try { w = JSON.parse(String(raw || "")) } catch (e) { return "" }
+  if (!w || typeof w.temperature !== "number" || !isFinite(w.temperature)) return ""
+  var at = Number(w.at || 0)
+  if (!(at > 0) || Number(now) - at > WEATHER_MAX_AGE_MS || at - Number(now) > 5 * 60 * 1000) return ""
+  var text = String(w.text || "").trim()
+  return Math.round(w.temperature) + "°" + (text ? ", " + text.charAt(0).toLowerCase() + text.slice(1) : "")
+}
diff --git i/shell/plugins/lock/LockGlance.qml w/shell/plugins/lock/LockGlance.qml
new file mode 100644
--- /dev/null
+++ w/shell/plugins/lock/LockGlance.qml
@@ -0,0 +1,624 @@
+import QtQuick
+import Quickshell
+import Quickshell.Io
+import qs.Commons
+import qs.Commons as Commons
+import qs.Ui
+import "../notifications/components"
+import "LockGlance.js" as Glance
+
+// The lock's glance view on touch-only devices (the lock-keypad toggle):
+// the time, the date, the weather, the newest notifications and a hint,
+// over the lock's own blurred wallpaper. A tap on a card opens it to more
+// of its text, a sideways swipe dismisses it (as in the shade); only a swipe up or a typed key moves to the PIN view, which
+// is the lock as before plus a small clock; with no input it comes back after
+// 15 s, and whenever the lock is shown, the screen goes dark (any way: the
+// lock's own blank, the power button, sleep) or the screen is woken. The
+// touch that wakes a dark screen only wakes it. Fingerprint unlock runs
+// underneath either view, untouched.
+//
+// Read-only: the notifications plugin's persisted toasts and history, its
+// do-not-disturb flag, the lock-hide-notification-text toggle, the bar's
+// clock format and the home screen's last weather reading. Nothing here
+// acts on a notification or asks the network.
+//
+// On a computer (keypad off) it shows nothing and reads nothing.
+Item {
+  id: glance
+
+  // The LockView this sits in.
+  property var lock: null
+  // Where the PIN view's own content starts (its hint or field), for the
+  // small clock above it.
+  property real pinTop: height * 0.2
+
+  readonly property bool active: !!lock && lock.keypad
+  property bool shown: true
+  readonly property bool showing: active && shown
+  // 1 with the glance up, 0 with the PIN view; animated in between. The
+  // view not in use is hidden (visible: false) once the change is over.
+  property real progress: showing ? 1 : 0
+  Behavior on progress { NumberAnimation { duration: 220; easing.type: Easing.OutCubic } }
+
+  readonly property string home: Quickshell.env("HOME")
+  property bool hideText: false
+  property bool doNotDisturb: false
+  property string barClockFormat: ""
+  property string notificationsRaw: ""
+  property string weatherRaw: ""
+  readonly property double now: clock.date.getTime()
+  readonly property bool twelveHour: Glance.twelveHour(barClockFormat, Qt.locale().timeFormat(Locale.ShortFormat))
+  // Swiped away: hidden at once by file name, until a read no longer finds
+  // the file (the service's forget runs on its file queue), as the shade
+  // does. A mark the files still show after 15 s lapses (a forget that never
+  // happened), and the card comes back.
+  property var dismissed: ({})
+  readonly property var cards: active ? Glance.cards(notificationsRaw, now, hideText, doNotDisturb)
+    .filter(function(c) { return !glance.dismissed[c.file] }) : []
+  readonly property var shownCards: cards.slice(0, Glance.MAX_CARDS)
+  // How many of those cards fit above the hint (refit).
+  property int fitCount: Glance.MAX_CARDS
+  readonly property string moreText: Glance.moreText(cards.slice(Math.min(fitCount, shownCards.length)))
+  // The cards opened to more of their text, by notification file name;
+  // all closed again whenever the glance comes back.
+  property var expanded: ({})
+  readonly property string weatherText: active ? Glance.weatherLine(weatherRaw, now) : ""
+  // Where the under-display sensor's part of the screen starts (LockView's
+  // keypadClearsSensor): the hint sits just below it, the cards above.
+  readonly property real sensorTop: lock && lock.keypadClearsSensor ? height - lock.keypadBottomMargin : height
+  property double lastActivity: Date.now()
+  property bool polling: true
+  // A touch on a dark screen only wakes it, as on a phone, and so does one
+  // within this long of a wake (the rest of that touch, or a finger already
+  // on its way).
+  property int wakeGuardMs: 400
+  property double wakeGuardUntil: 0
+
+  visible: active
+
+  function show() {
+    if (!active || (lock && lock.authenticatingPassword)) return
+    shown = true
+    expanded = ({})
+    if (lock.passwordText.length > 0) lock.passwordTextEdited("")
+    noteActivity()
+    refresh()
+    glance.forceActiveFocus()
+    if (lock.inputEnabled) lock.foldKeyboard()
+  }
+
+  function reveal() {
+    if (!showing) return
+    shown = false
+    pendingFocus = true
+    lock.wakeRequested()
+  }
+
+  // The PIN view's field takes focus once it is shown again (an item that
+  // is not visible can't), which brings up the on-screen keyboard for a
+  // password as before.
+  property bool pendingFocus: false
+  onProgressChanged: {
+    if (pendingFocus && progress < 1) {
+      pendingFocus = false
+      Qt.callLater(lock.forcePasswordFocus)
+    }
+  }
+
+  function noteActivity() {
+    lastActivity = Date.now()
+    idleTimer.since = lastActivity
+    if (!active) return
+    if (!polling) {
+      polling = true
+      refresh()
+    }
+  }
+
+  function armWakeGuard() {
+    wakeGuardUntil = Date.now() + wakeGuardMs
+  }
+
+  // Whether a touch that starts now only wakes the screen; a dark one is
+  // lit through the lock, as any touch on the lock lights it.
+  function wakeTouch() {
+    if (lock.displayDark) {
+      armWakeGuard()
+      lock.wakeRequested()
+      return true
+    }
+    return Date.now() < wakeGuardUntil
+  }
+
+  function refresh() {
+    if (active && !notificationsProc.running) notificationsProc.running = true
+  }
+
+  function refit() {
+    var avail = cardsArea.height
+    var gap = cardsColumn.spacing
+    var moreHeight = moreLabel.implicitHeight + gap
+    var used = 0
+    var n = 0
+    for (var i = 0; i < cardsRepeater.count; i++) {
+      var item = cardsRepeater.itemAt(i)
+      if (!item) break
+      var h = item.implicitHeight + (n > 0 ? gap : 0)
+      var needMore = i + 1 < cards.length
+      if (used + h + (needMore ? moreHeight : 0) > avail) break
+      used += h
+      n++
+    }
+    fitCount = n
+  }
+
+  onShownCardsChanged: Qt.callLater(refit)
+
+  // A card swiped off its side: that one notification is forgotten through
+  // the notifications service's forget call (omamobile-omarchy patch 0019),
+  // the call the phone's shade makes, so it leaves the toasts, the history
+  // and the shade too. Nothing of the notification runs.
+  property var forgetQueue: []
+  function dismiss(file) {
+    if (!file || dismissed[file]) return
+    var marks = {}
+    for (var k in dismissed) marks[k] = dismissed[k]
+    marks[file] = Date.now()
+    dismissed = marks
+    forgetQueue = forgetQueue.concat([file])
+    noteActivity()
+    Qt.callLater(runForget)
+  }
+
+  function runForget() {
+    if (forgetProc.running || forgetQueue.length === 0) return
+    forgetProc.command = ["sh", "-c",
+      "dir=$1; shift; for name; do qs ipc -p \"$dir\" call notifications forget \"$name\"; done; exit 0",
+      "sh", Quickshell.shellDir].concat(forgetQueue)
+    forgetQueue = []
+    forgetProc.running = true
+  }
+
+  function pruneDismissed(raw) {
+    var present = Glance.fileNames(raw)
+    var marks = {}
+    var any = false
+    for (var k in dismissed) {
+      if (!present[k]) continue
+      if (Date.now() - dismissed[k] > 15000) continue
+      marks[k] = dismissed[k]
+      any = true
+    }
+    dismissed = any ? marks : ({})
+  }
+
+  function toggleCard(file) {
+    var next = {}
+    for (var k in expanded) next[k] = expanded[k]
+    if (next[file]) delete next[file]
+    else next[file] = true
+    expanded = next
+    noteActivity()
+  }
+
+  // The card under a point of the glance, or null.
+  function cardAt(item, x, y) {
+    for (var i = 0; i < cardsRepeater.count; i++) {
+      var card = cardsRepeater.itemAt(i)
+      if (!card || !card.visible) continue
+      var p = item.mapToItem(card, x, y)
+      if (p.x >= 0 && p.y >= 0 && p.x <= card.width && p.y <= card.height) return card
+    }
+    return null
+  }
+  onHeightChanged: Qt.callLater(refit)
+
+  // A typed key on the glance moves to the PIN view and keeps the key: a
+  // digit (or, for a password, any character) goes into the field.
+  Keys.onPressed: function(event) {
+    if (!showing) return
+    var t = event.text
+    var printable = t.length === 1 && t.charCodeAt(0) >= 32 && !(event.modifiers & Qt.ControlModifier)
+    if (printable && lock.inputEnabled && !lock.authenticatingPassword
+        && (!lock.padShown || (t >= "0" && t <= "9"))) {
+      if (lock.failureMessage.length > 0) lock.clearFailureRequested()
+      lock.passwordTextEdited(lock.passwordText + t)
+    } else if (!printable && event.key !== Qt.Key_Return && event.key !== Qt.Key_Enter
+               && event.key !== Qt.Key_Up && event.key !== Qt.Key_Space) {
+      return
+    }
+    reveal()
+    event.accepted = true
+  }
+
+  Connections {
+    target: glance.lock
+    enabled: glance.active
+    function onInputEnabledChanged() { if (glance.lock.inputEnabled) glance.show() }
+    function onWakeSerialChanged() { glance.armWakeGuard(); glance.show() }
+    function onBlankSerialChanged() { glance.show() }
+    function onDisplayDarkChanged() { if (!glance.lock.displayDark) glance.armWakeGuard() }
+    function onWakeRequested() { glance.noteActivity() }
+    // Text that reaches the field another way still shows the PIN view.
+    function onPasswordTextChanged() { if (glance.showing && glance.lock.passwordText.length > 0) glance.reveal() }
+  }
+
+  Component.onCompleted: if (active) { refresh(); Qt.callLater(function() { if (glance.showing) glance.forceActiveFocus() }) }
+  onActiveChanged: if (active) refresh()
+
+  // Back to the glance after 15 s on the PIN view with nothing typed,
+  // counted on the wall clock as the lock's blank timer is: a countdown
+  // frozen by sleep would otherwise pick up where it stopped after resume.
+  Timer {
+    id: idleTimer
+    objectName: "lockGlanceIdle"
+    property int returnAfter: 15000
+    // When the PIN view last had input, or the countdown began.
+    property double since: 0
+    interval: 1000
+    repeat: true
+    running: glance.active && !glance.shown && glance.lock.passwordText.length === 0 && !glance.lock.authenticatingPassword
+    onRunningChanged: if (running) since = Date.now()
+    onTriggered: {
+      if (!(since > 0)) since = Date.now()
+      else if (Date.now() - since >= returnAfter) glance.show()
+    }
+  }
+
+  // The notification files have no change signal to watch, so they are read
+  // again every few seconds while the lock is in use, and not while it sits
+  // dark: the lock blanks the screen 10 s after the last input.
+  Timer {
+    id: pollTimer
+    interval: 5000
+    repeat: true
+    running: glance.active && glance.polling
+    onTriggered: {
+      if (Date.now() - glance.lastActivity > 20000) glance.polling = false
+      else glance.refresh()
+    }
+  }
+
+  SystemClock {
+    id: clock
+    precision: SystemClock.Minutes
+  }
+
+  Process {
+    id: notificationsProc
+    command: ["bash", "-c", "shopt -s nullglob; set -- \"$1\"*.json \"$1\"history/*.json; (($#)) && awk 1 \"$@\" 2>/dev/null; true",
+              "--", glance.home + "/.local/state/omarchy/notifications/"]
+    stdout: StdioCollector {
+      waitForEnd: true
+      onStreamFinished: {
+        glance.notificationsRaw = String(text || "")
+        glance.pruneDismissed(glance.notificationsRaw)
+      }
+    }
+  }
+
+  Process {
+    id: forgetProc
+    onExited: {
+      glance.runForget()
+      glance.refresh()
+    }
+  }
+
+  FileView {
+    path: glance.active ? glance.home + "/.local/state/omarchy/toggles/lock-hide-notification-text" : ""
+    watchChanges: true
+    printErrors: false
+    onLoaded: glance.hideText = true
+    onLoadFailed: glance.hideText = false
+    onFileChanged: reload()
+  }
+
+  FileView {
+    path: glance.active ? glance.home + "/.local/state/omarchy/notifications.json" : ""
+    watchChanges: true
+    printErrors: false
+    onLoaded: glance.doNotDisturb = Glance.doNotDisturb(text())
+    onLoadFailed: glance.doNotDisturb = false
+    onFileChanged: reload()
+  }
+
+  FileView {
+    path: glance.active ? glance.home + "/.local/state/omamobile/weather.json" : ""
+    watchChanges: true
+    printErrors: false
+    onLoaded: glance.weatherRaw = text()
+    onLoadFailed: glance.weatherRaw = ""
+    onFileChanged: reload()
+  }
+
+  FileView {
+    path: glance.active ? glance.home + "/.config/omarchy/shell.json" : ""
+    watchChanges: true
+    printErrors: false
+    onLoaded: {
+      try {
+        var shell = JSON.parse(text() || "{}")
+        glance.barClockFormat = shell.bar && shell.bar.clockFormat ? String(shell.bar.clockFormat) : ""
+      } catch (e) { glance.barClockFormat = "" }
+    }
+    onLoadFailed: glance.barClockFormat = ""
+    onFileChanged: reload()
+  }
+
+  // ---------------------------------------------------------------- PIN view
+
+  // The time, small, above the PIN view's hint or field.
+  Text {
+    id: pinClock
+    objectName: "lockPinClock"
+    textFormat: Text.PlainText
+    anchors.horizontalCenter: parent.horizontalCenter
+    y: Math.max(Style.space(24), glance.pinTop - Style.space(22) - height)
+    visible: glance.progress < 1
+    opacity: 1 - glance.progress
+    text: Qt.formatDateTime(clock.date, Glance.timeFormat(glance.twelveHour, true))
+    color: Commons.Color.lock.text
+    font.family: Style.font.family
+    font.pixelSize: Style.font.display
+  }
+
+  // ---------------------------------------------------------------- glance
+
+  Item {
+    id: glanceLayer
+    objectName: "lockGlanceView"
+    anchors.fill: parent
+    visible: glance.progress > 0
+    enabled: glance.showing
+    opacity: glance.progress
+
+    Item {
+      id: content
+      anchors.fill: parent
+      // Follows a swipe a little, and rises as the PIN view comes in.
+      transform: Translate {
+        y: Math.min(0, swipe.dragY) * 0.4 - Style.space(40) * (1 - glance.progress)
+      }
+
+      Column {
+        id: header
+        anchors.horizontalCenter: parent.horizontalCenter
+        y: Math.round(parent.height * 0.113)
+        width: Math.min(Style.space(380), parent.width - Style.space(32))
+        spacing: 0
+
+        Text {
+          id: timeLabel
+          objectName: "lockGlanceTime"
+          width: parent.width
+          horizontalAlignment: Text.AlignHCenter
+          textFormat: Text.PlainText
+          text: Qt.formatDateTime(clock.date, Glance.timeFormat(glance.twelveHour, false))
+          color: Commons.Color.lock.text
+          font.family: Style.font.family
+          font.weight: Font.Light
+          font.pixelSize: Math.round(Style.font.displayLarge * 3.7)
+          fontSizeMode: Text.HorizontalFit
+          minimumPixelSize: Style.font.display
+        }
+
+        Text {
+          objectName: "lockGlanceDate"
+          width: parent.width
+          topPadding: Style.space(14)
+          horizontalAlignment: Text.AlignHCenter
+          textFormat: Text.PlainText
+          text: Qt.formatDate(clock.date, "dddd, MMMM d")
+          color: Commons.Color.lock.text
+          font.family: Style.font.family
+          font.pixelSize: Style.font.heading
+          elide: Text.ElideRight
+        }
+
+        Text {
+          objectName: "lockGlanceWeather"
+          width: parent.width
+          topPadding: Style.space(6)
+          visible: glance.weatherText.length > 0
+          horizontalAlignment: Text.AlignHCenter
+          textFormat: Text.PlainText
+          text: glance.weatherText
+          color: Commons.Color.lock.placeholder
+          font.family: Style.font.family
+          font.pixelSize: Style.font.title
+          elide: Text.ElideRight
+        }
+      }
+
+      // Between the header and the hint; the cards that don't fit fold
+      // into the "more" line.
+      Item {
+        id: cardsArea
+        anchors.horizontalCenter: parent.horizontalCenter
+        y: header.y + header.height + Style.space(40)
+        width: header.width
+        height: Math.max(0, hint.y - Style.space(24) - y)
+        onHeightChanged: Qt.callLater(glance.refit)
+
+        Column {
+          id: cardsColumn
+          objectName: "lockGlanceCards"
+          width: parent.width
+          spacing: Style.space(10)
+
+          Repeater {
+            id: cardsRepeater
+            model: glance.shownCards
+
+            NotificationCard {
+              required property var modelData
+              required property int index
+              objectName: "lockGlanceCard"
+              width: cardsColumn.width
+              visible: index < glance.fitCount
+              app: modelData.app
+              appIcon: modelData.appIcon
+              image: modelData.image
+              glyph: modelData.glyph
+              urgency: modelData.urgency
+              timestamp: modelData.timestamp
+              summary: modelData.summary
+              body: modelData.body
+              detail: modelData.detail
+              readonly property bool open: !!glance.expanded[modelData.file]
+              summaryLines: open ? 2 : 1
+              bodyLines: open ? 4 : 1
+              cornerRadius: Style.cornerRadius
+              fontFamily: Style.font.family
+              swipeEnabled: false
+              closeButtonShown: false
+              // No actions from the lock: a tap opens or closes the card
+              // (the glance's touch area below does it; this is the same
+              // for a click that reaches the card), and a card swiped off
+              // its side (the touch area moves it, the card's own
+              // finishSwipe from patch 0017 decides) is forgotten.
+              onCardClicked: glance.toggleCard(modelData.file)
+              onCloseRequested: glance.dismiss(modelData.file)
+              onImplicitHeightChanged: Qt.callLater(glance.refit)
+            }
+          }
+
+          Text {
+            id: moreLabel
+            objectName: "lockGlanceMore"
+            width: parent.width
+            visible: glance.moreText.length > 0
+            topPadding: Style.space(2)
+            horizontalAlignment: Text.AlignHCenter
+            textFormat: Text.PlainText
+            text: glance.moreText
+            color: Commons.Color.lock.placeholder
+            font.family: Style.font.family
+            font.pixelSize: Style.font.subtitle
+            elide: Text.ElideRight
+          }
+
+          Text {
+            objectName: "lockGlanceQuiet"
+            width: parent.width
+            visible: glance.cards.length === 0
+            horizontalAlignment: Text.AlignHCenter
+            textFormat: Text.PlainText
+            text: "No new notifications"
+            color: Commons.Color.lock.placeholder
+            font.family: Style.font.family
+            font.pixelSize: Style.font.title
+          }
+        }
+      }
+
+      Text {
+        id: hint
+        objectName: "lockGlanceHint"
+        anchors.horizontalCenter: parent.horizontalCenter
+        width: parent.width - Style.space(32)
+        // Where the PIN view has its emergency call: above the sensor's
+        // fingerprint mark, or near the bottom without fingerprints.
+        y: glance.lock && glance.lock.keypadClearsSensor ? glance.sensorTop + Style.space(26)
+          : parent.height - (glance.lock ? glance.lock.keypadBottomMargin : 0) - height
+        textFormat: Text.PlainText
+        text: glance.lock && glance.lock.fingerprintConfigured ? "Touch the fingerprint sensor or swipe up" : "Swipe up to unlock"
+        color: Commons.Color.lock.text
+        font.family: Style.font.family
+        font.pixelSize: Style.font.subtitle
+        wrapMode: Text.WordWrap
+        horizontalAlignment: Text.AlignHCenter
+      }
+    }
+
+    // Over everything, cards included. The first 12 px of a drag decide its
+    // way: mostly sideways on a card swipes that card (off its side, past
+    // 35 % or a flick, dismisses it); mostly vertical is the swipe up to the
+    // PIN view (a clear drag, 8 % of the height, or a quick flick), from a
+    // card too. A tap on a card opens or closes it, a tap anywhere else does
+    // nothing, and a touch that wakes a dark screen only wakes it.
+    MouseArea {
+      id: swipe
+      objectName: "lockGlanceSwipe"
+      anchors.fill: parent
+      property real startY: 0
+      property real startX: 0
+      property double startAt: 0
+      property real dragY: 0
+      // This touch woke the screen (glance.wakeTouch): it does nothing else.
+      property bool wakeOnly: false
+      // "", "x" (a card swipe) or "y" (toward the PIN view), from the first
+      // 12 px of movement.
+      property string axis: ""
+      property var swipeCard: null
+      property real lastX: 0
+      property double lastAt: 0
+      property real velocityX: 0
+      onPressed: function(mouse) {
+        wakeOnly = glance.wakeTouch()
+        startY = mouse.y
+        startX = mouse.x
+        startAt = Date.now()
+        lastX = mouse.x
+        lastAt = startAt
+        velocityX = 0
+        dragY = 0
+        axis = ""
+        swipeCard = null
+      }
+      onPositionChanged: function(mouse) {
+        if (wakeOnly) return
+        var dx = mouse.x - startX
+        var dy = mouse.y - startY
+        if (!axis && Math.max(Math.abs(dx), Math.abs(dy)) >= Style.space(12)) {
+          axis = Math.abs(dx) > Math.abs(dy) ? "x" : "y"
+          if (axis === "x") {
+            var card = glance.cardAt(swipe, startX, startY)
+            swipeCard = card && !card.dismissing ? card : null
+          }
+        }
+        if (axis === "y") dragY = dy
+        if (axis === "x" && swipeCard) {
+          var t = Date.now()
+          if (t > lastAt) velocityX = (mouse.x - lastX) * 1000 / (t - lastAt)
+          lastX = mouse.x
+          lastAt = t
+          swipeCard.swipeOffset = dx
+          swipeCard.swipeVelocity = velocityX
+        }
+      }
+      onReleased: function(mouse) {
+        var moved = mouse.y - startY
+        dragY = 0
+        if (wakeOnly) {
+          wakeOnly = false
+          return
+        }
+        if (axis === "x") {
+          if (swipeCard) swipeCard.finishSwipe()
+          swipeCard = null
+          return
+        }
+        var quick = Date.now() - startAt < 300 && moved < -Style.space(24)
+        if (axis === "y" && (moved < -glance.height * 0.08 || quick)) {
+          glance.reveal()
+          return
+        }
+        if (Math.abs(moved) < Style.space(12) && Math.abs(mouse.x - startX) < Style.space(12)) {
+          var card = glance.cardAt(swipe, mouse.x, mouse.y)
+          if (card) glance.toggleCard(card.modelData.file)
+        }
+      }
+      onCanceled: {
+        dragY = 0
+        wakeOnly = false
+        if (swipeCard) {
+          swipeCard.swipeVelocity = 0
+          swipeCard.swipeOffset = 0
+        }
+        swipeCard = null
+      }
+    }
+  }
+}
