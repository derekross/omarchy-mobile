# Port mobileglance to4.5auth/wake fields without changing authcapabilities.
# Retain licensed4.0.6 standaloneNotificationCard/NotificationLogic API for
# privatepixel.lock too; parse4.5compactlive/history arrays into legacyreadrows,
# preserve stablekeys forIPCforget and readDNDfromquiet.json. No actions/network.
#4.5Toast is a different scene-boundtype, not a compatibleglance replacement.

--- /dev/null
+++ w/shell/plugins/lock/LockGlance.js
@@ -0,0 +1,164 @@
+.pragma library
+.import "../notifications/NotificationLogic.js" as NotificationLogic
+
+// What the phone's lock shows at a glance (LockGlance.qml): the clock's
+// 12- or 24-hour choice, the notifications grouped by app, and the weather
+// line. Plain functions of their inputs, so the test can drive them.
+
+// Up to this many notifications get a card; the rest fold into one line.
+var MAX_CARDS = 3
+// The notifications the lock sums up are the ones the phone's notification
+// shade lists: the newest ten of the toasts on screen and the history,
+// which the notifications service trims to ten (historyLimit), with no age
+// limit and no app left out.
+var SHADE_LIMIT = 10
+// NotificationUrgency.Critical, for the do-not-disturb rule.
+var CRITICAL = 2
+// A weather reading older than this is not shown.
+var WEATHER_MAX_AGE_MS = 3 * 60 * 60 * 1000
+
+// The bar's own default time format (omamobile-shell's bar, without a
+// clockFormat): the lock's clock agrees with it.
+var BAR_DEFAULT_FORMAT = "HH:mm"
+
+// 12- or 24-hour, decided as the phone bar and the home screen's clock decide
+// (omamobile-shell, HomeModel.systemTimeFormat) from the bar's clockFormat
+// (shell.json bar.clockFormat): quoted literals ignored, an AM/PM marker or
+// "h" without "H" means 12-hour. Without one, the bar's default (24-hour),
+// never the session's Qt locale, which is C/POSIX for the shell.
+function twelveHour(barFormat) {
+  var f = String(barFormat || BAR_DEFAULT_FORMAT).replace(/'[^']*'/g, "")
+  return /a/i.test(f) || (/h/.test(f) && !/H/.test(f))
+}
+
+// The bar's clockFormat from shell.json's text: "" when it has none, null
+// when the text can't be read (a write caught half done), which keeps the
+// last one.
+function barClockFormat(text) {
+  var shell
+  try { shell = JSON.parse(String(text || "")) } catch (e) { return null }
+  if (!shell || typeof shell !== "object") return null
+  return shell.bar && shell.bar.clockFormat ? String(shell.bar.clockFormat) : ""
+}
+
+// The small clock over the PIN view: a Qt format, with AM/PM in 12-hour.
+function timeFormat(twelve) {
+  return twelve ? "h:mm AP" : "HH:mm"
+}
+
+// The large glance time, without AM/PM. Built here, not as the Qt format
+// "h:mm": without an AM/PM marker in the same format Qt counts "h" from 0
+// to 23, so a 12-hour bar got a 24-hour lock ("14:02").
+function glanceTime(date, twelve) {
+  var d = date instanceof Date ? date : new Date(date)
+  var h = d.getHours()
+  var mm = (d.getMinutes() < 10 ? "0" : "") + d.getMinutes()
+  if (twelve) return (h % 12 || 12) + ":" + mm
+  return (h < 10 ? "0" : "") + h + ":" + mm
+}
+
+function age(timestamp, now) {
+  var minutes = Math.floor(Math.max(0, Number(now) - Number(timestamp || 0)) / 60000)
+  if (minutes < 1) return "now"
+  if (minutes < 60) return minutes + "m"
+  return Math.floor(minutes / 60) + "h"
+}
+
+
+// The name a card goes by: Omarchy's own messages (omarchy-action)
+// as Omarchy, a bare notify-send or a nameless sender as Notifications.
+function appName(app) {
+  var name = String(app || "").trim()
+  if (name === "omarchy-action") return "Omarchy"
+  if (!name || name === "notify-send") return "Notifications"
+  return name
+}
+
+// The shade's rows (see SHADE_LIMIT; a row with neither summary nor body is
+// skipped, as there) from the persisted popup and history files (the
+// notifications plugin's state, one JSON line each, read together).
+function shadeRows(raw) {
+  var rows = NotificationLogic.historyRows(raw, [], 1, 1000)
+  var out = []
+  for (var i = 0; i < rows.length && out.length < SHADE_LIMIT; i++) {
+    var e = rows[i]
+    if (!String(e.summary || "").trim() && !String(e.body || "").trim()) continue
+    out.push(e)
+  }
+  return out
+}
+
+// The file names (NotificationLogic.popupFileName) of every notification
+// the files hold, as a set.
+function fileNames(raw) {
+  var rows = NotificationLogic.historyRows(raw, [], 1, 1000)
+  var out = {}
+  for (var i = 0; i < rows.length; i++) out[NotificationLogic.popupFileName(rows[i])] = true
+  return out
+}
+
+// Those rows as cards, one per notification, newest first. While
+// do-not-disturb is on, only what would still toast: Omarchy's own
+// messages, and a critical notify-send (NotificationLogic.shouldBypassDnd).
+// hideText shows the app name and "Unlock to read" instead of the text, and
+// no sender picture. The detail beside the summary is the age ("2m").
+function cards(raw, now, hideText, dnd) {
+  var rows = shadeRows(raw)
+  var out = []
+  for (var i = 0; i < rows.length; i++) {
+    var e = rows[i]
+    if (dnd && !NotificationLogic.shouldBypassDnd({ appName: e.app, urgency: e.urgency }, CRITICAL)) continue
+    var name = appName(e.app)
+    out.push({
+      app: name,
+      appIcon: e.appIcon,
+      image: hideText ? "" : e.image,
+      glyph: e.glyph,
+      urgency: e.urgency,
+      timestamp: e.timestamp,
+      summary: hideText ? name : (String(e.summary || "").trim() || name),
+      body: hideText ? "Unlock to read" : NotificationLogic.sanitizeBody(e.body, e.app, e.appIcon),
+      detail: age(e.timestamp, now),
+      file: NotificationLogic.popupFileName(e)
+    })
+  }
+  return out
+}
+
+// The line under the cards for the notifications without one: "5 more from
+// Mail and GitHub", "5 more from Mail, GitHub and 2 others", each app named
+// once, newest first.
+function moreText(rest) {
+  if (!rest || rest.length === 0) return ""
+  var names = []
+  for (var i = 0; i < rest.length; i++) {
+    var app = String(rest[i].app || "")
+    if (app && names.indexOf(app) < 0) names.push(app)
+  }
+  if (names.length === 0) return rest.length + " more"
+  var from = names.length <= 2 ? names.join(" and ")
+    : names.slice(0, 2).join(", ") + " and " + (names.length - 2) + (names.length === 3 ? " other" : " others")
+  return rest.length + " more from " + from
+}
+
+// notifications.json's do-not-disturb flag: silenced notifications make no
+// toast, so the lock shows only what still toasts (cards).
+function doNotDisturb(raw) {
+  var parsed = NotificationLogic.parseSettings(raw)
+  return parsed.dnd === true
+}
+
+// The home screen weather widget's last reading, which omamobile-shell
+// keeps in ~/.local/state/omamobile/weather.json:
+//   {"at": <ms since epoch>, "temperature": 12, "unit": "°C", "text": "Partly cloudy"}
+// Shown as "12°, partly cloudy"; nothing when absent, unreadable or older
+// than WEATHER_MAX_AGE_MS. The lock itself never asks the network.
+function weatherLine(raw, now) {
+  var w
+  try { w = JSON.parse(String(raw || "")) } catch (e) { return "" }
+  if (!w || typeof w.temperature !== "number" || !isFinite(w.temperature)) return ""
+  var at = Number(w.at || 0)
+  if (!(at > 0) || Number(now) - at > WEATHER_MAX_AGE_MS || at - Number(now) > 5 * 60 * 1000) return ""
+  var text = String(w.text || "").trim()
+  return Math.round(w.temperature) + "°" + (text ? ", " + text.charAt(0).toLowerCase() + text.slice(1) : "")
+}
