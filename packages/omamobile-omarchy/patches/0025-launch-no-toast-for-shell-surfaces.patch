# SPDX-License-Identifier: MIT
# App launch: no "Launching ..." toast for a desktop entry that runs
# omarchy-shell. Such an entry opens a shell surface (on the phone the
# Updates entry summons the update sheet), never a toplevel, so the toast
# waited for a window that never came and sat over the sheet's buttons
# until its timeout. Every other launch keeps the toast. Candidate for
# upstream Omarchy.
#
# Omarchy 4.5: Suppress the launch toast for shell surfaces while retaining terminal-app
# launch routing.

diff --git i/shell/services/AppLibrary.qml w/shell/services/AppLibrary.qml
--- i/shell/services/AppLibrary.qml
+++ w/shell/services/AppLibrary.qml
@@ -74,10 +74,16 @@
     if (!iconIndexScan.running) iconIndexScan.running = true
   }
 
+  function launchesShellSurface(id) {
+    var entry = DesktopEntries.byId(id)
+    var command = entry && entry.command ? entry.command : []
+    return command.length > 0 && String(command[0]).replace(/^.*\//, "") === "omarchy-shell"
+  }
+
   function launch(desktopId, name) {
     var id = String(desktopId || "")
     if (!id) return
-    root.beginLaunchFeedback(name)
+    if (!root.launchesShellSurface(id)) root.beginLaunchFeedback(name)
     // A terminal app goes through Omarchy's TUI launcher, which names its
     // terminal window after the command (org.omarchy.nvim), so the dock and
     // titlebars can tell Neovim from the terminal it runs in.
