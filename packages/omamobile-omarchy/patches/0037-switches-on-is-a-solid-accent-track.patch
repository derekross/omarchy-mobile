# Switches: on is a solid accent track, as on a phone. Omarchy's switch told
# on from off by the knob's side and a faint change of fill (the selected
# tint against the normal one), and in a light theme (catppuccin-latte on
# the palmtop) the two fills look nearly the same, so the owner couldn't
# tell whether a card's switch was on. On now fills the track with the
# theme's accent and gives the knob the theme's background, which stands
# out on it; off keeps the muted fill and knob. Size, animation and the
# cursor ring are as before. Every switch built on Ui/ToggleSwitch changes
# with it (Toggle's rows and the cards' header switches).
#
# Against Omarchy 4.5.0 (4.5.0-3).
diff --git i/shell/Ui/ToggleSwitch.qml w/shell/Ui/ToggleSwitch.qml
--- i/shell/Ui/ToggleSwitch.qml
+++ w/shell/Ui/ToggleSwitch.qml
@@ -46,6 +46,7 @@ Item {
   property bool rounded: Style.cornerRadius > 0
   property color foreground: Commons.Color.foreground
   property color accent: Commons.Color.accent
+  property color knobOnColor: Commons.Color.background
 
   signal toggled()
   signal hovered(bool isHovered)
@@ -83,8 +84,10 @@ Item {
     height: root.trackHeight
     anchors.centerIn: parent
     radius: root.rounded ? height / 2 : 0
+    // On is the accent, solid, as on a phone: the selected tint alone was
+    // too close to the off fill to read in a light theme.
     color: root.checked
-      ? Style.selectedFillFor(root.foreground, root.accent)
+      ? root.accent
       : Style.normalFillFor(root.foreground, root.accent)
     borderSpec: Border.controlSpec(root.checked ? "selected" : "normal", root.foreground, root.accent)
 
@@ -96,7 +99,8 @@ Item {
       radius: root.rounded ? height / 2 : 0
       x: root.checked !== root.mirrored ? track.width - width - root.knobInset : root.knobInset
       anchors.verticalCenter: parent.verticalCenter
-      color: root.checked ? Style.selectedStateColor(root.foreground, root.accent) : Qt.darker(root.foreground, 1.25)
+      // The theme's background on the accent, so the knob stands out on it.
+      color: root.checked ? root.knobOnColor : Qt.darker(root.foreground, 1.25)
 
       Behavior on x { NumberAnimation { duration: Style.duration(120); easing.type: Easing.OutCubic } }
       Behavior on color { ColorAnimation { duration: Style.duration(120) } }
