# SPDX-License-Identifier: MIT
# Port menu Back/swipe to4.5FilterInput without covering inputmethod commits.
# Touch-only swipe,44px Back target, root/dmenu/confirmation/scroll guards.

diff --git i/shell/plugins/menu/Menu.qml w/shell/plugins/menu/Menu.qml
--- i/shell/plugins/menu/Menu.qml
+++ w/shell/plugins/menu/Menu.qml
@@ -1317,6 +1317,51 @@
 
       MouseArea { anchors.fill: parent; onClicked: {} }
 
+      // Touch back: a swipe right on the card goes up a level, as Backspace
+      // does. Only sideways movement past the threshold starts it, so a
+      // tap still picks a row, and a list that is scrolling keeps the
+      // finger.
+      readonly property bool canGoBack: root.activeMenu !== "root" && !root.dmenuActive && !root.deleteConfirmOpen
+      property real swipeOffset: 0
+      property real swipeVelocity: 0
+      transform: Translate { x: card.swipeOffset }
+
+      DragHandler {
+        id: backSwipe
+        target: null
+        acceptedDevices: PointerDevice.TouchScreen
+        yAxis.enabled: false
+        dragThreshold: Style.space(12)
+        enabled: card.canGoBack && !resultList.moving
+        onActiveChanged: {
+          if (active) {
+            backSwipeSettle.stop()
+            card.swipeVelocity = 0
+            return
+          }
+          // The finger's travel (the card follows at half speed).
+          var distance = card.swipeOffset * 2
+          var flung = card.swipeVelocity >= Style.space(900) && distance >= Style.space(24)
+          if (card.canGoBack && !resultList.moving && (distance >= Math.max(Style.space(64), card.width * 0.25) || flung)) root.goBack()
+          backSwipeSettle.restart()
+        }
+        onActiveTranslationChanged: {
+          if (!active) return
+          // The card follows the finger at half speed, and only rightwards.
+          card.swipeOffset = Math.max(0, activeTranslation.x) / 2
+          card.swipeVelocity = centroid.velocity.x
+        }
+      }
+
+      NumberAnimation {
+        id: backSwipeSettle
+        target: card
+        property: "swipeOffset"
+        to: 0
+        duration: 160
+        easing.type: Easing.OutCubic
+      }
+
       Item {
         id: keyCatcher
         anchors.fill: parent
@@ -1400,9 +1445,31 @@
           radius: root.cornerRadius
           color: "transparent"
 
+          MouseArea {
+            id: backButton
+            objectName: "menuBackButton"
+            visible: card.canGoBack
+            anchors.left: parent.left
+            anchors.verticalCenter: parent.verticalCenter
+            width: Style.space(44)
+            height: Math.max(parent.height, Style.space(44))
+            z: 2
+            Accessible.role: Accessible.Button
+            Accessible.name: "Back"
+            onClicked: root.goBack()
+            Text {
+              anchors.centerIn: parent
+              text: "‹"
+              textFormat: Text.PlainText
+              color: root.foreground
+              font.pixelSize: Style.font.heading
+            }
+          }
+
           FilterInput {
             id: filterInput
             anchors.left: parent.left
+            anchors.leftMargin: backButton.visible ? backButton.width : 0
             anchors.right: parent.right
             anchors.verticalCenter: parent.verticalCenter
             keyHandler: keyCatcher
