# Touch screens: swipe through the image picker (backgrounds, themes), fit it
# to a narrow screen, and hold the desktop for the Style menu (there is no
# right button or keyboard shortcut on a phone).
#
# Omarchy 4.5 port: 4.5 renamed the menu's "style" route to "appearance"
# ("style" stays an alias), so the hold summons "appearance" by its id. The
# swipe follows 4.5's right-to-left reading (Util.readingKey flips the arrow
# keys; the swipe flips the same way) and waits for the picker's reveal
# (layoutSettled), as 4.5's keys do. 4.5's hold-to-preview (PreviewHold) is
# a separate handler and untouched.

diff --git i/shell/plugins/background/Background.qml w/shell/plugins/background/Background.qml
--- i/shell/plugins/background/Background.qml
+++ w/shell/plugins/background/Background.qml
@@ -218,6 +218,17 @@
     if (!bgSwitchProc.running) bgSwitchProc.running = true
   }
 
+  // Touch screens: hold the desktop for the Appearance menu (4.0's "style"
+  // route; a phone has no right button or keyboard shortcut).
+  function openStyleMenu() {
+    if (!styleMenuProc.running) styleMenuProc.running = true
+  }
+
+  Process {
+    id: styleMenuProc
+    command: ["omarchy-menu", "summon", "appearance"]
+  }
+
   function openThemeSwitcher() {
     var payload = JSON.stringify({ source: "themes" })
 
@@ -521,6 +532,10 @@
       MouseArea {
         anchors.fill: parent
         acceptedButtons: Qt.LeftButton | Qt.RightButton
+        onPressAndHold: function(mouse) {
+          root.openStyleMenu()
+          mouse.accepted = true
+        }
         onDoubleClicked: function(mouse) {
           if (mouse.button === Qt.RightButton) root.openThemeSwitcher()
           else root.openSelector()
diff --git i/shell/plugins/image-picker/ImagePicker.qml w/shell/plugins/image-picker/ImagePicker.qml
