+  // Fit narrow screens (phones): never wider than the window allows.
+  property int expandedWidth: panel.width > 0 ? Math.min(768, panel.width - 96) : 768
+  property int expandedHeight: Math.round(475 * expandedWidth / 768)
   property int sliceWidth: 108
-  property int sliceHeight: 432
+  property int sliceHeight: Math.round(432 * expandedWidth / 768)
   property int sliceSpacing: -30
   property int skewOffset: 28
   property int bottomChromeHeight: showLabels ? (filterable ? 104 : 74) : (filterable ? 60 : 30)
@@ -728,6 +729,25 @@
 
           Component.onCompleted: forceActiveFocus()
 
+          // Swipe to move through the images on touch screens: toward the
+          // reading start for the next one, as the arrow keys read.
+          DragHandler {
+            target: null
+            yAxis.enabled: false
+            enabled: root.layoutSettled
+            property real swipeX: 0
+            onActiveTranslationChanged: swipeX = activeTranslation.x
+            onActiveChanged: {
+              if (active) {
+                swipeX = 0
+              } else if (Math.abs(swipeX) > 40) {
+                var next = swipeX < 0
+                if (Commons.I18n.rightToLeft) next = !next
+                root.selectAdjacent(next ? 1 : -1)
+              }
+            }
+          }
+
           Repeater {
             id: imageCards
             model: visibleImages
