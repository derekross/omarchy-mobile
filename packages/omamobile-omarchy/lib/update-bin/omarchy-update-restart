#!/bin/bash
# SPDX-License-Identifier: MIT
# Omarchy Mobile (on PATH only during omamobile-update): Omarchy's restart
# step without its questions. Omarchy decides "kernel updated" when no
# pacman-owned vmlinuz matches the running kernel; on the phone that test
# would always fire (a pushed kernel isn't a package, and a packaged one only
# runs once slot B holds it). The phone needs a restart when Omarchy asked for
# one, Hyprland was replaced, or linux-omamobile's hook (omamobile-boot-update)
# wrote slot B during this update; a kernel package it could not write is a
# warning. Services Omarchy marked are restarted and the shell too, as on a
# desktop. Nothing reboots here: the update sheet offers the restart.
#
# Omarchy 4.5 runs this step twice: --services-only after the migrations
# (the marked services and the shell), then --reboot-only at the very end
# (whether a restart is needed). Each does its half here too, so services
# and the shell restart once; a service that failed to restart in the first
# half is kept for the second's warnings. Without an argument (Omarchy 4.0)
# it does both, as before.
dir=${OMAMOBILE_UPDATE_DIR:-${XDG_RUNTIME_DIR:-/tmp}/omamobile-update}
out=$dir/restart.json
kept=$dir/restart-warnings
reasons=() warnings=()
services=1 verdict=1
case ${1:-} in
  --services-only) verdict=0 ;;
  --reboot-only) services=0 ;;
  "") ;;
  *) echo "omarchy-update-restart (phone): unknown option $1" >&2; exit 2 ;;
esac

if (( services )); then
  mkdir -p "$dir"
  : > "$kept"
  for file in "$HOME"/.local/state/omarchy/restart-*-required; do
    [[ -f $file ]] || continue
    name=${file##*/}
    service=${name#restart-}
    service=${service%-required}
    echo "Restarting $service"
    omarchy-state clear "$name" || rm -f "$file"
    "omarchy-restart-$service" || echo "Restarting $service failed" >> "$kept"
  done

  echo -e "\e[32m\nRestarting shell\e[0m"
  omarchy-restart-shell || true
fi
(( verdict )) || exit 0

modules=${OMAMOBILE_MODULES_DIR:-/usr/lib/modules}/$(uname -r)
[[ -d $modules ]] || warnings+=("No modules for the running kernel in $modules")

[[ -f $HOME/.local/state/omarchy/reboot-required ]] && reasons+=("Omarchy asked for a restart")

# The boot-update hook's result, when it ran during this update
boot_status=${OMAMOBILE_BOOT_UPDATE_STATUS:-/run/omamobile/boot-update.json}
if [[ -f $boot_status ]]; then
  boot=$(python3 -I - "$boot_status" "${OMAMOBILE_UPDATE_STARTED:-0}" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except (OSError, ValueError):
    sys.exit(0)
if int(d.get("time", 0)) < int(sys.argv[2] or 0):
    sys.exit(0)
msg = str(d.get("message", "")).replace("\n", " ").replace("\t", " ")
print("%s\x1f%s\x1f%s\x1f%s" % (d.get("result", ""), d.get("release", ""), "yes" if d.get("kernel_changed") else "no", msg))
PY
  ) || boot=""
  # A unit separator: tab is IFS white space, and an empty release would vanish
  IFS=$'\x1f' read -r boot_result boot_release boot_kernel boot_message <<<"$boot" || true
  case ${boot_result:-} in
    # kernel_changed: slot B now holds another release than the running
    # one; otherwise only the initramfs or the device tree changed
    written)
      if [[ ${boot_kernel:-} == yes ]]; then
        reasons+=("The kernel was updated (slot B now holds ${boot_release:-the new kernel})")
      else
        reasons+=("The boot images were updated (initramfs or device tree, kernel ${boot_release:-unchanged})")
      fi ;;
    refused|failed)
      warnings+=("The kernel package changed but slot B was not written (${boot_message:-see the pacman output}); fix that, then: sudo omamobile-boot-update write") ;;
  esac
fi

pid=$(pgrep -x Hyprland | head -1)
if [[ -n $pid ]] && [[ $(readlink "/proc/$pid/exe" 2>/dev/null) == *"(deleted)"* ]]; then
  reasons+=("Hyprland was updated")
fi

if [[ -s $kept ]]; then
  mapfile -t failed < "$kept"
  warnings+=("${failed[@]}")
fi
rm -f "$kept"

mkdir -p "$dir"
python3 -I - "$out" "${#reasons[@]}" "${reasons[@]}" "${warnings[@]}" <<'PY'
import json, sys
out, n = sys.argv[1], int(sys.argv[2])
rest = sys.argv[3:]
with open(out, "w") as f:
    json.dump({"needs_reboot": n > 0, "reasons": rest[:n], "warnings": rest[n:]}, f)
PY
if (( ${#reasons[@]} )); then
  echo "Restart the phone to finish: ${reasons[*]}"
fi
