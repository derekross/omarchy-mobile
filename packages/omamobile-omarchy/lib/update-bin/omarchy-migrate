#!/bin/bash
# SPDX-License-Identifier: MIT
# Omarchy Mobile (on PATH only during omamobile-update): Omarchy's migrations,
# minus the ones that touch what a phone doesn't have or must not change: the
# bootloader and boot entries (Limine, mkinitcpio, UKIs, efibootmgr, sbctl),
# Snapper, x86 kernels and drivers, fwupd, or that ask questions with gum.
# Also held: one that replaces /etc/pacman.conf wholesale (install, cp or mv
# onto it, or omarchy-refresh-pacman). 1791403252 moved [omarchy] above every
# other repository, [omamobile] included, then upgraded, so Omarchy's Hyprland
# replaced the phone's. Never run such a one by hand. Edits made some other
# way (sed, tee, a redirect) are caught after Omarchy's migrate returns: if
# [omamobile] is no longer the first repository, it is moved back to the top.
# A held migration is marked done in Omarchy's state (so Omarchy's login
# notice doesn't keep offering it) and listed in
# ~/.local/state/omamobile/update/held-migrations; after a review,
# omamobile-update run-migration <name> runs it. OMAMOBILE_HOLD_MIGRATIONS=0
# holds none of the generic desktop matches. Named mobile migrations and
# mobile-critical PAM/input/video matches remain held until reviewed/run
# individually.
real=${OMAMOBILE_REAL_BIN:-/usr/bin}/omarchy-migrate
case ${1:-} in
  --pending | --check | -h | --help) exec "$real" "$@" ;;
esac

pattern='limine|mkinitcpio|initcpio|efibootmgr|sbctl|snapper|grub-|bootctl|fwupd|/boot/|plymouth-set-default-theme|dracut|linux-omarchy|nvidia|gum (confirm|choose|input|write|filter|file)|(install|cp|mv) [^|;&]*[[:space:]]"?/etc/pacman\.conf"?[[:space:]]*($|[;&|])|omarchy-refresh-pacman|owedvideo|fcitx|omarchy-apply-lock|/etc/pam\.d/|system-sleep/fprintd'
# These releases contain concrete unreviewed phone regressions; a broad
# generic-hold override must not silently enable them.
mobile_pattern='omarchy-hyprland-titlebars|owedvideo|fcitx|omarchy-apply-lock|/etc/pam\.d/|system-sleep/fprintd'
# Not held: 1792648436.sh (4.5) removes the 4.0 notification engine's files
# (one per notification, history/, images/) and carries Do Not Disturb over.
# The 4.5 shell never reads them, the phone's shade reads the 4.5 store, and
# they hold old message text, so the phone runs it as a computer does.
mobile_hold_reason() {
  case $1 in
    1791403310.sh) echo 'installs titlebars pinned to a different Hyprland build' ;;
    1790042972.sh) echo 'adds a world clock to the bar (the phone has its own status bar)' ;;
    1789764927.sh) echo 'starts owedvideo (unreviewed mobile video pipeline)' ;;
    1791367434.sh) echo 'replaces input method with Fcitx defaults' ;;
    1791125650.sh) echo 'changes fprintd resume/stop lifecycle (preserve mobile PAM/claim policy)' ;;
  esac
}
# Only an explicit 0 disables generic holds; malformed values stay safe.
hold_generic=1
[[ ${OMAMOBILE_HOLD_MIGRATIONS:-1} == 0 ]] && hold_generic=0
{
  omarchy_path=${OMARCHY_PATH:-/usr/share/omarchy}
  state=${OMARCHY_MIGRATION_STATE:-$HOME/.local/state/omarchy/migrations}
  held=$HOME/.local/state/omamobile/update/held-migrations
  for file in "$omarchy_path"/migrations/*.sh; do
    [[ -f $file ]] || continue
    name=${file##*/}
    [[ -f $state/$name ]] && continue
    match=$(mobile_hold_reason "$name")
    reason=$match
    if [[ -z $match ]]; then
      match=$(grep -m1 -oE "$mobile_pattern" "$file" || true)
    fi
    if [[ -z $match && $hold_generic == 1 ]]; then
      match=$(grep -m1 -oE "$pattern" "$file" || true)
    fi
    [[ -n $match ]] || continue
    match=${match%%$'\n'*}
    title=$(sed -n '1s/^echo "\(.*\)"$/\1/p' "$file")
    mkdir -p "$state" "${held%/*}"
    touch "$state/$name"
    printf '%s\t%s\t%s\n' "$name" "$match" "${title:-}" >>"$held"
    [[ -n ${OMAMOBILE_UPDATE_DIR:-} ]] && printf '%s\t%s\t%s\n' "$name" "$match" "${title:-}" >>"$OMAMOBILE_UPDATE_DIR/held"
    [[ -n $reason ]] || reason="mentions $match"
    echo "Holding migration ${name%.sh}${title:+ ($title)}: $reason."
    if [[ $match == *pacman* ]]; then
      echo "  Don't run it by hand: it would put [omarchy] above [omamobile] again."
    else
      echo "  Review it, then: omamobile-update run-migration $name"
    fi
  done
}
rc=0
"$real" "$@" || rc=$?

conf=${OMAMOBILE_PACMAN_CONF:-/etc/pacman.conf}
first=$(sed -n 's/^[[:space:]]*\[\([^]]*\)\].*/\1/p' "$conf" 2>/dev/null | grep -vx options | head -1)
if [[ -n $first && $first != omamobile ]] && grep -c '^[[:space:]]*\[omamobile\]' "$conf" >/dev/null; then
  fixed=$(mktemp)
  awk '
    /^[[:space:]]*\[[^]]+\]/ {
      section = $0
      sub(/^[[:space:]]*\[/, "", section)
      sub(/\].*$/, "", section)
      if (section != "options") repositories = 1
    }
    !repositories { prefix = prefix $0 "\n"; next }
    section == "omamobile" { omamobile = omamobile $0 "\n"; next }
    { others = others $0 "\n" }
    END { printf "%s%s%s", prefix, omamobile, others }
  ' "$conf" >"$fixed"
  if sudo tee "$conf" <"$fixed" >/dev/null; then
    echo "A migration put [$first] above [omamobile] in $conf: moved [omamobile] back to the top."
    echo "  Packages installed since may be Omarchy's builds of the phone's own (hyprland, mesa): see docs/RELEASES.md 5.4."
  else
    echo "A migration put [$first] above [omamobile] in $conf, and it could not be moved back: see docs/RELEASES.md 5.4." >&2
    rc=1
  fi
  rm -f "$fixed"
fi
exit "$rc"
