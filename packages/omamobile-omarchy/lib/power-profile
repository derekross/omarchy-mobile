#!/bin/bash
# SPDX-License-Identifier: MIT
# Make the power card's profiles do something on a phone (#1027). With no
# P-state driver and no ACPI platform profile, power-profiles-daemon has
# nothing to drive: the placeholder it falls back to offers only Power-saver
# and Balanced and changes nothing. This package's drop-in starts the daemon
# with its fake driver, which offers all three and changes nothing either,
# and this follows the active profile and sets each cpufreq policy's limits:
#   power-saver  ceiling at the highest step at or below POWER_SAVER_PERCENT
#                of the cluster's top frequency (60 by default)
#   balanced     the cluster's full range
#   performance  floor at the highest step at or below PERFORMANCE_PERCENT of
#                the top (50 by default), ceiling at the top
# schedutil still picks the speed between them, and thermal limits still win.
# A phone is on Performance only when its owner picks it: Omarchy picks it on
# AC when it is offered and nothing is saved for that source, so
# omamobile-setup-user (omamobile-shell 0.2.162) saves Balanced for a source
# with nothing saved, at every login, before the session starts.
# A device whose own thermal guard writes the same files (the Pixel 8 Pro's
# omamobile-husky-thermal, #946) ships /usr/share/omamobile/power-profile-off
# in its device package: there this changes nothing, not even at restore,
# since a guard's cap lifted for one tick on a hot phone is what it guards
# against. The unit doesn't start there either.
#   power-profile watch          follow power-profiles-daemon (the service)
#   power-profile apply PROFILE  set the limits for PROFILE once
#   power-profile restore        give every cluster its full range back
# /etc/omamobile/power-profile.conf may set POWER_SAVER_PERCENT and
# PERFORMANCE_PERCENT (10-100).
set -euo pipefail
cpufreq=${OMAMOBILE_CPUFREQ:-/sys/devices/system/cpu/cpufreq}
conf=${OMAMOBILE_POWER_PROFILE_CONF:-/etc/omamobile/power-profile.conf}
off=${OMAMOBILE_POWER_PROFILE_OFF:-/usr/share/omamobile/power-profile-off}
bus=org.freedesktop.UPower.PowerProfiles
path=/org/freedesktop/UPower/PowerProfiles

# A whole percentage from the configuration, 10 to 100, or DEFAULT
setting() {
  local v=""
  [[ -r $conf ]] && v=$(sed -n "s/^$1=\([0-9]\{1,3\}\)[[:space:]]*\$/\1/p" "$conf" | tail -n1)
  if [[ -n $v ]] && (( 10#$v >= 10 && 10#$v <= 100 )); then echo $((10#$v)); else echo "$2"; fi
}
saver=$(setting POWER_SAVER_PERCENT 60)
performance=$(setting PERFORMANCE_PERCENT 50)

# The highest listed step at or below LIMIT; LIMIT itself if none is listed
step_below() {
  local limit=$1 list=$2 best=0 f
  for f in $list; do
    [[ $f =~ ^[0-9]+$ ]] || continue
    (( f <= limit && f > best )) && best=$f
  done
  (( best > 0 )) && echo "$best" || echo "$limit"
}

write() { # FILE VALUE
  [[ $(<"$1") == "$2" ]] && return 0
  echo "$2" > "$1" 2>/dev/null || echo "power-profile: ${1#"$cpufreq"/}: could not set $2" >&2
}

apply() {
  local profile=$1 p top bottom ceiling floor list
  for p in "$cpufreq"/policy*; do
    [[ -r $p/cpuinfo_max_freq && -r $p/cpuinfo_min_freq && -w $p/scaling_max_freq && -w $p/scaling_min_freq ]] || continue
    top=$(<"$p/cpuinfo_max_freq") bottom=$(<"$p/cpuinfo_min_freq")
    [[ $top =~ ^[0-9]+$ && $bottom =~ ^[0-9]+$ ]] || continue
    list=$(cat "$p/scaling_available_frequencies" 2>/dev/null || true)
    ceiling=$top floor=$bottom
    case $profile in
      power-saver) ceiling=$(step_below $((top * saver / 100)) "$list") ;;
      performance) floor=$(step_below $((top * performance / 100)) "$list") ;;
    esac
    (( floor < bottom )) && floor=$bottom
    # Floor down first and up last, so the floor never passes the ceiling
    write "$p/scaling_min_freq" "$bottom"
    write "$p/scaling_max_freq" "$ceiling"
    write "$p/scaling_min_freq" "$floor"
  done
  echo "power-profile: $profile"
}

active() {
  busctl get-property "$bus" "$path" "$bus" ActiveProfile 2>/dev/null |
    sed -n 's/^s "\([a-z-]*\)"$/\1/p'
}

watch() {
  local line now last=""
  trap 'apply balanced >/dev/null; exit 0' TERM INT
  now=$(active); [[ -n $now ]] && { apply "$now"; last=$now; }
  # Each change of the profile is a PropertiesChanged on the daemon's path
  while IFS= read -r line; do
    [[ $line == *ActiveProfile* ]] || continue
    now=$(active)
    [[ -n $now && $now != "$last" ]] || continue
    apply "$now"; last=$now
  done < <(gdbus monitor --system --dest "$bus" --object-path "$path")
  # The daemon left the bus: give the speed back and let systemd restart us
  apply balanced >/dev/null
  exit 1
}

if [[ -e $off ]]; then
  echo "power-profile: off on this device ($off): its thermal guard owns the CPU limits"
  case ${1:-} in watch | apply | restore) exit 0 ;; esac
fi

case ${1:-} in
  watch) watch ;;
  apply) [[ ${2:-} =~ ^[a-z-]+$ ]] || { echo "Usage: power-profile apply PROFILE" >&2; exit 2; }; apply "$2" ;;
  restore) apply balanced ;;
  *) echo "Usage: power-profile watch|apply PROFILE|restore" >&2; exit 2 ;;
esac
