#!/bin/bash
# SPDX-License-Identifier: MIT
# Tests for omamobile-device-tegu: the package stages what it says, enables
# only the hang-safe guards, and the scripts behave in a scratch root
# (test/graphics-start and friends, no phone, no hardware). reboot-to and
# tegu-tcpc-switch are compiled from src/, so a copied package still builds.
# Do not execute reboot-to.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

for script in build install bin/* vendor/systemd/system-sleep/* test/*; do
  bash -n "$script" || fail "$script parses"
done
# uwsm sources the env.d file with a POSIX shell
sh -n uwsm/env.d/omamobile-tegu-graphics || fail "the uwsm env.d file parses as POSIX shell"
pass "scripts parse"

grep -q '\.\./\.\.' build install && fail "build or install reaches outside the package directory"
pass "build and install stay inside the package directory"

if [[ -f ../omamobile-device-cheetah/src/reboot-to.c ]]; then
  cmp -s src/reboot-to.c ../omamobile-device-cheetah/src/reboot-to.c \
    || fail "reboot-to.c drifted from the cheetah package"
  pass "reboot-to.c matches the cheetah source"
  cmp -s vendor/udev/rules.d/10-omamobile-storage.rules \
    ../omamobile-device-cheetah/vendor/udev/rules.d/10-omamobile-storage.rules \
    || fail "the storage rule drifted from the cheetah package"
  pass "the storage rule matches the cheetah package"
  cmp -s etc/omamobile-mirrorlist ../omamobile-device-cheetah/etc/omamobile-mirrorlist \
    || fail "the mirrorlist drifted from the cheetah package"
  pass "the mirrorlist matches the cheetah package"
  cmp -s omamobile-device-tegu.install \
    ../omamobile-device-cheetah/omamobile-device-cheetah.install \
    || fail "the pacman install script drifted from the cheetah package"
  pass "the pacman install script matches the cheetah package"
  cmp -s vendor/systemd/sleep.conf.d/10-omamobile.conf \
    ../omamobile-device-cheetah/vendor/systemd/sleep.conf.d/10-omamobile.conf \
    || fail "the sleep drop-in drifted from the cheetah package"
  pass "the sleep drop-in matches the cheetah package"
fi
grep -q 'omamobile-keyring' PKGBUILD || fail "pacman needs omamobile-keyring"
grep -q '^install=omamobile-device-tegu.install$' PKGBUILD \
  || fail "the pacman install script is not named"
for dep in kmod bluez-utils; do
  grep -qE "^depends=.*\b$dep\b" PKGBUILD || fail "the scripts need $dep (depends)"
done
[[ -f etc/omamobile-mirrorlist && -f omamobile-device-tegu.install ]] \
  || fail "the pacman mirrorlist or install script is missing"
pass "pacman gets the keyring, the mirrorlist, the install script and the tools' dependencies"
if [[ -f ../../device/tegu/device.conf ]]; then
  cmp -s device.conf ../../device/tegu/device.conf \
    || fail "device.conf drifted from the descriptor"
  pass "device.conf matches the descriptor"
fi

# Nothing that must come from the user's own phone or a kernel build
# makepkg's pkg/ and src/build/ are not the package (check() runs beside them)
blobs=$(find . \( -path ./pkg -o -path ./src/build \) -prune -o -type f \( -name '*.ko' -o -name '*.bin' -o -name '*.hcd' -o -name '*.img' -o -name '*.wmfw' \) -print)
[[ -z $blobs ]] || fail "binaries in the package: $blobs"
macs=$(grep -rEn '\b([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}\b' --exclude-dir=build . || true)
[[ -z $macs ]] || fail "a MAC or Bluetooth address in the package: $macs"
pass "no blobs, no addresses"

./build "$tmp/build" || fail "the C tools compile"
[[ -x $tmp/build/reboot-to && -x $tmp/build/tegu-tcpc-switch ]] || fail "the C tools are not executable"
pass "the C tools compile"

./install "$tmp/root" "$tmp/build"
for f in usr/bin/reboot-to usr/bin/tegu-tcpc-switch \
         usr/bin/omamobile-tegu-graphics-start usr/lib/systemd/system/omamobile-tegu-graphics.service \
         usr/lib/systemd/system/display-manager.service.d/10-omamobile-tegu.conf \
         usr/bin/omamobile-tegu-aoc-start usr/lib/systemd/system/omamobile-tegu-aoc.service \
         usr/bin/omamobile-tegu-usb-rescue usr/lib/systemd/system/omamobile-tegu-usb-rescue.service \
         usr/bin/omamobile-bt-addr usr/lib/systemd/system/omamobile-bt-addr@.service \
         usr/lib/udev/rules.d/80-omamobile-bt-addr.rules \
         usr/bin/omamobile-tegu-charge-limit usr/lib/udev/rules.d/75-omamobile-tegu-charger.rules \
         usr/lib/modprobe.d/omamobile-tegu-guards.conf usr/lib/modprobe.d/omamobile-tegu-aoc.conf \
         usr/lib/modprobe.d/omamobile-tegu-display.conf usr/lib/modprobe.d/omamobile-tegu-clk-acpm.conf \
         usr/lib/systemd/system-sleep/omamobile-tegu-wifi usr/lib/systemd/system-sleep/omamobile-tegu-nfc \
         usr/lib/systemd/system/linux-modules-cleanup.service.d/10-omamobile-tegu.conf \
         usr/lib/systemd/system.conf.d/10-omamobile-reboot-watchdog.conf \
         usr/lib/systemd/sleep.conf.d/10-omamobile.conf \
         usr/lib/udev/rules.d/10-omamobile-storage.rules usr/lib/udev/rules.d/20-omamobile-torch.rules \
         usr/lib/udev/rules.d/70-omamobile-dma-heap.rules usr/lib/udev/rules.d/72-omamobile-feedbackd.rules \
         usr/lib/systemd/network/20-usb-gadget.network \
         usr/lib/NetworkManager/conf.d/10-omamobile-usb.conf \
         usr/share/uwsm/env.d/omamobile-tegu-graphics \
         usr/share/omamobile/device.conf \
         usr/share/omamobile/device-tegu/version \
         usr/share/licenses/omamobile-device-tegu/LICENSE \
         etc/pacman.d/omamobile-mirrorlist; do
  [[ -f $tmp/root/$f ]] || fail "install stages $f"
done
[[ -x $tmp/root/usr/lib/systemd/system-sleep/omamobile-tegu-wifi && -x $tmp/root/usr/lib/systemd/system-sleep/omamobile-tegu-nfc ]] \
  || fail "the sleep hooks are not executable"
for unit in omamobile-tegu-graphics omamobile-tegu-usb-rescue; do
  [[ $(readlink "$tmp/root/usr/lib/systemd/system/multi-user.target.wants/$unit.service") == ../$unit.service ]] \
    || fail "$unit is enabled by a vendor wants link"
done
[[ ! -e $tmp/root/usr/lib/systemd/system/multi-user.target.wants/omamobile-tegu-aoc.service ]] \
  || fail "the AoC start ships disabled (no wants link)"
grep -q 'KERNEL=="sda", MODE="0000"' "$tmp/root/usr/lib/udev/rules.d/10-omamobile-storage.rules" \
  || fail "the whole-disk node is made inaccessible"
grep -q 'ID_PART_ENTRY_NAME}!="userdata"' "$tmp/root/usr/lib/udev/rules.d/10-omamobile-storage.rules" \
  || fail "userdata is the only partition desktop tools may see"
grep -q 'Address=172.16.42.1/24' "$tmp/root/usr/lib/systemd/network/20-usb-gadget.network" \
  || fail "usb0 keeps the initramfs address"
grep -q 'Gateway=172.16.42.2' "$tmp/root/usr/lib/systemd/network/20-usb-gadget.network" \
  || fail "the host stays the fallback gateway"
grep -q '^PACKAGE=omamobile-device-tegu$' "$tmp/root/usr/share/omamobile/device.conf" \
  || fail "the installed descriptor is tegu"
grep -qx 'ConditionPathExists=!/usr/share/omamobile/device-tegu/version' \
  "$tmp/root/usr/lib/systemd/system/linux-modules-cleanup.service.d/10-omamobile-tegu.conf" \
  || fail "the module cleanup is held off by the package's version file"
grep -qx 'RebootWatchdogSec=1min' "$tmp/root/usr/lib/systemd/system.conf.d/10-omamobile-reboot-watchdog.conf" \
  || fail "a hung shutdown resets the phone after a minute"
grep -q 'RuntimeWatchdogSec' "$tmp/root/usr/lib/systemd/system.conf.d/10-omamobile-reboot-watchdog.conf" \
  && fail "no runtime watchdog from the package"
grep -q 'Before=display-manager.service' "$tmp/root/usr/lib/systemd/system/omamobile-tegu-graphics.service" \
  || fail "the graphics start runs before the display manager"
for node in 1f000000.gpu 19470000.display-controller; do
  grep -qx "ConditionPathExists=|/sys/bus/platform/devices/$node" "$tmp/root/usr/lib/systemd/system/omamobile-tegu-graphics.service" \
    || fail "the graphics start runs when $node exists (ORed condition)"
done
grep -q 'omamobile-tegu-display-card' "$tmp/root/usr/share/uwsm/env.d/omamobile-tegu-graphics" \
  && grep -q 'omamobile-tegu-gpu-ready.json' "$tmp/root/usr/share/uwsm/env.d/omamobile-tegu-graphics" \
  || fail "the session reads the graphics start's two files"
grep -q 'After=omamobile-tegu-graphics.service' "$tmp/root/usr/lib/systemd/system/display-manager.service.d/10-omamobile-tegu.conf" \
  || fail "the display manager waits for the graphics start"
for absent in usr/bin/omamobile-boot-success usr/bin/omamobile-bootctl \
              usr/lib/systemd/system/omamobile-boot-success.service \
              usr/bin/omamobile-wifi-start usr/bin/omamobile-charge-guard \
              usr/bin/omamobile-camera-start usr/bin/omamobile-aoc-start \
              usr/lib/udev/rules.d/20-omamobile-gpu-always-on.rules; do
  [[ ! -e $tmp/root/$absent ]] || fail "install includes $absent"
done
pass "install stages the package, enables only the guards, and nothing that marks a slot"

# Every driver the graphics guard loads is kept from autoloading (gs_dsim_cmd
# aside: it autoloads from its node and sends nothing until allow_tx is on,
# which only the guard sets), and nothing in modprobe.d would break the
# guard's own modprobe.
for m in $(grep -v '^ *#' bin/omamobile-tegu-graphics-start | grep -oE '\bmodprobe [a-z0-9_]+' | cut -d' ' -f2 | sort -u); do
  [[ $m == gs_dsim_cmd ]] && continue
  grep -qx "blacklist $m" vendor/modprobe.d/omamobile-tegu-guards.conf \
    || fail "$m is loaded by the graphics guard but not blacklisted"
done
for m in panthor gs_decon cs40l26_vibra leds_lm3644 max77779_battery hci_uart; do
  grep -qE "modprobe $m\b" bin/omamobile-tegu-graphics-start || fail "the graphics guard no longer loads $m"
done
for m in gsa gs201_aoc_sysmmu mailbox_wc aoc_core aoc_channel_dev aoc_alsa_dev aoc_char_dev; do
  grep -qx "blacklist $m" vendor/modprobe.d/omamobile-tegu-aoc.conf \
    || fail "$m is loaded by the AoC guard but not blacklisted"
done
grep -qE '^install ' vendor/modprobe.d/*.conf && fail "an install line in modprobe.d would break a guard's modprobe"
grep -qE '^options gs_dsim_cmd' vendor/modprobe.d/omamobile-tegu-display.conf \
  && fail "allow_tx belongs to the graphics start (google-tg4c only), not modprobe.d"
grep -q 'exynos_drm.panel_name=google-tg4c' bin/omamobile-tegu-graphics-start \
  || fail "the graphics start keys allow_tx on the bootloader's panel name"
[[ $(grep -c 'max_refresh=' vendor/modprobe.d/omamobile-tegu-display.conf) == 1 ]] \
  || fail "exactly one refresh-rate ceiling"
grep -qE '^options clk_acpm zumapro_gpu_max_khz=[0-9]+' vendor/modprobe.d/omamobile-tegu-clk-acpm.conf \
  || fail "the GPU DVFS ceiling is set"
pass "modprobe.d keeps the guarded drivers from autoloading and sets the display and GPU options"

grep -q 'chosen/config/bt_addr' bin/omamobile-bt-addr || fail "the Bluetooth address comes from the bootloader's DT"
grep -q 'HandlePowerKey' -r vendor && fail "no power-key policy from this package (omamobile-shell owns it on tegu)"
pass "the Bluetooth address is read at run time"

for t in test/graphics-start test/aoc-start test/usb-rescue test/sleep-hooks test/charge-limit; do
  "$t" || fail "$t"
done
pass "the scripts behave in a scratch root"
