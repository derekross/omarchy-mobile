pkgname=omamobile-device-tegu
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Omamobile support for the Google Pixel 9a (tegu): storage guard, USB networking, hang-safe graphics start"
arch=(aarch64)
url="https://github.com/derekross/omamobile"
license=(MIT)
depends=(bash systemd kmod bluez-utils omamobile-keyring)
optdepends=('omamobile-telephony-tegu: attach Phone and Messages to an attended running sitd')
provides=(omamobile-device omamobile-modem-policy omamobile-sitd-policy)
# The suspend-verified declaration holds only with sitd's internet bearer
# reconnect (omamobile-modem-sit 0.3.42), as device-cheetah's does.
conflicts=(omamobile-device 'omamobile-modem-sit<0.3.42')
backup=(etc/pacman.d/omamobile-mirrorlist etc/NetworkManager/conf.d/zz-omamobile-wifi-powersave.conf)
install=omamobile-device-tegu.install
makedepends=(gcc)
checkdepends=(diffutils)

build() {
  "$startdir/build" "$srcdir/build"
}

check() {
  "$startdir/test/all"
}

package() {
  "$startdir/install" "$pkgdir" "$srcdir/build"
}
