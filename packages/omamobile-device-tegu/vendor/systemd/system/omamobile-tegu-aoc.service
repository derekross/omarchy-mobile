# The AoC (audio and sensor DSP) at boot, through the hang-safe
# omamobile-tegu-aoc-start, at every boot (the package's wants link) once the
# device tree has the AoC node; without it the condition skips the unit. It
# is also omamobile-aoc.service (a link beside it), the name the sensor proxy
# and the fingerprint service order themselves after. The AoC, Trusty and
# amplifier modules are blacklisted for autoload
# (modprobe.d/omamobile-tegu-aoc.conf) so only the script loads them.
[Unit]
Description=Boot the Pixel 9a AoC audio and sensor DSP (hang-safe)
After=local-fs.target systemd-modules-load.service
ConditionPathExists=/sys/bus/platform/devices/154b0000.aoc

[Service]
Type=oneshot
ExecStart=/usr/bin/omamobile-tegu-aoc-start
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
