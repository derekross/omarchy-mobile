# The AoC (audio and sensor DSP) at boot, through the hang-safe
# omamobile-tegu-aoc-start. Not enabled by the package: the Pixel 9a kernel
# does not yet enable the AoC, GSA and Trusty nodes in its device tree (they
# are turned on by out-of-tree overlay modules in the bring-up), so the
# script would find nothing to do. Once a kernel enables them:
#   systemctl enable omamobile-tegu-aoc.service
# The AoC modules are blacklisted for autoload (modprobe.d/omamobile-tegu-aoc.conf).
[Unit]
Description=Boot the Pixel 9a AoC audio and sensor DSP (hang-safe)
After=local-fs.target systemd-modules-load.service
ConditionPathExists=/sys/bus/platform/devices/154b0000.aoc

[Service]
Type=oneshot
ExecStart=/usr/bin/omamobile-tegu-aoc-start
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
