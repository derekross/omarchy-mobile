# SPDX-License-Identifier: MIT
# The Pixel 9a's modem at boot, opt-in: not enabled by the package. The owner
# turns it on with `systemctl enable omamobile-tegu-modem-boot`. It starts the
# CP once (omamobile-tegu-modem-up keeps the once-per-boot rule, the NV
# checks, the failure latch with its one retry and the sleep inhibitor), then
# the phone service and, when installed, the Phone and Messages bridge, with
# gnssd in the modem profile so Omarchy's Location switch gets fixes
# (omamobile-gnss). With it on the palmtop doesn't suspend (the modem blocks
# sleep until suspend with the CP up is qualified), so the battery drains as
# if awake.
#
# Opt-in because of slot B: with B not marked successful every reset spends
# one of ABL's three tries, and at zero stock boots and has overwritten
# userdata; marking B on the 9a is on hold, and the unit can't tell whether
# it is marked. Before enabling it (README, "Starting it at boot"): slot B
# marked successful, a kernel with linux-omarchy-mobile#172, and the charger
# in for the first boots.
#
# An enabled unit is skipped, not failed, on a phone that can't run it:
# without the three files tools/phone-provision puts on the phone, and
# without CP drivers. Those are the kernel's when the device tree has a cpif
# node, which comes from the device's modem-cpif overlay in the boot images
# (the board's own device tree has only the modem node under the PCIe link),
# or else the owner's bring-up modules.
#
# Rollback: systemctl disable omamobile-tegu-modem-boot and reboot. After a
# reset with the modem up, the latch gives the next boot one more try and
# holds after a second (README).
[Unit]
Description=Start the Pixel 9a's modem and phone service (opt-in)
Documentation=file:///usr/share/doc/omamobile-device-tegu/README.md
After=omamobile-tegu-aoc.service omamobile-tegu-graphics.service network.target
Wants=network.target
ConditionPathExists=/usr/lib/omamobile-vendor/omamobile-vendor-chroot
ConditionPathExists=/usr/lib/omamobile-vendor/modem/root
ConditionPathExists=/etc/omamobile/modem-nv.sha256
ConditionPathExists=/var/lib/omamobile-vendor/modem/props.conf
ConditionPathExists=|/proc/device-tree/cpif
ConditionPathExists=|/var/lib/omamobile-tegu/modem/cpif.ko

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/omamobile-tegu-modem-up --phone --gnss
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
