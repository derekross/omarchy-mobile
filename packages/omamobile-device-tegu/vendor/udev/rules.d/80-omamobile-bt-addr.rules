# SPDX-License-Identifier: MIT
# Omarchy Mobile: give the BCM4383 Bluetooth controller its real address
# (omamobile-bt-addr@.service). Only the controller (DEVTYPE host): each
# connection is a bluetooth device too (hci0:N, DEVTYPE link).
ACTION=="add", SUBSYSTEM=="bluetooth", KERNEL=="hci[0-9]*", ENV{DEVTYPE}=="host", DRIVERS=="hci_uart_bcm", TAG+="systemd", ENV{SYSTEMD_WANTS}+="omamobile-bt-addr@%k.service"
