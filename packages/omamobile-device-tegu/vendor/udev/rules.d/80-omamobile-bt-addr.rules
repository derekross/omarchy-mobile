# SPDX-License-Identifier: MIT
# Omamobile: give the BCM4383 Bluetooth controller its real address
# (omamobile-bt-addr@.service).
# Controllers only (DEVTYPE host): a connection to a device is hciN:HANDLE in
# the same subsystem (DEVTYPE link), and its unit failed at every connect.
ACTION=="add", SUBSYSTEM=="bluetooth", KERNEL=="hci[0-9]*", ENV{DEVTYPE}=="host", DRIVERS=="hci_uart_bcm", TAG+="systemd", ENV{SYSTEMD_WANTS}+="omamobile-bt-addr@%k.service"
