#!/bin/bash
# SPDX-License-Identifier: MIT
# Bring up the Pixel 9a's GPU, display, haptics, torch, battery gauge and
# Bluetooth controller at boot, hang-safe. All six drivers are in the kernel
# tree and blacklisted for autoload (modprobe.d/omamobile-tegu-guards.conf),
# so this script is the only thing that loads them, in this order, after a
# marker has been written and synced. Each step keys on its own device node
# (the GPU on 1f000000.gpu, the display on 19470000.display-controller, the
# rest on their device-tree nodes), so a DTB without the GPU still gets its
# display. A load or bind that returns but fails is logged and skipped, and
# the start goes on to the next step: panthor without mali_csffw.bin must not
# take the display with it. Only a step that never comes back keeps the
# marker: the next boot finds it, leaves all of it alone and says so; after
# reading the previous boot's log, run "omamobile-tegu-graphics-start --retry".
#
# The panel's DSI commands (gs_dsim_cmd.allow_tx, for brightness, sleep and
# 120 Hz) are allowed only when the bootloader names the google-tg4c panel
# on the command line (exynos_drm.panel_name=google-tg4c, with the panel's
# id appended by the bootloader, kernel #90), and
# before gs_decon loads, since gs-decon decides on 120 Hz at probe.
#
# This is the curated start of the bring-up (device/tegu/bringup) without its
# file-hash manifest, EGL smoke test, mask checks, sddm start and bootloader
# dead-man: the marker is the safety net, as on the Pixel 7 Pro.
#   omamobile-tegu-graphics-start [--retry]
# OMAMOBILE_TEGU_ROOT: a scratch root for the package tests (fake /sys, /proc).
set -uo pipefail

root=${OMAMOBILE_TEGU_ROOT:-}
if [[ -n $root ]]; then
  [[ $root == /* && $root != / && -d $root ]] || exit 2
fi
state=$root/var/lib/omamobile
marker=$state/tegu-graphics-started
dt=$root/proc/device-tree
cmdline=$root/proc/cmdline
gpu=$root/sys/bus/platform/devices/1f000000.gpu
decon=$root/sys/bus/platform/devices/19470000.display-controller
allow_tx=$root/sys/module/gs_dsim_cmd/parameters/allow_tx
torch=$root/sys/class/leds/white:torch
gauge=$root/sys/class/power_supply/max77779-battery
haptics_node=$dt/soc/usi@10c900c0/i2c@10c90000/haptic-driver@43
torch_node=$dt/soc/usi@108b00c0/i2c@108b0000/led-controller@63
bluetooth_node=$dt/soc/usi@155d00c0/serial@155d0000/bluetooth

log() { echo "omamobile-tegu-graphics: $*"; }
loaded() { [[ -d $root/sys/module/$1 ]]; }
# A device-tree node is enabled when it exists and has no status or "okay".
enabled() {
  [[ -d $1 ]] || return 1
  [[ -e $1/status ]] || return 0
  case $(tr -d '\0' < "$1/status") in okay|ok) return 0 ;; *) return 1 ;; esac
}
# Wait for a device to bind to a driver: device dir, driver name, quarter seconds.
bound() {
  local i
  for ((i = 0; i < $3; i++)); do
    [[ $(readlink -f "$1/driver" 2>/dev/null) == */$2 ]] && return 0
    sleep 0.25
  done
  return 1
}
# The panel the bootloader named on the kernel command line, or nothing.
panel_name() {
  local word
  for word in $(cat "$cmdline" 2>/dev/null); do
    [[ $word == exynos_drm.panel_name=* ]] && { echo "${word#*=}"; return 0; }
  done
  echo ""
}

case ${1:-} in
  '') ;;
  --retry) rm -f "$marker" ;;
  *) log "usage: omamobile-tegu-graphics-start [--retry]"; exit 2 ;;
esac

if [[ -e $marker ]]; then
  log "the last start ($(cat "$marker" 2>/dev/null)) never finished; the GPU, display, haptics, torch, gauge and Bluetooth stay off this boot."
  log "after checking the previous boot's log, retry with: omamobile-tegu-graphics-start --retry"
  exit 0
fi
if [[ ! -e $gpu && ! -e $decon ]]; then
  log "no GPU and no display controller in this DTB; nothing to do"
  exit 0
fi
# Once per boot: a loaded driver is never unloaded or retried (AGENTS.md).
# --retry goes on from where the last start stopped: modprobe leaves a
# loaded driver as it is, so the steps already done cost nothing.
if [[ ${1:-} != --retry ]] && { loaded panthor || loaded gs_decon; }; then
  log "already started this boot"
  exit 0
fi

mkdir -p "$state" "$root/run"
# The marker names the step in progress, so a hang is easy to place.
phase() { printf '%s %s\n' "$(date -Is)" "$1" > "$marker"; sync -f "$marker" 2>/dev/null || sync; }
finish() { rm -f "$marker"; sync -f "$state" 2>/dev/null || sync; }
# A step that returned and failed: logged, skipped, the start goes on to the
# next one. The marker is cleared at the end as after a good start: it is for
# a step that never comes back, not for one that said no.
up=
failed=
skip() { log "$2; skipped"; failed+="${failed:+, }$1"; }

if [[ -e $gpu ]]; then
  phase gpu
  if ! modprobe panthor; then
    skip GPU "panthor failed (no mali_csffw.bin yet? see dmesg)"
  elif ! bound "$gpu" panthor 60; then
    skip GPU "the GPU did not bind to panthor (see dmesg)"
  else
    # The session's environment (uwsm/env.d/omamobile-tegu-graphics) reads
    # this and picks hardware GL.
    printf '{"gpu": "panthor", "by": "omamobile-tegu-graphics-start"}\n' > "$root/run/omamobile-tegu-gpu-ready.json"
    up+="GPU"
  fi
else
  log "no GPU in this DTB; skipped"
fi

if [[ -e $decon ]]; then
  phase display
  # gs_dsim_cmd is not guarded: it autoloads from its node ahead of this
  # start and sends nothing until allow_tx is on. Loading it here (a no-op
  # when it already is) makes the parameter file exist before the write.
  modprobe gs_dsim_cmd 2>/dev/null || true
  panel=$(panel_name)
  # the bootloader appends the panel's id (google-tg4c.2d008004 on the palmtop)
  if [[ $panel == google-tg4c || $panel == google-tg4c.* ]]; then
    if echo 1 > "$allow_tx" 2>/dev/null; then
      log "panel $panel: DSI commands allowed (gs_dsim_cmd.allow_tx=1)"
    else
      log "panel $panel: could not write $allow_tx; the display stays read-only at 60 Hz"
    fi
  else
    log "panel ${panel:-unnamed}: DSI commands stay off; the display stays read-only at 60 Hz"
  fi
  # stage=2 is the full driver (the lower stages are bring-up probes); the
  # refresh rate and the panel-off behaviour come from modprobe.d.
  if ! modprobe gs_decon stage=2 fbdev=0; then
    skip display "gs_decon failed (see dmesg)"
  elif ! bound "$decon" gs-decon 60; then
    skip display "the display controller did not bind to gs-decon (see dmesg)"
  else
    # The session's environment reads the display controller's DRM node,
    # whichever card number it got (the GPU may take card0).
    card=$(readlink -f "$root/dev/dri/by-path/platform-19470000.display-controller-card" 2>/dev/null || true)
    [[ -n $card ]] && printf '%s\n' "${card#"$root"}" > "$root/run/omamobile-tegu-display-card"
    up+="${up:+, }display"
  fi
else
  log "no display controller in this DTB; skipped"
fi

if enabled "$haptics_node"; then
  phase haptics
  if modprobe cs40l26_vibra; then up+="${up:+, }haptics"; else skip haptics "cs40l26_vibra failed (see dmesg)"; fi
else
  log "no haptics in this DTB; skipped"
fi

if enabled "$torch_node"; then
  phase torch
  if ! modprobe leds_lm3644; then
    skip torch "leds_lm3644 failed (see dmesg)"
  else
    for _ in $(seq 40); do [[ -e $torch/brightness ]] && break; sleep 0.25; done
    if [[ ! -e $torch/brightness ]]; then
      log "no white:torch LED after the driver loaded (see dmesg)"
    elif [[ $(cat "$torch/brightness") != 0 ]]; then
      # It must start off: turn it off here and say so.
      echo 0 > "$torch/brightness" 2>/dev/null
      skip torch "the torch came up lit; turned off (brightness now $(cat "$torch/brightness" 2>/dev/null))"
    else
      up+="${up:+, }torch"
    fi
  fi
else
  log "no torch in this DTB; skipped"
fi

phase gauge
if ! modprobe max77779_battery; then
  skip gauge "max77779_battery failed (see dmesg)"
else
  for _ in $(seq 40); do [[ -e $gauge/capacity ]] && break; sleep 0.25; done
  if [[ -e $gauge/capacity ]]; then
    up+="${up:+, }gauge $(cat "$gauge/capacity") %"
  else
    log "no max77779-battery supply after the driver loaded (see dmesg)"
  fi
fi

# The address and the power-on are omamobile-bt-addr@'s, started by udev.
if enabled "$bluetooth_node"; then
  phase bluetooth
  if modprobe hci_uart; then up+="${up:+, }Bluetooth"; else skip Bluetooth "hci_uart failed (see dmesg)"; fi
else
  log "no Bluetooth in this DTB; skipped"
fi

finish
log "up: ${up:-nothing}"
if [[ -n $failed ]]; then
  log "failed: $failed (these loads returned, so the marker is clear; --retry tries them again)"
  exit 1
fi
exit 0
