#!/bin/bash
# SPDX-License-Identifier: MIT
# Pixel 9a charge limit: /etc/omamobile/charge-limit holds the percentage at
# which charging stops (say 80); the charger starts again 5 below it. No
# file, or not a number from 1 to 100: charge to 100 %.
#
# A charger with charge_control_end_threshold takes the limit itself. The
# kernel's max77779-charger driver offers charge_behaviour instead, so for
# it this script holds charging off (inhibit-charge) from the limit and lets
# it run again (auto) 5 below, by the battery's capacity. udev runs it when
# the charger appears and on every battery change
# (75-omamobile-tegu-charger.rules); run it by hand after editing the file.
set -uo pipefail

root=${OMAMOBILE_TEGU_ROOT:-}
if [[ -n $root ]]; then
  [[ $root == /* && $root != / && -d $root ]] || exit 2
fi
file=$root/etc/omamobile/charge-limit
supply=$root/sys/class/power_supply
threshold=$supply/max77779-charger/charge_control_end_threshold
behaviour=$supply/max77779-charger/charge_behaviour
capacity=$supply/max77779-battery/capacity
log() { echo "omamobile-tegu-charge-limit: $*"; }

limit=100
if [[ -s $file ]]; then
  limit=$(tr -d ' \t\n' < "$file")
  if [[ ! $limit =~ ^[0-9]+$ ]] || (( 10#$limit < 1 || 10#$limit > 100 )); then
    log "$file is not a percentage from 1 to 100; no limit"
    [[ -w $behaviour ]] && echo auto > "$behaviour"
    exit 1
  fi
  limit=$((10#$limit))
fi

if [[ -w $threshold ]]; then
  [[ -s $file ]] || exit 0
  echo "$limit" > "$threshold" || { log "the charger refused $limit"; exit 1; }
  log "charge limit $(cat "$threshold") %"
  exit 0
fi

if [[ ! -w $behaviour ]]; then
  [[ -s $file ]] && log "no charger to limit"
  exit 0
fi
want=
if (( limit >= 100 )); then
  want=auto
elif [[ -r $capacity ]]; then
  level=$(tr -d ' \t\n' < "$capacity")
  [[ $level =~ ^[0-9]+$ ]] || { log "the battery reports no capacity"; exit 0; }
  if (( level >= limit )); then want=inhibit-charge
  elif (( level <= limit - 5 )); then want=auto
  fi
else
  log "no battery capacity; charging left as it is"
  exit 0
fi
[[ -n $want ]] || exit 0
current=$(grep -o '\[[a-z-]*\]' "$behaviour" 2>/dev/null | tr -d '[]')
[[ -n $current ]] || current=$(tr -d ' \t\n' < "$behaviour")
[[ $current == "$want" ]] && exit 0
echo "$want" > "$behaviour" || { log "the charger refused $want"; exit 1; }
log "charge limit $limit %: $want"
