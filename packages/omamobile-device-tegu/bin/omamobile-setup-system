#!/bin/bash
# SPDX-License-Identifier: MIT
# Omarchy Mobile's system setup for the Pixel 9a: what a platform's
# "setup-system" step does in Omarchy's lifecycle contract (omamobile-firstboot
# runs it). Runs as root; safe to rerun. The same as the Pixel 7 Pro's, with
# the 9a's own list of services.
#   omamobile-setup-system [timezone]
set -euo pipefail

# UTF-8 locale (Qt and Omarchy's tools expect one)
sed -i 's/^#\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen
locale-gen >/dev/null
echo "LANG=en_US.UTF-8" > /etc/locale.conf

# Time: no battery-backed clock is used yet, so keep NTP on
if [[ -n ${1:-} ]]; then
  ln -sf "/usr/share/zoneinfo/$1" /etc/localtime
fi
systemctl enable --now systemd-timesyncd >/dev/null 2>&1 || true

# The phone's services from the other Omarchy Mobile packages: enabled here,
# once, because packages don't enable units themselves (this package ships
# its own boot units as .wants links). Not on the 9a yet: the fingerprint
# service (its first start writes Trusty's secure storage), speaker
# protection (the 7 Pro's CS35L41s; the 9a's TAS2572s need none of it), and
# the GNSS socket, whose session starts the modem, whose PCIe link still hangs
# the SoC after some minutes (device/tegu/MODEM-PLAN.md).
for unit in omamobile-sensor-proxy.service omamobile-nfc-open.service; do
  systemctl cat "$unit" >/dev/null 2>&1 && systemctl enable "$unit" >/dev/null 2>&1 || true
done
