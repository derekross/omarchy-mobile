#!/bin/bash
# SPDX-License-Identifier: MIT
set -euo pipefail

base=/sys/firmware/devicetree/base
touch_node=$base/soc@0/usi@111d00c0/spi@111d0000/touchscreen@0

[[ -f $touch_node/status ]] || exit 0
[[ $(tr -d '\0' < "$touch_node/status") == okay ]] || exit 0
[[ $(tr -d '\0' < "$base/compatible") == *google,zumapro-tegu* ]] || exit 0

modprobe acpm_protocol
modprobe sec_acpm

for ((i = 0; i < 20; i++)); do
  if grep -F 'Name="Synaptics TouchComm Touchscreen"' /proc/bus/input/devices >/dev/null; then
    exit 0
  fi
  sleep 0.5
done

echo 'tegu touchscreen did not bind after ACPM and S2MPG14 started' >&2
exit 1
