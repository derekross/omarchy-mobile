#!/bin/bash
# SPDX-License-Identifier: MIT
# omamobile-install-link-hold.service's one job: return only when the login
# screen may come (docs/INSTALL-LINK-PLAN.md §3.3). That is when any of:
#   - first boot made the account (its `done`): from stage firstboot-done on
#     the display manager owns the screen
#   - the link ended (its `done`), or the marker is gone
#   - the daemon has not been running for 15 polls in a row (30 s):
#     stopped, failed, or never started. A restart that systemd has queued
#     (auto-restart) counts as running. A phone whose link cannot run is
#     never left without a login screen for it
# At stage firstboot-failed first boot has no `done`, so the screen stays
# held: the code stays on the first-start screen (§2.2, §17 P3).
#
# Before it returns it stops the first-start screen and waits for it to end
# (omamobile-install-screen.service, TimeoutStopSec=5s): the screen draws the
# background alone, drops DRM master and puts the VT back, so the display
# manager finds the panel free and no code on it.
#
# It reads files and `systemctl show`, and stops the screen; it writes
# nothing.
# Tests point it elsewhere: OMAMOBILE_LINK_ROOT (a scratch root),
# HOLD_SYSTEMCTL (a stand-in), HOLD_POLL_S (2), HOLD_GONE_POLLS (15).
set -uo pipefail
R=${OMAMOBILE_LINK_ROOT:-}
systemctl=${HOLD_SYSTEMCTL:-systemctl}
poll=${HOLD_POLL_S:-2}
gone_polls=${HOLD_GONE_POLLS:-15}
unit=omamobile-install-link.service
gone=0
say() { echo "hold-login: $*"; }
let_go() {
  say "$1"
  "$systemctl" stop omamobile-install-screen.service 2>/dev/null || say "the first-start screen did not stop cleanly"
  exit 0
}
while :; do
  if [[ ! -e $R/etc/omamobile/install-link ]]; then let_go "no marker: the login screen may come"; fi
  if [[ -e $R/var/lib/omamobile/firstboot/done ]]; then let_go "first boot made the account"; fi
  if [[ -e $R/var/lib/omamobile/install-link/done ]]; then let_go "the link has ended"; fi
  state=$("$systemctl" show -P ActiveState "$unit" 2>/dev/null) || state=unknown
  sub=$("$systemctl" show -P SubState "$unit" 2>/dev/null) || sub=unknown
  case $state/$sub in
    active/* | activating/* | reloading/* | */auto-restart) gone=0 ;;
    *) gone=$((gone + 1)) ;;
  esac
  if ((gone >= gone_polls)); then let_go "the link's daemon is not running ($state, $sub): the login screen may come"; fi
  sleep "$poll"
done
