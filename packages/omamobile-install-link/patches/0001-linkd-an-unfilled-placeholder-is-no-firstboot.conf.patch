+/// Whether a file of the owner's answers (`firstboot.conf`,
+/// `boot-update.conf`) holds any: a line that is neither blank nor a
+/// comment. A release image carries both as placeholders of comments only
+/// (omarchy-mobile's `rootfs/placeholders`, RELEASES §6.1), which an
+/// installer that streams the image fills in place; one left as it is
+/// counts as no file at all, as `omamobile-firstboot` and
+/// `omamobile-boot-update` read it (INSTALL-LINK-PLAN, the 2026-11-13
+/// decision). A file that cannot be read counts as one with answers: the
+/// start-up rules never take a phone for a first start on a guess.
+pub fn holds_answers(path: &Path) -> bool {
+    match fs::read(path) {
+        Ok(bytes) => String::from_utf8_lossy(&bytes).lines().any(|l| {
+            let t = l.trim();
+            !t.is_empty() && !t.starts_with('#')
+        }),
+        Err(e) => e.kind() != std::io::ErrorKind::NotFound,
+    }
+}
