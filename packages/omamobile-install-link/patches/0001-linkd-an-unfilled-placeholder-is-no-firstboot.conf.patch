+/// The release image's placeholders (omarchy-mobile `rootfs/placeholders`):
+/// comment lines and a last comment line of spaces, 4096 bytes. Left as
+/// they are, they are no `firstboot.conf` and no `boot-update.conf`.
+fn placeholder(path: &str) -> Vec<u8> {
+    let mut b = format!(
+        "# Omarchy Mobile: the place for {path}, kept by the release image.\n\
+         # Left as it is, it holds no answers.\n"
+    )
+    .into_bytes();
+    b.push(b'#');
+    b.resize(4095, b' ');
+    b.push(b'\n');
+    b
+}
+
+#[test]
+fn row_2_an_unfilled_placeholder_is_no_firstboot_conf() {
+    let p = Phone::new();
+    p.write("/etc/omamobile/firstboot.conf", &placeholder("/etc/omamobile/firstboot.conf"));
+    p.write("/etc/omamobile/boot-update.conf", &placeholder("/etc/omamobile/boot-update.conf"));
+    let s = offered(&p);
+    assert_eq!(s.stage, Persistent::default().stage, "a first start");
+    assert_eq!(p.gadget(), ["add"]);
+    // The answers taken (stage firstboot) and boot-update.conf still the
+    // image's placeholder: it is written, as when it is missing
+    let p = Phone::new();
+    p.write("/etc/omamobile/firstboot.conf", b"USERNAME=owner\n");
+    p.write("/etc/omamobile/boot-update.conf", &placeholder("/etc/omamobile/boot-update.conf"));
+    p.state_now(|s| s.stage = Stage::Firstboot);
+    assert_eq!(offered(&p).stage, Stage::Firstboot);
+    assert!(p
+        .read("/etc/omamobile/boot-update.conf")
+        .is_some_and(|t| t.ends_with("AUTO_WRITE=yes\n")));
+    // A filled one is the owner's answers: not a first start of the link's
+    let p = Phone::new();
+    let mut filled = b"USERNAME=owner\n".to_vec();
+    filled.extend_from_slice(&placeholder("/etc/omamobile/firstboot.conf")[15..]);
+    p.write("/etc/omamobile/firstboot.conf", &filled);
+    ended(&p, "not-first-start");
+}
