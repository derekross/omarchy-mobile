diff --git a/src/ipa/simple/data/imx471.yaml b/src/ipa/simple/data/imx471.yaml
new file mode 100644
index 0000000..3f9e597
--- /dev/null
+++ b/src/ipa/simple/data/imx471.yaml
@@ -0,0 +1,25 @@
+# SPDX-License-Identifier: CC0-1.0
+#
+# Sony IMX471 (the OnePlus 7T Pro's front camera, in its pop-up), not calibrated yet. The black level comes from the sensor's helper.
+# Fixed focus: no Af.
+#
+# The colour matrix is the identity until a calibration, so the saturation
+# default applies.
+%YAML 1.1
+---
+version: 1
+algorithms:
+  - BlackLevel:
+  - Awb:
+  - Ccm:
+      ccms:
+        - ct: 5000
+          ccm: [ 1, 0, 0,
+                 0, 1, 0,
+                 0, 0, 1 ]
+  # Defaults for applications that do not set the controls.
+  - Adjust:
+      contrast: 1.2
+      saturation: 1.1
+  - Agc:
+...
diff --git a/src/ipa/simple/data/imx481.yaml b/src/ipa/simple/data/imx481.yaml
new file mode 100644
index 0000000..c10057a
--- /dev/null
+++ b/src/ipa/simple/data/imx481.yaml
@@ -0,0 +1,40 @@
+# SPDX-License-Identifier: CC0-1.0
+#
+# Sony IMX481 (the OnePlus 7T Pro's ultrawide), not calibrated yet. The black level comes from the sensor's helper.
+# Autofocus drives the AK7374 lens: 8 coarse steps, then steps of 1/16
+# of the range.
+#
+# These values are the OnePlus 7T Pro's. The Pixel 4 XL's rear telephoto is
+# an IMX481 too and takes this file, with autofocus tuned for this lens.
+#
+# The colour matrix is the identity until a calibration, so the saturation
+# default applies.
+%YAML 1.1
+---
+version: 1
+algorithms:
+  - BlackLevel:
+  - Awb:
+  - Ccm:
+      ccms:
+        - ct: 5000
+          ccm: [ 1, 0, 0,
+                 0, 1, 0,
+                 0, 0, 1 ]
+  # Defaults for applications that do not set the controls.
+  - Adjust:
+      contrast: 1.2
+      saturation: 1.1
+  # Luma and chroma noise reduction and sharpening, scaled with the gain:
+  # measured on our own frames at gain 16 (indoors, the sensor's
+  # limit): about a fifth less luma and a sixth less colour noise than the
+  # Pixel's values, and stronger settings only hit the caps.
+  - Detail:
+      sharpen: 0.5
+      denoise: 0.03
+      chromaDenoise: 0.08
+  - Agc:
+  - Af:
+      coarseSteps: 8
+      fineSteps: 16
+...
diff --git a/src/ipa/simple/data/imx586.yaml b/src/ipa/simple/data/imx586.yaml
new file mode 100644
index 0000000..15f118a
--- /dev/null
+++ b/src/ipa/simple/data/imx586.yaml
@@ -0,0 +1,36 @@
+# SPDX-License-Identifier: CC0-1.0
+#
+# Sony IMX586 (the OnePlus 7T Pro's main camera), not calibrated yet. The black level comes from the sensor's helper.
+# Autofocus drives the main lens (an LC898217XC on our phone's SEMCO
+# module): 8 coarse steps over the range, then steps of 1/32 of it around
+# the sharpest one, for the large sensor's shallow depth of field.
+#
+# The colour matrix is the identity until a calibration, so the saturation
+# default applies.
+%YAML 1.1
+---
+version: 1
+algorithms:
+  - BlackLevel:
+  - Awb:
+  - Ccm:
+      ccms:
+        - ct: 5000
+          ccm: [ 1, 0, 0,
+                 0, 1, 0,
+                 0, 0, 1 ]
+  # Defaults for applications that do not set the controls.
+  - Adjust:
+      contrast: 1.2
+      saturation: 1.1
+  # Luma and chroma noise reduction and sharpening, scaled with the gain:
+  # the Pixel 7 Pro main camera's values.
+  - Detail:
+      sharpen: 0.6
+      denoise: 0.015
+      chromaDenoise: 0.03
+  - Agc:
+  - Af:
+      coarseSteps: 8
+      fineSteps: 32
+...
