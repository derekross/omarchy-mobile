@@ -857,6 +893,19 @@ public:
 };
 REGISTER_CAMERA_SENSOR_HELPER("s5k3j1", CameraSensorHelperS5k3j1)
 
+class CameraSensorHelperS5k3m5 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperS5k3m5()
+	{
+		/* 64 at 10 bits. */
+		blackLevel_ = 4096;
+		/* The kernel driver takes the gain in whole steps, 1x to 16x. */
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 1 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("s5k3m5", CameraSensorHelperS5k3m5)
+
 class CameraSensorHelperS5kgm5 : public CameraSensorHelper
