@@ -659,6 +659,45 @@ public:
 };
 REGISTER_CAMERA_SENSOR_HELPER("imx477", CameraSensorHelperImx477)
 
+class CameraSensorHelperImx481 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperImx481()
+	{
+		/* The sensor reports a 64-code pedestal in its 10-bit samples. */
+		blackLevel_ = 4096;
+		/* Sony: gain = 1024 / (1024 - register code). */
+		gain_ = AnalogueGainLinear{ 0, 1024, -1, 1024 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("imx481", CameraSensorHelperImx481)
+
+class CameraSensorHelperImx471 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperImx471()
+	{
+		/* The sensor reports a 64-code pedestal in its 10-bit samples. */
+		blackLevel_ = 4096;
+		/* Sony: gain = 1024 / (1024 - register code). */
+		gain_ = AnalogueGainLinear{ 0, 1024, -1, 1024 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("imx471", CameraSensorHelperImx471)
+
+class CameraSensorHelperImx586 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperImx586()
+	{
+		/* The sensor reports a 64-code pedestal in its 10-bit samples. */
+		blackLevel_ = 4096;
+		/* Sony: gain = 1024 / (1024 - register code). */
+		gain_ = AnalogueGainLinear{ 0, 1024, -1, 1024 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("imx586", CameraSensorHelperImx586)
+
 class CameraSensorHelperImx678 : public CameraSensorHelper
 {
 public:
@@ -896,6 +935,19 @@ public:
 };
 REGISTER_CAMERA_SENSOR_HELPER("s5kgn8", CameraSensorHelperS5kgn8)
 
+class CameraSensorHelperS5k3m5 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperS5k3m5()
+	{
+		/* The sensor reports a 64-code pedestal in its 10-bit samples. */
+		blackLevel_ = 4096;
+		/* The V4L2 control reports the gain multiplier directly. */
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 32 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("s5k3m5", CameraSensorHelperS5k3m5)
+
