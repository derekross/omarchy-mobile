# SPDX-License-Identifier: MIT
pkgname=omamobile-device-alioth
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Experimental POCO F3 support: USB access, native firewall and safe power policy"
arch=(aarch64)
url="https://github.com/derekross/omarchy-mobile"
license=(MIT)
depends=(bash python systemd networkmanager openssh iproute2 nftables ufw bluez)

build() {
  cc -O2 -Wall -Wextra -Werror -o "$srcdir/reboot-to" "$startdir/reboot-to.c"
}

check() { "$startdir/test/all"; }

package() { "$startdir/install" "$pkgdir" "$srcdir/reboot-to"; }
