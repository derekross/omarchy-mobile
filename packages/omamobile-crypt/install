#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omamobile-crypt into DESTDIR. Enables nothing.
#   ./install DESTDIR
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
d=${1:?Usage: ./install DESTDIR}
[[ $d == /* && $d != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
install -Dm755 bin/omamobile-pin "$d/usr/bin/omamobile-pin"
install -Dm755 bin/omamobile-encrypt-hold "$d/usr/bin/omamobile-encrypt-hold"
install -Dm644 README.md "$d/usr/share/doc/omamobile-crypt/README.md"
install -Dm644 LICENSE "$d/usr/share/licenses/omamobile-crypt/LICENSE"
install -Dm644 version "$d/usr/share/omamobile/crypt/version"
