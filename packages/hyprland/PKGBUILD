# SPDX-License-Identifier: 0BSD
#
# Omarchy Mobile build of Hyprland for the Pixel 7 Pro.
#
# Derived from Omarchy's hyprland PKGBUILD, 0.57.0-2
# (https://github.com/omacom-io/omarchy-pkgs, pkgbuilds/hyprland at
# 347f3d791489), itself Arch Linux's hyprland PKGBUILD carrying Omarchy's
# nvidia-egl-teardown, wl-output-global-grace and monitor-rule-vrr patches
# (unchanged here). Omarchy Mobile changes:
#  - 0001-dpms-keep-retrying-a-refused-dpms-commit.patch: Hyprland retried a
#    refused DPMS commit once, so DPMS off was lost whenever a client kept
#    a page flip in flight (device/cheetah/DISPLAY-PLAN.md, D3b-1). Drop it
#    once upstream retries.
#  - 0002-render-hold-the-last-frame-across-a-rotation.patch: after a
#    rotation, Hyprland drew the clients' old buffers stretched over the
#    turned output until each redrew (stripes, half-empty pages, for 200 ms
#    to a second on a Pixel 7). The output now keeps its last frame until
#    every layer surface has drawn at its new size, then turns the new
#    frame in as Android does (283 ms, 383 for a half turn, the old frame
#    fading out over it on Android's alpha-out curve).
#    Only with OMAMOBILE_ROTATION_HOLD=1 in Hyprland's environment, which
#    device-panther sets; other phones rotate as before.
#  - pkgrel 3.2: the higher of Omarchy's (0.57.0-2) and Arch Linux ARM's
#    (0.57.0-3) release plus .1, so it sorts above both, and .2 for the
#    rotation hold (3.1 is published); [omamobile] comes before [omarchy] and
#    [extra] in pacman.conf, so pacman takes this build either way.
#  - pkgrel 3.3: the rotation hold's half turn over Android's 383 ms and the
#    old frame faded out on Android's alpha-out curve (3.2 is published).
#  - arch=(aarch64) only.
#  - build() runs the two cmake steps of `make release` itself, with
#    CMAKE_SKIP_RPATH (Arch's Makefile sed) and the job count from MAKEFLAGS
#    instead of nproc: a full -j8 can run the phone out of memory.
#
# Maintainer of the original: Caleb Maclennan; contributors
# ThatOneCalculator, Brenno Lemos, Gabriel Fox.

pkgname=(hyprland hyprpm)
pkgver=0.57.0
pkgrel=3.3
pkgdesc='a highly customizable dynamic tiling Wayland compositor (Omarchy Mobile: DPMS retry, rotation hold)'
arch=(aarch64)
url="https://github.com/hyprwm/Hyprland"
license=(BSD-3-Clause)
depends=(cairo # libcairo.so
         aquamarine
         libgcc # libgcc_s.so
         'libstdc++' # libstdc++.so
         glibc # libc.so libm.so
         glib2
         glslang # libglslang-default-resource-limits.so libglslang.so
         hyprcursor
         hyprgraphics
         hyprland-guiutils
         hyprlang
         hyprutils
         hyprwire
         lcms2
         libcanberra
         libdrm # libdrm.so
         libei
         libglvnd
         libinput # libinput.so
         libx11
         libxcb # libxcb-dri3.so libxcb-present.so libxcb-render.so libxcb-res.so libxcb-shm.so libxcb.so libxcb-xfixes.so libxcb-xinput.so
         libxcomposite # libxcb-composite.so
         libxcursor # libXcursor.so
         libxfixes
         libxkbcommon
         libxrender
         lua # liblua.so
         mesa # libgbm.so
         muparser # libmuparser.so
         opengl-driver
         pango
         pixman
         re2
         sdbus-cpp
         tomlplusplus
         util-linux-libs
         wayland
         wayland-protocols
         xcb-proto
         xcb-util
         xcb-util-errors # libxcb-errors.so
         xcb-util-image
         xcb-util-keysyms
         xcb-util-renderutil # libxcb-render-util.so
         xcb-util-wm # libxcb-ewmh.so  libxcb-icccm.so
         xorg-xwayland)
makedepends=(cmake
             glaze
             hyprland-protocols
             hyprwayland-scanner
             meson
             ninja
             xorgproto)
optdepends=('hyprpm: build and install plugins'
            'hyprshutdown: clean logout and shutdown helper'
            'xdg-desktop-portal-hyprland: xdg-desktop-portal backend for hyprland')
provides=(wayland-compositor)
_archive="Hyprland-$pkgver"
source=("$_archive.tar.gz::$url/releases/download/v$pkgver/source-v$pkgver.tar.gz"
        nvidia-egl-teardown.patch
        wl-output-global-grace.patch
        monitor-rule-vrr.patch
        0001-dpms-keep-retrying-a-refused-dpms-commit.patch
        0002-render-hold-the-last-frame-across-a-rotation.patch)
sha256sums=('82d006ba9264fe67266c7d583c16f1a6c64d51424dbdc472c3e9c9d5ddfcd559'
            '26d62139b8ae55e286bcdff1838a6bc01a021d8f1039b40b8fa523df83f61610'
            '8fa0f57dc1b3246ab4e30ae81419150f4af7767fb31e739e36c824c6d99fab73'
            'c14fb0ec02d97100bcfa4e5c8daaf524972fa5c665e04960619744ba01c73c39'
            'a5670d9a6cdee3f3990a81cdecfd5e1f95771ebd1d7b1e2622ac7187684b8836'
            'c69e64fe55a25a7baa2751ff795ae1f8a1ddfc1d162b9b35f9d821675be02bb7')

prepare() {
	ln -sf hyprland-source "$_archive"
	cd "$_archive"
	# Omarchy's: release the EGL context before teardown; NVIDIA's EGL crashes on exit otherwise
	patch -Np1 --fuzz=0 -i "$srcdir/nvidia-egl-teardown.patch"
	# Omarchy's: wait before destroying a wl_output global that clients may still be binding
	patch -Np1 --fuzz=0 -i "$srcdir/wl-output-global-grace.patch"
	# Omarchy's: a reload ignored a monitor rule's vrr unless something else about the rule changed
	patch -Np1 --fuzz=0 -i "$srcdir/monitor-rule-vrr.patch"
	# Omarchy Mobile: retry a refused DPMS commit for up to a second
	patch -Np1 --fuzz=0 -i "$srcdir/0001-dpms-keep-retrying-a-refused-dpms-commit.patch"
	# Omarchy Mobile: hold the last frame across a rotation until the layers have drawn, then turn it in as Android does
	patch -Np1 --fuzz=0 -i "$srcdir/0002-render-hold-the-last-frame-across-a-rotation.patch"
	sed -i -e '/find_package.glaze/s/7...<8 //' {.,hyprpm,start}/CMakeLists.txt
}

build() {
	cd "$_archive"
	# `make release`, with Arch's CMAKE_SKIP_RPATH and our job count
	local jobs
	jobs=$(grep -oE -- '-j ?[0-9]+' <<<"${MAKEFLAGS:-}" | tr -dc 0-9)
	cmake --no-warn-unused-cli -DCMAKE_BUILD_TYPE:STRING=Release \
		-DCMAKE_INSTALL_PREFIX:STRING=/usr -DCMAKE_SKIP_RPATH=ON -S . -B ./build
	cmake --build ./build --config Release --target all -j"${jobs:-4}"
}

package_hyprland() {
	depends+=(libEGL.so
	          libGLESv2.so
	          libaquamarine.so
	          libcanberra.so
	          libeis.so
	          libgio-2.0.so
	          libgobject-2.0.so
	          libhyprcursor.so
	          libhyprgraphics.so
	          libhyprlang.so
	          libhyprutils.so
	          libhyprwire.so
	          liblcms2.so
	          libpango-1.0.so
	          libpangocairo-1.0.so
	          libpixman-1.so
	          libre2.so
	          libreadline.so
	          libsdbus-c++.so
	          libtomlplusplus.so
	          libuuid.so
	          libwayland-server.so
	          libxkbcommon.so)
	cd "$_archive"
	make DESTDIR="$pkgdir" install
	rm -fv "$pkgdir/usr/include/hyprland/src/version.h.in"
	find "$pkgdir" -name '*hyprpm*' -delete
	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
}

package_hyprpm() {
	pkgdesc='Plugin manager for Hyprland'
	depends=(cmake
	         cpio
	         glaze
	         hyprland
	         hyprland-protocols
	         hyprwayland-scanner
	         meson)
	cd "$_archive"
	make DESTDIR="$pkgdir" install
	find "$pkgdir" -type f,l -not -name '*hyprpm*' -delete
	find "$pkgdir" -type d -empty -delete
	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
}
