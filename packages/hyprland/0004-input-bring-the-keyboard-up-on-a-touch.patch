 #include "../../protocols/TextInputV3.hpp"
 #include "../../protocols/InputMethodV2.hpp"
 #include "../../protocols/core/Compositor.hpp"
+#include "../eventLoop/EventLoopManager.hpp"
+#include "../eventLoop/EventLoopTimer.hpp"
+#include <chrono>
+#include <cstdlib>
+#include <string_view>
+
+// OMAMOBILE_IME_ON_TOUCH=1 (read once): a text field that takes focus on its
+// own, as Chromium's address bar does when a window opens, does not bring up
+// the on-screen keyboard; it comes up when the field is touched, as on
+// Android. A field enabled within 800 ms of a touch or click activates the
+// input method at once. One enabled without it waits: 200 ms after the next
+// touch or click ends, if it is still the focused, enabled field (the tap was
+// on it, not on a link that took the focus away), it activates. Clients such
+// as Chromium send no text-input request after that tap until the input
+// method is active, so the compositor has to decide. Only a touch or click on
+// the field's own client counts: a back gesture or a tap on a recent app's
+// card (the shell's surfaces) that brings an app forward leaves it down.
+static bool imeOnTouch() {
+    static const bool ON = [] {
+        const char* e = std::getenv("OMAMOBILE_IME_ON_TOUCH");
+        return e && std::string_view{e} == "1";
+    }();
+    return ON;
+}
+
+static bool pressedOn(SP<CWLSurfaceResource> surface) {
+    const auto PRESSED = g_pInputManager->m_lastPressSurface.lock();
+    return surface && PRESSED && PRESSED->client() == surface->client();
+}
+
+static bool pressedRecentlyOn(SP<CWLSurfaceResource> surface) {
+    return std::chrono::steady_clock::now() - g_pInputManager->m_lastPressTime < std::chrono::milliseconds(800) && pressedOn(surface);
+}
+
+void CTextInput::activateDeferredIME() {
+    if (!m_imeDeferred || !isEnabled() || !pressedOn(focusedSurface()))
+        return;
+
+    LOG(Log::DEBUG, "TI touched: activating the input method");
+    m_imeDeferred = false;
+    g_pInputManager->m_relay.activateIME(this);
+}
+
+void textInputPressEnded() {
+    if (!imeOnTouch())
+        return;
+
+    static SP<CEventLoopTimer> timer;
+    if (!timer) {
+        timer = makeShared<CEventLoopTimer>(
+            std::nullopt,
+            [](SP<CEventLoopTimer> self, void* data) {
+                const auto TI = g_pInputManager->m_relay.getFocusedTextInput();
+                if (TI)
+                    TI->activateDeferredIME();
+            },
+            nullptr);
+        g_pEventLoopManager->addTimer(timer);
+    }
+
+    timer->updateTimeout(std::chrono::milliseconds(200));
+}
 
