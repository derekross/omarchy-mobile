#!/bin/bash
# SPDX-License-Identifier: MIT
# Tests for omamobile-device-husky. reboot-to is compiled from
# src/reboot-to.c in this directory, so a copied package still builds.
# Do not execute reboot-to.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

bash -n build || fail "build parses"
bash -n install || fail "install parses"
bash -n bin/omamobile-husky-display-start || fail "the display start parses"
pass "scripts parse"

grep -q '\.\./\.\.' build install && fail "build or install reaches outside the package directory"
pass "build and install stay inside the package directory"

if [[ -f ../omamobile-device-cheetah/src/reboot-to.c ]]; then
  cmp -s src/reboot-to.c ../omamobile-device-cheetah/src/reboot-to.c \
    || fail "reboot-to.c drifted from the cheetah package"
  pass "reboot-to.c matches the cheetah source"
  cmp -s vendor/udev/rules.d/10-omamobile-storage.rules \
    ../omamobile-device-cheetah/vendor/udev/rules.d/10-omamobile-storage.rules \
    || fail "the storage rule drifted from the cheetah package"
  pass "the storage rule matches the cheetah package"
  cmp -s etc/omamobile-mirrorlist ../omamobile-device-cheetah/etc/omamobile-mirrorlist \
    || fail "the mirrorlist drifted from the cheetah package"
  pass "the mirrorlist matches the cheetah package"
  cmp -s <(sed -n '/^# --- the \[omamobile\] channel/,$p' omamobile-device-husky.install) \
    <(sed -n '/^# --- the \[omamobile\] channel/,$p' ../omamobile-device-cheetah/omamobile-device-cheetah.install) \
    || fail "the install script's channel handling drifted from the cheetah package"
  pass "the install script keeps the [omamobile] channel as the cheetah package does"
  cmp -s vendor/systemd/logind.conf.d/10-omamobile-power-key.conf \
    ../omamobile-device-cheetah/vendor/systemd/logind.conf.d/10-omamobile-power-key.conf \
    || fail "the power-key drop-in drifted from the cheetah package"
  pass "the power-key drop-in matches the cheetah package"
  cmp -s omamobile-device-husky.install \
    ../omamobile-device-cheetah/omamobile-device-cheetah.install \
    || fail "the pacman install script drifted from the cheetah package"
  pass "the pacman install script matches the cheetah package"
fi
# The sleep drop-in: suspend-to-idle only, one state so a refused sleep isn't
# tried a second time (#619), and nothing that hibernates. Checked by its
# settings, as the 9a's package does: the 7 Pro's copy gets SuspendState in a
# change of its own.
sleepconf=vendor/systemd/sleep.conf.d/10-omamobile.conf
[[ $(grep -v '^#' "$sleepconf" | grep -c .) -eq 6 && $(grep -v '^#' "$sleepconf" | sed -n 1p) == "[Sleep]" ]] || fail "the sleep drop-in has other lines than its five settings"
for line in SuspendState=freeze MemorySleepMode=s2idle AllowHibernation=no AllowHybridSleep=no AllowSuspendThenHibernate=no; do
  grep -qx "$line" "$sleepconf" || fail "the sleep drop-in lacks $line"
done
pass "the sleep drop-in: one sleep state (freeze), s2idle, no hibernation"
grep -q 'omamobile-keyring' PKGBUILD || fail "pacman needs omamobile-keyring"
grep -q '^install=omamobile-device-husky.install$' PKGBUILD \
  || fail "the pacman install script is not named"
[[ -f etc/omamobile-mirrorlist && -f omamobile-device-husky.install ]] \
  || fail "the pacman mirrorlist or install script is missing"
pass "pacman gets the keyring, the mirrorlist, and the install script"
if [[ -f ../../device/husky/device.conf ]]; then
  cmp -s device.conf ../../device/husky/device.conf \
    || fail "device.conf drifted from the descriptor"
  pass "device.conf matches the descriptor"
fi

./build "$tmp/build" || fail "reboot-to compiles"
[[ -x $tmp/build/reboot-to ]] || fail "reboot-to is not executable"
pass "reboot-to compiles"

./install "$tmp/root" "$tmp/build"
for f in usr/bin/reboot-to \
         usr/lib/udev/rules.d/10-omamobile-storage.rules \
         usr/lib/systemd/network/20-usb-gadget.network \
         usr/lib/systemd/logind.conf.d/10-omamobile-power-key.conf \
         usr/lib/NetworkManager/conf.d/10-omamobile-usb.conf \
         etc/NetworkManager/conf.d/zz-omamobile-wifi-powersave.conf \
         usr/lib/systemd/sleep.conf.d/10-omamobile.conf \
         usr/lib/modprobe.d/omamobile-husky-clk-acpm.conf \
         usr/lib/modprobe.d/omamobile-husky-display.conf \
         usr/lib/systemd/system/omamobile-husky-display.service \
         usr/lib/systemd/system/display-manager.service.d/10-omamobile-husky.conf \
         usr/lib/modprobe.d/omamobile-max77759.conf \
         usr/bin/omamobile-usb-rescue \
         usr/lib/systemd/system/omamobile-usb-rescue.service \
         usr/lib/systemd/system/plymouth-quit.service.d/10-omamobile-retain-splash.conf \
         usr/bin/omamobile-bt-addr usr/lib/systemd/system/omamobile-bt-addr@.service \
         usr/lib/udev/rules.d/80-omamobile-bt-addr.rules \
         usr/share/omamobile/device.conf \
         usr/share/omamobile/charge-limit.conf \
         usr/lib/udev/rules.d/75-omamobile-charge-limit.rules \
         usr/lib/systemd/system/omamobile-charge-limit-apply.service \
         usr/share/omamobile/device-husky/version \
         usr/share/licenses/omamobile-device-husky/LICENSE \
         etc/pacman.d/omamobile-mirrorlist; do
  [[ -f $tmp/root/$f ]] || fail "install stages $f"
done
grep -qx 'MemorySleepMode=s2idle' "$tmp/root/usr/lib/systemd/sleep.conf.d/10-omamobile.conf" \
  || fail "suspend must use s2idle: the kernel's default is deep, which zuma can't wake from yet"
grep -qx 'AllowHibernation=no' "$tmp/root/usr/lib/systemd/sleep.conf.d/10-omamobile.conf" \
  || fail "there is no swap to hibernate to"
grep -q 'KERNEL=="sda", MODE="0000"' "$tmp/root/usr/lib/udev/rules.d/10-omamobile-storage.rules" \
  || fail "the whole-disk node is made inaccessible"
grep -q 'ID_PART_ENTRY_NAME}!="userdata"' "$tmp/root/usr/lib/udev/rules.d/10-omamobile-storage.rules" \
  || fail "userdata is the only partition desktop tools may see"
grep -q 'Address=172.16.42.1/24' "$tmp/root/usr/lib/systemd/network/20-usb-gadget.network" \
  || fail "usb0 keeps the initramfs address"
power="$tmp/root/usr/lib/systemd/logind.conf.d/10-omamobile-power-key.conf"
grep -qx '\[Login\]' "$power" \
  || fail "the power-key drop-in needs a [Login] header"
grep -q '^HandlePowerKey=ignore$' "$power" \
  || fail "a short press must not power the phone off"
grep -q '^HandlePowerKeyLongPress=ignore$' "$power" \
  || fail "the long press stays the PMIC reset"
grep -qE '^options clk_acpm zuma_gpu_max_khz=[0-9]+$' "$tmp/root/usr/lib/modprobe.d/omamobile-husky-clk-acpm.conf" \
  || fail "the GPU DVFS ceiling is set"
grep -qE '^install ' vendor/modprobe.d/*.conf && fail "an install line in modprobe.d would break the display start's modprobe"
grep -qx 'blacklist gs_decon' "$tmp/root/usr/lib/modprobe.d/omamobile-husky-display.conf" \
  || fail "gs_decon autoloads ahead of the display start"
grep -qx 'options gs_decon screen_off=2' "$tmp/root/usr/lib/modprobe.d/omamobile-husky-display.conf" \
  || fail "DPMS off leaves the panel awake, showing black frames"
[[ $(grep -h '^blacklist ' vendor/modprobe.d/omamobile-husky-display.conf) == 'blacklist gs_decon' ]] \
  || fail "the display file guards only gs_decon"
[[ -x $tmp/root/usr/bin/omamobile-husky-display-start ]] || fail "install stages the display start"
[[ $(readlink "$tmp/root/usr/lib/systemd/system/multi-user.target.wants/omamobile-husky-display.service") == ../omamobile-husky-display.service ]] \
  || fail "the display start is not enabled"
grep -qx 'After=omamobile-husky-display.service' "$tmp/root/usr/lib/systemd/system/display-manager.service.d/10-omamobile-husky.conf" \
  || fail "the display manager can start before the display driver"
grep -qx 'ConditionPathExists=/sys/bus/platform/devices/19470000.display-controller' "$tmp/root/usr/lib/systemd/system/omamobile-husky-display.service" \
  || fail "the display start runs (and fails) on a kernel without DECON0"
# modprobe.d only sets options, except the display file (gs_decon), the
# MAX77759 file, which keeps the charger and the Type-C driver from loading
# before their bring-up steps (as on the Pixel 7 Pro), and the AoC file, which
# leaves the AoC stack to the hang-safe start script: blacklist only, so a
# manual modprobe still works.
for conf in vendor/modprobe.d/*.conf; do
  [[ $conf == vendor/modprobe.d/omamobile-max77759.conf || $conf == vendor/modprobe.d/omamobile-husky-display.conf ||
        $conf == vendor/modprobe.d/omamobile-husky-aoc.conf ]] && continue
  ! grep -qE '^(install|blacklist) ' "$conf" || fail "$conf only sets options"
done
conf=vendor/modprobe.d/omamobile-max77759.conf
! grep -qE '^install ' "$conf" || fail "the MAX77759 file only blacklists, a manual modprobe must still work"
for m in max77759_charger tcpci_maxim gpio_max77759 nvmem_max77759; do
  grep -qx "blacklist $m" "$conf" || fail "$m is kept from autoloading"
done
! grep -qE '^blacklist (max17042_battery|max77759)$' "$conf" || fail "the fuel gauge and the MFD core keep autoloading"
pass "the MAX77759 cell drivers and the Type-C driver are blacklisted, the gauge and the MFD core are not"
bash -n bin/omamobile-usb-rescue || fail "the USB rescue parses"
grep -q '10cb0000.i2c' bin/omamobile-usb-rescue || fail "the USB rescue watches husky's bus (hsi2c_11)"
grep -q 'i2cset -f -y "$bus" $tcpc 0x93 0x09' bin/omamobile-usb-rescue || fail "the USB rescue closes the data switch"
[[ $(grep -c 'i2cset' bin/omamobile-usb-rescue) -eq 1 ]] || fail "the USB rescue writes one register only"
grep -q '^ExecStart=/usr/bin/omamobile-usb-rescue$' vendor/systemd/system/omamobile-usb-rescue.service \
  || fail "the USB rescue unit runs the script"
[[ $(readlink "$tmp/root/usr/lib/systemd/system/multi-user.target.wants/omamobile-usb-rescue.service") == ../omamobile-usb-rescue.service ]] \
  || fail "the USB rescue is enabled by a vendor wants link"
grep -q 'i2c-tools' PKGBUILD || fail "the USB rescue needs i2cget and i2cset"
pass "the USB replug rescue is installed, enabled by a wants link, and writes one register"
# The omarchy-trace Plymouth theme (#266): 30 frames rendered from Omarchy's
# logo by tools/gen-plymouth-trace.py, and the script and .plymouth file that
# name them.
theme=$tmp/root/usr/share/plymouth/themes/omarchy-trace
[[ -f $theme/omarchy-trace.plymouth && -f $theme/omarchy-trace.script ]] || fail "the trace theme's .plymouth or .script is not staged"
grep -qx 'ModuleName=script' "$theme/omarchy-trace.plymouth" || fail "the trace theme must use the script module"
grep -qx 'ScriptFile=/usr/share/plymouth/themes/omarchy-trace/omarchy-trace.script' "$theme/omarchy-trace.plymouth" \
  || fail "the .plymouth file names another script"
grep -qx 'ImageDir=/usr/share/plymouth/themes/omarchy-trace' "$theme/omarchy-trace.plymouth" || fail "the .plymouth file names another image dir"
frames=$(find "$theme" -name 'trace-[0-9][0-9].png' | wc -l)
((frames == 30)) || fail "the trace theme has $frames frames, not 30"
grep -q 'global.frame_count = 30;' "$theme/omarchy-trace.script" || fail "the script's frame count is not 30"
grep -q '"trace-0" + i + ".png"' "$theme/omarchy-trace.script" && grep -q '"trace-" + i + ".png"' "$theme/omarchy-trace.script" \
  || fail "the script does not load the trace-NN.png frames"
for n in $(seq -w 1 30); do
  [[ $(head -c 8 "$theme/trace-$n.png" | od -An -tx1 | tr -d ' ') == 89504e470d0a1a0a ]] || fail "trace-$n.png is not a PNG"
  [[ $(od -An -tu1 -j16 -N8 "$theme/trace-$n.png" | awk '{print $3*256+$4 "x" $7*256+$8}') == 800x188 ]] || fail "trace-$n.png is not 800x188"
done
grep -q 'Plymouth.SetQuitFunction(quit_callback);' "$theme/omarchy-trace.script" || fail "a quit must jump to the last frame"
# The held frame must be Omarchy's logo exactly (default/plymouth/logo.png in
# basecamp/omarchy, git blob f185b266), so the end matches the static splash.
# sha256 of that file, pinned so the test needs nothing beyond coreutils.
[[ $(sha256sum < "$theme/trace-30.png") == "ba8f1547a02ab5db64fe3923d0b834a220e2c3798c1674374a0eb92a18dfddfb  -" ]] \
  || fail "trace-30.png is not Omarchy's logo.png"
pass "the last trace frame is Omarchy's logo.png unchanged"
pass "the omarchy-trace theme: 30 800x188 frames, and the script and .plymouth file name them"
splash=vendor/systemd/system/plymouth-quit.service.d/10-omamobile-retain-splash.conf
if [[ -f ../omamobile-device-raven/$splash ]]; then
  [[ $(grep -v '^#' "$splash") == "$(grep -v '^#' "../omamobile-device-raven/$splash")" ]] \
    || fail "the retain-splash drop-in drifted from the raven package"
fi
grep -qx 'ExecStart=' "$tmp/root/usr/lib/${splash#vendor/}" \
  || fail "the drop-in must reset ExecStart= first, or the plain plymouth quit runs too"
grep -qx 'ExecStart=-/usr/bin/plymouth quit --retain-splash' "$tmp/root/usr/lib/${splash#vendor/}" \
  || fail "plymouth quit without --retain-splash hangs on gs-decon"
pass "Plymouth quits with --retain-splash, as on raven"
grep -q '^PACKAGE=omamobile-device-husky$' "$tmp/root/usr/share/omamobile/device.conf" \
  || fail "the installed descriptor is husky"
for absent in usr/bin/omamobile-boot-success usr/bin/omamobile-bootctl \
              usr/lib/systemd/system/omamobile-boot-success.service \
              usr/bin/omamobile-wifi-start usr/bin/omamobile-charge-guard \
              usr/bin/omamobile-camera-start; do
  [[ ! -e $tmp/root/$absent ]] || fail "install includes $absent"
done
pass "install stages the udev rule, the USB link, the mirrorlist and the display start, and nothing that marks a slot or starts the radio, the charger or a camera"
[[ ! -e $tmp/root/usr/lib/systemd/logind.conf.d/10-omamobile-lid.conf ]] \
  || fail "husky has no lid: no lid drop-in"
pass "no lid drop-in"
grep -qx 'supply=max77759-charger' "$tmp/root/usr/share/omamobile/charge-limit.conf" \
  || fail "husky declares its charge limit on max77759-charger"
[[ ! -e $tmp/root/usr/lib/systemd/system/multi-user.target.wants/omamobile-charge-limit-apply.service ]] \
  || fail "the apply unit is pulled in by udev, not enabled"
pass "the charge limit declaration, its udev rule and the apply unit are staged; the unit is not enabled"


# --- the AoC start: hang marker, nothing without the node ------------------
bash -n bin/omamobile-husky-aoc-start || fail "the AoC start parses"
grep -q '^ExecStart=/usr/bin/omamobile-husky-aoc-start$' vendor/systemd/system/omamobile-husky-aoc.service \
  || fail "the AoC unit runs the script"
grep -q '^ConditionPathExists=/sys/bus/platform/devices/154b0000.aoc$' vendor/systemd/system/omamobile-husky-aoc.service \
  || fail "the AoC unit needs the AoC node"
[[ $(readlink "$tmp/root/usr/lib/systemd/system/multi-user.target.wants/omamobile-husky-aoc.service") == ../omamobile-husky-aoc.service ]] \
  || fail "the AoC unit is enabled by a vendor wants link"
! grep -qE '^install ' vendor/modprobe.d/omamobile-husky-aoc.conf || fail "the AoC file only blacklists"
! grep -hv '^ *#' bin/omamobile-husky-aoc-start vendor/modprobe.d/omamobile-husky-aoc.conf | grep -c 'speaker_protection' >/dev/null \
  || fail "the AoC start never raises the speaker ceiling"
for m in gsa aoc_core aoc_alsa_dev snd_soc_cs35l41_spi gs201_aoc_boot; do
  grep -qx "blacklist $m" vendor/modprobe.d/omamobile-husky-aoc.conf || fail "$m is kept from autoloading"
done
pass "the AoC unit is installed, enabled by a wants link, and only the start script loads the AoC stack"
aoc=$tmp/aoc; mkdir -p "$aoc/bin" "$aoc/state"
printf '#!/bin/sh\necho "$*" >> %s/modprobe.log\n' "$aoc" > "$aoc/bin/modprobe"
printf '#!/bin/sh\nexit 0\n' > "$aoc/bin/sync"
chmod +x "$aoc/bin/modprobe" "$aoc/bin/sync"
# the script writes state to /var/lib/omamobile: run a copy with it pointed at the temp dir
sed "s|^state=/var/lib/omamobile|state=$aoc/state|; s|^loaded=.*|loaded=$aoc/run/aoc-firmware-loaded|" bin/omamobile-husky-aoc-start > "$aoc/start"
runaoc() { PATH=$aoc/bin:$PATH OMAMOBILE_AOC_NODE=$aoc/node OMAMOBILE_ASOUND_CARDS=$aoc/cards \
           OMAMOBILE_TRUSTY_STATUS=$aoc/trusty bash "$aoc/start" "$@" 2>&1; }
: > "$aoc/cards"
out=$(runaoc); rc=$?
[[ $rc -eq 0 && $out == *"nothing to do"* && ! -e $aoc/modprobe.log ]] || fail "without the AoC node nothing is loaded"
mkdir -p "$aoc/node"; echo okay > "$aoc/trusty"
date -Is > "$aoc/state/aoc-bringup-started"
out=$(runaoc); rc=$?
[[ $rc -eq 0 && $out == *"never finished"* && ! -e $aoc/modprobe.log ]] || fail "a marker left by a hung boot keeps the AoC off"
out=$(runaoc --retry) || true
[[ $out != *"never finished"* ]] || fail "--retry clears the marker"
[[ ! -e $aoc/state/aoc-bringup-started ]] || fail "a clean failure removes the marker (no firmware here)"
pass "the AoC start does nothing without the node, honours a hang marker, and --retry tries again"
# the Trusty node is found at the root and under soc@0 (the 8 Pro's layout)
rm -f "$aoc/trusty"; : > "$aoc/cards"; rm -rf "$aoc/dt" "$aoc/state/"* "$aoc/modprobe.log"
mkdir -p "$aoc/dt/soc@0/trusty"; echo okay > "$aoc/dt/soc@0/trusty/status"
out=$(PATH=$aoc/bin:$PATH OMAMOBILE_AOC_NODE=$aoc/node OMAMOBILE_ASOUND_CARDS=$aoc/cards OMAMOBILE_DT_ROOT=$aoc/dt bash "$aoc/start" 2>&1) || true
[[ $out != *"Trusty is not enabled"* ]] || fail "a Trusty node under soc@0 is found"
rm -rf "$aoc/dt"; mkdir -p "$aoc/dt/trusty"; echo okay > "$aoc/dt/trusty/status"
out=$(PATH=$aoc/bin:$PATH OMAMOBILE_AOC_NODE=$aoc/node OMAMOBILE_ASOUND_CARDS=$aoc/cards OMAMOBILE_DT_ROOT=$aoc/dt bash "$aoc/start" 2>&1) || true
[[ $out != *"Trusty is not enabled"* ]] || fail "a Trusty node at the root is found"
rm -rf "$aoc/dt"; mkdir -p "$aoc/dt"
out=$(PATH=$aoc/bin:$PATH OMAMOBILE_AOC_NODE=$aoc/node OMAMOBILE_ASOUND_CARDS=$aoc/cards OMAMOBILE_DT_ROOT=$aoc/dt bash "$aoc/start" 2>&1) || true
[[ $out == *"Trusty is not enabled"* ]] || fail "no Trusty node means the AoC stays off"
echo okay > "$aoc/trusty"; rm -rf "$aoc/state/"* "$aoc/modprobe.log"
pass "the Trusty node is found at the root or under soc@0, and its absence keeps the AoC off"
# the once-per-boot guards: nothing may reach the firmware file
rm -rf "$aoc/state/"* "$aoc/modprobe.log"; : > "$aoc/node/firmware"
mkdir -p "$aoc/run"; date -Is > "$aoc/run/aoc-firmware-loaded"
rc=0; out=$(runaoc) || rc=$?
[[ $rc -eq 1 && $out == *"already started this boot"* ]] || fail "a /run marker refuses a second start"
[[ ! -s $aoc/node/firmware && ! -e $aoc/modprobe.log && ! -e $aoc/state/aoc-bringup-started ]] \
  || fail "a second start in the same boot wrote to firmware or loaded modules"
rc=0; out=$(runaoc --retry) || rc=$?
[[ $rc -eq 1 && ! -s $aoc/node/firmware && ! -e $aoc/modprobe.log ]] || fail "--retry does not get past the /run marker"
rm -f "$aoc/run/aoc-firmware-loaded"
printf 'Services : 94\n0 : "control" mbox 0\n' > "$aoc/node/services"
out=$(runaoc); rc=$?
[[ $rc -eq 0 && $out == *"already online: Services : 94"* && ! -s $aoc/node/firmware && ! -e $aoc/modprobe.log ]] \
  || fail "an AoC that is already online is left alone"
printf 'Services : 0\n' > "$aoc/node/services"
out=$(runaoc) || true; [[ $out != *"already online"* ]] || fail "Services : 0 is not online"
rm -f "$aoc/node/services"
pass "a /run marker or an online AoC stops a second start before anything is loaded or written to firmware"

test/display-start || fail "test/display-start"
pass "the display start loads gs_decon after allowing DSI commands for google-hk3 only"

# USB is the last gateway: its route outlives an unplug, so ahead of Wi-Fi
# it sent IPv4 into a dead cable (seen on raven, 2026-10-28).
net=vendor/systemd/network/20-usb-gadget.network
! sed -n '/^\[Network\]/,/^\[/p' "$net" | grep -c '^Gateway=' >/dev/null || fail "usb0 sets no default route in [Network] (metric 0)"
metric=$(sed -n '/^\[Route\]/,/^\[/{s/^Metric=//p}' "$net")
[[ ${metric:-0} -gt 700 ]] || fail "usb0's gateway goes after Wi-Fi (600) and mobile data (700)"
pass "USB is the last gateway"

# The Bluetooth address: the 9a's script, rule and unit, with the chip name
# (and the placeholder it describes) changed for the BCM4398.
# Only from the repository, as the cheetah comparisons above.
tegu=../omamobile-device-tegu
if [[ -d $tegu ]]; then
  for f in bin/omamobile-bt-addr vendor/systemd/system/omamobile-bt-addr@.service \
           vendor/udev/rules.d/80-omamobile-bt-addr.rules; do
    diff <(sed -e s/BCM4383/BCM4398/g -e "s/(43:89:00:00:..)/(43:98:D0:..)/" "$tegu/$f") "$f" >/dev/null ||
      fail "$f is the 9a's with the BCM4398 named"
  done
  pass "the Bluetooth address script, rule and unit are the 9a's with the BCM4398 named"
fi
bash -n bin/omamobile-bt-addr || fail "the Bluetooth address script parses"
grep -q 'chosen/config/bt_addr' bin/omamobile-bt-addr || fail "the Bluetooth address comes from the bootloader's DT"
grep -q 'DRIVERS=="hci_uart_bcm"' vendor/udev/rules.d/80-omamobile-bt-addr.rules || fail "the rule matches the BCM UART controller only"
pass "the Bluetooth address is read at run time, with the 9a's script"
ps="$tmp/root/etc/NetworkManager/conf.d/zz-omamobile-wifi-powersave.conf"
grep -qx '\[connection\]' "$ps" || fail "the Wi-Fi power save file needs a [connection] header"
grep -qx 'wifi.powersave=3' "$ps" || fail "Wi-Fi power save is on by default (3 = enable)"
pass "Wi-Fi power save is on by default"

# The address unit is for a controller (DEVTYPE host) only: a connection to a
# device is hciN:HANDLE in the same subsystem (DEVTYPE link), and its unit
# failed ("not a controller") at every connect.
r=vendor/udev/rules.d/80-omamobile-bt-addr.rules
grep -c '^ACTION=="add", SUBSYSTEM=="bluetooth", KERNEL=="hci\[0-9\]\*", ENV{DEVTYPE}=="host", .*omamobile-bt-addr@%k\.service"$' "$r" >/dev/null ||
  fail "the Bluetooth address rule matches controllers only (DEVTYPE host), not their connections"
pass "the Bluetooth address rule matches controllers only, not their connections"

