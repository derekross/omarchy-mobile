[[ $(caps) == "1704000 1945000 2294000 890000000" ]] || fail "56-57 C holds: $(caps)"
temp 58000 1; run --tick
[[ $(caps) == "1328000 1418000 2049000 467000000" ]] || fail "58 C steps every cap down one level: $(caps)"
temp 60000 3; run --tick
[[ $(caps) == "324000 402000 500000 150000000" ]] || fail "60 C floors everything: $(caps)"
load=40; temp 57000 3; temp 56000 1; run --tick
[[ $(caps) == "324000 402000 500000 150000000" ]] || fail "56-57 C and busy holds the floor: $(caps)"
