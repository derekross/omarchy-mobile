rm -rf "$tmp/run"
echo 1328000 > "$cpu/policy0/scaling_max_freq"; echo 1945000 > "$cpu/policy4/scaling_max_freq"
echo 2294000 > "$cpu/policy8/scaling_max_freq"; echo 890000000 > "$gpu/max_freq"
load=95
