ju=(0 0 0 0 0 0 0 0); ji=(0 0 0 0 0 0 0 0); jw=(0 0 0 0 0 0 0 0); load=0
sq --tick; [[ $(cpus) == 0-7 ]] || fail "a counter going backwards holds the squeeze: $(cpus)"
