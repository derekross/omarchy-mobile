for _ in 1 2 3 4; do sq --tick 2>>"$tmp/idle.err"; done
[[ $(caps) == "324000 402000 500000 150000000" && -z $(cpus) ]] || fail "hot and idle: caps floored, no squeeze: $(caps) [$(cpus)]"
[[ $(grep -c 'heat is not from the CPU' "$tmp/idle.err") == 1 ]] || fail "hot and idle logs why exactly once: $(grep -c 'heat is not' "$tmp/idle.err")"
