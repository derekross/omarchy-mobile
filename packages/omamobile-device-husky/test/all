#!/bin/bash
# SPDX-License-Identifier: MIT
# Tests for omamobile-device-husky. reboot-to is compiled from
# src/reboot-to.c in this directory, so a copied package still builds.
# Do not execute reboot-to.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

bash -n build || fail "build parses"
bash -n install || fail "install parses"
bash -n bin/omamobile-husky-display-start || fail "the display start parses"
pass "scripts parse"

grep -q '\.\./\.\.' build install && fail "build or install reaches outside the package directory"
pass "build and install stay inside the package directory"

if [[ -f ../omamobile-device-cheetah/src/reboot-to.c ]]; then
  cmp -s src/reboot-to.c ../omamobile-device-cheetah/src/reboot-to.c \
    || fail "reboot-to.c drifted from the cheetah package"
  pass "reboot-to.c matches the cheetah source"
  cmp -s vendor/udev/rules.d/10-omamobile-storage.rules \
    ../omamobile-device-cheetah/vendor/udev/rules.d/10-omamobile-storage.rules \
    || fail "the storage rule drifted from the cheetah package"
  pass "the storage rule matches the cheetah package"
  cmp -s etc/omamobile-mirrorlist ../omamobile-device-cheetah/etc/omamobile-mirrorlist \
    || fail "the mirrorlist drifted from the cheetah package"
  pass "the mirrorlist matches the cheetah package"
  cmp -s vendor/systemd/logind.conf.d/10-omamobile-power-key.conf \
    ../omamobile-device-cheetah/vendor/systemd/logind.conf.d/10-omamobile-power-key.conf \
    || fail "the power-key drop-in drifted from the cheetah package"
  pass "the power-key drop-in matches the cheetah package"
  cmp -s omamobile-device-husky.install \
    ../omamobile-device-cheetah/omamobile-device-cheetah.install \
    || fail "the pacman install script drifted from the cheetah package"
  pass "the pacman install script matches the cheetah package"
fi
grep -q 'omamobile-keyring' PKGBUILD || fail "pacman needs omamobile-keyring"
grep -q '^install=omamobile-device-husky.install$' PKGBUILD \
  || fail "the pacman install script is not named"
[[ -f etc/omamobile-mirrorlist && -f omamobile-device-husky.install ]] \
  || fail "the pacman mirrorlist or install script is missing"
pass "pacman gets the keyring, the mirrorlist, and the install script"
if [[ -f ../../device/husky/device.conf ]]; then
  cmp -s device.conf ../../device/husky/device.conf \
    || fail "device.conf drifted from the descriptor"
  pass "device.conf matches the descriptor"
fi

./build "$tmp/build" || fail "reboot-to compiles"
[[ -x $tmp/build/reboot-to ]] || fail "reboot-to is not executable"
pass "reboot-to compiles"

./install "$tmp/root" "$tmp/build"
for f in usr/bin/reboot-to \
         usr/lib/udev/rules.d/10-omamobile-storage.rules \
         usr/lib/systemd/network/20-usb-gadget.network \
         usr/lib/systemd/logind.conf.d/10-omamobile-power-key.conf \
         usr/lib/NetworkManager/conf.d/10-omamobile-usb.conf \
         usr/lib/modprobe.d/omamobile-husky-clk-acpm.conf \
         usr/lib/modprobe.d/omamobile-husky-display.conf \
         usr/lib/systemd/system/omamobile-husky-display.service \
         usr/lib/systemd/system/display-manager.service.d/10-omamobile-husky.conf \
         usr/lib/modprobe.d/omamobile-max77759.conf \
         usr/bin/omamobile-usb-rescue \
         usr/lib/systemd/system/omamobile-usb-rescue.service \
         usr/share/omamobile/device.conf \
         usr/share/omamobile/device-husky/version \
         usr/share/licenses/omamobile-device-husky/LICENSE \
         etc/pacman.d/omamobile-mirrorlist; do
  [[ -f $tmp/root/$f ]] || fail "install stages $f"
done
grep -q 'KERNEL=="sda", MODE="0000"' "$tmp/root/usr/lib/udev/rules.d/10-omamobile-storage.rules" \
  || fail "the whole-disk node is made inaccessible"
grep -q 'ID_PART_ENTRY_NAME}!="userdata"' "$tmp/root/usr/lib/udev/rules.d/10-omamobile-storage.rules" \
  || fail "userdata is the only partition desktop tools may see"
grep -q 'Address=172.16.42.1/24' "$tmp/root/usr/lib/systemd/network/20-usb-gadget.network" \
  || fail "usb0 keeps the initramfs address"
power="$tmp/root/usr/lib/systemd/logind.conf.d/10-omamobile-power-key.conf"
grep -qx '\[Login\]' "$power" \
  || fail "the power-key drop-in needs a [Login] header"
grep -q '^HandlePowerKey=ignore$' "$power" \
  || fail "a short press must not power the phone off"
grep -q '^HandlePowerKeyLongPress=ignore$' "$power" \
  || fail "the long press stays the PMIC reset"
grep -qE '^options clk_acpm zuma_gpu_max_khz=[0-9]+$' "$tmp/root/usr/lib/modprobe.d/omamobile-husky-clk-acpm.conf" \
  || fail "the GPU DVFS ceiling is set"
grep -qE '^install ' vendor/modprobe.d/*.conf && fail "an install line in modprobe.d would break the display start's modprobe"
grep -qx 'blacklist gs_decon' "$tmp/root/usr/lib/modprobe.d/omamobile-husky-display.conf" \
  || fail "gs_decon autoloads ahead of the display start"
grep -qx 'options gs_decon screen_off=2' "$tmp/root/usr/lib/modprobe.d/omamobile-husky-display.conf" \
  || fail "DPMS off leaves the panel awake, showing black frames"
[[ $(grep -h '^blacklist ' vendor/modprobe.d/omamobile-husky-display.conf) == 'blacklist gs_decon' ]] \
  || fail "the display file guards only gs_decon"
[[ -x $tmp/root/usr/bin/omamobile-husky-display-start ]] || fail "install stages the display start"
[[ $(readlink "$tmp/root/usr/lib/systemd/system/multi-user.target.wants/omamobile-husky-display.service") == ../omamobile-husky-display.service ]] \
  || fail "the display start is not enabled"
grep -qx 'After=omamobile-husky-display.service' "$tmp/root/usr/lib/systemd/system/display-manager.service.d/10-omamobile-husky.conf" \
  || fail "the display manager can start before the display driver"
grep -qx 'ConditionPathExists=/sys/bus/platform/devices/19470000.display-controller' "$tmp/root/usr/lib/systemd/system/omamobile-husky-display.service" \
  || fail "the display start runs (and fails) on a kernel without DECON0"
# modprobe.d only sets options, except the display file (gs_decon) and the
# MAX77759 file, which keeps the charger and the Type-C driver from loading
# before their bring-up steps (as on the Pixel 7 Pro): blacklist only, so a
# manual modprobe still works.
for conf in vendor/modprobe.d/*.conf; do
  [[ $conf == vendor/modprobe.d/omamobile-max77759.conf || $conf == vendor/modprobe.d/omamobile-husky-display.conf ]] && continue
  ! grep -qE '^(install|blacklist) ' "$conf" || fail "$conf only sets options"
done
conf=vendor/modprobe.d/omamobile-max77759.conf
! grep -qE '^install ' "$conf" || fail "the MAX77759 file only blacklists, a manual modprobe must still work"
for m in max77759_charger tcpci_maxim gpio_max77759 nvmem_max77759; do
  grep -qx "blacklist $m" "$conf" || fail "$m is kept from autoloading"
done
! grep -qE '^blacklist (max17042_battery|max77759)$' "$conf" || fail "the fuel gauge and the MFD core keep autoloading"
pass "the MAX77759 cell drivers and the Type-C driver are blacklisted, the gauge and the MFD core are not"
bash -n bin/omamobile-usb-rescue || fail "the USB rescue parses"
grep -q '10cb0000.i2c' bin/omamobile-usb-rescue || fail "the USB rescue watches husky's bus (hsi2c_11)"
grep -q 'i2cset -f -y "$bus" $tcpc 0x93 0x09' bin/omamobile-usb-rescue || fail "the USB rescue closes the data switch"
[[ $(grep -c 'i2cset' bin/omamobile-usb-rescue) -eq 1 ]] || fail "the USB rescue writes one register only"
grep -q '^ExecStart=/usr/bin/omamobile-usb-rescue$' vendor/systemd/system/omamobile-usb-rescue.service \
  || fail "the USB rescue unit runs the script"
[[ $(readlink "$tmp/root/usr/lib/systemd/system/multi-user.target.wants/omamobile-usb-rescue.service") == ../omamobile-usb-rescue.service ]] \
  || fail "the USB rescue is enabled by a vendor wants link"
grep -q 'i2c-tools' PKGBUILD || fail "the USB rescue needs i2cget and i2cset"
pass "the USB replug rescue is installed, enabled by a wants link, and writes one register"
grep -q '^PACKAGE=omamobile-device-husky$' "$tmp/root/usr/share/omamobile/device.conf" \
  || fail "the installed descriptor is husky"
for absent in usr/bin/omamobile-boot-success usr/bin/omamobile-bootctl \
              usr/lib/systemd/system/omamobile-boot-success.service \
              usr/bin/omamobile-wifi-start usr/bin/omamobile-charge-guard \
              usr/bin/omamobile-camera-start; do
  [[ ! -e $tmp/root/$absent ]] || fail "install includes $absent"
done
pass "install stages the udev rule, the USB link, the mirrorlist and the display start, and nothing that marks a slot or starts the radio, the charger or a camera"
[[ ! -e $tmp/root/usr/lib/systemd/logind.conf.d/10-omamobile-lid.conf ]] \
  || fail "husky has no lid: no lid drop-in"
pass "no lid drop-in"

test/display-start || fail "test/display-start"
pass "the display start loads gs_decon after allowing DSI commands for google-hk3 only"

# USB is the last gateway: its route outlives an unplug, so ahead of Wi-Fi
# it sent IPv4 into a dead cable (seen on raven, 2026-10-28).
net=vendor/systemd/network/20-usb-gadget.network
! sed -n '/^\[Network\]/,/^\[/p' "$net" | grep -q '^Gateway=' || fail "usb0 sets no default route in [Network] (metric 0)"
metric=$(sed -n '/^\[Route\]/,/^\[/{s/^Metric=//p}' "$net")
[[ ${metric:-0} -gt 700 ]] || fail "usb0's gateway goes after Wi-Fi (600) and mobile data (700)"
pass "USB is the last gateway"
