OMAMOBILE_SYSTEMCTL=$tmp/bin/fake-systemctl OMAMOBILE_SYSFS=$fs OMAMOBILE_THERMAL_STATE=$tmp/run bin/omamobile-husky-thermal --restore || fail "restore runs"
[[ -z $(cpus) && ! -e $tmp/run/cpuset && ! -e $tmp/run/orig ]] || fail "restore puts the slice back: [$(cpus)]"
[[ $(caps) == "1328000 1945000 2294000 890000000" ]] || fail "restore puts the caps back: $(caps)"
