#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omamobile-device-husky into DESTDIR. Nothing is enabled that would
# mark a slot successful or start the radio, the charger, or a camera.
#   ./install DESTDIR [BUILDDIR]
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
destination=${1:?Usage: ./install DESTDIR [BUILDDIR]}
build=${2:-build}
[[ $destination == /* && $destination != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
install -Dm755 "$build/reboot-to" "$destination/usr/bin/reboot-to"
install -Dm644 vendor/udev/rules.d/10-omamobile-storage.rules \
  "$destination/usr/lib/udev/rules.d/10-omamobile-storage.rules"
install -Dm644 vendor/systemd/network/20-usb-gadget.network \
  "$destination/usr/lib/systemd/network/20-usb-gadget.network"
install -Dm644 vendor/systemd/logind.conf.d/10-omamobile-power-key.conf \
  "$destination/usr/lib/systemd/logind.conf.d/10-omamobile-power-key.conf"
install -Dm644 vendor/NetworkManager/conf.d/10-omamobile-usb.conf \
  "$destination/usr/lib/NetworkManager/conf.d/10-omamobile-usb.conf"
install -Dm644 vendor/modprobe.d/omamobile-husky-clk-acpm.conf \
  "$destination/usr/lib/modprobe.d/omamobile-husky-clk-acpm.conf"
install -Dm644 vendor/modprobe.d/omamobile-husky-display.conf \
  "$destination/usr/lib/modprobe.d/omamobile-husky-display.conf"
install -Dm755 bin/omamobile-husky-display-start \
  "$destination/usr/bin/omamobile-husky-display-start"
install -Dm644 vendor/systemd/system/omamobile-husky-display.service \
  "$destination/usr/lib/systemd/system/omamobile-husky-display.service"
install -Dm644 vendor/systemd/system/display-manager.service.d/10-omamobile-husky.conf \
  "$destination/usr/lib/systemd/system/display-manager.service.d/10-omamobile-husky.conf"
install -d "$destination/usr/lib/systemd/system/multi-user.target.wants"
ln -sfn ../omamobile-husky-display.service \
  "$destination/usr/lib/systemd/system/multi-user.target.wants/omamobile-husky-display.service"
install -Dm644 vendor/modprobe.d/omamobile-max77759.conf \
  "$destination/usr/lib/modprobe.d/omamobile-max77759.conf"
install -Dm755 bin/omamobile-usb-rescue "$destination/usr/bin/omamobile-usb-rescue"
install -Dm644 vendor/systemd/system/omamobile-usb-rescue.service \
  "$destination/usr/lib/systemd/system/omamobile-usb-rescue.service"
ln -sfn ../omamobile-usb-rescue.service \
  "$destination/usr/lib/systemd/system/multi-user.target.wants/omamobile-usb-rescue.service"
install -Dm644 vendor/systemd/system/plymouth-quit.service.d/10-omamobile-retain-splash.conf \
  "$destination/usr/lib/systemd/system/plymouth-quit.service.d/10-omamobile-retain-splash.conf"
install -Dm644 device.conf \
  "$destination/usr/share/omamobile/device.conf"
install -Dm644 etc/omamobile-mirrorlist \
  "$destination/etc/pacman.d/omamobile-mirrorlist"
install -Dm644 LICENSE "$destination/usr/share/licenses/omamobile-device-husky/LICENSE"
install -Dm644 version "$destination/usr/share/omamobile/device-husky/version"
