pkgname=omamobile-device-husky
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Omamobile support for the Google Pixel 8 Pro (husky): storage guard, USB networking and the USB replug rescue"
arch=(aarch64)
url="https://github.com/derekross/omamobile"
license=(MIT)
depends=(bash systemd omamobile-keyring i2c-tools 'omamobile-audio>=0.5.18')
provides=(omamobile-device)
conflicts=(omamobile-device)
backup=(etc/pacman.d/omamobile-mirrorlist etc/NetworkManager/conf.d/zz-omamobile-wifi-powersave.conf etc/UPower/UPower.conf.d/50-omamobile-critical.conf)
install=omamobile-device-husky.install
makedepends=(gcc)

build() {
  "$startdir/build" "$srcdir/build"
}

check() {
  "$startdir/test/all"
}

package() {
  "$startdir/install" "$pkgdir" "$srcdir/build"
}
