# SPDX-License-Identifier: MIT
# Omarchy Trace: plays trace-01.png .. trace-30.png once (Omarchy's logo
# outlined, then filled; made by tools/gen-plymouth-trace.py) and holds the
# last frame, which is Omarchy's logo.png unchanged, until Plymouth quits.
# Plymouth lives about 2 s on husky, so the animation takes 0.6 s, and a
# quit before it ends jumps to the last frame, so the image kept on screen
# by --retain-splash is always the whole logo.

Window.SetBackgroundTopColor(0.101, 0.105, 0.149);
Window.SetBackgroundBottomColor(0.101, 0.105, 0.149);

global.frame_count = 30;
global.ticks_per_frame = 1;  # refresh runs at 50 Hz: 50 frames/s, 0.6 s in all
for (i = 1; i <= global.frame_count; i++) {
  if (i < 10) name = "trace-0" + i + ".png";
  else name = "trace-" + i + ".png";
  frames[i] = Image(name);
}
sprite = Sprite(frames[1]);
global.frame = 1;
global.tick = 0;
global.layout_width = 0;
global.layout_height = 0;

fun layout() {
  global.layout_width = Window.GetWidth();
  global.layout_height = Window.GetHeight();
  sprite.SetX(Window.GetWidth() / 2 - frames[1].GetWidth() / 2);
  sprite.SetY(Window.GetHeight() / 2 - frames[1].GetHeight() / 2);
}
layout();

fun refresh_callback() {
  if (Window.GetWidth() != global.layout_width || Window.GetHeight() != global.layout_height)
    layout();
  if (global.frame < global.frame_count) {
    global.tick++;
    if (global.tick >= global.ticks_per_frame) {
      global.tick = 0;
      global.frame++;
      sprite.SetImage(frames[global.frame]);
    }
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

fun quit_callback() {
  global.frame = global.frame_count;
  sprite.SetImage(frames[global.frame_count]);
}
Plymouth.SetQuitFunction(quit_callback);
