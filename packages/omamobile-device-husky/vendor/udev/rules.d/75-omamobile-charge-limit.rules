# SPDX-License-Identifier: MIT
# Apply the saved charge limit (/etc/omamobile/charge-limit) when the MAX77759 charger appears, at every boot,
# through omamobile-charge-limit-apply.service rather than inside the udev worker. The helper acts only on the
# supply this package declares in /usr/share/omamobile/charge-limit.conf; no saved file: nothing is touched.
# No ACTION filter: with ACTION=="add" the device loses its systemd tag on the charger's next change event, and
# the unit did not start at boot on husky (2026-11-16); without it, it does.
SUBSYSTEM=="power_supply", KERNEL=="max77759-charger", TAG+="systemd", ENV{SYSTEMD_WANTS}+="omamobile-charge-limit-apply.service"
