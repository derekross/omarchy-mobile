#!/bin/sh
# SPDX-License-Identifier: MIT
# Hold a logind sleep inhibitor (block) while max77759-charger is online.
# The charger's temperature guard is delayed work: s2idle stops it while the
# chip goes on charging, so the phone must not sleep on the cable.
# udev starts this when the charger's power supply appears
# (80-omamobile-charger.rules); with the charger blacklisted it never
# appears, and this never runs. It exits when the charger goes away.
# Limits: a cable plugged in while already asleep is not covered (nothing
# wakes the phone), and polling is 1 s, so a suspend within about a second
# of plug-in can get through.
C=${OMAMOBILE_CHARGER_ONLINE:-/sys/class/power_supply/max77759-charger/online}
while [ -r "$C" ]; do
  if [ "$(cat "$C" 2>/dev/null)" = 1 ]; then
    # the lock lives exactly as long as the cable is in
    systemd-inhibit --what=sleep --mode=block --who=omamobile-charger \
      --why="charging: the charge guard does not run during sleep" \
      sh -c 'while [ "$(cat "$1" 2>/dev/null)" = 1 ]; do sleep 1; done' _ "$C" \
      || { echo "omamobile-plugged-inhibit: systemd-inhibit failed, sleep is not blocked" >&2; exit 1; }
  fi
  sleep 1
done
echo "omamobile-plugged-inhibit: $C is gone, stopping" >&2
