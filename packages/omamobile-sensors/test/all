#!/bin/bash
# SPDX-License-Identifier: MIT
# Tests for omamobile-sensors, from a copy of this directory alone.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
fail() { printf 'not ok - %s\n' "$1" >&2; exit 1; }
pass() { printf 'ok - %s\n' "$1"; }
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

for f in lib/*.py; do python3 -c "import sys; compile(open(sys.argv[1]).read(), sys.argv[1], \"exec\")" "$f" || fail "$f compiles"; done
pass "python compiles"

python3 -I lib/usf.py --self-test >/dev/null || fail "usf.py self-test"
pass "USF protocol self-test"

# orientation from gravity, iio-sensor-proxy's frame
PYTHONPATH=lib python3 - <<'PY' || fail "orientation thresholds"
import sys
sys.argv = ['x']
import importlib.util
spec = importlib.util.spec_from_file_location('sp', 'lib/sensor_proxy.py')
sp = importlib.util.module_from_spec(spec); spec.loader.exec_module(sp)
# Android accel (reaction to gravity) upright: (0, 9.8, 0) -> gravity (0, -9.8, 0)
assert sp.orientation('undefined', 0, -9.8, 0) == 'normal'
assert sp.orientation('undefined', 9.8, 0, 0) == 'left-up'
assert sp.orientation('undefined', -9.8, 0, 0) == 'right-up'
assert sp.orientation('undefined', 0, 9.8, 0) == 'bottom-up'
assert sp.tilt(0, 0, -9.8) == 'face-up'
PY
pass "orientation and tilt"

# the AoC settle wait before the registry load
PYTHONPATH=lib python3 - "$tmp" <<'PY' || fail "AoC settle wait"
import os, sys
import usf_backend as b
m = os.path.join(sys.argv[1], 'marker')
slept = []
assert b.aoc_settle(m, 15, now=lambda: 1000.0, sleep=slept.append) == 0.0   # no marker
open(m, 'w').close(); os.utime(m, (990.0, 990.0))
assert b.aoc_settle(m, 15, now=lambda: 1000.0, sleep=slept.append) == 5.0 and slept == [5.0]
assert b.aoc_settle(m, 15, now=lambda: 1100.0, sleep=slept.append) == 0.0
PY
pass "AoC settle wait"

# gyroscope stream: rates, record packing, AoC clock, USF backend on the fake AoC
PYTHONPATH=lib python3 - <<'PY' || fail "gyroscope stream (offline)"
import importlib.util, struct, time
spec = importlib.util.spec_from_file_location('sp', 'lib/sensor_proxy.py')
sp = importlib.util.module_from_spec(spec); spec.loader.exec_module(sp)
import usf, usf_backend as b
# rates: 15 Hz times a power of two, at or above the request, within the sensor's range
assert [sp.gyro_rate(r, 15.0, 480.0) for r in (0, 1, 15, 16, 100, 200, 240, 241, 400, 1000)] == \
    [240, 15, 15, 30, 120, 240, 240, 480, 480, 480]
# records: 24 bytes, little-endian, whole records per packet, numbered across packets
assert sp.GYRO_RECORD.size == 24
recs = [(10**12 + i, 0.5, -1.0, 2.0) for i in range(sp.GYRO_MAX_RECORDS + 3)]
pkts = sp.gyro_packets(recs, 7)
assert [len(p) // 24 for p in pkts] == [sp.GYRO_MAX_RECORDS, 3]
n = sp.GYRO_MAX_RECORDS + 1
assert struct.unpack('<QfffI', pkts[1][24:48]) == (10**12 + n, 0.5, -1.0, 2.0, 7 + n)
# AoC clock: 24.576 MHz ticks to ns as the firmware does
assert b.aoc_ticks_to_ns(24_576_000) == 1_000_000_125   # the firmware's rounding, 0.125 ppm
# the boottime pair, moved to monotonic (here 1000 s were spent suspended)
clocks = {time.CLOCK_BOOTTIME: 5_000 * 10**9, time.CLOCK_MONOTONIC: 4_000 * 10**9}
c = b.AocClock(path='pair', read=lambda p, d: '24576000000 3000000000000', now=lambda k: clocks[k])
aoc = b.aoc_ticks_to_ns(24576000000)
assert c.to_monotonic(aoc) == 2_000 * 10**9 and c.to_monotonic(aoc + 5) == 2_000 * 10**9 + 5
# without the sysfs pair: the time server against the monotonic midpoint
c = b.AocClock(path='', now=lambda k: clocks[k], get_time=lambda: 123)
assert c.to_monotonic(123) == clocks[time.CLOCK_MONOTONIC]
# a compact batch as monotonic records
fixed = type('C', (), {'to_monotonic': lambda self, t: t + 1000, 'sync': lambda self: 1000})()
batch = {'samples': [(100, 0, [1.0, 2.0, 3.0]), (200, 0, [4.0, 5.0, 6.0])]}
assert b.stream_samples(batch, fixed) == [(1100, 1.0, 2.0, 3.0), (1200, 4.0, 5.0, 6.0)]

# the USF backend on the fake AoC: finds the gyroscope, samples it unbatched,
# reports every sample with its time moved by the clock, stops it
class Tr(usf.DryRunTransport):
    fds = []
tr = Tr(simulate=True, quiet=True)
got = []
be = b.UsfBackend('/nonexistent', lambda k, v: got.append((k, v)), clock=fixed, transport=tr)
assert be.has['gyro'] and be.has['accel'], be.has
assert be.stream_range('gyro') == (1e9 / 66666666, 1e9 / 2083333)
be.start_stream('gyro', 4_166_666)
def sent(mid):
    envs = [usf.decode_envelope(usf.decode_msg(m)[1]) for m in tr.sent]
    return [e for e in envs if e['id'] == mid]
req = usf.decode_start_sampling_req(sent(usf.REQ_START_SAMPLING)[-1]['payload'])
assert req['period_ns'] == 4_166_666 and req['max_latency_ns'] == 0 and req['non_wakeup'], req
end = time.monotonic() + 0.1
while time.monotonic() < end:
    be._drain(be.client.poll(0.01))
gyro = [s for k, v in got if k == 'gyro' for s in v]
assert len(gyro) >= 10, len(gyro)
assert all(t2 - t1 == 4_166_666 for (t1, *_), (t2, *_) in zip(gyro, gyro[1:]))
assert [round(v, 4) for v in gyro[0][1:]] == [0.01, -0.02, 9.81]
be.stop_stream('gyro')
assert not tr.sim.active and 'gyro' not in be.sampling
assert len(sent(usf.REQ_STOP_SAMPLING)) == 1
PY
pass "gyroscope rates, records, AoC clock and USF backend"

# D-Bus round trip on a private session bus: test backend -> autorotate (dry run)
if command -v dbus-run-session >/dev/null; then
  # A private state directory: the user's own rotation lock must not apply
  XDG_STATE_HOME=$tmp/state GIO_USE_VFS=local dbus-run-session -- bash -c '
    PYTHONPATH=lib python3 lib/sensor_proxy.py --backend test --session & p=$!
    sleep 1
    timeout 8 python3 lib/autorotate.py --session --dry-run 2> '"$tmp"'/rot.log || true
    OMAMOBILE_TEST_LOCKED=1 timeout 8 python3 lib/autorotate.py --session --dry-run 2> '"$tmp"'/rot-locked.log || true
    kill $p' || true
  grep -q "transform 0" "$tmp/rot.log" || grep -q "transform = 0" "$tmp/rot.log" || fail "autorotate applies normal"
  grep -q "transform = 1" "$tmp/rot.log" || fail "autorotate applies left-up"
  pass "proxy and autorotate over D-Bus"
  # the same run with the shell locked: the screen is held portrait, left-up waits
  grep -q "portrait while locked" "$tmp/rot-locked.log" || fail "autorotate holds portrait while the shell is locked"
  if grep -q "transform = 1" "$tmp/rot-locked.log"; then fail "autorotate rotated a locked screen"; fi
  pass "the lock screen stays portrait"
fi

# gyroscope over D-Bus: an fd stream, the fastest claim sets the rate, and
# closing the socket, dying and ReleaseGyroscope all end a claim
if command -v dbus-run-session >/dev/null; then
  GIO_USE_VFS=local dbus-run-session -- bash -c '
    PYTHONPATH=lib python3 lib/sensor_proxy.py --backend test --session 2> "$1/gyro-proxy.log" & p=$!
    sleep 1
    python3 lib/gyro.py --session --rate 200 --duration 1.5 --stats > "$1/gyro-stats.txt" 2>&1
    python3 lib/gyro.py --session --rate 100 --duration 3 > "$1/gyro-slow.txt" 2>/dev/null & s=$!
    sleep 1
    python3 lib/gyro.py --session --rate 400 --duration 0.7 > /dev/null 2>&1
    wait $s
    python3 lib/gyro.py --session --duration 30 > /dev/null 2>&1 & k=$!
    sleep 1; kill -9 $k; wait $k 2>/dev/null
    python3 test/gyro_release.py > "$1/gyro-release.txt" 2>&1 || echo FAILED >> "$1/gyro-release.txt"
    sleep 0.5; kill $p' _ "$tmp" || true
  grep -q "240.0 Hz" "$tmp/gyro-stats.txt" || { cat "$tmp/gyro-stats.txt" >&2; fail "gyroscope stream at 240 Hz"; }
  grep -q "dropped (seq gaps)  0" "$tmp/gyro-stats.txt" || fail "gyroscope stream drops nothing"
  grep -c FAILED "$tmp/gyro-release.txt" >/dev/null && { cat "$tmp/gyro-release.txt" >&2; fail "ReleaseGyroscope ends the stream"; }
  # the 100 Hz client got the 400 Hz client's rate while both held claims
  awk 'NR > 1 && $1 - t < 3000000 { fast++ } { t = $1 } END { exit !(fast > 50) }' "$tmp/gyro-slow.txt" ||
    fail "the fastest claim sets the rate"
  sed -n 's/^test backend: //p' "$tmp/gyro-proxy.log" > "$tmp/gyro-events"
  printf '%s\n' 'gyro at 240 Hz' 'gyro stopped' 'gyro at 120 Hz' 'gyro stopped' 'gyro at 480 Hz' \
    'gyro stopped' 'gyro at 120 Hz' 'gyro stopped' 'gyro at 240 Hz' 'gyro stopped' 'gyro at 60 Hz' \
    'gyro stopped' | diff -u - "$tmp/gyro-events" || fail "the gyroscope follows the claims and stops with the last"
  pass "gyroscope stream over D-Bus"
fi

# auto-brightness: the curve, the user's point, the filter's hysteresis, the
# ramps and the controller on a fake clock (test/autobrightness.py)
python3 -I test/autobrightness.py > "$tmp/ab-unit.txt" 2>&1 || { cat "$tmp/ab-unit.txt" >&2; fail "auto-brightness unit tests"; }
pass "auto-brightness curve, hysteresis, ramps and manual levels ($(grep -c '^ok' "$tmp/ab-unit.txt") tests)"

# the toggle, against stand-ins for systemctl and busctl
mkdir -p "$tmp/stub"
cat > "$tmp/stub/systemctl" <<'SH'
#!/bin/sh
echo "$*" >> "$STUB_DIR/calls"
case "$*" in
  *is-active*) [ -e "$STUB_DIR/active" ] ;;
  *disable*) rm -f "$STUB_DIR/active" ;;
  *enable*) touch "$STUB_DIR/active" ;;
esac
SH
printf '#!/bin/sh\necho "b true"\n' > "$tmp/stub/busctl"
chmod +x "$tmp/stub/systemctl" "$tmp/stub/busctl"
mkdir -p "$tmp/bl-class/panel" "$tmp/bl-none"
toggle() { STUB_DIR=$tmp/stub OMAMOBILE_BACKLIGHT_CLASS=$tmp/bl-class PATH="$tmp/stub:$PATH" bin/omamobile-toggle-autobrightness "$@"; }
[[ $(toggle status) == '{"enabled":false,"available":true}' ]] || fail "toggle status, off"
[[ $(toggle) == enabled ]] || fail "toggle turns it on"
grep -qx -- '--user --quiet enable --now omamobile-autobrightness.service' "$tmp/stub/calls" || fail "on enables the user service"
[[ $(toggle status) == '{"enabled":true,"available":true}' ]] || fail "toggle status, on"
[[ $(toggle off) == disabled && $(toggle on) == enabled && $(toggle toggle) == disabled ]] || fail "toggle on, off, toggle"
toggle bogus 2>/dev/null && fail "toggle refuses an unknown word"
[[ $(STUB_DIR=$tmp/stub OMAMOBILE_BACKLIGHT_CLASS=$tmp/bl-none PATH="$tmp/stub:$PATH" bin/omamobile-toggle-autobrightness status) == '{"enabled":false,"available":false}' ]] ||
  fail "toggle status: not available without a backlight"
pass "omamobile-toggle-autobrightness"

# auto-brightness over D-Bus: the test backend's light (101 lux, one more
# each second) on a private session bus and a backlight directory: follows
# the light, releases the sensor while bl_power is off, takes a level set
# by hand as the user's point and keeps it
if command -v dbus-run-session >/dev/null; then
  bl=$tmp/backlight
  mkdir -p "$bl"
  echo 2047 > "$bl/max_brightness"; echo 1500 > "$bl/brightness"; echo 1500 > "$bl/actual_brightness"; echo 0 > "$bl/bl_power"
  XDG_STATE_HOME=$tmp/ab-state XDG_CONFIG_HOME=$tmp/ab-config GIO_USE_VFS=local dbus-run-session -- bash -c '
    PYTHONPATH=lib python3 lib/sensor_proxy.py --backend test --session 2>/dev/null & p=$!
    sleep 1
    python3 lib/autobrightness.py --session --backlight "$1" --dpms "" 2> "$2/ab.log" & a=$!
    sleep 4; cat "$1/brightness" > "$2/ab-followed"
    echo 4 > "$1/bl_power"; sleep 2
    echo 0 > "$1/bl_power"; sleep 5
    echo 900 > "$1/brightness"; sleep 4.5
    kill $a; wait $a; kill $p' _ "$bl" "$tmp" || true
  want=$(python3 -I -c 'import sys; sys.path.insert(0, "lib"); import autobrightness as a; print(a.Curve(a.Panel()).level(101))')
  got=$(cat "$tmp/ab-followed" 2>/dev/null)
  (( ${got:-0} >= want - 3 && ${got:-0} <= want + 3 )) || { cat "$tmp/ab.log" >&2; fail "auto-brightness follows the light ($got, want about $want)"; }
  [[ $(grep -c 'claimed the light sensor' "$tmp/ab.log") == 2 ]] || { cat "$tmp/ab.log" >&2; fail "claimed at start and again on the wake"; }
  grep -q 'released the light sensor' "$tmp/ab.log" || fail "releases the sensor while the panel is off"
  grep -q 'your level 900' "$tmp/ab.log" || { cat "$tmp/ab.log" >&2; fail "a level set by hand becomes the user's point"; }
  [[ $(cat "$bl/brightness") == 900 ]] || fail "the user's level stays"
  grep -q '"nits"' "$tmp/ab-state/omamobile/autobrightness.json" || fail "the user's point is saved"
  pass "auto-brightness over D-Bus"
fi

./install "$tmp/root"
for f in usr/bin/omamobile-sensor-proxy usr/bin/omamobile-autorotate usr/bin/omamobile-usf usr/bin/omamobile-gyro \
         usr/bin/omamobile-autobrightness usr/bin/omamobile-toggle-autobrightness \
         usr/lib/omamobile-sensors/usf.py usr/lib/omamobile-sensors/usf_backend.py usr/lib/omamobile-sensors/gyro.py \
         usr/lib/omamobile-sensors/sensor_proxy.py usr/lib/omamobile-sensors/autorotate.py \
         usr/lib/omamobile-sensors/autobrightness.py \
         usr/lib/systemd/system/omamobile-sensor-proxy.service usr/lib/systemd/user/omamobile-autorotate.service \
         usr/lib/systemd/user/omamobile-autobrightness.service \
         usr/share/dbus-1/system.d/net.hadess.SensorProxy.conf; do
  [[ -e $tmp/root/$f ]] || fail "install stages $f"
done
[[ $(find "$tmp/root" -path '*wants*' -name '*.service' -printf '%P\n') == usr/lib/systemd/system/multi-user.target.wants/omamobile-sensor-proxy.service ]] ||
  fail "only the sensor proxy is enabled"
[[ -e $tmp/root/usr/lib/systemd/system/multi-user.target.wants/omamobile-sensor-proxy.service ]] || fail "the proxy link resolves"
pass "install stages the package, enables only the sensor proxy"
