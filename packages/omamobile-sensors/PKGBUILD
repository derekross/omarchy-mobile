pkgname=omamobile-sensors
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Omarchy Mobile sensors for the Pixel 7 Pro: iio-sensor-proxy's D-Bus API from the AoC, auto-rotate for Hyprland, automatic brightness"
arch=(any)
url="https://github.com/derekross/omarchy-mobile"
license=(MIT)
depends=(python python-gobject dbus hyprland)
optdepends=('e2fsprogs: load the factory sensor calibration from persist (debugfs, read-only)')
provides=(iio-sensor-proxy)
conflicts=(iio-sensor-proxy)

check() {
  "$startdir/test/all"
}

package() {
  "$startdir/install" "$pkgdir"
}
