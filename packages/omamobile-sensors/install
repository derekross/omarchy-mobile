#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage omamobile-sensors into DESTDIR. Enables the sensor proxy at boot; the
# auto-rotate user service is turned on from the rotation lock tile, the
# auto-brightness one from the brightness icon or tile (or
# omamobile-toggle-autobrightness).
#   ./install DESTDIR
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
d=${1:?Usage: ./install DESTDIR}
[[ $d == /* && $d != "/" ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
for f in lib/*.py; do install -Dm644 "$f" "$d/usr/lib/omamobile-sensors/${f##*/}"; done
for f in bin/*; do install -Dm755 "$f" "$d/usr/bin/${f##*/}"; done
install -Dm644 systemd/omamobile-sensor-proxy.service "$d/usr/lib/systemd/system/omamobile-sensor-proxy.service"
install -dm755 "$d/usr/lib/systemd/system/multi-user.target.wants"
ln -sf ../omamobile-sensor-proxy.service "$d/usr/lib/systemd/system/multi-user.target.wants/omamobile-sensor-proxy.service"
install -Dm644 systemd/omamobile-autorotate.service "$d/usr/lib/systemd/user/omamobile-autorotate.service"
install -Dm644 systemd/omamobile-autobrightness.service "$d/usr/lib/systemd/user/omamobile-autobrightness.service"
install -Dm644 dbus/net.hadess.SensorProxy.conf "$d/usr/share/dbus-1/system.d/net.hadess.SensorProxy.conf"
install -Dm644 LICENSE "$d/usr/share/licenses/omamobile-sensors/LICENSE"
