#!/bin/bash
# SPDX-License-Identifier: MIT
# The pacman version of a release kernel (docs/RELEASES.md §4, §7):
#
#   7.3.0-rc6-omamobile-00453-g0123456789ab  ->  7.3.0rc6.r453.g0123456789ab
#   7.4.0-omamobile-00012-gabcdef012345      ->  7.4.0.r12.gabcdef012345
#   7.4.0-omamobile                          ->  7.4.0.r0   (built on the tag itself)
#
# '-' is folded away (pacman forbids it in a version), so a snapshot with
# more commits sorts higher, and an rc sorts below its release (pacman's
# vercmp: 7.3.0rc6 < 7.3.0). Only release builds are packaged: a
# development kernel (-omamobile-push1-..., or anything else before the
# commit count) and a tree with uncommitted changes (-dirty) are refused,
# so a development kernel can never be mistaken for a packaged one.
#
#   lib/pkgver RELEASE
set -euo pipefail
rel=${1:?usage: pkgver RELEASE (as in include/config/kernel.release)}
re='^([0-9]+)\.([0-9]+)(\.([0-9]+))?(-(rc[0-9]+))?-omamobile(-([0-9]+)-g([0-9a-f]{7,40}))?$'
if [[ $rel == *-dirty ]]; then
  echo "pkgver: $rel was built from a tree with uncommitted changes; package a clean snapshot" >&2
  exit 1
fi
if ! [[ $rel =~ $re ]]; then
  echo "pkgver: $rel is not a release kernel (expected <version>[-rcN]-omamobile[-<n>-g<sha>]; development builds such as -omamobile-push1 are not packaged)" >&2
  exit 1
fi
v=${BASH_REMATCH[1]}.${BASH_REMATCH[2]}.${BASH_REMATCH[4]:-0}${BASH_REMATCH[6]}
if [[ -n ${BASH_REMATCH[7]} ]]; then
  echo "$v.r$((10#${BASH_REMATCH[8]})).g${BASH_REMATCH[9]}"
else
  echo "$v.r0"
fi
