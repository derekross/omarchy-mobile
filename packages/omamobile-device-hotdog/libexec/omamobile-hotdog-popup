#!/usr/bin/python3 -I
# SPDX-License-Identifier: MIT
"""The OnePlus 7T Pro's pop-up front camera (CAMERA-PLAN.md section 6, P-steps).

Hardware (stock device tree, dtbo entry 18; OnePlus's GPL motor driver):
  a DRV8834 stepper driver, 1/32 microsteps (M1 high, M0 high-impedance):
    STEP   PM8150L GPIO10, func1 = the PM8150L LPG's channel at 0xbd00 (pwm 4)
    DIR    PM8150L GPIO11, 0 = up, 1 = down
    M1     PM8150L GPIO8, 1
    M0     PM8150B GPIO5, high-impedance (the LPG's pin state)
    nSLEEP PM8150  GPIO10, 1 = run
    BOOST  PM8150B GPIO12, 1 (stock sets it once and leaves it on)
  two MagnaChip M1120 hall sensors on QUP SE1 (i2c@884000): 0x0c sees the
  camera at the top, 0x0d at the bottom; |field| above a threshold (stock:
  150) means "there".

A move: wake the driver, 100 ms of slow steps, then fast steps until the
target's hall sensor reads "there" and then stops rising (the end stop;
the threshold alone is 0.5-1 mm short), plus a few ms to seat, never longer
than stock's timed move, then stop and sleep the driver. Stock stops on its
timer alone; this stops earlier when the sensor says so.

  status          read-only: both hall readings and what they mean
  up | down       one move; "up" is refused when the camera is up, "down"
                  always runs (it seats a camera that stands proud)
  daemon          raise the camera while the front sensor streams, lower it
                  1.5 s after; lower it at once if it is pushed in while up
                  or if the phone falls, and leave it down until the sensor
                  has been idle; needs /etc/omamobile/popup-hotdog-enable
  watch-fall      read-only: print the accelerometer's free-fall verdicts,
                  nothing moves (to test the detection on a soft landing)

Free fall: stock's interrupt (TLMM gpio163) has no source on Linux, so the
daemon reads the accelerometer from the SLPI's sensor core (ssccli, about
26 Hz) while the camera is up or rising. A fall is |a| below FALL_MMS2
(milli m/s^2) for FALL_MS and at least FALL_SAMPLES samples in a row; it
cuts a move up short and lowers the camera at once.
Nothing here writes a hall sensor register other than its reset, interrupt
and measurement setup (0x00, 0x01, 0x07, 0x08): 0x06 disables its I2C.
"""

import ctypes
import fcntl
import glob
import math
import os
import pty
import re
import signal
import subprocess
import sys
import threading
import time

CONF = "/etc/omamobile/popup-hotdog.conf"
ENABLE = "/etc/omamobile/popup-hotdog-enable"
STATE = "/run/omamobile/popup-hotdog"
TRACE = bool(os.environ.get("POPUP_TRACE"))

# Defaults, overridable in CONF (KEY=value lines).
DEFAULTS = {
    "UP_THRESHOLD": 150,     # |up sensor| above: camera at the top
    "DOWN_THRESHOLD": 150,   # |down sensor| above: camera at the bottom
    "SLOW_NS": 105000,       # 9.5 kHz microsteps (~300 full steps/s); LPG-exact
    "FAST_NS": 13125,        # 76 kHz microsteps (~2400 full steps/s); LPG-exact
    "SLOW_MS": 100,
    "MAX_FAST_MS": 510,      # stock's timed move, about 1244 full steps
    # The camera reaches the end stop about 655 ms (up) and 660 ms (down)
    # after the start, 40 ms past stock's timer (P3 2026-11-28, traced):
    # stopping on that timer left it 0.5-1 mm short. With this margin the
    # end-stop check (about 70 ms after arrival) ends every move
    "UP_EXTRA_MS": 160,
    "DOWN_EXTRA_MS": 160,
    "SEAT_MS": 20,           # after the end stop (the reading stopped rising)
    "PLATEAU_MS": 50,        # past the threshold, no rise for this long: at the end stop
    "PLATEAU_LSB": 3,        # a rise smaller than this is noise
    "IDLE_DOWN_MS": 1500,    # front sensor idle this long: lower the camera
    "FALL_MMS2": 3000,       # |a| below 3 m/s^2 (g is 9.81): weightless
    "FALL_MS": 60,           # ... for this long
    "FALL_SAMPLES": 3,       # ... and at least this many samples in a row
    "FALL_READY_MS": 600,    # wait this long for the first sample before raising
}

# --- device-tree paths of the pieces we use ---
DT = "/sys/firmware/devicetree/base"
GPIO_PM8150 = "pmic@0/gpio@c000"
GPIO_PM8150B = "pmic@2/gpio@c000"
GPIO_PM8150L = "pmic@4/gpio@c000"
LPG_PM8150L = "pmic@5/pwm"
HALL_BUS = "i2c@884000"
HALL_UP, HALL_DOWN = 0x0C, 0x0D
STEP_CHANNEL = 4


def log(msg):
    print(f"popup: {msg}", file=sys.stderr, flush=True)


def load_conf():
    conf = dict(DEFAULTS)
    try:
        with open(CONF) as f:
            for line in f:
                line = line.split("#", 1)[0].strip()
                if "=" in line:
                    k, v = (s.strip() for s in line.split("=", 1))
                    if k in conf:
                        conf[k] = int(v)
    except FileNotFoundError:
        pass
    # POPUP_<KEY>=value in the environment, for measuring (CAMERA-PLAN P3)
    for k in conf:
        if f"POPUP_{k}" in os.environ:
            conf[k] = int(os.environ[f"POPUP_{k}"])
    return conf


def of_path(sysdev):
    """The device-tree node of a sysfs device (or its parent), or ''."""
    for cand in (os.path.join(sysdev, "of_node"),
                 os.path.join(sysdev, "device", "of_node"),
                 os.path.join(sysdev, "..", "of_node")):
        if os.path.exists(cand):
            return os.path.realpath(cand)
    return ""


# --- GPIO character device (uAPI v2) ---
def _iowr(nr, size):
    return (3 << 30) | (size << 16) | (0xB4 << 8) | nr


GPIO_V2_GET_LINE_IOCTL = _iowr(0x07, 592)
GPIO_V2_LINE_SET_VALUES_IOCTL = _iowr(0x0F, 16)
FLAG_OUTPUT = 1 << 3


def gpiochip(node_suffix):
    for dev in glob.glob("/sys/bus/gpio/devices/gpiochip*"):
        if of_path(dev).endswith(node_suffix):
            return "/dev/" + os.path.basename(dev)
    raise SystemExit(f"popup: no GPIO controller {node_suffix} (overlay missing?)")


class Line:
    """One PMIC GPIO held as an output (DT numbering from 1)."""

    def __init__(self, chip, pmic_gpio, value, name):
        self.name = name
        req = bytearray(592)
        req[0:4] = (pmic_gpio - 1).to_bytes(4, "little")
        req[256:256 + len("omamobile-popup")] = b"omamobile-popup"
        cfg = 288
        # Output only: drive, bias and power source stay as the LPG's pin
        # state set them
        req[cfg:cfg + 8] = FLAG_OUTPUT.to_bytes(8, "little")
        req[cfg + 8:cfg + 12] = (1).to_bytes(4, "little")       # one attribute
        att = cfg + 32
        req[att:att + 4] = (2).to_bytes(4, "little")             # OUTPUT_VALUES
        req[att + 8:att + 16] = (value & 1).to_bytes(8, "little")
        req[att + 16:att + 24] = (1).to_bytes(8, "little")       # mask: line 0
        req[560:564] = (1).to_bytes(4, "little")                 # num_lines
        fd = os.open(chip, os.O_RDWR | os.O_CLOEXEC)
        try:
            fcntl.ioctl(fd, GPIO_V2_GET_LINE_IOCTL, req)
        finally:
            os.close(fd)
        self.fd = int.from_bytes(req[588:592], "little", signed=True)

    def set(self, value):
        vals = (value & 1).to_bytes(8, "little") + (1).to_bytes(8, "little")
        fcntl.ioctl(self.fd, GPIO_V2_LINE_SET_VALUES_IOCTL, bytearray(vals))

    def close(self):
        os.close(self.fd)


# --- PWM (sysfs) ---
class Step:
    def __init__(self):
        chips = [c for c in glob.glob("/sys/class/pwm/pwmchip*")
                 if of_path(c).endswith(LPG_PM8150L)]
        if not chips:
            raise SystemExit("popup: no PM8150L LPG PWM (overlay missing?)")
        self.dir = os.path.join(chips[0], f"pwm{STEP_CHANNEL}")
        if not os.path.isdir(self.dir):
            self._w(os.path.join(chips[0], "export"), STEP_CHANNEL)
            time.sleep(0.05)

    @staticmethod
    def _w(path, value):
        with open(path, "w") as f:
            f.write(str(value))

    def run(self, period_ns):
        """Start or retime the pulses; duty is always half the period."""
        cur = int(open(os.path.join(self.dir, "period")).read() or 0)
        half = period_ns // 2
        if period_ns < cur:
            self._w(os.path.join(self.dir, "duty_cycle"), half)
            self._w(os.path.join(self.dir, "period"), period_ns)
        else:
            self._w(os.path.join(self.dir, "period"), period_ns)
            self._w(os.path.join(self.dir, "duty_cycle"), half)
        self._w(os.path.join(self.dir, "enable"), 1)

    def stop(self):
        self._w(os.path.join(self.dir, "enable"), 0)


# --- M1120 hall sensors over /dev/i2c-N ---
I2C_RDWR, I2C_M_RD = 0x0707, 0x0001


class I2cMsg(ctypes.Structure):
    _fields_ = [("addr", ctypes.c_uint16), ("flags", ctypes.c_uint16),
                ("len", ctypes.c_uint16), ("buf", ctypes.POINTER(ctypes.c_uint8))]


class I2cRdwr(ctypes.Structure):
    _fields_ = [("msgs", ctypes.POINTER(I2cMsg)), ("nmsgs", ctypes.c_uint32)]


ALLOWED_HALL_WRITES = {0x00, 0x01, 0x07, 0x08}


class Hall:
    def __init__(self):
        # Kernel 7.3 has no /sys/class/i2c-adapter: the adapters are only on
        # the bus (CAMERA-PLAN P1, 2026-11-05); older kernels have both
        buses = [b for b in sorted(set(glob.glob("/sys/bus/i2c/devices/i2c-*") +
                                       glob.glob("/sys/class/i2c-adapter/i2c-*")))
                 if of_path(b).endswith(HALL_BUS)]
        if not buses:
            raise SystemExit("popup: hall sensor bus i2c@884000 not enabled (overlay missing?)")
        self.fd = os.open("/dev/" + os.path.basename(buses[0]), os.O_RDWR | os.O_CLOEXEC)
        for addr in (HALL_UP, HALL_DOWN):
            self._init(addr)

    def _xfer(self, addr, wr, rdlen=0):
        wbuf = (ctypes.c_uint8 * len(wr))(*wr)
        msgs = [I2cMsg(addr, 0, len(wr), wbuf)]
        rbuf = (ctypes.c_uint8 * max(rdlen, 1))()
        if rdlen:
            msgs.append(I2cMsg(addr, I2C_M_RD, rdlen, rbuf))
        arr = (I2cMsg * len(msgs))(*msgs)
        fcntl.ioctl(self.fd, I2C_RDWR, I2cRdwr(arr, len(msgs)))
        return bytes(rbuf[:rdlen])

    def _write(self, addr, reg, val):
        if reg not in ALLOWED_HALL_WRITES:
            raise SystemExit(f"popup: refusing to write hall register 0x{reg:02x}")
        self._xfer(addr, [reg, val])

    def _init(self, addr):
        self._write(addr, 0x07, 0x01)          # soft reset
        time.sleep(0.005)
        did = self._xfer(addr, [0x09], 1)[0]
        if did != 0x9C:
            raise SystemExit(f"popup: 0x{addr:02x} is not an M1120 (ID 0x{did:02x})")
        self._write(addr, 0x00, 0x40)          # persistence
        self._write(addr, 0x01, 0x01)          # polling, 10 bit, 0.034 mT/LSB
        self._write(addr, 0x08, 0x41)          # 80 Hz, 10 bit, measuring

    def read(self, addr):
        """Signed 10-bit field, or None while no sample is ready."""
        st1, lo, hi = self._xfer(addr, [0x10], 3)
        if not st1 & 0x01:
            return None
        x = ((hi & 0x40) >> 6) << 8 | lo
        return x - 0x200 if hi & 0x80 else x

    def settled(self, addr, tries=10):
        for _ in range(tries):
            v = self.read(addr)
            if v is not None:
                return v
            time.sleep(0.013)
        raise SystemExit(f"popup: hall 0x{addr:02x} gives no data")


def position(hall, conf):
    up, down = hall.settled(HALL_UP), hall.settled(HALL_DOWN)
    if abs(up) > conf["UP_THRESHOLD"] and abs(down) <= conf["DOWN_THRESHOLD"]:
        where = "up"
    elif abs(down) > conf["DOWN_THRESHOLD"] and abs(up) <= conf["UP_THRESHOLD"]:
        where = "down"
    else:
        where = "unknown"
    return where, up, down


class Motor:
    def __init__(self):
        pm8150l, pm8150b, pm8150 = (gpiochip(n) for n in (GPIO_PM8150L, GPIO_PM8150B, GPIO_PM8150))
        self.sleep_n = Line(pm8150, 10, 0, "nSLEEP")
        self.direction = Line(pm8150l, 11, 0, "DIR")
        self.m1 = Line(pm8150l, 8, 1, "M1")
        self.boost = Line(pm8150b, 12, 1, "BOOST")
        self.step = Step()

    def move(self, hall, conf, target, abort=None):
        """One move; a set abort event (a fall) stops it where it is."""
        abort = abort or threading.Event()
        sensor = HALL_UP if target == "up" else HALL_DOWN
        limit = conf["UP_THRESHOLD"] if target == "up" else conf["DOWN_THRESHOLD"]
        fast_ms = conf["MAX_FAST_MS"] + conf["DOWN_EXTRA_MS" if target == "down" else "UP_EXTRA_MS"]
        self.direction.set(0 if target == "up" else 1)
        self.sleep_n.set(1)
        time.sleep(0.002)                      # DRV8834 wake-up
        t0 = time.monotonic()
        reached = seated = peak = peak_at = None
        trace = []
        aborted = False
        try:
            self.step.run(conf["SLOW_NS"])
            aborted = abort.wait(conf["SLOW_MS"] / 1000)
            if not aborted:
                self.step.run(conf["FAST_NS"])
            end = time.monotonic() + fast_ms / 1000
            while not aborted and time.monotonic() < end:
                if abort.is_set():
                    aborted = True
                    break
                v = hall.read(sensor)
                now = time.monotonic()
                if v is not None:
                    a = abs(v)
                    if TRACE:
                        trace.append(f"{(now - t0) * 1000:.0f}:{a}")
                    if reached is None and a > limit:
                        reached = now
                    # Past the threshold the camera still has 0.5-1 mm to go
                    # (stopping there left it short at both ends, P3
                    # 2026-11-28): keep stepping until the field stops
                    # rising, i.e. the end stop, or stock's timer
                    if reached is not None:
                        if peak is None or a >= peak + conf["PLATEAU_LSB"]:
                            peak, peak_at = a, now
                        elif seated is None and (now - peak_at) * 1000 >= conf["PLATEAU_MS"]:
                            seated = now
                            end = min(end, now + conf["SEAT_MS"] / 1000)
                time.sleep(0.004)
        finally:
            self.step.stop()
            self.sleep_n.set(0)
            self.direction.set(0)
        ms = (time.monotonic() - t0) * 1000
        where, up, down = position(hall, conf)
        how = ("NOT reached" if reached is None else
               f"reached at {(reached - t0) * 1000:.0f} ms, "
               + (f"end stop at {(seated - t0) * 1000:.0f} ms" if seated else "stopped by the timer"))
        log(f"{target}: {ms:.0f} ms, sensor {how}"
            f"{', ABORTED' if aborted else ''}; now {where} (up {up}, down {down})")
        if TRACE:
            log("trace (ms:|field|) " + " ".join(trace))
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        with open(STATE, "w") as f:
            f.write(where + "\n")
        return where == target


class FallDetector:
    """|a| below a threshold for long enough: the phone is falling."""

    def __init__(self, conf):
        self.limit = conf["FALL_MMS2"] / 1000
        self.ms = conf["FALL_MS"]
        self.samples = conf["FALL_SAMPLES"]
        self.since = None
        self.n = 0

    def feed(self, t, x, y, z):
        if math.sqrt(x * x + y * y + z * z) >= self.limit:
            self.since, self.n = None, 0
            return False
        if self.since is None:
            self.since = t
        self.n += 1
        return self.n >= self.samples and (t - self.since) * 1000 >= self.ms


SAMPLE = re.compile(rb"X=(-?[0-9.]+) Y=(-?[0-9.]+) Z=(-?[0-9.]+)")


class FallWatch:
    """ssccli's accelerometer stream, read through a pty (its stdout would
    otherwise be block-buffered), fed to a FallDetector in a thread.
    `fell` is set on a fall and stays set until cleared."""

    CMD = ["ssccli", "--sensor", "accelerometer", "--timeout", "86400"]

    def __init__(self, conf):
        self.conf = conf
        self.fell = threading.Event()
        self.ready = threading.Event()
        self.proc = None
        self.thread = None
        self.warned = False

    def running(self):
        return self.thread is not None and self.thread.is_alive()

    def start(self):
        if self.running():
            return
        self.ready.clear()
        self.thread = threading.Thread(target=self._run, daemon=True)
        self.thread.start()

    def stop(self):
        p = self.proc
        if p and p.poll() is None:
            p.terminate()
        if self.thread:
            self.thread.join(2)
        self.thread = None
        self.ready.clear()

    def _run(self):
        det = FallDetector(self.conf)
        try:
            master, slave = pty.openpty()
            self.proc = subprocess.Popen(self.CMD, stdout=slave, stdin=subprocess.DEVNULL,
                                         stderr=subprocess.DEVNULL, close_fds=True)
        except OSError as e:
            log(f"free-fall watch: cannot start ssccli: {e}")
            return
        os.close(slave)
        buf = b""
        try:
            while True:
                try:
                    data = os.read(master, 4096)
                except OSError:
                    break
                if not data:
                    break
                now = time.monotonic()
                buf += data
                *lines, buf = buf.split(b"\n")
                for line in lines:
                    m = SAMPLE.search(line)
                    if not m:
                        continue
                    if not self.ready.is_set():
                        self.ready.set()
                        if self.warned:
                            log("free-fall watch: accelerometer back")
                            self.warned = False
                    if det.feed(now, *(float(v) for v in m.groups())):
                        if not self.fell.is_set():
                            log("free fall detected")
                        self.fell.set()
        finally:
            os.close(master)
            if self.proc.poll() is None:
                self.proc.terminate()
            self.proc.wait()
            self.ready.clear()

    def ensure(self, want):
        """Keep the stream running while wanted (restarted if ssccli exits)."""
        if want and not self.running():
            self.start()
        elif not want and self.running():
            self.stop()

    def wait_ready(self):
        if self.ready.wait(self.conf["FALL_READY_MS"] / 1000):
            return True
        if not self.warned:
            log("free-fall watch: no accelerometer samples (SLPI sensors down?): "
                "raising WITHOUT drop protection")
            self.warned = True
        return False


def cmd_move(target):
    conf = load_conf()
    hall = Hall()
    where, up, down = position(hall, conf)
    if where == target == "up":
        log(f"already up (up {up}, down {down}); not moving")
        return 0
    # "down" always runs: it seats a camera that reads down but stands proud
    # (the end-stop check ends it within about 0.2 s when it is home)
    if where == "unknown" and target == "up":
        log(f"position unknown (up {up}, down {down}): only 'down' is allowed")
        return 1
    return 0 if Motor().move(hall, conf, target) else 1


def front_sensor_state():
    for dev in glob.glob("/sys/bus/i2c/drivers/imx471/*-*/power/runtime_status"):
        return open(dev).read().strip()
    return None


def cmd_daemon():
    if not os.path.exists(ENABLE):
        log(f"{ENABLE} missing: the pop-up stays where it is")
        return 0
    conf = load_conf()
    hall = Hall()
    motor = Motor()
    fall = FallWatch(conf)
    stopping = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: stopping.set())
    signal.signal(signal.SIGINT, lambda *_: stopping.set())
    where, up, down = position(hall, conf)
    log(f"start: {where} (up {up}, down {down})")
    if where != "down":
        motor.move(hall, conf, "down")
    idle_since = None
    held = False     # pushed in, fell, or a move failed: wait for the camera to go idle
    try:
        while not stopping.is_set():
            state = front_sensor_state()
            where, up, _ = position(hall, conf)
            # The accelerometer only while the camera is out or about to come out
            fall.ensure(state == "active" or where != "down")
            if fall.fell.is_set():
                fall.fell.clear()
                if where != "down":
                    log(f"falling with the camera {where}: lowering")
                    motor.move(hall, conf, "down")
                    if state == "active":
                        held = True
                stopping.wait(0.2)
                continue
            if state == "active":
                idle_since = None
                if held:
                    pass
                elif where == "down":
                    fall.wait_ready()
                    held = not motor.move(hall, conf, "up", abort=fall.fell)
                elif where == "unknown":
                    # Up, then no longer at the top: pushed in by hand (stock
                    # lowers it too), or it never got there
                    log(f"left the top while in use (up {up}): lowering, not raising again until idle")
                    motor.move(hall, conf, "down")
                    held = True
            else:
                held = False
                idle_since = idle_since or time.monotonic()
                if where != "down" and (time.monotonic() - idle_since) * 1000 >= conf["IDLE_DOWN_MS"]:
                    motor.move(hall, conf, "down")
            # A fall wakes the loop at once
            fall.fell.wait(0.2)
    finally:
        where, _, _ = position(hall, conf)
        if where != "down":
            motor.move(hall, conf, "down")
        fall.stop()
    return 0


def cmd_watch_fall():
    conf = load_conf()
    fall = FallWatch(conf)
    fall.start()
    if not fall.ready.wait(3):
        log("no accelerometer samples")
        fall.stop()
        return 1
    log("watching; Ctrl-C to stop")
    try:
        while True:
            if fall.fell.wait(0.5):
                print(f"{time.strftime('%H:%M:%S')} FALL", flush=True)
                fall.fell.clear()
            if not fall.running():
                log("ssccli exited")
                return 1
    except KeyboardInterrupt:
        pass
    finally:
        fall.stop()
    return 0


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "status":
        conf = load_conf()
        where, up, down = position(Hall(), conf)
        print(f"{where} up={up} down={down} "
              f"thresholds={conf['UP_THRESHOLD']}/{conf['DOWN_THRESHOLD']}")
        return 0
    if cmd in ("up", "down"):
        return cmd_move(cmd)
    if cmd == "daemon":
        return cmd_daemon()
    if cmd == "watch-fall":
        return cmd_watch_fall()
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main())
