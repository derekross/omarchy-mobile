# OnePlus 7T Pro: the SAR sensor (Semtech SX9324, on the SLPI's own bus) as a
# near/far state in /run/omamobile/sar/ (device/hotdog/SENSORS-PLAN.md
# section 6). It subscribes once over QMI with non-wakeup delivery, so a grip
# never wakes the phone, and follows SLPI restarts through the QRTR name
# service. While near, the modem gets QMI SAR state 8 and Wi-Fi a 14 dBm
# limit (CAP_NET_ADMIN, for nl80211); far gives both back.
#   /etc/omamobile/sar.conf               OMAMOBILE_SAR_BACKOFF=no, ..._MODEM_STATE, ..._WIFI_DBM
#   systemctl mask omamobile-hotdog-sar   keeps it off
[Unit]
Description=OnePlus 7T Pro SAR sensor state (SX9324 through the Sensor Core)
After=omamobile-hotdog-sensors.service

[Service]
ExecStart=/usr/lib/omamobile/hotdog/omamobile-hotdog-sar
Restart=on-failure
RestartSec=5
EnvironmentFile=-/etc/omamobile/sar.conf
DynamicUser=yes
RuntimeDirectory=omamobile/sar
RuntimeDirectoryMode=0755
RestrictAddressFamilies=AF_QIPCRTR AF_UNIX AF_NETLINK
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
