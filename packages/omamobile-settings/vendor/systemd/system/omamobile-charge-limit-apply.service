# SPDX-License-Identifier: MIT
# Applies the saved charge limit (/etc/omamobile/charge-limit) to the MAX77759 charger. Pulled in by udev when the
# charger appears (75-omamobile-charge-limit.rules); the helper does nothing on phones other than husky or without
# the file. Not enabled.
[Unit]
Description=Apply the saved charge limit
StartLimitIntervalSec=0
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/lib/omamobile-settings/charge-limit
TimeoutStartSec=15
