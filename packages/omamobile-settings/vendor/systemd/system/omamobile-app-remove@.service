# The Settings app's Apps page: uninstalls one app, "/usr/lib/omamobile-settings/app-remove %I" (PKG:HASH) as root.
# The polkit rule 50-omamobile-app-remove.rules lets the active local user start these units; the helper refuses
# anything app-guard does not allow, or a target list other than the one the user confirmed. Not enabled.
[Unit]
Description=Uninstall app %I
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/lib/omamobile-settings/app-remove %I
TimeoutStartSec=320
