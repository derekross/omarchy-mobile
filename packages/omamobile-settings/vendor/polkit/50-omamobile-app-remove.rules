// SPDX-License-Identifier: MIT
// The Settings app's Apps page: let the active local user start omamobile-app-remove@PKG:HASH.service, which runs
// "/usr/lib/omamobile-settings/app-remove PKG:HASH" as root. That helper removes only what app-guard allows (never a
// protected or required package) and only the exact target list the user confirmed. Nothing else: no stop, no other unit.
polkit.addRule(function(action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      subject.local && subject.active &&
      /^omamobile-app-remove@([a-z0-9_.]|\\x(2d|2b|2e|40))+:[0-9a-f]{16}\.service$/.test(action.lookup("unit")) &&
      action.lookup("verb") == "start") {
    return polkit.Result.YES;
  }
});
