// SPDX-License-Identifier: MIT
// The Settings app's Security & privacy page: let the active local user start omamobile-firewall@on.service and
// omamobile-firewall@off.service, which run "/usr/lib/omamobile-settings/firewall on|off" as root. Nothing else.
polkit.addRule(function(action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      subject.local && subject.active &&
      /^omamobile-firewall@(on|off)\.service$/.test(action.lookup("unit")) &&
      action.lookup("verb") == "start") {
    return polkit.Result.YES;
  }
});
