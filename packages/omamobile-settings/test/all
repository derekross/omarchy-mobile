#!/bin/sh
# SPDX-License-Identifier: MIT
set -eu
source_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
build_dir=${OMAMOBILE_SETTINGS_TEST_BUILD_DIR:-"$source_dir/build/tests"}
"$source_dir/bin/build"
"$source_dir/test/display-backend.sh"
"$source_dir/test/charge-backend.sh"
python3 -I "$source_dir/test/credits.py"
mkdir -p "$build_dir"
fixture=$(mktemp -d)
trap 'rm -rf -- "$fixture"' EXIT HUP INT TERM
mkdir -p "$fixture/runtime" "$fixture/state" "$fixture/data" "$fixture/config" "$fixture/cache"
chmod 700 "$fixture/runtime"
cd "$build_dir"
qmake6 "$source_dir/tests/core_tests.pro"
make -j1
HOME="$fixture" XDG_STATE_HOME="$fixture/state" XDG_DATA_HOME="$fixture/data" XDG_CONFIG_HOME="$fixture/config" XDG_CACHE_HOME="$fixture/cache" \
  XDG_RUNTIME_DIR="$fixture/runtime" QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software \
  QT_QPA_PLATFORMTHEME= NO_AT_BRIDGE=1 GSETTINGS_BACKEND=memory ./settings-core-tests

# The guard bites: a HOME outside TMPDIR must stop the tests with exit 2. Every
# path is inside the fixture and the run keeps the main run's protections, so a
# broken guard would write into the fixture only.
o="$fixture/outside"
mkdir -p "$o/state" "$o/data" "$o/config" "$o/cache" "$fixture/tmp"
status=0
HOME="$o" TMPDIR="$fixture/tmp" XDG_STATE_HOME="$o/state" XDG_DATA_HOME="$o/data" XDG_CONFIG_HOME="$o/config" XDG_CACHE_HOME="$o/cache" \
  XDG_RUNTIME_DIR="$fixture/runtime" QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software \
  QT_QPA_PLATFORMTHEME= NO_AT_BRIDGE=1 GSETTINGS_BACKEND=memory DBUS_SESSION_BUS_ADDRESS=disabled: ./settings-core-tests >"$fixture/guard.out" 2>&1 || status=$?
if [ "$status" != 2 ] || ! grep -q "refusing to run" "$fixture/guard.out"; then
  cat "$fixture/guard.out" >&2
  echo "not ok - settings-core-tests refuses a HOME outside TMPDIR (exit $status)" >&2
  exit 1
fi

# And the "must exist" rule: the main run's environment with XDG_CACHE_HOME
# pointing at a directory that doesn't exist (inside the fixture) also stops
# with exit 2.
status=0
HOME="$fixture" XDG_STATE_HOME="$fixture/state" XDG_DATA_HOME="$fixture/data" XDG_CONFIG_HOME="$fixture/config" XDG_CACHE_HOME="$fixture/no-such-cache" \
  XDG_RUNTIME_DIR="$fixture/runtime" QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software \
  QT_QPA_PLATFORMTHEME= NO_AT_BRIDGE=1 GSETTINGS_BACKEND=memory DBUS_SESSION_BUS_ADDRESS=disabled: ./settings-core-tests >"$fixture/guard.out" 2>&1 || status=$?
if [ "$status" != 2 ] || ! grep -q "points to a directory that does not exist" "$fixture/guard.out" || [ -e "$fixture/no-such-cache" ]; then
  cat "$fixture/guard.out" >&2
  echo "not ok - settings-core-tests refuses an XDG_*_HOME that doesn't exist (exit $status)" >&2
  exit 1
fi

lifetime="$build_dir/lifetime"
mkdir -p "$lifetime"
(
  cd "$lifetime"
  qmake6 "$source_dir/tests/deviceinfo_lifetime_tests.pro"
  make -j1
  HOME="$fixture" XDG_STATE_HOME="$fixture/state" XDG_DATA_HOME="$fixture/data" XDG_CONFIG_HOME="$fixture/config" XDG_CACHE_HOME="$fixture/cache" \
    XDG_RUNTIME_DIR="$fixture/runtime" QT_QPA_PLATFORMTHEME= NO_AT_BRIDGE=1 ./settings-deviceinfo-lifetime-tests
)
session="$build_dir/session"
mkdir -p "$session"
(
  cd "$session"
  qmake6 "$source_dir/tests/session_app.pro"
  make -j1
)
HOME="$fixture" XDG_STATE_HOME="$fixture/state" XDG_DATA_HOME="$fixture/data" XDG_CONFIG_HOME="$fixture/config" XDG_CACHE_HOME="$fixture/cache" \
  XDG_RUNTIME_DIR="$fixture/runtime" QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software \
  QT_QPA_PLATFORMTHEME= NO_AT_BRIDGE=1 GSETTINGS_BACKEND=memory dbus-run-session -- python3 "$source_dir/test/single-instance.py" \
  "$session/settings-session-test-app"
