#!/bin/bash
# SPDX-License-Identifier: MIT
# app-remove PKG:HASH (root, from omamobile-app-remove@PKG:HASH.service; the polkit rule 50-omamobile-app-remove.rules
# lets the active local user start those units and nothing else). Uninstalls one app the Settings Apps page confirmed:
#   1. asks app-guard again, as root; refuses unless it says "ok" and its hash of the targets is HASH (what the user saw)
#   2. removes PKG with Omarchy's own omarchy-pkg-drop (pacman -Rns --noconfirm as root)
#   3. checks with pacman -Q that every target is gone, and writes the result for the page and a line to the log
# Result: $run/app-remove.HASH (one file per request), one JSON line {"pkg":..,"hash":..,"ok":true|false,"why":".."} (0644).
# Log: $log, "DATE removed NAME VERSION ..." per uninstall (the reinstall list).
# Test hooks: OMAMOBILE_APPMGR_ROOT (a scratch root for run/ and log/), and then PATH is kept (stubs).
set -uo pipefail
export LC_ALL=C
root=${OMAMOBILE_APPMGR_ROOT:-}
if [[ -n $root ]]; then [[ $root == /* && $root != / && -d $root ]] || exit 2
else export PATH=/usr/bin:/usr/share/omarchy/bin OMARCHY_PATH=/usr/share/omarchy; fi
guard=${OMAMOBILE_APPMGR_GUARD:-/usr/lib/omamobile-settings/app-guard}
run=$root/run/omamobile-settings
log=$root/var/log/omamobile-app-remove.log
arg=${1:-}
pkg=${arg%:*} want=${arg##*:}
esc() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/ }; s=${s//$'\t'/ }; printf '%s' "${s:0:600}"; }
result() {  # ok why
  mkdir -p -m 0755 "$run" && printf '{"pkg":"%s","hash":"%s","ok":%s,"why":"%s"}\n' "$(esc "$pkg")" "$(esc "$want")" "$1" "$(esc "$2")" >"$run/app-remove.$want.tmp" \
    && chmod 0644 "$run/app-remove.$want.tmp" && mv -f "$run/app-remove.$want.tmp" "$run/app-remove.$want"
  echo "omamobile-app-remove: $pkg: ${2:-removed}"
  [[ $1 == true ]]; exit $?
}
[[ $# -eq 1 && $arg == *:* && $pkg =~ ^[a-z0-9@_+][a-z0-9@._+-]{0,127}$ && $want =~ ^[0-9a-f]{16}$ ]] || { echo "omamobile-app-remove: bad request"; exit 1; }
mapfile -t lines < <("$guard" "$pkg" 2>/dev/null)
verdict=${lines[0]-} hash='' targets=()
for l in "${lines[@]:1}"; do
  IFS=$'\t' read -r k a b _ <<<"$l"
  case $k in hash) hash=$a ;; target) targets+=("$a $b") ;; esac
done
[[ $verdict == ok$'\t'* ]] || result false "${verdict#*$'\t'}"
[[ $hash == "$want" ]] || result false "what would be removed changed since you confirmed; open the app again"
((${#targets[@]})) || result false "nothing to remove"
names=(); for t in "${targets[@]}"; do names+=("${t% *}"); done
before=$(timeout 20 pacman -Qq 2>/dev/null) || result false "cannot read the installed packages"
# the exact confirmed list, so pacman has nothing of its own to add (unless the database changed in between: checked below)
drop_ok=1; timeout 300 omarchy-pkg-drop "${names[@]}" >/dev/null 2>&1 || drop_ok=0
after=$(timeout 20 pacman -Qq 2>/dev/null) || result false "the installed packages could not be read back after the removal"
extra=$(comm -23 <(sort <<<"$before") <(sort <<<"$after") | grep -vxF -f <(printf '%s\n' "${names[@]}") | tr '\n' ' ')
[[ -n $extra ]] && { mkdir -p -m 0755 "${log%/*}"; printf '%s ALSO REMOVED (not confirmed) %s\n' "$(date -Is)" "$extra" >>"$log"; result false "pacman also removed packages that were not shown: $extra(reinstall them with sudo pacman -S)"; }
gone=$(comm -23 <(sort <<<"$before") <(sort <<<"$after") | tr '\n' ' ')
((drop_ok)) || { [[ -n $gone ]] && { mkdir -p -m 0755 "${log%/*}"; printf '%s PARTLY removed %s\n' "$(date -Is)" "$gone" >>"$log"; }; result false "pacman could not remove $pkg${gone:+ (removed before it stopped: $gone)}"; }
left=()
for t in "${targets[@]}"; do timeout 10 pacman -Q -- "${t% *}" >/dev/null 2>&1 && left+=("${t% *}"); done
((${#left[@]})) && result false "still installed after removal: ${left[*]}"
mkdir -p -m 0755 "${log%/*}" && printf '%s removed %s\n' "$(date -Is)" "${targets[*]}" >>"$log"
result true ""
