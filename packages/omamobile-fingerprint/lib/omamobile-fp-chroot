#!/bin/bash
# SPDX-License-Identifier: MIT
# omamobile-fp-chroot: run Google's fingerprint stack for the Pixel 7 Pro or
# the Pixel 9a in a minimal chroot (device/cheetah/FINGERPRINT-RESEARCH.md, section 4;
# bring-up runbook in FINGERPRINT-PLAN.md).
#
#   omamobile-fp-chroot check            preconditions only; changes nothing
#   omamobile-fp-chroot paths            the device and paths in use; read-only
#   omamobile-fp-chroot preflight        the safety checks a start runs before
#                                        storageproxyd (the read-only copies,
#                                        the TDP guard, once per boot). Not a
#                                        dry check: it makes the copies, and on
#                                        success it counts as this boot's start,
#                                        so the service then refuses until a
#                                        reboot (start runs it itself)
#   omamobile-fp-chroot start [STAGE]    start the stack up to STAGE, in the
#                                        foreground (systemd runs it), and
#                                        supervise it until stopped
#   omamobile-fp-chroot ns CMD...        run a host command (ls, cat, kill)
#                                        in the running stack's namespaces
#   omamobile-fp-chroot run CMD...       run an Android binary in the chroot
#
# STAGE (each includes the ones before):
#   storage    servicemanager, vndservicemanager, storageproxyd
#   apploader  + trusty_apploader g7.app (the 9a: g7a.app)
#   keys       + Trusty KeyMint and Gatekeeper HALs
#   hal        + the Goodix fingerprint HAL
#   bridge     + omamobile-fp-bridge, fprintd's way in (default)
#
# The Android files come from tools/extract-fingerprint-vendor (Google's,
# never shipped by Omarchy Mobile) in $IMAGE; our preload shim in $SHIM. The
# chroot is a private mount namespace on a tmpfs: the image is bind-mounted
# read-only, and only $STATE (Trusty's secure storage files, the HAL's data)
# persists. It shares the host's network namespace on purpose: the sensor
# driver's netlink socket exists only in the initial one.
#
# Safety before storageproxyd (preflight; FINGERPRINT-PLAN F19 and
# section 4). Every start runs storageproxyd, and Trusty's storage writes
# the RPMB, so:
#   - the read-only copies (the 7 Pro): at the first start it copies
#     mfg_data (dd) and persist:/ss/0 and /ss/nsp (debugfs, which reads the
#     partition without mounting it) into $STATE and records their sha256 in
#     $STATE/provenance. Both partitions must read ro=1 (the storage guard)
#     and persist must not be mounted read-write;
#   - the TDP guard: no storageproxyd without the TDP copy (an empty TDP
#     against stock's RPMB anchor could break stock's persistent store for
#     good), and none once the copy, or persist:/ss/0 itself, no longer
#     matches the recorded hash: Linux or a stock boot changed TDP, and going
#     on would bury that under more writes (FINGERPRINT-PLAN F19);
#   - once per boot: Trusty keeps each store's state for the whole boot, and
#     a storage proxy stopped and started again in the same boot crashed
#     Trusty's storage app on 2026-11-02 (FINGERPRINT-PLAN F19). A marker in
#     /run refuses a second start until a reboot, and the inner start
#     (in the namespace) runs only with the token preflight wrote there;
#   - a start that never got running: a marker in $STATE is set before
#     storageproxyd and cleared once the stack runs. Found at the next boot,
#     it means that start died on the way (Trusty halted, which also takes
#     the AoC's sound and sensors with it), so that boot skips fingerprint
#     once and the one after tries again.
#
# The overrides of the device, the state and the partitions' and markers'
# paths (OMAMOBILE_FP_DEVICE, _STATE, _RUN, _SYSBLOCK, _DEVDIR, _MOUNTS,
# _BOOT_ID, _UIDIR) are honoured only with
# OMAMOBILE_FP_TEST=1, which the unit never sets (test/preflight).
set -euo pipefail

IMAGE=${OMAMOBILE_FP_IMAGE:-/usr/lib/omamobile-fp/root}
SHIM=${OMAMOBILE_FP_SHIM:-/usr/lib/omamobile-fp/omamobile-fp-shim.so}
BRIDGE=${OMAMOBILE_FP_BRIDGE:-/usr/lib/omamobile-fp/omamobile-fp-bridge}
PROBE=${OMAMOBILE_FP_PROBE:-/usr/lib/omamobile-fp/omamobile-tipc-probe}
PROPS_EXTRA=${OMAMOBILE_FP_PROPS_EXTRA:-/usr/lib/omamobile-fp/props.conf}
# The phone, from the device tree (OMAMOBILE_FP_DEVICE overrides): what
# differs is the Goodix trusted app, the KeyMint HAL (C++ on the 7 Pro, Rust
# on the 9a) and what Android's init would have set from the bootloader
# (props-DEVICE.conf, applied after props.conf).
fp_device() {
  local c
  c=$(tr '\0' '\n' < /proc/device-tree/compatible 2>/dev/null || true)
  case $c in
    *google,zumapro-tegu*) echo tegu ;;
    *) echo cheetah ;;
  esac
}
# From the board's compatible string; only test/preflight may override it
DEVICE=$(fp_device)
[[ ${OMAMOBILE_FP_TEST:-} == 1 ]] && DEVICE=${OMAMOBILE_FP_DEVICE:-$DEVICE}
case $DEVICE in
  cheetah)
    TA=g7.app
    KEYMINT=/vendor/bin/hw/android.hardware.security.keymint-service.trusty
    # the 7 Pro's HAL got a bare "on" and the circle after pointer down,
    # and matches with both
    PANEL=1440x3120 PANEL_HZ=60 PANEL_STATE=on LHBM_FIRST=0
    PANEL_NAME=sdc-s6e3hc4 MAP_STORES=0 ;;
  tegu)
    TA=g7a.app
    KEYMINT=/vendor/bin/hw/android.hardware.security.keymint-service.rust.trusty
    # Google's panel_name is the DSI device's name, from the bootloader's
    # "google-tg4c" panel; OMAMOBILE_FP_PANEL_NAME overrides it.
    # the 9a's Trusty stores as block devices (FINGERPRINT-PLAN D1, F4b)
    # the 9a's HAL parses the rate after the "@" of gs_panel's state line
    # ("On: WxH@Hz") and captures at pointer down, so the circle comes first
    PANEL=1080x2424 PANEL_HZ=120 PANEL_STATE="On: 1080x2424@120" LHBM_FIRST=1
    PANEL_NAME=google-tg4c MAP_STORES=1 ;;
  *) echo "omamobile-fp: unknown device '$DEVICE' (cheetah, tegu)" >&2; exit 1 ;;
esac
PANEL_NAME=${OMAMOBILE_FP_PANEL_NAME:-$PANEL_NAME}
PROPS_DEVICE=${OMAMOBILE_FP_PROPS_DEVICE:-/usr/lib/omamobile-fp/props-$DEVICE.conf}
STATE=/var/lib/omamobile-fp
[[ ${OMAMOBILE_FP_TEST:-} == 1 ]] && STATE=${OMAMOBILE_FP_STATE:-$STATE}
RUN=/run/omamobile-fp
# Where the partitions are found
SYSBLOCK=/sys/class/block
DEVDIR=/dev
MOUNTS=/proc/mounts
BOOT_ID_FILE=/proc/sys/kernel/random/boot_id
# test/preflight points these at a fake tree; nothing else may
if [[ ${OMAMOBILE_FP_TEST:-} == 1 ]]; then
  RUN=${OMAMOBILE_FP_RUN:-$RUN}
  SYSBLOCK=${OMAMOBILE_FP_SYSBLOCK:-$SYSBLOCK}
  DEVDIR=${OMAMOBILE_FP_DEVDIR:-$DEVDIR}
  MOUNTS=${OMAMOBILE_FP_MOUNTS:-$MOUNTS}
  BOOT_ID_FILE=${OMAMOBILE_FP_BOOT_ID:-$BOOT_ID_FILE}
fi
PROVENANCE=$STATE/provenance
# Set before storageproxyd, cleared once the stack runs (see the header).
PENDING=$STATE/start-pending
# Set once storageproxyd may have started this boot; /run goes with the
# reboot, which is exactly when Trusty's state does.
MARKER=$RUN/storageproxyd-started
ROOT=$RUN/root
NSPID=$RUN/ns.pid

# The UFS RPMB well-known LUN (stock storageproxyd: -r /dev/sg1).
RPMB_LUN=49476
# Our touchscreen driver's input device name (synaptics_tcm).
TOUCH_NAME="Synaptics TouchComm Touchscreen"
# The bridge's socket directory on the host (root only); in the chroot it
# is /dev/socket/omamobile-fp.
SOCKDIR=$RUN/sock
# The bridge's state for the desktop (omamobile-shell's fingerprint target):
# world-readable, unlike everything else here. In the chroot it is
# /dev/socket/omamobile-fp-ui.
UIDIR=/run/omamobile-fp-ui
[[ ${OMAMOBILE_FP_TEST:-} == 1 ]] && UIDIR=${OMAMOBILE_FP_UIDIR:-$UIDIR}
# The shell keeps a file fresh in here while the on-screen keyboard is up
# (its keys can cover the sensor); the bridge then ignores touches on the
# sensor. Sticky and world-writable like /tmp: a user can only turn
# fingerprint captures off with it, and cannot touch another user's file.
INHIBITDIR=$UIDIR/inhibit

say() { printf 'omamobile-fp: %s\n' "$*" >&2; }
die() { say "error: $*"; exit 1; }
# A refusal of the data checks: unlike a failed start it recurs at every
# boot until someone acts, so the desktop is told why (world-readable, like
# the bridge's state file; onboarding reads it).
refuse() {
  install -d -m 0755 "$UIDIR" 2>/dev/null && echo data-check > "$UIDIR/off-reason" 2>/dev/null || true
  die "$*"
}

# Host tools, resolved now: the Android processes get an Android PATH, and
# env(1) would look chroot up in that.
CHROOT_BIN=$(PATH=/usr/bin:/bin:/usr/sbin:/sbin command -v chroot || true)

# A supervised child still running (not gone, not a zombie)? PIDS[] holds
# the namespace's PIDs, so this reads the namespace's procfs, which setup()
# mounts at $ROOT/proc; the host's /proc would answer for another process.
alive() {
  local st
  st=$(sed 's/^.*) //' "$ROOT/proc/$1/stat" 2>/dev/null) || return 1
  [[ -n $st && ${st%% *} != Z ]]
}

# TERM the named children, then wait up to $1 tenths of a second for them.
stop_children() {
  local tenths=$1 n p i any; shift
  for n in "$@"; do
    p=${PIDS[$n]:-}
    [[ -n $p ]] && kill -TERM "$p" 2>/dev/null || true
  done
  for ((i = 0; i < tenths; i++)); do
    any=0
    for n in "$@"; do
      p=${PIDS[$n]:-}
      [[ -n $p ]] && alive "$p" && any=1
    done
    ((any)) || return 0
    sleep 0.1
  done
  say "still running after $((tenths / 10)) s: $*"
}

# Stop everything once: ignore further TERM/INT first, so the group-wide
# kill below cannot re-enter this handler. The bridge and the HALs go first,
# and storageproxyd last, so no trusted-app commit is in flight when the
# proxy disappears (a proxy killed under a live TA left Trusty's storage
# inconsistent on 2026-11-02, FINGERPRINT-PLAN F19). Then the process group,
# and exit: as the namespace's PID 1, exiting also ends every process left.
STOPPING=
stop() {
  local code=${1:-0}
  [[ -n $STOPPING ]] && exit "$code"
  STOPPING=1
  trap '' TERM INT
  say "stopping: the bridge and the HALs first, the storage proxy last"
  # no capture runs any more: the desktop drops its target
  rm -f "$UIDIR/state.json" "$UIDIR/state.json.new"
  stop_children 100 bridge fingerprint
  stop_children 50 gatekeeper keymint
  stop_children 50 storageproxyd
  kill -TERM 0 2>/dev/null || true
  exit "$code"
}

rpmb_sg() {
  local d
  for d in /sys/class/scsi_generic/sg*; do
    [[ -e $d/device ]] || continue
    [[ $(basename "$(readlink -f "$d/device")") == *:$RPMB_LUN ]] && { basename "$d"; return; }
  done
}

touch_event() {
  local d
  for d in /sys/class/input/event*; do
    [[ $(cat "$d/device/name" 2>/dev/null) == "$TOUCH_NAME" ]] && { basename "$d"; return; }
  done
}

check() {
  local ok=1 sg
  [[ $EUID -eq 0 ]] || die "run as root"
  [[ -x $CHROOT_BIN ]] || { say "no chroot(1) on the host (coreutils)"; ok=0; }
  [[ -f $IMAGE/vendor/bin/hw/android.hardware.biometrics.fingerprint-service.goodix ]] ||
    { say "no vendor image in $IMAGE (tools/extract-fingerprint-vendor)"; ok=0; }
  [[ -f $SHIM ]] || { say "no shim at $SHIM (fingerprint/Makefile)"; ok=0; }
  [[ -c /dev/trusty-ipc-dev0 ]] || { say "no /dev/trusty-ipc-dev0 (trusty_ipc loaded?)"; ok=0; }
  [[ -c /dev/goodix_fp ]] || say "no /dev/goodix_fp: only stages before 'hal' can run"
  # trusty_apploader hands g7.app to Trusty in a dma-buf from this heap
  [[ -c /dev/dma_heap/system ]] ||
    say "no /dev/dma_heap/system (modprobe system_heap): only 'storage' can run"
  [[ -x $BRIDGE ]] || say "no bridge at $BRIDGE: only stages before 'bridge' can run"
  [[ -n $(touch_event) ]] || say "no touchscreen ($TOUCH_NAME): the bridge cannot start captures"
  grep -qw binder /proc/filesystems || { say "kernel has no binderfs"; ok=0; }
  sg=$(rpmb_sg)
  [[ -n $sg ]] || { say "no SCSI generic node for the RPMB LUN $RPMB_LUN (modprobe sg)"; ok=0; }
  [[ -n $sg ]] && say "RPMB: /dev/$sg"
  if ((MAP_STORES)); then
    [[ -f $STATE/mfg_data.img ]] ||
      say "no $STATE/mfg_data.img: the HAL will run without factory calibration"
  else
    [[ -f $STATE/mfg_data.img ]] ||
      say "no $STATE/mfg_data.img yet: the first start copies it from mfg_data"
  fi
  [[ -n ${OMAMOBILE_FP_IN_NS:-} || ! -e $MARKER ]] || say "storageproxyd already started this boot: a new start needs a reboot"
  ((ok)) || exit 1
  say "preconditions met"
}

# --- Safety before storageproxyd (see the header) ---------------------------

# The block device name of a partition, by PARTNAME (the Arch root has no
# /dev/disk/by-partlabel).
part_dev() {
  local f
  for f in "$SYSBLOCK"/*/uevent; do
    grep -qx "PARTNAME=$1" "$f" 2>/dev/null && { basename "$(dirname "$f")"; return 0; }
  done
  return 1
}

sha() { sha256sum "$1" | cut -d' ' -f1; }
recorded() { [[ ! -f $PROVENANCE ]] || awk -v n="$1" '$2 == n {print $1; exit}' "$PROVENANCE"; }

# A partition fit to be read: found, read-only (the storage guard), and not
# mounted read-write. Prints its device name.
ro_part() {
  local d
  d=$(part_dev "$1") || die "no $1 partition (PARTNAME=$1 in $SYSBLOCK/*/uevent)"
  [[ $(cat "$SYSBLOCK/$d/ro" 2>/dev/null) == 1 ]] ||
    refuse "$1 ($d) is not read-only: the storage guard must keep it ro=1. Nothing copied, nothing started"
  if awk -v d="$DEVDIR/$d" '$1 == d && $4 ~ /(^|,)rw(,|$)/ {f = 1} END {exit !f}' "$MOUNTS" 2>/dev/null; then
    refuse "$1 ($d) is mounted read-write. Nothing copied, nothing started"
  fi
  printf '%s\n' "$d"
}

# Read one file out of persist's ext4 with debugfs: no mount, no journal
# replay, nothing written to the partition. Fails on an empty result.
persist_dump() { # $1 path in persist, $2 output, $3 the partition's device
  rm -f "$2"
  debugfs -R "dump -p $1 $2" "$DEVDIR/$3" >/dev/null 2>&1 || true
  [[ -s $2 ]]
}

# The 7 Pro's read-only copies, once (FINGERPRINT-PLAN F19.3, done by the
# runner): mfg_data and persist:/ss/{0,nsp} into $STATE, their sha256
# recorded in $STATE/provenance. A phone set up by hand (copies there, no
# provenance) has its TDP copy checked against persist:/ss/0 and adopted.
provision() {
  local p m tmp
  [[ -f $PROVENANCE ]] && return 0
  p=$(ro_part persist)
  m=$(ro_part mfg_data)
  command -v debugfs >/dev/null || die "no debugfs (e2fsprogs): can't read persist without mounting it"
  install -d -m 0700 "$STATE" "$STATE/persist-ss"
  tmp=$STATE/.provision
  rm -rf "$tmp"
  install -d -m 0700 "$tmp"
  if [[ -e $STATE/persist-ss/0 ]]; then
    persist_dump /ss/0 "$tmp/0" "$p" || die "can't read persist:/ss/0 to check the existing TDP copy"
    cmp -s "$tmp/0" "$STATE/persist-ss/0" ||
      refuse "$STATE/persist-ss/0 differs from persist:/ss/0: Linux's TDP copy and stock's no longer agree. Not starting: ask (FINGERPRINT-PLAN F19)"
    say "the existing TDP copy matches persist:/ss/0: recording it"
  else
    persist_dump /ss/0 "$tmp/0" "$p" ||
      refuse "persist has no /ss/0 (or it can't be read): without a TDP copy storageproxyd won't start"
    persist_dump /ss/nsp "$tmp/nsp" "$p" ||
      say "persist has no /ss/nsp: Trusty starts an empty one (it has no rollback check)"
    mv "$tmp/0" "$STATE/persist-ss/0"
    [[ ! -f $tmp/nsp ]] || mv "$tmp/nsp" "$STATE/persist-ss/nsp"
    say "copied persist:/ss read-only (debugfs; persist is never mounted)"
  fi
  dd if="$DEVDIR/$m" of="$tmp/mfg_data.img" bs=1M status=none || die "can't read mfg_data"
  [[ -s $tmp/mfg_data.img ]] || die "mfg_data read empty"
  chmod 0600 "$tmp/mfg_data.img"
  if [[ -s $STATE/mfg_data.img ]] && cmp -s "$tmp/mfg_data.img" "$STATE/mfg_data.img"; then
    say "the existing mfg_data.img matches the partition: recording it"
  else
    if [[ -e $STATE/mfg_data.img ]]; then
      mv -- "$STATE/mfg_data.img" "$STATE/mfg_data.img.before-provision.$(date +%Y%m%d%H%M%S)"
      say "the existing mfg_data.img differs from the partition: moved aside, copied again"
    fi
    mv "$tmp/mfg_data.img" "$STATE/mfg_data.img"
    say "copied mfg_data read-only (the factory calibration; the partition is never written)"
  fi
  rm -rf "$tmp"
  {
    echo "# omamobile-fp-chroot: read-only copies, $(date -Is 2>/dev/null || date). Never edit."
    echo "$(sha "$STATE/persist-ss/0")  persist-ss/0"
    [[ ! -f $STATE/persist-ss/nsp ]] || echo "$(sha "$STATE/persist-ss/nsp")  persist-ss/nsp"
    echo "$(sha "$STATE/mfg_data.img")  mfg_data.img"
  } > "$PROVENANCE.new"
  chmod 0600 "$PROVENANCE.new"
  mv "$PROVENANCE.new" "$PROVENANCE"
  say "recorded in $PROVENANCE: $(awk '!/^#/ {printf "%s %.16s  ", $2, $1}' "$PROVENANCE")"
}

# No storageproxyd without a TDP copy that still matches its recorded hash,
# and a persist:/ss/0 that still matches it too. A difference refuses the
# start rather than warning: once Linux has written TDP (or stock has, after
# a slot A boot), every further start moves the RPMB anchor on from the
# copy stock would read, and only the maintainer can decide what is safe.
tdp_guard() {
  local want got p tmp
  if ((MAP_STORES)); then
    # the 9a: TDP is tdp.img, the F3 copy of trusty_persist (before the
    # first mapped run, that copy as persist-ss/0)
    [[ -f $STATE/tdp.img || ( -f $STATE/persist-ss/0 && ! -L $STATE/persist-ss/0 && -s $STATE/persist-ss/0 ) ]] ||
      refuse "no TDP copy ($STATE/tdp.img): storageproxyd won't start without it (device/tegu/FINGERPRINT-PLAN.md F4b)"
    return 0
  fi
  [[ -s $STATE/persist-ss/0 ]] ||
    refuse "no TDP copy ($STATE/persist-ss/0, recorded in $PROVENANCE): storageproxyd won't start without it. Don't recreate it by hand: ask (FINGERPRINT-PLAN F19)"
  want=$(recorded persist-ss/0)
  [[ -n $want ]] || die "$PROVENANCE has no persist-ss/0 line"
  got=$(sha "$STATE/persist-ss/0")
  [[ $got == "$want" ]] ||
    refuse "the TDP copy changed (sha256 ${got:0:16}, recorded ${want:0:16}): Linux wrote Trusty's persistent store, so stock's persist:/ss/0 no longer matches the RPMB. Refusing to start: report it (FINGERPRINT-PLAN F19)"
  p=$(ro_part persist)
  install -d -m 0755 "$RUN"
  tmp=$RUN/persist-ss0.check
  persist_dump /ss/0 "$tmp" "$p" || die "can't read persist:/ss/0 to check it against the copy"
  got=$(sha "$tmp")
  rm -f "$tmp"
  [[ $got == "$want" ]] ||
    refuse "persist:/ss/0 changed since the copy was made (sha256 ${got:0:16}, recorded ${want:0:16}; did stock Android run?): the copy no longer matches the RPMB. Refusing to start: ask (FINGERPRINT-PLAN F19)"
  want=$(recorded mfg_data.img)
  if [[ -n $want && -f $STATE/mfg_data.img && $(sha "$STATE/mfg_data.img") != "$want" ]]; then
    say "warning: $STATE/mfg_data.img differs from its recorded copy (the partition itself is never written)"
  fi
  return 0
}

# Everything before storageproxyd. On success the marker is set: from here
# on this boot's storage proxy counts as started, even if a later step fails.
preflight() {
  if [[ -e $MARKER ]]; then
    die "secure storage already ran this boot ($(sed "s/ token .*//" "$MARKER" 2>/dev/null || true)): Trusty keeps its storage state until a reboot, and a second storage proxy in the same boot can crash it. Reboot to start fingerprint again"
  fi
  local boot pending
  boot=$(cat "$BOOT_ID_FILE" 2>/dev/null || echo unknown)
  if [[ -f $PENDING ]]; then
    pending=$(cat "$PENDING" 2>/dev/null || true)
    if [[ ${pending%% *} != "$boot" ]]; then
      rm -f "$PENDING"
      die "the last start (${pending#* }) never got running: it may have halted Trusty, which also stops the AoC's sound and sensors. Skipping fingerprint this boot; the next boot tries again (journalctl -b -1 -u omamobile-fp)"
    fi
  fi
  ((MAP_STORES)) || provision
  tdp_guard
  rm -f "$UIDIR/off-reason" 2>/dev/null || true
  install -d -m 0755 "$RUN"
  TOKEN=$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')
  # noclobber opens with O_EXCL: of two starts racing past the check above,
  # only one gets the marker
  (set -o noclobber; umask 077; echo "$(date -Is 2>/dev/null || date) pid $$ token $TOKEN" > "$MARKER") 2>/dev/null ||
    die "secure storage already ran this boot (another start got there first). Reboot to start fingerprint again"
  install -d -m 0700 "$STATE"
  echo "$boot $(date -Is 2>/dev/null || date)" > "$PENDING"
}

# Bind $1 onto $2 (created as a file or directory to match), optionally ro.
bind() {
  local src=$1 dst=$2 mode=${3:-rw}
  if [[ -d $src ]]; then mkdir -p "$dst"; else mkdir -p "$(dirname "$dst")"; : > "$dst"; fi
  mount --bind "$src" "$dst"
  [[ $mode == ro ]] && mount -o remount,bind,ro "$dst"
  return 0
}

# Property store: one file per property (see the shim).
write_props() {
  local dir=$1 f line k v
  mkdir -p "$dir"
  for f in "$ROOT/system/build.prop" "$ROOT/vendor/build.prop" "$PROPS_EXTRA" "$PROPS_DEVICE" \
      "$STATE/props.conf"; do
    [[ -f $f ]] || continue
    while IFS= read -r line; do
      [[ $line =~ ^[[:space:]]*# || $line != *=* ]] && continue
      k=${line%%=*} v=${line#*=}
      [[ $k =~ ^[A-Za-z0-9_.:@-]+$ ]] || continue
      printf '%s' "$v" > "$dir/$k"
    done < "$f"
  done
}

# Fake sysfs: only what the HAL reads, plus the real LHBM attributes.
setup_sys() {
  local sys=$ROOT/sys bl
  mount -t tmpfs -o mode=0755,nosuid,nodev,noexec sysfs-skel "$sys"
  bind /sys/devices/system/cpu "$sys/devices/system/cpu" ro
  bind /sys/firmware/devicetree "$sys/firmware/devicetree" ro
  [[ -d /sys/class/thermal ]] && bind /sys/class/thermal "$sys/class/thermal" ro
  for m in trusty_core trusty_virtio; do
    [[ -d /sys/module/$m ]] && bind "/sys/module/$m" "$sys/module/$m"
  done
  mkdir -p "$sys/devices/platform/exynos-drm/primary-panel"
  echo "$PANEL_NAME" > "$sys/devices/platform/exynos-drm/primary-panel/panel_name"
  # The 9a's HAL reads the refresh rate from the backlight state, after its
  # "@" (gs_panel's "On: WxH@Hz"); a bare "on" logs "Failed to parse refresh
  # rate". PANEL_STATE is per device: the 7 Pro keeps its bare "on".
  echo "$PANEL_HZ" > "$sys/devices/platform/exynos-drm/primary-panel/op_hz"
  # The panel driver's backlight device carries local_hbm_mode and
  # local_hbm_max_timeout; expose it under Google's name.
  bl=$(grep -l . /sys/class/backlight/*/local_hbm_mode 2>/dev/null | head -1 || true)
  mkdir -p "$sys/class/backlight/panel0-backlight"
  echo 0 > "$sys/class/backlight/panel0-backlight/hbm_mode"
  echo "$PANEL_STATE" > "$sys/class/backlight/panel0-backlight/state"
  if [[ -n $bl ]]; then
    bl=$(dirname "$bl")
    bind "$bl/local_hbm_mode" "$sys/class/backlight/panel0-backlight/local_hbm_mode"
    bind "$bl/local_hbm_max_timeout" "$sys/class/backlight/panel0-backlight/local_hbm_max_timeout"
  fi
  mount -o remount,ro "$sys"
}

setup_dev() {
  local dev=$ROOT/dev sg=$1 n
  mount -t tmpfs -o mode=0755,nosuid dev "$dev"
  for n in null zero full random urandom kmsg; do bind "/dev/$n" "$dev/$n"; done
  bind /dev/trusty-ipc-dev0 "$dev/trusty-ipc-dev0"
  [[ -c /dev/dma_heap/system ]] && bind /dev/dma_heap/system "$dev/dma_heap/system"
  local ev
  ev=$(touch_event)
  [[ -n $ev ]] && bind "/dev/input/$ev" "$dev/input/touchscreen" ro
  [[ -c /dev/trusty-log0 ]] && bind /dev/trusty-log0 "$dev/trusty-log0"
  [[ -c /dev/goodix_fp ]] && bind /dev/goodix_fp "$dev/goodix_fp"
  # RPMB only: no other SCSI generic node enters the chroot
  bind "/dev/$sg" "$dev/sg-rpmb"
  mkdir -p "$dev/socket" "$dev/binderfs" "$dev/block/by-name"
  # the bridge's socket, reachable from the host (fprintd)
  install -d -m 0700 "$SOCKDIR"
  bind "$SOCKDIR" "$dev/socket/omamobile-fp"
  install -d -m 0755 "$UIDIR"
  rm -f "$UIDIR/state.json" "$UIDIR/state.json.new"
  install -d -m 1777 "$INHIBITDIR"
  bind "$UIDIR" "$dev/socket/omamobile-fp-ui"
  # A private binder instance: binder, hwbinder and vndbinder are created at
  # mount (CONFIG_ANDROID_BINDER_DEVICES).
  mount -t binder binder "$dev/binderfs"
  for n in binder hwbinder vndbinder; do
    [[ -e $dev/binderfs/$n ]] || die "binderfs has no $n (CONFIG_ANDROID_BINDER_DEVICES)"
    ln -s "binderfs/$n" "$dev/$n"
  done
  # Factory calibration: never the partition itself. The HAL opens it
  # read-write (EROFS on a read-only bind, and it then runs without its
  # calibration), so it gets a scratch copy per run in /run: whatever it
  # writes is lost at stop, and the saved copy stays as F3 made it.
  if [[ -f $STATE/mfg_data.img ]]; then
    install -d -m 0700 /run/omamobile-fp
    install -m 0600 "$STATE/mfg_data.img" /run/omamobile-fp/mfg_data.img
    bind /run/omamobile-fp/mfg_data.img "$dev/block/by-name/mfg_data"
  fi
  # Trusty's tamper-detect stores as block devices, as stock maps them
  # (td: trusty_userdata, tdp: trusty_persist), each a loop device of a
  # Linux-owned image in $STATE: storageproxyd takes its size limit (-m)
  # only from a block device. Absent images keep the files in /data.
  local name img loop
  for name in td tdp; do
    img=$STATE/$name.img
    ((MAP_STORES)) && [[ -f $img ]] || continue
    loop=$(losetup -j "$img" | cut -d: -f1 | head -1)
    [[ -n $loop ]] || loop=$(losetup -f --show "$img")
    bind "$loop" "$dev/block/ss-$name"
  done
  # the target lives in the tmpfs just mounted on dev: create it first
  mkdir -p "$dev/__omamobile_props__"
  mount -t tmpfs -o mode=0755,nosuid,nodev,noexec props "$dev/__omamobile_props__"
  write_props "$dev/__omamobile_props__"
}

# Link a store path to its block device. A store already there (a file from
# an earlier unmapped run, or the 7 Pro's restored copy) is moved aside with
# a timestamp, never deleted: losing Trusty's state is never a side effect.
link_store() {
  local dev=$1 path=$2 aside
  [[ -L $path && $(readlink "$path") == "$dev" ]] && return 0
  if [[ -e $path || -L $path ]]; then
    aside=$path.before-map.$(date +%Y%m%d%H%M%S)
    mv -- "$path" "$aside" || die "can't move $path aside"
    say "moved the existing $path to $aside"
  fi
  ln -s "$dev" "$path"
}

setup_data() {
  mkdir -p "$STATE/data/vendor/ss" "$STATE/data/vendor/fingerprint" \
    "$STATE/data/vendor_de/0/fpdata" "$STATE/data/vendor/goodix" \
    "$STATE/data/vendor/tombstones/fingerprint" "$STATE/persist-ss" \
    "$STATE/data/vendor/omamobile-fp"
  chmod 0700 "$STATE/data/vendor/omamobile-fp"
  chmod 0700 "$STATE"
  bind "$STATE/data" "$ROOT/data"
  # Trusty's tamper-detect-persistent files (stock: persist/ss). We use a
  # Linux-owned copy; FINGERPRINT-RESEARCH.md section 6 explains why.
  mkdir -p "$ROOT/data/vendor/ss/persist"
  mount --bind "$STATE/persist-ss" "$ROOT/data/vendor/ss/persist"
  # A mapped store needs its link in place before storageproxyd starts, as
  # on stock: without it storageproxyd answers "pending symlink" and Trusty
  # reads the store as empty.
  if ((MAP_STORES)); then
    [[ -f $STATE/td.img ]] && link_store /dev/block/ss-td "$STATE/data/vendor/ss/0"
    [[ -f $STATE/tdp.img ]] && link_store /dev/block/ss-tdp "$STATE/persist-ss/0"
  fi
  return 0
}

# Build the chroot in the current (private) mount namespace.
setup() {
  local sg=$1
  mkdir -p "$ROOT"
  mount -t tmpfs -o mode=0755,nosuid omamobile-fp "$ROOT"
  for d in system vendor apex; do bind "$IMAGE/$d" "$ROOT/$d" ro; done
  mkdir -p "$ROOT/proc" "$ROOT/sys" "$ROOT/dev" "$ROOT/data" "$ROOT/tmp" \
    "$ROOT/mnt/vendor/persist" "$ROOT/linkerconfig" "$ROOT/omamobile"
  ln -s /system/bin "$ROOT/bin"
  ln -s /system/etc "$ROOT/etc"
  mount -t tmpfs -o mode=1777,nosuid,nodev tmp "$ROOT/tmp"
  mount -t proc -o nosuid,nodev,noexec proc "$ROOT/proc"
  bind "$SHIM" "$ROOT/omamobile/omamobile-fp-shim.so" ro
  [[ -x $BRIDGE ]] && bind "$BRIDGE" "$ROOT/omamobile/omamobile-fp-bridge" ro
  setup_dev "$sg"
  setup_sys
  setup_data
}

# Run an Android binary in the chroot as a supervised child.
# $1 name, $2 vendor|system (library search order), $3... command
LIBS_VENDOR=/vendor/lib64:/vendor/lib64/hw:/system/lib64
LIBS_SYSTEM=/system/lib64:/vendor/lib64
spawn() {
  local name=$1 kind=$2; shift 2
  local libs=$LIBS_VENDOR
  [[ $kind == system ]] && libs=$LIBS_SYSTEM
  say "starting $name"
  # The log prefix runs in a process substitution, so $! is the program
  # itself (env and chroot exec it), which stop() signals by name.
  env -i PATH=/system/bin:/vendor/bin \
    LD_LIBRARY_PATH="$libs" LD_PRELOAD=/omamobile/omamobile-fp-shim.so \
    OMAMOBILE_FP_PROPS=/dev/__omamobile_props__ \
    OMAMOBILE_FP_LOGLEVEL="${OMAMOBILE_FP_LOGLEVEL:-3}" \
    ANDROID_ROOT=/system ANDROID_DATA=/data \
    "$CHROOT_BIN" "$ROOT" "$@" > >(sed -u "s/^/[$name] /") 2>&1 &
  PIDS[$name]=$!
}

wait_prop() { # $1 name, $2 value, $3 timeout s
  local f=$ROOT/dev/__omamobile_props__/$1 i
  for ((i = 0; i < $3 * 10; i++)); do
    [[ -f $f && $(cat "$f") == "$2" ]] && return 0
    sleep 0.1
  done
  return 1
}

declare -A PIDS=()

start() {
  local stage=${1:-bridge} sg
  case $stage in storage|apploader|keys|hal|bridge) ;; *) die "unknown stage $stage" ;; esac
  if [[ -n ${OMAMOBILE_FP_IN_NS:-} ]]; then
    # Only after this boot's preflight: its marker carries the token it
    # handed down, so OMAMOBILE_FP_IN_NS=1 alone can't skip the checks.
    [[ ${OMAMOBILE_FP_TOKEN:-} =~ ^[0-9a-f]{32}$ && -f $MARKER && $(sed -n 's/.* token //p' "$MARKER") == "$OMAMOBILE_FP_TOKEN" ]] ||
      die "the inner start runs only after this boot's preflight (omamobile-fp-chroot start)"
  fi
  # Modules the stack needs, blacklisted from autoload (omamobile-device-
  # cheetah: omamobile-fingerprint.conf): load them by name, as needed.
  if [[ -z ${OMAMOBILE_FP_IN_NS:-} ]]; then
    [[ -n $(rpmb_sg) ]] || modprobe sg || true
    [[ $stage == storage || -c /dev/dma_heap/system ]] || modprobe system_heap || true
    [[ $stage == hal || $stage == bridge ]] && [[ ! -c /dev/goodix_fp ]] &&
      { modprobe goodix_fp || true; }
    udevadm settle -t 5 || true
  fi
  check
  sg=$(rpmb_sg)
  [[ $stage == storage || -c /dev/dma_heap/system ]] ||
    die "no /dev/dma_heap/system: trusty_apploader needs it"
  [[ $stage == bridge && ! -x $BRIDGE ]] && die "no bridge at $BRIDGE"
  [[ $stage == bridge && -z $(touch_event) ]] && die "no touchscreen ($TOUCH_NAME)"
  mkdir -p "$RUN"
  if [[ -z ${OMAMOBILE_FP_IN_NS:-} ]]; then
    # Consent, the read-only copies, the TDP guard, once per boot: every
    # stage starts storageproxyd.
    preflight
    export OMAMOBILE_FP_TOKEN=$TOKEN
    # Re-exec in a private mount namespace (and PID namespace, so the
    # Android processes die with us). Not a network namespace: see above.
    # systemd signals only this process (KillMode=mixed); unshare hands
    # TERM on to our PID 1, whose stop() takes the stack down in order.
    rm -f "$NSPID"
    local fwd=()
    unshare --help 2>/dev/null | grep -c -- '--forward-signals' >/dev/null && fwd=(--forward-signals)
    exec unshare --mount --propagation private --pid --fork --kill-child "${fwd[@]}" \
      env OMAMOBILE_FP_IN_NS=1 "$0" start "$stage"
  fi
  # unshare's child: PID 1 inside, its parent is unshare outside. /run is
  # shared with the host until our mounts, so record the host PID for ns/run.
  awk '/^NSpid:/ {print $2}' /proc/self/status > "$NSPID"
  trap 'stop 0' TERM INT
  # a die from here on (after the proxy may have started) still stops the
  # stack in order
  trap 'stop $?' EXIT
  setup "$sg"

  spawn servicemanager system /system/bin/servicemanager
  spawn vndservicemanager vendor /vendor/bin/vndservicemanager /dev/vndbinder
  sleep 1
  # storageproxyd sets ro.vendor.trusty.storage.fs_ready=1 once Trusty's
  # storage is mounted; trusty_apploader blocks until it runs.
  local maps=()
  if ((MAP_STORES)); then
    [[ -f $STATE/td.img ]] && maps+=(-f 0:/dev/block/ss-td -m /dev/block/ss-td)
    [[ -f $STATE/tdp.img ]] && maps+=(-f persist/0:/dev/block/ss-tdp)
  fi
  spawn storageproxyd vendor /vendor/bin/storageproxyd -d /dev/trusty-ipc-dev0 \
    -r /dev/sg-rpmb -p /data/vendor/ss -t ufs "${maps[@]}"
  wait_prop ro.vendor.trusty.storage.fs_ready 1 60 ||
    die "storageproxyd did not report fs_ready in 60 s"
  say "secure storage ready"

  if [[ $stage != storage ]]; then
    # Loaded apps stay until reboot, and a request that timed out here may
    # still complete inside Trusty: a second load then fails with "port
    # already registered". So look for the app's port first.
    if [[ -x $PROBE ]] && "$PROBE" goodix >/dev/null 2>&1; then
      say "$TA already loaded (its port answers)"
    else
      say "loading $TA"
      env -i LD_LIBRARY_PATH=$LIBS_VENDOR LD_PRELOAD=/omamobile/omamobile-fp-shim.so \
        OMAMOBILE_FP_PROPS=/dev/__omamobile_props__ \
        timeout 60 "$CHROOT_BIN" "$ROOT" /vendor/bin/trusty_apploader "/vendor/firmware/$TA" ||
        die "trusty_apploader failed ($?)"
      say "$TA loaded"
    fi
  fi

  if [[ $stage == keys || $stage == hal || $stage == bridge ]]; then
    spawn keymint vendor "$KEYMINT" --dev /dev/trusty-ipc-dev0
    spawn gatekeeper vendor /vendor/bin/hw/android.hardware.gatekeeper-service.trusty \
      --dev /dev/trusty-ipc-dev0
  fi

  if [[ $stage == hal || $stage == bridge ]]; then
    [[ -c $ROOT/dev/goodix_fp ]] || die "no /dev/goodix_fp in the chroot"
    spawn fingerprint vendor /vendor/bin/hw/android.hardware.biometrics.fingerprint-service.goodix
  fi

  # The bridge links libbinder_ndk like the HALs, with the vendor search
  # order, so it reaches them on the same binder (vndbinder, through the
  # vendor libbinder) and vndservicemanager.
  if [[ $stage == bridge ]]; then
    spawn bridge vendor /omamobile/omamobile-fp-bridge \
      --socket /dev/socket/omamobile-fp/bridge.sock --touch /dev/input/touchscreen \
      --ui-state /dev/socket/omamobile-fp-ui/state.json \
      --inhibit /dev/socket/omamobile-fp-ui/inhibit --panel "$PANEL" \
      --lhbm-first "$LHBM_FIRST" \
      ${OMAMOBILE_FP_LHBM_SETTLE_MS:+--settle "$OMAMOBILE_FP_LHBM_SETTLE_MS"}
  fi

  say "stage $stage running"
  rm -f "$PENDING"
  # Supervise: any child exiting stops the whole stack, and it stays stopped
  # until a reboot (one storage proxy per boot; the unit has no Restart=).
  wait -n || true
  # wait also returns when TERM/INT arrives; then the trap is already stopping
  [[ -n $STOPPING ]] || say "a service exited"
  stop 1
}

# $NSPID holds the namespace's PID 1 as seen from the host.
ns_pid() {
  [[ -f $NSPID ]] || die "not running"
  cat "$NSPID"
}

ns() {
  (($#)) || die "usage: omamobile-fp-chroot ns CMD..."
  exec nsenter --target "$(ns_pid)" --mount --pid "$@"
}

run() {
  (($#)) || die "usage: omamobile-fp-chroot run /vendor/bin/... ARGS"
  exec nsenter --target "$(ns_pid)" --mount --pid \
    env -i LD_LIBRARY_PATH=$LIBS_VENDOR LD_PRELOAD=/omamobile/omamobile-fp-shim.so \
    OMAMOBILE_FP_PROPS=/dev/__omamobile_props__ OMAMOBILE_FP_LOGLEVEL=2 \
    "$CHROOT_BIN" "$ROOT" "$@"
}

case ${1:-} in
  check) check ;;
  preflight) preflight ;;
  paths) printf '%s\n' "device=$DEVICE" "state=$STATE" "run=$RUN" "sysblock=$SYSBLOCK" "devdir=$DEVDIR" \
           "mounts=$MOUNTS" "boot_id=$BOOT_ID_FILE" "uidir=$UIDIR" ;;
  start) start "${2:-bridge}" ;;
  ns) shift; ns "$@" ;;
  run) shift; run "$@" ;;
  *) echo "usage: omamobile-fp-chroot check | paths | preflight | start [storage|apploader|keys|hal|bridge] | ns CMD... | run CMD..." >&2
     exit 2 ;;
esac
