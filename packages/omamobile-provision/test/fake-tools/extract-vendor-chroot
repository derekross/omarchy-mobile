#!/bin/bash
# SPDX-License-Identifier: MIT
# Stand-in for tools/extract-vendor-chroot (see common.sh)
source "$(dirname -- "${BASH_SOURCE[0]}")/common.sh"
while getopts "p:o:w:d:f" o; do case $o in o) OUT=$OPTARG ;; p) P=$OPTARG ;; *) ;; esac; done
shift $((OPTIND - 1))
fake_start "$P" "$1"
mkdir -p "$OUT"
chroot_tree "$OUT" "$P"
echo "libstub-$P.so" > "$OUT/STUBS"
