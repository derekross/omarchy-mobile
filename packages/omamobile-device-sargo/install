#!/bin/bash
# SPDX-License-Identifier: MIT
# Stage files only: nothing is started here. The clock's offset units are
# enabled by vendor wants links; no boot-success writes.
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
destination=${1:?Usage: ./install DESTDIR [BUILDDIR]}
build=${2:-build}
[[ $destination == /* && $destination != / ]] || { echo "Use an absolute staging directory" >&2; exit 1; }
for tool in reboot-to; do
  install -Dm755 "$build/$tool" "$destination/usr/bin/$tool"
done
for tool in omamobile-setup-system omamobile-rtc-offset; do
  install -Dm755 "bin/$tool" "$destination/usr/bin/$tool"
done
while IFS= read -r -d '' file; do
  install -Dm644 "$file" "$destination/usr/lib/${file#vendor/}"
done < <(find vendor -type f -print0)
while IFS= read -r -d '' file; do
  install -d "$destination/usr/lib/$(dirname "${file#vendor/}")"
  ln -sfn "$(readlink "$file")" "$destination/usr/lib/${file#vendor/}"
done < <(find vendor -type l -print0)
while IFS= read -r -d '' file; do
  install -Dm644 "$file" "$destination/etc/${file#config/}"
done < <(find config -type f -print0)
install -Dm644 etc/omamobile-mirrorlist "$destination/etc/pacman.d/omamobile-mirrorlist"
for file in LICENSE; do
  install -Dm644 "$file" "$destination/usr/share/licenses/omamobile-device-sargo/$file"
done
install -Dm644 version "$destination/usr/share/omamobile/device-sargo/version"
