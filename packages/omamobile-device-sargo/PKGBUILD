pkgname=omamobile-device-sargo
pkgver=$(cat "${startdir:-.}/version")
pkgrel=1
pkgdesc="Pixel 3a (sargo) first-light support: eMMC storage policy, USB networking and boot helpers"
arch=(aarch64)
url="https://github.com/derekross/omamobile"
license=(MIT)
depends=(bash systemd util-linux omamobile-keyring)
provides=(omamobile-device)
conflicts=(omamobile-device)
install=omamobile-device-sargo.install
makedepends=(gcc)
checkdepends=(python)
backup=(etc/UPower/UPower.conf.d/20-omamobile-critical-power.conf etc/pacman.d/omamobile-mirrorlist)

build() { "$startdir/build" "$srcdir/build"; }
check() { "$startdir/test/all"; }
package() { "$startdir/install" "$pkgdir" "$srcdir/build"; }
