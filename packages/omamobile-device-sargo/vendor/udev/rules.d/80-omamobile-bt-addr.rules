# SPDX-License-Identifier: MIT
# Omamobile: give the WCN3990 Bluetooth controller the phone's address
# (omamobile-bt-addr@.service); without one it stays unconfigured. Only the
# controller itself (DEVTYPE host), not its per-connection devices (hci0:256).
ACTION=="add", SUBSYSTEM=="bluetooth", ENV{DEVTYPE}=="host", KERNEL=="hci[0-9]*", DRIVERS=="hci_uart_qca", TAG+="systemd", ENV{SYSTEMD_WANTS}+="omamobile-bt-addr@%k.service"
