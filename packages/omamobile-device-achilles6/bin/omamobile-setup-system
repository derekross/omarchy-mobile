#!/bin/bash
# SPDX-License-Identifier: MIT
# Omamobile's system setup for the Lenovo Tab M10 FHD Plus (achilles6):
# UTF-8 locale, time zone, and NTP (run by omamobile-firstboot). Safe to rerun.
#   omamobile-setup-system [timezone]
set -euo pipefail

# UTF-8 locale (Qt and Omarchy's tools expect one)
sed -i 's/^#\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen
locale-gen >/dev/null
echo "LANG=en_US.UTF-8" > /etc/locale.conf

# Time: no persistent RTC battery is guaranteed, so keep NTP on
if [[ -n ${1:-} ]]; then
  ln -sf "/usr/share/zoneinfo/$1" /etc/localtime
fi
systemctl enable --now systemd-timesyncd >/dev/null 2>&1 || true
